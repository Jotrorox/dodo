package main

// Reproduce the math range constants with exact integer arithmetic only.
//
// No source tables, host libm functions, floating-point operations, or network
// access are used: the fixed-width unsigned integers in bignum.dodo enclose the
// Taylor series for atan(1/q) and atanh(1/q), scaled by 2**precision. Machin's
// identity gives pi = 16*atan(1/5) - 4*atan(1/239); ln(2) = 2*atanh(1/3).
// Every truncation/rounding must agree at both interval endpoints, and the
// entire calculation is repeated at 2048 and 4096 bits. Rational-to-binary64
// rounding and the shortest round-trip decimal spelling of each constant are
// done in integers as well, so the host's float formatting is not trusted.
//
// Run from anywhere inside the repository:
//
//     dodo run scripts/gen/math_constants.dodo -- --check
//
// --check verifies the checked-in blocks, --write regenerates them, and with
// neither option the generated blocks are printed without reading them.
// See stdlib/std/math/CONSTANTS.md for the derivations and provenance review.

import "std/console"
import "core/mem"
import "bignum"
import "regen"

const PRECISION_LOW: usize = 2048
const PRECISION_HIGH: usize = 4096
const LIMB_BITS: usize = 24
const LIMB_COUNT: usize = 66
const BEGIN: &str = "// BEGIN GENERATED MATH CONSTANTS"
const END: &str = "// END GENERATED MATH CONSTANTS"
const HEADER: &str = "// Generated by scripts/gen/math_constants.dodo; see std/math/CONSTANTS.md."
const COMMAND: &str = "dodo run scripts/gen/math_constants.dodo -- --write"
const MATH_PATH: &str = "stdlib/std/math.dodo"
const TRIG_PATH: &str = "stdlib/std/math/trig.dodo"
// A file only this repository has, to find the root from any subdirectory.
const SELF_PATH: &str = "scripts/gen/math_constants.dodo"

const USAGE: [10]&str = [
    "usage: dodo run scripts/gen/math_constants.dodo -- [--check | --write]",
    "",
    "Reproduce the math range constants in stdlib/std/math.dodo and",
    "stdlib/std/math/trig.dodo with exact integer arithmetic at 2048 and 4096 bits.",
    "",
    "  --check  fail if the generated blocks differ from the checked-in ones",
    "  --write  replace the generated blocks",
    "  (none)   print the generated blocks",
    "",
    "Run from anywhere inside the repository.",
]

const NAMES: [5]&str = ["LN_2_HIGH", "LN_2_LOW", "INV_LN_2", "EXP_OVERFLOW_LIMIT", "EXP_UNDERFLOW_LIMIT"]

// ---------------------------------------------------------------------------
// Interval series

// The enclosure [lower, upper] of scale * sum((+/-1)**k / ((2*k+1)*q**(2*k+1))).
struct Interval {
    lower: bignum.Big
    upper: bignum.Big
}

// q is given as a Big so that q = 2**54 - 1 works; q2 is q*q when it fits a
// u32 (then division by q*q is one short division), else 0.
fn reciprocal_series(q: &bignum.Big, q2: u32, scale: &bignum.Big, alternating: bool) -> Interval {
    assert(bignum.bit_length(q) >= 2, "series requires q >= 2")
    lower := bignum.zero()
    upper := bignum.zero()
    // floor(scale / q**(2*k+1)). Since floor(floor(x/a)/b) = floor(x/(a*b))
    // for positive integers, dividing step by step yields the same terms as
    // floor(scale / (odd * q**(2*k+1))) computed in one division.
    power := bignum.div(scale, q)
    odd := 1u32
    positive := true
    rest := 0u64
    for true {
        term := bignum.div_small(&power, odd, &mut rest)
        if bignum.is_zero(&term) {
            // The first omitted term is < 1 scaled unit. An alternating
            // tail has its sign and is no larger; a positive tail is bounded
            // by a geometric series with ratio <= 1/q**2, hence < 2 units.
            if alternating && !positive {
                lower = bignum.sub_small(&lower, 1)
            } else {
                bound: u64 = if alternating {
                    1
                } else {
                    2
                }
                upper = bignum.add_small(&upper, bound)
            }
            return Interval { lower: lower, upper: upper }
        }
        // Each exact scaled term lies in [term, term + 1].
        term_up := bignum.add_small(&term, 1)
        if positive {
            lower = bignum.add(&lower, &term)
            upper = bignum.add(&upper, &term_up)
        } else {
            lower = bignum.sub(&lower, &term_up)
            upper = bignum.sub(&upper, &term)
        }
        if q2 != 0 {
            power = bignum.div_small(&power, q2, &mut rest)
        } else {
            once := bignum.div(&power, q)
            power = bignum.div(&once, q)
        }
        odd = odd + 2
        if alternating {
            positive = !positive
        }
    }
    return Interval { lower: lower, upper: upper }
}

fn series_small(q: u32, scale: &bignum.Big, alternating: bool) -> Interval {
    big_q := bignum.from_u64(q as u64)
    return reciprocal_series(&big_q, q * q, scale, alternating)
}

fn agreed(lower: u64, upper: u64, name: &str) -> u64 {
    if lower != upper {
        fail2("insufficient precision to resolve ", name)
    }
    return lower
}

fn agreed_big(lower: &bignum.Big, upper: &bignum.Big, name: &str) -> bignum.Big {
    if !bignum.equal(lower, upper) {
        fail2("insufficient precision to resolve ", name)
    }
    return bignum.copy(lower)
}

// ---------------------------------------------------------------------------
// Exact binary64 rounding

const NEAREST: i32 = 0
const TOWARD_ZERO: i32 = 1

// The binary64 bit pattern of num / den (> 0, in the normal range), rounded to
// nearest with ties to even or toward zero.
fn to_f64(num: &bignum.Big, den: &bignum.Big, mode: i32) -> u64 {
    assert(!bignum.is_zero(num) && !bignum.is_zero(den), "to_f64 needs a positive value")
    // Find k with 2**53 <= floor(num * 2**k / den) < 2**54: a 53-bit
    // significand plus one rounding bit; a nonzero remainder is sticky.
    k := 53i64 - bignum.bit_length(num) as i64 + bignum.bit_length(den) as i64
    q := bignum.zero()
    r := bignum.zero()
    for true {
        if k >= 0 {
            shifted := bignum.shl(num, k as usize)
            bignum.divide(&shifted, den, &mut q, &mut r)
        } else {
            shifted := bignum.shl(den, (-k) as usize)
            bignum.divide(num, &shifted, &mut q, &mut r)
        }
        bits := bignum.bit_length(&q)
        if bits == 54 {
            break
        }
        if bits < 54 {
            k = k + 1
        } else {
            k = k - 1
        }
    }
    wide := bignum.to_u64(&q)
    significand := wide >> 1
    half := (wide & 1) != 0
    sticky := !bignum.is_zero(&r)
    if mode == NEAREST && half && (sticky || (significand & 1) != 0) {
        significand = significand + 1
        if significand == (1u64 << 53) {
            significand = significand >> 1
            k = k - 1
        }
    }
    // value = significand * 2**(1 - k), significand in [2**52, 2**53).
    biased := 1023i64 + 52 + 1 - k
    assert(biased > 0 && biased < 2047, "to_f64: result is not a normal binary64")
    return ((biased as u64) << 52) | (significand & 0x000fffffffffffffu64)
}

fn rounded(lower: &bignum.Big, upper: &bignum.Big, scale: &bignum.Big, name: &str) -> u64 {
    return agreed(to_f64(lower, scale, NEAREST), to_f64(upper, scale, NEAREST), name)
}

// num / den as a positive fraction.
fn ratio(num: u64, den: u64) -> u64 {
    a := bignum.from_u64(num)
    b := bignum.from_u64(den)
    return to_f64(&a, &b, NEAREST)
}

// ---------------------------------------------------------------------------
// The constants

struct Generated {
    constants: [5]u64
    digits: [66]u32
}

fn generate(precision: usize) -> Generated {
    scale := bignum.pow2(precision)
    atan5 := series_small(5, &scale, true)
    atan239 := series_small(239, &scale, true)
    a16 := bignum.mul_small(&atan5.lower, 16)
    b4 := bignum.mul_small(&atan239.upper, 4)
    pi_lower := bignum.sub(&a16, &b4)
    a16u := bignum.mul_small(&atan5.upper, 16)
    b4l := bignum.mul_small(&atan239.lower, 4)
    pi_upper := bignum.sub(&a16u, &b4l)
    table_bits := LIMB_BITS * LIMB_COUNT
    numerator := bignum.pow2(precision + 1 + table_bits)
    table_low := bignum.div(&numerator, &pi_upper)
    table_high := bignum.div(&numerator, &pi_lower)
    table := agreed_big(&table_low, &table_high, "2/pi table")
    digits := [0u32; 66]
    for i in 0usize..LIMB_COUNT {
        digits[i] = bignum.bits_at(&table, table_bits - LIMB_BITS * (i + 1), LIMB_BITS)
    }

    atanh3 := series_small(3, &scale, false)
    ln_lower := bignum.mul_small(&atanh3.lower, 2)
    ln_upper := bignum.mul_small(&atanh3.upper, 2)
    // Truncate ln(2) to 32 fractional bits (21 trailing zero significand bits).
    high_lower := bignum.shr(&ln_lower, precision - 32)
    high_upper := bignum.shr(&ln_upper, precision - 32)
    high_big := agreed_big(&high_lower, &high_upper, "ln(2) high")
    high := bignum.to_u64(&high_big)
    high_scaled := bignum.shl(&high_big, precision - 32)

    // max_finite = 2**1024 * (1 - 2**-53).
    // ln(1 - 2**-53) = -2*atanh(1/(2**54 - 1)).
    q := bignum.from_u64((1u64 << 54) - 1)
    correction := reciprocal_series(&q, 0, &scale, false)
    constants := [0u64; 5]
    constants[0] = ratio(high, 1u64 << 32)
    low_lower := bignum.sub(&ln_lower, &high_scaled)
    low_upper := bignum.sub(&ln_upper, &high_scaled)
    constants[1] = rounded(&low_lower, &low_upper, &scale, "ln(2) low")
    constants[2] = agreed(to_f64(&scale, &ln_upper, NEAREST), to_f64(&scale, &ln_lower, NEAREST), "1/ln(2)")
    l1024 := bignum.mul_small(&ln_lower, 1024)
    u1024 := bignum.mul_small(&ln_upper, 1024)
    c_upper := bignum.mul_small(&correction.upper, 2)
    c_lower := bignum.mul_small(&correction.lower, 2)
    overflow_lower := bignum.sub(&l1024, &c_upper)
    overflow_upper := bignum.sub(&u1024, &c_lower)
    constants[3] = rounded(&overflow_lower, &overflow_upper, &scale, "ln(max_finite)")
    // Half the smallest subnormal is 2**-1075. The strict '<' guard needs
    // the first binary64 input ABOVE its logarithm. For the negative value
    // -1075*ln(2), rounding upward is rounding its magnitude toward zero.
    u1075 := bignum.mul_small(&ln_upper, 1075)
    l1075 := bignum.mul_small(&ln_lower, 1075)
    under := agreed(to_f64(&u1075, &scale, TOWARD_ZERO), to_f64(&l1075, &scale, TOWARD_ZERO), "ln(2**-1075), rounded upward")
    constants[4] = under | (1u64 << 63)
    return Generated { constants: constants, digits: digits }
}

// ---------------------------------------------------------------------------
// Shortest round-trip decimal spelling, as Python's repr(float)

fn pow10(exponent: usize) -> bignum.Big {
    result := bignum.from_u64(1)
    for i in 0usize..exponent {
        result = bignum.mul_small(&result, 10)
    }
    return result
}

// num / den compared with 10**power: -1, 0 or 1.
fn compare_pow10(num: &bignum.Big, den: &bignum.Big, power: i64) -> i32 {
    if power >= 0 {
        scaled := bignum.copy(den)
        for i in 0usize..power as usize {
            scaled = bignum.mul_small(&scaled, 10)
        }
        return bignum.compare(num, &scaled)
    }
    scaled := bignum.copy(num)
    for i in 0usize..(-power) as usize {
        scaled = bignum.mul_small(&scaled, 10)
    }
    return bignum.compare(&scaled, den)
}

// Append the repr of the binary64 value with the given bits.
fn put_float(out: &mut regen.Buf, bits: u64) {
    if (bits >> 63) != 0 {
        out.str("-")
    }
    exponent := ((bits >> 52) & 0x7ff) as i64
    assert(exponent != 0 && exponent != 0x7ff, "only normal values are formatted")
    m := (bits & 0x000fffffffffffffu64) | (1u64 << 52)
    e := exponent - 1075
    num := bignum.from_u64(m)
    den := bignum.from_u64(1)
    if e >= 0 {
        num = bignum.shl(&num, e as usize)
    } else {
        den = bignum.pow2((-e) as usize)
    }
    magnitude := bits & 0x7fffffffffffffffu64
    // decimal_exponent = floor(log10(value)).
    decimal_exponent := 0i64
    for compare_pow10(&num, &den, decimal_exponent) < 0 {
        decimal_exponent = decimal_exponent - 1
    }
    for compare_pow10(&num, &den, decimal_exponent + 1) >= 0 {
        decimal_exponent = decimal_exponent + 1
    }
    // The shortest digit count whose nearest decimal rounds back to the value.
    // The nearest n-digit decimal is the only n-digit candidate to try: the
    // values rounding to this binary64 form an interval around it.
    digits := 0u64
    point := 0i64
    for n in 1i64..18 {
        s := n - 1 - decimal_exponent
        scaled_num := bignum.copy(&num)
        scaled_den := bignum.copy(&den)
        if s >= 0 {
            p := pow10(s as usize)
            scaled_num = mul_big(&num, &p)
        } else {
            p := pow10((-s) as usize)
            scaled_den = mul_big(&den, &p)
        }
        q := bignum.zero()
        r := bignum.zero()
        bignum.divide(&scaled_num, &scaled_den, &mut q, &mut r)
        twice := bignum.mul_small(&r, 2)
        order := bignum.compare(&twice, &scaled_den)
        candidate := bignum.to_u64(&q)
        if order > 0 || (order == 0 && (candidate & 1) != 0) {
            candidate = candidate + 1
        }
        back := bignum.from_u64(candidate)
        back_bits := 0u64
        if s >= 0 {
            p := pow10(s as usize)
            back_bits = to_f64(&back, &p, NEAREST)
        } else {
            p := pow10((-s) as usize)
            scaled := mul_big(&back, &p)
            one := bignum.from_u64(1)
            back_bits = to_f64(&scaled, &one, NEAREST)
        }
        if back_bits == magnitude {
            digits = candidate
            point = -s
            break
        }
    }
    assert(digits != 0, "no round-trip decimal found")
    // Python's repr: digits without trailing zeros, decimal point position
    // `point`, scientific notation when point <= -4 or point > 16.
    text := [0u8; 24]
    count := 0usize
    for digits != 0 {
        text[count] = b'0' + (digits % 10) as u8
        digits = digits / 10
        count = count + 1
    }
    // candidate = digits * 10**-s; a rounding carry can give it n + 1 digits.
    point = point + count as i64
    reversed := [0u8; 24]
    for i in 0usize..count {
        reversed[i] = text[count - 1 - i]
    }
    // Python's repr drops trailing zeros (left by a carry to 10**n).
    for count > 1 && reversed[count - 1] == b'0' {
        count = count - 1
    }
    ds := &reversed[..count]
    length := count as i64
    if point > -4 && point <= 16 {
        if point <= 0 {
            out.str("0.")
            for i in 0i64..-point {
                out.str("0")
            }
            out.bytes(ds)
        } else if point < length {
            out.bytes(&ds[..point as usize])
            out.str(".")
            out.bytes(&ds[point as usize..])
        } else {
            out.bytes(ds)
            for i in length..point {
                out.str("0")
            }
            out.str(".0")
        }
    } else {
        out.bytes(&ds[..1])
        if count > 1 {
            out.str(".")
            out.bytes(&ds[1..])
        }
        out.str("e")
        power := point - 1
        if power < 0 {
            out.str("-")
            power = -power
        } else {
            out.str("+")
        }
        if power < 10 {
            out.str("0")
        }
        out.uint(power as u64)
    }
}

// a * b for a b of at most a few limbs (powers of ten here).
fn mul_big(a: &bignum.Big, b: &bignum.Big) -> bignum.Big {
    result := bignum.zero()
    for i in 0usize..bignum.LIMBS {
        if b[i] != 0 {
            partial := bignum.mul_small(a, b[i])
            shifted := bignum.shl(&partial, 32 * i)
            result = bignum.add(&result, &shifted)
        }
    }
    return result
}

// ---------------------------------------------------------------------------
// Blocks and files

fn math_block(result: &Generated, out: &mut regen.Buf) {
    out.str(BEGIN)
    out.str("\n")
    out.str(HEADER)
    for i in 0usize..5 {
        out.str("\nconst ")
        out.str(NAMES[i])
        out.str(": f64 = ")
        put_float(out, result.constants[i])
    }
    out.str("\n")
    out.str(END)
}

fn trig_block(result: &Generated, out: &mut regen.Buf) {
    out.str("    ")
    out.str(BEGIN)
    out.str("\n    ")
    out.str(HEADER)
    start := 0usize
    for start < LIMB_COUNT {
        out.str("\n    ")
        if start == 0 {
            out.str("digits := [")
        }
        for i in 0usize..6 {
            if i != 0 {
                out.str(", ")
            }
            digit := result.digits[start + i]
            out.str("0x")
            out.hex2(((digit >> 16) & 255) as u8, true)
            out.hex2(((digit >> 8) & 255) as u8, true)
            out.hex2((digit & 255) as u8, true)
            if start + i == 0 {
                out.str("u64")
            }
        }
        if start + 6 == LIMB_COUNT {
            out.str("]")
        } else {
            out.str(",")
        }
        start = start + 6
    }
    out.str("\n    ")
    out.str(END)
}

// Replace the lines from the BEGIN marker through the END marker with block
// plus a newline. Returns false unless there is exactly one ordered pair.
fn replace_block(source: &[u8], block: &[u8], out: &mut regen.Buf) -> bool {
    begin_count := 0usize
    end_count := 0usize
    begin_at := 0usize
    end_after := 0usize
    begin_line := 0usize
    end_line := 0usize
    line := 0usize
    start := 0usize
    for start < source.len {
        stop := start
        for stop < source.len && source[stop] != b'\n' {
            stop = stop + 1
        }
        next := if stop < source.len {
            stop + 1
        } else {
            stop
        }
        if regen.equal(regen.trim(&source[start..stop]), BEGIN) {
            begin_count = begin_count + 1
            begin_at = start
            begin_line = line
        }
        if regen.equal(regen.trim(&source[start..stop]), END) {
            end_count = end_count + 1
            end_after = next
            end_line = line
        }
        line = line + 1
        start = next
    }
    if begin_count != 1 || end_count != 1 || begin_line >= end_line {
        return false
    }
    out.bytes(&source[..begin_at])
    out.bytes(block)
    out.str("\n")
    out.bytes(&source[end_after..])
    return true
}

fn fail2(message: &str, detail: &str) {
    errors := console.stderr()
    errors.print(message)!
    errors.println(detail)!
    regen.quit(1)
}

// Reads a repository file into storage, or exits after saying why.
fn load(relative: &str, storage: &mut[u8]) -> usize {
    match regen.read(relative, storage) {
        some(used) => {
            return used
        },
        none => {
            regen.quit(1)
            return 0
        },
    }
}

fn main() -> i32 {
    check := false
    write := false
    arguments := regen.arguments()
    for i in 0usize..arguments.len() {
        if arguments.is(i, "--check") && !write {
            check = true
        } else if arguments.is(i, "--write") && !check {
            write = true
        } else if arguments.is(i, "-h") || arguments.is(i, "--help") {
            regen.usage(&USAGE, false)
            return 0
        } else {
            regen.usage(&USAGE, true)
            return 2
        }
    }

    low := generate(PRECISION_LOW)
    high := generate(PRECISION_HIGH)
    for i in 0usize..5 {
        agreed(low.constants[i], high.constants[i], "precision agreement")
    }
    for i in 0usize..LIMB_COUNT {
        agreed(low.digits[i] as u64, high.digits[i] as u64, "precision agreement")
    }
    math_storage := [0u8; 8192]
    math := regen.Buf.new(&mut math_storage)
    math_block(&high, &mut math)
    trig_storage := [0u8; 8192]
    trig := regen.Buf.new(&mut trig_storage)
    trig_block(&high, &mut trig)
    if !(check || write) {
        regen.print(b"// ")
        regen.print(mem.str_bytes(MATH_PATH))
        regen.print(b"\n")
        regen.print(math.view())
        regen.print(b"\n\n// ")
        regen.print(mem.str_bytes(TRIG_PATH))
        regen.print(b"\n")
        regen.print(trig.view())
        regen.print(b"\n\n")
        return 0
    }

    if !regen.find_root(SELF_PATH) {
        regen.fail("Run this generator from inside the Dodo repository.")
        return 2
    }
    // Validate both files' markers before writing either.
    math_source := [0u8; 65536]
    math_used := load(MATH_PATH, &mut math_source)
    trig_source := [0u8; 65536]
    trig_used := load(TRIG_PATH, &mut trig_source)
    math_storage_new := [0u8; 65536]
    math_new := regen.Buf.new(&mut math_storage_new)
    if !replace_block(&math_source[..math_used], math.view(), &mut math_new) {
        fail2("expected exactly one ordered pair of generated-block markers in ", MATH_PATH)
    }
    trig_storage_new := [0u8; 65536]
    trig_new := regen.Buf.new(&mut trig_storage_new)
    if !replace_block(&trig_source[..trig_used], trig.view(), &mut trig_new) {
        fail2("expected exactly one ordered pair of generated-block markers in ", TRIG_PATH)
    }
    math_changed := !regen.same(&math_source[..math_used], math_new.view())
    trig_changed := !regen.same(&trig_source[..trig_used], trig_new.view())
    if check && (math_changed || trig_changed) {
        errors := console.stderr()
        if math_changed {
            errors.print("Outdated generated constants: ")!
            errors.println(MATH_PATH)!
        }
        if trig_changed {
            errors.print("Outdated generated constants: ")!
            errors.println(TRIG_PATH)!
        }
        errors.print("Run ")!
        errors.println(COMMAND)!
        return 1
    }
    if math_changed && regen.write(MATH_PATH, math_new.view()) != 0 {
        return 1
    }
    if trig_changed && regen.write(TRIG_PATH, trig_new.view()) != 0 {
        return 1
    }
    output := console.stdout()
    if check {
        output.print("Verified ")!
    } else {
        output.print("Generated ")!
    }
    output.println("66 limbs and 5 binary64 constants at 2048 and 4096 bits.")!
    return 0
}
