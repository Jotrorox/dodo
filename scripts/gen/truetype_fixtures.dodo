package main

import "std/math"
import "regen"

// Writes the TrueType fixtures std/graphics/truetype is tested against.
//
// The glyphs are drawn here, so the fonts carry no third-party licence. Each
// outline exercises one part of the format: polygons with holes (.notdef, A,
// N), a contour of off-curve points only (O), a contour starting off-curve
// with an on-curve last point (D), and composite glyphs with offsets (Ä), a
// uniform scale (o) and a rotation matrix (Z).
//
//     tests/graphics/fonts/dodo-test.ttf       short loca, cmap format 4, kern table
//     tests/graphics/fonts/dodo-test-long.ttf  long loca, cmap formats 4 and 12, no kern table
//     tests/graphics/fonts/dodo-test.ttc       both fonts as a TrueType collection
//
// tests/stdlib/graphics_checks.dodo also embeds dodo-test.ttf as the Dodo
// array TEST_FONT, since that fixture has no file system.
//
//     dodo run scripts/gen/truetype_fixtures.dodo -- --check
//
// With no option the four outputs are rewritten; --check verifies them
// instead, and --dodo prints the TEST_FONT array. The output is
// deterministic. Run it anywhere inside the repository.

const SELF: &str = "scripts/gen/truetype_fixtures.dodo"
const COMMAND: &str = "`dodo run scripts/gen/truetype_fixtures.dodo`"
const USAGE: &str = "usage: dodo run scripts/gen/truetype_fixtures.dodo -- [--check | --dodo]"
const SHORT_FONT: &str = "tests/graphics/fonts/dodo-test.ttf"
const LONG_FONT: &str = "tests/graphics/fonts/dodo-test-long.ttf"
const COLLECTION: &str = "tests/graphics/fonts/dodo-test.ttc"
const CHECKS: &str = "tests/stdlib/graphics_checks.dodo"
const ARRAY_BEGIN: &str = "const TEST_FONT: ["
const ARRAY_END: &str = "\n]"

const UNITS_PER_EM: u16 = 1000
const ASCENT: i16 = 800
const DESCENT: i16 = -200
const LINE_GAP: i16 = 90

// Contours are (x, y, on-curve) triples in font units, y up, clockwise for
// filled areas and counterclockwise for holes; the *_CONTOURS arrays give
// each contour's point count.
static NOTDEF: [24]i32 = [
    50, 0, 1, 50, 700, 1, 450, 700, 1, 450, 0, 1,
    100, 50, 1, 400, 50, 1, 400, 650, 1, 100, 650, 1,
]
static NOTDEF_CONTOURS: [2]usize = [4, 4]
static LETTER_A: [33]i32 = [
    0, 0, 1, 250, 700, 1, 350, 700, 1, 600, 0, 1, 480, 0, 1, 420, 180, 1, 180, 180, 1, 120, 0, 1,
    220, 300, 1, 380, 300, 1, 300, 560, 1,
]
static LETTER_A_CONTOURS: [2]usize = [8, 3]
static LETTER_O: [24]i32 = [
    50, -10, 0, 50, 710, 0, 550, 710, 0, 550, -10, 0,
    150, 90, 0, 450, 90, 0, 450, 610, 0, 150, 610, 0,
]
static LETTER_O_CONTOURS: [2]usize = [4, 4]
static LETTER_D: [42]i32 = [
    560, 700, 0, 560, 350, 1, 560, 0, 0, 300, 0, 1, 60, 0, 1, 60, 700, 1, 300, 700, 1,
    160, 100, 1, 300, 100, 1, 460, 100, 0, 460, 350, 1, 460, 600, 0, 300, 600, 1, 160, 600, 1,
]
static LETTER_D_CONTOURS: [2]usize = [7, 7]
static PERIOD: [12]i32 = [0, 0, 1, 0, 120, 1, 120, 120, 1, 120, 0, 1]
static PERIOD_CONTOURS: [1]usize = [4]
static LETTER_N: [30]i32 = [
    60, 0, 1, 60, 700, 1, 160, 700, 1, 440, 180, 1, 440, 700, 1,
    540, 700, 1, 540, 0, 1, 440, 0, 1, 160, 520, 1, 160, 0, 1,
]
static LETTER_N_CONTOURS: [1]usize = [10]

const ARG_WORDS: u16 = 0x1
const XY_VALUES: u16 = 0x2
const HAVE_SCALE: u16 = 0x8
const MORE: u16 = 0x20
const HAVE_2X2: u16 = 0x80

// Composite components are (glyph, dx, dy, transform), where the transform
// indexes TRANSFORMS: none, a uniform scale, or a 2x2 matrix (xx, yx, xy, yy).
const NONE: i32 = 0
const HALF: i32 = 1
const ROTATE: i32 = 2
const TRANSFORMS: [3][4]f64 = [
    [1.0, 0.0, 0.0, 1.0],
    [0.5, 0.0, 0.0, 0.5],
    [0.0, 0.8, -0.8, 0.0],
]
static ADIERESIS: [12]i32 = [2, 0, 0, NONE, 5, 150, 780, NONE, 5, 330, 780, NONE]
static SMALL_O: [4]i32 = [3, 0, 0, HALF]
static LETTER_Z: [4]i32 = [8, 600, 0, ROTATE]

// .notdef, space, A, O, D, period, Adieresis, o, N, Z
const GLYPH_COUNT: usize = 10
const ADVANCES: [10]u16 = [500, 250, 600, 600, 620, 220, 600, 350, 600, 600]
// The last glyphs share the final advance, so hmtx lists fewer metrics.
const METRICS: usize = 9
// Character codes, ascending, and their glyphs.
const CODES: [9]u32 = [0x20, 0x2E, 0x41, 0x44, 0x4E, 0x4F, 0x5A, 0x6F, 0xC4]
const CODE_GLYPHS: [9]u16 = [1, 5, 2, 4, 8, 3, 9, 7, 6]
const ASTRAL_CODE: u32 = 0x1F600
const ASTRAL_GLYPH: u16 = 3
// Kerning pairs (left, right, value), sorted by glyph pair.
const KERNING: [3][3]i32 = [[2, 3, -30], [2, 4, -80], [4, 2, -40]]

static EMPTY_POINTS: [0]i32 = []
static EMPTY_CONTOURS: [0]usize = []

fn points(glyph: usize) -> &[i32] from(static) {
    match glyph {
        0 => {
            return &NOTDEF
        },
        2 => {
            return &LETTER_A
        },
        3 => {
            return &LETTER_O
        },
        4 => {
            return &LETTER_D
        },
        5 => {
            return &PERIOD
        },
        8 => {
            return &LETTER_N
        },
        _ => {
            return &EMPTY_POINTS
        },
    }
}

fn contours(glyph: usize) -> &[usize] from(static) {
    match glyph {
        0 => {
            return &NOTDEF_CONTOURS
        },
        2 => {
            return &LETTER_A_CONTOURS
        },
        3 => {
            return &LETTER_O_CONTOURS
        },
        4 => {
            return &LETTER_D_CONTOURS
        },
        5 => {
            return &PERIOD_CONTOURS
        },
        8 => {
            return &LETTER_N_CONTOURS
        },
        _ => {
            return &EMPTY_CONTOURS
        },
    }
}

fn components(glyph: usize) -> &[i32] from(static) {
    match glyph {
        6 => {
            return &ADIERESIS
        },
        7 => {
            return &SMALL_O
        },
        9 => {
            return &LETTER_Z
        },
        _ => {
            return &EMPTY_POINTS
        },
    }
}

fn u16be(out: &mut regen.Buf, value: u16) {
    out.byte((value >> 8) as u8)
    out.byte((value & 0xFF) as u8)
}

fn i16be(out: &mut regen.Buf, value: i32) {
    u16be(out, (value & 0xFFFF) as u16)
}

fn u32be(out: &mut regen.Buf, value: u32) {
    u16be(out, (value >> 16) as u16)
    u16be(out, (value & 0xFFFF) as u16)
}

fn zeros(out: &mut regen.Buf, count: usize) {
    for _ in 0usize..count {
        out.byte(0)
    }
}

fn pad4(out: &mut regen.Buf, start: usize) {
    for (out.used - start) % 4 != 0 {
        out.byte(0)
    }
}

fn f2dot14(out: &mut regen.Buf, value: f64) {
    i16be(out, math.round_even(value * 16384.0) as i32)
}

// Largest power of two not above `count`, and its base-2 logarithm.
fn search_range(count: usize) -> usize {
    search := 1usize
    for search * 2 <= count {
        search = search * 2
    }
    return search
}

fn log2(value: usize) -> usize {
    result := 0usize
    for (1usize << result) < value {
        result += 1
    }
    return result
}

fn min_i(a: i32, b: i32) -> i32 {
    if b < a {
        return b
    }
    return a
}

fn max_i(a: i32, b: i32) -> i32 {
    if b > a {
        return b
    }
    return a
}

// Bounding box (x0, y0, x1, y1) of a simple glyph's points.
fn bbox_of(glyph: usize) -> [4]i32 {
    let p = points(glyph)
    box := [p[0], p[1], p[0], p[1]]
    for i := 0usize; i < p.len; i += 3 {
        box[0] = min_i(box[0], p[i])
        box[1] = min_i(box[1], p[i + 1])
        box[2] = max_i(box[2], p[i])
        box[3] = max_i(box[3], p[i + 1])
    }
    return box
}

fn simple_glyph(out: &mut regen.Buf, glyph: usize) {
    let p = points(glyph)
    let c = contours(glyph)
    count := p.len / 3
    flags := [0u8; 64]
    xs_storage := [0u8; 256]
    xs := regen.Buf.new(&mut xs_storage)
    ys_storage := [0u8; 256]
    ys := regen.Buf.new(&mut ys_storage)
    px := 0i32
    py := 0i32
    for i in 0usize..count {
        x := p[3 * i]
        y := p[3 * i + 1]
        dx := x - px
        dy := y - py
        px = x
        py = y
        flag := (p[3 * i + 2] & 1) as u8
        if dx == 0 {
            flag = flag | 0x10
        } else if dx >= -255 && dx <= 255 {
            // A one-byte magnitude; the second flag bit gives its sign.
            flag = flag | 0x02
            if dx > 0 {
                flag = flag | 0x10
            }
            xs.byte(max_i(dx, -dx) as u8)
        } else {
            i16be(&mut xs, dx)
        }
        if dy == 0 {
            flag = flag | 0x20
        } else if dy >= -255 && dy <= 255 {
            flag = flag | 0x04
            if dy > 0 {
                flag = flag | 0x20
            }
            ys.byte(max_i(dy, -dy) as u8)
        } else {
            i16be(&mut ys, dy)
        }
        flags[i] = flag
    }
    let box = bbox_of(glyph)
    i16be(out, c.len as i32)
    for k in 0usize..4 {
        i16be(out, box[k])
    }
    total := 0usize
    for k in 0usize..c.len {
        total += c[k]
        u16be(out, (total - 1) as u16)
    }
    u16be(out, 0)
    // Run-length encode equal flags with the repeat bit.
    i := 0usize
    for i < count {
        run := 1usize
        for i + run < count && flags[i + run] == flags[i] && run < 256 {
            run += 1
        }
        if run > 1 {
            out.byte(flags[i] | 0x08)
            out.byte((run - 1) as u8)
        } else {
            out.byte(flags[i])
        }
        i += run
    }
    out.bytes(xs.view())
    out.bytes(ys.view())
}

fn min_f(a: f64, b: f64) -> f64 {
    if b < a {
        return b
    }
    return a
}

fn max_f(a: f64, b: f64) -> f64 {
    if b > a {
        return b
    }
    return a
}

// A component's box: the referenced glyph's corners, transformed, offset
// and truncated toward zero.
fn part_box(boxes: &[i32], glyph: usize, dx: i32, dy: i32, transform: i32) -> [4]i32 {
    let x0 = boxes[glyph * 4] as f64
    let y0 = boxes[glyph * 4 + 1] as f64
    let x1 = boxes[glyph * 4 + 2] as f64
    let y1 = boxes[glyph * 4 + 3] as f64
    corners := [x0, y0, x0, y1, x1, y0, x1, y1]
    t := transform as usize
    for k in 0usize..4 {
        x := corners[2 * k]
        y := corners[2 * k + 1]
        if transform == HALF {
            corners[2 * k] = x * TRANSFORMS[t][0]
            corners[2 * k + 1] = y * TRANSFORMS[t][0]
        } else if transform != NONE {
            corners[2 * k] = TRANSFORMS[t][0] * x + TRANSFORMS[t][2] * y
            corners[2 * k + 1] = TRANSFORMS[t][1] * x + TRANSFORMS[t][3] * y
        }
    }
    low_x := corners[0] + dx as f64
    low_y := corners[1] + dy as f64
    high_x := low_x
    high_y := low_y
    for k in 1usize..4 {
        low_x = min_f(low_x, corners[2 * k] + dx as f64)
        high_x = max_f(high_x, corners[2 * k] + dx as f64)
        low_y = min_f(low_y, corners[2 * k + 1] + dy as f64)
        high_y = max_f(high_y, corners[2 * k + 1] + dy as f64)
    }
    return [math.trunc(low_x) as i32, math.trunc(low_y) as i32, math.trunc(high_x) as i32, math.trunc(high_y) as i32]
}

// Writes a composite glyph and stores its box in `boxes`.
fn composite_glyph(out: &mut regen.Buf, glyph: usize, boxes: &mut[i32]) {
    let parts = components(glyph)
    count := parts.len / 4
    box := [0i32; 4]
    for i in 0usize..count {
        let part = part_box(boxes, parts[4 * i] as usize, parts[4 * i + 1], parts[4 * i + 2], parts[4 * i + 3])
        for k in 0usize..4 {
            if i == 0 || (k < 2 && part[k] < box[k]) || (k >= 2 && part[k] > box[k]) {
                box[k] = part[k]
            }
        }
    }
    for k in 0usize..4 {
        boxes[glyph * 4 + k] = box[k]
    }
    i16be(out, -1)
    for k in 0usize..4 {
        i16be(out, box[k])
    }
    for i in 0usize..count {
        reference := parts[4 * i]
        dx := parts[4 * i + 1]
        dy := parts[4 * i + 2]
        transform := parts[4 * i + 3]
        t := transform as usize
        flags := XY_VALUES
        if i + 1 < count {
            flags = flags | MORE
        }
        words := !(dx >= -128 && dx <= 127 && dy >= -128 && dy <= 127)
        if words {
            flags = flags | ARG_WORDS
        }
        if transform == HALF {
            flags = flags | HAVE_SCALE
        } else if transform != NONE {
            flags = flags | HAVE_2X2
        }
        u16be(out, flags)
        u16be(out, reference as u16)
        if words {
            i16be(out, dx)
            i16be(out, dy)
        } else {
            out.byte((dx & 0xFF) as u8)
            out.byte((dy & 0xFF) as u8)
        }
        if transform == HALF {
            f2dot14(out, TRANSFORMS[t][0])
        } else if transform != NONE {
            for k in 0usize..4 {
                f2dot14(out, TRANSFORMS[t][k])
            }
        }
    }
}

// Writes the glyf table and fills `offsets` (GLYPH_COUNT + 1 entries).
fn glyph_table(out: &mut regen.Buf, offsets: &mut[usize]) {
    start := out.used
    boxes := [0i32; 40]
    for glyph in 0usize..GLYPH_COUNT {
        offsets[glyph] = out.used - start
        if points(glyph).len > 0 {
            let box = bbox_of(glyph)
            for k in 0usize..4 {
                boxes[glyph * 4 + k] = box[k]
            }
            simple_glyph(out, glyph)
        } else if components(glyph).len > 0 {
            composite_glyph(out, glyph, &mut boxes)
        } else {
            // An empty glyph: zero box and no data.
            continue
        }
        pad4(out, start)
    }
    offsets[GLYPH_COUNT] = out.used - start
}

fn loca_table(out: &mut regen.Buf, offsets: &[usize], long_loca: bool) {
    for i in 0usize..GLYPH_COUNT + 1 {
        if long_loca {
            u32be(out, offsets[i] as u32)
        } else {
            u16be(out, (offsets[i] / 2) as u16)
        }
    }
}

fn cmap_format4(out: &mut regen.Buf) {
    // 'A' through 'D' use idRangeOffset into a glyph array (B and C are
    // missing); every other character is its own idDelta segment.
    starts := [0u32; 16]
    ends := [0u32; 16]
    deltas := [0u32; 16]
    ranged := [false; 16]
    count := 0usize
    inserted := false
    for i in 0usize..CODES.len {
        code := CODES[i]
        if code >= 0x41 && !inserted {
            starts[count] = 0x41
            ends[count] = 0x44
            ranged[count] = true
            count += 1
            inserted = true
        }
        if code >= 0x41 && code <= 0x44 {
            continue
        }
        starts[count] = code
        ends[count] = code
        deltas[count] = (CODE_GLYPHS[i] as u32 + 0x10000 - code) & 0xFFFF
        count += 1
    }
    starts[count] = 0xFFFF
    ends[count] = 0xFFFF
    deltas[count] = 1
    count += 1
    search := search_range(count)
    body_length := 8 * count + 2 + 2 * 4
    u16be(out, 4)
    u16be(out, (14 + body_length) as u16)
    u16be(out, 0)
    u16be(out, (2 * count) as u16)
    u16be(out, (2 * search) as u16)
    u16be(out, log2(search) as u16)
    u16be(out, (2 * count - 2 * search) as u16)
    for i in 0usize..count {
        u16be(out, ends[i] as u16)
    }
    u16be(out, 0)
    for i in 0usize..count {
        u16be(out, starts[i] as u16)
    }
    for i in 0usize..count {
        u16be(out, deltas[i] as u16)
    }
    for i in 0usize..count {
        if ranged[i] {
            // Bytes from this idRangeOffset entry to the glyph array.
            u16be(out, (2 * (count - i)) as u16)
        } else {
            u16be(out, 0)
        }
    }
    for code in 0x41u32..0x45 {
        glyph := 0u16
        for i in 0usize..CODES.len {
            if CODES[i] == code {
                glyph = CODE_GLYPHS[i]
            }
        }
        u16be(out, glyph)
    }
}

fn cmap_format12(out: &mut regen.Buf) {
    groups := CODES.len + 1
    u16be(out, 12)
    u16be(out, 0)
    u32be(out, (16 + 12 * groups) as u32)
    u32be(out, 0)
    u32be(out, groups as u32)
    for i in 0usize..CODES.len {
        u32be(out, CODES[i])
        u32be(out, CODES[i])
        u32be(out, CODE_GLYPHS[i] as u32)
    }
    u32be(out, ASTRAL_CODE)
    u32be(out, ASTRAL_CODE)
    u32be(out, ASTRAL_GLYPH as u32)
}

fn cmap_table(out: &mut regen.Buf, with_format12: bool) {
    count := 1usize
    if with_format12 {
        count = 2
    }
    format4_storage := [0u8; 512]
    format4 := regen.Buf.new(&mut format4_storage)
    cmap_format4(&mut format4)
    offset := 4 + 8 * count
    u16be(out, 0)
    u16be(out, count as u16)
    u16be(out, 3)
    u16be(out, 1)
    u32be(out, offset as u32)
    if with_format12 {
        u16be(out, 3)
        u16be(out, 10)
        u32be(out, (offset + format4.used) as u32)
    }
    out.bytes(format4.view())
    if with_format12 {
        cmap_format12(out)
    }
}

fn kern_table(out: &mut regen.Buf) {
    count := KERNING.len
    search := search_range(count)
    u16be(out, 0)
    u16be(out, 1)
    u16be(out, 0)
    u16be(out, (6 + 8 + 6 * count) as u16)
    u16be(out, 0x0001)
    u16be(out, count as u16)
    u16be(out, (6 * search) as u16)
    u16be(out, log2(search) as u16)
    u16be(out, (6 * (count - search)) as u16)
    for i in 0usize..count {
        u16be(out, KERNING[i][0] as u16)
        u16be(out, KERNING[i][1] as u16)
        i16be(out, KERNING[i][2])
    }
}

fn head_table(out: &mut regen.Buf, long_loca: bool) {
    u32be(out, 0x00010000)
    u32be(out, 0x00010000)
    u32be(out, 0)
    u32be(out, 0x5F0F3CF5)
    u16be(out, 0x000B)
    u16be(out, UNITS_PER_EM)
    zeros(out, 16)
    i16be(out, -750)
    i16be(out, -200)
    i16be(out, 650)
    i16be(out, 900)
    u16be(out, 0)
    u16be(out, 8)
    i16be(out, 2)
    // indexToLocFormat
    if long_loca {
        i16be(out, 1)
    } else {
        i16be(out, 0)
    }
    i16be(out, 0)
}

fn hhea_table(out: &mut regen.Buf) {
    advance_max := 0u16
    for i in 0usize..GLYPH_COUNT {
        if ADVANCES[i] > advance_max {
            advance_max = ADVANCES[i]
        }
    }
    u32be(out, 0x00010000)
    i16be(out, ASCENT as i32)
    i16be(out, DESCENT as i32)
    i16be(out, LINE_GAP as i32)
    u16be(out, advance_max)
    i16be(out, 0)
    i16be(out, 0)
    i16be(out, 650)
    i16be(out, 1)
    i16be(out, 0)
    i16be(out, 0)
    zeros(out, 8)
    i16be(out, 0)
    u16be(out, METRICS as u16)
}

fn hmtx_table(out: &mut regen.Buf) {
    for i in 0usize..GLYPH_COUNT {
        if i < METRICS {
            u16be(out, ADVANCES[i])
        }
        // Left side bearing.
        i16be(out, 0)
    }
}

fn maxp_table(out: &mut regen.Buf) {
    u32be(out, 0x00010000)
    u16be(out, GLYPH_COUNT as u16)
    let rest = [64u16, 4, 64, 4, 2, 0, 0, 0, 0, 0, 0, 3, 2]
    for i in 0usize..rest.len {
        u16be(out, rest[i])
    }
}

fn checksum(data: &[u8]) -> u32 {
    sum := 0u64
    for i := 0usize; i < data.len; i += 4 {
        word := 0u64
        for k in 0usize..4 {
            word = word << 8
            if i + k < data.len {
                word = word | data[i + k] as u64
            }
        }
        sum = (sum + word) & 0xFFFFFFFF
    }
    return sum as u32
}

// An sfnt whose table offsets count from `base` bytes before it.
fn font_file(out: &mut regen.Buf, long_loca: bool, with_format12: bool, with_kern: bool, base: usize) {
    // Tables in tag order, built one after another into `scratch`.
    tags := [b"cmap", b"glyf", b"head", b"hhea", b"hmtx", b"kern", b"loca", b"maxp"]
    starts := [0usize; 9]
    present := [true; 8]
    present[5] = with_kern
    scratch_storage := [0u8; 8192]
    scratch := regen.Buf.new(&mut scratch_storage)
    offsets := [0usize; 11]
    for t in 0usize..8 {
        starts[t] = scratch.used
        match t {
            0 => {
                cmap_table(&mut scratch, with_format12)
            },
            1 => {
                glyph_table(&mut scratch, &mut offsets)
            },
            2 => {
                head_table(&mut scratch, long_loca)
            },
            3 => {
                hhea_table(&mut scratch)
            },
            4 => {
                hmtx_table(&mut scratch)
            },
            5 => {
                if with_kern {
                    kern_table(&mut scratch)
                }
            },
            6 => {
                loca_table(&mut scratch, &offsets, long_loca)
            },
            _ => {
                maxp_table(&mut scratch)
            },
        }
    }
    starts[8] = scratch.used
    let tables = scratch.view()
    count := 7usize
    if with_kern {
        count = 8
    }
    search := search_range(count)
    u32be(out, 0x00010000)
    u16be(out, count as u16)
    u16be(out, (16 * search) as u16)
    u16be(out, log2(search) as u16)
    u16be(out, (16 * (count - search)) as u16)
    offset := base + 12 + 16 * count
    for t in 0usize..8 {
        if !present[t] {
            continue
        }
        let body = &tables[starts[t]..starts[t + 1]]
        out.bytes(tags[t])
        u32be(out, checksum(body))
        u32be(out, offset as u32)
        u32be(out, body.len as u32)
        offset += (body.len + 3) / 4 * 4
    }
    for t in 0usize..8 {
        if !present[t] {
            continue
        }
        start := out.used
        out.bytes(&tables[starts[t]..starts[t + 1]])
        pad4(out, start)
    }
}

fn dodo_array(out: &mut regen.Buf, data: &[u8]) {
    out.str(ARRAY_BEGIN)
    out.uint(data.len as u64)
    out.str("]u8 = [\n")
    for i in 0usize..data.len {
        if i % 20 == 0 {
            out.str("    ")
        } else {
            out.str(", ")
        }
        out.uint(data[i] as u64)
        if i + 1 == data.len {
            out.byte(b'\n')
        } else if i % 20 == 19 {
            out.str(",\n")
        }
    }
    out.byte(b']')
}

fn main() -> i32 {
    check := false
    dodo := false
    arguments := regen.arguments()
    for i in 0usize..arguments.len() {
        if arguments.is(i, "--check") {
            check = true
        } else if arguments.is(i, "--dodo") {
            dodo = true
        } else {
            regen.fail(USAGE)
            return 2
        }
    }
    if check && dodo {
        regen.fail(USAGE)
        return 2
    }
    short_storage := [0u8; 4096]
    short := regen.Buf.new(&mut short_storage)
    font_file(&mut short, false, false, true, 0)
    array_storage := [0u8; 8192]
    array := regen.Buf.new(&mut array_storage)
    dodo_array(&mut array, short.view())
    if dodo {
        array.byte(b'\n')
        return regen.print(array.view())
    }
    long_storage := [0u8; 4096]
    long := regen.Buf.new(&mut long_storage)
    font_file(&mut long, true, true, false, 0)
    first_offset := 12usize + 8
    first_storage := [0u8; 4096]
    first := regen.Buf.new(&mut first_storage)
    font_file(&mut first, false, false, true, first_offset)
    second_storage := [0u8; 4096]
    second := regen.Buf.new(&mut second_storage)
    font_file(&mut second, true, true, false, first_offset + first.used)
    collection_storage := [0u8; 8192]
    collection := regen.Buf.new(&mut collection_storage)
    collection.str("ttcf")
    u32be(&mut collection, 0x00010000)
    u32be(&mut collection, 2)
    u32be(&mut collection, first_offset as u32)
    u32be(&mut collection, (first_offset + first.used) as u32)
    collection.bytes(first.view())
    collection.bytes(second.view())
    if !regen.locate_root(SELF) {
        return 1
    }
    status := regen.update_file(SHORT_FONT, short.view(), check, COMMAND)
    status = status | regen.update_file(LONG_FONT, long.view(), check, COMMAND)
    status = status | regen.update_file(COLLECTION, collection.view(), check, COMMAND)
    status = status | regen.update_block(CHECKS, ARRAY_BEGIN, ARRAY_END, array.view(), check, COMMAND)
    return status
}
