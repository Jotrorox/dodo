// Accents, three rows each (only the ring uses the third), indexed by the
// accent constants below.
const MEDIUM_ACCENTS: [18]&str = [
    "..#....", "...#...", ".......", // grave
    "....#..", "...#...", ".......", // acute
    "...#...", "..#.#..", ".......", // circumflex
    "..##..#", ".#..##.", ".......", // tilde
    ".......", "..#.#..", ".......", // diaeresis
    "...#...", "..#.#..", "...#...", // ring
]
const MEDIUM_CEDILLA: [3]&str = ["...#...", "....#..", "..##..."]

const GRAVE: u8 = 0
const ACUTE: u8 = 1
const CIRCUMFLEX: u8 = 2
const TILDE: u8 = 3
const DIAERESIS: u8 = 4
const RING: u8 = 5
const CEDILLA: u8 = 6

// Latin-1 letters composed from (code, base letter, accent).
const COMPOSED: [53][3]u8 = [
    [0xC0, b'A', GRAVE], [0xC1, b'A', ACUTE], [0xC2, b'A', CIRCUMFLEX],
    [0xC3, b'A', TILDE], [0xC4, b'A', DIAERESIS], [0xC5, b'A', RING],
    [0xC7, b'C', CEDILLA],
    [0xC8, b'E', GRAVE], [0xC9, b'E', ACUTE], [0xCA, b'E', CIRCUMFLEX],
    [0xCB, b'E', DIAERESIS],
    [0xCC, b'I', GRAVE], [0xCD, b'I', ACUTE], [0xCE, b'I', CIRCUMFLEX],
    [0xCF, b'I', DIAERESIS],
    [0xD1, b'N', TILDE],
    [0xD2, b'O', GRAVE], [0xD3, b'O', ACUTE], [0xD4, b'O', CIRCUMFLEX],
    [0xD5, b'O', TILDE], [0xD6, b'O', DIAERESIS],
    [0xD9, b'U', GRAVE], [0xDA, b'U', ACUTE], [0xDB, b'U', CIRCUMFLEX],
    [0xDC, b'U', DIAERESIS],
    [0xDD, b'Y', ACUTE],
    [0xE0, b'a', GRAVE], [0xE1, b'a', ACUTE], [0xE2, b'a', CIRCUMFLEX],
    [0xE3, b'a', TILDE], [0xE4, b'a', DIAERESIS], [0xE5, b'a', RING],
    [0xE7, b'c', CEDILLA],
    [0xE8, b'e', GRAVE], [0xE9, b'e', ACUTE], [0xEA, b'e', CIRCUMFLEX],
    [0xEB, b'e', DIAERESIS],
    [0xEC, b'i', GRAVE], [0xED, b'i', ACUTE], [0xEE, b'i', CIRCUMFLEX],
    [0xEF, b'i', DIAERESIS],
    [0xF1, b'n', TILDE],
    [0xF2, b'o', GRAVE], [0xF3, b'o', ACUTE], [0xF4, b'o', CIRCUMFLEX],
    [0xF5, b'o', TILDE], [0xF6, b'o', DIAERESIS],
    [0xF9, b'u', GRAVE], [0xFA, b'u', ACUTE], [0xFB, b'u', CIRCUMFLEX],
    [0xFC, b'u', DIAERESIS],
    [0xFD, b'y', ACUTE], [0xFF, b'y', DIAERESIS],
]

// ---------------------------------------------------------------------------
// A glyph is one byte per row, the leftmost column in the top bit, so the
// spacing column to the right of the art is always clear. A font stores
// glyphs for codes 0-255 at `code * height` with a flag per code saying
// whether it is drawn.

// A row of art as a byte; none if it has the wrong width or other characters.
fn row_bits(row: &[u8], width: usize) -> Option<u8> {
    if row.len != width {
        return none
    }
    value := 0u8
    for column in 0usize..width {
        if row[column] == b'#' {
            value = value | (0x80u8 >> column as u8)
        } else if row[column] != b'.' {
            return none
        }
    }
    return some(value)
}

fn bits(row: &str) -> u8 {
    let bytes = mem.str_bytes(row)
    match row_bits(bytes, bytes.len) {
        some(value) => {
            return value
        },
        none => {
            return 0
        },
    }
}

// The whitespace-separated words of a line.
struct Words {
    starts: [16]usize
    ends: [16]usize
    count: usize

    fn split(line: &[u8]) -> Words {
        words := Words { starts: [0usize; 16], ends: [0usize; 16], count: 0 }
        i := 0usize
        for i < line.len {
            if line[i] == b' ' {
                i += 1
                continue
            }
            start := i
            for i < line.len && line[i] != b' ' {
                i += 1
            }
            if words.count < 16 {
                words.starts[words.count] = start
                words.ends[words.count] = i
            }
            words.count += 1
        }
        return words
    }
    fn word(&self, line: &[u8], index: usize) -> &[u8] from(line) {
        return &line[self.starts[index]..self.ends[index]]
    }
}

fn hex_value(digit: u8) -> Option<usize> {
    match digit {
        b'0'..=b'9' => {
            return some((digit - b'0') as usize)
        },
        b'a'..=b'f' => {
            return some((digit - b'a' + 10) as usize)
        },
        b'A'..=b'F' => {
            return some((digit - b'A' + 10) as usize)
        },
        _ => {
            return none
        },
    }
}

fn name_to_code(name: &[u8]) -> Option<usize> {
    if name.len == 1 {
        return some(name[0] as usize)
    }
    if regen.same(name, mem.str_bytes("SP")) {
        return some(0x20)
    }
    if name.len < 3 || name.len > 4 || name[0] != b'U' || name[1] != b'+' {
        return none
    }
    code := 0usize
    for i in 2usize..name.len {
        match hex_value(name[i]) {
            some(value) => {
                code = code * 16 + value
            },
            none => {
                return none
            },
        }
    }
    return some(code)
}

// Prints "<what> <name>: <problem>" and returns false.
fn malformed(what: &str, name: &[u8], problem: &str) -> bool {
    storage := [0u8; 256]
    message := regen.Buf.new(&mut storage)
    message.str(what)
    message.byte(b' ')
    message.bytes(name)
    message.str(": ")
    message.str(problem)
    used := message.used
    unsafe {
        regen.fail(mem.str_from_utf8(&storage[..used]))
    }
    return false
}

fn blank(line: &[u8]) -> bool {
    for i in 0usize..line.len {
        if line[i] != b' ' {
            return false
        }
    }
    return true
}

// Parses bands of art: a header naming each glyph, then `rows` lines of art.
// Glyph rows go to `glyphs[code * height + top + row]`.
fn parse(art: &[&str], rows: usize, width: usize, height: usize, top: usize, glyphs: &mut[u8], drawn: &mut[bool]) -> bool {
    index := 0usize
    for index < art.len {
        let header = mem.str_bytes(art[index])
        if blank(header) {
            index += 1
            continue
        }
        names := Words.split(header)
        if names.count > 16 {
            return malformed("band", header, "more than 16 glyphs")
        }
        if index + rows >= art.len {
            return malformed("band", header, "too few rows")
        }
        for row in 0usize..rows {
            let line = mem.str_bytes(art[index + 1 + row])
            cells := Words.split(line)
            if cells.count != names.count {
                return malformed("band", header, "a row has the wrong number of cells")
            }
        }
        for column in 0usize..names.count {
            let name = names.word(header, column)
            code := 0usize
            match name_to_code(name) {
                some(value) => {
                    code = value
                },
                none => {
                    return malformed("glyph", name, "bad glyph name")
                },
            }
            if code < FIRST || code > LAST {
                return malformed("glyph", name, "outside U+0020 to U+00FF")
            }
            if drawn[code] {
                return malformed("glyph", name, "defined twice")
            }
            for row in 0usize..rows {
                let line = mem.str_bytes(art[index + 1 + row])
                cells := Words.split(line)
                match row_bits(cells.word(line, column), width) {
                    some(value) => {
                        glyphs[code * height + top + row] = value
                    },
                    none => {
                        return malformed("glyph", name, "malformed row")
                    },
                }
            }
            drawn[code] = true
        }
        index += 1 + rows
    }
    return true
}

fn is_upper(letter: u8) -> bool {
    return letter >= b'A' && letter <= b'Z'
}

fn small_font(glyphs: &mut[u8], drawn: &mut[bool]) -> bool {
    if !parse(&SMALL_ART, 8, 5, 8, 0, glyphs, drawn) {
        return false
    }
    // Short capitals sit in rows 2-6, leaving rows 0-1 for the accent.
    short := [0u8; 2048]
    short_drawn := [false; 256]
    if !parse(&SMALL_SHORT_CAPS, 5, 5, 8, 2, &mut short, &mut short_drawn) {
        return false
    }
    for i in 0usize..COMPOSED.len {
        code := COMPOSED[i][0] as usize
        base := COMPOSED[i][1] as usize
        accent := COMPOSED[i][2] as usize
        for row in 0usize..8 {
            if accent == CEDILLA as usize {
                glyphs[code * 8 + row] = glyphs[base * 8 + row]
            } else if is_upper(base as u8) {
                glyphs[code * 8 + row] = short[base * 8 + row]
            } else if base == b'i' as usize {
                glyphs[code * 8 + row] = bits(SMALL_DOTLESS_I[row])
            } else {
                glyphs[code * 8 + row] = glyphs[base * 8 + row]
            }
        }
        if accent == CEDILLA as usize {
            glyphs[code * 8 + 7] = glyphs[code * 8 + 7] | bits(SMALL_CEDILLA)
        } else {
            for row in 0usize..2 {
                glyphs[code * 8 + row] = glyphs[code * 8 + row] | bits(SMALL_ACCENTS[accent * 2 + row])
            }
        }
        drawn[code] = true
    }
    return true
}

fn medium_font(glyphs: &mut[u8], drawn: &mut[bool]) -> bool {
    if !parse(&MEDIUM_ART, 13, 7, 16, 3, glyphs, drawn) {
        return false
    }
    for i in 0usize..COMPOSED.len {
        code := COMPOSED[i][0] as usize
        base := COMPOSED[i][1] as usize
        accent := COMPOSED[i][2] as usize
        for row in 0usize..16 {
            glyphs[code * 16 + row] = glyphs[base * 16 + row]
        }
        if base == b'i' as usize {
            // Dotless i: drop the dot at row 4.
            glyphs[code * 16 + 4] = 0
        }
        for row in 0usize..3 {
            if accent == CEDILLA as usize {
                glyphs[code * 16 + 13 + row] = glyphs[code * 16 + 13 + row] | bits(MEDIUM_CEDILLA[row])
            } else if is_upper(base as u8) {
                glyphs[code * 16 + row] = glyphs[code * 16 + row] | bits(MEDIUM_ACCENTS[accent * 3 + row])
            } else {
                glyphs[code * 16 + 3 + row] = glyphs[code * 16 + 3 + row] | bits(MEDIUM_ACCENTS[accent * 3 + row])
            }
        }
        drawn[code] = true
    }
    return true
}

// Row `row` of the box std/graphics draws for characters outside a font.
fn replacement_row(width: usize, height: usize, row: usize) -> u8 {
    inner := width - 1
    if row >= height - 1 {
        return 0
    }
    // The top `inner` columns set, or just the first and last of them.
    full := ((0xFF00u16 >> inner as u16) & 0xFF) as u8
    if row == 0 || row == height - 2 {
        return full
    }
    return 0x80 | (0x80u8 >> (inner - 1) as u8)
}

fn glyph_row(glyphs: &[u8], drawn: &[bool], width: usize, height: usize, code: usize, row: usize) -> u8 {
    if drawn[code] {
        return glyphs[code * height + row]
    }
    return replacement_row(width, height, row)
}

fn dodo_array(out: &mut regen.Buf, name: &str, glyphs: &[u8], drawn: &[bool], width: usize, height: usize) {
    count := (LAST + 1 - FIRST) * height
    out.str("static ")
    out.str(name)
    out.str(": [")
    out.uint(count as u64)
    out.str("]u8 = [\n")
    for index in 0usize..count {
        if index % 16 == 0 {
            out.str("    ")
        } else {
            out.str(", ")
        }
        out.str("0x")
        out.hex2(glyph_row(glyphs, drawn, width, height, FIRST + index / height, index % height), false)
        if index + 1 == count {
            out.byte(b'\n')
        } else if index % 16 == 15 {
            out.str(",\n")
        }
    }
    out.byte(b']')
}

fn preview(out: &mut regen.Buf, name: &str, glyphs: &[u8], drawn: &[bool], width: usize, height: usize) {
    out.str("== ")
    out.str(name)
    out.str(" ==\n")
    for start := FIRST; start <= LAST; start += 16 {
        // 224 codes make 14 full bands of 16.
        stop := start + 16
        for code in start..stop {
            if code > start {
                out.str("  ")
            }
            out.hex2(code as u8, true)
            for _ in 2usize..width {
                out.byte(b' ')
            }
        }
        out.byte(b'\n')
        for row in 0usize..height {
            for code in start..stop {
                if code > start {
                    out.str("  ")
                }
                value := glyph_row(glyphs, drawn, width, height, code, row)
                for column in 0usize..width {
                    if (value & (0x80u8 >> column as u8)) != 0 {
                        out.byte(b'#')
                    } else {
                        out.byte(b'.')
                    }
                }
            }
            out.byte(b'\n')
        }
        out.byte(b'\n')
    }
}

fn main() -> i32 {
    check := false
    write := false
    show := false
    modes := 0
    arguments := regen.arguments()
    for i in 0usize..arguments.len() {
        if arguments.is(i, "--check") {
            check = true
        } else if arguments.is(i, "--write") {
            write = true
        } else if arguments.is(i, "--preview") {
            show = true
        } else {
            regen.fail(USAGE)
            return 2
        }
        modes += 1
    }
    if modes > 1 {
        regen.fail(USAGE)
        return 2
    }
    small := [0u8; 2048]
    small_drawn := [false; 256]
    medium := [0u8; 4096]
    medium_drawn := [false; 256]
    if !small_font(&mut small, &mut small_drawn) || !medium_font(&mut medium, &mut medium_drawn) {
        return 1
    }
    block_storage := [0u8; 131072]
    out := regen.Buf.new(&mut block_storage)
    if show {
        preview(&mut out, "SMALL", &small, &small_drawn, 6, 8)
        preview(&mut out, "MEDIUM", &medium, &medium_drawn, 8, 16)
        return regen.print(out.view())
    }
    out.str(BEGIN)
    out.str("\n// Generated by scripts/gen/graphics_fonts.dodo; edit the art there and run it with --write.\n")
    dodo_array(&mut out, "SMALL_GLYPHS", &small, &small_drawn, 6, 8)
    out.byte(b'\n')
    dodo_array(&mut out, "MEDIUM_GLYPHS", &medium, &medium_drawn, 8, 16)
    out.byte(b'\n')
    out.str(END)
    if !check && !write {
        out.byte(b'\n')
        return regen.print(out.view())
    }
    if !regen.locate_root(SELF) {
        return 1
    }
    return regen.update_block(TARGET, BEGIN, END, out.view(), check, COMMAND)
}
