package main

import "core/mem"
import "regen"

// Generates the bitmap font tables in stdlib/std/graphics/font.dodo.
//
// The glyphs below were drawn for Dodo and are dedicated to the public domain
// along with the rest of this file's data. Both fonts cover U+0020 through
// U+00FF (ASCII and Latin-1). Accented Latin-1 letters are composed from a base
// letter and an accent; code points without a drawing (the C1 controls and a
// few symbols) store the replacement box that std/graphics also draws for
// characters outside a font.
//
// SMALL is 6x8: glyphs are 5 columns wide plus one column of spacing, capitals
// use rows 0-6 and descenders row 7. Accented capitals use 5-row capitals so
// the accent fits in rows 0-1.
//
// MEDIUM is 8x16: glyphs are 7 columns wide plus one of spacing. Rows 0-2 hold
// accents over capitals, capitals use rows 3-12, lowercase x-height rows 6-12,
// descenders rows 13-15. The art below starts at row 3.
//
// The art is in bands: a line naming each glyph (a character, SP for the
// space, or U+XX), then one line per row. `"` and `\` are named U+22 and U+5C
// so the art needs no escapes.
//
//     dodo run scripts/gen/graphics_fonts.dodo -- --check
//
// --check verifies the checked-in block, --write regenerates it, --preview
// prints every glyph as text; with none of them the block is printed. Run it
// anywhere inside the repository.

const SELF: &str = "scripts/gen/graphics_fonts.dodo"
const TARGET: &str = "stdlib/std/graphics/font.dodo"
const BEGIN: &str = "// BEGIN GENERATED FONTS"
const END: &str = "// END GENERATED FONTS"
const COMMAND: &str = "`dodo run scripts/gen/graphics_fonts.dodo -- --write`"
const USAGE: &str = "usage: dodo run scripts/gen/graphics_fonts.dodo -- [--check | --write | --preview]"
const FIRST: usize = 0x20
const LAST: usize = 0xFF

