package main

import "std/math"
import "regen"

// Generates the integer transfer-curve tables in stdlib/std/image/color.dodo.
//
// The sRGB curve (IEC 61966-2-1) is evaluated in binary64: a division where
// it is linear and std/math's pow for the power segment, then rounded to the
// nearest 16-bit code. std/math's pow is not correctly rounded (it differs
// from the C library's pow by up to 4 ulps on these inputs), but no value
// lies within 1e-6 of a rounding boundary, so the codes match the earlier
// Python generator, which used the C library, exactly.
//
//     dodo run scripts/gen/image_tables.dodo -- --check
//
// --write updates the file in place and --check verifies it; with neither,
// the generated block is printed. Run it anywhere inside the repository.

const SELF: &str = "scripts/gen/image_tables.dodo"
const TARGET: &str = "stdlib/std/image/color.dodo"
const BEGIN: &str = "// BEGIN GENERATED IMAGE TABLES"
const END: &str = "// END GENERATED IMAGE TABLES"
const COMMAND: &str = "`dodo run scripts/gen/image_tables.dodo -- --write`"
const USAGE: &str = "usage: dodo run scripts/gen/image_tables.dodo -- [--write | --check]"

fn srgb_to_linear(v: f64) -> f64 {
    if v <= 0.04045 {
        return v / 12.92
    }
    return math.pow((v + 0.055) / 1.055, 2.4)!
}

fn linear_to_srgb(v: f64) -> f64 {
    if v <= 0.0031308 {
        return v * 12.92
    }
    return 1.055 * math.pow(v, 1.0 / 2.4)! - 0.055
}

fn code(value: f64) -> u64 {
    scaled := math.trunc(value * 65535.0 + 0.5)
    if scaled < 0.0 {
        return 0
    }
    if scaled > 65535.0 {
        return 65535
    }
    return scaled as u64
}

fn table(out: &mut regen.Buf, name: &str, values: &[u64]) {
    out.str("static ")
    out.str(name)
    out.str(": [")
    out.uint(values.len as u64)
    out.str("]u16 = [\n")
    for start := 0usize; start < values.len; start += 16 {
        out.str("    ")
        for i := start; i < start + 16 && i < values.len; i += 1 {
            if i > start {
                out.str(", ")
            }
            out.uint(values[i])
        }
        if start + 16 < values.len {
            out.byte(b',')
        }
        out.byte(b'\n')
    }
    out.byte(b']')
}

fn block(out: &mut regen.Buf) {
    // Knots at every 8-bit code (v = i * 257), so 8-bit input is exact.
    to_linear := [0u64; 256]
    for i in 0usize..256 {
        to_linear[i] = code(srgb_to_linear(i as f64 / 255.0))
    }
    // Knots every 16 linear codes; the last knot is the curve at 1.0.
    to_srgb := [0u64; 4097]
    for j in 0usize..4097 {
        linear := j * 16
        if linear > 65535 {
            linear = 65535
        }
        to_srgb[j] = code(linear_to_srgb(linear as f64 / 65535.0))
    }
    out.str(BEGIN)
    out.str("\n// Generated by ")
    out.str(COMMAND)
    out.str(".\n")
    table(out, "SRGB_TO_LINEAR", &to_linear)
    out.byte(b'\n')
    table(out, "LINEAR_TO_SRGB", &to_srgb)
    out.byte(b'\n')
    out.str(END)
}

fn main() -> i32 {
    write := false
    check := false
    arguments := regen.arguments()
    for i in 0usize..arguments.len() {
        if arguments.is(i, "--write") {
            write = true
        } else if arguments.is(i, "--check") {
            check = true
        } else {
            regen.fail(USAGE)
            return 2
        }
    }
    block_storage := [0u8; 65536]
    generated := regen.Buf.new(&mut block_storage)
    block(&mut generated)
    if !write && !check {
        generated.byte(b'\n')
        return regen.print(generated.view())
    }
    if !regen.locate_root(SELF) {
        return 1
    }
    return regen.update_block(TARGET, BEGIN, END, generated.view(), check, COMMAND)
}
