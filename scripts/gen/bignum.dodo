package bignum

// Minimal fixed-width unsigned integer arithmetic for scripts/gen/math_constants.dodo.
//
// A Big is LIMBS little-endian 32-bit limbs (6144 bits). Every operation is
// exact: results that would overflow the width or go negative trap instead of
// wrapping, so a silently wrong constant cannot be produced. Only the
// operations that generator needs are provided; speed is not a goal.

pub const LIMBS: usize = 192
pub type Big = [192]u32

const MASK: u64 = 0xffffffff

pub fn zero() -> Big {
    return [0u32; 192]
}

pub fn copy(a: &Big) -> Big {
    result := zero()
    for i in 0usize..LIMBS {
        result[i] = a[i]
    }
    return result
}

pub fn from_u64(value: u64) -> Big {
    result := zero()
    result[0] = (value & MASK) as u32
    result[1] = (value >> 32) as u32
    return result
}

// 2**bits.
pub fn pow2(bits: usize) -> Big {
    result := zero()
    result[bits / 32] = 1u32 << (bits % 32) as u32
    return result
}

// The number of limbs up to and including the most significant nonzero one.
fn used(a: &Big) -> usize {
    n := LIMBS
    for n > 0 && a[n - 1] == 0 {
        n = n - 1
    }
    return n
}

pub fn is_zero(a: &Big) -> bool {
    return used(a) == 0
}

pub fn bit_length(a: &Big) -> usize {
    n := used(a)
    if n == 0 {
        return 0
    }
    top := a[n - 1]
    bits := 0usize
    for top != 0 {
        top = top >> 1
        bits = bits + 1
    }
    return 32 * (n - 1) + bits
}

// The low 64 bits; traps if the value does not fit.
pub fn to_u64(a: &Big) -> u64 {
    assert(used(a) <= 2, "bignum: value does not fit in u64")
    return (a[1] as u64 << 32) | a[0] as u64
}

// -1, 0 or 1 as a is less than, equal to or greater than b.
pub fn compare(a: &Big, b: &Big) -> i32 {
    i := LIMBS
    for i > 0 {
        i = i - 1
        if a[i] != b[i] {
            if a[i] < b[i] {
                return -1
            }
            return 1
        }
    }
    return 0
}

pub fn equal(a: &Big, b: &Big) -> bool {
    return compare(a, b) == 0
}

pub fn add(a: &Big, b: &Big) -> Big {
    result := zero()
    carry := 0u64
    for i in 0usize..LIMBS {
        t := a[i] as u64 + b[i] as u64 + carry
        result[i] = (t & MASK) as u32
        carry = t >> 32
    }
    assert(carry == 0, "bignum: addition overflow")
    return result
}

pub fn add_small(a: &Big, b: u64) -> Big {
    other := from_u64(b)
    return add(a, &other)
}

// a - b; traps if b > a.
pub fn sub(a: &Big, b: &Big) -> Big {
    result := zero()
    borrow := 0u64
    for i in 0usize..LIMBS {
        subtrahend := b[i] as u64 + borrow
        if a[i] as u64 >= subtrahend {
            result[i] = (a[i] as u64 - subtrahend) as u32
            borrow = 0
        } else {
            result[i] = (a[i] as u64 + (1u64 << 32) - subtrahend) as u32
            borrow = 1
        }
    }
    assert(borrow == 0, "bignum: subtraction underflow")
    return result
}

pub fn sub_small(a: &Big, b: u64) -> Big {
    other := from_u64(b)
    return sub(a, &other)
}

pub fn mul_small(a: &Big, b: u32) -> Big {
    result := zero()
    carry := 0u64
    for i in 0usize..LIMBS {
        t := a[i] as u64 * b as u64 + carry
        result[i] = (t & MASK) as u32
        carry = t >> 32
    }
    assert(carry == 0, "bignum: multiplication overflow")
    return result
}

pub fn shl(a: &Big, bits: usize) -> Big {
    assert(bit_length(a) + bits <= 32 * LIMBS, "bignum: shift overflow")
    result := zero()
    limbs := bits / 32
    offset := (bits % 32) as u64
    for i in limbs..LIMBS {
        low := a[i - limbs] as u64 << offset
        high := if offset == 0 || i == limbs {
            0u64
        } else {
            a[i - limbs - 1] as u64 >> (32 - offset)
        }
        result[i] = ((low | high) & MASK) as u32
    }
    return result
}

// floor(a / 2**bits).
pub fn shr(a: &Big, bits: usize) -> Big {
    result := zero()
    limbs := bits / 32
    offset := (bits % 32) as u64
    for i in 0usize..LIMBS {
        if i + limbs < LIMBS {
            low := a[i + limbs] as u64 >> offset
            high := if offset == 0 || i + limbs + 1 >= LIMBS {
                0u64
            } else {
                (a[i + limbs + 1] as u64 << (32 - offset)) & MASK
            }
            result[i] = (low | high) as u32
        }
    }
    return result
}

// Bits [shift, shift + width) of a, for width <= 32.
pub fn bits_at(a: &Big, shift: usize, width: usize) -> u32 {
    part := shr(a, shift)
    return (part[0] as u64 & ((1u64 << width as u64) - 1)) as u32
}

// floor(a / b) for a small divisor; the remainder goes to remainder.
pub fn div_small(a: &Big, b: u32, remainder: &mut u64) -> Big {
    assert(b != 0, "bignum: division by zero")
    result := zero()
    rest := 0u64
    i := LIMBS
    for i > 0 {
        i = i - 1
        current := (rest << 32) | a[i] as u64
        result[i] = (current / b as u64) as u32
        rest = current % b as u64
    }
    *remainder = rest
    return result
}

// quotient = floor(a / b), remainder = a - quotient * b (Knuth, TAOCP vol. 2,
// 4.3.1, Algorithm D).
pub fn divide(a: &Big, b: &Big, quotient: &mut Big, remainder: &mut Big) {
    n := used(b)
    assert(n != 0, "bignum: division by zero")
    if compare(a, b) < 0 {
        *quotient = zero()
        *remainder = copy(a)
        return
    }
    if n == 1 {
        rest := 0u64
        *quotient = div_small(a, b[0], &mut rest)
        *remainder = from_u64(rest)
        return
    }
    m := used(a) - n
    // Normalize so the divisor's top limb has its high bit set.
    shift := 0u64
    for ((b[n - 1] << shift as u32) & 0x80000000) == 0 {
        shift = shift + 1
    }
    vn := [0u32; 192]
    un := [0u32; 193]
    for i in 0usize..n {
        high := (b[i] as u64 << shift) & MASK
        low := if shift == 0 || i == 0 {
            0u64
        } else {
            b[i - 1] as u64 >> (32 - shift)
        }
        vn[i] = (high | low) as u32
    }
    for i in 0usize..LIMBS + 1 {
        high := if i < LIMBS {
            (a[i] as u64 << shift) & MASK
        } else {
            0u64
        }
        low := if shift == 0 || i == 0 {
            0u64
        } else {
            a[i - 1] as u64 >> (32 - shift)
        }
        un[i] = (high | low) as u32
    }
    q := zero()
    top := vn[n - 1] as u64
    second := vn[n - 2] as u64
    j := m + 1
    for j > 0 {
        j = j - 1
        numerator := (un[j + n] as u64 << 32) | un[j + n - 1] as u64
        qhat := numerator / top
        rhat := numerator % top
        for qhat > MASK || qhat * second > ((rhat << 32) | un[j + n - 2] as u64) {
            qhat = qhat - 1
            rhat = rhat + top
            if rhat > MASK {
                break
            }
        }
        // Multiply and subtract qhat * vn from un[j..j + n].
        k := 0i64
        for i in 0usize..n {
            p := qhat * vn[i] as u64
            t := un[i + j] as i64 - k - (p & MASK) as i64
            un[i + j] = (t & MASK as i64) as u32
            k = (p >> 32) as i64 - (t >> 32)
        }
        t := un[j + n] as i64 - k
        un[j + n] = (t & MASK as i64) as u32
        if t < 0 {
            // qhat was one too large: add the divisor back.
            qhat = qhat - 1
            carry := 0u64
            for i in 0usize..n {
                s := un[i + j] as u64 + vn[i] as u64 + carry
                un[i + j] = (s & MASK) as u32
                carry = s >> 32
            }
            un[j + n] = ((un[j + n] as u64 + carry) & MASK) as u32
        }
        q[j] = qhat as u32
    }
    *quotient = q
    r := zero()
    for i in 0usize..n {
        low := un[i] as u64 >> shift
        high := if shift == 0 {
            0u64
        } else {
            (un[i + 1] as u64 << (32 - shift)) & MASK
        }
        r[i] = (low | high) as u32
    }
    *remainder = r
}

pub fn div(a: &Big, b: &Big) -> Big {
    q := zero()
    r := zero()
    divide(a, b, &mut q, &mut r)
    return q
}
