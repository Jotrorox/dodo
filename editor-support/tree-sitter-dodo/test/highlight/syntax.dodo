package syntax
// <- keyword
//      ^ type
import "core/bytes" as bytes
// <- keyword
//     ^ string
//                     ^ type

@repr(C)
// <- attribute
struct Buffer<T> {
// <- keyword
//     ^ type
//            ^ type
    value: T
//  ^ property

    fn view(&self) -> &T from(self) {
//  ^ keyword
//     ^ function
//           ^ variable.special
//                 ^ operator
//                     ^ type
//                       ^ keyword
        return &self.value
//      ^ keyword
//                   ^ property
    }
}

enum State { Ready, Failed(code: i32) }
//   ^ type
//           ^ variant
//                               ^ type.builtin

fn main(count: i32) -> i32 {
// ^ function
//      ^ variable.parameter
//             ^ type.builtin
    let enabled = true
//  ^ keyword
//                ^ boolean
    missing := none
//          ^ operator
//             ^ constant.builtin
    text := "hello\n\u{1F426}"
//          ^ string
//                ^ string.escape
    path := b"//directory/file"
//          ^ string
    byte := b'\x41'
//          ^ string
//            ^ string.escape
    values := [0xffu8, 0o755u32, 0b1010, 1_000usize, 1.5e-2f64, 2f32]
//             ^ number
//                                                   ^ number
    for i in 0..10 {
//  ^ keyword
//        ^ keyword
//           ^ number
//            ^ operator
        assert_eq(i << 1, i * 2)
//      ^ function
//                  ^ operator
    }
    bytes.equal(path, b"//directory/file")
//        ^ function
    identity::<i32>(count)
//  ^ function
    identity<i32>(count)
//  ^ function
    let smaller = count < enabled
//                ^ variable
//                      ^ operator
    // Comments contain fn fake() {} and "strings" without syntax effects.
//  ^ comment
    return count
}
