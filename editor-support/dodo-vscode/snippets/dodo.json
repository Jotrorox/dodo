{
  "Main program": {
    "prefix": "main",
    "body": ["package ${1:main}", "", "fn main() -> i32 {", "    $0", "    return 0", "}"],
    "description": "Dodo program with a main entry point"
  },
  "Package declaration": {
    "prefix": "package",
    "body": "package ${1:name}",
    "description": "Declare the file's package"
  },
  "Import": {
    "prefix": "import",
    "body": "import \"${1:std/io}\"",
    "description": "Import a package by path"
  },
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) -> ${3:void} {", "    $0", "}"],
    "description": "Declare a function"
  },
  "Public function": {
    "prefix": "pubfn",
    "body": ["pub fn ${1:name}(${2}) -> ${3:void} {", "    $0", "}"],
    "description": "Declare an exported function"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "    ${2:value}: ${3:i32}", "    $0", "}"],
    "description": "Declare a struct"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "    ${2:First},", "    ${3:Second},", "}"],
    "description": "Declare an enum"
  },
  "Borrowing method": {
    "prefix": "method",
    "body": ["pub fn ${1:name}(&self) -> ${2:void} {", "    $0", "}"],
    "description": "Add a shared-borrow method inside a struct"
  },
  "Immutable binding": {
    "prefix": "let",
    "body": "let ${1:name} = ${2:value}",
    "description": "Bind an immutable value"
  },
  "Mutable binding": {
    "prefix": "var",
    "body": "${1:name} := ${2:0i32}",
    "description": "Bind a mutable value with an inferred type"
  },
  "Constant": {
    "prefix": "const",
    "body": "const ${1:NAME}: ${2:usize} = ${3:0}",
    "description": "Declare a compile-time constant"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "    $0", "}"],
    "description": "Conditional block"
  },
  "If else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition} {", "    ${2}", "} else {", "    $0", "}"],
    "description": "Conditional with an alternative"
  },
  "Range loop": {
    "prefix": "for",
    "body": ["for ${1:i} in ${2:0}..${3:count} {", "    $0", "}"],
    "description": "Loop over an exclusive integer range"
  },
  "Collection loop": {
    "prefix": "foreach",
    "body": ["for ${1:item} in ${2:items} {", "    $0", "}"],
    "description": "Borrow each collection element"
  },
  "Match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "    ${2:pattern} => {", "        ${3}", "    },", "    _ => {", "        $0", "    },", "}"],
    "description": "Match patterns with a fallback arm"
  },
  "Option match": {
    "prefix": "matchoption",
    "body": ["match ${1:value} {", "    some(${2:item}) => {", "        ${3}", "    },", "    none => {", "        $0", "    },", "}"],
    "description": "Handle both Option cases"
  },
  "Result match": {
    "prefix": "matchresult",
    "body": ["match ${1:result} {", "    ok(${2:value}) => {", "        ${3}", "    },", "    err(${4:error}) => {", "        $0", "    },", "}"],
    "description": "Handle both Result cases"
  },
  "Unsafe block": {
    "prefix": "unsafe",
    "body": ["// SAFETY: ${1:explain the caller's guarantees}", "unsafe {", "    $0", "}"],
    "description": "Unsafe block with a safety explanation"
  },
  "Test": {
    "prefix": "test",
    "body": ["@test", "fn ${1:checks_behavior}() {", "    assert_eq(${2:actual}, ${3:expected})", "    $0", "}"],
    "description": "Add a test discovered by dodo test"
  },
  "Equality assertion": {
    "prefix": "assert_eq",
    "body": "assert_eq(${1:actual}, ${2:expected})",
    "description": "Assert that two values are equal"
  }
}
