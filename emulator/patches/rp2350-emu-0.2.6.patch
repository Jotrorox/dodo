+#[cfg(test)]
+mod acquire_release_tests {
+    use super::*;
+
+    // STL r1, [r0] then LDA r2, [r0]: E8C0 1FAF, E8D0 2FAF.
+    #[test]
+    fn stl_and_lda_store_and_load_words() {
+        let mut bus = crate::bus::Bus::default();
+        let mut c = CortexM33::for_test(0);
+        c.regs.r[0] = 0x2000_1000;
+        c.regs.r[1] = 0xCAFE_F00D;
+        c.execute_one_wide_with_bus(0xE8C0, 0x1FAF, &mut bus);
+        c.execute_one_wide_with_bus(0xE8D0, 0x2FAF, &mut bus);
+        assert_eq!(c.regs.r[2], 0xCAFE_F00D);
+        assert!(c.pending_fault.is_none());
+    }
+
+    // LDAEX r2, [r0] then STLEX r3, r1, [r0]: E8D0 2FEF, E8C0 1FE3.
+    #[test]
+    fn ldaex_and_stlex_pair_succeeds() {
+        let mut bus = crate::bus::Bus::default();
+        let mut c = CortexM33::for_test(0);
+        c.regs.r[0] = 0x2000_1000;
+        c.regs.r[1] = 7;
+        c.execute_one_wide_with_bus(0xE8D0, 0x2FEF, &mut bus);
+        c.execute_one_wide_with_bus(0xE8C0, 0x1FE3, &mut bus);
+        assert_eq!(c.regs.r[3], 0, "STLEX succeeds after LDAEX");
+        c.execute_one_wide_with_bus(0xE8C0, 0x1FE3, &mut bus);
+        assert_eq!(c.regs.r[3], 1, "STLEX fails without a monitor");
+        c.execute_one_wide_with_bus(0xE8D0, 0x2FAF, &mut bus);
+        assert_eq!(c.regs.r[2], 7);
+    }
+}
