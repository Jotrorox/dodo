package json_strings_bench

import "core/ptr"
import "core/mem"
import "std/console"
import "std/io"
import "std/time/hosted"
import "std/encoding/json"

fn main() {
    input := console.stdin()
    header := [0u8; 16]
    io.read_exact(&mut input, &mut header)!
    iterations := 0u64
    for i in 0usize..8 {
        iterations |=(header[i] as u64) << ((i * 8) as u64)
    }
    storage := [0u8; 4096]
    report := io.read_bounded(&mut input, &mut storage)!
    count := report.read
    assert(report.eof && count > 2 && iterations > 0)
    assert_eq(storage[count - 2], 48u8)
    mode := header[8]
    checksum := 0u64
    clock := hosted.MonotonicClock.new()
    if mode == 0 {
        start := clock.now()!
        for i in 0u64..iterations {
            digit := (unsafe {
                ptr.read_volatile(ptr.from_ref(&i))
            } % 2) as u8
            storage[count - 2] = 48 + digit
            value := json.parse(&storage[..count])!
            checksum += value.raw().len as u64 + digit as u64
        }
        end := clock.now()!
        elapsed := end.duration_since(&start)!
        console.printf("{} {}\n", elapsed.to_nanos()!, checksum)!
        return
    }

    alternate := [0u8; 4096]
    for i in 0usize..count {
        alternate[i] = storage[i]
    }
    alternate[count - 2] = 49
    first := json.parse(&storage[..count])!
    second := json.parse(&alternate[..count])!
    values := [first.into_string()!, second.into_string()!]
    reference := [0u8; 4096]
    expected := values[0].decode(&mut reference)!
    plain := json.String.from_str(expected)
    length := plain.decoded_len()
    output := [0u8; 4096]
    start := clock.now()!
    for i in 0u64..iterations {
        // Select equal or last-byte-different input through a volatile index;
        // parsing and construction of the reference stay outside this timer.
        index := (unsafe {
            ptr.read_volatile(ptr.from_ref(&i))
        } % 2) as usize
        value := &values[index]
        if mode == 1 {
            if value.equal(&plain) {
                checksum += 1
            }
        } else if mode == 2 {
            checksum += value.decoded_len() as u64
        } else {
            decoded := value.decode(&mut output)!
            written := mem.str_bytes(decoded)
            assert_eq(written.len, length)
            checksum += written.len as u64 + written[length - 1] as u64
        }
    }
    end := clock.now()!
    elapsed := end.duration_since(&start)!
    if mode == 3 {
        // Check all output bytes, not only the timed checksum's final byte.
        selected := &values[((iterations - 1) % 2) as usize]
        assert(selected.equals(unsafe {
            mem.str_from_utf8(&output[..length])
        }))
    }
    console.printf("{} {}\n", elapsed.to_nanos()!, checksum)!
}
