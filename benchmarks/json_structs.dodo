package json_structs_bench

import "core/ptr"
import "std/console"
import "std/io"
import "std/time/hosted"
import "std/encoding/json"

@derive(Json)
struct Record {
    // FIELDS: generated by bench_stdlib.py for the requested schema size.
}

fn main() {
    input := console.stdin()
    header := [0u8; 16]
    io.read_exact(&mut input, &mut header)!
    iterations := 0u64
    for i in 0usize..8 {
        iterations |=(header[i] as u64) << ((i * 8) as u64)
    }
    storage := [0u8; 65536]
    report := io.read_bounded(&mut input, &mut storage)!
    assert(report.eof && report.read > 0 && iterations > 0)
    key_index := [0usize; 1280]
    mode := header[8]
    checksum := 0u64
    clock := hosted.MonotonicClock.new()
    start := clock.now()!
    for i in 0u64..iterations {
        digit := (unsafe {
            ptr.read_volatile(ptr.from_ref(&i))
        } % 10) as u8
        // Members arrive in reverse schema order, ending in "f000":0}.
        storage[report.read - 2] = 48 + digit
        if mode == 2 {
            record := json.decode::<Record>(&storage[..report.read])!
            checksum += record.f000 as u64 + record.LAST_FIELD as u64
        } else {
            value := json.parse_indexed(&storage[..report.read], &mut key_index)!
            if mode == 0 {
                checksum += value.raw().len as u64 + digit as u64
            } else {
                record := json.from_value::<Record>(value)!
                checksum += record.f000 as u64 + record.LAST_FIELD as u64
            }
        }
    }
    end := clock.now()!
    elapsed := end.duration_since(&start)!
    nanos := elapsed.to_nanos()!
    record := json.decode::<Record>(&storage[..report.read])!
    assert_eq(record.f000, ((iterations - 1) % 10) as u32)
    // CHECKS: generated by bench_stdlib.py for all other fields.
    console.printf("{} {}\n", nanos, checksum)!
}
