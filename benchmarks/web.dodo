package web_bench

import "core/ptr"
import "core/bytes"
import "std/console"
import "std/io"
import "std/time/hosted"
import "std/web"
import "std/web/application"

pub struct Greeting {
    pub fn handle(&mut self, request: &mut web.Request, response: &mut web.Response) -> void!web.Failure {
        response.text(b"Hello, ")?
        response.append(request.param(b"name")?)?
        return response.append(request.query_or(b"suffix", b"!"))
    }
}

fn main() {
    input := console.stdin()
    header := [0u8; 16]
    io.read_exact(&mut input, &mut header)!
    iterations := 0u64
    for i in 0usize..8 {
        iterations |=(header[i] as u64) << ((i * 8) as u64)
    }
    mode := header[8]
    assert(iterations > 0)
    checksum := 0u64
    clock := hosted.MonotonicClock.new()
    if mode == 0 || mode == 3 || mode == 4 {
        routes := [
            // ROUTES: generated by bench_stdlib.py for the requested table size.
        ]
        if mode == 4 {
            routes[0].pattern = b"/route/LAST"
            routes[0].id = routes.len - 1
            routes[routes.len - 1].pattern = b"/route/0000"
            routes[routes.len - 1].id = 0
        }
        index_storage := [0usize; 512]
        router := if mode == 3 {
            web.Router.indexed(&routes, &mut index_storage[..routes.len * 2])!
        } else {
            web.Router.new(&routes)!
        }
        start := clock.now()!
        for i in 0u64..iterations {
            index := (unsafe {
                ptr.read_volatile(ptr.from_ref(&i))
            } % routes.len as u64) as usize
            found := router.find(b"GET", routes[index].pattern)!
            checksum += found.id as u64
        }
        end := clock.now()!
        elapsed := end.duration_since(&start)!
        nanos := elapsed.to_nanos()!
        console.printf("{} {}\n", nanos, checksum)!
        return
    }
    if mode == 1 {
        targets := [b"/hello/%41da?suffix=+friend", b"/hello/%42ob?suffix=+friend"]
        output := [0u8; 128]
        start := clock.now()!
        for i in 0u64..iterations {
            index := (unsafe {
                ptr.read_volatile(ptr.from_ref(&i))
            } % 2) as usize
            count := web.decode_path(targets[index], &mut output)!
            checksum += count as u64 + output[7] as u64
        }
        end := clock.now()!
        elapsed := end.duration_since(&start)!
        nanos := elapsed.to_nanos()!
        assert(bytes.equal(&output[..10], b"/hello/Ada") || bytes.equal(&output[..10], b"/hello/Bob"))
        console.printf("{} {}\n", nanos, checksum)!
        return
    }
    site := application.builder()
        .get(b"/health", web.json(b"{\"ok\":true}"))
        .get(b"/hello/:name", Greeting {})
        .get(b"/files/*rest", web.text(b"file"))
        .build()!
    targets := [b"/hello/%41da?suffix=+friend", b"/hello/%42ob?suffix=+friend"]
    start := clock.now()!
    for i in 0u64..iterations {
        index := (unsafe {
            ptr.read_volatile(ptr.from_ref(&i))
        } % 2) as usize
        response := site.request(b"GET", targets[index])
        assert_eq(response.status(), 200u16)
        checksum += response.body().len as u64 + response.body()[7] as u64
    }
    end := clock.now()!
    elapsed := end.duration_since(&start)!
    nanos := elapsed.to_nanos()!
    site.request(b"GET", targets[0]).expect_status(200).expect_body(b"Hello, Ada friend")
    console.printf("{} {}\n", nanos, checksum)!
}
