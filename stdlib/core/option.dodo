package option

import "core/mem"

// Move the payload out while leaving an empty option in its original place.
pub fn take<T>(value: &mut Option<T>) -> Option<T> {
    return mem.replace(value, none)
}
pub fn replace<T>(value: &mut Option<T>, replacement: T) -> Option<T> {
    return mem.replace(value, some(replacement))
}
pub fn unwrap_or<T>(value: Option<T>, fallback: T) -> T {
    match value {
        some(payload) => {
            return payload
        },
        none => {
            return fallback
        },
    }
}
