package num

import "core/mem"

// Pointer-sized resource arithmetic. Failures never trap or wrap implicitly.
pub const MAX: usize = ~0usize
pub const MIN: usize = 0
pub enum ArithmeticError {
    Overflow, DivisionByZero, InvalidShift, InvalidAlignment
}

pub fn checked_add(a: usize, b: usize) -> Result<usize, ArithmeticError> {
    if b > MAX - a {
        return err(ArithmeticError.Overflow)
    }
    return ok(a + b)
}
pub fn checked_sub(a: usize, b: usize) -> Result<usize, ArithmeticError> {
    if b > a {
        return err(ArithmeticError.Overflow)
    }
    return ok(a - b)
}
pub fn checked_mul(a: usize, b: usize) -> Result<usize, ArithmeticError> {
    if a != 0 && b > MAX / a {
        return err(ArithmeticError.Overflow)
    }
    return ok(a * b)
}
pub fn checked_div(a: usize, b: usize) -> Result<usize, ArithmeticError> {
    if b == 0 {
        return err(ArithmeticError.DivisionByZero)
    }
    return ok(a / b)
}
pub fn checked_rem(a: usize, b: usize) -> Result<usize, ArithmeticError> {
    if b == 0 {
        return err(ArithmeticError.DivisionByZero)
    }
    return ok(a % b)
}
pub fn checked_shl(value: usize, shift: usize) -> Result<usize, ArithmeticError> {
    if shift >= mem.size_of::<usize>() * 8 {
        return err(ArithmeticError.InvalidShift)
    }
    if value > MAX >> shift {
        return err(ArithmeticError.Overflow)
    }
    return ok(value << shift)
}
pub fn checked_shr(value: usize, shift: usize) -> Result<usize, ArithmeticError> {
    if shift >= mem.size_of::<usize>() * 8 {
        return err(ArithmeticError.InvalidShift)
    }
    return ok(value >> shift)
}
pub fn saturating_add(a: usize, b: usize) -> usize {
    if b > MAX - a {
        return MAX
    }
    return a + b
}
pub fn saturating_sub(a: usize, b: usize) -> usize {
    if b > a {
        return 0
    }
    return a - b
}
pub fn saturating_mul(a: usize, b: usize) -> usize {
    if a != 0 && b > MAX / a {
        return MAX
    }
    return a * b
}
pub fn wrapping_add(a: usize, b: usize) -> usize {
    if b > MAX - a {
        return b - (MAX - a) - 1
    }
    return a + b
}
pub fn wrapping_sub(a: usize, b: usize) -> usize {
    if b > a {
        return MAX - (b - a) + 1
    }
    return a - b
}
pub fn wrapping_mul(a: usize, b: usize) -> usize {
    result := 0usize
    for b != 0 {
        if (b & 1) != 0 {
            result = wrapping_add(result, a)
        }
        b = b >> 1
        if b != 0 {
            a = wrapping_add(a, a)
        }
    }
    return result
}
pub fn min(a: usize, b: usize) -> usize {
    if a < b {
        return a
    }
    return b
}
pub fn max(a: usize, b: usize) -> usize {
    if a > b {
        return a
    }
    return b
}
pub fn is_power_of_two(value: usize) -> bool {
    return value != 0 && (value & (value - 1)) == 0
}
pub fn align_up(value: usize, alignment: usize) -> Result<usize, ArithmeticError> {
    if!is_power_of_two(alignment) {
        return err(ArithmeticError.InvalidAlignment)
    }
    rounded := checked_add(value, alignment - 1)?
    return ok(rounded & ~(alignment - 1))
}
