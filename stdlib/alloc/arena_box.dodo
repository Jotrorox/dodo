package arena_box

import "alloc/error"
import "alloc/arena"
import "alloc/boxed"

// Own a value in caller-backed arena storage. The returned Box exclusively
// borrows its allocator until extraction or destruction. T cannot carry checked
// borrows or contain Results. Allocation failure destroys value normally.
pub fn new<T>(allocator: &mut arena.Arena, value: T) -> boxed.Box<T, arena.Arena>!error.AllocError from(allocator) {
    // SAFETY: Arena guarantees unique, aligned live storage until deallocation;
    // Box retains a checked borrow of the Arena, which retains its backing.
    unsafe {
        return boxed.new::<T, arena.Arena>(allocator, value)
    }
}
