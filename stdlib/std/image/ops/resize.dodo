package ops

import "core/slice"
import "std/image/color"
import "std/image/convert"
import "std/image/pixels"
import "std/image/shared/scratch" as carve

// Resampling to another size with a choice of filters.
//
// resize() is separable: each source row is filtered horizontally into a
// small ring of rows, and each target row is filtered vertically from that
// ring as soon as all the source rows it needs have arrived. Only as many
// horizontally filtered rows as the vertical filter has taps are kept, so
// working memory grows with the target width, not with the image. The same
// machinery drives ResizeSink, which resizes rows streaming out of a decoder
// without a full-size intermediate.
//
// Weights are computed entirely in integers. Target pixel i of an axis
// scaled from `in` to `out` pixels is centred at source coordinate
// (i + 0.5) * in / out; when downscaling the filter is stretched by in / out
// so that it averages instead of skipping pixels. Distances are exact
// rationals turned into 16.16 fixed point, kernels are evaluated in fixed
// point (Lanczos through a 1/256-step table), and each output's weights are
// rounded cumulatively so that they sum to exactly WEIGHT_ONE (16 fractional
// bits). Taps outside the image are clamped to the edge pixel. Identical
// sizes on an axis copy that axis unfiltered.
//
// Pixels are filtered as premultiplied RGBA, so transparent pixels carry no
// color into their neighbours, then divided by alpha again. With
// ResizeOptions.linear, color is converted from sRGB to linear light before
// filtering and back afterwards, which keeps bright and dark detail in
// balance. Integer targets work on 16-bit samples with 64-bit accumulators
// and clamp each pass to 0..65535 (ringing filters overshoot); results are
// identical on every target. Float targets (F16, F32) use an f32 pipeline
// with the same weights and keep values outside 0.0..1.0.
//
// Filters (support radius in source pixels before stretching):
//
//     Nearest     0.5  the pixel under the target pixel's centre, unfiltered
//     Box         0.5  exact area average: the share of each source pixel
//                      covered by the target pixel; best for downscaling
//     Bilinear    1    triangle filter
//     CatmullRom  2    cubic, B = 0, C = 0.5: sharp, slight ringing
//     Mitchell    2    cubic, B = C = 1/3: soft, little ringing
//     Lanczos3    3    windowed sinc: sharpest, most ringing
//
// Scratch layout, every part from carve.size(): horizontal bounds (2 u32
// per target column) and weights (taps i32 per column), vertical bounds and
// weights likewise per target row, one source row and one target row of
// working RGBA, and the ring of vertical-taps target rows. Working samples
// are u16 for integer targets and f32 for float targets. Nearest only needs
// the bounds.

pub enum Filter {
    Nearest,
    Box,
    Bilinear,
    CatmullRom,
    Mitchell,
    Lanczos3
}

pub struct ResizeOptions {
    pub filter: Filter
    // Filter in linear light instead of on sRGB-encoded values.
    pub linear: bool

    pub fn new(filter: Filter) -> ResizeOptions {
        return ResizeOptions { filter: filter, linear: false }
    }
    pub fn linear_light(filter: Filter) -> ResizeOptions {
        return ResizeOptions { filter: filter, linear: true }
    }
}

const NEAREST: u32 = 0
const BOX: u32 = 1
const BILINEAR: u32 = 2
const CATMULL_ROM: u32 = 3
const MITCHELL: u32 = 4
const LANCZOS3: u32 = 5

const WEIGHT_BITS: i64 = 16
const WEIGHT_ONE: i64 = 65536
const FIXED_ONE: i64 = 65536

fn filter_code(filter: &Filter) -> u32 {
    match filter {
        Filter.Nearest => {
            return NEAREST
        }
        Filter.Box => {
            return BOX
        }
        Filter.Bilinear => {
            return BILINEAR
        }
        Filter.CatmullRom => {
            return CATMULL_ROM
        }
        Filter.Mitchell => {
            return MITCHELL
        }
        Filter.Lanczos3 => {
            return LANCZOS3
        }
    }
}

// Twice the support radius.
fn support2(code: u32) -> i64 {
    if code == BILINEAR {
        return 2
    }
    if code == CATMULL_ROM || code == MITCHELL {
        return 4
    }
    if code == LANCZOS3 {
        return 6
    }
    return 1
}

// ---------------------------------------------------------------------------
// Weights

fn floor_div(n: i64, d: i64) -> i64 {
    q := n / d
    if n % d != 0 && n < 0 {
        return q - 1
    }
    return q
}

fn ceil_div(n: i64, d: i64) -> i64 {
    return -floor_div(-n, d)
}

fn clamp_index(j: i64, length: u32) -> i64 {
    if j < 0 {
        return 0
    }
    if j >= length as i64 {
        return length as i64 - 1
    }
    return j
}

// The kernel at distance x >= 0 (16.16 fixed point), in 16.16.
fn kernel(code: u32, x: i64) -> i64 {
    if code == BILINEAR {
        if x >= FIXED_ONE {
            return 0
        }
        return FIXED_ONE - x
    }
    if code == LANCZOS3 {
        if x >= 3 * FIXED_ONE {
            return 0
        }
        index := (x >> 8) as usize
        fraction := x & 255
        low := LANCZOS3_TABLE[index] as i64
        high := LANCZOS3_TABLE[index + 1] as i64
        return low + floor_div((high - low) * fraction + 128, 256)
    }
    x2 := (x * x) >> 16
    x3 := (x2 * x) >> 16
    if code == CATMULL_ROM {
        if x < FIXED_ONE {
            return floor_div(3 * x3 - 5 * x2 + 2 * FIXED_ONE, 2)
        }
        if x < 2 * FIXED_ONE {
            return floor_div(-x3 + 5 * x2 - 8 * x + 4 * FIXED_ONE, 2)
        }
        return 0
    }
    // Mitchell-Netravali, B = C = 1/3.
    if x < FIXED_ONE {
        return floor_div(21 * x3 - 36 * x2 + 16 * FIXED_ONE, 18)
    }
    if x < 2 * FIXED_ONE {
        return floor_div(-7 * x3 + 36 * x2 - 60 * x + 32 * FIXED_ONE, 18)
    }
    return 0
}

// The source pixel under target pixel i's centre.
fn nearest_source(i: u32, input: u32, output: u32) -> u32 {
    j := ((2 * i as u64 + 1) * input as u64) / (2 * output as u64)
    if j >= input as u64 {
        return input - 1
    }
    return j as u32
}

// Taps per output for one axis: an upper bound on the source pixels any
// output reads. 1 when the axis is copied.
fn axis_taps(input: u32, output: u32, code: u32) -> usize {
    if code == NEAREST || input == output {
        return 1
    }
    larger := input as i64
    if output as i64 > larger {
        larger = output as i64
    }
    taps := ceil_div(support2(code) * larger, output as i64) + 2
    if taps > input as i64 {
        taps = input as i64
    }
    return taps as usize
}

// The unnormalized weight of source pixel j for output i, and the window of
// j values with nonzero weight, in the units described in plan_axis.
struct Window {
    first: i64
    last: i64
}

fn window(code: u32, i: u32, input: u32, output: u32) -> Window {
    larger := input as i64
    if output as i64 > larger {
        larger = output as i64
    }
    centre := (2 * i as i64 + 1) * input as i64
    step := 2 * output as i64
    if code == BOX {
        low := centre - larger
        high := centre + larger
        return Window { first: floor_div(low, step), last: ceil_div(high, step) - 1 }
    }
    reach := support2(code) * larger
    return Window { first: floor_div(centre - reach - output as i64, step) + 1, last: ceil_div(centre + reach - output as i64, step) - 1 }
}

// In units of 1 / (2 * output) source pixels the target centre lies at
// (2i + 1) * input and source pixel j spans [2j * output, (2j + 2) * output)
// with its centre at (2j + 1) * output. Distances are divided by
// 2 * max(input, output), which also stretches the filter when downscaling.
fn raw_weight(code: u32, i: u32, j: i64, input: u32, output: u32) -> i64 {
    larger := input as i64
    if output as i64 > larger {
        larger = output as i64
    }
    centre := (2 * i as i64 + 1) * input as i64
    if code == BOX {
        low := centre - larger
        high := centre + larger
        left := 2 * j * output as i64
        right := left + 2 * output as i64
        if left > low {
            low = left
        }
        if right < high {
            high = right
        }
        if high <= low {
            return 0
        }
        return high - low
    }
    distance := centre - (2 * j + 1) * output as i64
    if distance < 0 {
        distance = -distance
    }
    return kernel(code, distance * FIXED_ONE / (2 * larger))
}

fn round_div(n: i64, d: i64) -> i64 {
    return floor_div(2 * n + d, 2 * d)
}

// Fill bounds (first source pixel, tap count) and weights (taps per output,
// summing to WEIGHT_ONE) for one axis.
fn plan_axis(input: u32, output: u32, code: u32, taps: usize, bounds: &mut[u32], weights: &mut[i32]) {
    for i in 0u32..output {
        b := 2 * i as usize
        w := i as usize * taps
        for k in 0usize..taps {
            weights[w + k] = 0
        }
        if code == NEAREST || input == output {
            bounds[b] = nearest_source(i, input, output)
            bounds[b + 1] = 1
            weights[w] = WEIGHT_ONE as i32
            continue
        }
        span := window(code, i, input, output)
        start := clamp_index(span.first, input)
        end := clamp_index(span.last, input)
        total := 0i64
        for j := span.first; j <= span.last; j += 1 {
            total += raw_weight(code, i, j, input, output)
        }
        if total <= 0 || end - start + 1 > taps as i64 {
            // Cannot happen for these kernels; fall back to the nearest pixel.
            bounds[b] = nearest_source(i, input, output)
            bounds[b + 1] = 1
            weights[w] = WEIGHT_ONE as i32
            continue
        }
        bounds[b] = start as u32
        bounds[b + 1] = (end - start + 1) as u32
        // Cumulative rounding keeps every weight within one unit of exact
        // and makes the sum exactly WEIGHT_ONE.
        running := 0i64
        given := 0i64
        for j := span.first; j <= span.last; j += 1 {
            running += raw_weight(code, i, j, input, output)
            next := round_div(running * WEIGHT_ONE, total)
            slot := (clamp_index(j, input) - start) as usize
            weights[w + slot] = weights[w + slot] + (next - given) as i32
            given = next
        }
    }
}

// ---------------------------------------------------------------------------
// The resampler shared by resize() and ResizeSink

struct Resampler {
    source_width: u32
    source_height: u32
    target_width: u32
    target_height: u32
    htaps: usize
    vtaps: usize
    // Nearest or same size: pixels are copied, not filtered.
    direct: bool
    float: bool
    linear: bool
    hbounds: &mut[u32]
    hweights: &mut[i32]
    vbounds: &mut[u32]
    vweights: &mut[i32]
    line: &mut[u8]
    ring: &mut[u8]
    output: &mut[u8]
    // Target rows written so far.
    next_target: u32
}

struct Sizes {
    hbounds: usize
    hweights: usize
    vbounds: usize
    vweights: usize
    line: usize
    ring: usize
    output: usize
}

fn is_direct(source_width: u32, source_height: u32, target_width: u32, target_height: u32, code: u32) -> bool {
    return code == NEAREST || (source_width == target_width && source_height == target_height)
}

fn sizes(source_width: u32, source_height: u32, target_width: u32, target_height: u32, float: bool, code: u32) -> Sizes!pixels.Error {
    if source_width > pixels.MAX_DIMENSION || source_height > pixels.MAX_DIMENSION || target_width > pixels.MAX_DIMENSION || target_height > pixels.MAX_DIMENSION {
        return err(pixels.Error.TooLarge)
    }
    hbounds := carve.size(2 * target_width as usize, 4)?
    vbounds := carve.size(2 * target_height as usize, 4)?
    if is_direct(source_width, source_height, target_width, target_height, code) {
        return ok(Sizes { hbounds: hbounds, hweights: 0, vbounds: vbounds, vweights: 0, line: 0, ring: 0, output: 0 })
    }
    htaps := axis_taps(source_width, target_width, code)
    vtaps := axis_taps(source_height, target_height, code)
    element := 2usize
    if float {
        element = 4
    }
    hweights := carve.size(pixels.checked(target_width as usize, htaps, 0)?, 4)?
    vweights := carve.size(pixels.checked(target_height as usize, vtaps, 0)?, 4)?
    line := carve.size(4 * source_width as usize, element)?
    row := 4 * target_width as usize
    ring := carve.size(pixels.checked(row, vtaps, 0)?, element)?
    output := carve.size(row, element)?
    return ok(Sizes { hbounds: hbounds, hweights: hweights, vbounds: vbounds, vweights: vweights, line: line, ring: ring, output: output })
}

fn total_size(parts: &Sizes) -> usize!pixels.Error {
    total := carve.add(parts.hbounds, parts.hweights)?
    total = carve.add(total, parts.vbounds)?
    total = carve.add(total, parts.vweights)?
    total = carve.add(total, parts.line)?
    total = carve.add(total, parts.ring)?
    return carve.add(total, parts.output)
}

// Scratch bytes resize() and ResizeSink need for these sizes and a target
// in `target_layout`.
pub fn resize_scratch_size(source_width: u32, source_height: u32, target_width: u32, target_height: u32, target_layout: &pixels.Layout, options: &ResizeOptions) -> usize!pixels.Error {
    parts := sizes(source_width, source_height, target_width, target_height, target_layout.is_float(), filter_code(&options.filter))?
    return total_size(&parts)
}

fn new_resampler(source_width: u32, source_height: u32, target_width: u32, target_height: u32, float: bool, options: &ResizeOptions, bytes: &mut[u8]) -> Resampler!pixels.Error from(bytes) {
    if target_width == 0 || target_height == 0 || source_width == 0 || source_height == 0 {
        return err(pixels.Error.Malformed)
    }
    code := filter_code(&options.filter)
    parts := sizes(source_width, source_height, target_width, target_height, float, code)?
    total := total_size(&parts)?
    if bytes.len < total {
        return err(pixels.Error.BufferTooSmall)
    }
    direct := is_direct(source_width, source_height, target_width, target_height, code)
    htaps := 1usize
    vtaps := 1usize
    if !direct {
        htaps = axis_taps(source_width, target_width, code)
        vtaps = axis_taps(source_height, target_height, code)
    }
    let slice.SplitMut { left: a, right: rest1 } = carve.split(bytes, parts.hbounds)?
    let slice.SplitMut { left: b, right: rest2 } = carve.split(rest1, parts.hweights)?
    let slice.SplitMut { left: c, right: rest3 } = carve.split(rest2, parts.vbounds)?
    let slice.SplitMut { left: d, right: rest4 } = carve.split(rest3, parts.vweights)?
    let slice.SplitMut { left: e, right: rest5 } = carve.split(rest4, parts.line)?
    let slice.SplitMut { left: f, right: rest6 } = carve.split(rest5, parts.ring)?
    let slice.SplitMut { left: g, right: _ } = carve.split(rest6, parts.output)?
    hbounds := carve.u32s(a)
    hweights := carve.i32s(b)
    vbounds := carve.u32s(c)
    vweights := carve.i32s(d)
    if direct {
        for i in 0u32..target_width {
            hbounds[2 * i as usize] = nearest_source(i, source_width, target_width)
        }
        for i in 0u32..target_height {
            vbounds[2 * i as usize] = nearest_source(i, source_height, target_height)
        }
    } else {
        plan_axis(source_width, target_width, code, htaps, hbounds, hweights)
        plan_axis(source_height, target_height, code, vtaps, vbounds, vweights)
    }
    return ok(Resampler { source_width: source_width, source_height: source_height, target_width: target_width, target_height: target_height, htaps: htaps, vtaps: vtaps, direct: direct, float: float, linear: options.linear, hbounds: hbounds, hweights: hweights, vbounds: vbounds, vweights: vweights, line: e, ring: f, output: g, next_target: 0 })
}

// True once every target row is written.
fn finished(r: &Resampler) -> bool {
    return r.next_target >= r.target_height
}

// Whether source row y is still needed; rows below the next target row's
// window never are.
fn wants(r: &Resampler, y: u32) -> bool {
    if r.next_target >= r.target_height {
        return false
    }
    first := r.vbounds[2 * r.next_target as usize]
    if r.direct {
        return y == first
    }
    return y >= first
}

// Feed source row y (rows arrive in increasing order) and write every
// target row that becomes complete.
fn push(r: &mut Resampler, y: u32, row: &[u8], layout: &pixels.Layout, target: &mut pixels.ViewMut) {
    if !wants(r, y) {
        return
    }
    target_layout := target.layout().clone()
    if r.direct {
        for r.next_target < r.target_height && r.vbounds[2 * r.next_target as usize] == y {
            line := target.row_mut(r.next_target)
            for i in 0u32..r.target_width {
                convert.row(row, layout, r.hbounds[2 * i as usize] as usize, line, &target_layout, i as usize, 1)
            }
            r.next_target += 1
        }
        return
    }
    if r.float {
        filter_row_f32(r, y, row, layout)
    } else {
        filter_row16(r, y, row, layout)
    }
    for r.next_target < r.target_height {
        j := r.next_target as usize
        if r.vbounds[2 * j] as u64 + r.vbounds[2 * j + 1] as u64 - 1 > y as u64 {
            break
        }
        if r.float {
            emit_row_f32(r, j)
            store_f32(carve.f32s(r.output), target.row_mut(r.next_target), &target_layout, 0, r.target_width as usize)
        } else {
            emit_row16(r, j)
            convert.store_rgba16(carve.u16s(r.output), target.row_mut(r.next_target), &target_layout, 0, r.target_width as usize)
        }
        r.next_target += 1
    }
}

// ---------------------------------------------------------------------------
// The 16-bit path

fn premultiply16(c: u32, a: u32) -> u32 {
    return (c * a + 32767) / 65535
}

fn clamp16(value: i64) -> u16 {
    if value <= 0 {
        return 0
    }
    if value >= 65535 {
        return 65535
    }
    return value as u16
}

// Source row y as premultiplied (linear) RGBA16, filtered horizontally into
// ring slot y % vtaps.
fn filter_row16(r: &mut Resampler, y: u32, row: &[u8], layout: &pixels.Layout) {
    width := r.source_width as usize
    linear := r.linear
    line := carve.u16s(r.line)
    convert.load_rgba16(row, layout, 0, width, line)
    for p in 0usize..width {
        o := p * 4
        a := line[o + 3] as u32
        for c in 0usize..3 {
            v := line[o + c] as u32
            if linear {
                v = color.srgb_to_linear16(v as u16) as u32
            }
            if a < 65535 {
                v = premultiply16(v, a)
            }
            line[o + c] = v as u16
        }
    }
    taps := r.htaps
    base := (y as usize % r.vtaps) * r.target_width as usize * 4
    ring := carve.u16s(r.ring)
    for i in 0usize..r.target_width as usize {
        start := r.hbounds[2 * i] as usize
        count := r.hbounds[2 * i + 1] as usize
        w := i * taps
        acc0 := 0i64
        acc1 := 0i64
        acc2 := 0i64
        acc3 := 0i64
        for k in 0usize..count {
            weight := r.hweights[w + k] as i64
            s := (start + k) * 4
            acc0 += weight * line[s] as i64
            acc1 += weight * line[s + 1] as i64
            acc2 += weight * line[s + 2] as i64
            acc3 += weight * line[s + 3] as i64
        }
        o := base + i * 4
        half := WEIGHT_ONE / 2
        ring[o] = clamp16((acc0 + half) >> WEIGHT_BITS)
        ring[o + 1] = clamp16((acc1 + half) >> WEIGHT_BITS)
        ring[o + 2] = clamp16((acc2 + half) >> WEIGHT_BITS)
        ring[o + 3] = clamp16((acc3 + half) >> WEIGHT_BITS)
    }
}

// Target row j filtered vertically from the ring into r.output as straight
// sRGB-encoded RGBA16.
fn emit_row16(r: &mut Resampler, j: usize) {
    width := r.target_width as usize
    stride := width * 4
    first := r.vbounds[2 * j] as usize
    count := r.vbounds[2 * j + 1] as usize
    w := j * r.vtaps
    vtaps := r.vtaps
    linear := r.linear
    ring := carve.u16s(r.ring)
    output := carve.u16s(r.output)
    half := WEIGHT_ONE / 2
    for i in 0usize..width {
        acc0 := 0i64
        acc1 := 0i64
        acc2 := 0i64
        acc3 := 0i64
        slot := first % vtaps
        for k in 0usize..count {
            weight := r.vweights[w + k] as i64
            s := slot * stride + i * 4
            acc0 += weight * ring[s] as i64
            acc1 += weight * ring[s + 1] as i64
            acc2 += weight * ring[s + 2] as i64
            acc3 += weight * ring[s + 3] as i64
            slot += 1
            if slot == vtaps {
                slot = 0
            }
        }
        a := clamp16((acc3 + half) >> WEIGHT_BITS) as u32
        values := [clamp16((acc0 + half) >> WEIGHT_BITS) as u32, clamp16((acc1 + half) >> WEIGHT_BITS) as u32, clamp16((acc2 + half) >> WEIGHT_BITS) as u32]
        o := i * 4
        for c in 0usize..3 {
            v := values[c]
            if a < 65535 {
                if a == 0 {
                    v = 0
                } else {
                    if v > a {
                        v = a
                    }
                    v = (v * 65535 + a / 2) / a
                }
            }
            if linear {
                v = color.linear_to_srgb16(v as u16) as u32
            }
            output[o + c] = v as u16
        }
        output[o + 3] = a as u16
    }
}

// ---------------------------------------------------------------------------
// The f32 path

fn filter_row_f32(r: &mut Resampler, y: u32, row: &[u8], layout: &pixels.Layout) {
    width := r.source_width as usize
    linear := r.linear
    line := carve.f32s(r.line)
    load_f32(row, layout, 0, width, line)
    for p in 0usize..width {
        o := p * 4
        a := line[o + 3]
        for c in 0usize..3 {
            v := line[o + c]
            if linear {
                v = transfer_f32(v, true)
            }
            line[o + c] = v * a
        }
    }
    taps := r.htaps
    base := (y as usize % r.vtaps) * r.target_width as usize * 4
    ring := carve.f32s(r.ring)
    for i in 0usize..r.target_width as usize {
        start := r.hbounds[2 * i] as usize
        count := r.hbounds[2 * i + 1] as usize
        w := i * taps
        acc0 := 0.0f32
        acc1 := 0.0f32
        acc2 := 0.0f32
        acc3 := 0.0f32
        for k in 0usize..count {
            weight := r.hweights[w + k] as f32 / 65536.0f32
            s := (start + k) * 4
            acc0 += weight * line[s]
            acc1 += weight * line[s + 1]
            acc2 += weight * line[s + 2]
            acc3 += weight * line[s + 3]
        }
        o := base + i * 4
        ring[o] = acc0
        ring[o + 1] = acc1
        ring[o + 2] = acc2
        ring[o + 3] = acc3
    }
}

fn emit_row_f32(r: &mut Resampler, j: usize) {
    width := r.target_width as usize
    stride := width * 4
    first := r.vbounds[2 * j] as usize
    count := r.vbounds[2 * j + 1] as usize
    w := j * r.vtaps
    vtaps := r.vtaps
    linear := r.linear
    ring := carve.f32s(r.ring)
    output := carve.f32s(r.output)
    for i in 0usize..width {
        acc0 := 0.0f32
        acc1 := 0.0f32
        acc2 := 0.0f32
        acc3 := 0.0f32
        slot := first % vtaps
        for k in 0usize..count {
            weight := r.vweights[w + k] as f32 / 65536.0f32
            s := slot * stride + i * 4
            acc0 += weight * ring[s]
            acc1 += weight * ring[s + 1]
            acc2 += weight * ring[s + 2]
            acc3 += weight * ring[s + 3]
            slot += 1
            if slot == vtaps {
                slot = 0
            }
        }
        a := acc3
        if !(a > 0.0f32) {
            a = 0.0f32
        } else if a > 1.0f32 {
            a = 1.0f32
        }
        values := [acc0, acc1, acc2]
        o := i * 4
        for c in 0usize..3 {
            v := values[c]
            if a == 0.0f32 {
                v = 0.0f32
            } else if a != 1.0f32 {
                v = v / a
            }
            if linear {
                v = transfer_f32(v, false)
            }
            output[o + c] = v
        }
        output[o + 3] = a
    }
}

// ---------------------------------------------------------------------------
// Entry points

// Resize `source` into `target` (any sizes and layouts). Identical sizes
// copy. Malformed when the source is empty but the target is not;
// BufferTooSmall when scratch is shorter than resize_scratch_size().
pub fn resize(source: &pixels.View, target: &mut pixels.ViewMut, options: &ResizeOptions, scratch: &mut[u8]) -> void!pixels.Error {
    source_width := source.width()
    source_height := source.height()
    target_width := target.width()
    target_height := target.height()
    if target_width == 0 || target_height == 0 {
        return ok()
    }
    if source_width == 0 || source_height == 0 {
        return err(pixels.Error.Malformed)
    }
    if source_width == target_width && source_height == target_height {
        return convert.copy(source, target)
    }
    float := target.layout().is_float()
    r := new_resampler(source_width, source_height, target_width, target_height, float, options, scratch)?
    layout := source.layout().clone()
    for y in 0u32..source_height {
        if finished(&r) {
            break
        }
        push(&mut r, y, source.row(y), &layout, target)
    }
    return ok()
}

// A sink that resizes a decoder's output into `target` while it streams, so
// a large image can be decoded straight to a thumbnail. The decoder must
// deliver full-width rects top to bottom with no gaps or repeats (PNG, BMP,
// QOI, PPM and other row-order decoders do); anything else, such as tiles
// or interlaced passes, fails with Unsupported, and the image should then be
// decoded to a full-size view and passed to resize(). Scratch is
// resize_scratch_size() for the header's size and the target's layout.
pub struct ResizeSink {
    target: &mut pixels.ViewMut
    resampler: Resampler
    // The next source row expected.
    row: u32

    pub fn new(target: &mut pixels.ViewMut, source_width: u32, source_height: u32, options: &ResizeOptions, scratch: &mut[u8]) -> ResizeSink!pixels.Error from(target, scratch) {
        width := target.width()
        height := target.height()
        float := target.layout().is_float()
        resampler := new_resampler(source_width, source_height, width, height, float, options, scratch)?
        return ok(ResizeSink { target: target, resampler: resampler, row: 0 })
    }
    pub fn begin(&mut self, header: &pixels.Header) -> void!pixels.Error {
        if header.width != self.resampler.source_width || header.height != self.resampler.source_height {
            return err(pixels.Error.Malformed)
        }
        return ok()
    }
    pub fn rect(&mut self, x: u32, y: u32, source: &pixels.View) -> void!pixels.Error {
        if x != 0 || source.width() != self.resampler.source_width || y != self.row {
            return err(pixels.Error.Unsupported)
        }
        if y as u64 + source.height() as u64 > self.resampler.source_height as u64 {
            return err(pixels.Error.Malformed)
        }
        layout := source.layout().clone()
        for k in 0u32..source.height() {
            push(&mut self.resampler, y + k, source.row(k), &layout, self.target)
        }
        self.row = y + source.height()
        return ok()
    }
    // True once every target row has been written.
    pub fn complete(&self) -> bool {
        return finished(&self.resampler)
    }
}

