package encode

// LSB-first bit writer over caller output, plus the variable-length field
// encodings of the JPEG XL headers (U32, U64, Enum).
//
// Writing past the end of the output never traps: the writer keeps counting
// bytes and sets `overflow`, which encode() reports as BufferTooSmall.

struct BitWriter {
    out: &mut[u8]
    // Index of the next byte to store.
    pos: usize
    acc: u64
    count: u32
    overflow: bool

    fn new(out: &mut[u8], start: usize) -> BitWriter from(out) {
        return BitWriter { out: out, pos: start, acc: 0, count: 0, overflow: false }
    }
    // Append the low n bits of value (n <= 32; value < 2^n).
    fn write(&mut self, n: u32, value: u64) {
        if n == 0 {
            return
        }
        self.acc = self.acc | (value << (self.count as u64))
        self.count += n
        for self.count >= 8 {
            if self.pos < self.out.len {
                self.out[self.pos] = (self.acc & 255) as u8
            } else {
                self.overflow = true
            }
            self.pos += 1
            self.acc = self.acc >> 8
            self.count -= 8
        }
    }
    fn bit(&mut self, flag: bool) {
        if flag {
            self.write(1, 1)
        } else {
            self.write(1, 0)
        }
    }
    // Zero bits up to the next byte boundary.
    fn pad(&mut self) {
        if self.count != 0 {
            pad := 8 - self.count
            self.write(pad, 0)
        }
    }
    // Bits written since byte offset `start`.
    fn bits_since(&self, start: usize) -> u64 {
        return (self.pos - start) as u64 * 8 + self.count as u64
    }
    // Copy whole bytes; the writer must be byte-aligned.
    fn bytes(&mut self, data: &[u8]) {
        for i in 0usize..data.len {
            self.write(8, data[i] as u64)
        }
    }
    // U32(d0, d1, d2, d3) where each distribution is offset + u(bits). The
    // first distribution that holds the value is used; callers only pass
    // representable values.
    fn u32(&mut self, value: u32, o0: u32, b0: u32, o1: u32, b1: u32, o2: u32, b2: u32, o3: u32, b3: u32) {
        if fits(value, o0, b0) {
            self.write(2, 0)
            self.write(b0, (value - o0) as u64)
        } else if fits(value, o1, b1) {
            self.write(2, 1)
            self.write(b1, (value - o1) as u64)
        } else if fits(value, o2, b2) {
            self.write(2, 2)
            self.write(b2, (value - o2) as u64)
        } else {
            self.write(2, 3)
            self.write(b3, (value - o3) as u64)
        }
    }
    // Enum: U32(0, 1, 2 + u(4), 18 + u(6)).
    fn enumeration(&mut self, value: u32) {
        self.u32(value, 0, 0, 1, 0, 2, 4, 18, 6)
    }
    // U64 zero, the only U64 value the encoder writes (no extensions).
    fn u64_zero(&mut self) {
        self.write(2, 0)
    }
}

fn fits(value: u32, offset: u32, bits: u32) -> bool {
    if value < offset {
        return false
    }
    if bits >= 32 {
        return true
    }
    return value - offset < (1u32 << bits)
}

// Number of bits needed for values 0..max, ceil(log2(max + 1)).
fn bits_for(max: u32) -> u32 {
    n := 0u32
    for n < 32 && (max >> n) != 0 {
        n += 1
    }
    return n
}

// floor(log2(v)) for v >= 1.
fn floor_log2(v: u64) -> u32 {
    n := 0u32
    rest := v >> 1
    for rest != 0 {
        n += 1
        rest = rest >> 1
    }
    return n
}

// Signed to unsigned zig-zag: 0, -1, 1, -2, ... -> 0, 1, 2, 3, ...
fn pack_signed(v: i64) -> u64 {
    if v >= 0 {
        return (v as u64) << 1
    }
    return (((-1 - v) as u64) << 1) | 1
}
