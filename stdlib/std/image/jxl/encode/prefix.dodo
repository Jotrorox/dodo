package encode

// Prefix (Huffman) codes as JPEG XL stores them: RFC 7932 (Brotli) simple
// and complex codes, with code lengths of at most 15 bits.

// Symbols per histogram: literal tokens stay below LZ77_MIN_SYMBOL (224) and
// LZ77 length symbols follow it.
const MAX_ALPHA: usize = 272
const MAX_CODE_LENGTH: usize = 15
const CODE_LENGTH_CODES: usize = 18
// Transmission order of the code-length code lengths.
const CODE_LENGTH_ORDER: [18]usize = [1, 2, 3, 4, 0, 5, 17, 6, 16, 7, 8, 9, 10, 11, 12, 13, 14, 15]
// The fixed code for code-length code lengths 0..5, LSB-first.
const CODE_LENGTH_LENGTH_BITS: [6]u32 = [2, 4, 3, 2, 2, 4]
const CODE_LENGTH_LENGTH_CODES: [6]u64 = [0, 7, 3, 2, 1, 15]

// Assign code lengths of at most `limit` bits to freq[0..n] (n <= MAX_ALPHA),
// minimizing sum(freq * length) up to the length limit. Symbols with zero
// frequency get length 0, except that with `min_two` at least two symbols
// receive codes so the code is complete. The result is always a complete
// code when two or more symbols have codes. Returns the number of coded
// symbols.
fn huffman_lengths(freq: &[u64], n: usize, lengths: &mut[u8], limit: usize, min_two: bool) -> usize {
    leaves := [0usize; 272]
    weight := [0u64; 543]
    parent := [0usize; 543]
    depth := [0usize; 543]
    used := 0usize
    for i in 0usize..n {
        lengths[i] = 0
        if freq[i] != 0 {
            leaves[used] = i
            used += 1
        }
    }
    if min_two {
        for i in 0usize..n {
            if used >= 2 {
                break
            }
            if freq[i] == 0 {
                leaves[used] = i
                used += 1
            }
        }
    }
    if used == 0 {
        return 0
    }
    if used == 1 {
        lengths[leaves[0]] = 1
        return 1
    }
    // Stable insertion sort by frequency keeps ties deterministic.
    for i in 1usize..used {
        symbol := leaves[i]
        j := i
        for j > 0 && freq[leaves[j - 1]] > freq[symbol] {
            leaves[j] = leaves[j - 1]
            j -= 1
        }
        leaves[j] = symbol
    }
    for i in 0usize..used {
        weight[i] = freq[leaves[i]]
    }
    // Two-queue construction: leaves and internal nodes each come out in
    // nondecreasing weight order.
    next_leaf := 0usize
    next_node := used
    nodes := used
    for nodes < 2 * used - 1 {
        first := 0usize
        second := 0usize
        for c in 0usize..2 {
            pick := 0usize
            if next_leaf < used && (next_node == nodes || weight[next_leaf] <= weight[next_node]) {
                pick = next_leaf
                next_leaf += 1
            } else {
                pick = next_node
                next_node += 1
            }
            if c == 0 {
                first = pick
            } else {
                second = pick
            }
        }
        weight[nodes] = weight[first] + weight[second]
        parent[first] = nodes
        parent[second] = nodes
        nodes += 1
    }
    counts := [0usize; 16]
    root := nodes - 1
    depth[root] = 0
    i := root
    for i > 0 {
        i -= 1
        depth[i] = depth[parent[i]] + 1
        if i < used {
            d := depth[i]
            if d > limit {
                d = limit
            }
            counts[d] += 1
        }
    }
    // Clamping oversubscribes the code space; `total` measures it in units of
    // the longest code. Each step moves a leaf one level down and lets a
    // clamped leaf join it, removing one unit, until the code is complete.
    total := 0usize
    for bits in 1usize..limit + 1 {
        total += counts[bits] << (limit - bits)
    }
    for total > (1usize << limit) {
        bits := limit - 1
        for counts[bits] == 0 {
            bits -= 1
        }
        counts[bits] -= 1
        counts[bits + 1] += 2
        counts[limit] -= 1
        total -= 1
    }
    // Longest codes go to the least frequent symbols.
    at := 0usize
    for length in 0usize..limit {
        bits := limit - length
        for k in 0usize..counts[bits] {
            lengths[leaves[at]] = bits as u8
            at += 1
        }
    }
    return used
}

// Canonical codes for lengths[0..n], bit-reversed for LSB-first output.
fn canonical_codes(lengths: &[u8], n: usize, codes: &mut[u16]) {
    counts := [0u32; 16]
    for i in 0usize..n {
        counts[lengths[i] as usize] += 1
    }
    counts[0] = 0
    next := [0u32; 16]
    code := 0u32
    for bits in 1usize..16 {
        code = (code + counts[bits - 1]) << 1
        next[bits] = code
    }
    for symbol in 0usize..n {
        length := lengths[symbol] as usize
        codes[symbol] = 0
        if length != 0 {
            value := next[length]
            next[length] += 1
            reversed := 0u32
            for b in 0usize..length {
                reversed = (reversed << 1) | ((value >> (b as u32)) & 1)
            }
            codes[symbol] = reversed as u16
        }
    }
}

// Write the prefix code with code lengths lengths[0..alphabet]. An alphabet
// of one symbol needs no bits at all; one used symbol becomes a zero-bit
// simple code.
fn write_prefix_code(w: &mut BitWriter, lengths: &[u8], alphabet: usize) {
    if alphabet <= 1 {
        return
    }
    symbol_bits := bits_for((alphabet - 1) as u32)
    symbols := [0usize; 4]
    used := 0usize
    for i in 0usize..alphabet {
        if lengths[i] != 0 {
            if used < 4 {
                symbols[used] = i
            }
            used += 1
        }
    }
    if used <= 4 {
        if used == 0 {
            used = 1
            symbols[0] = 0
        }
        // Simple code: symbols in order of increasing length, ties by value.
        for a in 1usize..used {
            s := symbols[a]
            b := a
            for b > 0 && lengths[symbols[b - 1]] > lengths[s] {
                symbols[b] = symbols[b - 1]
                b -= 1
            }
            symbols[b] = s
        }
        w.write(2, 1)
        w.write(2, (used - 1) as u64)
        for k in 0usize..used {
            w.write(symbol_bits, symbols[k] as u64)
        }
        if used == 4 {
            // Tree select: lengths 1, 2, 3, 3 rather than 2, 2, 2, 2.
            if lengths[symbols[0]] == 1 {
                w.write(1, 1)
            } else {
                w.write(1, 0)
            }
        }
        return
    }
    // Complex code: run-length coded code lengths (zero runs with symbol 17),
    // themselves prefix coded.
    items := [0u8; 272]
    extras := [0u8; 272]
    count := 0usize
    last := alphabet - 1
    for lengths[last] == 0 {
        last -= 1
    }
    i := 0usize
    for i <= last {
        length := lengths[i]
        if length != 0 {
            items[count] = length
            extras[count] = 0
            count += 1
            i += 1
            continue
        }
        run := 0usize
        for i + run <= last && lengths[i + run] == 0 {
            run += 1
        }
        i += run
        reps := run
        if reps == 11 {
            items[count] = 0
            extras[count] = 0
            count += 1
            reps -= 1
        }
        if reps < 3 {
            for r in 0usize..reps {
                items[count] = 0
                extras[count] = 0
                count += 1
            }
        } else {
            reps -= 3
            start := count
            for {
                items[count] = 17
                extras[count] = (reps & 7) as u8
                count += 1
                reps = reps >> 3
                if reps == 0 {
                    break
                }
                reps -= 1
            }
            // Repeat codes are emitted most significant digit first.
            lo := start
            hi := count - 1
            for lo < hi {
                t := extras[lo]
                extras[lo] = extras[hi]
                extras[hi] = t
                lo += 1
                hi -= 1
            }
        }
    }
    freq := [0u64; 18]
    for k in 0usize..count {
        freq[items[k] as usize] += 1
    }
    cl_lengths := [0u8; 18]
    cl_codes := [0u16; 18]
    huffman_lengths(&freq, CODE_LENGTH_CODES, &mut cl_lengths, 5, true)
    canonical_codes(&cl_lengths, CODE_LENGTH_CODES, &mut cl_codes)
    w.write(2, 0)
    end := 0usize
    for k in 0usize..CODE_LENGTH_CODES {
        if cl_lengths[CODE_LENGTH_ORDER[k]] != 0 {
            end = k + 1
        }
    }
    for k in 0usize..end {
        v := cl_lengths[CODE_LENGTH_ORDER[k]] as usize
        w.write(CODE_LENGTH_LENGTH_BITS[v], CODE_LENGTH_LENGTH_CODES[v])
    }
    for k in 0usize..count {
        s := items[k] as usize
        w.write(cl_lengths[s] as u32, cl_codes[s] as u64)
        if s == 17 {
            w.write(3, extras[k] as u64)
        }
    }
}
