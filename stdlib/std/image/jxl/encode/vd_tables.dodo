package encode

import "std/image/convert"
import "std/image/pixels"
import "std/math"
import "std/math/trig"

// VarDCT tables shared with the decoder (copied from std/image/jxl's
// vardct_tables.dodo so the decoder stays independent): the varblock types
// (DctSelect), natural coefficient orders, the default dequantization
// parameters and weights, and the floating-point DCT whose inverse the
// decoder runs (forward and inverse are exact inverses of each other).

// Offset of the half-secant tables in the DCT scratch (two 256-entry work
// rows come first).
const VD_T_SEC: usize = 768
// Matrices of the 8 and 16-point transforms (forward then inverse each).
const VD_T_MAT8: usize = 1024
const VD_T_MAT16: usize = 1152
// Floats of DCT scratch.
const VD_DCT_TEMP: usize = 1664

const VD_NUM_DCT_SELECT: u32 = 27
const VD_NUM_PARAMS: usize = 17
const VD_NUM_ORDERS: usize = 13

// Per DctSelect: width and height in 8x8 blocks, dequantization parameter
// set, coefficient order, and whether it is one of the special 8x8
// transforms (which are never transposed).
static VD_DS_W8: [27]u32 = [1, 1, 1, 1, 2, 4, 1, 2, 1, 4, 2, 4, 1, 1, 1, 1, 1, 1, 8, 4, 8, 16, 8, 16, 32, 16, 32]
static VD_DS_H8: [27]u32 = [1, 1, 1, 1, 2, 4, 2, 1, 4, 1, 4, 2, 1, 1, 1, 1, 1, 1, 8, 8, 4, 16, 16, 8, 32, 32, 16]
static VD_DS_PARAM: [27]u32 = [0, 1, 2, 3, 4, 5, 6, 6, 7, 7, 8, 8, 9, 9, 10, 10, 10, 10, 11, 12, 12, 13, 14, 14, 15, 16, 16]
static VD_DS_ORDER: [27]u32 = [0, 1, 1, 1, 2, 3, 4, 4, 5, 5, 6, 6, 1, 1, 1, 1, 1, 1, 7, 8, 8, 9, 10, 10, 11, 12, 12]
static VD_DS_SPECIAL: [27]bool = [false, true, true, true, false, false, false, false, false, false, false, false, true, true, true, true, true, true, false, false, false, false, false, false, false, false, false]

// Dequantization matrix size (width >= height) per parameter set.
static VD_PARAM_W: [17]u32 = [8, 8, 8, 8, 16, 32, 16, 32, 32, 8, 8, 64, 64, 128, 128, 256, 256]
static VD_PARAM_H: [17]u32 = [8, 8, 8, 8, 16, 32, 8, 8, 16, 8, 8, 64, 32, 128, 64, 256, 128]
// Coefficient order size (width >= height).
static VD_ORDER_W: [13]u32 = [8, 8, 16, 32, 16, 32, 32, 64, 64, 128, 128, 256, 256]
static VD_ORDER_H: [13]u32 = [8, 8, 16, 32, 8, 8, 16, 64, 32, 128, 64, 256, 128]

// Varblocks taller than wide (and square DCTs) store coefficients
// transposed relative to their order and matrix.
fn vd_ds_transposed(ds: u32) -> bool {
    return !VD_DS_SPECIAL[ds as usize] && VD_DS_H8[ds as usize] >= VD_DS_W8[ds as usize]
}

fn vd_order_offset(o: usize) -> usize {
    total := 0usize
    for i in 0usize..o {
        total += (VD_ORDER_W[i] * VD_ORDER_H[i]) as usize
    }
    return total
}

fn vd_param_size(p: usize) -> usize {
    return (VD_PARAM_W[p] * VD_PARAM_H[p]) as usize
}

// Offset of parameter set p's three matrices in the dequantization store.
fn vd_param_offset(p: usize) -> usize {
    total := 0usize
    for i in 0usize..p {
        total += 3 * vd_param_size(i)
    }
    return total
}

// Natural coefficient orders of all 13 shapes, as y * width + x.
// The first `count` orders only.
fn vd_natural_orders(out: &mut[u32], count: usize) {
    for o in 0usize..count {
        bw := VD_ORDER_W[o] as usize
        bh := VD_ORDER_H[o] as usize
        base := vd_order_offset(o)
        y_scale := bw / bh
        lbw := bw / 8
        lbh := bh / 8
        index := 0usize
        for i in 0usize..lbw * lbh {
            out[base + index] = ((i / lbw) * bw + i % lbw) as u32
            index += 1
        }
        for d in 1usize..2 * bw {
            margin := 0usize
            if d > bw {
                margin = d - bw
            }
            for order in margin..d - margin {
                x := d - 1 - order
                y := order
                if d % 2 == 1 {
                    x = order
                    y = d - 1 - order
                }
                if x < lbw && y < lbw {
                    continue
                }
                if y % y_scale != 0 {
                    continue
                }
                out[base + index] = ((y / y_scale) * bw + x) as u32
                index += 1
            }
        }
    }
}
static VD_SCALE_F: [32]f32 = [
    1.0000000000000000, 0.9996047255830407, 0.9984194528776054, 0.9964458326264695, 0.9936866130906366, 0.9901456355893141, 0.9858278282666936, 0.9807391980963174, 0.9748868211368796, 0.9682788310563117, 0.9609244059440204, 0.9528337534340876, 0.9440180941651672, 0.9344896436056892, 0.9242615922757944, 0.9133480844001980, 0.9017641950288744, 0.8895259056651056, 0.8766500784429904, 0.8631544288990163, 0.8490574973847023, 0.8343786191696513, 0.8191378932865928, 0.8033561501721485, 0.7870549181591013, 0.7702563888779096, 0.7529833816270532, 0.7352593067735488, 0.7171081282466044, 0.6985543251889097, 0.6796228528314652, 0.6603391026591464
]

// Half secants 1 / (2 cos((2k + 1) pi / (2n))) for n = 4 .. 256, at
// t[VD_T_SEC + n / 2 - 2 + k].
fn vd_init_dct_tables(t: &mut[f32]) {
    n := 4usize
    for n <= 256 {
        for k in 0usize..n / 2 {
            theta := (2 * k + 1) as f64 * 3.141592653589793 / (2 * n) as f64
            c := 1.0f64
            match trig.cos(theta) {
                ok(v) => {
                    c = v
                }
                err(_) => {}
            }
            t[VD_T_SEC + n / 2 - 2 + k] = (0.5 / c) as f32
        }
        n *= 2
    }
    vd_init_matrix(t, VD_T_MAT8, 8)
    vd_init_matrix(t, VD_T_MAT16, 16)
}

// Forward (t[at + u * n + k]) and inverse (t[at + n * n + k * n + u])
// matrices of the n-point transform.
fn vd_init_matrix(t: &mut[f32], at: usize, n: usize) {
    for u in 0usize..n {
        for k in 0usize..n {
            c := 1.0f64
            if u > 0 {
                match trig.cos((2 * k + 1) as f64 * u as f64 * 3.141592653589793 / (2 * n) as f64) {
                    ok(v) => {
                        c = v * 1.4142135623730951
                    }
                    err(_) => {}
                }
            }
            t[at + u * n + k] = (c / n as f64) as f32
            t[at + n * n + k * n + u] = c as f32
        }
    }
}

// The n-point transform (n = 8 or 16) of t[d..] by matrix, with t[s..] as
// scratch.
fn vd_dct_matrix(t: &mut[f32], d: usize, s: usize, n: usize, inverse: bool) {
    at := VD_T_MAT8
    if n == 16 {
        at = VD_T_MAT16
    }
    if inverse {
        at += n * n
    }
    for i in 0usize..n {
        t[s + i] = t[d + i]
    }
    for u in 0usize..n {
        row := at + u * n
        a0 := 0.0f32
        a1 := 0.0f32
        a2 := 0.0f32
        a3 := 0.0f32
        k := 0usize
        for k < n {
            a0 += t[s + k] * t[row + k]
            a1 += t[s + k + 1] * t[row + k + 1]
            a2 += t[s + k + 2] * t[row + k + 2]
            a3 += t[s + k + 3] * t[row + k + 3]
            k += 4
        }
        t[d + u] = (a0 + a1) + (a2 + a3)
    }
}

fn vd_sec(t: &[f32], n: usize, k: usize) -> f32 {
    return t[VD_T_SEC + n / 2 - 2 + k]
}

const VD_SQRT2: f32 = 1.4142135623730951

fn vd_dct4_inplace(t: &mut[f32], d: usize, inverse: bool) {
    sec0 := 0.5411961f32
    sec1 := 1.306563f32
    i0 := t[d]
    i1 := t[d + 1]
    i2 := t[d + 2]
    i3 := t[d + 3]
    if !inverse {
        sum03 := i0 + i3
        sum12 := i1 + i2
        tmp0 := (i0 - i3) * sec0
        tmp1 := (i1 - i2) * sec1
        out0 := (tmp0 + tmp1) / 4.0
        out1 := (tmp0 - tmp1) / 4.0
        t[d] = (sum03 + sum12) / 4.0
        t[d + 1] = out0 * VD_SQRT2 + out1
        t[d + 2] = (sum03 - sum12) / 4.0
        t[d + 3] = out1
        return
    }
    tmp0 := i1 * VD_SQRT2
    tmp1 := i1 + i3
    out0 := (tmp0 + tmp1) * sec0
    out1 := (tmp0 - tmp1) * sec1
    sum02 := i0 + i2
    sub02 := i0 - i2
    t[d] = sum02 + out0
    t[d + 1] = sub02 + out1
    t[d + 2] = sub02 - out1
    t[d + 3] = sum02 - out0
}

// 1D DCT of t[d..d + n] (n a power of two) using t[s..s + n] as scratch.
// Inverse: x_k = X_0 + sqrt(2) sum X_u cos((2k + 1) u pi / 2n); forward is
// its exact inverse.
fn vd_dct1d(t: &mut[f32], d: usize, s: usize, n: usize, inverse: bool) {
    if n <= 1 {
        return
    }
    if n == 8 || n == 16 {
        vd_dct_matrix(t, d, s, n, inverse)
        return
    }
    if n == 2 {
        a := t[d] + t[d + 1]
        b := t[d] - t[d + 1]
        if inverse {
            t[d] = a
            t[d + 1] = b
        } else {
            t[d] = a / 2.0
            t[d + 1] = b / 2.0
        }
        return
    }
    if n == 4 {
        vd_dct4_inplace(t, d, inverse)
        return
    }
    half := n / 2
    if inverse {
        for i in 0usize..half {
            t[s + i] = t[d + 2 * i]
            t[s + half + i] = t[d + 2 * i + 1]
        }
        k := half - 1
        for k > 0 {
            t[s + half + k] += t[s + half + k - 1]
            k -= 1
        }
        t[s + half] *= VD_SQRT2
        vd_dct1d(t, s, d, half, true)
        vd_dct1d(t, s + half, d + half, half, true)
        for i in 0usize..half {
            r := t[s + half + i] * vd_sec(t, n, i)
            a := t[s + i]
            t[d + i] = a + r
            t[d + n - 1 - i] = a - r
        }
        return
    }
    for i in 0usize..half {
        a := t[d + i]
        b := t[d + n - 1 - i]
        t[s + i] = (a + b) / 2.0
        t[s + half + i] = (a - b) / 2.0 * vd_sec(t, n, i)
    }
    vd_dct1d(t, s, d, half, false)
    vd_dct1d(t, s + half, d + half, half, false)
    t[s + half] *= VD_SQRT2
    for i in 0usize..half - 1 {
        t[s + half + i] += t[s + half + i + 1]
    }
    for i in 0usize..half {
        t[d + 2 * i] = t[s + i]
        t[d + 2 * i + 1] = t[s + half + i]
    }
}

// Separable 2D DCT of a w x h block of `p` (row stride `stride`).
fn vd_dct2d(p: &mut[f32], off: usize, stride: usize, w: usize, h: usize, inverse: bool, t: &mut[f32]) {
    if w > 1 {
        for y in 0usize..h {
            row := off + y * stride
            for x in 0usize..w {
                t[x] = p[row + x]
            }
            vd_dct1d(t, 0, 256, w, inverse)
            for x in 0usize..w {
                p[row + x] = t[x]
            }
        }
    }
    if h > 1 {
        for x in 0usize..w {
            for y in 0usize..h {
                t[y] = p[off + y * stride + x]
            }
            vd_dct1d(t, 0, 256, h, inverse)
            for y in 0usize..h {
                p[off + y * stride + x] = t[y]
            }
        }
    }
}

// libjxl's FastLog2f / FastPow2f / FastPowf (fast_math-inl.h): the
// dequantization weights use them, so they are reproduced exactly.
fn vd_fast_log2f(x: f32) -> f32 {
    bits := convert.f32_bits(x) as i64
    exp_bits := bits - 0x3f2aaaab
    exp_shifted := 0i64
    if exp_bits >= 0 {
        exp_shifted = exp_bits >> 23
    } else {
        exp_shifted = -((-exp_bits + 8388607) >> 23)
    }
    mantissa := convert.f32_from_bits(((bits - exp_shifted * 8388608) & 0xffffffff) as u32) - 1.0
    yp := (0.74245873327820566f32 * mantissa + 1.4287160470083755) * mantissa + -0.0000018503833400518310
    yq := (0.17409343003366853f32 * mantissa + 1.0096718572241148) * mantissa + 0.99032814277590719
    return yp / yq + exp_shifted as f32
}

fn vd_fast_pow2f(x: f32) -> f32 {
    if !(x == x) || x < -126.0 {
        return 0.0
    }
    if x > 127.0 {
        return convert.f32_from_bits(0x7f800000)
    }
    floorx := math.floor(x as f64) as f32
    e := floorx as i64 + 127
    if e < 1 {
        return 0.0
    }
    if e > 254 {
        e = 254
    }
    scale := convert.f32_from_bits((e as u32) << 23)
    frac := x - floorx
    num := frac + 10.1749063
    num = num * frac + 48.8687798
    num = num * frac + 98.5506591
    num = num * scale
    den := frac * 0.210242958 + -0.0222328856
    den = den * frac + -19.4414990
    den = den * frac + 98.5506633
    return num / den
}

fn vd_fast_powf(b: f32, e: f32) -> f32 {
    return vd_fast_pow2f(vd_fast_log2f(b) * e)
}

fn vd_band_mult(v: f32) -> f32 {
    if v > 0.0 {
        return 1.0 + v
    }
    return 1.0 / (1.0 - v)
}

// Bands from parameters prm[base..base + n], into bands[..n]; fails when
// a band is too small.
fn vd_make_bands(prm: &[f32], base: usize, n: usize, bands: &mut[f32]) -> void!pixels.Error {
    if n == 0 || n > 16 {
        return err(pixels.Error.Malformed)
    }
    bands[0] = prm[base]
    if !(bands[0] >= 0.00000001) {
        return err(pixels.Error.Malformed)
    }
    for i in 1usize..n {
        bands[i] = bands[i - 1] * vd_band_mult(prm[base + i])
        if !(bands[i] >= 0.00000001) {
            return err(pixels.Error.Malformed)
        }
    }
    return ok()
}

// Interpolate(): position `scaled` in band units.
fn vd_interpolate(scaled: f32, bands: &[f32], n: usize) -> f32 {
    if n == 1 {
        return bands[0]
    }
    index := scaled as usize
    if index > n - 2 {
        index = n - 2
    }
    a := bands[index]
    b := bands[index + 1]
    return a * vd_fast_powf(b / a, scaled - index as f32)
}

fn vd_sqrt32(v: f32) -> f32 {
    match math.sqrt(v as f64) {
        ok(s) => {
            return s as f32
        }
        err(_) => {
            return 0.0
        }
    }
}

// DCT quantization weights (GetQuantWeights) of a width x height matrix
// from n bands.
fn vd_dct_weights(prm: &[f32], base: usize, n: usize, width: usize, height: usize, out: &mut[f32], at: usize) -> void!pixels.Error {
    bands := [0.0f32; 16]
    vd_make_bands(prm, base, n, &mut bands)?
    scale := (n - 1) as f32 / (1.41421356237f32 + 0.000001)
    rcpcol := scale / (width - 1) as f32
    rcprow := scale / (height - 1) as f32
    for y in 0usize..height {
        dy := y as f32 * rcprow
        dy2 := dy * dy
        for x in 0usize..width {
            dx := x as f32 * rcpcol
            out[at + y * width + x] = vd_interpolate(vd_sqrt32(dx * dx + dy2), &bands, n)
        }
    }
    return ok()
}

