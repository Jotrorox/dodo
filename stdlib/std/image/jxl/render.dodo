package jxl

import "core/ptr"
import "std/image/convert"
import "std/image/pixels"
import "std/image/sink"

// The float pipeline (see decode.dodo): decoded modular channels (XYB
// dequantized, bit depths normalized) or the VarDCT color planes go through
// chroma upsampling, Gaborish and the edge-preserving filter, become the
// frame's f32 planes (upsampled; patches and splines of upsampled frames
// apply to coded-size planes first), get noise, then the color transform,
// blending onto the canvas over reference slots and spot colors, following
// libjxl's render pipeline order.

const PATCH_NONE: u32 = 0
const PATCH_REPLACE: u32 = 1
const PATCH_ADD: u32 = 2
const PATCH_MUL: u32 = 3
const PATCH_BLEND_ABOVE: u32 = 4
const PATCH_BLEND_BELOW: u32 = 5
const PATCH_MULADD_ABOVE: u32 = 6
const PATCH_MULADD_BELOW: u32 = 7

// Float planes: the frame (planes of fw x fh), the canvas (image size),
// the reference slots, and filter rows. Plane count is 3 + extra channels.
struct FloatBufs {
    frame: &mut[f32]
    canvas: &mut[f32]
    slots: &mut[f32]
    ftemp: &mut[f32]
    // Three frame-sized planes for noise synthesis (empty without noise).
    noise: &mut[f32]
    // Coded-size planes of upsampled frames with patches or splines (lw x
    // lh; empty when no frame needs them).
    low: &mut[f32]
    planes: usize
    fw: usize
    fh: usize
    lw: usize
    lh: usize
    slot_off: [4]usize
    slot_cap: [4]usize
    // Stored size of each slot (the saved frame's window), the frame size
    // patches are checked against, and whether it holds a frame saved
    // before the color transform (only those feed patches, only the
    // others backgrounds, as in libjxl).
    slot_w: [4]usize
    slot_h: [4]usize
    slot_fw: [4]usize
    slot_fh: [4]usize
    slot_valid: [4]bool
    slot_before: [4]bool
    // False for a single frame covering the image: it is emitted from the
    // frame planes directly.
    use_canvas: bool
}

// The arena seen as f32 (for channels converted in place).
fn as_f32(ints: &mut[i32]) -> &mut[f32] from(ints) {
    unsafe {
        return ptr.borrow_slice_mut(ptr.as_mut_ptr(ints) as *mut f32, ints.len, ints)
    }
}

fn float_bits_i32(v: f32) -> i32 {
    return wrap_i32(convert.f32_bits(v) as i64)
}

// Convert the decoded channels to float in place: XYB dequantization for
// XYB images, bit depth normalization otherwise.
fn channels_to_float(h: &ImageHeader, f: &FrameHeader, work: &mut ModularWork, gch: &ChanList, vals: &FrameVals, ex: &Extras) {
    if !f.modular {
        // VarDCT: the color planes are separate, gch holds extra channels.
        for e in 0usize..h.num_extra as usize {
            convert_channel(work, gch, e, ex.get(e, EX_BITS), ex.get(e, EX_EXP))
        }
        return
    }
    color := f.color_channels as usize
    if h.xyb && color == 3 {
        w := gch.width(0)
        hh := gch.height(0)
        for y in 0usize..hh {
            p0 := gch.offset(0) + y * gch.stride(0)
            p1 := gch.offset(1) + y * gch.stride(1)
            p2 := gch.offset(2) + y * gch.stride(2)
            for x in 0usize..w {
                yv := work.arena[p0 + x] as i64
                xv := work.arena[p1 + x] as i64
                bv := work.arena[p2 + x] as i64 + yv
                if bv > 2147483647 {
                    bv = 2147483647
                }
                if bv < -2147483648 {
                    bv = -2147483648
                }
                work.arena[p0 + x] = float_bits_i32(xv as f32 * vals.m_lf[0])
                work.arena[p1 + x] = float_bits_i32(yv as f32 * vals.m_lf[1])
                work.arena[p2 + x] = float_bits_i32(bv as f32 * vals.m_lf[2])
            }
        }
    } else {
        for c in 0usize..color {
            convert_channel(work, gch, c, h.bits, h.exp_bits)
        }
    }
    for e in 0usize..h.num_extra as usize {
        convert_channel(work, gch, color + e, ex.get(e, EX_BITS), ex.get(e, EX_EXP))
    }
}

fn convert_channel(work: &mut ModularWork, gch: &ChanList, c: usize, bits: u32, exp_bits: u32) {
    for y in 0usize..gch.height(c) {
        p := gch.offset(c) + y * gch.stride(c)
        for x in 0usize..gch.width(c) {
            work.arena[p + x] = float_bits_i32(sample_to_float(work.arena[p + x], bits, exp_bits))
        }
    }
}

// 3x3 Gaborish smoothing of the three color channels (float, in the arena).
fn gaborish(f: &FrameHeader, a: &mut[f32], gch: &ChanList, temp: &mut[f32]) -> void!pixels.Error {
    for c in 0usize..3 {
        w1 := f.gab_weights[c * 2]
        w2 := f.gab_weights[c * 2 + 1]
        div := 1.0f32 + 4.0 * (w1 + w2)
        k0 := 1.0f32 / div
        k1 := w1 / div
        k2 := w2 / div
        w := gch.width(c)
        h := gch.height(c)
        off := gch.offset(c)
        stride := gch.stride(c)
        if 3 * w > temp.len {
            return err(pixels.Error.TooLarge)
        }
        // temp: original rows y - 1, y and y + 1 (mirrored at the edges).
        r0 := off + mirror(-1, h) * stride
        for x in 0usize..w {
            temp[x] = a[r0 + x]
            temp[w + x] = a[off + x]
        }
        for y in 0usize..h {
            ny := off + mirror(y as i64 + 1, h) * stride
            for x in 0usize..w {
                temp[2 * w + x] = a[ny + x]
            }
            row := off + y * stride
            for x in 0usize..w {
                l := mirror(x as i64 - 1, w)
                rr := mirror(x as i64 + 1, w)
                edges := temp[x] + temp[2 * w + x] + temp[w + l] + temp[w + rr]
                corners := temp[l] + temp[rr] + temp[2 * w + l] + temp[2 * w + rr]
                a[row + x] = k0 * temp[w + x] + k1 * edges + k2 * corners
            }
            for x in 0usize..w {
                temp[x] = temp[w + x]
                temp[w + x] = temp[2 * w + x]
            }
        }
    }
    return ok()
}

// Edge-preserving filter (libjxl stage_epf.cc), steps 0 to 2 on the three
// color channels in the arena; `src` receives a copy of each step's input.
// The inverse sigma is `inv_sigma` over the frame (modular frames:
// kInvSigmaNum over epf_sigma_for_modular) or, when `sigma_stride` is not 0,
// sigma[(y / 8) * sigma_stride + x / 8] per 8x8 block (VarDCT). Pixels
// whose inverse sigma is below kMinSigma stay unfiltered.
fn epf(f: &FrameHeader, a: &mut[f32], gch: &ChanList, src: &mut[f32], inv_sigma: f32, sigma: &[f32], sigma_stride: usize) -> void!pixels.Error {
    per_block := sigma_stride > 0
    if !per_block && inv_sigma < -3.9052429 {
        return ok()
    }
    w := gch.width(0)
    h := gch.height(0)
    plane := w * h
    if 3 * plane > src.len {
        return err(pixels.Error.TooLarge)
    }
    for step in 0u32..3 {
        if step == 0 && f.epf_iters < 3 {
            continue
        }
        if step == 2 && f.epf_iters < 2 {
            continue
        }
        for c in 0usize..3 {
            off := gch.offset(c)
            stride := gch.stride(c)
            for y in 0usize..h {
                for x in 0usize..w {
                    src[c * plane + y * w + x] = a[off + y * stride + x]
                }
            }
        }
        sm := 1.65f32
        if step == 0 {
            sm = f.epf_pass0_sigma * 1.65
        } else if step == 2 {
            sm = f.epf_pass2_sigma * 1.65
        }
        bsm := sm * f.epf_border_sad
        count := 4usize
        if step == 0 {
            count = 12
        }
        for y in 0usize..h {
            border_row := (y % 8) == 0 || (y % 8) == 7
            for x in 0usize..w {
                inv := inv_sigma
                if per_block {
                    inv = sigma[(y / 8) * sigma_stride + x / 8]
                    if inv < -3.9052429 {
                        continue
                    }
                }
                mul := sm
                if border_row || (x % 8) == 0 || (x % 8) == 7 {
                    mul = bsm
                }
                strength := inv * mul
                total := 1.0f32
                acc := [0.0f32; 3]
                for c in 0usize..3 {
                    acc[c] = src[c * plane + y * w + x]
                }
                for i in 0usize..count {
                    dy := 0i64
                    dx := 0i64
                    if step == 0 {
                        dy = EPF_OFFSETS[i * 2] as i64
                        dx = EPF_OFFSETS[i * 2 + 1] as i64
                    } else {
                        dy = EPF_PLUS[(i + 1) * 2] as i64
                        dx = EPF_PLUS[(i + 1) * 2 + 1] as i64
                    }
                    ny := mirror(y as i64 + dy, h)
                    nx := mirror(x as i64 + dx, w)
                    sad := 0.0f32
                    for c in 0usize..3 {
                        base := c * plane
                        d := 0.0f32
                        if step == 2 {
                            d = src[base + ny * w + nx] - src[base + y * w + x]
                            if d < 0.0 {
                                d = -d
                            }
                        } else {
                            for k in 0usize..5 {
                                oy := EPF_PLUS[k * 2] as i64
                                ox := EPF_PLUS[k * 2 + 1] as i64
                                p := src[base + mirror(y as i64 + oy, h) * w + mirror(x as i64 + ox, w)]
                                q := src[base + mirror(y as i64 + dy + oy, h) * w + mirror(x as i64 + dx + ox, w)]
                                e := p - q
                                if e < 0.0 {
                                    e = -e
                                }
                                d += e
                            }
                        }
                        sad += d * f.epf_channel_scale[c]
                    }
                    weight := sad * strength + 1.0
                    if weight < 0.0 {
                        weight = 0.0
                    }
                    total += weight
                    for c in 0usize..3 {
                        acc[c] += weight * src[c * plane + ny * w + nx]
                    }
                }
                norm := 1.0f32 / total
                for c in 0usize..3 {
                    a[gch.offset(c) + y * gch.stride(c) + x] = acc[c] * norm
                }
            }
        }
    }
    return ok()
}

// Step 0 neighbors (row, column), and the plus shape (center first).
static EPF_OFFSETS: [24]i32 = [-2, 0, -1, -1, -1, 0, -1, 1, 0, -2, 0, -1, 0, 1, 0, 2, 1, -1, 1, 0, 1, 1, 2, 0]
static EPF_PLUS: [10]i32 = [0, 0, -1, 0, 0, -1, 0, 1, 1, 0]

fn mirror(v: i64, size: usize) -> usize {
    n := size as i64
    x := v
    for {
        if x < 0 {
            x = -x - 1
        } else if x >= n {
            x = 2 * n - x - 1
        } else {
            return x as usize
        }
    }
}

// Upsampling weights for factor `n` (2, 4 or 8): the header's custom ones
// or the defaults.
fn upsampling_kernel(r: &mut Reader, h: &ImageHeader, n: usize, kernel: &mut[f32]) {
    count := 15usize
    defaults := &UP2_WEIGHTS[..]
    bit := 1u32
    if n == 4 {
        count = 55
        defaults = &UP4_WEIGHTS[..]
        bit = 2
    } else if n == 8 {
        count = 210
        defaults = &UP8_WEIGHTS[..]
        bit = 4
    }
    weights := [0.0f32; 210]
    for i in 0usize..count {
        weights[i] = defaults[i]
    }
    if (h.custom_weights & bit) != 0 {
        skip := 0u64
        if bit > 1 && (h.custom_weights & 1) != 0 {
            skip += 15
        }
        if bit > 2 && (h.custom_weights & 2) != 0 {
            skip += 55
        }
        r.clear_limit()
        r.seek_bit(h.weights_bit + skip * 16)
        for i in 0usize..count {
            weights[i] = r.f16()
        }
    }
    half := n / 2
    for ky in 0usize..half {
        for kx in 0usize..half {
            o0 := (ky * n + kx) * 25
            o1 := (ky * n + (n - 1 - kx)) * 25
            o2 := ((n - 1 - ky) * n + kx) * 25
            o3 := ((n - 1 - ky) * n + (n - 1 - kx)) * 25
            for py in 0usize..5 {
                for px in 0usize..5 {
                    j := 5 * ky + py
                    i := 5 * kx + px
                    my := i
                    mx := j
                    if j < i {
                        my = j
                        mx = i
                    }
                    index := mx
                    if my > 0 {
                        index = 5 * half * my - my * (my - 1) / 2 + mx - my
                    }
                    w := weights[index]
                    kernel[o0 + py * 5 + px] = w
                    kernel[o1 + py * 5 + (4 - px)] = w
                    kernel[o2 + (4 - py) * 5 + px] = w
                    kernel[o3 + (4 - py) * 5 + (4 - px)] = w
                }
            }
        }
    }
}

// Copy or upsample float channel c of `a` (described by gch) into plane
// `plane` of `out` (planes of fw x fh).
fn fill_plane(r: &mut Reader, h: &ImageHeader, a: &[f32], gch: &ChanList, c: usize, factor: usize, out: &mut[f32], fw: usize, fh: usize, plane: usize) {
    dst := plane * fw * fh
    off := gch.offset(c)
    stride := gch.stride(c)
    w := gch.width(c)
    hh := gch.height(c)
    if factor <= 1 {
        for y in 0usize..fh {
            sy := y
            if sy >= hh {
                sy = hh - 1
            }
            for x in 0usize..fw {
                sx := x
                if sx >= w {
                    sx = w - 1
                }
                out[dst + y * fw + x] = a[off + sy * stride + sx]
            }
        }
        return
    }
    kernel := [0.0f32; 1600]
    upsampling_kernel(r, h, factor, &mut kernel)
    for y in 0usize..fh {
        iy := y / factor
        oy := y % factor
        for x in 0usize..fw {
            ix := x / factor
            ox := x % factor
            k := (oy * factor + ox) * 25
            sum := 0.0f32
            lo := 3.4e38f32
            hi := -3.4e38f32
            for py in 0usize..5 {
                sy := mirror(iy as i64 + py as i64 - 2, hh)
                row := off + sy * stride
                for px in 0usize..5 {
                    sx := mirror(ix as i64 + px as i64 - 2, w)
                    v := a[row + sx]
                    sum += kernel[k + py * 5 + px] * v
                    if v < lo {
                        lo = v
                    }
                    if v > hi {
                        hi = v
                    }
                }
            }
            if sum < lo {
                sum = lo
            }
            if sum > hi {
                sum = hi
            }
            out[dst + y * fw + x] = sum
        }
    }
}

// Horizontal chroma upsampling of row `row` (channel c of `gch`) at
// output column x.
fn chroma_h(a: &[f32], gch: &ChanList, c: usize, row: usize, x: usize) -> f32 {
    base := gch.offset(c) + row * gch.stride(c)
    if gch.hshift(c) == 0 {
        return a[base + x]
    }
    n := gch.width(c)
    sx := x >> 1
    cur := a[base + sx] * 0.75
    if (x & 1) == 0 {
        return 0.25 * a[base + mirror(sx as i64 - 1, n)] + cur
    }
    return 0.25 * a[base + mirror(sx as i64 + 1, n)] + cur
}

// Upsample a subsampled YCbCr channel c of `gch` to the full w x h sample
// size at a[out..] (stride w) as libjxl does: 3/4 nearest + 1/4 next
// sample, horizontally then vertically, edges mirrored.
fn chroma_to_full(a: &mut[f32], gch: &ChanList, c: usize, out: usize, w: usize, h: usize) {
    m := gch.height(c)
    for y in 0usize..h {
        for x in 0usize..w {
            v := 0.0f32
            if gch.vshift(c) == 0 {
                v = chroma_h(a, gch, c, y, x)
            } else {
                sy := y >> 1
                mid := chroma_h(a, gch, c, sy, x) * 0.75
                other := mirror(sy as i64 - 1, m)
                if (y & 1) == 1 {
                    other = mirror(sy as i64 + 1, m)
                }
                v = chroma_h(a, gch, c, other, x) * 0.25 + mid
            }
            a[out + y * w + x] = v
        }
    }
}

fn clamp01(v: f32) -> f32 {
    if v < 0.0 {
        return 0.0
    }
    if v > 1.0 {
        return 1.0
    }
    return v
}

// Round to nearest, ties to even, for 0 <= v < 2^31.
fn nearest(v: f32) -> u32 {
    if !(v > 0.0) {
        return 0
    }
    if v >= 4294967040.0 {
        return 0xffffff00
    }
    whole := v as u32
    fraction := v - whole as f32
    if fraction > 0.5 || (fraction == 0.5 && (whole & 1) == 1) {
        return whole + 1
    }
    return whole
}

fn uses_alpha(mode: u32) -> bool {
    return mode == PATCH_BLEND_ABOVE || mode == PATCH_BLEND_BELOW || mode == PATCH_MULADD_ABOVE || mode == PATCH_MULADD_BELOW
}

// libjxl's PerformBlending for one pixel: ex.v holds the background, the
// foreground and the result (3 + num_ec values each); the color blending is
// (mode0, alpha0, clamp0), each extra channel's is in its EX_PMODE,
// EX_PALPHA and EX_PCLAMP words (patch blending modes).
fn blend_pixel(h: &ImageHeader, ex: &mut Extras, mode0: u32, alpha0: u32, clamp0: bool, has_alpha: bool) {
    nec := h.num_extra as usize
    np := 3 + nec
    fo := np
    oo := 2 * np
    for i in 0usize..nec {
        mode := ex.get(i, EX_PMODE)
        b := ex.v[3 + i]
        fv := ex.v[fo + 3 + i]
        alpha := ex.get(i, EX_PALPHA) as usize
        if alpha >= nec {
            alpha = 0
        }
        clamp := ex.get(i, EX_PCLAMP) != 0
        premultiplied := ex.get(alpha, EX_ASSOC) != 0
        v := b
        if mode == PATCH_ADD {
            v = b + fv
        } else if mode == PATCH_BLEND_ABOVE || mode == PATCH_BLEND_BELOW {
            lower := b
            lower_a := ex.v[3 + alpha]
            upper := fv
            upper_a := ex.v[fo + 3 + alpha]
            if mode == PATCH_BLEND_BELOW {
                lower = fv
                lower_a = ex.v[fo + 3 + alpha]
                upper = b
                upper_a = ex.v[3 + alpha]
            }
            fa := upper_a
            if clamp {
                fa = clamp01(fa)
            }
            if alpha == i {
                v = 1.0 - (1.0 - fa) * (1.0 - lower_a)
            } else if premultiplied {
                v = upper + lower * (1.0 - fa)
            } else {
                new_a := 1.0 - (1.0 - fa) * (1.0 - lower_a)
                inv := 0.0f32
                if new_a > 0.0 {
                    inv = 1.0 / new_a
                }
                v = (upper * fa + lower * lower_a * (1.0 - fa)) * inv
            }
        } else if mode == PATCH_MULADD_ABOVE || mode == PATCH_MULADD_BELOW {
            lower := b
            upper := fv
            upper_a := ex.v[fo + 3 + alpha]
            if mode == PATCH_MULADD_BELOW {
                lower = fv
                upper = b
                upper_a = ex.v[3 + alpha]
            }
            if alpha == i {
                v = lower
            } else {
                fa := upper_a
                if clamp {
                    fa = clamp01(fa)
                }
                v = lower + upper * fa
            }
        } else if mode == PATCH_MUL {
            m := fv
            if clamp {
                m = clamp01(m)
            }
            v = b * m
        } else if mode == PATCH_REPLACE {
            v = fv
        }
        ex.v[oo + 3 + i] = v
    }
    mode := mode0
    alpha := alpha0 as usize
    if alpha >= nec {
        alpha = 0
    }
    if mode == PATCH_ADD || ((mode == PATCH_MULADD_ABOVE || mode == PATCH_MULADD_BELOW) && !has_alpha) {
        for c in 0usize..3 {
            ex.v[oo + c] = ex.v[c] + ex.v[fo + c]
        }
    } else if mode == PATCH_MULADD_ABOVE || mode == PATCH_MULADD_BELOW {
        fa := ex.v[fo + 3 + alpha]
        if mode == PATCH_MULADD_BELOW {
            fa = ex.v[3 + alpha]
        }
        if clamp0 {
            fa = clamp01(fa)
        }
        for c in 0usize..3 {
            if mode == PATCH_MULADD_ABOVE {
                ex.v[oo + c] = ex.v[c] + ex.v[fo + c] * fa
            } else {
                ex.v[oo + c] = ex.v[fo + c] + ex.v[c] * fa
            }
        }
    } else if mode == PATCH_BLEND_ABOVE || mode == PATCH_BLEND_BELOW {
        if !has_alpha {
            for c in 0usize..3 {
                ex.v[oo + c] = ex.v[fo + c]
            }
        } else {
            premultiplied := ex.get(alpha, EX_ASSOC) != 0
            above := mode == PATCH_BLEND_ABOVE
            lower_a := ex.v[3 + alpha]
            fa := ex.v[fo + 3 + alpha]
            if !above {
                lower_a = ex.v[fo + 3 + alpha]
                fa = ex.v[3 + alpha]
            }
            if clamp0 {
                fa = clamp01(fa)
            }
            new_a := 1.0 - (1.0 - fa) * (1.0 - lower_a)
            inv := 0.0f32
            if new_a > 0.0 {
                inv = 1.0 / new_a
            }
            for c in 0usize..3 {
                upper := ex.v[fo + c]
                lower := ex.v[c]
                if !above {
                    upper = ex.v[c]
                    lower = ex.v[fo + c]
                }
                if premultiplied {
                    ex.v[oo + c] = upper + lower * (1.0 - fa)
                } else {
                    ex.v[oo + c] = (upper * fa + lower * lower_a * (1.0 - fa)) * inv
                }
            }
            ex.v[oo + 3 + alpha] = new_a
        }
    } else if mode == PATCH_MUL {
        for c in 0usize..3 {
            m := ex.v[fo + c]
            if clamp0 {
                m = clamp01(m)
            }
            ex.v[oo + c] = ex.v[c] * m
        }
    } else if mode == PATCH_REPLACE {
        for c in 0usize..3 {
            ex.v[oo + c] = ex.v[fo + c]
        }
    } else {
        for c in 0usize..3 {
            ex.v[oo + c] = ex.v[c]
        }
    }
}

// Frame blending mode to patch blending mode.
fn patch_mode(mode: u32) -> u32 {
    if mode == BLEND_ADD {
        return PATCH_ADD
    }
    if mode == BLEND_BLEND {
        return PATCH_BLEND_ABOVE
    }
    if mode == BLEND_MULADD {
        return PATCH_MULADD_ABOVE
    }
    if mode == BLEND_MUL {
        return PATCH_MUL
    }
    return PATCH_REPLACE
}

// The size patches are positioned in: the coded (not upsampled) frame
// size, padded to whole blocks for VarDCT frames (as libjxl checks them).
fn patch_area(f: &FrameHeader, vertical: bool) -> u64 {
    if !f.modular {
        return vardct_blocks(f, vertical) as u64 * 8
    }
    if vertical {
        return f.sample_height as u64
    }
    return f.sample_width as u64
}

// Parse the patches at the reader; with `apply`, blend each patch from its
// reference slot into the frame planes as it is read (in decoding order,
// which is libjxl's order for overlapping patches). Patches apply before
// upsampling: into the frame planes (upsampling 1) or, with `low`, into the
// coded-size planes fb.low (lw x lh). Parts outside the planes are clipped.
fn patches(r: &mut Reader, h: &ImageHeader, f: &FrameHeader, tcode: &mut Code, n1: &mut Code, n2: &mut Code, window: &mut[u32], apply: bool, fb: &mut FloatBufs, ex: &mut Extras, low: bool) -> void!pixels.Error {
    read_code(r, 10, tcode, n1, n2, window)?
    stream := Stream.new(window)
    stream.begin(tcode, r)
    nec := h.num_extra as usize
    fw := patch_area(f, false)
    fh := patch_area(f, true)
    max_refs := 1024 + fw * fh / 4
    // Patches land only in the part of the frame that matters (see
    // window.dodo, in the frame's patch coordinates); the slots hold what
    // that part reads.
    apply_w := f.patch_w as usize
    apply_h := f.patch_h as usize
    max_patches := max_refs * 4
    num_refs := tcode.read(&mut stream, r, 0, 0) as u64
    if num_refs > max_refs {
        return err(pixels.Error.Malformed)
    }
    if apply && ex.n < nec {
        return err(pixels.Error.TooLarge)
    }
    total := 0u64
    has_alpha := h.has_alpha()
    planes := 3 + nec
    tw := fb.fw
    th := fb.fh
    if low {
        tw = fb.lw
        th = fb.lh
    }
    if apply_w > tw {
        apply_w = tw
    }
    if apply_h > th {
        apply_h = th
    }
    for i in 0u64..num_refs {
        slot := tcode.read(&mut stream, r, 1, 0) as usize
        if slot >= 4 {
            return err(pixels.Error.Malformed)
        }
        rx := tcode.read(&mut stream, r, 3, 0) as usize
        ry := tcode.read(&mut stream, r, 3, 0) as usize
        pw := tcode.read(&mut stream, r, 2, 0) as usize + 1
        ph := tcode.read(&mut stream, r, 2, 0) as usize + 1
        if apply {
            if !fb.slot_valid[slot] || !fb.slot_before[slot] || rx + pw > fb.slot_fw[slot] || ry + ph > fb.slot_fh[slot] {
                return err(pixels.Error.Malformed)
            }
        }
        count := tcode.read(&mut stream, r, 7, 0) as u64
        if count > max_patches {
            return err(pixels.Error.Malformed)
        }
        count += 1
        total += count
        if total > max_patches {
            return err(pixels.Error.Malformed)
        }
        px := 0i64
        py := 0i64
        for k in 0u64..count {
            if k == 0 {
                px = tcode.read(&mut stream, r, 4, 0) as i64
                py = tcode.read(&mut stream, r, 4, 0) as i64
            } else {
                px += unpack_signed(tcode.read(&mut stream, r, 6, 0)) as i64
                py += unpack_signed(tcode.read(&mut stream, r, 6, 0)) as i64
                if px < 0 || py < 0 {
                    return err(pixels.Error.Malformed)
                }
            }
            if px as u64 + pw as u64 > fw || py as u64 + ph as u64 > fh {
                return err(pixels.Error.Malformed)
            }
            mode0 := 0u32
            alpha0 := 0u32
            clamp0 := false
            for j in 0usize..nec + 1 {
                mode := tcode.read(&mut stream, r, 5, 0)
                if mode >= 8 {
                    return err(pixels.Error.Malformed)
                }
                alpha := 0u32
                if uses_alpha(mode) && nec > 1 {
                    alpha = tcode.read(&mut stream, r, 8, 0)
                    if alpha as usize >= nec {
                        return err(pixels.Error.Malformed)
                    }
                }
                clamp := false
                if uses_alpha(mode) || mode == PATCH_MUL {
                    clamp = tcode.read(&mut stream, r, 9, 0) != 0
                }
                if j == 0 {
                    mode0 = mode
                    alpha0 = alpha
                    clamp0 = clamp
                } else if apply {
                    ex.put(j - 1, EX_PMODE, mode)
                    ex.put(j - 1, EX_PALPHA, alpha)
                    clamped := 0u32
                    if clamp {
                        clamped = 1
                    }
                    ex.put(j - 1, EX_PCLAMP, clamped)
                }
            }
            if r.overrun {
                return err(pixels.Error.Truncated)
            }
            if !apply {
                continue
            }
            target_plane := tw * th
            sw := fb.slot_w[slot]
            slot_plane := sw * fb.slot_h[slot]
            base := fb.slot_off[slot]
            fo := planes
            oo := 2 * planes
            for dy in 0usize..ph {
                ty := py as usize + dy
                if ty >= apply_h || ry + dy >= fb.slot_h[slot] {
                    break
                }
                for dx in 0usize..pw {
                    tx := px as usize + dx
                    if tx >= apply_w || rx + dx >= sw {
                        break
                    }
                    for c in 0usize..planes {
                        at := c * target_plane + ty * tw + tx
                        if low {
                            ex.v[c] = fb.low[at]
                        } else {
                            ex.v[c] = fb.frame[at]
                        }
                        ex.v[fo + c] = fb.slots[base + c * slot_plane + (ry + dy) * sw + rx + dx]
                    }
                    blend_pixel(h, ex, mode0, alpha0, clamp0, has_alpha)
                    for c in 0usize..planes {
                        at := c * target_plane + ty * tw + tx
                        if low {
                            fb.low[at] = ex.v[oo + c]
                        } else {
                            fb.frame[at] = ex.v[oo + c]
                        }
                    }
                }
            }
        }
    }
    stream.finish(tcode)?
    return ok()
}

fn skip_patches(r: &mut Reader, h: &ImageHeader, f: &FrameHeader, tcode: &mut Code, n1: &mut Code, n2: &mut Code, window: &mut[u32]) -> void!pixels.Error {
    e1 := [0.0f32; 1]
    e2 := [0.0f32; 1]
    e3 := [0.0f32; 1]
    e4 := [0.0f32; 1]
    e5 := [0.0f32; 1]
    e6 := [0.0f32; 1]
    w := [0u32; 1]
    v := [0.0f32; 1]
    fb := FloatBufs { frame: &mut e1, canvas: &mut e2, slots: &mut e3, ftemp: &mut e4, noise: &mut e5, low: &mut e6, planes: 0, fw: 0, fh: 0, lw: 0, lh: 0, slot_off: [0usize; 4], slot_cap: [0usize; 4], slot_w: [0usize; 4], slot_h: [0usize; 4], slot_fw: [0usize; 4], slot_fh: [0usize; 4], slot_valid: [false; 4], slot_before: [false; 4], use_canvas: false }
    ex := Extras { w: &mut w, v: &mut v, n: 0 }
    return patches(r, h, f, tcode, n1, n2, window, false, &mut fb, &mut ex, false)
}

// Copy planes into reference slot k: the top-left width x height of the
// frame planes, or the canvas (image size). `before` marks a frame saved
// before the color transform, whose full size is fw x fh.
fn save_slot(fb: &mut FloatBufs, k: usize, from_frame: bool, width: usize, height: usize, before: bool, fw: usize, fh: usize) -> void!pixels.Error {
    pixels_count := width * height
    if pixels_count > fb.slot_cap[k] || (from_frame && (width > fb.fw || height > fb.fh)) {
        return err(pixels.Error.TooLarge)
    }
    base := fb.slot_off[k]
    frame_plane := fb.fw * fb.fh
    for c in 0usize..fb.planes {
        for y in 0usize..height {
            for x in 0usize..width {
                v := 0.0f32
                if from_frame {
                    v = fb.frame[c * frame_plane + y * fb.fw + x]
                } else {
                    v = fb.canvas[c * pixels_count + y * width + x]
                }
                fb.slots[base + c * pixels_count + y * width + x] = v
            }
        }
    }
    fb.slot_w[k] = width
    fb.slot_h[k] = height
    fb.slot_fw[k] = fw
    fb.slot_fh[k] = fh
    fb.slot_valid[k] = true
    fb.slot_before[k] = before
    return ok()
}

// The background sample of plane c at canvas (x, y) from slot k (zero when
// the slot is empty or smaller).
fn slot_sample(fb: &FloatBufs, k: usize, c: usize, x: usize, y: usize) -> f32 {
    if !fb.slot_valid[k] || x >= fb.slot_w[k] || y >= fb.slot_h[k] {
        return 0.0
    }
    return fb.slots[fb.slot_off[k] + c * fb.slot_w[k] * fb.slot_h[k] + y * fb.slot_w[k] + x]
}

// Compose the frame onto the canvas: over the reference slots for blended
// or cropped frames, as a copy otherwise.
fn compose(h: &ImageHeader, f: &FrameHeader, fb: &mut FloatBufs, ex: &mut Extras) -> void!pixels.Error {
    width := h.width as usize
    height := h.height as usize
    canvas_plane := width * height
    frame_plane := fb.fw * fb.fh
    planes := fb.planes
    nec := h.num_extra as usize
    if !f.needs_blending(h.num_extra) {
        for c in 0usize..planes {
            for y in 0usize..height {
                for x in 0usize..width {
                    v := 0.0f32
                    if x < fb.fw && y < fb.fh {
                        v = fb.frame[c * frame_plane + y * fb.fw + x]
                    }
                    fb.canvas[c * canvas_plane + y * width + x] = v
                }
            }
        }
        return ok()
    }
    if ex.n < nec {
        return err(pixels.Error.TooLarge)
    }
    // The frame's extra channel blending as patch blending modes.
    for i in 0usize..nec {
        mode := patch_mode(ex.get(i, EX_MODE))
        ex.put(i, EX_PMODE, mode)
        alpha := ex.get(i, EX_ALPHA)
        ex.put(i, EX_PALPHA, alpha)
        clamp := ex.get(i, EX_CLAMP)
        ex.put(i, EX_PCLAMP, clamp)
    }
    mode0 := patch_mode(f.blend_mode)
    has_alpha := h.has_alpha()
    fo := planes
    oo := 2 * planes
    for y in 0usize..height {
        for x in 0usize..width {
            for c in 0usize..planes {
                src := f.blend_source as usize
                if c >= 3 {
                    src = ex.get(c - 3, EX_SOURCE) as usize
                }
                ex.v[c] = slot_sample(fb, src, c, x, y)
            }
            fx := x as i64 - f.x0 as i64
            fy := y as i64 - f.y0 as i64
            if fx >= 0 && fy >= 0 && fx < fb.fw as i64 && fy < fb.fh as i64 {
                for c in 0usize..planes {
                    ex.v[fo + c] = fb.frame[c * frame_plane + fy as usize * fb.fw + fx as usize]
                }
                blend_pixel(h, ex, mode0, f.blend_alpha, f.blend_clamp, has_alpha)
                for c in 0usize..planes {
                    fb.canvas[c * canvas_plane + y * width + x] = ex.v[oo + c]
                }
            } else {
                for c in 0usize..planes {
                    fb.canvas[c * canvas_plane + y * width + x] = ex.v[c]
                }
            }
        }
    }
    return ok()
}

// Restoration filters on the color channels `cch` of `a` (floats), then
// the channels into the frame planes (upsampled) or, with `low`, copied at
// their coded size into fb.low. EPF uses vb.sigma per 8x8 block for VarDCT
// frames (`per_block`), `inv_sigma` otherwise.
fn filter_color(r: &mut Reader, h: &ImageHeader, f: &FrameHeader, a: &mut[f32], cch: &ChanList, fb: &mut FloatBufs, vb: &VBufs, per_block: bool, low: bool) -> void!pixels.Error {
    if f.gab {
        gaborish(f, a, cch, fb.ftemp)?
    }
    if f.epf_iters > 0 {
        if per_block {
            epf(f, a, cch, fb.frame, 0.0, vb.sigma, vb.bw)?
        } else {
            // kInvSigmaNum / sigma; the frame planes are free scratch here.
            empty := [0.0f32; 1]
            epf(f, a, cch, fb.frame, -1.1715728752538099 / f.epf_sigma_modular, &empty, 0)?
        }
    }
    for c in 0usize..3 {
        if low {
            fill_plane(r, h, a, cch, c, 1, fb.low, fb.lw, fb.lh, c)
        } else {
            fill_plane(r, h, a, cch, c, f.upsampling as usize, fb.frame, fb.fw, fb.fh, c)
        }
    }
    return ok()
}

// Render one decoded frame through the float pipeline. VarDCT frames
// bring their color samples in `planes` (3 planes of vb.rw x vb.rh).
// Stage order as in libjxl: chroma upsampling, Gaborish, EPF, extra
// channel upsampling (unless every extra channel shares the color
// upsampling), patches, splines, upsampling, noise.
fn render_frame(r: &mut Reader, h: &ImageHeader, f: &FrameHeader, work: &mut ModularWork, gch: &ChanList, vals: &FrameVals, fb: &mut FloatBufs, vb: &mut VBufs, planes: &mut[f32], sbuf: &mut[i32], cpf: &mut[f32], tcode: &mut Code, n1: &mut Code, n2: &mut Code, window: &mut[u32], ct: &ColorTransform, ex: &mut Extras) -> void!pixels.Error {
    // The frame's pixel window (see window.dodo).
    fw := f.win_pw as usize
    fh := f.win_ph as usize
    if f.frame_type == FT_LF {
        // LF frames hold the 1:8^lf_level image (upsampled from their coded
        // size like other frames).
        shift := (3 * f.lf_level) as u64
        fw = ceil_shift(f.width as u64, shift as u32) as usize
        fh = ceil_shift(f.height as u64, shift as u32) as usize
    }
    if fb.planes * fw * fh > fb.frame.len {
        return err(pixels.Error.TooLarge)
    }
    fb.fw = fw
    fb.fh = fh
    nec := h.num_extra as usize
    if ex.n < nec {
        return err(pixels.Error.TooLarge)
    }
    channels_to_float(h, f, work, gch, vals, ex)
    color := f.color_channels as usize
    up := f.upsampling as usize
    has_patches := (f.flags & FLAG_PATCHES) != 0
    has_splines := (f.flags & FLAG_SPLINES) != 0
    // Extra channels with the color channels' sample size are upsampled
    // with them, after patches and splines; others first. Patches in
    // upsampled frames need the former (libjxl rejects the rest).
    late_ec := up > 1 && f.ec_same_size(h.num_extra)
    if has_patches && up > 1 && !late_ec {
        return err(pixels.Error.Malformed)
    }
    // Patches and splines of upsampled frames apply to the coded-size
    // planes in fb.low.
    low := up > 1 && (has_patches || has_splines)
    if low {
        // Over the sample window (see window.dodo).
        sw := f.win_sw as usize
        sh := f.win_sh as usize
        count := 3usize
        if late_ec {
            count = fb.planes
        }
        if count * sw * sh > fb.low.len {
            return err(pixels.Error.TooLarge)
        }
        fb.lw = sw
        fb.lh = sh
    }
    // The color channels as three float channel views.
    cd := [0i32; 3 * CH_STRIDE]
    cch := ChanList { d: &mut cd, count: 3, nb_meta: 0 }
    mark := work.arena_used
    if !f.modular {
        for c in 0usize..3 {
            cch.set(c, c * vb.rw * vb.rh, vb.rw, f.win_sw as usize, f.win_sh as usize, 0, 0)
        }
        if vb.subsampled {
            upsample_chroma(f, vb, planes)
        }
        filter_color(r, h, f, planes, &cch, fb, vb, true, low)?
    } else {
        // Full-size copies cover the sample window (see window.dodo).
        w := f.win_sw as usize
        hh := f.win_sh as usize
        subsampled := f.ycbcr && chroma_subsampled(f)
        filters := f.gab || f.epf_iters > 0
        for c in 0usize..3 {
            source := c
            if color == 1 {
                source = 0
            }
            cch.set(c, gch.offset(source), gch.stride(source), gch.width(source), gch.height(source), 0, 0)
            // Gray frames are filtered as three copies of the channel (as
            // libjxl does); subsampled chroma is upsampled to full size
            // first. The copies live at the arena top meanwhile.
            copy := (color == 1 && c > 0 && filters) || (subsampled && (gch.hshift(c) != 0 || gch.vshift(c) != 0))
            if copy {
                off := work.alloc(w as u64 * hh as u64)?
                if color == 1 {
                    for y in 0usize..hh {
                        for x in 0usize..w {
                            work.arena[off + y * w + x] = work.arena[gch.offset(0) + y * gch.stride(0) + x]
                        }
                    }
                } else {
                    chroma_to_full(as_f32(work.arena), gch, c, off, w, hh)
                }
                cch.set(c, off, w, w, hh, 0, 0)
            }
        }
        filter_color(r, h, f, as_f32(work.arena), &cch, fb, vb, false, low)?
    }
    // Extra channels.
    ec_first := 0usize
    if f.modular {
        ec_first = color
    }
    for e in 0usize..nec {
        if low && late_ec {
            fill_plane(r, h, as_f32(work.arena), gch, ec_first + e, 1, fb.low, fb.lw, fb.lh, 3 + e)
        } else {
            fill_plane(r, h, as_f32(work.arena), gch, ec_first + e, ex.get(e, EX_UP) as usize, fb.frame, fb.fw, fb.fh, 3 + e)
        }
    }
    work.arena_used = mark
    ytox := 0.0f32
    ytob := 1.0f32
    if !f.modular {
        ytox = vb.base_x
        ytob = vb.base_b
    }
    if has_patches {
        r.clear_limit()
        r.seek_bit(vals.patches_bit)
        patches(r, h, f, tcode, n1, n2, window, true, fb, ex, low)?
    }
    if has_splines {
        r.clear_limit()
        r.seek_bit(vals.splines_bit)
        if low {
            splines(r, f, tcode, n1, n2, window, true, fb.low, fb.lw, fb.lh, sbuf, cpf, ytox, ytob)?
        } else {
            splines(r, f, tcode, n1, n2, window, true, fb.frame, fw, fh, sbuf, cpf, ytox, ytob)?
        }
    }
    if low {
        // Upsample the coded-size planes into the frame planes.
        count := 3usize
        if late_ec {
            count = fb.planes
        }
        lplane := fb.lw * fb.lh
        for k in 0usize..count {
            one := [0i32; CH_STRIDE]
            lch := ChanList { d: &mut one, count: 1, nb_meta: 0 }
            lch.set(0, k * lplane, fb.lw, fb.lw, fb.lh, 0, 0)
            fill_plane(r, h, fb.low, &lch, 0, up, fb.frame, fb.fw, fb.fh, k)
        }
    }
    if (f.flags & FLAG_NOISE) != 0 {
        render_noise(f, fb, &vals.noise_lut, vals.visible, vals.nonvisible, ytox, ytob)?
    }
    if f.frame_type == FT_LF {
        store_lf_slot(vb, (f.lf_level - 1) as usize, fb.frame, fw, fh)?
    }
    if f.can_reference() && f.save_before_ct {
        save_slot(fb, f.save_as_reference as usize, true, fw, fh, true, f.width as usize, f.height as usize)?
    }
    // Color transform. libjxl renders spot colors after blending and saving
    // the frame, on linear samples for XYB frames that are neither blended
    // nor saved after the color transform (its conversion from linear comes
    // last then), on output samples otherwise.
    plane := fw * fh
    spots := h.any_spot && f.is_normal()
    linear_spots := spots && h.xyb && !f.needs_blending(h.num_extra) && !(f.can_reference() && !f.save_before_ct)
    if h.xyb {
        for i in 0usize..plane {
            x := fb.frame[i]
            y := fb.frame[plane + i]
            b := fb.frame[2 * plane + i]
            if linear_spots {
                xyb_linear(ct, &mut x, &mut y, &mut b)
                fb.frame[i] = x
                fb.frame[plane + i] = y
                fb.frame[2 * plane + i] = b
                spot_pixel(h, ex, fb.frame, plane, i)
                x = encode_transfer(ct, fb.frame[i])
                y = encode_transfer(ct, fb.frame[plane + i])
                b = encode_transfer(ct, fb.frame[2 * plane + i])
            } else {
                xyb_pixel(ct, &mut x, &mut y, &mut b)
            }
            fb.frame[i] = x
            fb.frame[plane + i] = y
            fb.frame[2 * plane + i] = b
        }
    } else if f.ycbcr {
        for i in 0usize..plane {
            cb := fb.frame[i]
            yv := fb.frame[plane + i] + 128.0 / 255.0
            cr := fb.frame[2 * plane + i]
            fb.frame[i] = yv + 1.402 * cr
            fb.frame[plane + i] = yv - 0.344136 * cb - 0.714136 * cr
            fb.frame[2 * plane + i] = yv + 1.772 * cb
        }
    }
    if !f.is_normal() {
        if f.can_reference() && !f.save_before_ct {
            // Only backgrounds read it, over the image area.
            sw := fw
            if sw > h.width as usize {
                sw = h.width as usize
            }
            sh := fh
            if sh > h.height as usize {
                sh = h.height as usize
            }
            save_slot(fb, f.save_as_reference as usize, true, sw, sh, false, sw, sh)?
        }
        return ok()
    }
    if !fb.use_canvas {
        if spots && !linear_spots {
            for i in 0usize..plane {
                spot_pixel(h, ex, fb.frame, plane, i)
            }
        }
        return ok()
    }
    if f.needs_blending(h.num_extra) {
        // libjxl refuses backgrounds saved before the color transform.
        if fb.slot_valid[f.blend_source as usize] && fb.slot_before[f.blend_source as usize] {
            return err(pixels.Error.Malformed)
        }
        for e in 0usize..h.num_extra as usize {
            s := ex.get(e, EX_SOURCE) as usize
            if fb.slot_valid[s] && fb.slot_before[s] {
                return err(pixels.Error.Malformed)
            }
        }
    }
    compose(h, f, fb, ex)?
    if f.can_reference() && !f.save_before_ct {
        save_slot(fb, f.save_as_reference as usize, false, h.width as usize, h.height as usize, false, h.width as usize, h.height as usize)?
    }
    if spots && !linear_spots {
        canvas_plane := h.width as usize * h.height as usize
        for i in 0usize..canvas_plane {
            spot_pixel(h, ex, fb.canvas, canvas_plane, i)
        }
    }
    return ok()
}

// Render the spot color channels into pixel i of the color planes of `p`
// (planes of `plane` samples), in channel order like libjxl's spot stages.
fn spot_pixel(h: &ImageHeader, ex: &Extras, p: &mut[f32], plane: usize, i: usize) {
    for e in 0usize..h.num_extra as usize {
        if ex.get(e, EX_KIND) != EC_SPOT {
            continue
        }
        mix := ex.spot(e, 3) * p[(3 + e) * plane + i]
        for c in 0usize..3 {
            p[c * plane + i] = mix * ex.spot(e, c) + (1.0 - mix) * p[c * plane + i]
        }
    }
}

// Emit the canvas in the native layout: the color channels (and alpha),
// or with `select` < NO_EXTRA that extra channel alone.
fn emit_canvas<S: sink.Sink>(output: &mut S, h: &ImageHeader, fb: &FloatBufs, layout: &pixels.Layout, tile: &mut[u8], ex: &Extras, select: usize) -> void!pixels.Error {
    channels := layout.channel_count()
    sample := layout.sample_code()
    size := layout.sample_bytes()
    bpp := layout.bytes_per_pixel()
    width := h.width as usize
    height := h.height as usize
    plane := width * height
    alpha := h.alpha_channel()
    src := [0usize, 1, 2, 3]
    if select != NO_EXTRA {
        src[0] = 3 + select
    } else if channels <= 2 {
        src[0] = 0
        src[1] = 3 + alpha
    } else if channels == 4 {
        src[3] = 3 + alpha
    }
    ty := 0usize
    for ty < height {
        th := height - ty
        if th > TILE {
            th = TILE
        }
        tx := 0usize
        for tx < width {
            tw := width - tx
            if tw > TILE {
                tw = TILE
            }
            row_bytes := tw * bpp
            for y in 0usize..th {
                for x in 0usize..tw {
                    for k in 0usize..channels {
                        v := 0.0f32
                        if fb.use_canvas {
                            v = fb.canvas[src[k] * plane + (ty + y) * width + tx + x]
                        } else {
                            v = fb.frame[src[k] * plane + (ty + y) * width + tx + x]
                        }
                        at := y * row_bytes + x * bpp + k * size
                        if sample == pixels.SAMPLE_F32 {
                            pixels.put32(tile, at, convert.f32_bits(v))
                        } else if sample == pixels.SAMPLE_U16 {
                            put_sample(tile, at, sample, nearest(clamp01(v) * 65535.0))
                        } else {
                            // Ordered dithering, as libjxl does for 8-bit output.
                            d := DITHER[((ty + y + k * 13) % 32) * 32 + (tx + x + k * 23) % 32]
                            q := v * 255.0 + d
                            if q < 0.0 {
                                q = 0.0
                            }
                            if q > 255.0 {
                                q = 255.0
                            }
                            put_sample(tile, at, sample, nearest(q))
                        }
                    }
                }
            }
            view := pixels.View.new(&tile[..row_bytes * th], tw as u32, th as u32, layout.clone())?
            output.rect(tx as u32, ty as u32, &view)?
            tx += tw
        }
        ty += th
    }
    return ok()
}

