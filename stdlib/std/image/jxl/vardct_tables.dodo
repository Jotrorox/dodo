package jxl

import "std/image/convert"
import "std/image/pixels"
import "std/math"
import "std/math/trig"

// VarDCT tables and transforms: the varblock types (DctSelect), coefficient
// orders, default dequantization weights, the separable floating-point DCT
// (recursive radix-2, any power-of-two size up to 256) and the special
// 8x8 transforms (DCT2, DCT4, Hornuss, DCT4x8/8x4, AFV).

const NUM_DCT_SELECT: u32 = 27
const NUM_PARAMS: usize = 17
const NUM_ORDERS: usize = 13
// Floats of temporary storage the transforms need.
const DCT_TEMP: usize = 2048
// Offsets in the temporary area: two 256-entry work rows, the half-secant
// tables, and LLF / small transform scratch.
const T_SEC: usize = 768
const T_LLF: usize = 1024

// Per DctSelect: width and height in 8x8 blocks, dequantization parameter
// set, coefficient order, and whether it is one of the special 8x8
// transforms (which are never transposed).
static DS_W8: [27]u32 = [1, 1, 1, 1, 2, 4, 1, 2, 1, 4, 2, 4, 1, 1, 1, 1, 1, 1, 8, 4, 8, 16, 8, 16, 32, 16, 32]
static DS_H8: [27]u32 = [1, 1, 1, 1, 2, 4, 2, 1, 4, 1, 4, 2, 1, 1, 1, 1, 1, 1, 8, 8, 4, 16, 16, 8, 32, 32, 16]
static DS_PARAM: [27]u32 = [0, 1, 2, 3, 4, 5, 6, 6, 7, 7, 8, 8, 9, 9, 10, 10, 10, 10, 11, 12, 12, 13, 14, 14, 15, 16, 16]
static DS_ORDER: [27]u32 = [0, 1, 1, 1, 2, 3, 4, 4, 5, 5, 6, 6, 1, 1, 1, 1, 1, 1, 7, 8, 8, 9, 10, 10, 11, 12, 12]
static DS_SPECIAL: [27]bool = [false, true, true, true, false, false, false, false, false, false, false, false, true, true, true, true, true, true, false, false, false, false, false, false, false, false, false]

// Dequantization matrix size (width >= height) per parameter set.
static PARAM_W: [17]u32 = [8, 8, 8, 8, 16, 32, 16, 32, 32, 8, 8, 64, 64, 128, 128, 256, 256]
static PARAM_H: [17]u32 = [8, 8, 8, 8, 16, 32, 8, 8, 16, 8, 8, 64, 32, 128, 64, 256, 128]
// Coefficient order size (width >= height).
static ORDER_W: [13]u32 = [8, 8, 16, 32, 16, 32, 32, 64, 64, 128, 128, 256, 256]
static ORDER_H: [13]u32 = [8, 8, 16, 32, 8, 8, 16, 64, 32, 128, 64, 256, 128]

// Varblocks taller than wide (and square DCTs) store coefficients
// transposed relative to their order and matrix.
fn ds_transposed(ds: u32) -> bool {
    return !DS_SPECIAL[ds as usize] && DS_H8[ds as usize] >= DS_W8[ds as usize]
}

fn order_offset(o: usize) -> usize {
    total := 0usize
    for i in 0usize..o {
        total += (ORDER_W[i] * ORDER_H[i]) as usize
    }
    return total
}

fn param_size(p: usize) -> usize {
    return (PARAM_W[p] * PARAM_H[p]) as usize
}

// Offset of parameter set p's three matrices in the dequantization store.
fn param_offset(p: usize) -> usize {
    total := 0usize
    for i in 0usize..p {
        total += 3 * param_size(i)
    }
    return total
}

const ORDER_TOTAL: usize = 131328
const PARAM_TOTAL: usize = 394752

// Natural coefficient orders of all 13 shapes, as y * width + x.
fn natural_orders(out: &mut[u32]) {
    for o in 0usize..NUM_ORDERS {
        bw := ORDER_W[o] as usize
        bh := ORDER_H[o] as usize
        base := order_offset(o)
        y_scale := bw / bh
        lbw := bw / 8
        lbh := bh / 8
        index := 0usize
        for i in 0usize..lbw * lbh {
            out[base + index] = ((i / lbw) * bw + i % lbw) as u32
            index += 1
        }
        for d in 1usize..2 * bw {
            margin := 0usize
            if d > bw {
                margin = d - bw
            }
            for order in margin..d - margin {
                x := d - 1 - order
                y := order
                if d % 2 == 1 {
                    x = order
                    y = d - 1 - order
                }
                if x < lbw && y < lbw {
                    continue
                }
                if y % y_scale != 0 {
                    continue
                }
                out[base + index] = ((y / y_scale) * bw + x) as u32
                index += 1
            }
        }
    }
}
