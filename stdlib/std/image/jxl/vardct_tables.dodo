// Half secants 1 / (2 cos((2k + 1) pi / (2n))) for n = 4 .. 256, at
// t[T_SEC + n / 2 - 2 + k].
fn init_dct_tables(t: &mut[f32]) {
    n := 4usize
    for n <= 256 {
        for k in 0usize..n / 2 {
            theta := (2 * k + 1) as f64 * 3.141592653589793 / (2 * n) as f64
            c := 1.0f64
            match trig.cos(theta) {
                ok(v) => {
                    c = v
                }
                err(_) => {}
            }
            t[T_SEC + n / 2 - 2 + k] = (0.5 / c) as f32
        }
        n *= 2
    }
}

fn sec(t: &[f32], n: usize, k: usize) -> f32 {
    return t[T_SEC + n / 2 - 2 + k]
}

const SQRT2: f32 = 1.4142135623730951

fn dct4_inplace(t: &mut[f32], d: usize, inverse: bool) {
    sec0 := 0.5411961f32
    sec1 := 1.306563f32
    i0 := t[d]
    i1 := t[d + 1]
    i2 := t[d + 2]
    i3 := t[d + 3]
    if !inverse {
        sum03 := i0 + i3
        sum12 := i1 + i2
        tmp0 := (i0 - i3) * sec0
        tmp1 := (i1 - i2) * sec1
        out0 := (tmp0 + tmp1) / 4.0
        out1 := (tmp0 - tmp1) / 4.0
        t[d] = (sum03 + sum12) / 4.0
        t[d + 1] = out0 * SQRT2 + out1
        t[d + 2] = (sum03 - sum12) / 4.0
        t[d + 3] = out1
        return
    }
    tmp0 := i1 * SQRT2
    tmp1 := i1 + i3
    out0 := (tmp0 + tmp1) * sec0
    out1 := (tmp0 - tmp1) * sec1
    sum02 := i0 + i2
    sub02 := i0 - i2
    t[d] = sum02 + out0
    t[d + 1] = sub02 + out1
    t[d + 2] = sub02 - out1
    t[d + 3] = sum02 - out0
}

// 1D DCT of t[d..d + n] (n a power of two) using t[s..s + n] as scratch.
// Inverse: x_k = X_0 + sqrt(2) sum X_u cos((2k + 1) u pi / 2n); forward is
// its exact inverse.
fn dct1d(t: &mut[f32], d: usize, s: usize, n: usize, inverse: bool) {
    if n <= 1 {
        return
    }
    if n == 2 {
        a := t[d] + t[d + 1]
        b := t[d] - t[d + 1]
        if inverse {
            t[d] = a
            t[d + 1] = b
        } else {
            t[d] = a / 2.0
            t[d + 1] = b / 2.0
        }
        return
    }
    if n == 4 {
        dct4_inplace(t, d, inverse)
        return
    }
    half := n / 2
    if inverse {
        for i in 0usize..half {
            t[s + i] = t[d + 2 * i]
            t[s + half + i] = t[d + 2 * i + 1]
        }
        k := half - 1
        for k > 0 {
            t[s + half + k] += t[s + half + k - 1]
            k -= 1
        }
        t[s + half] *= SQRT2
        dct1d(t, s, d, half, true)
        dct1d(t, s + half, d + half, half, true)
        for i in 0usize..half {
            r := t[s + half + i] * sec(t, n, i)
            a := t[s + i]
            t[d + i] = a + r
            t[d + n - 1 - i] = a - r
        }
        return
    }
    for i in 0usize..half {
        a := t[d + i]
        b := t[d + n - 1 - i]
        t[s + i] = (a + b) / 2.0
        t[s + half + i] = (a - b) / 2.0 * sec(t, n, i)
    }
    dct1d(t, s, d, half, false)
    dct1d(t, s + half, d + half, half, false)
    t[s + half] *= SQRT2
    for i in 0usize..half - 1 {
        t[s + half + i] += t[s + half + i + 1]
    }
    for i in 0usize..half {
        t[d + 2 * i] = t[s + i]
        t[d + 2 * i + 1] = t[s + half + i]
    }
}

// Separable 2D DCT of a w x h block of `p` (row stride `stride`).
fn dct2d(p: &mut[f32], off: usize, stride: usize, w: usize, h: usize, inverse: bool, t: &mut[f32]) {
    if w > 1 {
        for y in 0usize..h {
            row := off + y * stride
            for x in 0usize..w {
                t[x] = p[row + x]
            }
            dct1d(t, 0, 256, w, inverse)
            for x in 0usize..w {
                p[row + x] = t[x]
            }
        }
    }
    if h > 1 {
        for x in 0usize..w {
            for y in 0usize..h {
                t[y] = p[off + y * stride + x]
            }
            dct1d(t, 0, 256, h, inverse)
            for y in 0usize..h {
                p[off + y * stride + x] = t[y]
            }
        }
    }
}

// dct2d on a block inside the temporary area itself (offset >= 512).
fn dct2d_in(t: &mut[f32], off: usize, stride: usize, w: usize, h: usize, inverse: bool) {
    for y in 0usize..h {
        row := off + y * stride
        for x in 0usize..w {
            t[x] = t[row + x]
        }
        dct1d(t, 0, 256, w, inverse)
        for x in 0usize..w {
            t[row + x] = t[x]
        }
    }
    for x in 0usize..w {
        for y in 0usize..h {
            t[y] = t[off + y * stride + x]
        }
        dct1d(t, 0, 256, h, inverse)
        for y in 0usize..h {
            t[off + y * stride + x] = t[y]
        }
    }
}

// The four 2x2 butterflies of an aux IDCT stage of size `size`.
fn aux_idct2(p: &mut[f32], off: usize, stride: usize, size: usize, t: &mut[f32]) {
    half := size / 2
    for y in 0usize..half {
        for x in 0usize..half {
            c00 := p[off + y * stride + x]
            c01 := p[off + y * stride + x + half]
            c10 := p[off + (y + half) * stride + x]
            c11 := p[off + (y + half) * stride + x + half]
            t[T_LLF + (2 * y) * size + 2 * x] = c00 + c01 + c10 + c11
            t[T_LLF + (2 * y) * size + 2 * x + 1] = c00 + c01 - c10 - c11
            t[T_LLF + (2 * y + 1) * size + 2 * x] = c00 - c01 + c10 - c11
            t[T_LLF + (2 * y + 1) * size + 2 * x + 1] = c00 - c01 - c10 + c11
        }
    }
    for y in 0usize..size {
        for x in 0usize..size {
            p[off + y * stride + x] = t[T_LLF + y * size + x]
        }
    }
}

// The pixels of an 8x8 varblock of a special type from its dequantized
// coefficients, in place (jxl-oxide's transform functions).
fn special_transform(ds: u32, p: &mut[f32], off: usize, stride: usize, t: &mut[f32]) {
    // Scratch for 4x4 / 4x8 sub-transforms after the 64-entry staging.
    s := T_LLF + 64
    if ds == 2 {
        aux_idct2(p, off, stride, 2, t)
        aux_idct2(p, off, stride, 4, t)
        aux_idct2(p, off, stride, 8, t)
        return
    }
    if ds == 3 || ds == 1 {
        aux_idct2(p, off, stride, 2, t)
        for y in 0usize..2 {
            for x in 0usize..2 {
                b := s + (y * 2 + x) * 16
                for iy in 0usize..4 {
                    for ix in 0usize..4 {
                        if ds == 3 {
                            // Stored transposed, as jxl-oxide does.
                            t[b + ix * 4 + iy] = p[off + (y + iy * 2) * stride + x + ix * 2]
                        } else {
                            t[b + iy * 4 + ix] = p[off + (y + iy * 2) * stride + x + ix * 2]
                        }
                    }
                }
                if ds == 3 {
                    dct2d_in(t, b, 4, 4, 4, true)
                } else {
                    sum := 0.0f32
                    for i in 1usize..16 {
                        sum += t[b + i]
                    }
                    avg := t[b] - sum / 16.0
                    t[b] = t[b + 5]
                    t[b + 5] = 0.0
                    for i in 0usize..16 {
                        t[b + i] += avg
                    }
                }
            }
        }
        for y in 0usize..2 {
            for x in 0usize..2 {
                b := s + (y * 2 + x) * 16
                for iy in 0usize..4 {
                    for ix in 0usize..4 {
                        p[off + (y * 4 + iy) * stride + x * 4 + ix] = t[b + iy * 4 + ix]
                    }
                }
            }
        }
        return
    }
    if ds == 12 || ds == 13 {
        c0 := p[off]
        c1 := p[off + stride]
        p[off] = c0 + c1
        p[off + stride] = c0 - c1
        for idx in 0usize..2 {
            b := s + idx * 32
            for iy in 0usize..4 {
                for ix in 0usize..8 {
                    t[b + iy * 8 + ix] = p[off + (iy * 2 + idx) * stride + ix]
                }
            }
            dct2d_in(t, b, 8, 8, 4, true)
        }
        for y in 0usize..8 {
            for x in 0usize..8 {
                if ds == 13 {
                    p[off + x * stride + y] = t[s + y * 8 + x]
                } else {
                    p[off + y * stride + x] = t[s + y * 8 + x]
                }
            }
        }
        return
    }
    // AFV0..3.
    n := ds - 14
    flip_x := (n % 2) as usize
    flip_y := (n / 2) as usize
    afv := s
    samples := s + 16
    s44 := s + 32
    s48 := s + 48
    t[afv] = (p[off] + p[off + 1] + p[off + stride]) * 4.0
    for i in 1usize..16 {
        t[afv + i] = p[off + (2 * (i / 4)) * stride + 2 * (i % 4)]
    }
    for i in 0usize..16 {
        t[samples + i] = 0.0
    }
    for k in 0usize..16 {
        c := t[afv + k]
        for i in 0usize..16 {
            t[samples + i] += c * AFV_BASIS[k * 16 + i]
        }
    }
    t[s44] = p[off] - p[off + 1] + p[off + stride]
    for iy in 0usize..4 {
        for ix in 0usize..4 {
            if ix == 0 && iy == 0 {
                continue
            }
            t[s44 + ix * 4 + iy] = p[off + (2 * iy) * stride + 2 * ix + 1]
        }
    }
    dct2d_in(t, s44, 4, 4, 4, true)
    t[s48] = p[off] - p[off + stride]
    for iy in 0usize..4 {
        for ix in 0usize..8 {
            if ix == 0 && iy == 0 {
                continue
            }
            t[s48 + iy * 8 + ix] = p[off + (2 * iy + 1) * stride + ix]
        }
    }
    dct2d_in(t, s48, 8, 8, 4, true)
    for iy in 0usize..4 {
        ay := iy
        if flip_y == 1 {
            ay = 3 - iy
        }
        for ix in 0usize..4 {
            ax := ix
            if flip_x == 1 {
                ax = 3 - ix
            }
            p[off + (flip_y * 4 + iy) * stride + flip_x * 4 + ix] = t[samples + ay * 4 + ax]
        }
    }
    for iy in 0usize..4 {
        for ix in 0usize..4 {
            p[off + (flip_y * 4 + iy) * stride + (1 - flip_x) * 4 + ix] = t[s44 + iy * 4 + ix]
        }
    }
    for iy in 0usize..4 {
        for ix in 0usize..8 {
            p[off + ((1 - flip_y) * 4 + iy) * stride + ix] = t[s48 + iy * 8 + ix]
        }
    }
}

// libjxl's FastLog2f / FastPow2f / FastPowf (fast_math-inl.h): the
// dequantization weights use them, so they are reproduced exactly.
fn fast_log2f(x: f32) -> f32 {
    bits := convert.f32_bits(x) as i64
    exp_bits := bits - 0x3f2aaaab
    exp_shifted := 0i64
    if exp_bits >= 0 {
        exp_shifted = exp_bits >> 23
    } else {
        exp_shifted = -((-exp_bits + 8388607) >> 23)
    }
    mantissa := convert.f32_from_bits(((bits - exp_shifted * 8388608) & 0xffffffff) as u32) - 1.0
    yp := (0.74245873327820566f32 * mantissa + 1.4287160470083755) * mantissa + -0.0000018503833400518310
    yq := (0.17409343003366853f32 * mantissa + 1.0096718572241148) * mantissa + 0.99032814277590719
    return yp / yq + exp_shifted as f32
}

fn fast_pow2f(x: f32) -> f32 {
    if !(x == x) || x < -126.0 {
        return 0.0
    }
    if x > 127.0 {
        return convert.f32_from_bits(0x7f800000)
    }
    floorx := math.floor(x as f64) as f32
    e := floorx as i64 + 127
    if e < 1 {
        return 0.0
    }
    if e > 254 {
        e = 254
    }
    scale := convert.f32_from_bits((e as u32) << 23)
    frac := x - floorx
    num := frac + 10.1749063
    num = num * frac + 48.8687798
    num = num * frac + 98.5506591
    num = num * scale
    den := frac * 0.210242958 + -0.0222328856
    den = den * frac + -19.4414990
    den = den * frac + 98.5506633
    return num / den
}

fn fast_powf(b: f32, e: f32) -> f32 {
    return fast_pow2f(fast_log2f(b) * e)
}

fn band_mult(v: f32) -> f32 {
    if v > 0.0 {
        return 1.0 + v
    }
    return 1.0 / (1.0 - v)
}

// Bands from parameters prm[base..base + n], into bands[..n]; fails when
// a band is too small.
fn make_bands(prm: &[f32], base: usize, n: usize, bands: &mut[f32]) -> void!pixels.Error {
    if n == 0 || n > 16 {
        return err(pixels.Error.Malformed)
    }
    bands[0] = prm[base]
    if !(bands[0] >= 0.00000001) {
        return err(pixels.Error.Malformed)
    }
    for i in 1usize..n {
        bands[i] = bands[i - 1] * band_mult(prm[base + i])
        if !(bands[i] >= 0.00000001) {
            return err(pixels.Error.Malformed)
        }
    }
    return ok()
}

// Interpolate(): position `scaled` in band units.
fn interpolate(scaled: f32, bands: &[f32], n: usize) -> f32 {
    if n == 1 {
        return bands[0]
    }
    index := scaled as usize
    if index > n - 2 {
        index = n - 2
    }
    a := bands[index]
    b := bands[index + 1]
    return a * fast_powf(b / a, scaled - index as f32)
}

fn sqrt32(v: f32) -> f32 {
    match math.sqrt(v as f64) {
        ok(s) => {
            return s as f32
        }
        err(_) => {
            return 0.0
        }
    }
}

// DCT quantization weights (GetQuantWeights) of a width x height matrix
// from n bands.
fn dct_weights(prm: &[f32], base: usize, n: usize, width: usize, height: usize, out: &mut[f32], at: usize) -> void!pixels.Error {
    bands := [0.0f32; 16]
    make_bands(prm, base, n, &mut bands)?
    scale := (n - 1) as f32 / (1.41421356237f32 + 0.000001)
    rcpcol := scale / (width - 1) as f32
    rcprow := scale / (height - 1) as f32
    for y in 0usize..height {
        dy := y as f32 * rcprow
        dy2 := dy * dy
        for x in 0usize..width {
            dx := x as f32 * rcpcol
            out[at + y * width + x] = interpolate(sqrt32(dx * dx + dy2), &bands, n)
        }
    }
    return ok()
}

// The dequantization multipliers (reciprocal weights) of parameter set p
// for channel c, from `prm` (channel stride 48) in `mode`, into out[at..].
fn compute_matrix(p: usize, mode: u32, n: usize, m: usize, prm: &[f32], c: usize, out: &mut[f32], at: usize, t: &mut[f32]) -> void!pixels.Error {
    width := PARAM_W[p] as usize
    height := PARAM_H[p] as usize
    base := c * 48
    if mode == 6 {
        dct_weights(prm, base, n, width, height, out, at)?
    } else if mode == 1 {
        for i in 0usize..64 {
            out[at + i] = prm[base]
        }
        out[at] = 1.0
        out[at + 1] = prm[base + 1]
        out[at + 8] = prm[base + 1]
        out[at + 9] = prm[base + 2]
    } else if mode == 2 {
        out[at] = 1.0
        for idx in 0usize..6 {
            shift := idx / 2
            dim := 1usize << shift
            v := prm[base + idx]
            if idx % 2 == 0 {
                for y in 0usize..dim {
                    for x in dim..dim * 2 {
                        out[at + y * 8 + x] = v
                        out[at + x * 8 + y] = v
                    }
                }
            } else {
                for y in dim..dim * 2 {
                    for x in dim..dim * 2 {
                        out[at + y * 8 + x] = v
                    }
                }
            }
        }
    } else if mode == 3 {
        dct_weights(prm, base + 2, n, 4, 4, t, T_LLF)?
        for y in 0usize..4 {
            for x in 0usize..4 {
                v := t[T_LLF + y * 4 + x]
                out[at + y * 16 + x * 2] = v
                out[at + y * 16 + x * 2 + 1] = v
                out[at + (y * 2 + 1) * 8 + x * 2] = v
                out[at + (y * 2 + 1) * 8 + x * 2 + 1] = v
            }
        }
        out[at + 1] /= prm[base]
        out[at + 8] /= prm[base]
        out[at + 9] /= prm[base + 1]
    } else if mode == 4 {
        dct_weights(prm, base + 1, n, 8, 4, t, T_LLF)?
        for y in 0usize..8 {
            for x in 0usize..8 {
                out[at + y * 8 + x] = t[T_LLF + (y / 2) * 8 + x]
            }
        }
        out[at + 8] /= prm[base]
    } else if mode == 5 {
        dct_weights(prm, base + 9, n, 8, 4, t, T_LLF)?
        dct_weights(prm, base + 9 + n, m, 4, 4, t, T_LLF + 32)?
        bands := [0.0f32; 4]
        bands[0] = prm[base + 5]
        if !(bands[0] >= 0.00000001) {
            return err(pixels.Error.Malformed)
        }
        for i in 1usize..4 {
            bands[i] = bands[i - 1] * band_mult(prm[base + 5 + i])
            if !(bands[i] >= 0.00000001) {
                return err(pixels.Error.Malformed)
            }
        }
        lo := 0.8517778890324296f32
        hi := 12.97166202570235f32 - lo + 0.000001
        for y in 0usize..4 {
            for x in 0usize..4 {
                v := 0.0f32
                if x == 0 && y == 0 {
                    v = 1.0
                } else if x == 0 && y == 1 {
                    v = prm[base + 2]
                } else if x == 1 && y == 0 {
                    v = prm[base + 3]
                } else if x == 1 && y == 1 {
                    v = prm[base + 4]
                } else {
                    v = interpolate((AFV_FREQS[y * 4 + x] - lo) * 3.0 / hi, &bands, 4)
                }
                out[at + 16 * y + 2 * x] = v
            }
        }
        for y in 0usize..4 {
            for x in 0usize..8 {
                v := t[T_LLF + y * 8 + x]
                if y == 0 && x == 0 {
                    v = prm[base]
                }
                out[at + y * 16 + 8 + x] = v
            }
            for x in 0usize..4 {
                v := t[T_LLF + 32 + y * 4 + x]
                if y == 0 && x == 0 {
                    v = prm[base + 1]
                }
                out[at + y * 16 + 2 * x + 1] = v
            }
        }
    }
    size := width * height
    for i in 0usize..size {
        w := out[at + i]
        if !(w >= 0.00000001) || w >= 100000000.0 {
            return err(pixels.Error.Malformed)
        }
        out[at + i] = 1.0f32 / w
    }
    return ok()
}

static AFV_FREQS: [16]f32 = [0.0, 0.0, 0.8517778890324296, 5.37778436506804, 0.0, 0.0, 4.734747904497923, 5.449245381693219, 1.6598270267479331, 4.0, 7.275749096817861, 10.423227632456525, 2.662932286148962, 7.630657783650829, 8.962388608184032, 12.97166202570235]

