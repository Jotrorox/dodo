package jxl

import "core/slice"
import "std/image/pixels"
import "std/image/shared/scratch"

// The embedded ICC profile (18181-1 annex B): an entropy-coded byte stream
// with 41 contexts chosen from the two previous bytes, which then encodes
// the profile as a predicted header, a tag list with common tag shortcuts,
// and data commands (raw bytes, shuffled 2- and 4-byte runs, numeric
// prediction of order 0 to 2, XYZ and common type shortcuts).

const ICC_CONTEXTS: u32 = 41
const ICC_MAX_SIZE: u64 = 268435456
// Working storage for the entropy decoder of an ICC stream: its Code, two
// nested Codes and an LZ77 window of 32768 entries.
const ICC_CODE_POOL: usize = 21504
const NESTED_POOL: usize = 4096
const ICC_WINDOW: usize = 32768

fn icc_work_bytes() -> usize {
    return code_bytes(ICC_CONTEXTS as usize + 1, ICC_CODE_POOL) + 2 * code_bytes(2, NESTED_POOL) + ICC_WINDOW * 4 + 16
}

// A Code carved from exactly code_bytes(num_dist, pool) bytes.
fn carve_code(bytes: &mut[u8], num_dist: usize) -> Code!pixels.Error from(bytes) {
    let slice.SplitMut { left: map, right: rest } = scratch.split(bytes, num_dist + 10)?
    let slice.SplitMut { left: info, right: tail } = scratch.split(rest, MAX_CLUSTERS * INFO_STRIDE * 4 + 8)?
    return ok(Code.new(map, scratch.u32s(info), scratch.u32s(tail)))
}

fn icc_context(index: u64, b1: u32, b2: u32) -> u32 {
    if index <= 128 {
        return 0
    }
    p1 := 7u32
    if is_letter(b1) {
        p1 = 0
    } else if is_number(b1) {
        p1 = 1
    } else if b1 <= 1 {
        p1 = 2 + b1
    } else if b1 <= 15 {
        p1 = 4
    } else if b1 >= 241 && b1 <= 254 {
        p1 = 5
    } else if b1 == 255 {
        p1 = 6
    }
    p2 := 4u32
    if is_letter(b2) {
        p2 = 0
    } else if is_number(b2) {
        p2 = 1
    } else if b2 <= 15 {
        p2 = 2
    } else if b2 >= 241 {
        p2 = 3
    }
    return 1 + p1 + 8 * p2
}

fn is_letter(b: u32) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
}

fn is_number(b: u32) -> bool {
    return (b >= 48 && b <= 57) || b == 46 || b == 44
}

// Decode the entropy-coded ICC stream at the reader. With `store`, the
// encoded bytes go to `encoded`; otherwise they are only skipped. Returns
// the encoded length.
fn read_icc_stream(r: &mut Reader, work: &mut[u8], encoded: &mut[u8], store: bool) -> u64!pixels.Error {
    enc_size := r.u64c()
    if enc_size > ICC_MAX_SIZE {
        return err(pixels.Error.TooLarge)
    }
    if store && enc_size > encoded.len as u64 {
        return err(pixels.Error.BufferTooSmall)
    }
    let slice.SplitMut { left: code_bytes_0, right: rest } = scratch.split(work, code_bytes(ICC_CONTEXTS as usize + 1, ICC_CODE_POOL))?
    let slice.SplitMut { left: n1_bytes, right: rest2 } = scratch.split(rest, code_bytes(2, NESTED_POOL))?
    let slice.SplitMut { left: n2_bytes, right: window_bytes } = scratch.split(rest2, code_bytes(2, NESTED_POOL))?
    code := carve_code(code_bytes_0, ICC_CONTEXTS as usize + 1)?
    n1 := carve_code(n1_bytes, 2)?
    n2 := carve_code(n2_bytes, 2)?
    window := scratch.u32s(window_bytes)
    read_code(r, ICC_CONTEXTS, &mut code, &mut n1, &mut n2, window)?
    stream := Stream.new(window)
    stream.begin(&code, r)
    head := [0u8; 18]
    b1 := 0u32
    b2 := 0u32
    for i in 0u64..enc_size {
        value := code.read(&mut stream, r, icc_context(i, b1, b2), 0)
        if value >= 256 {
            return err(pixels.Error.Malformed)
        }
        if i < 18 {
            head[i as usize] = value as u8
            if i == 17 || i + 1 == enc_size {
                // output_size bounds a sane enc_size.
                cursor := 0usize
                output_size := varint(&head[..(i + 1) as usize], &mut cursor)?
                if output_size > ICC_MAX_SIZE || output_size + 65536 < enc_size {
                    return err(pixels.Error.Malformed)
                }
            }
        }
        if store {
            encoded[i as usize] = value as u8
        }
        b2 = b1
        b1 = value
        if (i & 1023) == 1023 {
            if r.overrun {
                return err(pixels.Error.Truncated)
            }
            if r.broken {
                return err(pixels.Error.Malformed)
            }
        }
    }
    if r.overrun {
        return err(pixels.Error.Truncated)
    }
    if r.broken {
        return err(pixels.Error.Malformed)
    }
    stream.finish(&code)?
    return ok(enc_size)
}

fn skip_icc(r: &mut Reader, work: &mut[u8]) -> u64!pixels.Error {
    empty := [0u8; 1]
    return read_icc_stream(r, work, &mut empty, false)
}

// A LEB128 varint of at most 63 bits at stream[*cursor].
fn varint(stream: &[u8], cursor: &mut usize) -> u64!pixels.Error {
    value := 0u64
    shift := 0u64
    for shift < 63 {
        if *cursor >= stream.len {
            return err(pixels.Error.Malformed)
        }
        b := stream[*cursor]
        *cursor += 1
        value = value | (((b & 127) as u64) << shift)
        if (b & 128) == 0 {
            return ok(value)
        }
        shift += 7
    }
    return ok(value)
}

static COMMON_TAGS: [76]u8 = [
    b'r', b'T', b'R', b'C', b'r', b'X', b'Y', b'Z', b'c', b'p', b'r', b't', b'w', b't', b'p', b't',
    b'b', b'k', b'p', b't', b'r', b'X', b'Y', b'Z', b'g', b'X', b'Y', b'Z', b'b', b'X', b'Y', b'Z',
    b'k', b'X', b'Y', b'Z', b'r', b'T', b'R', b'C', b'g', b'T', b'R', b'C', b'b', b'T', b'R', b'C',
    b'k', b'T', b'R', b'C', b'c', b'h', b'a', b'd', b'd', b'e', b's', b'c', b'c', b'h', b'r', b'm',
    b'd', b'm', b'n', b'd', b'd', b'm', b'd', b'd', b'l', b'u', b'm', b'i'
]

static COMMON_DATA: [32]u8 = [
    b'X', b'Y', b'Z', b' ', b'd', b'e', b's', b'c', b't', b'e', b'x', b't', b'm', b'l', b'u', b'c',
    b'p', b'a', b'r', b'a', b'c', b'u', b'r', b'v', b's', b'f', b'3', b'2', b'g', b'b', b'd', b' '
]

// Output of the ICC decoder with bounds checks.
struct IccOut {
    out: &mut[u8]
    count: usize

    fn push(&mut self, b: u8) -> void!pixels.Error {
        if self.count >= self.out.len {
            return err(pixels.Error.BufferTooSmall)
        }
        self.out[self.count] = b
        self.count += 1
        return ok()
    }
    fn push32(&mut self, v: u32) -> void!pixels.Error {
        self.push((v >> 24) as u8)?
        self.push(((v >> 16) & 255) as u8)?
        self.push(((v >> 8) & 255) as u8)?
        self.push((v & 255) as u8)?
        return ok()
    }
    fn push_tag(&mut self, table: &[u8], index: usize) -> void!pixels.Error {
        for k in 0usize..4 {
            self.push(table[index * 4 + k])?
        }
        return ok()
    }
}

fn predict_header(index: usize, output_size: u64, header: &[u8]) -> u8 {
    if index < 4 {
        return ((output_size >> ((3 - index) * 8) as u64) & 255) as u8
    }
    if index == 8 {
        return 4
    }
    if index >= 12 && index < 24 {
        text := [b'm', b'n', b't', b'r', b'R', b'G', b'B', b' ', b'X', b'Y', b'Z', b' ']
        return text[index - 12]
    }
    if index >= 36 && index < 40 {
        text := [b'a', b'c', b's', b'p']
        return text[index - 36]
    }
    if index >= 41 && index < 44 {
        if header[40] == b'A' {
            if index == 43 {
                return b'L'
            }
            return b'P'
        }
        if header[40] == b'M' {
            if index == 41 {
                return b'S'
            }
            if index == 42 {
                return b'F'
            }
            return b'T'
        }
        if header[40] == b'S' && index >= 42 {
            if header[41] == b'G' {
                if index == 42 {
                    return b'I'
                }
                return b' '
            }
            if header[41] == b'U' {
                if index == 42 {
                    return b'N'
                }
                return b'W'
            }
        }
        return 0
    }
    if index == 70 {
        return 246
    }
    if index == 71 {
        return 214
    }
    if index == 73 {
        return 1
    }
    if index == 78 {
        return 211
    }
    if index == 79 {
        return 45
    }
    if index >= 80 && index < 84 {
        return header[4 + index - 80]
    }
    return 0
}

// The byte at position i of a 2- or 4-way shuffled run (libjxl Shuffle,
// the inverse of the encoder's Unshuffle): the encoder read the run in
// order into the columns of a matrix with ceil(len / width) rows, so byte i
// sits in column s at row t, where the first len % rows columns hold one
// byte more than the others.
fn shuffled(bytes: &[u8], width: usize, i: usize) -> u8 {
    len := bytes.len
    rows := (len + width - 1) / width
    q := len / rows
    r := len % rows
    s := 0usize
    t := 0usize
    if i < r * (q + 1) {
        s = i / (q + 1)
        t = i % (q + 1)
    } else {
        s = r + (i - r * (q + 1)) / q
        t = (i - r * (q + 1)) % q
    }
    return bytes[s + t * rows]
}

// Turn the decoded ICC stream into the profile bytes; returns the length.
fn decode_icc(stream: &[u8], output: &mut[u8]) -> usize!pixels.Error {
    cursor := 0usize
    output_size := varint(stream, &mut cursor)?
    commands_size := varint(stream, &mut cursor)?
    if commands_size > (stream.len - cursor) as u64 {
        return err(pixels.Error.Malformed)
    }
    if output_size > ICC_MAX_SIZE {
        return err(pixels.Error.TooLarge)
    }
    if output_size > output.len as u64 {
        return err(pixels.Error.BufferTooSmall)
    }
    commands_end := cursor + commands_size as usize
    cmd := cursor
    data := commands_end
    header_size := output_size as usize
    if header_size > 128 {
        header_size = 128
    }
    if stream.len - data < header_size {
        return err(pixels.Error.Malformed)
    }
    out := IccOut { out: output, count: 0 }
    header_data := &stream[data..data + header_size]
    for i in 0usize..header_size {
        p := predict_header(i, output_size, header_data)
        out.push(core.wrapping_add(p, header_data[i]))?
    }
    data += header_size
    if output_size <= 128 {
        return ok(out.count)
    }
    // Tag list.
    commands := &stream[..commands_end]
    tags_value := varint(commands, &mut cmd)?
    if tags_value > 0 {
        num_tags := tags_value - 1
        if num_tags > 0xffffffff {
            return err(pixels.Error.Malformed)
        }
        out.push32(num_tags as u32)?
        previous_start := num_tags * 12 + 128
        previous_size := 0u64
        for {
            if cmd >= commands_end {
                // The commands end inside the tag list: the size check below
                // decides.
                break
            }
            command := commands[cmd]
            cmd += 1
            tagcode := command & 63
            if tagcode == 0 {
                break
            }
            tag := [0u8; 4]
            if tagcode == 1 {
                if stream.len - data < 4 {
                    return err(pixels.Error.Malformed)
                }
                for k in 0usize..4 {
                    tag[k] = stream[data + k]
                }
                data += 4
            } else if tagcode <= 20 {
                for k in 0usize..4 {
                    tag[k] = COMMON_TAGS[(tagcode as usize - 2) * 4 + k]
                }
            } else {
                return err(pixels.Error.Malformed)
            }
            start := previous_start + previous_size
            if (command & 64) != 0 {
                start = varint(commands, &mut cmd)?
            }
            size := previous_size
            is_xyz := (tag[1] == b'X' && tag[2] == b'Y' && tag[3] == b'Z' && (tag[0] == b'r' || tag[0] == b'g' || tag[0] == b'b' || tag[0] == b'k')) || (tag[0] == b'w' && tag[1] == b't' && tag[2] == b'p' && tag[3] == b't') || (tag[0] == b'b' && tag[1] == b'k' && tag[2] == b'p' && tag[3] == b't') || (tag[0] == b'l' && tag[1] == b'u' && tag[2] == b'm' && tag[3] == b'i')
            if (command & 128) != 0 {
                size = varint(commands, &mut cmd)?
            } else if is_xyz {
                size = 20
            }
            // Tag offsets and sizes need only be 32-bit numbers (libjxl
            // round-trips profiles whose tags point past their end).
            if start > 0xffffffff || size > 0xffffffff {
                return err(pixels.Error.Malformed)
            }
            previous_start = start
            previous_size = size
            for k in 0usize..4 {
                out.push(tag[k])?
            }
            out.push32(start as u32)?
            out.push32(size as u32)?
            if tagcode == 2 {
                out.push_tag(&COMMON_TAGS, 10)?
                out.push32(start as u32)?
                out.push32(size as u32)?
                out.push_tag(&COMMON_TAGS, 11)?
                out.push32(start as u32)?
                out.push32(size as u32)?
            } else if tagcode == 3 {
                if start + size * 2 > 0xffffffff {
                    return err(pixels.Error.Malformed)
                }
                out.push_tag(&COMMON_TAGS, 6)?
                out.push32((start + size) as u32)?
                out.push32(size as u32)?
                out.push_tag(&COMMON_TAGS, 7)?
                out.push32((start + size * 2) as u32)?
                out.push32(size as u32)?
            }
        }
    }
    // Main content.
    for cmd < commands_end {
        command := commands[cmd]
        cmd += 1
        if command == 1 || command == 2 || command == 3 {
            num := varint(commands, &mut cmd)?
            if num > (stream.len - data) as u64 {
                return err(pixels.Error.Malformed)
            }
            run := &stream[data..data + num as usize]
            data += num as usize
            for i in 0usize..run.len {
                if command == 1 {
                    out.push(run[i])?
                } else if command == 2 {
                    out.push(shuffled(run, 2, i))?
                } else {
                    out.push(shuffled(run, 4, i))?
                }
            }
        } else if command == 4 {
            if cmd >= commands_end {
                return err(pixels.Error.Malformed)
            }
            flags := commands[cmd]
            cmd += 1
            width := ((flags & 3) + 1) as usize
            order := ((flags >> 2) & 3) as usize
            if width == 3 || order == 3 {
                return err(pixels.Error.Malformed)
            }
            stride := width as u64
            if (flags & 16) != 0 {
                stride = varint(commands, &mut cmd)?
                if stride < width as u64 {
                    return err(pixels.Error.Malformed)
                }
            }
            if stride * 4 >= out.count as u64 {
                return err(pixels.Error.Malformed)
            }
            num := varint(commands, &mut cmd)?
            if num > (stream.len - data) as u64 {
                return err(pixels.Error.Malformed)
            }
            run := &stream[data..data + num as usize]
            data += num as usize
            i := 0usize
            count := num as usize
            for i < count {
                prev := [0u32; 3]
                for j in 0usize..order + 1 {
                    at := out.count - stride as usize * (j + 1)
                    v := 0u32
                    for k in 0usize..width {
                        v = (v << 8) | out.out[at + k] as u32
                    }
                    prev[j] = v
                }
                p := prev[0]
                if order == 1 {
                    p = core.wrapping_sub(core.wrapping_mul(2u32, prev[0]), prev[1])
                } else if order == 2 {
                    p = core.wrapping_add(core.wrapping_mul(3u32, core.wrapping_sub(prev[0], prev[1])), prev[2])
                }
                j := 0usize
                for j < width && i + j < count {
                    b := run[i + j]
                    if width == 2 {
                        b = shuffled(run, 2, i + j)
                    } else if width == 4 {
                        b = shuffled(run, 4, i + j)
                    }
                    shift := (8 * (width - 1 - j)) as u32
                    out.push((core.wrapping_add(b as u32, p >> shift) & 255) as u8)?
                    j += 1
                }
                i += width
            }
        } else if command == 10 {
            if stream.len - data < 12 {
                return err(pixels.Error.Malformed)
            }
            out.push_tag(&COMMON_DATA, 0)?
            out.push32(0)?
            for k in 0usize..12 {
                out.push(stream[data + k])?
            }
            data += 12
        } else if command >= 16 && command <= 23 {
            out.push_tag(&COMMON_DATA, (command - 16) as usize)?
            out.push32(0)?
        } else {
            return err(pixels.Error.Malformed)
        }
    }
    if out.count as u64 != output_size {
        return err(pixels.Error.Malformed)
    }
    return ok(out.count)
}
