package jxl

import "std/image/pixels"

// Walking the frames of a file from their headers and TOCs only, to count
// them and to size every buffer decode() needs before any pixel work.

const MAX_FRAMES: u32 = 1048576

struct Scan {
    frames: u32
    displayed: u32
    // Largest per-frame needs.
    max_samples: u64
    max_frame_pixels: u64
    max_sample_width: u32
    max_sample_height: u32
    max_frame_width: u32
    max_frame_height: u32
    max_toc: u32
    max_group_dim: u32
    max_tree_global: u64
    // Reference slots written (bit per slot) and their largest size.
    slots: u32
    slot_pixels: [4]u64
    // Whether the float pipeline is needed for some frame.
    float_path: bool
    any_vardct: bool
    // Frames blend, crop, chain or animate: decode needs a canvas.
    needs_canvas: bool
    progressive: bool
    max_channels: u32
    // VarDCT frames: largest coefficient planes (floats), 8x8 blocks,
    // 64x64 tiles and groups; LF frame outputs per lf_level (floats).
    vd_planes: u64
    vd_blocks: u64
    vd_tiles: u64
    vd_groups: u64
    lf_slot: [3]u64
    any_noise: bool
    any_splines: bool
    // Gray modular frames with restoration filters: samples of their color
    // channel (two more copies are needed).
    gray_filtered: u64
}

fn new_scan() -> Scan {
    return Scan { frames: 0, displayed: 0, max_samples: 0, max_frame_pixels: 0, max_sample_width: 0, max_sample_height: 0, max_frame_width: 0, max_frame_height: 0, max_toc: 1, max_group_dim: 128, max_tree_global: 0, slots: 0, slot_pixels: [0u64; 4], float_path: false, any_vardct: false, needs_canvas: false, progressive: false, max_channels: 1, vd_planes: 0, vd_blocks: 0, vd_tiles: 0, vd_groups: 0, lf_slot: [0u64; 3], any_noise: false, any_splines: false, gray_filtered: 0 }
}

// Samples of one frame's modular channels (color and extra channels at
// their coded sizes).
fn frame_samples(h: &ImageHeader, f: &FrameHeader) -> u64 {
    w := f.sample_width as u64
    hh := f.sample_height as u64
    total := 0u64
    if f.modular {
        total = f.color_channels as u64 * w * hh
    }
    for i in 0usize..h.num_extra as usize {
        shift := ec_shift(f, i)
        total += ceil_shift(w, shift) * ceil_shift(hh, shift)
    }
    return total
}

fn ceil_shift(v: u64, shift: u32) -> u64 {
    return (v + (1u64 << (shift as u64)) - 1) >> (shift as u64)
}

fn log2_exact(v: u32) -> u32 {
    n := 0u32
    for n < 31 && (1u32 << n) < v {
        n += 1
    }
    return n
}

// The shift of extra channel i relative to the color samples.
fn ec_shift(f: &FrameHeader, i: usize) -> u32 {
    up := log2_exact(f.upsampling)
    ec := log2_exact(f.ec_upsampling[i])
    if ec < up {
        return 0
    }
    return ec - up
}

// Whether a frame can bypass the float pipeline: lossless-style modular
// samples written straight to the output.
fn direct_frame(h: &ImageHeader, f: &FrameHeader) -> bool {
    if !f.modular || h.xyb || f.ycbcr || f.upsampling != 1 || f.gab || f.epf_iters != 0 {
        return false
    }
    if (f.flags & (FLAG_PATCHES | FLAG_SPLINES | FLAG_NOISE)) != 0 {
        return false
    }
    if f.have_crop && (f.x0 != 0 || f.y0 != 0 || f.width != h.width || f.height != h.height) {
        return false
    }
    if !f.replaces_all(h.num_extra) || f.width != h.width || f.height != h.height {
        return false
    }
    for i in 0usize..h.num_extra as usize {
        if f.ec_upsampling[i] != 1 {
            return false
        }
    }
    return true
}

// Skip the TOC at the reader (like read_toc without storing it), a
// permutation decoded with the skimmer.
fn scan_toc(r: &mut Reader, f: &mut FrameHeader, sk: &mut Skim, win: &mut[u8]) -> void!pixels.Error {
    entries := f.toc_entries as usize
    f.toc_permuted = r.bit()
    if f.toc_permuted {
        skip_permutation(r, entries, sk, win)?
    }
    r.pad()
    total := 0u64
    for i in 0usize..entries {
        total += r.u32c(dist(0, 10), dist(1024, 14), dist(17408, 22), dist(4211712, 30)) as u64
    }
    r.pad()
    if r.overrun {
        return err(pixels.Error.Truncated)
    }
    if r.broken {
        return err(pixels.Error.Malformed)
    }
    f.data_start = r.byte_position()
    f.data_size = total
    if total > 0xffffffff {
        return err(pixels.Error.TooLarge)
    }
    return ok()
}

// Skip a Lehmer-coded TOC permutation of `size` entries. The window keeps
// the context class of each entry; entries that LZ77 copies are not
// range-checked here (decode() checks them when it reads the TOC).
fn skip_permutation(r: &mut Reader, size: usize, sk: &mut Skim, win: &mut[u8]) -> void!pixels.Error {
    code := new_sk_code()
    sk_read_code(r, 8, &mut code, sk)?
    st := new_sk_stream(SK_TOC, SK_WINDOW)
    sk_begin(&mut st, &code, r)
    end := sk_read(&mut code, sk, &mut st, win, r, permutation_context(size as u32), 0) as usize
    if st.copied {
        // A copy before any value repeats zeros.
        end = 0
    }
    if end > size {
        return err(pixels.Error.Malformed)
    }
    previous := 0u32
    for k in 0usize..end {
        value := sk_read(&mut code, sk, &mut st, win, r, previous, 0)
        if st.copied {
            previous = value
        } else {
            if value as usize >= size - k {
                return err(pixels.Error.Malformed)
            }
            previous = permutation_context(value)
        }
        if (k & 1023) == 1023 && sk_failed(&st, r) {
            break
        }
    }
    sk_finish(&st, &code, r)?
    return ok()
}

fn walk_frames(r: &mut Reader, h: &ImageHeader, s: &mut Scan, sk: &mut Skim, win: &mut[u8]) -> void!pixels.Error {
    r.seek_byte(h.frames_byte)
    if h.have_preview {
        preview := h.clone_header()
        preview.width = h.preview_width
        preview.height = h.preview_height
        f := read_frame_header(r, &preview)?
        scan_toc(r, &mut f, sk, win)?
        r.seek_byte64(f.end())
    }
    for {
        if s.frames >= MAX_FRAMES {
            return err(pixels.Error.TooLarge)
        }
        f := read_frame_header(r, h)?
        scan_toc(r, &mut f, sk, win)?
        s.frames += 1
        if f.is_keyframe() {
            s.displayed += 1
        }
        if !f.modular {
            s.any_vardct = true
            bw := vardct_blocks(&f, false) as u64
            bh := vardct_blocks(&f, true) as u64
            if bw * bh > s.vd_blocks {
                s.vd_blocks = bw * bh
                s.vd_planes = 192 * bw * bh
            }
            tiles := ((bw + 7) / 8) * ((bh + 7) / 8)
            if tiles > s.vd_tiles {
                s.vd_tiles = tiles
            }
            if f.num_groups() as u64 > s.vd_groups {
                s.vd_groups = f.num_groups() as u64
            }
        }
        if (f.flags & FLAG_NOISE) != 0 {
            s.any_noise = true
        }
        if (f.flags & FLAG_SPLINES) != 0 {
            s.any_splines = true
        }
        if f.color_channels == 1 && (f.gab || f.epf_iters > 0) {
            gray := f.sample_width as u64 * f.sample_height as u64
            if gray > s.gray_filtered {
                s.gray_filtered = gray
            }
        }
        if f.frame_type == FT_LF && f.lf_level >= 1 && f.lf_level <= 3 {
            size := 3 * f.sample_width as u64 * f.sample_height as u64
            if size > s.lf_slot[(f.lf_level - 1) as usize] {
                s.lf_slot[(f.lf_level - 1) as usize] = size
            }
        }
        samples := frame_samples(h, &f)
        if samples > s.max_samples {
            s.max_samples = samples
        }
        pixels_count := f.width as u64 * f.height as u64
        if pixels_count > s.max_frame_pixels {
            s.max_frame_pixels = pixels_count
        }
        if f.sample_width > s.max_sample_width {
            s.max_sample_width = f.sample_width
        }
        if f.sample_height > s.max_sample_height {
            s.max_sample_height = f.sample_height
        }
        if f.width > s.max_frame_width {
            s.max_frame_width = f.width
        }
        if f.height > s.max_frame_height {
            s.max_frame_height = f.height
        }
        if f.toc_entries > s.max_toc {
            s.max_toc = f.toc_entries
        }
        if f.group_dim > s.max_group_dim {
            s.max_group_dim = f.group_dim
        }
        nch := f.color_channels as u64 + h.num_extra as u64
        tree := 1024 + f.width as u64 * f.height as u64 * nch / 16
        if tree > 4194304 {
            tree = 4194304
        }
        if tree > s.max_tree_global {
            s.max_tree_global = tree
        }
        if f.can_reference() {
            slot := f.save_as_reference as usize
            s.slots = s.slots | (1u32 << (slot as u32))
            size := h.width as u64 * h.height as u64
            if pixels_count > size {
                size = pixels_count
            }
            if size > s.slot_pixels[slot] {
                s.slot_pixels[slot] = size
            }
        }
        if !direct_frame(h, &f) {
            s.float_path = true
        }
        if f.needs_blending(h.num_extra) || !f.is_normal() || f.width != h.width || f.height != h.height || f.have_crop {
            s.needs_canvas = true
        }
        if f.num_passes > 1 {
            s.progressive = true
        }
        if nch > s.max_channels as u64 {
            s.max_channels = nch as u32
        }
        if f.is_last {
            break
        }
        if f.end() > 0xffffffffffff {
            return err(pixels.Error.TooLarge)
        }
        r.seek_byte64(f.end())
        if r.overrun {
            return err(pixels.Error.Truncated)
        }
    }
    if s.frames > 1 {
        s.float_path = true
        s.needs_canvas = true
    }
    return ok()
}
