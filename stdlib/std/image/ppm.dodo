package ppm

import "std/image/color"
import "std/image/convert"
import "std/image/meta"
import "std/image/pixels"
import "std/image/shared/binary"
import "std/image/sink"

// The Netpbm family: binary PGM (P5) and PPM (P6) with any maxval, PAM (P7)
// with the GRAYSCALE, GRAYSCALE_ALPHA, RGB, RGB_ALPHA and BLACKANDWHITE tuple
// types, and PFM ("Pf" gray, "PF" RGB 32-bit float), all reported as
// pixels.Format.Ppm.
//
// Samples up to maxval 255 decode to 8 bits, scaled to 0..255 and rounded;
// larger maxvals decode to 16 bits scaled to 0..65535. Samples above maxval
// saturate. PFM decodes to little-endian F32 in linear light, rows top-down,
// with values outside 0.0..1.0 kept. ASCII variants (P1 to P3) and binary
// bitmaps (P4) are Unsupported.

// EncodeOptions.kind values.
// Pick by the source layout: gray to P5, RGB to P6, alpha to P7, float to PFM.
pub const KIND_AUTO: u32 = 0
pub const KIND_PGM: u32 = 5
pub const KIND_PPM: u32 = 6
pub const KIND_PAM: u32 = 7
pub const KIND_PFM: u32 = 8

// Pixels converted per batch through stack storage.
const CHUNK: usize = 64

struct Fields {
    // KIND_PGM, KIND_PPM, KIND_PAM or KIND_PFM.
    kind: u32
    width: u32
    height: u32
    maxval: u32
    channels: usize
    // Bytes per sample: 1, 2 or 4 (PFM).
    size: usize
    // PFM byte order.
    little: bool
    // Offset of the first sample.
    data: usize
}

fn is_space(byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12
}

// 'P', a known type byte, then whitespace.
pub fn matches(data: &[u8]) -> bool {
    if data.len < 3 || data[0] != b'P' {
        return false
    }
    kind := data[1]
    return (kind == b'5' || kind == b'6' || kind == b'7' || kind == b'f' || kind == b'F') && is_space(data[2])
}

// Skip whitespace and # comments.
fn skip(data: &[u8], position: &mut usize) {
    for *position < data.len {
        byte := data[*position]
        if byte == b'#' {
            for *position < data.len && data[*position] != 10 && data[*position] != 13 {
                *position += 1
            }
        } else if is_space(byte) {
            *position += 1
        } else {
            return
        }
    }
}

// Skip whitespace and comments, then read a decimal number.
fn number(data: &[u8], position: &mut usize) -> u32!pixels.Error {
    skip(data, position)
    if *position >= data.len {
        return err(pixels.Error.Truncated)
    }
    value := 0u64
    digits := 0usize
    for *position < data.len && data[*position] >= b'0' && data[*position] <= b'9' {
        value = value * 10 + (data[*position] - b'0') as u64
        if value > 0xffffffff {
            return err(pixels.Error.TooLarge)
        }
        *position += 1
        digits += 1
    }
    if digits == 0 {
        return err(pixels.Error.Malformed)
    }
    return ok(value as u32)
}

// Skip whitespace and comments, then the extent of the next token.
fn token(data: &[u8], position: &mut usize) -> usize!pixels.Error {
    skip(data, position)
    if *position >= data.len {
        return err(pixels.Error.Truncated)
    }
    start := *position
    for *position < data.len && !is_space(data[*position]) {
        *position += 1
    }
    return ok(start)
}

fn same(data: &[u8], start: usize, end: usize, word: &[u8]) -> bool {
    if end - start != word.len {
        return false
    }
    for i in 0usize..word.len {
        if data[start + i] != word[i] {
            return false
        }
    }
    return true
}

fn fields(data: &[u8]) -> Fields!pixels.Error {
    if data.len < 2 {
        return err(pixels.Error.Truncated)
    }
    if data[0] != b'P' {
        return err(pixels.Error.Malformed)
    }
    kind := data[1]
    if kind == b'6' || kind == b'5' {
        return netpbm_fields(data)
    }
    if kind == b'7' {
        return pam_fields(data)
    }
    if kind == b'F' || kind == b'f' {
        return pfm_fields(data)
    }
    if kind >= b'1' && kind <= b'4' {
        return err(pixels.Error.Unsupported)
    }
    return err(pixels.Error.Malformed)
}

fn netpbm_fields(data: &[u8]) -> Fields!pixels.Error {
    channels := 1usize
    kind := KIND_PGM
    if data[1] == b'6' {
        channels = 3
        kind = KIND_PPM
    }
    position := 2usize
    width := number(data, &mut position)?
    height := number(data, &mut position)?
    maxval := number(data, &mut position)?
    if maxval == 0 || maxval > 65535 {
        return err(pixels.Error.Malformed)
    }
    // Exactly one whitespace byte separates the header from the samples.
    if position >= data.len {
        return err(pixels.Error.Truncated)
    }
    position += 1
    binary.check_dimensions(width, height)?
    size := 1usize
    if maxval > 255 {
        size = 2
    }
    return ok(Fields { kind: kind, width: width, height: height, maxval: maxval, channels: channels, size: size, little: false, data: position })
}

fn pam_fields(data: &[u8]) -> Fields!pixels.Error {
    position := 2usize
    width := 0u32
    height := 0u32
    depth := 0u32
    maxval := 0u32
    // Bits: width, height, depth, maxval seen.
    seen := 0u32
    // Channels named by TUPLTYPE, 0 when absent or unknown.
    named := 0u32
    for {
        start := token(data, &mut position)?
        end := position
        if same(data, start, end, b"ENDHDR") {
            // The header ends with a newline.
            if position >= data.len {
                return err(pixels.Error.Truncated)
            }
            position += 1
            break
        } else if same(data, start, end, b"WIDTH") {
            width = number(data, &mut position)?
            seen = seen | 1
        } else if same(data, start, end, b"HEIGHT") {
            height = number(data, &mut position)?
            seen = seen | 2
        } else if same(data, start, end, b"DEPTH") {
            depth = number(data, &mut position)?
            seen = seen | 4
        } else if same(data, start, end, b"MAXVAL") {
            maxval = number(data, &mut position)?
            seen = seen | 8
        } else if same(data, start, end, b"TUPLTYPE") {
            name := token(data, &mut position)?
            last := position
            if same(data, name, last, b"GRAYSCALE") || same(data, name, last, b"BLACKANDWHITE") {
                named = 1
            } else if same(data, name, last, b"GRAYSCALE_ALPHA") || same(data, name, last, b"BLACKANDWHITE_ALPHA") {
                named = 2
            } else if same(data, name, last, b"RGB") {
                named = 3
            } else if same(data, name, last, b"RGB_ALPHA") {
                named = 4
            } else {
                named = 0
            }
            // Skip the rest of the line.
            for position < data.len && data[position] != 10 && data[position] != 13 {
                position += 1
            }
        } else {
            return err(pixels.Error.Malformed)
        }
    }
    if seen != 15 || maxval == 0 || maxval > 65535 {
        return err(pixels.Error.Malformed)
    }
    if depth < 1 || depth > 4 {
        return err(pixels.Error.Unsupported)
    }
    if named != 0 && named != depth {
        return err(pixels.Error.Malformed)
    }
    binary.check_dimensions(width, height)?
    size := 1usize
    if maxval > 255 {
        size = 2
    }
    return ok(Fields { kind: KIND_PAM, width: width, height: height, maxval: maxval, channels: depth as usize, size: size, little: false, data: position })
}

fn pfm_fields(data: &[u8]) -> Fields!pixels.Error {
    channels := 3usize
    if data[1] == b'f' {
        channels = 1
    }
    position := 2usize
    width := number(data, &mut position)?
    height := number(data, &mut position)?
    // The scale: its sign gives the byte order, its magnitude is ignored.
    skip(data, &mut position)
    if position >= data.len {
        return err(pixels.Error.Truncated)
    }
    little := data[position] == b'-'
    digits := 0usize
    nonzero := false
    length := 0usize
    for position < data.len && !is_space(data[position]) {
        byte := data[position]
        if byte >= b'0' && byte <= b'9' {
            digits += 1
            if byte != b'0' {
                nonzero = true
            }
        } else if byte != b'.' && byte != b'-' && byte != b'+' && byte != b'e' && byte != b'E' {
            return err(pixels.Error.Malformed)
        }
        position += 1
        length += 1
        if length > 64 {
            return err(pixels.Error.Malformed)
        }
    }
    if position >= data.len {
        return err(pixels.Error.Truncated)
    }
    if digits == 0 || !nonzero {
        return err(pixels.Error.Malformed)
    }
    position += 1
    binary.check_dimensions(width, height)?
    return ok(Fields { kind: KIND_PFM, width: width, height: height, maxval: 0, channels: channels, size: 4, little: little, data: position })
}

fn native(f: &Fields) -> pixels.Layout {
    sample := pixels.SAMPLE_U8
    if f.size == 2 {
        sample = pixels.SAMPLE_U16
    } else if f.size == 4 {
        sample = pixels.SAMPLE_F32
    }
    return pixels.Layout.from_codes(f.channels, sample, false)
}

// Significant bits for maxval.
fn maxval_bits(maxval: u32) -> u32 {
    bits := 1u32
    for bits < 16 && (maxval >> bits) != 0 {
        bits += 1
    }
    return bits
}

fn header_of(f: &Fields) -> pixels.Header {
    bits := 32u32
    if f.kind != KIND_PFM {
        bits = maxval_bits(f.maxval)
    }
    header := pixels.Header.new(pixels.Format.Ppm, f.width, f.height, native(f), bits)
    if f.kind == KIND_PFM {
        header.color = color.ColorInfo.linear()
    }
    return header
}

pub fn info(data: &[u8]) -> pixels.Header!pixels.Error {
    f := fields(data)?
    return ok(header_of(&f))
}

// Netpbm files carry no metadata.
pub fn metadata(data: &[u8]) -> meta.Metadata!pixels.Error {
    fields(data)?
    return ok(meta.Metadata.empty())
}

// The decoder needs no scratch.
pub fn scratch_size(data: &[u8]) -> usize!pixels.Error {
    fields(data)?
    return ok(0)
}

// One sample scaled from 0..maxval to 0..255, rounded; samples above maxval
// saturate.
fn sample8(value: u32, maxval: u32) -> u8 {
    if value >= maxval {
        return 255
    }
    if maxval == 255 {
        return value as u8
    }
    return ((value * 255 + maxval / 2) / maxval) as u8
}

fn sample16(value: u32, maxval: u32) -> u16 {
    if value >= maxval {
        return 65535
    }
    if maxval == 65535 {
        return value as u16
    }
    return ((value * 65535 + maxval / 2) / maxval) as u16
}

pub fn decode<S: sink.Sink>(data: &[u8], output: &mut S, scratch: &mut[u8]) -> void!pixels.Error {
    f := fields(data)?
    header := header_of(&f)
    layout := header.native.clone()
    row := pixels.checked(f.width as usize, f.channels * f.size, 0)?
    length := pixels.checked(row, f.height as usize, f.data)?
    if data.len < length {
        return err(pixels.Error.Truncated)
    }
    output.begin(&header)?
    if f.width == 0 || f.height == 0 {
        return ok()
    }
    if f.kind != KIND_PFM && f.size == 1 && f.maxval == 255 {
        // Stored bytes are the native layout.
        view := pixels.View.new(&data[f.data..length], f.width, f.height, layout)?
        return output.rect(0, 0, &view)
    }
    if f.kind == KIND_PFM && f.little {
        for stored in 0u32..f.height {
            start := f.data + stored as usize * row
            view := pixels.View.new(&data[start..start + row], f.width, 1, layout.clone())?
            output.rect(0, f.height - 1 - stored, &view)?
        }
        return ok()
    }
    buffer := [0u8; CHUNK * 12]
    pixel := f.channels * f.size
    for stored in 0u32..f.height {
        y := stored
        if f.kind == KIND_PFM {
            y = f.height - 1 - stored
        }
        start := f.data + stored as usize * row
        column := 0u32
        for column < f.width {
            count := f.width - column
            if count > CHUNK as u32 {
                count = CHUNK as u32
            }
            base := start + column as usize * pixel
            samples := count as usize * f.channels
            for i in 0usize..samples {
                if f.size == 1 {
                    buffer[i] = sample8(data[base + i] as u32, f.maxval)
                } else if f.size == 2 {
                    p := base + i * 2
                    value := ((data[p] as u32) << 8) | (data[p + 1] as u32)
                    pixels.put16(&mut buffer, i * 2, sample16(value, f.maxval))
                } else {
                    // Big-endian float to little-endian.
                    p := base + i * 4
                    buffer[i * 4] = data[p + 3]
                    buffer[i * 4 + 1] = data[p + 2]
                    buffer[i * 4 + 2] = data[p + 1]
                    buffer[i * 4 + 3] = data[p]
                }
            }
            view := pixels.View.new(&buffer[..samples * f.size], count, 1, layout.clone())?
            output.rect(column, y, &view)?
            column += count
        }
    }
    return ok()
}

// ---------------------------------------------------------------------------
// Encoder

pub struct EncodeOptions {
    // KIND_AUTO, KIND_PGM, KIND_PPM, KIND_PAM or KIND_PFM.
    pub kind: u32

    pub fn new() -> EncodeOptions {
        return EncodeOptions { kind: KIND_AUTO }
    }
}

// What encode writes for a source layout.
struct Plan {
    kind: u32
    channels: usize
    // Bytes per sample: 1, 2 or 4.
    size: usize
}

fn plan(layout: &pixels.Layout, options: &EncodeOptions) -> Plan!pixels.Error {
    kind := options.kind
    if kind == KIND_AUTO {
        if layout.is_float() {
            kind = KIND_PFM
        } else if layout.has_alpha() {
            kind = KIND_PAM
        } else if layout.is_gray() {
            kind = KIND_PGM
        } else {
            kind = KIND_PPM
        }
    }
    size := 2usize
    if layout.sample_code() == pixels.SAMPLE_U8 {
        size = 1
    }
    if kind == KIND_PGM {
        return ok(Plan { kind: kind, channels: 1, size: size })
    }
    if kind == KIND_PPM {
        return ok(Plan { kind: kind, channels: 3, size: size })
    }
    if kind == KIND_PAM {
        return ok(Plan { kind: kind, channels: layout.channel_count(), size: size })
    }
    if kind == KIND_PFM {
        channels := 3usize
        if layout.is_gray() {
            channels = 1
        }
        return ok(Plan { kind: kind, channels: channels, size: 4 })
    }
    return err(pixels.Error.Unsupported)
}

fn decimal_length(value: u32) -> usize {
    length := 1usize
    rest := value
    for rest >= 10 {
        rest = rest / 10
        length += 1
    }
    return length
}

fn write_decimal(output: &mut[u8], offset: usize, value: u32) -> usize {
    length := decimal_length(value)
    rest := value
    for i in 0usize..length {
        output[offset + length - 1 - i] = b'0' + (rest % 10) as u8
        rest = rest / 10
    }
    return offset + length
}

fn write_text(output: &mut[u8], offset: usize, text: &[u8]) -> usize {
    for i in 0usize..text.len {
        output[offset + i] = text[i]
    }
    return offset + text.len
}

fn tuple_type(channels: usize) -> &[u8] from(static) {
    if channels == 1 {
        return b"GRAYSCALE"
    }
    if channels == 2 {
        return b"GRAYSCALE_ALPHA"
    }
    if channels == 3 {
        return b"RGB"
    }
    return b"RGB_ALPHA"
}

fn maxval_of(p: &Plan) -> u32 {
    if p.size == 1 {
        return 255
    }
    return 65535
}

// Header bytes for a plan.
fn header_length(width: u32, height: u32, p: &Plan) -> usize {
    if p.kind == KIND_PFM {
        // "PF\n" w " " h "\n-1.0\n"
        return 3 + decimal_length(width) + 1 + decimal_length(height) + 6
    }
    if p.kind == KIND_PAM {
        return 3 + 6 + decimal_length(width) + 1 + 7 + decimal_length(height) + 1 + 6 + 1 + 1 + 7 + decimal_length(maxval_of(p)) + 1 + 9 + tuple_type(p.channels).len + 1 + 7
    }
    // "P6\n" w " " h "\n" maxval "\n"
    return 3 + decimal_length(width) + 1 + decimal_length(height) + 1 + decimal_length(maxval_of(p)) + 1
}

fn write_header(output: &mut[u8], width: u32, height: u32, p: &Plan) -> usize {
    output[0] = b'P'
    if p.kind == KIND_PFM {
        output[1] = b'F'
        if p.channels == 1 {
            output[1] = b'f'
        }
    } else if p.kind == KIND_PAM {
        output[1] = b'7'
    } else if p.kind == KIND_PPM {
        output[1] = b'6'
    } else {
        output[1] = b'5'
    }
    output[2] = 10
    position := 3usize
    if p.kind == KIND_PAM {
        position = write_text(output, position, b"WIDTH ")
        position = write_decimal(output, position, width)
        position = write_text(output, position, b"\nHEIGHT ")
        position = write_decimal(output, position, height)
        position = write_text(output, position, b"\nDEPTH ")
        position = write_decimal(output, position, p.channels as u32)
        position = write_text(output, position, b"\nMAXVAL ")
        position = write_decimal(output, position, maxval_of(p))
        position = write_text(output, position, b"\nTUPLTYPE ")
        position = write_text(output, position, tuple_type(p.channels))
        position = write_text(output, position, b"\nENDHDR\n")
        return position
    }
    position = write_decimal(output, position, width)
    output[position] = 32
    position = write_decimal(output, position + 1, height)
    output[position] = 10
    position += 1
    if p.kind == KIND_PFM {
        return write_text(output, position, b"-1.0\n")
    }
    position = write_decimal(output, position, maxval_of(p))
    output[position] = 10
    return position + 1
}

// The exact size encode writes.
pub fn max_encoded_size(width: u32, height: u32, layout: &pixels.Layout, options: &EncodeOptions) -> usize!pixels.Error {
    binary.check_dimensions(width, height)?
    p := plan(layout, options)?
    count := binary.pixel_count(width, height)?
    return pixels.checked(count, p.channels * p.size, header_length(width, height, &p))
}

pub fn encode_scratch_size(width: u32, height: u32, layout: &pixels.Layout, options: &EncodeOptions) -> usize!pixels.Error {
    binary.check_dimensions(width, height)?
    plan(layout, options)?
    return ok(0)
}

// Write `source` and return the byte count, max_encoded_size(...). PFM from
// a float view keeps the float values exactly, out-of-range ones included.
pub fn encode(source: &pixels.View, options: &EncodeOptions, output: &mut[u8], scratch: &mut[u8]) -> usize!pixels.Error {
    layout := source.layout().clone()
    p := plan(&layout, options)?
    if p.kind != KIND_PFM || !layout.is_float() {
        view_source := sink.ViewSource.new(source)
        return encode_from(&view_source, options, output, scratch)
    }
    width := source.width()
    height := source.height()
    total := max_encoded_size(width, height, &layout, options)?
    if output.len < total {
        return err(pixels.Error.BufferTooSmall)
    }
    position := write_header(output, width, height, &p)
    target := pixels.Layout.from_codes(p.channels, pixels.SAMPLE_F32, false)
    row := width as usize * p.channels * 4
    for stored in 0u32..height {
        line := source.row(height - 1 - stored)
        convert.row(line, &layout, 0, &mut output[position..position + row], &target, 0, width as usize)
        position += row
    }
    return ok(position)
}

pub fn encode_from<S: sink.Source>(source: &S, options: &EncodeOptions, output: &mut[u8], scratch: &mut[u8]) -> usize!pixels.Error {
    width := source.width()
    height := source.height()
    layout := source.layout()
    p := plan(&layout, options)?
    total := max_encoded_size(width, height, &layout, options)?
    if output.len < total {
        return err(pixels.Error.BufferTooSmall)
    }
    position := write_header(output, width, height, &p)
    narrow := [0u8; CHUNK * 4]
    wide := [0u16; CHUNK * 4]
    for r in 0u32..height {
        y := r
        if p.kind == KIND_PFM {
            y = height - 1 - r
        }
        column := 0u32
        for column < width {
            count := width - column
            if count > CHUNK as u32 {
                count = CHUNK as u32
            }
            if p.size == 1 {
                source.load_rgba8(column, y, count as usize, &mut narrow)
                for i in 0usize..count as usize {
                    o := i * 4
                    if p.channels >= 3 {
                        output[position] = narrow[o]
                        output[position + 1] = narrow[o + 1]
                        output[position + 2] = narrow[o + 2]
                        if p.channels == 4 {
                            output[position + 3] = narrow[o + 3]
                        }
                    } else {
                        output[position] = gray8(narrow[o], narrow[o + 1], narrow[o + 2])
                        if p.channels == 2 {
                            output[position + 1] = narrow[o + 3]
                        }
                    }
                    position += p.channels
                }
            } else {
                source.load_rgba16(column, y, count as usize, &mut wide)
                for i in 0usize..count as usize {
                    o := i * 4
                    values := [0u32; 4]
                    if p.channels >= 3 {
                        values[0] = wide[o] as u32
                        values[1] = wide[o + 1] as u32
                        values[2] = wide[o + 2] as u32
                        values[3] = wide[o + 3] as u32
                    } else {
                        values[0] = convert.luma16(wide[o] as u32, wide[o + 1] as u32, wide[o + 2] as u32)
                        values[1] = wide[o + 3] as u32
                    }
                    for c in 0usize..p.channels {
                        if p.size == 2 {
                            binary.put_be16(output, position, values[c])
                            position += 2
                        } else {
                            binary.put_le32(output, position, convert.unorm16_to_f32_bits(values[c] as u16))
                            position += 4
                        }
                    }
                }
            }
            column += count
        }
    }
    return ok(position)
}

// BT.709 luma of 8-bit RGB, through the 16-bit path so gray stays exact.
fn gray8(r: u8, g: u8, b: u8) -> u8 {
    luma := convert.luma16(r as u32 * 257, g as u32 * 257, b as u32 * 257)
    return ((luma * 255 + 32767) / 65535) as u8
}
