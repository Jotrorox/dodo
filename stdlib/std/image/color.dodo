package color

// How an image's samples map to colors, and how it is meant to be displayed.
//
// ColorInfo uses CICP (ITU-T H.273) code points as the canonical
// description: AVIF, JPEG XL and PNG's cICP chunk store them directly, and
// decoders map other descriptions (PNG sRGB, gAMA and cHRM; JPEG XL's color
// encoding) onto them where an exact match exists. What CICP cannot name
// stays available: a plain power-law gamma, custom chromaticities, and the
// location of an embedded ICC profile in the file. The code points are u8
// fields compared with the constants below, so a ColorInfo is cheap to copy
// field by field.
//
// The transfer helpers are integer-only, so 8 and 16-bit conversions give
// the same results on every target.

// Color primaries (H.273 table 2).
pub const PRIMARIES_BT709: u8 = 1
pub const PRIMARIES_UNSPECIFIED: u8 = 2
pub const PRIMARIES_BT470M: u8 = 4
pub const PRIMARIES_BT470BG: u8 = 5
pub const PRIMARIES_BT601: u8 = 6
pub const PRIMARIES_SMPTE240: u8 = 7
pub const PRIMARIES_FILM: u8 = 8
pub const PRIMARIES_BT2020: u8 = 9
pub const PRIMARIES_XYZ: u8 = 10
pub const PRIMARIES_DCI_P3: u8 = 11
pub const PRIMARIES_DISPLAY_P3: u8 = 12
pub const PRIMARIES_EBU3213: u8 = 22

// Transfer characteristics (H.273 table 3).
pub const TRANSFER_BT709: u8 = 1
pub const TRANSFER_UNSPECIFIED: u8 = 2
pub const TRANSFER_GAMMA22: u8 = 4
pub const TRANSFER_GAMMA28: u8 = 5
pub const TRANSFER_BT601: u8 = 6
pub const TRANSFER_SMPTE240: u8 = 7
pub const TRANSFER_LINEAR: u8 = 8
pub const TRANSFER_LOG100: u8 = 9
pub const TRANSFER_LOG316: u8 = 10
pub const TRANSFER_XVYCC: u8 = 11
pub const TRANSFER_BT1361: u8 = 12
pub const TRANSFER_SRGB: u8 = 13
pub const TRANSFER_BT2020_10: u8 = 14
pub const TRANSFER_BT2020_12: u8 = 15
pub const TRANSFER_PQ: u8 = 16
pub const TRANSFER_SMPTE428: u8 = 17
pub const TRANSFER_HLG: u8 = 18

// Matrix coefficients (H.273 table 4). Decoded images are always RGB or
// gray, so this records what the file used, normally MATRIX_IDENTITY.
pub const MATRIX_IDENTITY: u8 = 0
pub const MATRIX_BT709: u8 = 1
pub const MATRIX_UNSPECIFIED: u8 = 2
pub const MATRIX_FCC: u8 = 4
pub const MATRIX_BT470BG: u8 = 5
pub const MATRIX_BT601: u8 = 6
pub const MATRIX_SMPTE240: u8 = 7
pub const MATRIX_YCGCO: u8 = 8
pub const MATRIX_BT2020_NCL: u8 = 9
pub const MATRIX_BT2020_CL: u8 = 10
pub const MATRIX_ICTCP: u8 = 14

// How an embedded ICC profile is stored at icc_offset.
pub const ICC_NONE: u8 = 0
// The profile bytes themselves.
pub const ICC_RAW: u8 = 1
// A zlib stream (PNG iCCP).
pub const ICC_ZLIB: u8 = 2
// Entropy-coded inside a JPEG XL codestream; image.icc() decodes it.
pub const ICC_JXL: u8 = 3

// Rendering intents (PNG sRGB chunk, ICC header).
pub const INTENT_PERCEPTUAL: u8 = 0
pub const INTENT_RELATIVE: u8 = 1
pub const INTENT_SATURATION: u8 = 2
pub const INTENT_ABSOLUTE: u8 = 3

pub struct ColorInfo {
    pub primaries: u8
    pub transfer: u8
    pub matrix: u8
    pub full_range: bool
    // True when the file described its colors (a color chunk, CICP, ICC or
    // a JPEG XL color encoding). Untagged images default to sRGB.
    pub tagged: bool
    // Nonzero when the file gives only a power-law curve (PNG gAMA without
    // sRGB, JPEG XL custom gamma): the encoding exponent times 100000, so
    // 45455 is the usual 1/2.2. transfer is then TRANSFER_UNSPECIFIED unless
    // the gamma is one CICP names.
    pub gamma: u32
    // Custom chromaticities times 100000 (PNG cHRM, JPEG XL custom
    // primaries), meaningful when custom_primaries is true; primaries is
    // then PRIMARIES_UNSPECIFIED unless they match a named set.
    pub custom_primaries: bool
    pub white_x: u32
    pub white_y: u32
    pub red_x: u32
    pub red_y: u32
    pub green_x: u32
    pub green_y: u32
    pub blue_x: u32
    pub blue_y: u32
    pub intent: u8
    // The embedded ICC profile: a byte range of the input and its encoding.
    pub icc_encoding: u8
    pub icc_offset: usize
    pub icc_length: usize
    // Peak display luminance in nits the image is graded for (JPEG XL
    // intensity target, PNG cLLi); zero when unknown.
    pub intensity_target: u32

    // Untagged sRGB, the assumption for files without color information.
    pub fn srgb() -> ColorInfo {
        return ColorInfo { primaries: PRIMARIES_BT709, transfer: TRANSFER_SRGB, matrix: MATRIX_IDENTITY, full_range: true, tagged: false, gamma: 0, custom_primaries: false, white_x: 0, white_y: 0, red_x: 0, red_y: 0, green_x: 0, green_y: 0, blue_x: 0, blue_y: 0, intent: INTENT_PERCEPTUAL, icc_encoding: ICC_NONE, icc_offset: 0, icc_length: 0, intensity_target: 0 }
    }
    // Untagged linear-light sRGB primaries (QOI colorspace 1).
    pub fn linear() -> ColorInfo {
        info := ColorInfo.srgb()
        info.transfer = TRANSFER_LINEAR
        return info
    }
    pub fn clone(&self) -> ColorInfo {
        return ColorInfo { primaries: self.primaries, transfer: self.transfer, matrix: self.matrix, full_range: self.full_range, tagged: self.tagged, gamma: self.gamma, custom_primaries: self.custom_primaries, white_x: self.white_x, white_y: self.white_y, red_x: self.red_x, red_y: self.red_y, green_x: self.green_x, green_y: self.green_y, blue_x: self.blue_x, blue_y: self.blue_y, intent: self.intent, icc_encoding: self.icc_encoding, icc_offset: self.icc_offset, icc_length: self.icc_length, intensity_target: self.intensity_target }
    }
    // True when samples are sRGB-encoded with BT.709 primaries, or the file
    // says nothing and sRGB is assumed. An ICC profile makes this false: the
    // profile, not CICP, then defines the colors.
    pub fn is_srgb(&self) -> bool {
        if self.icc_encoding != ICC_NONE {
            return false
        }
        return self.primaries == PRIMARIES_BT709 && self.transfer == TRANSFER_SRGB
    }
    pub fn is_linear(&self) -> bool {
        return self.transfer == TRANSFER_LINEAR
    }
    // Perceptual-quantizer or hybrid-log-gamma content.
    pub fn is_hdr(&self) -> bool {
        return self.transfer == TRANSFER_PQ || self.transfer == TRANSFER_HLG
    }
    pub fn has_icc(&self) -> bool {
        return self.icc_encoding != ICC_NONE
    }
    // Set the curve from a PNG-style gamma (encoding exponent x 100000),
    // naming sRGB-compatible and linear values where CICP can.
    pub fn set_gamma(&mut self, gamma: u32) {
        self.gamma = gamma
        if gamma == 100000 {
            self.transfer = TRANSFER_LINEAR
        } else if gamma >= 45400 && gamma <= 45500 {
            // 1/2.2: the common stand-in for sRGB, and CICP's gamma 2.2.
            self.transfer = TRANSFER_GAMMA22
        } else if gamma >= 35700 && gamma <= 35750 {
            self.transfer = TRANSFER_GAMMA28
        } else {
            self.transfer = TRANSFER_UNSPECIFIED
        }
    }
    // Set custom chromaticities (x 100000), naming BT.709, BT.2020 and the
    // P3 sets when every coordinate is within 0.001.
    pub fn set_chromaticities(&mut self, white_x: u32, white_y: u32, red_x: u32, red_y: u32, green_x: u32, green_y: u32, blue_x: u32, blue_y: u32) {
        self.custom_primaries = true
        self.white_x = white_x
        self.white_y = white_y
        self.red_x = red_x
        self.red_y = red_y
        self.green_x = green_x
        self.green_y = green_y
        self.blue_x = blue_x
        self.blue_y = blue_y
        d65 := near(white_x, 31270) && near(white_y, 32900)
        if d65 && near(red_x, 64000) && near(red_y, 33000) && near(green_x, 30000) && near(green_y, 60000) && near(blue_x, 15000) && near(blue_y, 6000) {
            self.primaries = PRIMARIES_BT709
        } else if d65 && near(red_x, 70800) && near(red_y, 29200) && near(green_x, 17000) && near(green_y, 79700) && near(blue_x, 13100) && near(blue_y, 4600) {
            self.primaries = PRIMARIES_BT2020
        } else if d65 && near(red_x, 68000) && near(red_y, 32000) && near(green_x, 26500) && near(green_y, 69000) && near(blue_x, 15000) && near(blue_y, 6000) {
            self.primaries = PRIMARIES_DISPLAY_P3
        } else if near(white_x, 31400) && near(white_y, 35100) && near(red_x, 68000) && near(red_y, 32000) && near(green_x, 26500) && near(green_y, 69000) && near(blue_x, 15000) && near(blue_y, 6000) {
            self.primaries = PRIMARIES_DCI_P3
        } else {
            self.primaries = PRIMARIES_UNSPECIFIED
        }
    }
}

// Within 0.001 of a chromaticity; `value` comes from the file and may be
// any u32.
fn near(value: u32, expected: u32) -> bool {
    return value as u64 + 100 >= expected as u64 && value as u64 <= expected as u64 + 100
}

// ---------------------------------------------------------------------------
// Orientation

// How stored pixels must be transformed for display (EXIF orientation tag,
// also used by JPEG XL). Names describe the transform to apply.
pub enum Orientation {
    // EXIF 1: as stored.
    Identity,
    // EXIF 2: mirror left-right.
    FlipHorizontal,
    // EXIF 3.
    Rotate180,
    // EXIF 4: mirror top-bottom.
    FlipVertical,
    // EXIF 5: mirror along the top-left to bottom-right diagonal.
    Transpose,
    // EXIF 6: rotate 90 degrees clockwise.
    Rotate90,
    // EXIF 7: mirror along the top-right to bottom-left diagonal.
    Transverse,
    // EXIF 8: rotate 270 degrees clockwise (90 counter-clockwise).
    Rotate270
}

// The orientation for an EXIF value; values outside 1..8 mean Identity.
pub fn orientation_from_exif(value: u32) -> Orientation {
    if value == 2 {
        return Orientation.FlipHorizontal
    }
    if value == 3 {
        return Orientation.Rotate180
    }
    if value == 4 {
        return Orientation.FlipVertical
    }
    if value == 5 {
        return Orientation.Transpose
    }
    if value == 6 {
        return Orientation.Rotate90
    }
    if value == 7 {
        return Orientation.Transverse
    }
    if value == 8 {
        return Orientation.Rotate270
    }
    return Orientation.Identity
}

pub fn exif_value(orientation: &Orientation) -> u32 {
    match orientation {
        Orientation.Identity => {
            return 1
        }
        Orientation.FlipHorizontal => {
            return 2
        }
        Orientation.Rotate180 => {
            return 3
        }
        Orientation.FlipVertical => {
            return 4
        }
        Orientation.Transpose => {
            return 5
        }
        Orientation.Rotate90 => {
            return 6
        }
        Orientation.Transverse => {
            return 7
        }
        Orientation.Rotate270 => {
            return 8
        }
    }
}

pub fn clone_orientation(orientation: &Orientation) -> Orientation {
    return orientation_from_exif(exif_value(orientation))
}

// True when displaying swaps width and height (EXIF 5 through 8).
pub fn swaps_axes(orientation: &Orientation) -> bool {
    return exif_value(orientation) >= 5
}

// ---------------------------------------------------------------------------
// Transfer curves

// An sRGB-encoded 16-bit sample in linear light, from a 256-knot table that
// is exact for 8-bit values (v = k * 257) and interpolated between them.
pub fn srgb_to_linear16(value: u16) -> u16 {
    v := value as u32
    index := v / 257
    fraction := v - index * 257
    low := SRGB_TO_LINEAR[index as usize] as u32
    if fraction == 0 {
        return low as u16
    }
    high := SRGB_TO_LINEAR[index as usize + 1] as u32
    return ((low * (257 - fraction) + high * fraction + 128) / 257) as u16
}

// A linear-light 16-bit sample sRGB-encoded, from a 4097-knot table.
pub fn linear_to_srgb16(value: u16) -> u16 {
    v := value as u32
    index := v >> 4
    fraction := v & 15
    low := LINEAR_TO_SRGB[index as usize] as u32
    if fraction == 0 {
        return low as u16
    }
    high := LINEAR_TO_SRGB[index as usize + 1] as u32
    return ((low * (16 - fraction) + high * fraction + 8) >> 4) as u16
}

// An 8-bit sRGB value in linear light, exactly rounded to 16 bits.
pub fn srgb8_to_linear16(value: u8) -> u16 {
    return SRGB_TO_LINEAR[value as usize]
}

// A linear 16-bit value as 8-bit sRGB.
pub fn linear16_to_srgb8(value: u16) -> u8 {
    return ((linear_to_srgb16(value) as u32 * 255 + 32767) / 65535) as u8
}

