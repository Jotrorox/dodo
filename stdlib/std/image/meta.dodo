package meta

import "std/compress/brotli"
import "std/compress/deflate"
import "std/compress/zlib"
import "std/image/pixels"
import "std/image/shared/binary"
import "std/image/shared/scratch"

// Image metadata located without copying: decoders report EXIF, XMP and ICC
// payloads as byte ranges of the input file plus how they are encoded.
// Helpers here read the EXIF orientation and decode zlib and Brotli
// payloads; ICC profiles entropy-coded in a JPEG XL codestream are decoded
// through std/image or std/image/jxl.

// How an Item's bytes are stored.
pub const ENCODING_RAW: u8 = 0
// A zlib stream (PNG iCCP, compressed iTXt).
pub const ENCODING_ZLIB: u8 = 1
// A JPEG XL "brob" box payload: the 4-byte type of the box it replaces
// ("Exif", "xml ") followed by a Brotli stream of that box's payload.
pub const ENCODING_BROTLI: u8 = 2
// Entropy-coded in a JPEG XL codestream (ICC only).
pub const ENCODING_JXL: u8 = 3

// One payload: data[offset..offset + length] in `encoding`. Absent when
// length is zero. EXIF items start at the TIFF header ("II*\0" or
// "MM\0*"); XMP items are the XML packet.
pub struct Item {
    pub offset: usize
    pub length: usize
    pub encoding: u8

    pub fn none() -> Item {
        return Item { offset: 0, length: 0, encoding: ENCODING_RAW }
    }
    pub fn raw(offset: usize, length: usize) -> Item {
        return Item { offset: offset, length: length, encoding: ENCODING_RAW }
    }
    pub fn present(&self) -> bool {
        return self.length > 0
    }
    pub fn clone(&self) -> Item {
        return Item { offset: self.offset, length: self.length, encoding: self.encoding }
    }
    // The item's stored bytes in `data`, the file it came from.
    pub fn bytes(&self, data: &[u8]) -> &[u8]!pixels.Error from(data) {
        return binary.range(data, self.offset, self.length)
    }
}

pub struct Metadata {
    pub exif: Item
    pub xmp: Item
    pub icc: Item

    pub fn empty() -> Metadata {
        return Metadata { exif: Item.none(), xmp: Item.none(), icc: Item.none() }
    }
}

// Decode an item into `output`, returning the byte count: raw items are
// copied, zlib items inflated, Brotli items decompressed (EXIF then starts
// at the TIFF header, as for raw items; `output` must also hold the 4-byte
// offset field and any padding before it). Brotli items are decoded with
// 16 KiB of stack workspace (brotli.STACK_WORKSPACE_LEN words; about 30 KiB
// of stack in all), enough for the streams the reference encoder writes
// for payloads of up to 128 KiB; one that needs more fails with TooLarge,
// and decode_with_scratch() decodes every stream. Inflating a zlib item
// takes about 20 KiB of stack. JPEG XL items fail with Unsupported here.
pub fn decode(data: &[u8], item: &Item, output: &mut[u8]) -> usize!pixels.Error {
    if item.encoding == ENCODING_BROTLI {
        stored := item.bytes(data)?
        return decode_brob(stored, output, none)
    }
    empty := [0u8; 0]
    return decode_with_scratch(data, item, output, &mut empty)
}

// Scratch bytes decode_with_scratch() needs for `item`: for a Brotli item,
// its stream's workspace (brotli.workspace_size(), read from the stream
// headers: exact for almost every stream, at most about 1.3 MiB); zero for
// the other encodings.
pub fn scratch_size(data: &[u8], item: &Item) -> usize!pixels.Error {
    if item.encoding != ENCODING_BROTLI {
        return ok(0)
    }
    stored := item.bytes(data)?
    if stored.len < 4 {
        return err(pixels.Error.Truncated)
    }
    words := match brotli.workspace_size(&stored[4..]) {
        ok(n) => {
            n
        }
        err(error) => {
            return err(brotli_error(error))
        }
    }
    return scratch.size(words, 2)
}

// decode() with caller-supplied scratch of scratch_size(data, item) bytes,
// which may be heap or static storage; Brotli items then take no large
// stack and every valid stream decodes. Smaller scratch fails with
// TooLarge when a Brotli stream's tables do not fit.
pub fn decode_with_scratch(data: &[u8], item: &Item, output: &mut[u8], work: &mut[u8]) -> usize!pixels.Error {
    stored := item.bytes(data)?
    if item.encoding == ENCODING_BROTLI {
        words := scratch.u16s(work)
        return decode_brob(stored, output, some(words))
    }
    if item.encoding == ENCODING_RAW {
        if output.len < stored.len {
            return err(pixels.Error.BufferTooSmall)
        }
        for i in 0usize..stored.len {
            output[i] = stored[i]
        }
        return ok(stored.len)
    }
    if item.encoding != ENCODING_ZLIB {
        return err(pixels.Error.Unsupported)
    }
    match zlib.decode(stored, output) {
        ok(result) => {
            return ok(result.output_written)
        }
        err(error) => {
            if error == deflate.Error.OutputFull {
                return err(pixels.Error.BufferTooSmall)
            }
            if error == deflate.Error.Truncated {
                return err(pixels.Error.Truncated)
            }
            return err(pixels.Error.Malformed)
        }
    }
}

// A brob box payload: the inner box type, then the Brotli stream, decoded
// in `words` or else with brotli.decompress()'s stack workspace. An Exif
// box payload starts with the offset of the TIFF header from the end of
// that 4-byte field, which is removed.
fn decode_brob(stored: &[u8], output: &mut[u8], words: Option<&mut[u16]>) -> usize!pixels.Error {
    if stored.len < 4 {
        return err(pixels.Error.Truncated)
    }
    decoded := match words {
        some(workspace) => {
            brotli.decompress_with_workspace(&stored[4..], output, workspace)
        }
        none => {
            brotli.decompress(&stored[4..], output)
        }
    }
    length := match decoded {
        ok(n) => {
            n
        }
        err(error) => {
            return err(brotli_error(error))
        }
    }
    if stored[0] != b'E' || stored[1] != b'x' || stored[2] != b'i' || stored[3] != b'f' {
        return ok(length)
    }
    if length < 4 {
        return err(pixels.Error.Malformed)
    }
    skip := binary.be32(&output[..length], 0)? as usize
    if skip > length - 4 {
        return err(pixels.Error.Malformed)
    }
    start := 4 + skip
    for i in 0usize..length - start {
        output[i] = output[start + i]
    }
    return ok(length - start)
}

fn brotli_error(error: brotli.Error) -> pixels.Error {
    match error {
        brotli.Error.Truncated => {
            return pixels.Error.Truncated
        }
        brotli.Error.OutputFull => {
            return pixels.Error.BufferTooSmall
        }
        brotli.Error.WorkspaceTooSmall => {
            return pixels.Error.TooLarge
        }
        brotli.Error.Unsupported => {
            return pixels.Error.Unsupported
        }
        brotli.Error.WindowTooSmall => {
            return pixels.Error.BufferTooSmall
        }
        brotli.Error.InvalidData => {
            return pixels.Error.Malformed
        }
    }
}

// The orientation tag (0x0112) of a TIFF-structured EXIF payload, 1 to 8,
// or 1 when absent. Only IFD0 is searched, as the tag lives there.
pub fn exif_orientation(exif: &[u8]) -> u32!pixels.Error {
    if exif.len < 8 {
        return err(pixels.Error.Truncated)
    }
    little := false
    if exif[0] == b'I' && exif[1] == b'I' {
        little = true
    } else if exif[0] != b'M' || exif[1] != b'M' {
        return err(pixels.Error.Malformed)
    }
    if tiff16(exif, 2, little)? != 42 {
        return err(pixels.Error.Malformed)
    }
    ifd := tiff32(exif, 4, little)? as usize
    count := tiff16(exif, ifd, little)? as usize
    for i in 0usize..count {
        entry := ifd + 2 + i * 12
        tag := tiff16(exif, entry, little)?
        if tag == 0x0112 {
            kind := tiff16(exif, entry + 2, little)?
            value := 1u32
            if kind == 3 {
                value = tiff16(exif, entry + 8, little)?
            } else if kind == 4 {
                value = tiff32(exif, entry + 8, little)?
            } else {
                return err(pixels.Error.Malformed)
            }
            if value < 1 || value > 8 {
                return ok(1)
            }
            return ok(value)
        }
    }
    return ok(1)
}

fn tiff16(data: &[u8], offset: usize, little: bool) -> u32!pixels.Error {
    if little {
        return binary.le16(data, offset)
    }
    return binary.be16(data, offset)
}

fn tiff32(data: &[u8], offset: usize, little: bool) -> u32!pixels.Error {
    if little {
        return binary.le32(data, offset)
    }
    return binary.be32(data, offset)
}
