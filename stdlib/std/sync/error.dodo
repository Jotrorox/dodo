package error

pub enum Error {
    TimedOut, Cancelled, Closed, InvalidInput, NativeFailure, AllocationFailed,
    InvalidOrdering
}

pub fn check(code: i32) -> void!Error {
    if code == 0 {
        return ok()
    }
    if code == 1 {
        return err(Error.TimedOut)
    }
    if code == 2 {
        return err(Error.Cancelled)
    }
    if code == 3 {
        return err(Error.Closed)
    }
    if code == 4 {
        return err(Error.InvalidInput)
    }
    if code == 6 {
        return err(Error.AllocationFailed)
    }
    return err(Error.NativeFailure)
}
