package linux

// Internal ABI to runtime.c, compiled against target platform headers.
// All pointers require live, stable, initialized storage owned by a Dodo wrapper.
pub unsafe extern "C" fn dodo_sync_init(memory: *mut u8, bytes: usize) -> i32
pub unsafe extern "C" fn dodo_sync_destroy(memory: *mut u8)
pub unsafe extern "C" fn dodo_sync_lock(memory: *mut u8, shared: i32, timeout: u64) -> i32
pub unsafe extern "C" fn dodo_sync_unlock(memory: *mut u8, shared: i32)
pub unsafe extern "C" fn dodo_sync_wait(memory: *mut u8, timeout: u64) -> i32
pub unsafe extern "C" fn dodo_sync_notify(memory: *mut u8, all: i32)
pub unsafe extern "C" fn dodo_sync_cancel(memory: *mut u8)
pub unsafe extern "C" fn dodo_sync_barrier_init(memory: *mut u8, parties: usize) -> i32
pub unsafe extern "C" fn dodo_sync_barrier_wait(memory: *mut u8, timeout: u64) -> i32
pub unsafe extern "C" fn dodo_sync_channel_init(memory: *mut u8, ring: *mut u8, capacity: usize, stride: usize) -> i32
pub unsafe extern "C" fn dodo_sync_send(memory: *mut u8, value: *const u8, timeout: u64) -> i32
pub unsafe extern "C" fn dodo_sync_receive(memory: *mut u8, value: *mut u8, timeout: u64) -> i32
pub unsafe extern "C" fn dodo_sync_close(memory: *mut u8)
pub unsafe extern "C" fn dodo_sync_allocate(payload: usize, alignment: usize) -> *mut u8
pub unsafe extern "C" fn dodo_sync_retain(memory: *mut u8)
pub unsafe extern "C" fn dodo_sync_release(memory: *mut u8) -> i32
pub unsafe extern "C" fn dodo_sync_free(memory: *mut u8)
