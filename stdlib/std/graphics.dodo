package graphics

import "core/bytes"
import "core/mem"
import "core/num"

// CPU drawing into caller-owned pixel storage. No allocation, no operating
// system, and no floating point: every target, firmware included, produces
// identical pixels, which makes rendered images comparable byte for byte.
//
// A Canvas borrows its pixels; it never owns or grows them. Drawing calls
// cannot fail: anything outside the canvas or its clip rectangle is skipped.
// Only construction and presenting return Results.
//
// Coordinates are i32 pixels with the origin at the top-left corner and y
// growing downward. Pixel (x, y) covers the unit square from (x, y) to
// (x + 1, y + 1). Line and polygon vertices are clamped to +/-2^29 and ellipse
// radii to 16383 so intermediate products fit in 64 bits; circles, rectangles
// and text are exact for every i32/u32 input.

pub enum Error {
    // An argument is outside what the operation accepts, such as a stride
    // shorter than one row or a dimension above MAX_DIMENSION.
    InvalidInput,
    // The pixel storage or output buffer is shorter than required.
    BufferTooSmall,
    // The pixel format, file variant or feature is not implemented.
    Unsupported,
    // A display or its bus failed while presenting.
    Device
}

pub fn error_name(error: Error) -> &str from(static) {
    match error {
        Error.InvalidInput => {
            return "InvalidInput"
        }
        Error.BufferTooSmall => {
            return "BufferTooSmall"
        }
        Error.Unsupported => {
            return "Unsupported"
        }
        Error.Device => {
            return "Device"
        }
    }
}

// Memory layout of one pixel.
pub enum PixelFormat {
    // Four bytes per pixel in the order red, green, blue, alpha.
    Rgba8888,
    // Four bytes per pixel in the order blue, green, red, alpha, the native
    // 32-bit layout of Windows DIBs, macOS bitmaps and X11 on little-endian.
    Bgra8888,
    // Two bytes per pixel, 5 bits red, 6 green, 5 blue, high byte first: the
    // order SPI panels such as the ST7789 and ILI9341 receive.
    Rgb565,
    // One luminance byte per pixel.
    Gray8,
    // One bit per pixel, eight pixels per byte with the leftmost in the most
    // significant bit; each row starts on a byte boundary. A set bit is on
    // (white).
    Mono1
}

// The largest accepted width or height. Keeping both well inside i32 lets
// every edge computation use plain checked integer arithmetic.
pub const MAX_DIMENSION: u32 = 16777216

const COORD_LIMIT: i64 = 536870912
const ELLIPSE_LIMIT: u64 = 16383
const POLYGON_CROSSINGS: usize = 64
const ORIGIN_LIMIT: i64 = 268435456

// Bits used by one pixel: 32, 16, 8 or 1.
pub fn bits_per_pixel(format: PixelFormat) -> u32 {
    return format_bits(&format) as u32
}

// Bytes in one tightly packed row, or the largest usize if it does not fit.
pub fn min_stride(width: u32, format: PixelFormat) -> usize {
    return row_bytes(width, &format)
}

// Bytes a tightly packed width x height canvas needs, or the largest usize if
// the size does not fit in memory. Size static storage or an allocation with it.
pub fn bytes_needed(width: u32, height: u32, format: PixelFormat) -> usize {
    match num.checked_mul(row_bytes(width, &format), height as usize) {
        ok(total) => {
            return total
        }
        err(_) => {
            return core.wrapping_sub(0usize, 1usize)
        }
    }
}

// A canvas over `pixels` with tightly packed rows; see Canvas.new.
pub fn canvas(pixels: &mut[u8], width: u32, height: u32, format: PixelFormat) -> Canvas!Error from(pixels) {
    return Canvas.new(pixels, width, height, format)
}

fn format_bits(format: &PixelFormat) -> usize {
    match format {
        PixelFormat.Rgba8888 => {
            return 32
        }
        PixelFormat.Bgra8888 => {
            return 32
        }
        PixelFormat.Rgb565 => {
            return 16
        }
        PixelFormat.Gray8 => {
            return 8
        }
        PixelFormat.Mono1 => {
            return 1
        }
    }
}

fn row_bytes(width: u32, format: &PixelFormat) -> usize {
    bits := format_bits(format)
    if bits == 1 {
        return (width as usize + 7) / 8
    }
    return num.saturating_mul(width as usize, bits / 8)
}

// ---------------------------------------------------------------------------
// Colors

// A color as 0xAARRGGBB: alpha in the top byte, then red, green and blue.
// Colors are plain integers so they copy freely into every drawing call.
pub type Color = u32

pub const TRANSPARENT: Color = 0x00000000
pub const BLACK: Color = 0xff000000
pub const WHITE: Color = 0xffffffff
pub const RED: Color = 0xffff0000
pub const GREEN: Color = 0xff00ff00
pub const BLUE: Color = 0xff0000ff
pub const YELLOW: Color = 0xffffff00
pub const CYAN: Color = 0xff00ffff
pub const MAGENTA: Color = 0xffff00ff
pub const GRAY: Color = 0xff808080
pub const DARK_GRAY: Color = 0xff404040
pub const LIGHT_GRAY: Color = 0xffc0c0c0

// An opaque color from its channels.
pub fn rgb(red: u8, green: u8, blue: u8) -> Color {
    return rgba(red, green, blue, 255)
}

// A color with an explicit alpha; 0 is fully transparent, 255 opaque.
pub fn rgba(red: u8, green: u8, blue: u8, alpha: u8) -> Color {
    return ((alpha as u32) << 24) | ((red as u32) << 16) | ((green as u32) << 8) | (blue as u32)
}

// An opaque color from 0xRRGGBB, as written in CSS. Bits above the low 24
// are ignored.
pub fn hex(value: u32) -> Color {
    return 0xff000000 | (value & 0x00ffffff)
}

pub fn red(color: Color) -> u8 {
    return ((color >> 16) & 255) as u8
}

pub fn green(color: Color) -> u8 {
    return ((color >> 8) & 255) as u8
}

pub fn blue(color: Color) -> u8 {
    return (color & 255) as u8
}

pub fn alpha(color: Color) -> u8 {
    return (color >> 24) as u8
}

// The same color with its alpha replaced.
pub fn with_alpha(color: Color, alpha: u8) -> Color {
    return (color & 0x00ffffff) | ((alpha as u32) << 24)
}

// Perceived brightness, 0 to 255, using integer BT.601 weights. Gray8 and
// Mono1 canvases store this value (Mono1 lights pixels from 128 up).
pub fn luma(color: Color) -> u8 {
    value := 77 * ((color >> 16) & 255) + 150 * ((color >> 8) & 255) + 29 * (color & 255)
    return ((value + 128) >> 8) as u8
}

// `top` composited over `bottom` (source-over). Both are straight, not
// premultiplied, colors.
pub fn over(top: Color, bottom: Color) -> Color {
    a := top >> 24
    if a == 255 {
        return top
    }
    if a == 0 {
        return bottom
    }
    inverse := 255 - a
    bottom_alpha := bottom >> 24
    if bottom_alpha == 255 {
        return blend_opaque(tint_low(top, a), tint_high(top, a), inverse, bottom)
    }
    // out_alpha * 255 = a * 255 + bottom_alpha * (255 - a)
    out_alpha := a * 255 + bottom_alpha * inverse
    if out_alpha == 0 {
        return TRANSPARENT
    }
    r := mix_channel((top >> 16) & 255, (bottom >> 16) & 255, a, bottom_alpha * inverse, out_alpha)
    g := mix_channel((top >> 8) & 255, (bottom >> 8) & 255, a, bottom_alpha * inverse, out_alpha)
    b := mix_channel(top & 255, bottom & 255, a, bottom_alpha * inverse, out_alpha)
    return (div255(out_alpha) << 24) | (r << 16) | (g << 8) | b
}

// (top * a * 255 + bottom * weight) / out_alpha, rounded.
fn mix_channel(top: u32, bottom: u32, a: u32, weight: u32, out_alpha: u32) -> u32 {
    value := (top * a * 255 + bottom * weight) as u64
    return ((value + (out_alpha as u64) / 2) / (out_alpha as u64)) as u32
}

// Round value / 255 for value <= 255 * 255.
fn div255(value: u32) -> u32 {
    biased := value + 128
    return (biased + (biased >> 8)) >> 8
}

// Blending works on whole 32-bit pixels, two 8-bit channels per operation:
// bytes 0 and 2 of a pixel sit in the 16-bit lanes of one u32, bytes 1 and
// 3 in another, and every lane product stays below 2^16. The alpha byte is
// byte 3 both in a Color and in Rgba8888/Bgra8888 storage, so the same code
// blends either layout.
//
// tint_low and tint_high premultiply a source pixel by its alpha `a` once:
// bytes 0 and 2, then bytes 1 and 3 with the alpha byte taken as 255, so
// blending onto an opaque pixel leaves it opaque.
fn tint_low(pixel: u32, a: u32) -> u32 {
    return (pixel & 0x00ff00ff) * a
}

fn tint_high(pixel: u32, a: u32) -> u32 {
    return (((pixel >> 8) & 0x000000ff) | 0x00ff0000) * a
}

// A tinted source with alpha a composited over the opaque pixel `below`,
// where inverse = 255 - a. Each channel is div255(top * a + below * inverse),
// which is exactly what over() computes when the bottom alpha is 255.
fn blend_opaque(low: u32, high: u32, inverse: u32, below: u32) -> u32 {
    l := low + (below & 0x00ff00ff) * inverse + 0x00800080
    h := high + ((below >> 8) & 0x00ff00ff) * inverse + 0x00800080
    l = ((l + ((l >> 8) & 0x00ff00ff)) >> 8) & 0x00ff00ff
    h = (h + ((h >> 8) & 0x00ff00ff)) & 0xff00ff00
    return l | h
}

// The bytes `color` occupies in `format`, packed with the first memory byte
// in the low bits. Mono1 yields 0 or 1.
fn encode(format: &PixelFormat, color: Color) -> u32 {
    r := (color >> 16) & 255
    g := (color >> 8) & 255
    b := color & 255
    a := color >> 24
    match format {
        PixelFormat.Rgba8888 => {
            return r | (g << 8) | (b << 16) | (a << 24)
        }
        PixelFormat.Bgra8888 => {
            return b | (g << 8) | (r << 16) | (a << 24)
        }
        PixelFormat.Rgb565 => {
            value := ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
            return (value >> 8) | ((value & 255) << 8)
        }
        PixelFormat.Gray8 => {
            return luma(color) as u32
        }
        PixelFormat.Mono1 => {
            if luma(color) >= 128 {
                return 1
            }
            return 0
        }
    }
}

// ---------------------------------------------------------------------------
// Geometry

pub struct Point {
    pub x: i32
    pub y: i32

    pub fn new(x: i32, y: i32) -> Point {
        return Point { x: x, y: y }
    }
    pub fn clone(&self) -> Point {
        return Point { x: self.x, y: self.y }
    }
    pub fn equals(&self, other: &Point) -> bool {
        return self.x == other.x && self.y == other.y
    }
}

pub struct Size {
    pub width: u32
    pub height: u32

    pub fn new(width: u32, height: u32) -> Size {
        return Size { width: width, height: height }
    }
    pub fn clone(&self) -> Size {
        return Size { width: self.width, height: self.height }
    }
    pub fn equals(&self, other: &Size) -> bool {
        return self.width == other.width && self.height == other.height
    }
    pub fn is_empty(&self) -> bool {
        return self.width == 0 || self.height == 0
    }
}

// An axis-aligned rectangle covering columns x..x+width and rows y..y+height,
// end exclusive. A rectangle with zero width or height is empty.
pub struct Rect {
    pub x: i32
    pub y: i32
    pub width: u32
    pub height: u32

    pub fn new(x: i32, y: i32, width: u32, height: u32) -> Rect {
        return Rect { x: x, y: y, width: width, height: height }
    }
    pub fn empty() -> Rect {
        return Rect { x: 0, y: 0, width: 0, height: 0 }
    }
    pub fn clone(&self) -> Rect {
        return Rect { x: self.x, y: self.y, width: self.width, height: self.height }
    }
    // Field-wise equality; two differently placed empty rectangles differ.
    pub fn equals(&self, other: &Rect) -> bool {
        return self.x == other.x && self.y == other.y && self.width == other.width && self.height == other.height
    }
    pub fn is_empty(&self) -> bool {
        return self.width == 0 || self.height == 0
    }
    pub fn size(&self) -> Size {
        return Size { width: self.width, height: self.height }
    }
    // One past the last column, which may exceed the i32 range.
    pub fn right(&self) -> i64 {
        return self.x as i64 + self.width as i64
    }
    // One past the last row, which may exceed the i32 range.
    pub fn bottom(&self) -> i64 {
        return self.y as i64 + self.height as i64
    }
    pub fn contains(&self, x: i32, y: i32) -> bool {
        return x >= self.x && (x as i64) < self.right() && y >= self.y && (y as i64) < self.bottom()
    }
    // The overlap of both rectangles, or Rect.empty() if they do not overlap.
    pub fn intersect(&self, other: &Rect) -> Rect {
        return edges_rect(max64(self.x as i64, other.x as i64), max64(self.y as i64, other.y as i64), min64(self.right(), other.right()), min64(self.bottom(), other.bottom()))
    }
    // The smallest rectangle containing both. An empty operand is ignored;
    // a result wider than u32 saturates.
    pub fn union(&self, other: &Rect) -> Rect {
        if self.is_empty() {
            return other.clone()
        }
        if other.is_empty() {
            return self.clone()
        }
        return edges_rect(min64(self.x as i64, other.x as i64), min64(self.y as i64, other.y as i64), max64(self.right(), other.right()), max64(self.bottom(), other.bottom()))
    }
    // The same rectangle moved by (dx, dy), saturating at the i32 range.
    pub fn offset(&self, dx: i32, dy: i32) -> Rect {
        x := clamp64(self.x as i64 + dx as i64, -2147483648, 2147483647) as i32
        y := clamp64(self.y as i64 + dy as i64, -2147483648, 2147483647) as i32
        return Rect { x: x, y: y, width: self.width, height: self.height }
    }
}

// A rectangle from edges, empty when they cross, saturating to i32/u32.
fn edges_rect(left: i64, top: i64, right: i64, bottom: i64) -> Rect {
    if left >= right || top >= bottom {
        return Rect.empty()
    }
    x := clamp64(left, -2147483648, 2147483647)
    y := clamp64(top, -2147483648, 2147483647)
    width := min64(right - x, 4294967295)
    height := min64(bottom - y, 4294967295)
    return Rect { x: x as i32, y: y as i32, width: width as u32, height: height as u32 }
}

fn min64(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn max64(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn clamp64(value: i64, low: i64, high: i64) -> i64 {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}

fn abs64(value: i64) -> i64 {
    if value < 0 {
        return -value
    }
    return value
}

fn coordinate(value: i32) -> i64 {
    return clamp64(value as i64, -COORD_LIMIT, COORD_LIMIT)
}

// floor(sqrt(value)), bit by bit.
fn isqrt(value: u64) -> u64 {
    if value < 2 {
        return value
    }
    bit := 1u64 << 62
    for bit > value {
        bit = bit >> 2
    }
    remainder := value
    root := 0u64
    for bit != 0 {
        if remainder >= root + bit {
            remainder -= root + bit
            root = (root >> 1) + bit
        } else {
            root = root >> 1
        }
        bit = bit >> 2
    }
    return root
}

// Floor and ceiling division by a positive divisor.
fn floor_div(value: i64, divisor: i64) -> i64 {
    if value >= 0 {
        return value / divisor
    }
    return -((-value + divisor - 1) / divisor)
}

fn ceil_div(value: i64, divisor: i64) -> i64 {
    return -floor_div(-value, divisor)
}

// value / divisor rounded to the nearest integer, halves up.
fn round_div(value: i64, divisor: i64) -> i64 {
    return floor_div(2 * value + divisor, 2 * divisor)
}

// Half the width of row `dy` of a disk of radius r centred on a pixel: the
// largest w with w^2 + dy^2 <= r^2 + r, that is, the pixel centres within
// r + 1/2. Requires dy <= r.
fn circle_half(radius: u64, dy: u64) -> i64 {
    return isqrt(radius * radius + radius - dy * dy) as i64
}

// The same for an ellipse with radii rx, ry (both <= ELLIPSE_LIMIT): the
// largest w with (w / (rx + 1/2))^2 + (dy / (ry + 1/2))^2 <= 1. Requires dy <= ry.
fn ellipse_half(rx: u64, ry: u64, dy: u64) -> i64 {
    a := (2 * rx + 1) * (2 * rx + 1)
    b := (2 * ry + 1) * (2 * ry + 1)
    return isqrt(a * (b - 4 * dy * dy) / (4 * b)) as i64
}

// The first pixel column right of where the edge from vertex `edge` to the
// next crosses the centre of `row`, or none if the edge does not span that
// row. Horizontal edges never cross. `coordinates` holds x, y pairs.
fn crossing(coordinates: &[i32], edge: usize, row: i64) -> Option<i64> {
    next := (edge + 1) % (coordinates.len / 2)
    ax := coordinate(coordinates[2 * edge])
    ay := coordinate(coordinates[2 * edge + 1])
    bx := coordinate(coordinates[2 * next])
    by := coordinate(coordinates[2 * next + 1])
    if ay == by {
        return none
    }
    if ay > by {
        swap_x := ax
        ax = bx
        bx = swap_x
        swap_y := ay
        ay = by
        by = swap_y
    }
    if row < ay || row >= by {
        return none
    }
    dy := by - ay
    t := 2 * (row - ay) + 1
    // Pixel px is inside from this edge when px + 1/2 >= the crossing.
    return some(ceil_div(2 * ax * dy + t * (bx - ax) - dy, 2 * dy))
}

// ---------------------------------------------------------------------------
// Fonts

// A fixed-width bitmap font. Glyphs are stored for consecutive code points
// starting at `first`, each `glyph_height` rows of ceil(glyph_width / 8)
// bytes, leftmost pixel in the most significant bit. The cell includes any
// spacing, so text advances by exactly glyph_width * scale per character.
// Characters outside the font draw as an outlined replacement box.
pub struct Font {
    glyph_width: u32
    glyph_height: u32
    first: u32
    count: u32
    scale: u32
    bitmap: &[u8]

    // Fails with InvalidInput for a zero or above-256 glyph dimension or a
    // zero count, and BufferTooSmall when `bitmap` is shorter than
    // count * glyph_height * ceil(glyph_width / 8) bytes.
    pub fn new(glyph_width: u32, glyph_height: u32, first: u32, count: u32, bitmap: &[u8]) -> Font!Error from(bitmap) {
        if glyph_width == 0 || glyph_height == 0 || glyph_width > 256 || glyph_height > 256 || count == 0 {
            return err(Error.InvalidInput)
        }
        per_glyph := ((glyph_width as usize + 7) / 8) * glyph_height as usize
        match num.checked_mul(per_glyph, count as usize) {
            ok(total) => {
                if bitmap.len < total {
                    return err(Error.BufferTooSmall)
                }
            }
            err(_) => {
                return err(Error.BufferTooSmall)
            }
        }
        return ok(Font { glyph_width: glyph_width, glyph_height: glyph_height, first: first, count: count, scale: 1, bitmap: bitmap })
    }
    // The same font drawn `factor` times larger in both directions. Factors
    // are limited to 1 through 64; 0 is treated as 1.
    pub fn scaled(self, factor: u32) -> Font {
        scale := factor
        if scale == 0 {
            scale = 1
        }
        if scale > 64 {
            scale = 64
        }
        return Font { glyph_width: self.glyph_width, glyph_height: self.glyph_height, first: self.first, count: self.count, scale: scale, bitmap: self.bitmap }
    }
    pub fn scale(&self) -> u32 {
        return self.scale
    }
    // Horizontal distance between characters, in canvas pixels.
    pub fn advance(&self) -> u32 {
        return self.glyph_width * self.scale
    }
    // Vertical distance between lines, in canvas pixels.
    pub fn line_height(&self) -> u32 {
        return self.glyph_height * self.scale
    }
    pub fn has_glyph(&self, code_point: u32) -> bool {
        return code_point >= self.first && code_point - self.first < self.count
    }
    // The size `text` covers: the longest line times the advance, and the
    // line count times the line height. "\n" starts a line; "\r" is ignored.
    pub fn measure(&self, text: &str) -> Size {
        data := mem.str_bytes(text)
        columns := 0u64
        widest := 0u64
        lines := 0u64
        if data.len > 0 {
            lines = 1
        }
        index := 0usize
        for index < data.len {
            code := decode_utf8(data, index)
            index += utf8_length(data[index])
            if code == 10 {
                lines += 1
                columns = 0
            } else if code != 13 {
                columns += 1
                if columns > widest {
                    widest = columns
                }
            }
        }
        width := widest * self.advance() as u64
        height := lines * self.line_height() as u64
        return Size { width: min64(width as i64, 4294967295) as u32, height: min64(height as i64, 4294967295) as u32 }
    }
}

// Length of the UTF-8 sequence starting with `lead`, in bytes.
fn utf8_length(lead: u8) -> usize {
    if lead < 0x80 {
        return 1
    }
    if lead < 0xe0 {
        return 2
    }
    if lead < 0xf0 {
        return 3
    }
    return 4
}

// The scalar at `index` of valid UTF-8 (a &str's bytes).
fn decode_utf8(data: &[u8], index: usize) -> u32 {
    lead := data[index] as u32
    if lead < 0x80 {
        return lead
    }
    if lead < 0xe0 {
        return ((lead & 0x1f) << 6) | (data[index + 1] as u32 & 0x3f)
    }
    if lead < 0xf0 {
        return ((lead & 0x0f) << 12) | ((data[index + 1] as u32 & 0x3f) << 6) | (data[index + 2] as u32 & 0x3f)
    }
    return ((lead & 0x07) << 18) | ((data[index + 1] as u32 & 0x3f) << 12) | ((data[index + 2] as u32 & 0x3f) << 6) | (data[index + 3] as u32 & 0x3f)
}

// ---------------------------------------------------------------------------
// Canvas

// A drawing surface over borrowed pixel storage. Row y starts at byte
// y * stride. Every drawing call is limited to the clip rectangle, which
// starts as the whole canvas, and grows the dirty rectangle to cover the
// pixels it wrote. Displays present only the dirty part; take_dirty() reads
// and resets it.
//
// A canvas normally covers a surface from (0, 0). set_origin places it at
// another point of a larger surface, such as one band of a screen: drawing,
// clip, dirty and color_at coordinates are then surface coordinates, and the
// canvas stores only its width x height pixels from the origin.
pub struct Canvas {
    pixels: &mut[u8]
    width: u32
    height: u32
    stride: usize
    format: PixelFormat
    bytes_per_pixel: usize
    origin_x: i64
    origin_y: i64
    clip_left: i64
    clip_top: i64
    clip_right: i64
    clip_bottom: i64
    dirty_left: i64
    dirty_top: i64
    dirty_right: i64
    dirty_bottom: i64

    // A canvas with tightly packed rows. Fails with InvalidInput when a
    // dimension exceeds MAX_DIMENSION and BufferTooSmall when `pixels` is
    // shorter than bytes_needed(width, height, format). Extra bytes are unused.
    // The pixels keep their contents and the dirty rectangle starts empty.
    pub fn new(pixels: &mut[u8], width: u32, height: u32, format: PixelFormat) -> Canvas!Error from(pixels) {
        stride := row_bytes(width, &format)
        return Canvas.with_stride(pixels, width, height, stride, format)
    }
    // A canvas whose rows are `stride` bytes apart, for storage with padded
    // rows such as a window system's shared buffer. The stride must be at
    // least min_stride(width, format); `pixels` must hold stride * height bytes.
    pub fn with_stride(pixels: &mut[u8], width: u32, height: u32, stride: usize, format: PixelFormat) -> Canvas!Error from(pixels) {
        if width > MAX_DIMENSION || height > MAX_DIMENSION || stride < row_bytes(width, &format) {
            return err(Error.InvalidInput)
        }
        match num.checked_mul(stride, height as usize) {
            ok(total) => {
                if pixels.len < total {
                    return err(Error.BufferTooSmall)
                }
            }
            err(_) => {
                return err(Error.BufferTooSmall)
            }
        }
        bytes_per_pixel := format_bits(&format) / 8
        return ok(Canvas { pixels: pixels, width: width, height: height, stride: stride, format: format, bytes_per_pixel: bytes_per_pixel, origin_x: 0, origin_y: 0, clip_left: 0, clip_top: 0, clip_right: width as i64, clip_bottom: height as i64, dirty_left: 0, dirty_top: 0, dirty_right: 0, dirty_bottom: 0 })
    }

    pub fn width(&self) -> u32 {
        return self.width
    }
    pub fn height(&self) -> u32 {
        return self.height
    }
    pub fn size(&self) -> Size {
        return Size { width: self.width, height: self.height }
    }
    // The area of the surface the canvas covers: its size at its origin.
    pub fn bounds(&self) -> Rect {
        return Rect { x: self.origin_x as i32, y: self.origin_y as i32, width: self.width, height: self.height }
    }
    // Place the canvas's top-left pixel at (x, y) of the surface, each
    // clamped to +/-2^28. The pixels keep their contents, the clip resets to
    // the new bounds and the dirty rectangle to empty.
    pub fn set_origin(&mut self, x: i32, y: i32) {
        self.origin_x = clamp64(x as i64, -ORIGIN_LIMIT, ORIGIN_LIMIT)
        self.origin_y = clamp64(y as i64, -ORIGIN_LIMIT, ORIGIN_LIMIT)
        self.reset_clip()
        self.take_dirty()
    }
    pub fn format(&self) -> PixelFormat {
        match &self.format {
            PixelFormat.Rgba8888 => {
                return PixelFormat.Rgba8888
            }
            PixelFormat.Bgra8888 => {
                return PixelFormat.Bgra8888
            }
            PixelFormat.Rgb565 => {
                return PixelFormat.Rgb565
            }
            PixelFormat.Gray8 => {
                return PixelFormat.Gray8
            }
            PixelFormat.Mono1 => {
                return PixelFormat.Mono1
            }
        }
    }
    // Bytes from the start of one row to the next.
    pub fn stride(&self) -> usize {
        return self.stride
    }
    // The canvas bytes, stride * height of them, for presenting or encoding.
    // Byte offsets count from the canvas's top-left pixel, wherever its
    // origin is.
    pub fn pixels(&self) -> &[u8] from(self) {
        return &self.pixels[..self.stride * self.height as usize]
    }
    // The bytes of the canvas's row y, counted from its top edge (surface
    // row y + bounds().y), exactly min_stride(width, format) long.
    // Panics when y >= height.
    pub fn row(&self, y: u32) -> &[u8] from(self) {
        start := y as usize * self.stride
        return &self.pixels[start..start + row_bytes(self.width, &self.format)]
    }

    // -- Clipping ----------------------------------------------------------

    pub fn clip(&self) -> Rect {
        return edges_rect(self.clip_left, self.clip_top, self.clip_right, self.clip_bottom)
    }
    // Limit drawing to `rect`, intersected with the canvas.
    pub fn set_clip(&mut self, rect: Rect) {
        left := self.origin_x
        top := self.origin_y
        right := left + self.width as i64
        bottom := top + self.height as i64
        self.clip_left = clamp64(rect.x as i64, left, right)
        self.clip_top = clamp64(rect.y as i64, top, bottom)
        self.clip_right = clamp64(rect.right(), left, right)
        self.clip_bottom = clamp64(rect.bottom(), top, bottom)
        if self.clip_right < self.clip_left {
            self.clip_right = self.clip_left
        }
        if self.clip_bottom < self.clip_top {
            self.clip_bottom = self.clip_top
        }
    }
    pub fn reset_clip(&mut self) {
        self.clip_left = self.origin_x
        self.clip_top = self.origin_y
        self.clip_right = self.origin_x + self.width as i64
        self.clip_bottom = self.origin_y + self.height as i64
    }

    // -- Dirty tracking ----------------------------------------------------

    // The smallest rectangle covering every pixel drawn since the last
    // take_dirty(), or an empty rectangle.
    pub fn dirty(&self) -> Rect {
        return edges_rect(self.dirty_left, self.dirty_top, self.dirty_right, self.dirty_bottom)
    }
    // Return the dirty rectangle and reset it to empty.
    pub fn take_dirty(&mut self) -> Rect {
        result := self.dirty()
        self.dirty_left = 0
        self.dirty_top = 0
        self.dirty_right = 0
        self.dirty_bottom = 0
        return result
    }
    // Add `rect`, limited to the canvas, to the dirty rectangle: for pixels
    // changed through other means, or to retry a failed present.
    pub fn mark_dirty(&mut self, rect: Rect) {
        left := self.origin_x
        top := self.origin_y
        right := left + self.width as i64
        bottom := top + self.height as i64
        self.touch(clamp64(rect.x as i64, left, right), clamp64(rect.y as i64, top, bottom), clamp64(rect.right(), left, right), clamp64(rect.bottom(), top, bottom))
    }
    // Mark the whole canvas dirty.
    pub fn mark_all_dirty(&mut self) {
        left := self.origin_x
        top := self.origin_y
        right := left + self.width as i64
        bottom := top + self.height as i64
        self.touch(left, top, right, bottom)
    }
    fn touch(&mut self, left: i64, top: i64, right: i64, bottom: i64) {
        if left >= right || top >= bottom {
            return
        }
        if self.dirty_left >= self.dirty_right {
            self.dirty_left = left
            self.dirty_top = top
            self.dirty_right = right
            self.dirty_bottom = bottom
            return
        }
        if left < self.dirty_left {
            self.dirty_left = left
        }
        if top < self.dirty_top {
            self.dirty_top = top
        }
        if right > self.dirty_right {
            self.dirty_right = right
        }
        if bottom > self.dirty_bottom {
            self.dirty_bottom = bottom
        }
    }

    // -- Pixel access ------------------------------------------------------

    // The color at (x, y), or none outside the canvas. Formats without alpha
    // read as opaque; Rgb565 channels are widened by repeating their high bits.
    pub fn color_at(&self, x: i32, y: i32) -> Option<Color> {
        column := x as i64 - self.origin_x
        row := y as i64 - self.origin_y
        if column < 0 || row < 0 || column >= self.width as i64 || row >= self.height as i64 {
            return none
        }
        return some(self.read(column as usize, row as usize))
    }
    // Read and write one in-bounds pixel by surface coordinates.
    fn get(&self, x: i64, y: i64) -> Color {
        return self.read((x - self.origin_x) as usize, (y - self.origin_y) as usize)
    }
    fn put(&mut self, x: i64, y: i64, packed: u32) {
        column := (x - self.origin_x) as usize
        row := (y - self.origin_y) as usize
        self.write(column, row, packed)
    }
    fn read(&self, x: usize, y: usize) -> Color {
        row := y * self.stride
        match &self.format {
            PixelFormat.Rgba8888 => {
                value := self.load(row + x * 4)
                return (value & 0xff00ff00) | ((value & 255) << 16) | ((value >> 16) & 255)
            }
            PixelFormat.Bgra8888 => {
                return self.load(row + x * 4)
            }
            PixelFormat.Rgb565 => {
                i := row + x * 2
                value := ((self.pixels[i] as u32) << 8) | (self.pixels[i + 1] as u32)
                r := value >> 11
                g := (value >> 5) & 63
                b := value & 31
                return 0xff000000 | (((r << 3) | (r >> 2)) << 16) | (((g << 2) | (g >> 4)) << 8) | ((b << 3) | (b >> 2))
            }
            PixelFormat.Gray8 => {
                v := self.pixels[row + x] as u32
                return 0xff000000 | (v << 16) | (v << 8) | v
            }
            PixelFormat.Mono1 => {
                if (self.pixels[row + x / 8] & (0x80u8 >> ((x % 8) as u8))) != 0 {
                    return WHITE
                }
                return BLACK
            }
        }
    }
    // Store already encoded bytes for one in-bounds pixel.
    fn write(&mut self, x: usize, y: usize, packed: u32) {
        i := y * self.stride + x * self.bytes_per_pixel
        if self.bytes_per_pixel == 4 {
            self.store(i, packed)
        } else if self.bytes_per_pixel == 2 {
            self.pixels[i] = (packed & 255) as u8
            self.pixels[i + 1] = (packed >> 8) as u8
        } else if self.bytes_per_pixel == 1 {
            self.pixels[i] = packed as u8
        } else {
            index := y * self.stride + x / 8
            mask := 0x80u8 >> ((x % 8) as u8)
            if packed != 0 {
                self.pixels[index] = self.pixels[index] | mask
            } else {
                self.pixels[index] = self.pixels[index] & (255 - mask)
            }
        }
    }
    // Load and store the 32-bit pixel at byte offset i of a 4-byte format,
    // with byte 0 in the low bits.
    fn load(&self, i: usize) -> u32 {
        p := &self.pixels[i..i + 4]
        return (p[0] as u32) | ((p[1] as u32) << 8) | ((p[2] as u32) << 16) | ((p[3] as u32) << 24)
    }
    fn store(&mut self, i: usize, value: u32) {
        p := &mut self.pixels[i..i + 4]
        p[0] = (value & 255) as u8
        p[1] = ((value >> 8) & 255) as u8
        p[2] = ((value >> 16) & 255) as u8
        p[3] = (value >> 24) as u8
    }
    // Composite `color` over the in-bounds pixel at storage position
    // (x, y). Opaque 32-bit pixels blend in their stored layout without
    // decoding; everything else goes through over().
    fn composite(&mut self, x: usize, y: usize, color: Color) {
        if self.bytes_per_pixel == 4 {
            i := y * self.stride + x * 4
            below := self.load(i)
            if (below >> 24) == 255 {
                a := color >> 24
                top := encode(&self.format, color)
                self.store(i, blend_opaque(tint_low(top, a), tint_high(top, a), 255 - a, below))
                return
            }
        }
        below := self.read(x, y)
        blended := encode(&self.format, over(color, below))
        self.write(x, y, blended)
    }
    // Fill columns left..right of `row`, all inside the canvas.
    //
    // The whole-byte loops store through a local subslice, not through
    // self.pixels: a store via self.pixels could, for all the optimizer
    // knows, overwrite the canvas itself, so it would reload the slice and
    // recheck bounds on every byte instead of turning the loop into wide
    // stores.
    fn run(&mut self, left: usize, right: usize, row: usize, packed: u32) {
        start := row * self.stride
        bpp := self.bytes_per_pixel
        if bpp == 4 {
            span := &mut self.pixels[start + left * 4..start + right * 4]
            b0 := (packed & 255) as u8
            b1 := ((packed >> 8) & 255) as u8
            b2 := ((packed >> 16) & 255) as u8
            b3 := (packed >> 24) as u8
            for p in 0usize..span.len / 4 {
                span[p * 4] = b0
                span[p * 4 + 1] = b1
                span[p * 4 + 2] = b2
                span[p * 4 + 3] = b3
            }
        } else if bpp == 2 {
            span := &mut self.pixels[start + left * 2..start + right * 2]
            b0 := (packed & 255) as u8
            b1 := (packed >> 8) as u8
            for p in 0usize..span.len / 2 {
                span[p * 2] = b0
                span[p * 2 + 1] = b1
            }
        } else if bpp == 1 {
            bytes.fill(&mut self.pixels[start + left..start + right], packed as u8)
        } else {
            x := left
            for x < right && x % 8 != 0 {
                self.write(x, row, packed)
                x += 1
            }
            full := 0u8
            if packed != 0 {
                full = 255
            }
            for x + 8 <= right {
                self.pixels[start + x / 8] = full
                x += 8
            }
            for x < right {
                self.write(x, row, packed)
                x += 1
            }
        }
    }
    // Fill columns left..right of `row`, clipped, and mark them dirty.
    fn hline(&mut self, left: i64, right: i64, row: i64, packed: u32) {
        if row < self.clip_top || row >= self.clip_bottom {
            return
        }
        l := max64(left, self.clip_left)
        r := min64(right, self.clip_right)
        if l >= r {
            return
        }
        ox := self.origin_x
        oy := self.origin_y
        self.run((l - ox) as usize, (r - ox) as usize, (row - oy) as usize, packed)
        self.touch(l, row, r, row + 1)
    }
    // Set one pixel, clipped, and mark it dirty.
    fn dot(&mut self, x: i64, y: i64, packed: u32) {
        if x < self.clip_left || x >= self.clip_right || y < self.clip_top || y >= self.clip_bottom {
            return
        }
        self.put(x, y, packed)
        self.touch(x, y, x + 1, y + 1)
    }
    // Fill an edge-bounded area, clipped.
    fn block(&mut self, left: i64, top: i64, right: i64, bottom: i64, packed: u32) {
        t := max64(top, self.clip_top)
        b := min64(bottom, self.clip_bottom)
        l := max64(left, self.clip_left)
        r := min64(right, self.clip_right)
        if l >= r || t >= b {
            return
        }
        ox := self.origin_x
        oy := self.origin_y
        for row in t..b {
            self.run((l - ox) as usize, (r - ox) as usize, (row - oy) as usize, packed)
        }
        self.touch(l, t, r, b)
    }
    // Draw the part of the outer span outer_left..=outer_right not covered
    // by the inner span, keeping at least one pixel on each side.
    // `inner_left > inner_right` means no inner span on this row.
    fn ring_row(&mut self, row: i64, outer_left: i64, outer_right: i64, inner_left: i64, inner_right: i64, packed: u32) {
        if inner_left > inner_right {
            self.hline(outer_left, outer_right + 1, row, packed)
            return
        }
        self.hline(outer_left, max64(inner_left, outer_left + 1), row, packed)
        self.hline(min64(inner_right + 1, outer_right), outer_right + 1, row, packed)
    }

    // -- Drawing -----------------------------------------------------------

    // Fill the clip rectangle (the whole canvas unless set_clip was called).
    pub fn clear(&mut self, color: Color) {
        packed := encode(&self.format, color)
        left := self.clip_left
        top := self.clip_top
        right := self.clip_right
        bottom := self.clip_bottom
        self.block(left, top, right, bottom, packed)
    }
    // Set one pixel. Colors are stored, not blended; see blend_rect.
    pub fn pixel(&mut self, x: i32, y: i32, color: Color) {
        packed := encode(&self.format, color)
        self.dot(x as i64, y as i64, packed)
    }
    // A one pixel wide line including both end points. Pixel rows (or
    // columns, for steep lines) follow the exact line, rounding half up.
    pub fn line(&mut self, x0: i32, y0: i32, x1: i32, y1: i32, color: Color) {
        packed := encode(&self.format, color)
        self.segment(coordinate(x0), coordinate(y0), coordinate(x1), coordinate(y1), packed)
    }
    fn segment(&mut self, ax: i64, ay: i64, bx: i64, by: i64, packed: u32) {
        dx := bx - ax
        dy := by - ay
        if dx == 0 && dy == 0 {
            self.dot(ax, ay, packed)
            return
        }
        if dx == 0 {
            self.block(ax, min64(ay, by), ax + 1, max64(ay, by) + 1, packed)
            return
        }
        if dy == 0 {
            self.hline(min64(ax, bx), max64(ax, bx) + 1, ay, packed)
            return
        }
        steep := abs64(dy) > abs64(dx)
        // Walk the major axis m; the minor axis n follows.
        m0 := ax
        n0 := ay
        major := dx
        minor := dy
        m_low := self.clip_left
        m_high := self.clip_right
        n_low := self.clip_top
        n_high := self.clip_bottom
        if steep {
            m0 = ay
            n0 = ax
            major = dy
            minor = dx
            m_low = self.clip_top
            m_high = self.clip_bottom
            n_low = self.clip_left
            n_high = self.clip_right
        }
        length := abs64(major)
        rise := abs64(minor)
        m_step := 1i64
        if major < 0 {
            m_step = -1
        }
        n_step := 1i64
        if minor < 0 {
            n_step = -1
        }
        // Steps k with m0 + m_step * k inside the clip on the major axis.
        first := 0i64
        last := length
        if m_step > 0 {
            first = max64(first, m_low - m0)
            last = min64(last, m_high - 1 - m0)
        } else {
            first = max64(first, m0 - (m_high - 1))
            last = min64(last, m0 - m_low)
        }
        if first > last {
            return
        }
        // n(k) = n0 + n_step * floor((2 * rise * k + length) / (2 * length))
        span := 2 * length
        numerator := 2 * rise * first + length
        quotient := numerator / span
        remainder := numerator % span
        for k in first..last + 1 {
            n := n0 + n_step * quotient
            if (n_step > 0 && n >= n_high) || (n_step < 0 && n < n_low) {
                return
            }
            if n >= n_low && n < n_high {
                m := m0 + m_step * k
                if steep {
                    self.put(n, m, packed)
                    self.touch(n, m, n + 1, m + 1)
                } else {
                    self.put(m, n, packed)
                    self.touch(m, n, m + 1, n + 1)
                }
            }
            remainder += 2 * rise
            if remainder >= span {
                remainder -= span
                quotient += 1
            }
        }
    }
    // The one pixel wide outline of a width x height rectangle.
    pub fn rect(&mut self, x: i32, y: i32, width: u32, height: u32, color: Color) {
        if width == 0 || height == 0 {
            return
        }
        packed := encode(&self.format, color)
        left := x as i64
        top := y as i64
        right := left + width as i64
        bottom := top + height as i64
        self.hline(left, right, top, packed)
        if height > 1 {
            self.hline(left, right, bottom - 1, packed)
        }
        self.block(left, top + 1, left + 1, bottom - 1, packed)
        if width > 1 {
            self.block(right - 1, top + 1, right, bottom - 1, packed)
        }
    }
    pub fn fill_rect(&mut self, x: i32, y: i32, width: u32, height: u32, color: Color) {
        packed := encode(&self.format, color)
        self.block(x as i64, y as i64, x as i64 + width as i64, y as i64 + height as i64, packed)
    }
    // fill_rect for a Rect value, such as the bounds text() returned.
    pub fn fill(&mut self, rect: Rect, color: Color) {
        self.fill_rect(rect.x, rect.y, rect.width, rect.height, color)
    }
    // Composite `color` over the pixels of a rectangle using its alpha.
    pub fn blend_rect(&mut self, x: i32, y: i32, width: u32, height: u32, color: Color) {
        a := color >> 24
        if a == 255 {
            self.fill_rect(x, y, width, height, color)
            return
        }
        if a == 0 {
            return
        }
        t := max64(y as i64, self.clip_top)
        b := min64(y as i64 + height as i64, self.clip_bottom)
        l := max64(x as i64, self.clip_left)
        r := min64(x as i64 + width as i64, self.clip_right)
        if l >= r || t >= b {
            return
        }
        ox := self.origin_x
        oy := self.origin_y
        // UI backgrounds repeat, so remember the last pixel blended.
        last_below := 0u32
        last_result := 0u32
        have_last := false
        if self.bytes_per_pixel == 4 {
            // Premultiply once; opaque pixels then blend in storage layout.
            top := encode(&self.format, color)
            low := tint_low(top, a)
            high := tint_high(top, a)
            inverse := 255 - a
            for row in t..b {
                y := (row - oy) as usize
                i := y * self.stride + (l - ox) as usize * 4
                for column in l..r {
                    below := self.load(i)
                    if !have_last || below != last_below {
                        last_below = below
                        have_last = true
                        if (below >> 24) == 255 {
                            last_result = blend_opaque(low, high, inverse, below)
                        } else {
                            under := self.read((column - ox) as usize, y)
                            last_result = encode(&self.format, over(color, under))
                        }
                    }
                    self.store(i, last_result)
                    i += 4
                }
            }
        } else {
            // Rgb565, Gray8 and Mono1 read as opaque colors.
            for row in t..b {
                y := (row - oy) as usize
                for column in l..r {
                    x := (column - ox) as usize
                    below := self.read(x, y)
                    if !have_last || below != last_below {
                        last_below = below
                        have_last = true
                        last_result = encode(&self.format, over(color, below))
                    }
                    self.write(x, y, last_result)
                }
            }
        }
        self.touch(l, t, r, b)
    }
    // A rectangle outline with corners rounded to `radius`, limited to half
    // the shorter side.
    pub fn round_rect(&mut self, x: i32, y: i32, width: u32, height: u32, radius: u32, color: Color) {
        if width == 0 || height == 0 {
            return
        }
        packed := encode(&self.format, color)
        r := corner_radius(width, height, radius)
        top := y as i64
        bottom := top + height as i64
        first := max64(top, self.clip_top)
        last := min64(bottom, self.clip_bottom)
        for row in first..last {
            outer := corner_inset(row - top, height as i64, r)
            ol := x as i64 + outer
            or := x as i64 + width as i64 - 1 - outer
            if width < 3 || height < 3 || row == top || row == bottom - 1 {
                self.hline(ol, or + 1, row, packed)
            } else {
                inner_r := r
                if inner_r > 0 {
                    inner_r -= 1
                }
                inner := corner_inset(row - top - 1, height as i64 - 2, inner_r)
                self.ring_row(row, ol, or, x as i64 + 1 + inner, x as i64 + width as i64 - 2 - inner, packed)
            }
        }
    }
    pub fn fill_round_rect(&mut self, x: i32, y: i32, width: u32, height: u32, radius: u32, color: Color) {
        if width == 0 || height == 0 {
            return
        }
        packed := encode(&self.format, color)
        r := corner_radius(width, height, radius)
        top := y as i64
        first := max64(top, self.clip_top)
        last := min64(top + height as i64, self.clip_bottom)
        for row in first..last {
            inset := corner_inset(row - top, height as i64, r)
            self.hline(x as i64 + inset, x as i64 + width as i64 - inset, row, packed)
        }
    }
    // A one pixel wide circle outline. Radius r spans 2r + 1 pixels centred
    // on (cx, cy) and covers the pixel centres within r + 1/2 of it.
    pub fn circle(&mut self, cx: i32, cy: i32, radius: u32, color: Color) {
        packed := encode(&self.format, color)
        r := radius as i64
        x := cx as i64
        y := cy as i64
        first := max64(y - r, self.clip_top)
        last := min64(y + r + 1, self.clip_bottom)
        for row in first..last {
            dy := abs64(row - y)
            outer := circle_half(r as u64, dy as u64)
            if dy < r {
                inner := circle_half((r - 1) as u64, dy as u64)
                self.ring_row(row, x - outer, x + outer, x - inner, x + inner, packed)
            } else {
                self.hline(x - outer, x + outer + 1, row, packed)
            }
        }
    }
    pub fn fill_circle(&mut self, cx: i32, cy: i32, radius: u32, color: Color) {
        packed := encode(&self.format, color)
        r := radius as i64
        x := cx as i64
        y := cy as i64
        first := max64(y - r, self.clip_top)
        last := min64(y + r + 1, self.clip_bottom)
        for row in first..last {
            half := circle_half(r as u64, abs64(row - y) as u64)
            self.hline(x - half, x + half + 1, row, packed)
        }
    }
    // An axis-aligned ellipse outline spanning 2rx + 1 by 2ry + 1 pixels.
    // Radii above 16383 are clamped.
    pub fn ellipse(&mut self, cx: i32, cy: i32, rx: u32, ry: u32, color: Color) {
        if rx == ry {
            self.circle(cx, cy, rx, color)
            return
        }
        packed := encode(&self.format, color)
        a := num.min(rx as usize, ELLIPSE_LIMIT as usize) as u64
        b := num.min(ry as usize, ELLIPSE_LIMIT as usize) as u64
        x := cx as i64
        y := cy as i64
        first := max64(y - b as i64, self.clip_top)
        last := min64(y + b as i64 + 1, self.clip_bottom)
        for row in first..last {
            dy := abs64(row - y) as u64
            outer := ellipse_half(a, b, dy)
            if a > 0 && b > 0 && dy < b {
                inner := ellipse_half(a - 1, b - 1, dy)
                self.ring_row(row, x - outer, x + outer, x - inner, x + inner, packed)
            } else {
                self.hline(x - outer, x + outer + 1, row, packed)
            }
        }
    }
    pub fn fill_ellipse(&mut self, cx: i32, cy: i32, rx: u32, ry: u32, color: Color) {
        if rx == ry {
            self.fill_circle(cx, cy, rx, color)
            return
        }
        packed := encode(&self.format, color)
        a := num.min(rx as usize, ELLIPSE_LIMIT as usize) as u64
        b := num.min(ry as usize, ELLIPSE_LIMIT as usize) as u64
        x := cx as i64
        y := cy as i64
        first := max64(y - b as i64, self.clip_top)
        last := min64(y + b as i64 + 1, self.clip_bottom)
        for row in first..last {
            half := ellipse_half(a, b, abs64(row - y) as u64)
            self.hline(x - half, x + half + 1, row, packed)
        }
    }
    // The closed outline through the vertices in `coordinates`, given as x, y
    // pairs (x0, y0, x1, y1, ...): a line from each vertex to the next and
    // from the last back to the first. A trailing unpaired value is ignored.
    pub fn polygon(&mut self, coordinates: &[i32], color: Color) {
        vertices := coordinates.len / 2
        if vertices == 0 {
            return
        }
        packed := encode(&self.format, color)
        if vertices == 1 {
            self.dot(coordinates[0] as i64, coordinates[1] as i64, packed)
            return
        }
        for i in 0usize..vertices {
            next := (i + 1) % vertices
            self.segment(coordinate(coordinates[2 * i]), coordinate(coordinates[2 * i + 1]), coordinate(coordinates[2 * next]), coordinate(coordinates[2 * next + 1]), packed)
            if vertices == 2 {
                return
            }
        }
    }
    // Fill the inside of the polygon through `coordinates` (x, y pairs) by
    // the even-odd rule: a pixel is filled when its centre is enclosed by an
    // odd number of edges. Self-intersecting outlines and holes traced in
    // either direction work. Needs at least three vertices.
    pub fn fill_polygon(&mut self, coordinates: &[i32], color: Color) {
        vertices := coordinates.len / 2
        if vertices < 3 {
            return
        }
        packed := encode(&self.format, color)
        top := COORD_LIMIT
        bottom := -COORD_LIMIT
        for i in 0usize..vertices {
            y := coordinate(coordinates[2 * i + 1])
            top = min64(top, y)
            bottom = max64(bottom, y)
        }
        first := max64(top, self.clip_top)
        last := min64(bottom, self.clip_bottom)
        keys := [0i64; POLYGON_CROSSINGS]
        for row in first..last {
            count := 0usize
            overflow := false
            for i in 0usize..vertices {
                match crossing(coordinates, i, row) {
                    some(key) => {
                        if count < POLYGON_CROSSINGS {
                            // Clamping keeps the order and fits the clip.
                            keys[count] = clamp64(key, self.clip_left - 1, self.clip_right + 1)
                            count += 1
                        } else {
                            overflow = true
                        }
                    }
                    none => {}
                }
            }
            if overflow {
                self.polygon_row_unbuffered(coordinates, row, packed)
            } else {
                for i in 1usize..count {
                    key := keys[i]
                    j := i
                    for j > 0 && keys[j - 1] > key {
                        keys[j] = keys[j - 1]
                        j -= 1
                    }
                    keys[j] = key
                }
                pair := 0usize
                for pair + 1 < count {
                    self.hline(keys[pair], keys[pair + 1], row, packed)
                    pair += 2
                }
            }
        }
    }
    // One row of fill_polygon with more crossings than its buffer: select
    // crossings in (column, edge) order without storing them.
    fn polygon_row_unbuffered(&mut self, coordinates: &[i32], row: i64, packed: u32) {
        vertices := coordinates.len / 2
        last_key := 0i64
        last_edge := 0usize
        started := false
        inside := false
        start := 0i64
        for {
            found := false
            best_key := 0i64
            best_edge := 0usize
            for i in 0usize..vertices {
                match crossing(coordinates, i, row) {
                    some(key) => {
                        after := !started || key > last_key || (key == last_key && i > last_edge)
                        better := !found || key < best_key || (key == best_key && i < best_edge)
                        if after && better {
                            found = true
                            best_key = key
                            best_edge = i
                        }
                    }
                    none => {}
                }
            }
            if !found {
                return
            }
            if inside {
                self.hline(start, best_key, row, packed)
            } else {
                start = best_key
            }
            inside = !inside
            started = true
            last_key = best_key
            last_edge = best_edge
        }
    }
    // Copy all of `source` with its top-left corner at (x, y), converting
    // the pixel format if needed. Alpha is copied, not blended.
    pub fn blit(&mut self, source: &Canvas, x: i32, y: i32) {
        self.blit_region(source, source.bounds(), x, y)
    }
    // Copy `region` of `source`, in the source's coordinates, with its
    // top-left corner at (x, y).
    pub fn blit_region(&mut self, source: &Canvas, region: Rect, x: i32, y: i32) {
        self.copy_from(source, region, x, y, false)
    }
    // Composite all of `source` over this canvas at (x, y) using the source
    // alpha (source-over). Sources without alpha are opaque, like blit.
    pub fn blend(&mut self, source: &Canvas, x: i32, y: i32) {
        self.blend_region(source, source.bounds(), x, y)
    }
    pub fn blend_region(&mut self, source: &Canvas, region: Rect, x: i32, y: i32) {
        self.copy_from(source, region, x, y, true)
    }
    fn copy_from(&mut self, source: &Canvas, region: Rect, x: i32, y: i32, blend: bool) {
        // Source rectangle limited to the source canvas.
        sl := max64(region.x as i64, source.origin_x)
        st := max64(region.y as i64, source.origin_y)
        sr := min64(region.right(), source.origin_x + source.width as i64)
        sb := min64(region.bottom(), source.origin_y + source.height as i64)
        // Where the source's top-left lands, shifted by any trimmed margin.
        dl := x as i64 + (sl - region.x as i64)
        dt := y as i64 + (st - region.y as i64)
        // Destination rectangle limited to the clip.
        l := max64(dl, self.clip_left)
        t := max64(dt, self.clip_top)
        r := min64(dl + (sr - sl), self.clip_right)
        b := min64(dt + (sb - st), self.clip_bottom)
        if l >= r || t >= b {
            return
        }
        // Byte copies work for equal whole-byte formats; Mono1 bits may be
        // misaligned between the canvases.
        same := self.bytes_per_pixel > 0 && same_format(&self.format, &source.format)
        has_alpha := format_bits(&source.format) == 32
        for row in t..b {
            // Source storage position of destination (l, row).
            source_row := (row - dt + st - source.origin_y) as usize
            source_column := (l - dl + sl - source.origin_x) as usize
            if same && (!blend || !has_alpha) {
                bpp := self.bytes_per_pixel
                source_start := source_row * source.stride + source_column * bpp
                to := (row - self.origin_y) as usize * self.stride + (l - self.origin_x) as usize * bpp
                count := (r - l) as usize * bpp
                // Local subslices, as in run(), let this become a memcpy.
                origin := &source.pixels[source_start..source_start + count]
                into := &mut self.pixels[to..to + count]
                for i in 0usize..count {
                    into[i] = origin[i]
                }
            } else {
                for column in l..r {
                    color := source.read(source_column + (column - l) as usize, source_row)
                    if blend && has_alpha {
                        a := color >> 24
                        if a == 255 {
                            converted := encode(&self.format, color)
                            self.put(column, row, converted)
                        } else if a != 0 {
                            cx := (column - self.origin_x) as usize
                            cy := (row - self.origin_y) as usize
                            self.composite(cx, cy, color)
                        }
                    } else {
                        converted := encode(&self.format, color)
                        self.put(column, row, converted)
                    }
                }
            }
        }
        self.touch(l, t, r, b)
    }
    // Draw `text` with its top-left corner at (x, y) and return the area its
    // character cells cover, the same size font.measure(text) reports, even
    // where clipping hid them. Only set glyph pixels are drawn; fill the
    // returned bounds first for an opaque background. "\n" returns to x on
    // the next line and "\r" is ignored.
    pub fn text(&mut self, font: &Font, x: i32, y: i32, text: &str, color: Color) -> Rect {
        packed := encode(&self.format, color)
        data := mem.str_bytes(text)
        advance := font.advance() as i64
        line_height := font.line_height() as i64
        pen_x := x as i64
        pen_y := y as i64
        index := 0usize
        for index < data.len {
            code := decode_utf8(data, index)
            index += utf8_length(data[index])
            if code == 10 {
                pen_x = x as i64
                pen_y += line_height
            } else if code != 13 {
                self.glyph(font, pen_x, pen_y, code, packed)
                pen_x += advance
            }
        }
        size := font.measure(text)
        return Rect { x: x, y: y, width: size.width, height: size.height }
    }
    fn glyph(&mut self, font: &Font, x: i64, y: i64, code: u32, packed: u32) {
        scale := font.scale as i64
        width := font.glyph_width as i64
        height := font.glyph_height as i64
        if x >= self.clip_right || y >= self.clip_bottom || x + width * scale <= self.clip_left || y + height * scale <= self.clip_top {
            return
        }
        if !font.has_glyph(code) {
            // Replacement box: the outline of the cell minus its spacing.
            box_width := max64(width - 1, 1) * scale
            box_height := max64(height - 1, 1) * scale
            self.block(x, y, x + box_width, y + scale, packed)
            self.block(x, y + box_height - scale, x + box_width, y + box_height, packed)
            self.block(x, y, x + scale, y + box_height, packed)
            self.block(x + box_width - scale, y, x + box_width, y + box_height, packed)
            return
        }
        row_bytes := (font.glyph_width as usize + 7) / 8
        base := (code - font.first) as usize * row_bytes * font.glyph_height as usize
        for gy in 0i64..height {
            row := base + gy as usize * row_bytes
            gx := 0i64
            for gx < width {
                if glyph_bit(font.bitmap, row, gx as usize) {
                    start := gx
                    for gx < width && glyph_bit(font.bitmap, row, gx as usize) {
                        gx += 1
                    }
                    self.block(x + start * scale, y + gy * scale, x + gx * scale, y + (gy + 1) * scale, packed)
                } else {
                    gx += 1
                }
            }
        }
    }

    // -- Antialiased and gradient drawing ---------------------------------
    //
    // These calls composite over the existing pixels: each pixel is blended
    // with the color by the fraction of it the shape covers, times the
    // color's alpha. Coordinates follow the integer primitives: shapes given
    // by pixel centres (lines, circles, ellipses) cover the same pixels as
    // their integer counterparts, with partial coverage at the edges.

    // Fill `outline` by `rule` with `color`.
    pub fn fill_outline<O: Outline>(&mut self, outline: &O, rule: FillRule, color: Color) {
        unused := Gradient.linear(0, 0, 0, 0, color, color)
        self.rasterize(outline, rule, color, &unused, false)
    }
    // Fill a stored path by `rule` with `color`.
    pub fn fill_path(&mut self, path: &Path, rule: FillRule, color: Color) {
        self.fill_outline(path, rule, color)
    }
    // Fill `outline` by `rule` with a gradient.
    pub fn gradient_outline<O: Outline>(&mut self, outline: &O, rule: FillRule, gradient: &Gradient) {
        self.rasterize(outline, rule, 0, gradient, true)
    }
    pub fn gradient_path(&mut self, path: &Path, rule: FillRule, gradient: &Gradient) {
        self.gradient_outline(path, rule, gradient)
    }
    // Fill a width x height rectangle with a gradient.
    pub fn gradient_rect(&mut self, x: i32, y: i32, width: u32, height: u32, gradient: &Gradient) {
        t := max64(y as i64, self.clip_top)
        b := min64(y as i64 + height as i64, self.clip_bottom)
        l := max64(x as i64, self.clip_left)
        r := min64(x as i64 + width as i64, self.clip_right)
        if l >= r || t >= b {
            return
        }
        if gradient.rows_constant() && !gradient.dithers(&self.format) {
            // Vertical gradients: one color per row, filled or blended whole.
            width := (r - l) as u32
            for row in t..b {
                color := gradient.color_at(l as i32, row as i32)
                self.blend_rect(l as i32, row as i32, width, 1, color)
            }
            self.touch(l, t, r, b)
            return
        }
        ox := self.origin_x
        oy := self.origin_y
        wide := self.bytes_per_pixel == 4
        // Runs of one opaque color encode once.
        last_paint := 0u32
        last_packed := encode(&self.format, 0)
        for row in t..b {
            y := (row - oy) as usize
            i := y * self.stride + (l - ox) as usize * self.bytes_per_pixel
            walk := gradient.walk(l, row)
            for column in l..r {
                color := gradient.walk_color(&mut walk)
                paint := gradient.dithered(color, column, row, &self.format)
                a := paint >> 24
                if a == 255 {
                    if paint != last_paint {
                        last_paint = paint
                        last_packed = encode(&self.format, paint)
                    }
                    if wide {
                        self.store(i, last_packed)
                    } else {
                        self.write((column - ox) as usize, y, last_packed)
                    }
                } else if a != 0 {
                    self.composite((column - ox) as usize, y, paint)
                }
                i += self.bytes_per_pixel
                gradient.advance(&mut walk)
            }
        }
        self.touch(l, t, r, b)
    }
    // A one pixel wide line between the centres of pixels (x0, y0) and
    // (x1, y1), with square ends reaching the outer edges of both pixels.
    // Horizontal and vertical lines cover exactly the pixels line() draws.
    pub fn aa_line(&mut self, x0: i32, y0: i32, x1: i32, y1: i32, color: Color) {
        shape := StrokeShape { x0: centre(x0), y0: centre(y0), x1: centre(x1), y1: centre(y1), half: 128, round: false }
        self.fill_outline(&shape, FillRule.NonZero, color)
    }
    // A line `width` pixels wide between the centres of pixels (x0, y0) and
    // (x1, y1), with round ends centred on them.
    pub fn aa_thick_line(&mut self, x0: i32, y0: i32, x1: i32, y1: i32, width: u32, color: Color) {
        if width == 0 {
            return
        }
        half := min64(width as i64, AA_PIXEL_LIMIT) * 128
        shape := StrokeShape { x0: centre(x0), y0: centre(y0), x1: centre(x1), y1: centre(y1), half: half, round: true }
        self.fill_outline(&shape, FillRule.NonZero, color)
    }
    // A disk of radius + 1/2 pixels around the centre of pixel (cx, cy),
    // the area fill_circle approximates with whole pixels.
    pub fn aa_fill_circle(&mut self, cx: i32, cy: i32, radius: u32, color: Color) {
        self.aa_fill_ellipse(cx, cy, radius, radius, color)
    }
    // The one pixel wide ring between radius - 1/2 and radius + 1/2, the
    // area circle() approximates.
    pub fn aa_circle(&mut self, cx: i32, cy: i32, radius: u32, color: Color) {
        self.aa_ellipse(cx, cy, radius, radius, color)
    }
    pub fn aa_fill_ellipse(&mut self, cx: i32, cy: i32, rx: u32, ry: u32, color: Color) {
        shape := EllipseShape { cx: centre(cx), cy: centre(cy), rx: aa_radius(rx), ry: aa_radius(ry), inner_rx: 0, inner_ry: 0, ring: false }
        self.fill_outline(&shape, FillRule.NonZero, color)
    }
    pub fn aa_ellipse(&mut self, cx: i32, cy: i32, rx: u32, ry: u32, color: Color) {
        outer_x := aa_radius(rx)
        outer_y := aa_radius(ry)
        shape := EllipseShape { cx: centre(cx), cy: centre(cy), rx: outer_x, ry: outer_y, inner_rx: outer_x - 256, inner_ry: outer_y - 256, ring: true }
        self.fill_outline(&shape, FillRule.NonZero, color)
    }
    // A width x height rectangle with exactly round corners of `radius`
    // pixels, limited to half the shorter side.
    pub fn aa_fill_round_rect(&mut self, x: i32, y: i32, width: u32, height: u32, radius: u32, color: Color) {
        left := corner(x)
        top := corner(y)
        shape := RoundRectShape { left: left, top: top, right: left + min64(width as i64, AA_PIXEL_LIMIT) * 256, bottom: top + min64(height as i64, AA_PIXEL_LIMIT) * 256, radius: min64(radius as i64, AA_PIXEL_LIMIT) * 256, inset: 256, ring: false }
        self.fill_outline(&shape, FillRule.NonZero, color)
    }
    // The one pixel wide outline along the inside of aa_fill_round_rect.
    pub fn aa_round_rect(&mut self, x: i32, y: i32, width: u32, height: u32, radius: u32, color: Color) {
        left := corner(x)
        top := corner(y)
        shape := RoundRectShape { left: left, top: top, right: left + min64(width as i64, AA_PIXEL_LIMIT) * 256, bottom: top + min64(height as i64, AA_PIXEL_LIMIT) * 256, radius: min64(radius as i64, AA_PIXEL_LIMIT) * 256, inset: 256, ring: true }
        self.fill_outline(&shape, FillRule.NonZero, color)
    }
    // The polygon through `coordinates` (x, y pairs of pixel corners, as for
    // fill_polygon), filled by the even-odd rule. Vertices are clamped to
    // +/-2^21. Needs at least three vertices.
    pub fn aa_fill_polygon(&mut self, coordinates: &[i32], color: Color) {
        if coordinates.len / 2 < 3 {
            return
        }
        shape := PolygonShape { coordinates: coordinates }
        self.fill_outline(&shape, FillRule.EvenOdd, color)
    }
    // Composite `color`, with its alpha scaled by coverage (0 to 255), over
    // the in-bounds pixel (x, y).
    fn paint_pixel(&mut self, x: i64, y: i64, color: Color, coverage: u32) {
        a := div255((color >> 24) * coverage)
        if a == 0 {
            return
        }
        if a == 255 {
            opaque := encode(&self.format, color)
            self.put(x, y, opaque)
            return
        }
        column := (x - self.origin_x) as usize
        row := (y - self.origin_y) as usize
        self.composite(column, row, with_alpha(color, a as u8))
    }
    fn rasterize<O: Outline>(&mut self, outline: &O, rule: FillRule, color: Color, gradient: &Gradient, shaded: bool) {
        even_odd := false
        match rule {
            FillRule.NonZero => {}
            FillRule.EvenOdd => {
                even_odd = true
            }
        }
        pen := Pen.new()
        outline.trace(&mut pen)
        pen.close()
        if !pen.any {
            return
        }
        top := max64(floor_div(pen.min_y, 256), self.clip_top)
        bottom := min64(ceil_div(pen.max_y, 256), self.clip_bottom)
        left := max64(floor_div(pen.min_x, 256), self.clip_left)
        right := min64(ceil_div(pen.max_x, 256), self.clip_right)
        if left >= right || top >= bottom {
            return
        }
        opaque := !shaded && (color >> 24) == 255
        packed := encode(&self.format, color)
        for row in top..bottom {
            // A solid fill's walk is constant: `unused` has no extent.
            walk := gradient.walk(left, row)
            start := left
            for start < right {
                end := min64(start + CHUNK as i64, right)
                pen.begin(row, start, end)
                outline.trace(&mut pen)
                pen.close()
                // Resolve the pass: running sums of the cells are coverage.
                sum := pen.carry
                written_left := end
                written_right := start
                for column in start..end {
                    index := (column - start) as usize
                    sum += pen.cells[index]
                    pen.cells[index] = 0
                    coverage := abs64(sum)
                    if even_odd {
                        coverage = coverage % (2 * FULL)
                        if coverage > FULL {
                            coverage = 2 * FULL - coverage
                        }
                    } else if coverage > FULL {
                        coverage = FULL
                    }
                    level := ((coverage * 255 + 32768) >> 16) as u32
                    if level > 0 {
                        if level == 255 && opaque {
                            self.put(column, row, packed)
                        } else if shaded {
                            sampled := gradient.walk_color(&mut walk)
                            paint := gradient.dithered(sampled, column, row, &self.format)
                            self.paint_pixel(column, row, paint, level)
                        } else {
                            self.paint_pixel(column, row, color, level)
                        }
                        written_left = min64(written_left, column)
                        written_right = max64(written_right, column + 1)
                    }
                    if shaded {
                        gradient.advance(&mut walk)
                    }
                }
                self.touch(written_left, row, written_right, row + 1)
                start = end
            }
        }
    }

    // -- Comparison --------------------------------------------------------

    // True when both canvases have the same size and every pixel decodes to
    // the same color. Formats and origins may differ; padding bytes are
    // ignored.
    pub fn equals(&self, other: &Canvas) -> bool {
        if self.width != other.width || self.height != other.height {
            return false
        }
        difference := self.diff_bounds(other)
        return difference.is_empty()
    }
    // The smallest rectangle covering every pixel whose color differs, or
    // an empty rectangle. Pixels present in only one canvas count as
    // different. Origins are ignored: both canvases are compared from their
    // top-left pixels, and the rectangle is relative to them.
    pub fn diff_bounds(&self, other: &Canvas) -> Rect {
        common_width := num.min(self.width as usize, other.width as usize)
        common_height := num.min(self.height as usize, other.height as usize)
        left := common_width as i64
        top := common_height as i64
        right := 0i64
        bottom := 0i64
        for y in 0usize..common_height {
            for x in 0usize..common_width {
                if self.read(x, y) != other.read(x, y) {
                    left = min64(left, x as i64)
                    top = min64(top, y as i64)
                    right = max64(right, x as i64 + 1)
                    bottom = max64(bottom, y as i64 + 1)
                }
            }
        }
        result := edges_rect(left, top, right, bottom)
        if self.width != other.width || self.height != other.height {
            outer := edges_rect(0, 0, max64(self.width as i64, other.width as i64), max64(self.height as i64, other.height as i64))
            if self.width != other.width {
                band := edges_rect(common_width as i64, 0, max64(self.width as i64, other.width as i64), outer.bottom())
                result = result.union(&band)
            }
            if self.height != other.height {
                band := edges_rect(0, common_height as i64, outer.right(), max64(self.height as i64, other.height as i64))
                result = result.union(&band)
            }
        }
        return result
    }
}

fn same_format(a: &PixelFormat, b: &PixelFormat) -> bool {
    match a {
        PixelFormat.Rgba8888 => {
            return *b == PixelFormat.Rgba8888
        }
        PixelFormat.Bgra8888 => {
            return *b == PixelFormat.Bgra8888
        }
        PixelFormat.Rgb565 => {
            return *b == PixelFormat.Rgb565
        }
        PixelFormat.Gray8 => {
            return *b == PixelFormat.Gray8
        }
        PixelFormat.Mono1 => {
            return *b == PixelFormat.Mono1
        }
    }
}

fn glyph_bit(bitmap: &[u8], row: usize, column: usize) -> bool {
    return (bitmap[row + column / 8] & (0x80u8 >> ((column % 8) as u8))) != 0
}

// Radius limited so both corners of the shorter side fit.
fn corner_radius(width: u32, height: u32, radius: u32) -> i64 {
    limit := min64((width as i64 - 1) / 2, (height as i64 - 1) / 2)
    return min64(radius as i64, limit)
}

// Columns cut from each side of row `t` (0 = top) of a rounded rectangle
// `height` rows tall with corner radius r.
fn corner_inset(t: i64, height: i64, radius: i64) -> i64 {
    if radius <= 0 {
        return 0
    }
    dy := 0i64
    if t < radius {
        dy = radius - t
    } else if t >= height - radius {
        dy = t - (height - 1 - radius)
    }
    if dy == 0 {
        return 0
    }
    return radius - circle_half(radius as u64, dy as u64)
}

// ---------------------------------------------------------------------------
// Displays

// Anything that can show a canvas: a window, an SPI or I2C panel, or the
// in-memory std/graphics/fake display. Drawing code generic over Display runs
// unchanged on all of them.
//
// Display coordinates are surface coordinates: a canvas covers
// canvas.bounds() of the display, the whole display when it has the
// display's size and no origin, or one part of it, such as a band from
// Bands. Only the part of a presented rectangle inside both the canvas and
// the display is shown; the rest is ignored, as drawing ignores pixels
// outside a canvas.
pub interface Display {
    // Pixel size of the whole display.
    fn size(&self) -> Size
    // The pixel format it reads most efficiently. Others are converted.
    fn format(&self) -> PixelFormat
    // Show `dirty` from `canvas`. Pixels outside it may or may not be
    // transferred.
    fn present(&mut self, canvas: &Canvas, dirty: Rect) -> void!Error
}

// Present the canvas's dirty rectangle, if any, and reset it. On failure the
// rectangle is marked dirty again so the next call retries it.
pub fn present<D: Display>(display: &mut D, canvas: &mut Canvas) -> void!Error {
    dirty := canvas.take_dirty()
    if dirty.is_empty() {
        return ok()
    }
    retry := dirty.clone()
    match display.present(canvas, dirty) {
        ok() => {
            return ok()
        }
        err(error) => {
            canvas.mark_dirty(retry)
            return err(error)
        }
    }
}

// Present the whole canvas regardless of its dirty rectangle, then reset it.
pub fn present_all<D: Display>(display: &mut D, canvas: &mut Canvas) -> void!Error {
    canvas.mark_all_dirty()
    return present(display, canvas)
}

// Draws a screen taller than the memory for its pixels one horizontal band
// at a time. A 320x240 RGB565 frame needs 153,600 bytes, more than half an
// RP2040's RAM; a 320x40 band needs 25,600. Each call to next moves a canvas
// one band down the screen with set_origin, so drawing code keeps using
// screen coordinates and the canvas keeps only what falls inside the band:
//
//     pixels := [0u8; 320 * 40 * 2]
//     band := graphics.canvas(&mut pixels, 320, 40, graphics.PixelFormat.Rgb565)?
//     bands := graphics.Bands.new(240)
//     for bands.next(&mut band) {
//         draw_screen(&mut band, &state)
//         graphics.present_all(&mut lcd, &mut band)?
//     }
//
// The scene is drawn once per band, so the work grows with the band count;
// pick the tallest band the memory allows. Displays ignore the part of a
// last band that hangs below the screen.
pub struct Bands {
    height: i64
    next_y: i64

    // Bands covering a screen `screen_height` pixels tall from row 0.
    pub fn new(screen_height: u32) -> Bands {
        return Bands { height: screen_height as i64, next_y: 0 }
    }
    // Move `canvas` to the left edge of the next band, resetting its clip
    // and dirty rectangle, and return true; after the last band, return
    // false and start over, so the same Bands draws the next frame. A
    // canvas with no rows covers nothing and returns false.
    pub fn next(&mut self, canvas: &mut Canvas) -> bool {
        if self.next_y >= self.height || canvas.height() == 0 {
            self.next_y = 0
            return false
        }
        canvas.set_origin(0, self.next_y as i32)
        self.next_y += canvas.height() as i64
        return true
    }
    // Start the next frame from the top even if this one was cut short.
    pub fn restart(&mut self) {
        self.next_y = 0
    }
}

// ---------------------------------------------------------------------------
// Antialiased vector drawing
//
// Paths, outlines and the aa_* canvas methods are rasterized with exact
// coverage: each pixel's alpha is the area of the pixel the shape covers,
// computed in integers from the shape's edges at 1/256 pixel precision.
// Curves are flattened to within 1/32 pixel. Antialiased and gradient drawing
// composites over the existing pixels (source-over), unlike the integer
// primitives above, which store their color.

// Path, Pen and Outline coordinates are fixed point with SUBPIXEL units to
// the pixel: 256 is one pixel, 128 half a pixel. The pixel (x, y) covers
// x * 256 .. (x + 1) * 256 horizontally, so its centre is x * 256 + 128.
pub const SUBPIXEL: i32 = 256

// Path coordinates are clamped to +/-2^29 subpixels (+/-2^21 pixels).
const PATH_LIMIT: i64 = 536870912
const AA_PIXEL_LIMIT: i64 = 2097152
// Columns rasterized per pass; a wider shape takes several passes per row.
const CHUNK: usize = 256
// Coverage of a whole pixel in the accumulation buffer.
const FULL: i64 = 65536
// Largest distance between a curve and its flattened chords, in subpixels.
const FLATNESS: i64 = 8
const CURVE_STEPS: i64 = 256

// Which parts of a self-overlapping outline are inside.
pub enum FillRule {
    // Inside where the outline winds around a point at least once in either
    // direction; overlapping contours merge. TrueType glyphs use this rule.
    NonZero,
    // Inside where a ray from the point crosses the outline an odd number of
    // times, so a contour inside another cuts a hole whatever its direction.
    EvenOdd
}

// A shape that can describe itself to a Pen. The rasterizer calls trace
// several times per drawing call, once to find the bounds and then once per
// row band, so trace must describe the same outline every time. Implement it
// to draw procedural shapes without storing them; a Path stores commands for
// shapes built up front.
pub interface Outline {
    fn trace(&self, pen: &mut Pen)
}

// Receives an outline as move, line, curve and close commands in subpixel
// coordinates. Contours close themselves: move_to and the end of a trace
// close an open contour with a straight line to its start.
pub struct Pen {
    measuring: bool
    any: bool
    min_x: i64
    min_y: i64
    max_x: i64
    max_y: i64
    row_top: i64
    row_bottom: i64
    column_start: i64
    column_end: i64
    carry: i64
    cells: [256]i64
    start_x: i64
    start_y: i64
    x: i64
    y: i64
    open: bool

    fn new() -> Pen {
        return Pen { measuring: true, any: false, min_x: 0, min_y: 0, max_x: 0, max_y: 0, row_top: 0, row_bottom: 0, column_start: 0, column_end: 0, carry: 0, cells: [0i64; 256], start_x: 0, start_y: 0, x: 0, y: 0, open: false }
    }
    // Rasterize the pixel row `row`, columns start..end, on the next trace.
    fn begin(&mut self, row: i64, start: i64, end: i64) {
        self.measuring = false
        self.row_top = row * 256
        self.row_bottom = row * 256 + 256
        self.column_start = start
        self.column_end = end
        self.carry = 0
        self.start_x = 0
        self.start_y = 0
        self.x = 0
        self.y = 0
        self.open = false
    }

    // Start a new contour at (x, y), closing the current one.
    pub fn move_to(&mut self, x: i32, y: i32) {
        self.close()
        px := path_coordinate(x)
        py := path_coordinate(y)
        self.start_x = px
        self.start_y = py
        self.x = px
        self.y = py
        self.open = true
        self.include(px, py)
    }
    // A straight edge from the current point to (x, y). Without a preceding
    // move_to, the contour starts at the current point, initially (0, 0).
    pub fn line_to(&mut self, x: i32, y: i32) {
        self.ensure_open()
        px := path_coordinate(x)
        py := path_coordinate(y)
        x0 := self.x
        y0 := self.y
        self.segment(x0, y0, px, py)
        self.x = px
        self.y = py
    }
    // A quadratic Bezier curve through control point (cx, cy) to (x, y).
    pub fn quad_to(&mut self, cx: i32, cy: i32, x: i32, y: i32) {
        self.ensure_open()
        x0 := self.x
        y0 := self.y
        x1 := path_coordinate(cx)
        y1 := path_coordinate(cy)
        x2 := path_coordinate(x)
        y2 := path_coordinate(y)
        self.x = x2
        self.y = y2
        if self.measuring {
            self.include(x1, y1)
            self.include(x2, y2)
            return
        }
        low_y := min64(y0, min64(y1, y2))
        high_y := max64(y0, max64(y1, y2))
        low_x := min64(x0, min64(x1, x2))
        high_x := max64(x0, max64(x1, x2))
        if self.outside(low_x, high_x, low_y, high_y, y0, y2) {
            return
        }
        bend := abs64(x0 - 2 * x1 + x2) + abs64(y0 - 2 * y1 + y2)
        n := curve_steps(bend, 4 * FLATNESS)
        square := n * n
        px := x0
        py := y0
        for i in 1i64..n + 1 {
            s := n - i
            qx := round_div(x0 * s * s + 2 * x1 * s * i + x2 * i * i, square)
            qy := round_div(y0 * s * s + 2 * y1 * s * i + y2 * i * i, square)
            self.segment(px, py, qx, qy)
            px = qx
            py = qy
        }
    }
    // A cubic Bezier curve through control points (c1x, c1y) and (c2x, c2y)
    // to (x, y).
    pub fn cubic_to(&mut self, c1x: i32, c1y: i32, c2x: i32, c2y: i32, x: i32, y: i32) {
        self.ensure_open()
        x0 := self.x
        y0 := self.y
        x1 := path_coordinate(c1x)
        y1 := path_coordinate(c1y)
        x2 := path_coordinate(c2x)
        y2 := path_coordinate(c2y)
        x3 := path_coordinate(x)
        y3 := path_coordinate(y)
        self.x = x3
        self.y = y3
        if self.measuring {
            self.include(x1, y1)
            self.include(x2, y2)
            self.include(x3, y3)
            return
        }
        low_y := min64(min64(y0, y1), min64(y2, y3))
        high_y := max64(max64(y0, y1), max64(y2, y3))
        low_x := min64(min64(x0, x1), min64(x2, x3))
        high_x := max64(max64(x0, x1), max64(x2, x3))
        if self.outside(low_x, high_x, low_y, high_y, y0, y3) {
            return
        }
        bend := max64(abs64(x0 - 2 * x1 + x2) + abs64(y0 - 2 * y1 + y2), abs64(x1 - 2 * x2 + x3) + abs64(y1 - 2 * y2 + y3))
        n := curve_steps(3 * bend, 4 * FLATNESS)
        cube := n * n * n
        px := x0
        py := y0
        for i in 1i64..n + 1 {
            s := n - i
            a := s * s * s
            b := 3 * s * s * i
            c := 3 * s * i * i
            d := i * i * i
            qx := round_div(x0 * a + x1 * b + x2 * c + x3 * d, cube)
            qy := round_div(y0 * a + y1 * b + y2 * c + y3 * d, cube)
            self.segment(px, py, qx, qy)
            px = qx
            py = qy
        }
    }
    // Close the current contour with a straight edge back to its start.
    pub fn close(&mut self) {
        if !self.open {
            return
        }
        self.open = false
        x0 := self.x
        y0 := self.y
        sx := self.start_x
        sy := self.start_y
        self.segment(x0, y0, sx, sy)
        self.x = sx
        self.y = sy
    }

    fn ensure_open(&mut self) {
        if !self.open {
            self.start_x = self.x
            self.start_y = self.y
            self.open = true
            px := self.x
            py := self.y
            self.include(px, py)
        }
    }
    fn include(&mut self, x: i64, y: i64) {
        if !self.measuring {
            return
        }
        if !self.any {
            self.any = true
            self.min_x = x
            self.max_x = x
            self.min_y = y
            self.max_y = y
            return
        }
        self.min_x = min64(self.min_x, x)
        self.max_x = max64(self.max_x, x)
        self.min_y = min64(self.min_y, y)
        self.max_y = max64(self.max_y, y)
    }
    // True when a curve with this control hull contributes nothing to the
    // current pass except, when it lies left of the pass, its winding.
    fn outside(&mut self, low_x: i64, high_x: i64, low_y: i64, high_y: i64, first_y: i64, last_y: i64) -> bool {
        if high_y <= self.row_top || low_y >= self.row_bottom || low_x >= self.column_end * 256 {
            return true
        }
        if high_x <= (self.column_start - 1) * 256 {
            top := self.row_top
            bottom := self.row_bottom
            self.carry += 256 * (clamp64(last_y, top, bottom) - clamp64(first_y, top, bottom))
            return true
        }
        return false
    }
    // Add the coverage of one straight edge to the current pass.
    fn segment(&mut self, x0: i64, y0: i64, x1: i64, y1: i64) {
        if self.measuring {
            self.include(x0, y0)
            self.include(x1, y1)
            return
        }
        if y0 == y1 {
            return
        }
        tx := x0
        ty := y0
        bx := x1
        by := y1
        if y0 > y1 {
            tx = x1
            ty = y1
            bx = x0
            by = y0
        }
        top := self.row_top
        bottom := self.row_bottom
        if by <= top || ty >= bottom {
            return
        }
        ya := max64(ty, top)
        yb := min64(by, bottom)
        span := by - ty
        xa := tx + round_div((bx - tx) * (ya - ty), span)
        xb := tx + round_div((bx - tx) * (yb - ty), span)
        d := yb - ya
        if y1 < y0 {
            d = -d
        }
        self.accumulate(min64(xa, xb), max64(xa, xb), d)
    }
    // Spread the coverage of an edge running from x = left to right (in any
    // direction) across `d` subpixel rows of the current row. Each cell holds
    // the change in coverage from the previous column; columns left of the
    // pass add up in `carry`.
    fn accumulate(&mut self, left: i64, right: i64, d: i64) {
        start := self.column_start
        end := self.column_end
        first := floor_div(left, 256)
        if first >= end {
            return
        }
        last := floor_div(right, 256)
        low := first
        previous := 0i64
        if first < start {
            previous = edge_cover(left, right, d, start - 1)
            self.carry += previous
            low = start
        }
        high := min64(last + 1, end - 1)
        column := low
        for column <= high {
            value := edge_cover(left, right, d, column)
            index := (column - start) as usize
            self.cells[index] += value - previous
            previous = value
            column += 1
        }
    }
}

// Coverage, up to and including `column`, of the part of a pixel row right of
// an edge from x = left to right spanning d subpixel rows: d * 256 once the
// edge is entirely to the left. The edge's x moves linearly over its rows, so
// this is d times the average of clamp(column + 1 - x, 0, 1) along it.
fn edge_cover(left: i64, right: i64, d: i64, column: i64) -> i64 {
    u := (column + 1) * 256
    if u <= left {
        return 0
    }
    if u - right >= 256 {
        return d * 256
    }
    if right == left {
        return d * (u - left)
    }
    return floor_div(d * (ramp_area(u - left) - ramp_area(u - right)), 2 * (right - left))
}

// Twice the integral of clamp(t, 0, 256) for t from -infinity to v.
fn ramp_area(v: i64) -> i64 {
    if v <= 0 {
        return 0
    }
    if v <= 256 {
        return v * v
    }
    return 512 * v - 65536
}

// Chords needed so a curve whose second difference is `bend` stays within
// tolerance: ceil(sqrt(bend / tolerance)), from 1 to CURVE_STEPS.
fn curve_steps(bend: i64, tolerance: i64) -> i64 {
    quotient := ceil_div(bend, tolerance)
    if quotient <= 1 {
        return 1
    }
    n := isqrt(quotient as u64) as i64
    if n * n < quotient {
        n += 1
    }
    return min64(n, CURVE_STEPS)
}

fn path_coordinate(value: i32) -> i64 {
    return clamp64(value as i64, -PATH_LIMIT, PATH_LIMIT)
}

// Pixel coordinate to the subpixel position of its top-left corner.
fn corner(value: i32) -> i64 {
    return clamp64(value as i64, -AA_PIXEL_LIMIT, AA_PIXEL_LIMIT) * 256
}

// Pixel coordinate to the subpixel position of its centre.
fn centre(value: i32) -> i64 {
    return corner(value) + 128
}

// A radius in pixels to subpixels, extended by half a pixel so the shape
// reaches the outer edge of the pixels at that distance.
fn aa_radius(radius: u32) -> i64 {
    return min64(radius as i64, AA_PIXEL_LIMIT) * 256 + 128
}

fn fixed(value: i64) -> i32 {
    return clamp64(value, -PATH_LIMIT, PATH_LIMIT) as i32
}

// Path commands in storage words: a tag followed by its coordinates.
const COMMAND_MOVE: i32 = 1
const COMMAND_LINE: i32 = 2
const COMMAND_QUAD: i32 = 3
const COMMAND_CUBIC: i32 = 4
const COMMAND_CLOSE: i32 = 5

// An outline stored as commands in caller-owned i32 words, in subpixel
// coordinates. A move or line takes 3 words, a quadratic curve 5, a cubic 7,
// a close 1; the shape helpers add whole closed contours. Building a path
// cannot fail: when a command does not fit, the path is marked overflowed,
// keeps no further commands, and draws nothing.
//
//     storage := [0i32; 256]
//     path := graphics.Path.new(&mut storage)
//     path.move_to(10 * graphics.SUBPIXEL, 0)
//     path.quad_to(20 * graphics.SUBPIXEL, 20 * graphics.SUBPIXEL, 0, 20 * graphics.SUBPIXEL)
//     path.close()
//     canvas.fill_path(&path, graphics.FillRule.NonZero, graphics.WHITE)
pub struct Path {
    words: &mut[i32]
    length: usize
    overflowed: bool

    pub fn new(storage: &mut[i32]) -> Path from(storage) {
        return Path { words: storage, length: 0, overflowed: false }
    }
    // Remove every command and the overflow mark.
    pub fn clear(&mut self) {
        self.length = 0
        self.overflowed = false
    }
    // Storage words in use.
    pub fn len(&self) -> usize {
        return self.length
    }
    pub fn is_empty(&self) -> bool {
        return self.length == 0
    }
    // True when a command did not fit; the path then draws nothing.
    pub fn overflowed(&self) -> bool {
        return self.overflowed
    }
    fn room(&mut self, words: usize) -> bool {
        if self.overflowed || self.words.len - self.length < words {
            self.overflowed = true
            return false
        }
        return true
    }
    fn push(&mut self, value: i32) {
        self.words[self.length] = value
        self.length += 1
    }
    pub fn move_to(&mut self, x: i32, y: i32) {
        if self.room(3) {
            self.push(COMMAND_MOVE)
            self.push(x)
            self.push(y)
        }
    }
    pub fn line_to(&mut self, x: i32, y: i32) {
        if self.room(3) {
            self.push(COMMAND_LINE)
            self.push(x)
            self.push(y)
        }
    }
    pub fn quad_to(&mut self, cx: i32, cy: i32, x: i32, y: i32) {
        if self.room(5) {
            self.push(COMMAND_QUAD)
            self.push(cx)
            self.push(cy)
            self.push(x)
            self.push(y)
        }
    }
    pub fn cubic_to(&mut self, c1x: i32, c1y: i32, c2x: i32, c2y: i32, x: i32, y: i32) {
        if self.room(7) {
            self.push(COMMAND_CUBIC)
            self.push(c1x)
            self.push(c1y)
            self.push(c2x)
            self.push(c2y)
            self.push(x)
            self.push(y)
        }
    }
    pub fn close(&mut self) {
        if self.room(1) {
            self.push(COMMAND_CLOSE)
        }
    }
    // A closed rectangle contour with its top-left corner at (x, y).
    pub fn rect(&mut self, x: i32, y: i32, width: i32, height: i32) {
        left := path_coordinate(x)
        top := path_coordinate(y)
        right := path_coordinate(x) + path_coordinate(width)
        bottom := path_coordinate(y) + path_coordinate(height)
        self.move_to(fixed(left), fixed(top))
        self.line_to(fixed(right), fixed(top))
        self.line_to(fixed(right), fixed(bottom))
        self.line_to(fixed(left), fixed(bottom))
        self.close()
    }
    // A closed rectangle contour with corners rounded to `radius`, limited
    // to half the shorter side.
    pub fn round_rect(&mut self, x: i32, y: i32, width: i32, height: i32, radius: i32) {
        left := path_coordinate(x)
        top := path_coordinate(y)
        trace_round_rect(self, left, top, left + max64(path_coordinate(width), 0), top + max64(path_coordinate(height), 0), max64(radius as i64, 0), false)
    }
    // A closed ellipse contour centred on (cx, cy).
    pub fn ellipse(&mut self, cx: i32, cy: i32, rx: i32, ry: i32) {
        trace_ellipse(self, path_coordinate(cx), path_coordinate(cy), abs64(path_coordinate(rx)), abs64(path_coordinate(ry)), false)
    }
    pub fn circle(&mut self, cx: i32, cy: i32, radius: i32) {
        self.ellipse(cx, cy, radius, radius)
    }
    // Describe the stored commands to `pen`; nothing once overflowed.
    pub fn trace(&self, pen: &mut Pen) {
        if self.overflowed {
            return
        }
        i := 0usize
        w := &self.words[..self.length]
        for i < w.len {
            tag := w[i]
            if tag == COMMAND_MOVE {
                pen.move_to(w[i + 1], w[i + 2])
                i += 3
            } else if tag == COMMAND_LINE {
                pen.line_to(w[i + 1], w[i + 2])
                i += 3
            } else if tag == COMMAND_QUAD {
                pen.quad_to(w[i + 1], w[i + 2], w[i + 3], w[i + 4])
                i += 5
            } else if tag == COMMAND_CUBIC {
                pen.cubic_to(w[i + 1], w[i + 2], w[i + 3], w[i + 4], w[i + 5], w[i + 6])
                i += 7
            } else {
                pen.close()
                i += 1
            }
        }
    }
}

// What the shape helpers draw into: a Pen or a Path.
interface Sink {
    fn move_to(&mut self, x: i32, y: i32)
    fn line_to(&mut self, x: i32, y: i32)
    fn cubic_to(&mut self, c1x: i32, c1y: i32, c2x: i32, c2y: i32, x: i32, y: i32)
    fn close(&mut self)
}

// cos and sin of the multiples of 45 degrees, and 4/3 tan(pi/16), the control
// distance of a 45 degree cubic arc, in 2^-24 units. Eight such arcs stay
// within 4.2e-6 of the radius of a true circle.
const ARC_ONE: i64 = 16777216
const ARC_DIAGONAL: i64 = 11863283
const ARC_HANDLE: i64 = 4449594

fn arc_cos(index: usize) -> i64 {
    match index % 8 {
        0 => {
            return ARC_ONE
        }
        1 => {
            return ARC_DIAGONAL
        }
        2 => {
            return 0
        }
        3 => {
            return -ARC_DIAGONAL
        }
        4 => {
            return -ARC_ONE
        }
        5 => {
            return -ARC_DIAGONAL
        }
        6 => {
            return 0
        }
        _ => {
            return ARC_DIAGONAL
        }
    }
}

// value / 2^24, rounded to nearest.
fn shift24(value: i64) -> i64 {
    return (value + 8388608) >> 24
}

fn arc_sin(index: usize) -> i64 {
    return arc_cos(index + 6)
}

// `count` 45 degree arcs of the ellipse c + a cos t + b sin t, starting at
// angle index `first` (t = first * 45 degrees) and continuing through
// increasing indexes. With `start`, the first point begins a new contour;
// otherwise a line joins it to the current point.
fn trace_arcs<S: Sink>(sink: &mut S, cx: i64, cy: i64, ax: i64, ay: i64, bx: i64, by: i64, first: usize, count: usize, start: bool) {
    px := cx + shift24(ax * arc_cos(first) + bx * arc_sin(first))
    py := cy + shift24(ay * arc_cos(first) + by * arc_sin(first))
    if start {
        sink.move_to(fixed(px), fixed(py))
    } else {
        sink.line_to(fixed(px), fixed(py))
    }
    for j in first..first + count {
        tx := shift24(bx * arc_cos(j) - ax * arc_sin(j))
        ty := shift24(by * arc_cos(j) - ay * arc_sin(j))
        qx := cx + shift24(ax * arc_cos(j + 1) + bx * arc_sin(j + 1))
        qy := cy + shift24(ay * arc_cos(j + 1) + by * arc_sin(j + 1))
        ux := shift24(bx * arc_cos(j + 1) - ax * arc_sin(j + 1))
        uy := shift24(by * arc_cos(j + 1) - ay * arc_sin(j + 1))
        c1x := px + shift24(tx * ARC_HANDLE)
        c1y := py + shift24(ty * ARC_HANDLE)
        c2x := qx - shift24(ux * ARC_HANDLE)
        c2y := qy - shift24(uy * ARC_HANDLE)
        sink.cubic_to(fixed(c1x), fixed(c1y), fixed(c2x), fixed(c2y), fixed(qx), fixed(qy))
        px = qx
        py = qy
    }
}

// A closed axis-aligned ellipse, clockwise on screen, or counterclockwise
// when `reverse` is set.
fn trace_ellipse<S: Sink>(sink: &mut S, cx: i64, cy: i64, rx: i64, ry: i64, reverse: bool) {
    by := ry
    if reverse {
        by = -ry
    }
    trace_arcs(sink, cx, cy, rx, 0, 0, by, 0, 8, true)
    sink.close()
}

// A closed rounded rectangle between the given edges, clockwise on screen or
// counterclockwise when `reverse` is set (traced mirrored left to right).
fn trace_round_rect<S: Sink>(sink: &mut S, left: i64, top: i64, right: i64, bottom: i64, radius: i64, reverse: bool) {
    if right <= left || bottom <= top {
        return
    }
    r := min64(min64(radius, (right - left) / 2), (bottom - top) / 2)
    // Corner centres on the side traced first (near) and last (far).
    near := right - r
    far := left + r
    s := 1i64
    if reverse {
        near = left + r
        far = right - r
        s = -1
    }
    sink.move_to(fixed(far), fixed(top))
    if r == 0 {
        sink.line_to(fixed(near), fixed(top))
        sink.line_to(fixed(near), fixed(bottom))
        sink.line_to(fixed(far), fixed(bottom))
        sink.close()
        return
    }
    trace_arcs(sink, near, top + r, s * r, 0, 0, r, 6, 2, false)
    trace_arcs(sink, near, bottom - r, s * r, 0, 0, r, 0, 2, false)
    trace_arcs(sink, far, bottom - r, s * r, 0, 0, r, 2, 2, false)
    trace_arcs(sink, far, top + r, s * r, 0, 0, r, 4, 2, false)
    sink.close()
}

// An ellipse, or a ring between two concentric ellipses.
struct EllipseShape {
    cx: i64
    cy: i64
    rx: i64
    ry: i64
    inner_rx: i64
    inner_ry: i64
    ring: bool

    fn trace(&self, pen: &mut Pen) {
        trace_ellipse(pen, self.cx, self.cy, self.rx, self.ry, false)
        if self.ring && self.inner_rx > 0 && self.inner_ry > 0 {
            trace_ellipse(pen, self.cx, self.cy, self.inner_rx, self.inner_ry, true)
        }
    }
}

// A rounded rectangle, or the ring between it and one inset by `inset`.
struct RoundRectShape {
    left: i64
    top: i64
    right: i64
    bottom: i64
    radius: i64
    inset: i64
    ring: bool

    fn trace(&self, pen: &mut Pen) {
        trace_round_rect(pen, self.left, self.top, self.right, self.bottom, self.radius, false)
        if self.ring {
            d := self.inset
            trace_round_rect(pen, self.left + d, self.top + d, self.right - d, self.bottom - d, max64(self.radius - d, 0), true)
        }
    }
}

// A line of the given half width between two points: square ends extending
// half the width past the points, or round ends centred on them.
struct StrokeShape {
    x0: i64
    y0: i64
    x1: i64
    y1: i64
    half: i64
    round: bool

    fn trace(&self, pen: &mut Pen) {
        dx := self.x1 - self.x0
        dy := self.y1 - self.y0
        r := self.half
        if dx == 0 && dy == 0 {
            if self.round {
                trace_ellipse(pen, self.x0, self.y0, r, r, false)
            } else {
                pen.move_to(fixed(self.x0 - r), fixed(self.y0 - r))
                pen.line_to(fixed(self.x0 + r), fixed(self.y0 - r))
                pen.line_to(fixed(self.x0 + r), fixed(self.y0 + r))
                pen.line_to(fixed(self.x0 - r), fixed(self.y0 + r))
                pen.close()
            }
            return
        }
        length := isqrt((dx * dx + dy * dy) as u64) as i64
        // Unit direction u and normal v in 2^-24 units, then scaled by r.
        ux := floor_div(2 * dx * ARC_ONE + length, 2 * length)
        uy := floor_div(2 * dy * ARC_ONE + length, 2 * length)
        ax := shift24(ux * r)
        ay := shift24(uy * r)
        nx := -ay
        ny := ax
        if self.round {
            pen.move_to(fixed(self.x0 + nx), fixed(self.y0 + ny))
            pen.line_to(fixed(self.x1 + nx), fixed(self.y1 + ny))
            trace_arcs(pen, self.x1, self.y1, ax, ay, -nx, -ny, 6, 4, false)
            pen.line_to(fixed(self.x0 - nx), fixed(self.y0 - ny))
            trace_arcs(pen, self.x0, self.y0, -ax, -ay, nx, ny, 6, 4, false)
            pen.close()
            return
        }
        pen.move_to(fixed(self.x0 - ax + nx), fixed(self.y0 - ay + ny))
        pen.line_to(fixed(self.x1 + ax + nx), fixed(self.y1 + ay + ny))
        pen.line_to(fixed(self.x1 + ax - nx), fixed(self.y1 + ay - ny))
        pen.line_to(fixed(self.x0 - ax - nx), fixed(self.y0 - ay - ny))
        pen.close()
    }
}

// A polygon through pixel-corner vertices given as x, y pairs.
struct PolygonShape {
    coordinates: &[i32]

    fn trace(&self, pen: &mut Pen) {
        vertices := self.coordinates.len / 2
        for i in 0usize..vertices {
            x := fixed(corner(self.coordinates[2 * i]))
            y := fixed(corner(self.coordinates[2 * i + 1]))
            if i == 0 {
                pen.move_to(x, y)
            } else {
                pen.line_to(x, y)
            }
        }
        pen.close()
    }
}

// ---------------------------------------------------------------------------
// Gradients

// The most color stops a gradient holds; add_stop ignores more.
pub const GRADIENT_STOPS: usize = 8

// What a gradient paints beyond its end points.
pub enum Spread {
    // Extend the first and last colors.
    Pad,
    // Start again from the first color.
    Repeat,
    // Run back and forth.
    Reflect
}

const SPREAD_PAD: u8 = 0
const SPREAD_REPEAT: u8 = 1
const SPREAD_REFLECT: u8 = 2

// Gradient coordinates are clamped to +/-2^20 pixels and pixel distances
// from them to +/-2^22 so products stay within 64 bits.
const GRADIENT_LIMIT: i64 = 1048576
const GRADIENT_REACH: i64 = 4194304

// A linear or radial color gradient for gradient_rect, gradient_path and
// gradient_outline. Colors are sampled at pixel centres and interpolated in
// premultiplied alpha, so fading to TRANSPARENT does not darken. Stops sit
// at offsets from 0 (the start point or centre) to 255 (the end point or
// radius); two stops at one offset make a hard edge.
//
//     sky := graphics.Gradient.linear(0, 0, 0, 99, graphics.hex(0x203a5c), graphics.hex(0xf4a259))
//     sky.add_stop(160, graphics.hex(0xbc4b51))
//     canvas.gradient_rect(0, 0, 160, 100, &sky)
pub struct Gradient {
    radial: bool
    x0: i64
    y0: i64
    dx: i64
    dy: i64
    length2: i64
    radius: i64
    spread: u8
    dither: bool
    count: usize
    offsets: [8]i64
    colors: [8]u32

    // From `start` at pixel (x0, y0) to `end` at pixel (x1, y1), constant
    // along lines perpendicular to that direction. If both points are the
    // same pixel, the gradient paints its last stop's color.
    pub fn linear(x0: i32, y0: i32, x1: i32, y1: i32, start: Color, end: Color) -> Gradient {
        ax := clamp64(x0 as i64, -GRADIENT_LIMIT, GRADIENT_LIMIT)
        ay := clamp64(y0 as i64, -GRADIENT_LIMIT, GRADIENT_LIMIT)
        dx := clamp64(x1 as i64, -GRADIENT_LIMIT, GRADIENT_LIMIT) - ax
        dy := clamp64(y1 as i64, -GRADIENT_LIMIT, GRADIENT_LIMIT) - ay
        g := Gradient { radial: false, x0: ax, y0: ay, dx: dx, dy: dy, length2: dx * dx + dy * dy, radius: 0, spread: SPREAD_PAD, dither: false, count: 2, offsets: [0i64; 8], colors: [0u32; 8] }
        g.offsets[1] = 65535
        g.colors[0] = premultiply(start)
        g.colors[1] = premultiply(end)
        return g
    }
    // From `inner` at the centre of pixel (cx, cy) to `outer` at `radius`
    // pixels from it, constant along circles. A zero radius paints the last
    // stop's color.
    pub fn radial(cx: i32, cy: i32, radius: u32, inner: Color, outer: Color) -> Gradient {
        ax := clamp64(cx as i64, -GRADIENT_LIMIT, GRADIENT_LIMIT)
        ay := clamp64(cy as i64, -GRADIENT_LIMIT, GRADIENT_LIMIT)
        r := min64(radius as i64, GRADIENT_LIMIT) * 256
        g := Gradient { radial: true, x0: ax, y0: ay, dx: 0, dy: 0, length2: 0, radius: r, spread: SPREAD_PAD, dither: false, count: 2, offsets: [0i64; 8], colors: [0u32; 8] }
        g.offsets[1] = 65535
        g.colors[0] = premultiply(inner)
        g.colors[1] = premultiply(outer)
        return g
    }
    // Insert a stop at `offset` (0 to 255), after any stops already there.
    // A gradient holds at most GRADIENT_STOPS stops; further ones are ignored.
    pub fn add_stop(&mut self, offset: u8, color: Color) {
        if self.count >= GRADIENT_STOPS {
            return
        }
        position := offset as i64 * 257
        at := self.count
        for at > 0 && self.offsets[at - 1] > position {
            self.offsets[at] = self.offsets[at - 1]
            self.colors[at] = self.colors[at - 1]
            at -= 1
        }
        self.offsets[at] = position
        self.colors[at] = premultiply(color)
        self.count += 1
    }
    pub fn stop_count(&self) -> usize {
        return self.count
    }
    pub fn set_spread(&mut self, spread: Spread) {
        match spread {
            Spread.Pad => {
                self.spread = SPREAD_PAD
            }
            Spread.Repeat => {
                self.spread = SPREAD_REPEAT
            }
            Spread.Reflect => {
                self.spread = SPREAD_REFLECT
            }
        }
    }
    // Ordered (4x4 Bayer) dithering when drawing on Rgb565 and Mono1
    // canvases, which trades banding for a fine regular pattern. Other
    // formats store 8 bits per channel and are unaffected.
    pub fn set_dither(&mut self, on: bool) {
        self.dither = on
    }
    // The undithered color at the centre of pixel (x, y).
    pub fn color_at(&self, x: i32, y: i32) -> Color {
        t := self.spread_position(self.position(x as i64, y as i64))
        return unpremultiply(self.mixed(t))
    }
    // The position of pixel (x, y) along the gradient, 0 at the start and
    // 65536 at the end, before the spread applies.
    fn position(&self, x: i64, y: i64) -> i64 {
        if self.radial {
            if self.radius > 0 {
                ex := clamp64(x - self.x0, -GRADIENT_REACH, GRADIENT_REACH) * 256
                ey := clamp64(y - self.y0, -GRADIENT_REACH, GRADIENT_REACH) * 256
                return isqrt((ex * ex + ey * ey) as u64) as i64 * 65536 / self.radius
            }
        } else if self.length2 > 0 {
            ex := clamp64(x - self.x0, -GRADIENT_REACH, GRADIENT_REACH)
            ey := clamp64(y - self.y0, -GRADIENT_REACH, GRADIENT_REACH)
            return floor_div((ex * self.dx + ey * self.dy) * 65536, self.length2)
        }
        return 65535
    }
    // A position mapped into 0..65535 by the spread.
    fn spread_position(&self, position: i64) -> i64 {
        t := position
        if self.spread == SPREAD_REPEAT {
            return t - floor_div(t, 65536) * 65536
        }
        if self.spread == SPREAD_REFLECT {
            t = t - floor_div(t, 131072) * 131072
            if t >= 65536 {
                t = 131071 - t
            }
            return t
        }
        return clamp64(t, 0, 65535)
    }
    // The premultiplied color at a spread position.
    fn mixed(&self, t: i64) -> u32 {
        last := self.count - 1
        if t <= self.offsets[0] {
            return self.colors[0]
        }
        if t >= self.offsets[last] {
            return self.colors[last]
        }
        i := 0usize
        for i + 1 < last && t >= self.offsets[i + 1] {
            i += 1
        }
        low := self.offsets[i]
        f := ((t - low) * 256 / (self.offsets[i + 1] - low)) as u32
        return mix_premultiplied(self.colors[i], self.colors[i + 1], f)
    }

    // -- Stepping along a row ----------------------------------------------
    //
    // gradient_rect and the rasterizer visit pixels left to right, so they
    // step a Walk instead of sampling each pixel from scratch. A linear
    // position advances by a constant quotient and remainder, with no
    // division. A radial distance is predicted from the three before it
    // and confirmed by squaring, so the square root is only computed near
    // the centre, where the distance bends sharply. Pixels whose position
    // or premultiplied color repeats reuse the previous color. Every result
    // equals color_at exactly.

    // A walk starting at pixel (x, y).
    fn walk(&self, x: i64, y: i64) -> Walk {
        w := Walk { x: x, position: 65535, remainder: 0, step: 0, step_remainder: 0, row_square: 0, root1: 0, root2: 0, root3: 0, roots: 0u32, segment: 0, segment_low: 0, segment_high: 0, reciprocal: 0, cached_t: 0, cached_mixed: 0, cached: 0, has_cache: false }
        if self.radial {
            if self.radius > 0 {
                ey := clamp64(y - self.y0, -GRADIENT_REACH, GRADIENT_REACH) * 256
                w.row_square = ey * ey
                position := self.radial_position(&mut w)
                w.position = position
            }
        } else if self.length2 > 0 {
            ex := clamp64(x - self.x0, -GRADIENT_REACH, GRADIENT_REACH)
            ey := clamp64(y - self.y0, -GRADIENT_REACH, GRADIENT_REACH)
            numerator := (ex * self.dx + ey * self.dy) * 65536
            w.position = floor_div(numerator, self.length2)
            w.remainder = numerator - w.position * self.length2
            step := self.dx * 65536
            w.step = floor_div(step, self.length2)
            w.step_remainder = step - w.step * self.length2
        }
        return w
    }
    // Move the walk one pixel to the right.
    fn advance(&self, w: &mut Walk) {
        if self.radial {
            w.x += 1
            if self.radius > 0 {
                position := self.radial_position(w)
                w.position = position
            }
            return
        }
        if self.length2 > 0 {
            // Columns beyond GRADIENT_REACH clamp to the same position.
            offset := w.x - self.x0
            if offset >= -GRADIENT_REACH && offset < GRADIENT_REACH {
                w.position += w.step
                w.remainder += w.step_remainder
                if w.remainder >= self.length2 {
                    w.remainder -= self.length2
                    w.position += 1
                }
            }
        }
        w.x += 1
    }
    // The radial position of the walk's pixel, recording its distance.
    fn radial_position(&self, w: &mut Walk) -> i64 {
        ex := clamp64(w.x - self.x0, -GRADIENT_REACH, GRADIENT_REACH) * 256
        square := ex * ex + w.row_square
        guess := w.root1
        if w.roots >= 3 {
            guess = 3 * (w.root1 - w.root2) + w.root3
        } else if w.roots == 2 {
            guess = 2 * w.root1 - w.root2
        }
        root := settle_root(square, guess)
        w.root3 = w.root2
        w.root2 = w.root1
        w.root1 = root
        if w.roots < 3 {
            w.roots += 1
        }
        return root * 65536 / self.radius
    }
    // mixed(t), remembering the stop pair t falls between so neighbouring
    // pixels skip the search and divide by multiplying with a reciprocal.
    fn walk_mixed(&self, w: &mut Walk, t: i64) -> u32 {
        last := self.count - 1
        if t <= self.offsets[0] {
            return self.colors[0]
        }
        if t >= self.offsets[last] {
            return self.colors[last]
        }
        if t < w.segment_low || t >= w.segment_high {
            // Stops in a nonempty interval offsets[i]..offsets[i + 1]
            // containing t; mixed() finds the same pair.
            i := 0usize
            for i + 1 < last && t >= self.offsets[i + 1] {
                i += 1
            }
            w.segment = i
            w.segment_low = self.offsets[i]
            w.segment_high = self.offsets[i + 1]
            w.reciprocal = RECIPROCAL_ONE / (w.segment_high - w.segment_low) + 1
        }
        f := (((t - w.segment_low) * 256 * w.reciprocal) >> RECIPROCAL_SHIFT) as u32
        return mix_premultiplied(self.colors[w.segment], self.colors[w.segment + 1], f)
    }
    // The undithered color of the walk's pixel.
    fn walk_color(&self, w: &mut Walk) -> Color {
        t := self.spread_position(w.position)
        if w.has_cache && t == w.cached_t {
            return w.cached
        }
        mixed := self.walk_mixed(w, t)
        w.cached_t = t
        if !w.has_cache || mixed != w.cached_mixed {
            w.cached_mixed = mixed
            w.cached = unpremultiply(mixed)
            w.has_cache = true
        }
        return w.cached
    }
    // True when every pixel of a row has the same color.
    fn rows_constant(&self) -> bool {
        if self.radial {
            return self.radius == 0
        }
        return self.dx == 0 || self.length2 == 0
    }
    // True when dithered() changes colors for `format`.
    fn dithers(&self, format: &PixelFormat) -> bool {
        if !self.dither {
            return false
        }
        match format {
            PixelFormat.Rgb565 => {
                return true
            }
            PixelFormat.Mono1 => {
                return true
            }
            _ => {
                return false
            }
        }
    }
    // `color`, sampled at (x, y), as stored on a canvas in `format`.
    fn dithered(&self, color: Color, x: i64, y: i64, format: &PixelFormat) -> Color {
        if !self.dither {
            return color
        }
        m := bayer(x, y)
        match format {
            PixelFormat.Rgb565 => {
                r := min_u32(((color >> 16) & 255) + (2 * m + 1) / 4, 255)
                g := min_u32(((color >> 8) & 255) + (2 * m + 1) / 8, 255)
                b := min_u32((color & 255) + (2 * m + 1) / 4, 255)
                return (color & 0xff000000) | (r << 16) | (g << 8) | b
            }
            PixelFormat.Mono1 => {
                if luma(color) as u32 >= 16 * m + 8 {
                    return color | 0x00ffffff
                }
                return color & 0xff000000
            }
            _ => {
                return color
            }
        }
    }
}

// The state of Gradient.walk along one row.
struct Walk {
    // The pixel's column and unspread position.
    x: i64
    position: i64
    // Linear: position = floor(numerator / length2), kept as quotient and
    // remainder, and the per-column step split the same way.
    remainder: i64
    step: i64
    step_remainder: i64
    // Radial: the row's squared distance from the centre, in 1/256 pixels,
    // and the last three distances, newest first.
    row_square: i64
    root1: i64
    root2: i64
    root3: i64
    roots: u32
    // The stop pair of the last color mixed: offsets segment_low up to
    // segment_high, and RECIPROCAL_ONE / (their distance), plus one.
    segment: usize
    segment_low: i64
    segment_high: i64
    reciprocal: i64
    // The last spread position, its premultiplied color and that color.
    cached_t: i64
    cached_mixed: u32
    cached: Color
    has_cache: bool
}

// floor(n / d) = (n * (2^40 / d + 1)) >> 40 for n < 2^24 and d < 2^16:
// the reciprocal overshoots n / d by less than n / 2^40 < 2^-16, while
// the fraction of n / d is at most 1 - 1/d, more than 2^-16 below 1. The
// product stays below 2^49 because n < 256 * d here.
const RECIPROCAL_SHIFT: i64 = 40
const RECIPROCAL_ONE: i64 = 1099511627776

// Correct distances below 2^31 need squares below 2^62.
const ROOT_LIMIT: i64 = 2147483647

// floor(sqrt(value)) for 0 <= value < 2^62, starting from a guess: a few
// steps of one confirm a close guess, and anything else falls back to isqrt.
fn settle_root(value: i64, guess: i64) -> i64 {
    root := clamp64(guess, 0, ROOT_LIMIT - 1)
    for _ in 0..4 {
        if root * root > value {
            root -= 1
        } else if (root + 1) * (root + 1) <= value {
            root += 1
        } else {
            return root
        }
    }
    if root * root <= value && (root + 1) * (root + 1) > value {
        return root
    }
    return isqrt(value as u64) as i64
}

// The 4x4 Bayer threshold, 0 to 15, of pixel (x, y).
fn bayer(x: i64, y: i64) -> u32 {
    index := ((y & 3) * 4 + (x & 3)) as usize
    match index {
        0 => {
            return 0
        }
        1 => {
            return 8
        }
        2 => {
            return 2
        }
        3 => {
            return 10
        }
        4 => {
            return 12
        }
        5 => {
            return 4
        }
        6 => {
            return 14
        }
        7 => {
            return 6
        }
        8 => {
            return 3
        }
        9 => {
            return 11
        }
        10 => {
            return 1
        }
        11 => {
            return 9
        }
        12 => {
            return 15
        }
        13 => {
            return 7
        }
        14 => {
            return 13
        }
        _ => {
            return 5
        }
    }
}

fn premultiply(color: Color) -> u32 {
    a := color >> 24
    r := div255(((color >> 16) & 255) * a)
    g := div255(((color >> 8) & 255) * a)
    b := div255((color & 255) * a)
    return (a << 24) | (r << 16) | (g << 8) | b
}

fn unpremultiply(color: u32) -> Color {
    a := color >> 24
    if a == 0 {
        return TRANSPARENT
    }
    if a == 255 {
        return color
    }
    r := min_u32((((color >> 16) & 255) * 255 + a / 2) / a, 255)
    g := min_u32((((color >> 8) & 255) * 255 + a / 2) / a, 255)
    b := min_u32(((color & 255) * 255 + a / 2) / a, 255)
    return (a << 24) | (r << 16) | (g << 8) | b
}

// Channel-wise (a * (256 - f) + b * f) / 256, rounded, for f in 0..256,
// two channels per operation (see tint_low).
fn mix_premultiplied(a: u32, b: u32, f: u32) -> u32 {
    g := 256 - f
    low := (a & 0x00ff00ff) * g + (b & 0x00ff00ff) * f + 0x00800080
    high := ((a >> 8) & 0x00ff00ff) * g + ((b >> 8) & 0x00ff00ff) * f + 0x00800080
    return ((low >> 8) & 0x00ff00ff) | (high & 0xff00ff00)
}

fn min_u32(a: u32, b: u32) -> u32 {
    if a < b {
        return a
    }
    return b
}
