package vector

import "core/mem"
import "core/ptr"
import "alloc/error"
import "alloc/layout"
import "alloc/block"

// A is an owned allocator capability: allocate(&self,&Layout)->Block!AllocError,
// unsafe deallocate(&self,Block). It may retain checked backing dependencies.
pub struct Vector<T, A> {
    elements: [0]T
    allocator: A
    pointer: *mut T
    length: usize
    reserved: usize

    // Cursor starts at zero. Each call yields one logical element.
    pub fn next(&self, cursor: &mut usize) -> Option<&T> from(self) {
        if *cursor >= self.length {
            return none
        }
        index := *cursor
        *cursor = index + 1
        return self.get(index)
    }
    pub fn len(&self) -> usize {
        return self.length
    }
    pub fn capacity(&self) -> usize {
        return self.reserved
    }
    pub fn is_empty(&self) -> bool {
        return self.length == 0
    }
    pub fn as_slice(&self) -> &[T] {
        unsafe {
            return ptr.view_slice(self.pointer, self.length, self)
        }
    }
    pub fn as_mut_slice(&mut self) -> &mut[T] requires_plain(T) {
        unsafe {
            return ptr.borrow_slice_mut(self.pointer, self.length, self)
        }
    }
    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.length {
            return none
        }
        unsafe {
            return some(ptr.view(ptr.offset(self.pointer, index as isize), self))
        }
    }
    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> requires_plain(T) {
        if index >= self.length {
            return none
        }
        unsafe {
            return some(ptr.borrow_mut(ptr.offset(self.pointer, index as isize), self))
        }
    }
    // Scoped mutation: M.apply(&mut T)->void!E may edit an owned payload,
    // but cannot retain its temporary borrow or add new stored dependencies.
    // Restore the occupied slot before propagating errors; edits are not rolled
    // back. Missing indices return ok(false) without calling the mutation.
    pub fn try_update<M, E>(&mut self, index: usize, mutation: &mut M) -> bool!E requires_plain(E) {
        if index >= self.length {
            return ok(false)
        }
        unsafe {
            destination := ptr.offset(self.pointer, index as isize)
            value := ptr.take(destination, self)
            result: void!E = mutation.apply(&mut value)
            ptr.store(destination, value, self)
            result?
        }
        return ok(true)
    }
    // Geometric growth; failure preserves all existing values and capacity.
    pub fn reserve(&mut self, additional: usize) -> void!error.AllocError {
        if additional > layout.max_size() - self.length {
            return err(error.AllocError.SizeOverflow)
        }
        required := self.length + additional
        if required <= self.reserved {
            return ok()
        }
        capacity := self.reserved
        if capacity < 4 {
            capacity = 4
        }
        for capacity < required {
            if capacity > layout.max_size() / 2 {
                capacity = required
            } else {
                capacity = capacity * 2
            }
        }
        requested := layout.array::<T>(capacity)?
        previous_layout := layout.array::<T>(self.reserved)?
        allocated := self.allocator.allocate(&requested)?
        unsafe {
            destination := allocated.as_ptr() as *mut T
            ptr.relocate(self.pointer, destination, self.length, self)
            if self.reserved != 0 {
                previous := block.Block.from_raw_parts(self.pointer as *mut u8, previous_layout)
                self.allocator.deallocate(previous)
            }
            self.pointer = destination
            self.reserved = capacity
        }
        return ok()
    }
    pub fn push(&mut self, value: T) -> void!error.AllocError stores(self, value) {
        self.reserve(1)?
        unsafe {
            ptr.store(ptr.offset(self.pointer, self.length as isize), value, self)
        }
        self.length = self.length + 1
        return ok()
    }
    pub fn pop(&mut self) -> Option<T> from(self.stored) {
        if self.length == 0 {
            return none
        }
        self.length = self.length - 1
        unsafe {
            return some(ptr.take(ptr.offset(self.pointer, self.length as isize), self))
        }
    }
    // Out-of-range is represented by UnsupportedLayout; no mutation on error.
    pub fn insert(&mut self, index: usize, value: T) -> void!error.AllocError stores(self, value) {
        if index > self.length {
            return err(error.AllocError.UnsupportedLayout)
        }
        self.reserve(1)?
        unsafe {
            destination := ptr.offset(self.pointer, index as isize)
            ptr.relocate(destination, ptr.offset(destination, 1), self.length - index, self)
            ptr.store(destination, value, self)
        }
        self.length = self.length + 1
        return ok()
    }
    pub fn remove(&mut self, index: usize) -> Option<T> from(self.stored) {
        if index >= self.length {
            return none
        }
        unsafe {
            source := ptr.offset(self.pointer, index as isize)
            value := ptr.take(source, self)
            ptr.relocate(ptr.offset(source, 1), source, self.length - index - 1, self)
            self.length = self.length - 1
            return some(value)
        }
    }
    pub fn swap_remove(&mut self, index: usize) -> Option<T> from(self.stored) {
        if index >= self.length {
            return none
        }
        unsafe {
            source := ptr.offset(self.pointer, index as isize)
            value := ptr.take(source, self)
            self.length = self.length - 1
            if index != self.length {
                last := ptr.take(ptr.offset(self.pointer, self.length as isize), self)
                ptr.store(source, last, self)
            }
            return some(value)
        }
    }
    // Invalid index destroys the replacement and returns none.
    pub fn replace(&mut self, index: usize, value: T) -> Option<T> from(self.stored) stores(self, value) {
        if index >= self.length {
            return none
        }
        unsafe {
            destination := ptr.offset(self.pointer, index as isize)
            old := ptr.take(destination, self)
            ptr.store(destination, value, self)
            return some(old)
        }
    }
    pub fn swap(&mut self, a: usize, b: usize) -> bool {
        if a >= self.length || b >= self.length {
            return false
        }
        if a == b {
            return true
        }
        unsafe {
            first := ptr.offset(self.pointer, a as isize)
            second := ptr.offset(self.pointer, b as isize)
            x := ptr.take(first, self)
            y := ptr.take(second, self)
            ptr.store(first, y, self)
            ptr.store(second, x, self)
        }
        return true
    }
    pub fn clear(&mut self) {
        for self.length != 0 {
            core.drop(self.pop())
        }
    }
    fn drop(&mut self) {
        self.clear()
        if self.reserved != 0 {
            // Every stored capacity was validated by reserve.
            match layout.array::<T>(self.reserved) {
                ok(requested) => {
                    unsafe {
                        allocation := block.Block.from_raw_parts(self.pointer as *mut u8, requested)
                        self.allocator.deallocate(allocation)
                    }
                },
                err(_) => {},
            }
        }
    }
}

// SAFETY: A must keep all allocations unique, aligned, valid until deallocate,
// and alive while the capability lives. No allocation occurs in new.
pub unsafe fn new<T, A>(allocator: A) -> Vector<T, A> from(allocator) {
    mem.storage_type::<T>()
    unsafe {
        return Vector<T, A> { elements: [], allocator: allocator, pointer: mem.align_of::<T>() as *mut T, length: 0, reserved: 0 }
    }
}
