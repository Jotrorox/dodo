package shared_heap

import "alloc/shared_arena"
import "std/collections/heap"

// Safe adapter for the checked single-threaded shared arena capability.
pub fn new<T, C>(allocator: shared_arena.Handle, policy: C) -> heap.Heap<T, C, shared_arena.Handle> from(allocator, policy) {
    unsafe {
        return heap.new::<T, C, shared_arena.Handle>(allocator, policy)
    }
}
