package shared_ordered_map

import "alloc/shared_arena"
import "std/collections/ordered_map"

// Safe adapter for the checked single-threaded shared arena capability.
pub fn new<K, V, C>(allocator: shared_arena.Handle, policy: C) -> ordered_map.Map<K, V, C, shared_arena.Handle> from(allocator, policy) {
    unsafe {
        return ordered_map.new::<K, V, C, shared_arena.Handle>(allocator, policy)
    }
}
