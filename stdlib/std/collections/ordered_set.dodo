package ordered_set

import "alloc/error"
import "std/collections/ordered_map"

pub struct Unit {}
pub struct Set<T, C, A> {
    map: ordered_map.Map<T, Unit, C, A>
    pub fn len(&self) -> usize {
        return self.map.len()
    }
    pub fn capacity(&self) -> usize {
        return self.map.capacity()
    }
    pub fn contains(&self, value: &T) -> bool {
        return self.map.contains(value)
    }
    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.map.len() {
            return none
        }
        return some(&self.map.entries()[index].key)
    }
    pub fn insert(&mut self, value: T) -> bool!error.AllocError {
        match self.map.insert(value, Unit {})? {
            some(_) => {
                return ok(false)
            }, none => {
                return ok(true)
            },
        }
    }
    pub fn remove(&mut self, value: &T) -> bool {
        match self.map.remove(value) {
            some(_) => {
                return true
            }, none => {
                return false
            },
        }
    }
    pub fn clear(&mut self) {
        self.map.clear()
    }
}
// SAFETY: allocator must satisfy vector.new's capability contract.
pub unsafe fn new<T, C, A>(allocator: A, ordering: C) -> Set<T, C, A> from(allocator, ordering) {
    unsafe {
        return Set<T, C, A> { map: ordered_map.new::<T, Unit, C, A>(allocator, ordering) }
    }
}
