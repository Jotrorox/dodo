package shared_deque

import "alloc/shared_arena"
import "std/collections/deque"

// Safe adapter for the checked single-threaded shared arena capability.
pub fn new<T>(allocator: shared_arena.Handle) -> deque.Deque<T, shared_arena.Handle> from(allocator) {
    unsafe {
        return deque.new::<T, shared_arena.Handle>(allocator)
    }
}
