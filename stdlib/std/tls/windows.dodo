package windows

pub unsafe extern "C" fn dodo_tls_new(server: i32, hostname: *const u8, hostname_len: usize, roots: *const u8, roots_len: usize, certificate: *const u8, certificate_len: usize, key: *const u8, key_len: usize, alpn: *const u8, alpn_len: usize, system_roots: i32, client_auth: i32, verify_time: i64, error: *mut i32) -> *mut u8
pub unsafe extern "C" fn dodo_tls_free(state: *mut u8)
pub unsafe extern "C" fn dodo_tls_handshake(state: *mut u8, error: *mut i32) -> i32
pub unsafe extern "C" fn dodo_tls_feed(state: *mut u8, bytes: *const u8, count: usize, actual: *mut usize) -> i32
pub unsafe extern "C" fn dodo_tls_drain(state: *mut u8, bytes: *mut u8, count: usize, actual: *mut usize) -> i32
pub unsafe extern "C" fn dodo_tls_read(state: *mut u8, bytes: *mut u8, count: usize, actual: *mut usize, error: *mut i32) -> i32
pub unsafe extern "C" fn dodo_tls_write(state: *mut u8, bytes: *const u8, count: usize, actual: *mut usize, error: *mut i32) -> i32
pub unsafe extern "C" fn dodo_tls_flush(state: *mut u8, error: *mut i32) -> i32
pub unsafe extern "C" fn dodo_tls_shutdown(state: *mut u8, error: *mut i32) -> i32
pub unsafe extern "C" fn dodo_tls_eof(state: *mut u8)
pub unsafe extern "C" fn dodo_tls_alpn(state: *mut u8, bytes: *mut u8, capacity: usize) -> i32
