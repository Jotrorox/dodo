    output[1] = 139
    output[2] = 8
    for i in 3usize..9 {
        output[i] = 0
    }
    output[9] = 255
    written := match deflate_dynamic.encode_level(input, &mut output[10..output.len - 8], level) {
        ok(count) => {
            count
        },
        err(_) => {
            return err(Error.OutputFull)
        },
    }
    offset := 10 + written
    sum := checksum.crc32(input)
    size := (input.len & 0xffffffffusize) as u32
    for i in 0usize..4 {
        output[offset + i] = ((sum >> ((i * 8) as u32)) & 255) as u8
        output[offset + 4 + i] = ((size >> ((i * 8) as u32)) & 255) as u8
    }
    return ok(offset + 8)
}

// Compress with reusable caller-owned match-finder storage.
pub fn encode_fixed_with_workspace(input: &[u8], output: &mut[u8], level: usize, workspace: &mut deflate_workspace.Workspace) -> usize!Error {
    if level > 9 {
        return err(Error.InvalidData)
    }
    if output.len < 18 {
        return err(Error.OutputFull)
    }
    output[0] = 31
    output[1] = 139
    output[2] = 8
    for i in 3usize..9 {
        output[i] = 0
    }
    output[9] = 255
    written := match deflate_fixed.encode_with_workspace(input, &mut output[10..output.len - 8], level, workspace) {
        ok(count) => {
            count
        },
        err(_) => {
            return err(Error.OutputFull)
        },
    }
    offset := 10 + written
    sum := checksum.crc32(input)
    size := (input.len & 0xffffffffusize) as u32
    for i in 0usize..4 {
        output[offset + i] = ((sum >> ((i * 8) as u32)) & 255) as u8
        output[offset + 4 + i] = ((size >> ((i * 8) as u32)) & 255) as u8
    }
    return ok(offset + 8)
}

