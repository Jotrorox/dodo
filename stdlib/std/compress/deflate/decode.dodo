package deflate

// LSB-first reader over a complete input. position ends at the byte holding
// the last bit read, so a wrapper's trailer starts right after it.
struct BitReader {
    input: &[u8]
    position: usize
    bits: u32
    count: usize
    fn read(&mut self, n: usize) -> usize!Error {
        for self.count < n {
            if self.position == self.input.len {
                return err(Error.Truncated)
            }
            self.bits = self.bits | ((self.input[self.position] as u32) << (self.count as u32))
            self.position += 1
            self.count += 8
        }
        value := self.bits & ((1u32 << (n as u32)) - 1)
        self.bits = self.bits >> (n as u32)
        self.count -= n
        return ok(value as usize)
    }
    // Stored blocks start at a byte boundary. Fewer than eight bits are
    // buffered, all from the current byte.
    fn align(&mut self) {
        self.bits = 0
        self.count = 0
    }
    fn symbol(&mut self, t: &Tree) -> usize!Error {
        code := 0usize
        first := 0usize
        index := 0usize
        for length in 1usize..16 {
            code = code | self.read(1)?
            count := t.counts[length]
            if code - first < count {
                return ok(t.symbols[index + code - first])
            }
            index += count
            first = (first + count) << 1
            code = code << 1
        }
        return err(Error.InvalidData)
    }
}

// Decodes one complete raw DEFLATE stream into output and stops after its
// final block. Expansion is limited by output.len; on error the output
// contents are unspecified.
pub fn decode(input: &[u8], output: &mut[u8]) -> DecodeResult!Error {
    return decode_with_window(input, output, WINDOW_SIZE)
}
// Like decode, but rejects distances beyond window, which must be 1 through
// WINDOW_SIZE. zlib uses this for windows its header declares smaller.
pub fn decode_with_window(input: &[u8], output: &mut[u8], window: usize) -> DecodeResult!Error {
    if window == 0 || window > WINDOW_SIZE {
        return err(Error.InvalidData)
    }
    reader := BitReader { input: input, position: 0, bits: 0, count: 0 }
    lit := empty_tree()
    dist := empty_tree()
    written := 0usize
    final_block := false
    for !final_block {
        final_block = reader.read(1)? != 0
        kind := reader.read(2)?
        if kind == 0 {
            reader.align()
            len := reader.read(16)?
            if (len ^ reader.read(16)?) != 0xffff {
                return err(Error.InvalidData)
            }
            if len > input.len - reader.position {
                return err(Error.Truncated)
            }
            if len > output.len - written {
                return err(Error.OutputFull)
            }
            for i in 0usize..len {
                output[written + i] = input[reader.position + i]
            }
            reader.position += len
            written += len
            continue
        }
        if kind == 1 {
            fixed_trees(&mut lit, &mut dist)
        } else if kind == 2 {
            read_dynamic_trees(&mut reader, &mut lit, &mut dist)?
        } else {
            return err(Error.InvalidData)
        }
        for {
            s := reader.symbol(&lit)?
            if s < 256 {
                if written == output.len {
                    return err(Error.OutputFull)
                }
                output[written] = s as u8
                written += 1
                continue
            }
            if s == 256 {
                break
            }
            if s > 285 {
                return err(Error.InvalidData)
            }
            count := LENGTH_BASE[s - 257] + reader.read(LENGTH_EXTRA[s - 257])?
            d := reader.symbol(&dist)?
            if d >= 30 {
                return err(Error.InvalidData)
            }
            distance := DIST_BASE[d] + reader.read(DIST_EXTRA[d])?
            if distance > written || distance > window {
                return err(Error.InvalidData)
            }
            if count > output.len - written {
                return err(Error.OutputFull)
            }
            for i in 0usize..count {
                output[written] = output[written - distance]
                written += 1
            }
        }
    }
    return ok(DecodeResult { input_consumed: reader.position, output_written: written })
}
fn read_dynamic_trees(reader: &mut BitReader, lit: &mut Tree, dist: &mut Tree) -> void!Error {
    nlit := reader.read(5)? + 257
    ndist := reader.read(5)? + 1
    ncode := reader.read(4)? + 4
    if nlit > 286 {
        return err(Error.InvalidData)
    }
    code_lengths := [0u8; 19]
    for i in 0usize..ncode {
        code_lengths[CODE_ORDER[i]] = reader.read(3)? as u8
    }
    codes := empty_tree()
    build_code_length_tree(&mut codes, &code_lengths)?
    lengths := [0u8; 318]
    total := nlit + ndist
    i := 0usize
    for i < total {
        s := reader.symbol(&codes)?
        if s < 16 {
            lengths[i] = s as u8
            i += 1
            continue
        }
        count := 0usize
        value := 0u8
        if s == 16 {
            if i == 0 {
                return err(Error.InvalidData)
            }
            count = 3 + reader.read(2)?
            value = lengths[i - 1]
        } else if s == 17 {
            count = 3 + reader.read(3)?
        } else {
            count = 11 + reader.read(7)?
        }
        if count > total - i {
            return err(Error.InvalidData)
        }
        for j in 0usize..count {
            lengths[i + j] = value
        }
        i += count
    }
    return build_block_trees(lit, dist, &lengths[..total], nlit)
}
// The code-length alphabet must be complete, even with a single code.
fn build_code_length_tree(codes: &mut Tree, code_lengths: &[u8]) -> void!Error {
    build_tree(codes, code_lengths, false)?
    if codes.counts[0] == 18 {
        return err(Error.InvalidData)
    }
    return ok()
}
fn build_block_trees(lit: &mut Tree, dist: &mut Tree, lengths: &[u8], nlit: usize) -> void!Error {
    if lengths[256] == 0 {
        return err(Error.InvalidData)
    }
    build_tree(lit, &lengths[..nlit], false)?
    build_tree(dist, &lengths[nlit..], true)?
    return ok()
}
