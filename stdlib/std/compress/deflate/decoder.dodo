package deflate

const MODE_HEADER: usize = 0
const MODE_STORED_LEN: usize = 1
const MODE_STORED_NLEN: usize = 2
const MODE_STORED_COPY: usize = 3
const MODE_TABLE_SIZES: usize = 4
const MODE_CODE_LENGTHS: usize = 5
const MODE_LENGTHS: usize = 6
const MODE_REPEAT: usize = 7
const MODE_SYMBOL: usize = 8
const MODE_LENGTH_EXTRA: usize = 9
const MODE_DISTANCE: usize = 10
const MODE_DISTANCE_EXTRA: usize = 11
const MODE_COPY: usize = 12
const MODE_LITERAL: usize = 13
const MODE_DONE: usize = 14
const MODE_FAILED: usize = 15

const TREE_LIT: usize = 0
const TREE_DIST: usize = 1
const TREE_CODES: usize = 2

// Incremental raw DEFLATE decoder with its own 32 KiB history, so output may
// be delivered in buffers of any size. It never reads past the stream's last
// byte, leaving any trailer or following data to the caller.
pub struct Decoder {
    bits: u32
    bit_count: usize
    value: usize
    mode: usize
    final_block: bool
    max_distance: usize
    window: [32768]u8
    window_pos: usize
    history: usize
    lit: Tree
    dist: Tree
    codes: Tree
    lengths: [318]u8
    code_lengths: [19]u8
    nlit: usize
    ndist: usize
    ncode: usize
    index: usize
    pending: usize
    extra: usize
    distance: usize
    sym_code: usize
    sym_first: usize
    sym_index: usize
    sym_len: usize
    pub fn new() -> Decoder {
        return Decoder { bits: 0, bit_count: 0, value: 0, mode: MODE_HEADER, final_block: false,
        max_distance: WINDOW_SIZE, window: [0u8; 32768], window_pos: 0, history: 0,
        lit: empty_tree(), dist: empty_tree(), codes: empty_tree(), lengths: [0u8; 318],
        code_lengths: [0u8; 19], nlit: 0, ndist: 0, ncode: 0, index: 0,
        pending: 0, extra: 0, distance: 0,
        sym_code: 0, sym_first: 0, sym_index: 0, sym_len: 1 }
    }
    // Rejects distances beyond window, which must be 1 through WINDOW_SIZE.
    pub fn new_with_window(window: usize) -> Decoder!Error {
        if window == 0 || window > WINDOW_SIZE {
            return err(Error.InvalidData)
        }
        d := Decoder.new()
        d.max_distance = window
        return ok(d)
    }
    // Returns the decoder to its initial state, keeping its window limit.
    pub fn reset(&mut self) {
        self.bits = 0
        self.bit_count = 0
        self.mode = MODE_HEADER
        self.final_block = false
        self.window_pos = 0
        self.history = 0
        self.sym_code = 0
        self.sym_first = 0
        self.sym_index = 0
        self.sym_len = 1
    }
    pub fn is_done(&self) -> bool {
        return self.mode == MODE_DONE
    }
    fn read(&mut self, n: usize, input: &[u8], pos: &mut usize) -> bool {
        for self.bit_count < n {
            if *pos == input.len {
                return false
            }
            self.bits = self.bits | ((input[*pos] as u32) << (self.bit_count as u32))
            *pos += 1
            self.bit_count += 8
        }
        self.value = (self.bits & ((1u32 << (n as u32)) - 1)) as usize
        self.bits = self.bits >> (n as u32)
        self.bit_count -= n
        return true
    }
    // Decodes one symbol into value, resuming a partially read code. Returns
    // false when input runs out first.
    fn symbol(&mut self, which: usize, input: &[u8], pos: &mut usize) -> bool!Error {
        for self.sym_len < 16 {
            if !self.read(1, input, pos) {
                return ok(false)
            }
            self.sym_code = self.sym_code | self.value
            count := 0usize
            if which == TREE_LIT {
                count = self.lit.counts[self.sym_len]
            } else if which == TREE_DIST {
                count = self.dist.counts[self.sym_len]
            } else {
                count = self.codes.counts[self.sym_len]
            }
            if self.sym_code - self.sym_first < count {
                at := self.sym_index + self.sym_code - self.sym_first
                if which == TREE_LIT {
                    self.value = self.lit.symbols[at]
                } else if which == TREE_DIST {
                    self.value = self.dist.symbols[at]
                } else {
                    self.value = self.codes.symbols[at]
                }
                self.sym_code = 0
                self.sym_first = 0
                self.sym_index = 0
                self.sym_len = 1
                return ok(true)
            }
            self.sym_index += count
            self.sym_first = (self.sym_first + count) << 1
            self.sym_code = self.sym_code << 1
            self.sym_len += 1
        }
        return err(Error.InvalidData)
    }
    fn emit(&mut self, value: u8, output: &mut[u8], pos: &mut usize) {
        output[*pos] = value
        *pos += 1
        self.window[self.window_pos] = value
        self.window_pos = (self.window_pos + 1) & (WINDOW_SIZE - 1)
        if self.history < WINDOW_SIZE {
            self.history += 1
        }
    }
    fn end_block(&mut self) {
        if self.final_block {
            self.mode = MODE_DONE
        } else {
            self.mode = MODE_HEADER
        }
    }
    // Decodes as much as input and output allow. Either may be empty. Counts
    // cover this call only. Errors are final: later calls repeat InvalidData.
    pub fn process(&mut self, input: &[u8], output: &mut[u8]) -> Progress!Error {
        ip := 0usize
        op := 0usize
        match self.step(input, output, &mut ip, &mut op) {
            ok(status) => {
                return ok(progress(ip, op, status))
            },
            err(reason) => {
                self.mode = MODE_FAILED
                return err(reason)
            },
        }
    }
    fn step(&mut self, input: &[u8], output: &mut[u8], ip: &mut usize, op: &mut usize) -> Status!Error {
        for {
            mode := self.mode
            if mode == MODE_HEADER {
                if !self.read(3, input, ip) {
                    return ok(Status.NeedInput)
                }
                self.final_block = (self.value & 1) != 0
                kind := self.value >> 1
                if kind == 0 {
                    self.bits = 0
                    self.bit_count = 0
                    self.mode = MODE_STORED_LEN
                } else if kind == 1 {
                    fixed_trees(&mut self.lit, &mut self.dist)
                    self.mode = MODE_SYMBOL
                } else if kind == 2 {
                    self.mode = MODE_TABLE_SIZES
                } else {
                    return err(Error.InvalidData)
                }
            } else if mode == MODE_STORED_LEN {
                if !self.read(16, input, ip) {
                    return ok(Status.NeedInput)
                }
                self.pending = self.value
                self.mode = MODE_STORED_NLEN
            } else if mode == MODE_STORED_NLEN {
                if !self.read(16, input, ip) {
                    return ok(Status.NeedInput)
                }
                if (self.pending ^ self.value) != 0xffff {
                    return err(Error.InvalidData)
                }
                self.mode = MODE_STORED_COPY
            } else if mode == MODE_STORED_COPY {
                // The reader is byte aligned here, so copy whole bytes.
                for self.pending > 0 {
                    if *op == output.len {
                        return ok(Status.NeedOutput)
                    }
                    if *ip == input.len {
                        return ok(Status.NeedInput)
                    }
                    byte := input[*ip]
                    *ip += 1
                    self.emit(byte, output, op)
                    self.pending -= 1
                }
                self.end_block()
            } else if mode == MODE_TABLE_SIZES {
                if !self.read(14, input, ip) {
                    return ok(Status.NeedInput)
                }
                self.nlit = (self.value & 31) + 257
                self.ndist = ((self.value >> 5) & 31) + 1
                self.ncode = ((self.value >> 10) & 15) + 4
                if self.nlit > 286 {
                    return err(Error.InvalidData)
                }
                self.code_lengths = [0u8; 19]
                self.index = 0
                self.mode = MODE_CODE_LENGTHS
            } else if mode == MODE_CODE_LENGTHS {
                for self.index < self.ncode {
                    if !self.read(3, input, ip) {
                        return ok(Status.NeedInput)
                    }
                    self.code_lengths[CODE_ORDER[self.index]] = self.value as u8
                    self.index += 1
                }
                build_code_length_tree(&mut self.codes, &self.code_lengths)?
                self.index = 0
                self.mode = MODE_LENGTHS
            } else if mode == MODE_LENGTHS {
                total := self.nlit + self.ndist
                if self.index == total {
                    build_block_trees(&mut self.lit, &mut self.dist, &self.lengths[..total], self.nlit)?
                    self.mode = MODE_SYMBOL
                } else {
                    if !self.symbol(TREE_CODES, input, ip)? {
                        return ok(Status.NeedInput)
                    }
                    if self.value < 16 {
                        self.lengths[self.index] = self.value as u8
                        self.index += 1
                    } else {
                        if self.value == 16 && self.index == 0 {
                            return err(Error.InvalidData)
                        }
                        self.pending = self.value
                        self.mode = MODE_REPEAT
                    }
                }
            } else if mode == MODE_REPEAT {
                n := 2usize
                base := 3usize
                if self.pending == 17 {
                    n = 3
                } else if self.pending == 18 {
                    n = 7
                    base = 11
                }
                if !self.read(n, input, ip) {
                    return ok(Status.NeedInput)
                }
                count := self.value + base
                byte := 0u8
                if self.pending == 16 {
                    byte = self.lengths[self.index - 1]
                }
                if count > self.nlit + self.ndist - self.index {
                    return err(Error.InvalidData)
                }
                for i in 0usize..count {
                    self.lengths[self.index + i] = byte
                }
                self.index += count
                self.mode = MODE_LENGTHS
            } else if mode == MODE_SYMBOL {
                if !self.symbol(TREE_LIT, input, ip)? {
                    return ok(Status.NeedInput)
                }
                if self.value < 256 {
                    self.mode = MODE_LITERAL
                } else if self.value == 256 {
                    self.end_block()
                } else {
                    if self.value > 285 {
                        return err(Error.InvalidData)
                    }
                    self.pending = LENGTH_BASE[self.value - 257]
                    self.extra = LENGTH_EXTRA[self.value - 257]
                    self.mode = MODE_LENGTH_EXTRA
                }
            } else if mode == MODE_LITERAL {
                if *op == output.len {
                    return ok(Status.NeedOutput)
                }
                byte := self.value as u8
                self.emit(byte, output, op)
                self.mode = MODE_SYMBOL
            } else if mode == MODE_LENGTH_EXTRA {
                extra := self.extra
                if !self.read(extra, input, ip) {
                    return ok(Status.NeedInput)
                }
                self.pending += self.value
                self.mode = MODE_DISTANCE
            } else if mode == MODE_DISTANCE {
                if !self.symbol(TREE_DIST, input, ip)? {
                    return ok(Status.NeedInput)
                }
                if self.value >= 30 {
                    return err(Error.InvalidData)
                }
                self.distance = DIST_BASE[self.value]
                self.extra = DIST_EXTRA[self.value]
                self.mode = MODE_DISTANCE_EXTRA
            } else if mode == MODE_DISTANCE_EXTRA {
                extra := self.extra
                if !self.read(extra, input, ip) {
                    return ok(Status.NeedInput)
                }
                self.distance += self.value
                if self.distance > self.history || self.distance > self.max_distance {
                    return err(Error.InvalidData)
                }
                self.mode = MODE_COPY
            } else if mode == MODE_COPY {
                for self.pending > 0 {
                    if *op == output.len {
                        return ok(Status.NeedOutput)
                    }
                    source := (self.window_pos + WINDOW_SIZE - self.distance) & (WINDOW_SIZE - 1)
                    byte := self.window[source]
                    self.emit(byte, output, op)
                    self.pending -= 1
                }
                self.mode = MODE_SYMBOL
            } else if mode == MODE_DONE {
                return ok(Status.Done)
            } else {
                return err(Error.InvalidData)
            }
        }
    }
}
