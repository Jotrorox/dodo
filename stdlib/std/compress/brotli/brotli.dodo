package brotli

// RFC 7932 Brotli decompression with caller-supplied buffers and no
// allocation. Every meta-block kind (compressed, uncompressed, metadata,
// empty last) is decoded, with block types and block counts for all three
// categories, the four literal context modes, distance context maps,
// NPOSTFIX/NDIRECT distance codes, the distance ring buffer, and the static
// dictionary with all 121 transforms (tables.dodo, generated by
// scripts/generate_brotli_tables.py). Window sizes 10 to 24 are supported;
// large-window Brotli (a non-standard extension) fails with Unsupported.
//
// Memory: the decoded bytes live in a caller window. decompress() writes into
// the output buffer and uses it as the window; Decoder keeps a ring buffer of
// at least window_len(input) bytes and hands out the data in pieces. Prefix
// code tables, context maps and the other per-meta-block state live in a
// `u16` workspace: a meta-block needs a few thousand words for typical
// streams and at most WORKSPACE_LEN words for any valid one. decompress()
// keeps STACK_WORKSPACE_LEN words (256 KiB) on the stack; streams that need
// more fail with WorkspaceTooSmall, and decompress_with_workspace() or
// Decoder take a caller workspace of any size instead.
//
// Untrusted input never traps: every length and index is checked. A stream
// whose transformed dictionary word is empty is rejected (libbrotli rejects
// most such words too), so every command produces output and decoding time
// is bounded by the output size. The one-shot functions reject bytes after
// the end of the stream, as the brotli tool does; Decoder ignores them and
// input_consumed() reports where the stream ended.

pub enum Error {
    // The input ended inside the stream.
    Truncated,
    // The stream is malformed.
    InvalidData,
    // The output buffer of decompress() cannot hold the decompressed data.
    OutputFull,
    // The Decoder window is shorter than the stream's sliding window and
    // the decompressed data does not fit in it.
    WindowTooSmall,
    // The workspace cannot hold one meta-block's prefix code tables and
    // context maps; WORKSPACE_LEN words always suffice.
    WorkspaceTooSmall,
    // Large-window Brotli.
    Unsupported
}

// Workspace words that hold the tables of any valid meta-block: 256
// literal, 256 insert-and-copy and 256 distance prefix codes at their
// largest two-level table sizes, the block-switch codes, both context maps
// and the literal context modes.
pub const WORKSPACE_LEN: usize = 690956
// Workspace words decompress() keeps on the stack.
pub const STACK_WORKSPACE_LEN: usize = 131072
// The largest sliding window, for window size 24.
pub const MAX_WINDOW_LEN: usize = 16777216

// Decompresses one stream into output and returns its length. The output
// buffer is also the window, so no other memory is needed beyond 256 KiB of
// stack workspace (see STACK_WORKSPACE_LEN). Input after the end of the
// stream is InvalidData. On error the output contents are unspecified.
pub fn decompress(input: &[u8], output: &mut[u8]) -> usize!Error {
    words := [0u16; STACK_WORKSPACE_LEN]
    return decompress_with_workspace(input, output, &mut words)
}

// decompress() with a caller-owned workspace, which may live in static
// storage; WORKSPACE_LEN words decode every valid stream.
pub fn decompress_with_workspace(input: &[u8], output: &mut[u8], workspace: &mut[u16]) -> usize!Error {
    decoder := Decoder.start(input, output, workspace, true)?
    decoder.step()?
    if decoder.input_consumed() != input.len {
        return err(Error.InvalidData)
    }
    return ok(decoder.produced())
}

// The window length a Decoder needs for this stream: the stream's sliding
// window size (1 << WBITS, at most MAX_WINDOW_LEN), or the decompressed
// length when the stream holds a single meta-block that is shorter. Only
// the header is read.
pub fn window_len(input: &[u8]) -> usize!Error {
    window := [0u8; 1]
    words := [0u16; 1]
    decoder := Decoder.start(input, &mut window, &mut words, false)?
    return decoder.first_window()
}

// The decompressed length of a stream, found by decoding it through a
// window of window_len(input) or more bytes and discarding the data.
pub fn decompressed_size(input: &[u8], window: &mut[u8], workspace: &mut[u16]) -> usize!Error {
    decoder := Decoder.new(input, window, workspace)?
    size := decoder.skip_to_end()?
    if decoder.input_consumed() != input.len {
        return err(Error.InvalidData)
    }
    return ok(size)
}
