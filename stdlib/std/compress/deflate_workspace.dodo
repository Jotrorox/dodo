package deflate_workspace

// Reusable LZ77 match-finder storage. Arrays contain positions encoded as
// position + 1. Encoders reset them on each call, so they can be reused.
// Footprint is 36,864 usize values (294,912 bytes on 64-bit targets).
pub struct Workspace {
    pub heads: [4096]usize
    pub links: [32768]usize
    pub fn new() -> Workspace {
        return Workspace { heads: [0usize; 4096], links: [0usize; 32768] }
    }
    pub fn reset(&mut self) {
        for i in 0usize..4096 {
            self.heads[i] = 0
        }
        for i in 0usize..32768 {
            self.links[i] = 0
        }
    }
}
