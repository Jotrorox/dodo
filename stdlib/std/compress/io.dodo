package io

import "std/io" as streamio
import "core/mem"
import "std/compress/deflate_store"
import "std/compress/zlib_store"
import "std/compress/gzip_store"
import "std/compress/inflate"
import "std/compress/zlib_stream"
import "std/compress/gzip_stream"

// A checked decoding reader distinguishes device failures from malformed data,
// checksum failures, unsupported dictionaries, and truncated streams.
pub enum ErrorKind {
    Io, Truncated, InvalidData, ChecksumMismatch, UnsupportedDictionary
}
pub struct Error {
    pub kind: ErrorKind
    pub transferred: usize
    pub cause: streamio.Error
}
pub enum Status {
    NeedInput, NeedOutput, Done
}
pub struct Progress {
    pub input_consumed: usize, pub output_written: usize, pub status: Status
}
pub struct CodecError {
    pub kind: ErrorKind;
    pub input_consumed: usize;
    pub output_written: usize
}
pub interface Codec {
    fn process(&mut self, input: &[u8], output: &mut[u8]) -> Progress!CodecError
}
pub struct Raw {
    decoder: inflate.Decoder
    pub fn new() -> Raw {
        return Raw { decoder: inflate.Decoder.new() }
    }
    pub fn process(&mut self, input: &[u8], output: &mut[u8]) -> Progress!CodecError {
        p := match self.decoder.process(input, output) {
            ok(value) => {
                value
            }, err(_) => {
                return err(CodecError { kind: ErrorKind.InvalidData, input_consumed: self.decoder.last_input_consumed(), output_written: self.decoder.last_output_written() })
            }
        }
        s := Status.NeedInput
        match &p.status {
            inflate.Status.NeedInput => {
                s = Status.NeedInput
            },
            inflate.Status.NeedOutput => {
                s = Status.NeedOutput
            },
            inflate.Status.Done => {
                s = Status.Done
            },
        }
        return ok(Progress { input_consumed: p.input_consumed, output_written: p.output_written, status: s })
    }
}
pub struct Zlib {
    decoder: zlib_stream.Decoder
    pub fn new() -> Zlib {
        return Zlib { decoder: zlib_stream.Decoder.new() }
    }
    pub fn process(&mut self, input: &[u8], output: &mut[u8]) -> Progress!CodecError {
        p := match self.decoder.process(input, output) {
            ok(value) => {
                value
            },
            err(e) => {
                match e {
                    zlib_stream.Error.InvalidData => {
                        return err(CodecError { kind: ErrorKind.InvalidData, input_consumed: self.decoder.last_input_consumed(), output_written: self.decoder.last_output_written() })
                    },
                    zlib_stream.Error.ChecksumMismatch => {
                        return err(CodecError { kind: ErrorKind.ChecksumMismatch, input_consumed: self.decoder.last_input_consumed(), output_written: self.decoder.last_output_written() })
                    },
                    zlib_stream.Error.UnsupportedDictionary => {
                        return err(CodecError { kind: ErrorKind.UnsupportedDictionary, input_consumed: self.decoder.last_input_consumed(), output_written: self.decoder.last_output_written() })
                    },
                }
            },
        }
        s := Status.NeedInput
        match &p.status {
            zlib_stream.Status.NeedInput => {
                s = Status.NeedInput
            },
            zlib_stream.Status.NeedOutput => {
                s = Status.NeedOutput
            },
            zlib_stream.Status.Done => {
                s = Status.Done
            },
        }
        return ok(Progress { input_consumed: p.input_consumed, output_written: p.output_written, status: s })
    }
}
pub struct Gzip {
    decoder: gzip_stream.Decoder
    pub fn new() -> Gzip {
        return Gzip { decoder: gzip_stream.Decoder.new() }
    }
    pub fn process(&mut self, input: &[u8], output: &mut[u8]) -> Progress!CodecError {
        p := match self.decoder.process(input, output) {
            ok(value) => {
                value
            },
            err(e) => {
                match e {
                    gzip_stream.Error.InvalidData => {
                        return err(CodecError { kind: ErrorKind.InvalidData, input_consumed: self.decoder.last_input_consumed(), output_written: self.decoder.last_output_written() })
                    },
                    gzip_stream.Error.ChecksumMismatch => {
                        return err(CodecError { kind: ErrorKind.ChecksumMismatch, input_consumed: self.decoder.last_input_consumed(), output_written: self.decoder.last_output_written() })
                    },
                }
            },
        }
        s := Status.NeedInput
        match &p.status {
            gzip_stream.Status.NeedInput => {
                s = Status.NeedInput
            },
            gzip_stream.Status.NeedOutput => {
                s = Status.NeedOutput
            },
            gzip_stream.Status.Done => {
                s = Status.Done
            },
        }
        return ok(Progress { input_consumed: p.input_consumed, output_written: p.output_written, status: s })
    }
}
// Reads only as far as the end of one stream, leaving a following stream or
// trailer in the source. Read errors carrying a byte are deferred until that
// byte has been consumed, with produced output included in transferred.
pub struct Reader<R: streamio.Reader, C: Codec> {
    source: &mut R
    codec: C
    byte: [1]u8
    have: usize
    done: bool
    failed: bool
    reason: streamio.Error
    pub fn new(source: &mut R, codec: C) -> Reader<R, C> from(source) {
        return Reader<R, C> { source: source, codec: codec, byte: [0u8; 1], have: 0, done: false, failed: false, reason: streamio.failure(streamio.ErrorKind.Other, 0) }
    }
    pub fn read_checked(&mut self, output: &mut[u8]) -> usize!Error {
        if output.len == 0 || self.done {
            return ok(0)
        }
        written := 0usize
        for true {
            progress := match self.codec.process(&self.byte[..self.have], &mut output[written..]) {
                ok(value) => {
                    value
                },
                err(reason) => {
                    if reason.input_consumed > self.have || reason.output_written > output.len - written {
                        return err(Error { kind: ErrorKind.Io, transferred: written, cause: streamio.failure(streamio.ErrorKind.InvalidProgress, 0) })
                    }
                    self.have -= reason.input_consumed
                    written += reason.output_written
                    kind := mem.replace(&mut reason.kind, ErrorKind.InvalidData)
                    return err(Error { kind: kind, transferred: written, cause: streamio.failure(streamio.ErrorKind.InvalidInput, 0) })
                },
            }
            if progress.input_consumed > self.have || progress.output_written > output.len - written {
                return err(Error { kind: ErrorKind.Io, transferred: written, cause: streamio.failure(streamio.ErrorKind.InvalidProgress, 0) })
            }
            self.have -= progress.input_consumed
            written += progress.output_written
            if self.have == 0 && self.failed {
                self.failed = false
                reason := mem.replace(&mut self.reason, streamio.failure(streamio.ErrorKind.Other, 0))
                return err(Error { kind: ErrorKind.Io, transferred: written, cause: reason })
            }
            match &progress.status {
                Status.Done => {
                    self.done = true;
                    return ok(written)
                },
                Status.NeedOutput => {
                    return ok(written)
                },
                Status.NeedInput => {
                    if self.have != 0 {
                        return err(Error { kind: ErrorKind.InvalidData, transferred: written, cause: streamio.failure(streamio.ErrorKind.Other, 0) })
                    }
                    match streamio.read_once(self.source, &mut self.byte) {
                        ok(count) => {
                            if count == 0 {
                                return err(Error { kind: ErrorKind.Truncated, transferred: written, cause: streamio.failure(streamio.ErrorKind.UnexpectedEof, 0) })
                            }
                            self.have = count
                        },
                        err(reason) => {
                            self.have = reason.transferred
                            if reason.kind == streamio.ErrorKind.Interrupted {
                                // Process any returned byte and retry.
                            } else if self.have == 0 {
                                return err(Error { kind: ErrorKind.Io, transferred: written, cause: reason })
                            } else {
                                self.reason = reason
                                self.failed = true
                            }
                        },
                    }
                },
            }
        }
        return ok(written)
    }
    // streamio.Reader compatibility. Use read_checked to inspect format errors.
    pub fn read(&mut self, output: &mut[u8]) -> usize!streamio.Error {
        match self.read_checked(output) {
            ok(count) => {
                return ok(count)
            },
            err(reason) => {
                if reason.kind == ErrorKind.Io {
                    error := mem.replace(&mut reason.cause, streamio.failure(streamio.ErrorKind.Other, 0))
                    error.transferred = reason.transferred
                    return err(error)
                }
                kind := streamio.ErrorKind.InvalidInput
                if reason.kind == ErrorKind.Truncated {
                    kind = streamio.ErrorKind.UnexpectedEof
                }
                return err(streamio.failure(kind, reason.transferred))
            },
        }
    }
}

// Streaming stored-block encoders. These adapters write valid streams without
// compression; use finish() and handle its result before discarding a writer.

pub interface EncoderCodec {
    fn process(&mut self, input: &[u8], output: &mut[u8], finish: bool) -> Progress
}
pub struct RawEncoder {
    encoder: deflate_store.Encoder
    pub fn new() -> RawEncoder {
        return RawEncoder { encoder: deflate_store.Encoder.new() }
    }
    pub fn process(&mut self, input: &[u8], output: &mut[u8], finish: bool) -> Progress {
        p := self.encoder.process(input, output, finish)
        s := Status.NeedInput
        match &p.status {
            deflate_store.Status.NeedInput => {
                s = Status.NeedInput
            },
            deflate_store.Status.NeedOutput => {
                s = Status.NeedOutput
            },
            deflate_store.Status.Done => {
                s = Status.Done
            },
        }
        return Progress { input_consumed: p.input_consumed, output_written: p.output_written, status: s }
    }
}
pub struct ZlibEncoder {
    encoder: zlib_store.Encoder
    pub fn new() -> ZlibEncoder {
        return ZlibEncoder { encoder: zlib_store.Encoder.new() }
    }
    pub fn process(&mut self, input: &[u8], output: &mut[u8], finish: bool) -> Progress {
        p := self.encoder.process(input, output, finish)
        s := Status.NeedInput
        match &p.status {
            zlib_store.Status.NeedInput => {
                s = Status.NeedInput
            },
            zlib_store.Status.NeedOutput => {
                s = Status.NeedOutput
            },
            zlib_store.Status.Done => {
                s = Status.Done
            },
        }
        return Progress { input_consumed: p.input_consumed, output_written: p.output_written, status: s }
    }
}
pub struct GzipEncoder {
    encoder: gzip_store.Encoder
    pub fn new() -> GzipEncoder {
        return GzipEncoder { encoder: gzip_store.Encoder.new() }
    }
    pub fn process(&mut self, input: &[u8], output: &mut[u8], finish: bool) -> Progress {
        p := self.encoder.process(input, output, finish)
        s := Status.NeedInput
        match &p.status {
            gzip_store.Status.NeedInput => {
                s = Status.NeedInput
            },
            gzip_store.Status.NeedOutput => {
                s = Status.NeedOutput
            },
            gzip_store.Status.Done => {
                s = Status.Done
            },
        }
        return Progress { input_consumed: p.input_consumed, output_written: p.output_written, status: s }
    }
}
// A write accepts input before attempting to flush the corresponding encoded
// bytes. A failed write reports the accepted input count, and retains every
// unflushed encoded byte for the next write or finish. finish is repeatable
// after device errors, and returns the encoded byte count flushed by that call.
pub struct Writer<W: streamio.Writer, C: EncoderCodec> {
    sink: &mut W
    codec: C
    buffer: [4096]u8
    start: usize
    end: usize
    finishing: bool
    done: bool
    pub fn new(sink: &mut W, codec: C) -> Writer<W, C> from(sink) {
        return Writer<W, C> { sink: sink, codec: codec, buffer: [0u8; 4096], start: 0, end: 0, finishing: false, done: false }
    }
    fn flush_pending(&mut self) -> usize!streamio.Error {
        total := 0usize
        for self.start < self.end {
            match streamio.write_once(self.sink, &self.buffer[self.start..self.end]) {
                ok(count) => {
                    self.start += count;
                    total += count
                },
                err(reason) => {
                    self.start += reason.transferred
                    total += reason.transferred
                    if reason.kind != streamio.ErrorKind.Interrupted {
                        reason.transferred = total
                        return err(reason)
                    }
                },
            }
        }
        self.start = 0
        self.end = 0
        return ok(total)
    }
    pub fn write(&mut self, input: &[u8]) -> usize!streamio.Error {
        if self.finishing {
            return err(streamio.failure(streamio.ErrorKind.Closed, 0))
        }
        if input.len == 0 {
            return ok(0)
        }
        match self.flush_pending() {
            ok(_) => {},
            err(reason) => {
                reason.transferred = 0;
                return err(reason)
            },
        }
        // A complete stored block and the largest wrapper header fit in the
        // buffer, so a successful partial write can be followed by finish.
        count := input.len
        if count > 4080 {
            count = 4080
        }
        p := self.codec.process(&input[..count], &mut self.buffer, false)
        if p.input_consumed > count || p.output_written > self.buffer.len || (p.input_consumed == 0 && p.output_written == 0) {
            return err(streamio.failure(streamio.ErrorKind.InvalidProgress, 0))
        }
        self.end = p.output_written
        match self.flush_pending() {
            ok(_) => {
                return ok(p.input_consumed)
            },
            err(reason) => {
                reason.transferred = p.input_consumed;
                return err(reason)
            },
        }
    }
    pub fn finish(&mut self) -> usize!streamio.Error {
        self.finishing = true
        total := 0usize
        for true {
            match self.flush_pending() {
                ok(count) => {
                    total += count
                },
                err(reason) => {
                    reason.transferred += total;
                    return err(reason)
                },
            }
            if self.done {
                return ok(total)
            }
            p := self.codec.process(b"", &mut self.buffer, true)
            if p.input_consumed != 0 || p.output_written > self.buffer.len {
                return err(streamio.failure(streamio.ErrorKind.InvalidProgress, total))
            }
            self.end = p.output_written
            match &p.status {
                Status.Done => {
                    self.done = true
                },
                Status.NeedInput => {
                    return err(streamio.failure(streamio.ErrorKind.InvalidInput, total))
                },
                Status.NeedOutput => {
                    if p.output_written == 0 {
                        return err(streamio.failure(streamio.ErrorKind.InvalidProgress, total))
                    }
                },
            }
        }
        return ok(total)
    }
}
