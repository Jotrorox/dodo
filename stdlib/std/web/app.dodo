package app

import "std/web/application"
import "std/web"
import "std/web/testing"
import "std/io"
import "std/console"
import "std/web/hosted"
import "std/web/reactor"
import "std/http/hosting"
import "std/net"
import "std/net/native"

pub const WORKSPACE_BYTES: usize = hosted.WORKSPACE_BYTES
pub const BODY_BYTES: usize = 4096
pub const DEFAULT_CONNECTIONS: usize = 8

pub struct Limits {
    pub header_bytes: usize
    pub header_fields: usize
    pub body_bytes: usize
    pub response_bytes: usize
    pub path_bytes: usize
    pub query_bytes: usize
    pub query_fields: usize
    pub response_header_bytes: usize
    pub response_header_fields: usize
    pub fn defaults() -> Limits {
        return Limits { header_bytes: 16384, header_fields: 100, body_bytes: BODY_BYTES,
        response_bytes: BODY_BYTES, path_bytes: hosted.PATH_BYTES, query_bytes: hosted.QUERY_BYTES,
        query_fields: 100, response_header_bytes: hosted.RESPONSE_HEADER_BYTES,
        response_header_fields: hosted.RESPONSE_HEADER_FIELDS }
    }
}
pub struct Timeouts {
    pub header_ms: u64
    pub body_ms: u64
    pub request_ms: u64
    pub write_ms: u64
    pub idle_ms: u64
    pub fn defaults() -> Timeouts {
        return Timeouts { header_ms: 10000, body_ms: 30000, request_ms: 30000, write_ms: 30000, idle_ms: 15000 }
    }
}
pub enum Execution {
    Serial, Concurrent
}
pub struct Config {
    pub limits: Limits
    pub timeouts: Timeouts
    pub execution: Execution
    pub backlog: u32
    // Total accepted connections, not simultaneous connections. Zero is unlimited.
    pub max_connections: usize
    pub requests_per_connection: usize
    pub events_per_turn: usize
    pub fn defaults() -> Config {
        return Config { limits: Limits.defaults(), timeouts: Timeouts.defaults(), execution: Execution.Serial,
        backlog: 256, max_connections: 0, requests_per_connection: 100, events_per_turn: 16 }
    }
    pub fn serial(&self) -> hosted.Config {
        return hosted.Config { backlog: self.backlog, max_connections: self.max_connections,
        header_bytes: self.limits.header_bytes, header_fields: self.limits.header_fields,
        body_bytes: self.limits.body_bytes, response_bytes: self.limits.response_bytes,
        path_bytes: self.limits.path_bytes, query_bytes: self.limits.query_bytes,
        query_fields: self.limits.query_fields, response_header_bytes: self.limits.response_header_bytes,
        response_header_fields: self.limits.response_header_fields,
        header_timeout_ms: self.timeouts.header_ms, body_timeout_ms: self.timeouts.body_ms,
        request_timeout_ms: self.timeouts.request_ms, write_timeout_ms: self.timeouts.write_ms }
    }
    pub fn concurrent(&self) -> reactor.Config {
        return reactor.Config { server: self.serial(), requests_per_connection: self.requests_per_connection,
        idle_timeout_ms: self.timeouts.idle_ms, events_per_turn: self.events_per_turn }
    }
}

// Borrowed storage is reusable after serving returns. Body capacities are per
// slot in concurrent mode; trailing bytes after equal division are unused.
pub struct Storage {
    workspace: &mut[u8]
    request: &mut[u8]
    response: &mut[u8]
    slots: Option<&mut[reactor.Slot]>
    pub fn new(workspace: &mut[u8], request: &mut[u8], response: &mut[u8]) -> Storage from(workspace, request, response) {
        return Storage { workspace: workspace, request: request, response: response, slots: none }
    }
    pub fn concurrent(workspace: &mut[u8], request: &mut[u8], response: &mut[u8], slots: &mut[reactor.Slot]) -> Storage from(workspace, request, response, slots) {
        return Storage { workspace: workspace, request: request, response: response, slots: some(slots) }
    }
}

// Owns route metadata, named handler values, and grouped configuration. The
// default storage lives only for a serving call; no self-referential borrows.
// Serving consumes this object. Custom Storage is borrowed and can be reused.
pub struct Server<H> {
    pub application: application.Application<H>
    pub config: Config
    pub fn new(application: application.Application<H>) -> Server<H> from(application) {
        return Server { application: application, config: Config.defaults() }
    }
    pub fn request(&mut self, method: &[u8], target: &[u8]) -> testing.Response {
        return self.application.request(method, target)
    }
    pub fn request_with(&mut self, input: &testing.Request) -> testing.Response {
        return self.application.request_with(input)
    }
    pub fn serve(self, address: &[u8]) -> hosted.Report!hosting.Error {
        cancel := net.NeverCancel {}
        return self.serve_until(address, &cancel)
    }
    pub fn serve_until<X>(self, address: &[u8], cancel: &X) -> hosted.Report!hosting.Error {
        if self.config.execution == Execution.Concurrent {
            return self.concurrent_defaults(address, cancel)
        }
        return self.serial_defaults(address, cancel)
    }
    fn serial_defaults<X>(self, address: &[u8], cancel: &X) -> hosted.Report!hosting.Error {
        workspace := [0u8; hosted.WORKSPACE_BYTES]
        request := [0u8; BODY_BYTES]
        response := [0u8; BODY_BYTES]
        storage := Storage.new(&mut workspace, &mut request, &mut response)
        clock := native.MonotonicClock {}
        return self.serve_with(address, &mut storage, &mut clock, cancel)
    }
    fn concurrent_defaults<X>(self, address: &[u8], cancel: &X) -> hosted.Report!hosting.Error {
        slots := reactor.slots()
        workspace := [0u8; hosted.WORKSPACE_BYTES *DEFAULT_CONNECTIONS]
        request := [0u8; BODY_BYTES *DEFAULT_CONNECTIONS]
        response := [0u8; BODY_BYTES *DEFAULT_CONNECTIONS]
        storage := Storage.concurrent(&mut workspace, &mut request, &mut response, &mut slots)
        clock := native.MonotonicClock {}
        return self.serve_with(address, &mut storage, &mut clock, cancel)
    }
    pub fn serve_in(self, address: &[u8], storage: &mut Storage) -> hosted.Report!hosting.Error {
        clock := native.MonotonicClock {}
        cancel := net.NeverCancel {}
        return self.serve_with(address, storage, &mut clock, &cancel)
    }
    // Explicit serial transport hook, also used by std/web/https. Never
    // silently downgrade a requested concurrent server to serial execution.
    pub fn serve_serial_with<A, C, X>(self, address: &[u8], storage: &mut Storage,
    acceptor: &mut A, clock: &mut C, cancel: &X) -> hosted.Report!hosting.Error {
        let Server { application: application, config: config } = self
        if config.execution != Execution.Serial {
            return err(hosting.failure(hosting.ErrorKind.InvalidInput))
        }
        let application.Application { table: table, handler: owned_handler } = application
        handler := owned_handler
        return hosted.serve_with(address, table.routes(), &mut handler,
        storage.workspace, storage.request, storage.response, config.serial(), acceptor, clock, cancel)
    }
    pub fn serve_with<C, X>(self, address: &[u8], storage: &mut Storage, clock: &mut C, cancel: &X) -> hosted.Report!hosting.Error {
        let Server { application: application, config: config } = self
        let application.Application { table: table, handler: owned_handler } = application
        handler := owned_handler
        if config.execution == Execution.Concurrent {
            match &mut storage.slots {
                some(active) => {
                    return reactor.serve_with(address, table.routes(), &mut handler,
                    *active, storage.workspace, storage.request, storage.response, config.concurrent(), clock, cancel)
                }
                none => {
                    return err(hosting.failure(hosting.ErrorKind.Workspace))
                }
            }
        }
        acceptor := hosted.PlainAcceptor {}
        return hosted.serve_with(address, table.routes(), &mut handler,
        storage.workspace, storage.request, storage.response, config.serial(), &mut acceptor, clock, cancel)
    }
}

// One error boundary for fluent setup and hosted serving.
pub struct Error {
    pub registration: Option<application.RegistrationError>
    pub serving: Option<hosting.Error>
    pub fn format<F>(&self, output: &mut F) -> void!io.Error {
        match &self.registration {
            some(reason) => {
                return reason.format(output)
            }
            none => {}
        }
        match &self.serving {
            some(reason) => {
                return reason.format(output)
            }
            none => {
                return output.string("web: unknown startup failure")
            }
        }
    }
}
pub struct Builder<H, M> {
    routes: application.Builder<H, M>
    pub config: Config
    pub fn route<N>(self, method: &[u8], pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, method, pattern, handler) {
        let Builder { routes: routes, config: config } = self
        return Builder { routes: routes.route(method, pattern, handler), config: config }
    }
    pub fn get<N>(self, pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, pattern, handler) {
        return self.route(b"GET", pattern, handler)
    }
    pub fn post<N>(self, pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, pattern, handler) {
        return self.route(b"POST", pattern, handler)
    }
    pub fn put<N>(self, pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, pattern, handler) {
        return self.route(b"PUT", pattern, handler)
    }
    pub fn patch<N>(self, pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, pattern, handler) {
        return self.route(b"PATCH", pattern, handler)
    }
    pub fn delete<N>(self, pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, pattern, handler) {
        return self.route(b"DELETE", pattern, handler)
    }
    pub fn head<N>(self, pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, pattern, handler) {
        return self.route(b"HEAD", pattern, handler)
    }
    pub fn options<N>(self, pattern: &[u8], handler: N) -> Builder<application.Handlers<H, N>, M> from(self, pattern, handler) {
        return self.route(b"OPTIONS", pattern, handler)
    }
    pub fn middleware<N>(self, middleware: N) -> Builder<H, web.Chain<M, N>> from(self, middleware) {
        let Builder { routes: routes, config: config } = self
        return Builder { routes: routes.middleware(middleware), config: config }
    }
    pub fn concurrent(self) -> Builder<H, M> from(self) {
        self.config.execution = Execution.Concurrent
        return self
    }
    pub fn max_connections(self, count: usize) -> Builder<H, M> from(self) {
        self.config.max_connections = count
        return self
    }
    pub fn build(self) -> Server<web.WithMiddleware<H, M>>!application.RegistrationError from(self) {
        let Builder { routes: routes, config: config } = self
        return ok(Server { application: routes.build()?, config: config })
    }
    // Main-function convenience: printable startup failures and an exit code.
    pub fn run(self, address: &[u8]) -> i32 {
        return exit_code(self.serve(address))
    }
    // Transport supplies serve(server, address) -> hosted.Report!E, where E
    // is printable. Plain apps do not import or link a TLS backend.
    pub fn run_with<T>(self, address: &[u8], transport: T) -> i32 {
        match self.build() {
            ok(server) => {
                return exit_code(transport.serve(server, address))
            }
            err(reason) => {
                errors := console.stderr()
                match errors.println(&reason) {
                    ok(_) => {}
                    err(_) => {}
                }
                return 1
            }
        }
    }
    pub fn serve(self, address: &[u8]) -> hosted.Report!Error from(self) {
        cancel := net.NeverCancel {}
        return self.serve_until(address, &cancel)
    }
    pub fn serve_until<X>(self, address: &[u8], cancel: &X) -> hosted.Report!Error from(self) {
        match self.build() {
            ok(server) => {
                match server.serve_until(address, cancel) {
                    ok(report) => {
                        return ok(report)
                    }
                    err(reason) => {
                        return err(Error { registration: none, serving: some(reason) })
                    }
                }
            }
            err(reason) => {
                return err(Error { registration: some(reason), serving: none })
            }
        }
    }
}
pub fn new() -> Builder<application.Empty, web.NoMiddleware> from(static) {
    return Builder { routes: application.builder(), config: Config.defaults() }
}

// Shared main-function reporting for built-in and explicitly chosen transports.
fn exit_code<E>(result: hosted.Report!E) -> i32 {
    match result {
        ok(report) => {
            if report.failed != 0 {
                match &report.last_error {
                    some(reason) => {
                        errors := console.stderr()
                        match errors.println(reason) {
                            ok(_) => {}
                            err(_) => {}
                        }
                    }
                    none => {}
                }
                return 2
            }
            return 0
        }
        err(reason) => {
            errors := console.stderr()
            match errors.println(&reason) {
                ok(_) => {}
                err(_) => {}
            }
            return 1
        }
    }
}
