package hosted

import "core/bytes"
import "core/slice"
import "std/http"
import "std/http/connection"
import "std/http/hosting"
import "std/net"
import "std/net/native"
import "std/web"

// Fixed protocol, path, query and header storage; body buffers are separate.
pub const PATH_BYTES: usize = 2048
pub const QUERY_BYTES: usize = 2048
pub const REQUEST_HEADER_BYTES: usize = 16384
pub const RESPONSE_HEADER_BYTES: usize = 4096
pub const RESPONSE_HEADER_FIELDS: usize = 32
pub const WORKSPACE_BYTES: usize = 61440
pub struct Config {
    pub backlog: u32
    pub header_bytes: usize
    pub header_fields: usize
    pub body_bytes: usize
    pub response_bytes: usize
    pub path_bytes: usize
    pub query_bytes: usize
    pub query_fields: usize
    pub response_header_bytes: usize
    pub response_header_fields: usize
    pub header_timeout_ms: u64
    pub body_timeout_ms: u64
    pub request_timeout_ms: u64
    pub write_timeout_ms: u64
    // Zero means serve until cancelled. One request per accepted connection.
    pub max_connections: usize
    pub fn defaults() -> Config {
        return Config { backlog: 256, header_bytes: 16384, header_fields: 100,
        body_bytes: 65536, response_bytes: 65536, path_bytes: PATH_BYTES, query_bytes: QUERY_BYTES,
        query_fields: 100, response_header_bytes: RESPONSE_HEADER_BYTES, response_header_fields: RESPONSE_HEADER_FIELDS, header_timeout_ms: 10000,
        body_timeout_ms: 30000, request_timeout_ms: 30000, write_timeout_ms: 30000, max_connections: 0 }
    }
    pub fn valid(&self) -> bool {
        return self.header_bytes != 0 && self.header_bytes <= 16384 && self.header_fields != 0 && self.header_fields <= 100 &&
            self.path_bytes != 0 && self.path_bytes <= PATH_BYTES && self.query_bytes <= QUERY_BYTES &&
            self.query_fields <= 100 && self.response_header_bytes <= RESPONSE_HEADER_BYTES &&
            self.response_header_fields <= RESPONSE_HEADER_FIELDS && self.backlog != 0 &&
            self.header_timeout_ms != 0 && self.body_timeout_ms != 0 && self.request_timeout_ms != 0 && self.write_timeout_ms != 0
    }
    pub fn limits(&self, capacity: usize) -> http.Limits {
        limits := http.Limits.defaults()
        limits.header_bytes = self.header_bytes
        limits.header_fields = self.header_fields
        limits.body_bytes = self.body_bytes as u64
        if capacity < self.body_bytes {
            limits.body_bytes = capacity as u64
        }
        return limits
    }
}
pub struct Report {
    pub accepted: usize
    pub completed: usize
    pub rejected: usize
    pub failed: usize
    pub cancelled: bool
    pub last_error: Option<hosting.Error>
}
pub struct Text {
    body: &[u8]
    pub fn new(body: &[u8]) -> Text from(body) {
        return Text { body: body }
    }
    pub fn handle(&mut self, request: &mut web.Request, response: &mut web.Response) -> void!web.Failure {
        return response.text(self.body)
    }
}
pub fn status(reason: &hosting.Error) -> u16 {
    if reason.kind == hosting.ErrorKind.BodyLimit {
        return 413
    }
    if reason.kind == hosting.ErrorKind.HeaderLimit {
        return 431
    }
    if reason.kind == hosting.ErrorKind.TimedOut {
        return 408
    }
    if reason.kind == hosting.ErrorKind.Handler {
        return 500
    }
    match &reason.application {
        some(problem) => {
            if problem.kind == web.Error.NotFound {
                return 404
            }
            if problem.kind == web.Error.MethodNotAllowed {
                return 405
            }
            if problem.kind == web.Error.HeaderLimit {
                return 431
            }
            if problem.kind == web.Error.QueryLimit || problem.kind == web.Error.BufferFull {
                return 414
            }
        }
        none => {}
    }
    return 400
}
// Fresh serialization is intentional: parser errors permanently poison the
// connection driver. No output from a failed serializer is ever transmitted.
pub fn error_response<S, C, X>(stream: &mut S, code: u16, output: &mut[u8], clock: &mut C, cancel: &X, until: u64) -> void!hosting.Error {
    headers := [http.Header { name: b"Connection", value: b"close" }]
    response := http.Response { status: code, reason: b"", headers: &headers, body: http.Body.empty() }
    count := 0usize
    match http.write_response(&response, output) {
        ok(value) => {
            count = value
        }
        err(reason) => {
            return err(hosting.protocol_error(reason))
        }
    }
    return hosting.write(stream, &output[..count], clock, cancel, until)
}
pub fn request_error(reason: web.Failure) -> hosting.Error {
    return hosting.web_error(reason, hosting.ErrorKind.InvalidInput)
}
// Materialize borrowed header views only during serialization. The response's
// copied bytes outlive these local views; the connection retains no view.
fn empty_header() -> http.Header from(static) {
    return http.Header { name: b"", value: b"" }
}
pub fn response_head(driver: &mut connection.Connection, response: &web.Response, connection_value: &[u8]) -> void!hosting.Error {
    headers := [empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(),
    empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(),
    empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(),
    empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(), empty_header(),
    empty_header()]
    count := 0usize
    for count < RESPONSE_HEADER_FIELDS {
        match response.header_at(count) {
            none => {
                break
            }
            some(field) => {
                headers[count] = field
            }
        }
        count += 1
    }
    match response.header_at(RESPONSE_HEADER_FIELDS) {
        some(_) => {
            return err(hosting.web_error(web.failure(web.Error.HeaderLimit), hosting.ErrorKind.Handler))
        }
        none => {}
    }
    headers[count] = http.Header { name: b"Connection", value: connection_value }
    framing := http.Body.sized(response.body().len as u64)
    if response.status() == 204 {
        framing = http.Body.empty()
    }
    if response.status() == 205 {
        framing = http.Body.sized(0)
    }
    message := http.Response { status: response.status(), reason: b"", headers: &headers[..count + 1], body: framing }
    match driver.response(&message) {
        ok() => {
            return ok()
        }
        err(reason) => {
            result := hosting.connection_error(reason)
            result.kind = hosting.ErrorKind.Handler
            return err(result)
        }
    }
}
pub fn bodyless(method: &[u8], code: u16) -> bool {
    return bytes.equal(method, b"HEAD") || code == 204 || code == 205 || code == 304
}
pub struct Target {
    pub path: usize;
    pub query: usize
}
pub fn decode_target(target: &[u8], path_buffer: &mut[u8], query_buffer: &mut[u8], config: &Config) -> Target!hosting.Error {
    if config.path_bytes > path_buffer.len || config.query_bytes > query_buffer.len {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    result := Target { path: 0, query: 0 }
    uri: http.Uri
    match http.Uri.parse(target) {
        ok(value) => {
            uri = value
        }
        err(reason) => {
            return err(hosting.protocol_error(reason))
        }
    }
    raw := uri.path()
    if raw.len == 0 {
        raw = b"/"
    }
    match web.decode_path(raw, &mut path_buffer[..config.path_bytes]) {
        ok(count) => {
            result.path = count
        }
        err(reason) => {
            return err(request_error(web.failure(reason)))
        }
    }
    match web.decode_query(uri.query(), &mut query_buffer[..config.query_bytes], config.query_fields) {
        ok(count) => {
            result.query = count
        }
        err(reason) => {
            return err(request_error(reason))
        }
    }
    return ok(result)
}
// A request is buffered before dispatch. No unchecked callback borrow survives.
// Handler.handle(&mut web.Request, &mut web.Response) -> void!web.Failure.
// Callback execution itself is cooperative: checks occur before and after it.
fn respond<S, H, C, X>(stream: &mut S, router: &web.Router, handler: &mut H, workspace: &mut[u8],
request_body: &mut[u8], response_body: &mut[u8], config: &Config, request_id: u64,
clock: &mut C, cancel: &X, response_started: &mut bool) -> bool!hosting.Error {
    started := clock.now_ms()
    request_until := hosting.deadline(started, config.request_timeout_ms)
    phase_until := hosting.earlier(request_until, hosting.deadline(started, config.header_timeout_ms))
    let some(slice.SplitMut { left: parser, right: rest }) = slice.split_at_mut(workspace, 16384) else {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    let some(slice.SplitMut { left: input_buffer, right: rest_output }) = slice.split_at_mut(rest, 4096) else {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    let some(slice.SplitMut { left: transmit, right: metadata }) = slice.split_at_mut(rest_output, 16384) else {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    let some(slice.SplitMut { left: path_buffer, right: after_path }) = slice.split_at_mut(metadata, PATH_BYTES) else {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    let some(slice.SplitMut { left: query_buffer, right: after_query }) = slice.split_at_mut(after_path, QUERY_BYTES) else {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    let some(slice.SplitMut { left: header_buffer, right: response_headers }) = slice.split_at_mut(after_query, REQUEST_HEADER_BYTES) else {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    retained := web.Fields.new(header_buffer, config.header_fields)
    driver: connection.Connection
    match connection.Connection.new(http.Role.Request, parser, input_buffer, transmit, config.limits(request_body.len)) {
        ok(value) => {
            driver = value
        }
        err(reason) => {
            return err(hosting.connection_error(reason))
        }
    }
    body_used := 0usize
    path_used := 0usize
    route_id := 0usize
    route_index := 0usize
    query_used := 0usize
    expect_continue := false
    for true {
        hosting.check(clock, cancel, phase_until)?
        event: http.Event
        match driver.poll_event(stream) {
            ok(value) => {
                event = value
            }
            err(reason) => {
                return err(hosting.connection_error(reason))
            }
        }
        if event.kind == http.EventKind.Header {
            name: &[u8]
            value: &[u8]
            match driver.field(event.name_offset, event.name_length) {
                ok(data) => {
                    name = data
                }
                err(reason) => {
                    return err(hosting.protocol_error(reason))
                }
            }
            match driver.field(event.value_offset, event.value_length) {
                ok(data) => {
                    value = data
                }
                err(reason) => {
                    return err(hosting.protocol_error(reason))
                }
            }
            match retained.append(name, value) {
                ok() => {}
                err(reason) => {
                    return err(request_error(reason))
                }
            }
            if http.equal_ascii(name, b"Expect") {
                if!http.equal_ascii(value, b"100-continue") {
                    return err(hosting.failure(hosting.ErrorKind.InvalidInput))
                }
                expect_continue = true
            }
        }
        if event.kind == http.EventKind.HeadersComplete {
            phase_until = hosting.earlier(request_until, hosting.deadline(clock.now_ms(), config.body_timeout_ms))
            target := decode_target(driver.target(), path_buffer, query_buffer, config)?
            path_used = target.path
            query_used = target.query
            match router.find(driver.method(), &path_buffer[..path_used]) {
                ok(found) => {
                    route_id = found.id;
                    route_index = found.index
                }
                err(reason) => {
                    return err(request_error(web.failure(reason)))
                }
            }
            if expect_continue {
                headers: [0]http.Header = []
                interim := http.Response { status: 100, reason: b"Continue", headers: &headers, body: http.Body.empty() }
                match driver.informational(&interim) {
                    ok() => {}
                    err(reason) => {
                        return err(hosting.connection_error(reason))
                    }
                }
                hosting.flush(&mut driver, stream, clock, cancel, phase_until)?
            }
        }
        if event.kind == http.EventKind.Body {
            count := driver.body().len
            if count > request_body.len - body_used {
                return err(hosting.failure(hosting.ErrorKind.BodyLimit))
            }
            match bytes.copy_from(&mut request_body[body_used..body_used + count], driver.body()) {
                ok() => {}
                err(_) => {
                    return err(hosting.failure(hosting.ErrorKind.InvalidInput))
                }
            }
            body_used += count
            match driver.consume_body(count) {
                ok() => {}
                err(reason) => {
                    return err(hosting.connection_error(reason))
                }
            }
        }
        if event.kind == http.EventKind.Upgrade {
            return err(hosting.failure(hosting.ErrorKind.Protocol))
        }
        if event.kind == http.EventKind.Complete {
            break
        }
        if event.kind == http.EventKind.NeedInput && driver.unread().len == 0 {
            hosting.wait(stream, false, clock, cancel, phase_until)?
        }
    }
    hosting.check(clock, cancel, request_until)?
    capacity := response_body.len
    if capacity > config.response_bytes {
        capacity = config.response_bytes
    }
    response := web.Response.new(&mut response_headers[..config.response_header_bytes], config.response_header_fields, &mut response_body[..capacity])
    request := web.Request.new(driver.method(), &path_buffer[..path_used], retained.bytes(), &query_buffer[..query_used],
    &request_body[..body_used], router, route_index, route_id, request_id)
    match web.handle(handler, &mut request, &mut response) {
        ok() => {}
        err(reason) => {
            return err(hosting.web_error(reason, hosting.ErrorKind.Handler))
        }
    }
    head := bodyless(request.method(), response.status())
    core.drop(request)
    hosting.check(clock, cancel, request_until)?
    response_head(&mut driver, &response, b"close")?
    until := hosting.earlier(request_until, hosting.deadline(clock.now_ms(), config.write_timeout_ms))
    *response_started = true
    if head {
        hosting.send(&mut driver, stream, b"", clock, cancel, until)?
    } else {
        hosting.send(&mut driver, stream, response.body(), clock, cancel, until)?
    }
    return ok(true)
}
// An error response gets its own bounded write interval, even if request input
// timed out. Cancellation skips that write and closes immediately.
pub fn serve_connection<S, H, C, X>(stream: &mut S, router: &web.Router, handler: &mut H, workspace: &mut[u8],
request_body: &mut[u8], response_body: &mut[u8], config: &Config, request_id: u64,
clock: &mut C, cancel: &X) -> bool!hosting.Error {
    if workspace.len < WORKSPACE_BYTES {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    if!config.valid() {
        return err(hosting.failure(hosting.ErrorKind.InvalidInput))
    }
    response_started := false
    match respond(stream, router, handler, workspace, request_body, response_body, config, request_id, clock, cancel, &mut response_started) {
        ok(value) => {
            return ok(value)
        }
        err(reason) => {
            if!response_started && reason.kind != hosting.ErrorKind.Cancelled && reason.kind != hosting.ErrorKind.Transport {
                until := hosting.deadline(clock.now_ms(), config.write_timeout_ms)
                match error_response(stream, status(&reason), &mut workspace[20480..36864], clock, cancel, until) {
                    ok() => {
                        reason.responded = true
                        return err(reason)
                    }
                    err(_) => {}
                }
            }
            return err(reason)
        }
    }
}
pub struct PlainAcceptor {
    pub fn serve<H, C, X>(&mut self, socket: &mut native.TcpConnection, router: &web.Router, handler: &mut H,
    workspace: &mut[u8], request_body: &mut[u8], response_body: &mut[u8], config: &Config,
    request_id: u64, clock: &mut C, cancel: &X) -> bool!hosting.Error {
        stream := hosting.Plain.new(socket)
        return serve_connection(&mut stream, router, handler, workspace, request_body, response_body, config, request_id, clock, cancel)
    }
}
pub fn serve<H>(address: &[u8], routes: &[web.Route], handler: &mut H, workspace: &mut[u8], request_body: &mut[u8],
response_body: &mut[u8], config: Config) -> Report!hosting.Error {
    clock := native.MonotonicClock {}
    cancel := net.NeverCancel {}
    acceptor := PlainAcceptor {}
    return serve_with(address, routes, handler, workspace, request_body, response_body, config, &mut acceptor, &mut clock, &cancel)
}
// Bounded serial execution: one socket, one request, no task/thread/pool per peer.
// Cooperative cancellation ends acceptance and aborts the current connection.
// No callback or socket ownership survives this function, including error exits.
pub fn serve_with<H, P, C, X>(address: &[u8], routes: &[web.Route], handler: &mut H, workspace: &mut[u8],
request_body: &mut[u8], response_body: &mut[u8], config: Config, acceptor: &mut P,
clock: &mut C, cancel: &X) -> Report!hosting.Error {
    if workspace.len < WORKSPACE_BYTES {
        return err(hosting.failure(hosting.ErrorKind.Workspace))
    }
    if!config.valid() {
        return err(hosting.failure(hosting.ErrorKind.InvalidInput))
    }
    index := [0usize; 2048]
    router: web.Router
    if routes.len > 16 && routes.len <= index.len / 2 {
        match web.Router.indexed(routes, &mut index) {
            ok(value) => {
                router = value
            }
            err(reason) => {
                return err(hosting.web_error(web.failure(reason), hosting.ErrorKind.InvalidInput))
            }
        }
    } else {
        match web.Router.new(routes) {
            ok(value) => {
                router = value
            }
            err(reason) => {
                return err(hosting.web_error(web.failure(reason), hosting.ErrorKind.InvalidInput))
            }
        }
    }
    local: net.SocketAddress
    match net.parse_socket(address) {
        ok(value) => {
            local = value
        }
        err(reason) => {
            return err(hosting.network_error(reason, hosting.ErrorKind.InvalidInput))
        }
    }
    listener: native.TcpListener
    match native.TcpListener.bind(&local, config.backlog) {
        ok(value) => {
            listener = value
        }
        err(reason) => {
            return err(hosting.network_error(reason, hosting.ErrorKind.Connect))
        }
    }
    report := Report { accepted: 0, completed: 0, rejected: 0, failed: 0, cancelled: false, last_error: none }
    for config.max_connections == 0 || report.accepted < config.max_connections {
        if cancel.cancelled() {
            report.cancelled = true;
            return ok(report)
        }
        match listener.accept() {
            err(reason) => {
                if reason.kind != net.ErrorKind.Interrupted {
                    return err(hosting.network_error(reason, hosting.ErrorKind.Transport))
                }
            }
            ok(pending) => {
                match pending {
                    none => {
                        match listener.wait_ready(10) {
                            ok(_) => {}
                            err(reason) => {
                                if reason.kind != net.ErrorKind.Interrupted {
                                    return err(hosting.network_error(reason, hosting.ErrorKind.Transport))
                                }
                            }
                        }
                    }
                    some(socket) => {
                        report.accepted += 1
                        match acceptor.serve(&mut socket, &router, handler, workspace, request_body, response_body,
                        &config, report.accepted as u64, clock, cancel) {
                            ok(completed) => {
                                if completed {
                                    report.completed += 1
                                } else {
                                    report.rejected += 1
                                }
                            }
                            err(reason) => {
                                if reason.kind == hosting.ErrorKind.Cancelled {
                                    report.cancelled = true;
                                    return ok(report)
                                }
                                if reason.responded {
                                    report.rejected += 1
                                } else {
                                    report.failed += 1
                                }
                                report.last_error = some(reason)
                            }
                        }
                    }
                }
            }
        }
    }
    return ok(report)
}
