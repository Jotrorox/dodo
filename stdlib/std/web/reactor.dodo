package reactor

import "core/bytes"
import "core/mem"
import "core/slice"
import "std/http"
import "std/http/connection"
import "std/http/hosting"
import "std/io"
import "std/net"
import "std/net/native"
import "std/web"
import "std/web/hosted"

pub const WORKSPACE_BYTES: usize = hosted.WORKSPACE_BYTES
pub struct Config {
    pub server: hosted.Config
    pub requests_per_connection: usize
    pub idle_timeout_ms: u64
    pub events_per_turn: usize
    pub fn defaults() -> Config {
        return Config { server: hosted.Config.defaults(), requests_per_connection: 100,
        idle_timeout_ms: 15000, events_per_turn: 16 }
    }
}
enum Step {
    Pending, Progress, Complete, Rejected, Closed, Failed
}

// No buffer borrows survive a turn. Each slot owns one socket and opaque HTTP
// state; disjoint caller-owned byte ranges accompany it when it is resumed.
pub struct Slot {
    socket: native.TcpConnection
    established: bool
    state: connection.State
    active: bool
    runnable: bool
    writing: bool
    poll_index: usize
    phase: u8 // 0 headers, 1 body, 2 response, 3 idle, 4 error response
    // Closing phases: 5 successful response, 6 rejection, 7 idle/peer EOF.
    deadline: u64
    request_until: u64
    body_used: usize
    path_used: usize
    route_id: usize
    route_index: usize
    query_used: usize
    header_used: usize
    header_count: usize
    last_error: Option<hosting.Error>
    request_id: u64
    requests: usize
    expect_continue: bool
    reuse: bool
    final_started: bool
    finished: bool
    response_length: usize
    response_offset: usize
    pub fn new() -> Slot {
        return Slot { socket: native.TcpConnection.closed(), state: connection.State.new(http.Role.Request, http.Limits.defaults()),
        established: false, active: false, runnable: false, writing: false, poll_index: 0, phase: 0, deadline: 0, request_until: 0,
        body_used: 0, path_used: 0, route_id: 0, route_index: 0, query_used: 0, header_used: 0, header_count: 0, last_error: none, request_id: 0, requests: 0, expect_continue: false,
        reuse: false, final_started: false, finished: false, response_length: 0, response_offset: 0 }
    }
    fn close(&mut self) {
        match self.socket.close() {
            ok() => {}
            err(_) => {}
        }
        self.active = false
        self.runnable = false
    }
    fn begin(&mut self, now: u64, config: &Config) {
        self.phase = 0
        self.request_until = hosting.deadline(now, config.server.request_timeout_ms)
        self.deadline = hosting.earlier(self.request_until, hosting.deadline(now, config.server.header_timeout_ms))
        self.body_used = 0
        self.path_used = 0
        self.query_used = 0
        self.header_used = 0
        self.header_count = 0
        self.expect_continue = false
        self.final_started = false
        self.finished = false
        self.response_length = 0
        self.response_offset = 0
        self.writing = false
    }
    fn start(&mut self, socket: native.TcpConnection, now: u64, config: &Config, capacity: usize, established: bool) {
        self.socket = socket
        self.state = connection.State.new(http.Role.Request, config.server.limits(capacity))
        self.requests = 0
        self.established = established
        self.last_error = none
        self.active = true
        self.runnable = true
        self.begin(now, config)
    }
    fn flush<S>(&mut self, stream: &mut S, driver: &mut connection.Connection) -> Step!hosting.Error {
        match driver.poll_flush(stream) {
            ok(progress) => {
                if progress.transferred != 0 {
                    // A partially written informational head cannot be followed
                    // by an error head either. Once that head is fully flushed,
                    // a later request error may still send its final response.
                    self.final_started = self.phase == 2 || driver.pending_output() != 0
                }
                if progress.state == io.PollState.Pending {
                    return ok(Step.Pending)
                }
                return ok(Step.Progress)
            }
            err(reason) => {
                return err(hosting.connection_error(reason))
            }
        }
    }
    fn advance<S, H, C, X>(&mut self, stream: &mut S, driver: &mut connection.Connection, router: &web.Router, handler: &mut H,
    path: &mut[u8], query: &mut[u8], retained: &mut[u8], response_headers: &mut[u8], request: &mut[u8], response: &mut[u8], config: &Config, clock: &mut C,
    next_id: &mut u64, cancel: &X) -> Step!hosting.Error {
        if driver.pending_output() != 0 {
            if self.phase == 2 && self.response_offset == 0 && self.response_length != 0 {
                match driver.append_body(&response[..self.response_length]) {
                    ok(count) => {
                        self.response_offset = count
                    }
                    err(reason) => {
                        if reason.kind != connection.ErrorKind.Backpressure {
                            return err(hosting.connection_error(reason))
                        }
                    }
                }
            }
            return self.flush(stream, driver)
        }
        if self.phase == 2 {
            if self.response_offset < self.response_length {
                match driver.poll_body(stream, &response[self.response_offset..self.response_length]) {
                    ok(progress) => {
                        self.response_offset += progress.transferred
                        if progress.transferred != 0 {
                            self.final_started = true
                        }
                        if progress.state == io.PollState.Pending {
                            return ok(Step.Pending)
                        }
                        return ok(Step.Progress)
                    }
                    err(reason) => {
                        return err(hosting.connection_error(reason))
                    }
                }
            }
            if!self.finished {
                trailers: [0]http.Header = []
                match driver.finish_body(&trailers) {
                    ok() => {
                        self.finished = true
                    }
                    err(reason) => {
                        return err(hosting.connection_error(reason))
                    }
                }
                if driver.pending_output() != 0 {
                    return ok(Step.Progress)
                }
            }
            if!driver.output_complete() {
                return err(hosting.failure(hosting.ErrorKind.InvalidInput))
            }
            if!stream.flush()? {
                return ok(Step.Pending)
            }
            self.requests += 1
            if self.reuse && driver.reusable() {
                match driver.next_message() {
                    ok() => {}
                    err(reason) => {
                        return err(hosting.connection_error(reason))
                    }
                }
                self.phase = 3
                self.deadline = hosting.deadline(clock.now_ms(), config.idle_timeout_ms)
            } else {
                self.phase = 5
                return ok(Step.Progress)
            }
            return ok(Step.Complete)
        }
        // A pipelined message may already be buffered. Reset the preceding
        // response flags before parsing it, including its error paths.
        if self.phase == 3 && driver.unread().len != 0 {
            self.begin(clock.now_ms(), config)
        }
        event: http.Event
        match driver.poll_event(stream) {
            ok(value) => {
                event = value
            }
            err(reason) => {
                return err(hosting.connection_error(reason))
            }
        }
        if self.phase == 3 {
            if event.kind == http.EventKind.NeedInput && driver.unread().len == 0 {
                if driver.input_ended() {
                    self.phase = 7
                    self.deadline = hosting.deadline(clock.now_ms(), config.server.write_timeout_ms)
                    return ok(Step.Progress)
                }
                return ok(Step.Pending)
            }
            self.begin(clock.now_ms(), config)
        }
        if event.kind == http.EventKind.NeedInput {
            if driver.unread().len != 0 {
                return ok(Step.Progress)
            }
            if driver.input_ended() {
                return err(hosting.protocol_error(http.failure(http.ErrorKind.UnexpectedEof, 0)))
            }
            return ok(Step.Pending)
        }
        if event.kind == http.EventKind.Header {
            name: &[u8]
            match driver.field(event.name_offset, event.name_length) {
                ok(value) => {
                    name = value
                }
                err(reason) => {
                    return err(hosting.protocol_error(reason))
                }
            }
            value: &[u8]
            match driver.field(event.value_offset, event.value_length) {
                ok(data) => {
                    value = data
                }
                err(reason) => {
                    return err(hosting.protocol_error(reason))
                }
            }
            fields: web.Fields
            match web.Fields.resume(retained, self.header_used, self.header_count, config.server.header_fields) {
                ok(value) => {
                    fields = value
                }
                err(reason) => {
                    return err(hosted.request_error(reason))
                }
            }
            match fields.append(name, value) {
                ok() => {
                    self.header_used = fields.bytes().len;
                    self.header_count = fields.len()
                }
                err(reason) => {
                    return err(hosted.request_error(reason))
                }
            }
            if http.equal_ascii(name, b"Expect") {
                if!http.equal_ascii(value, b"100-continue") {
                    return err(hosting.failure(hosting.ErrorKind.InvalidInput))
                }
                self.expect_continue = true
            }
        }
        if event.kind == http.EventKind.HeadersComplete {
            self.phase = 1
            self.deadline = hosting.earlier(self.request_until, hosting.deadline(clock.now_ms(), config.server.body_timeout_ms))
            target := hosted.decode_target(driver.target(), path, query, &config.server)?
            self.path_used = target.path
            self.query_used = target.query
            match router.find(driver.method(), &path[..self.path_used]) {
                ok(found) => {
                    self.route_id = found.id;
                    self.route_index = found.index;
                }
                err(reason) => {
                    return err(hosted.request_error(web.failure(reason)))
                }
            }
            if *next_id == 18446744073709551615u64 {
                *next_id = 0
            }
            *next_id += 1
            self.request_id = *next_id
            if self.expect_continue {
                headers: [0]http.Header = []
                interim := http.Response { status: 100, reason: b"Continue", headers: &headers, body: http.Body.empty() }
                match driver.informational(&interim) {
                    ok() => {}
                    err(reason) => {
                        return err(hosting.connection_error(reason))
                    }
                }
            }
        }
        if event.kind == http.EventKind.Body {
            count := driver.body().len
            if count > request.len - self.body_used {
                return err(hosting.failure(hosting.ErrorKind.BodyLimit))
            }
            match bytes.copy_from(&mut request[self.body_used..self.body_used + count], driver.body()) {
                ok() => {
                    self.body_used += count
                }
                err(_) => {
                    return err(hosting.failure(hosting.ErrorKind.InvalidInput))
                }
            }
            match driver.consume_body(count) {
                ok() => {}
                err(reason) => {
                    return err(hosting.connection_error(reason))
                }
            }
        }
        if event.kind == http.EventKind.Upgrade {
            return err(hosting.failure(hosting.ErrorKind.Protocol))
        }
        if event.kind == http.EventKind.Complete {
            if clock.now_ms() >= self.request_until {
                return err(hosting.failure(hosting.ErrorKind.TimedOut))
            }
            capacity := response.len
            if capacity > config.server.response_bytes {
                capacity = config.server.response_bytes
            }
            output := web.Response.new(&mut response_headers[..config.server.response_header_bytes], config.server.response_header_fields, &mut response[..capacity])
            context := web.Request.new(driver.method(), &path[..self.path_used], &retained[..self.header_used], &query[..self.query_used],
            &request[..self.body_used], router, self.route_index, self.route_id, self.request_id)
            match web.handle(handler, &mut context, &mut output) {
                ok() => {}
                err(reason) => {
                    return err(hosting.web_error(reason, hosting.ErrorKind.Handler))
                }
            }
            bodyless := hosted.bodyless(context.method(), output.status())
            core.drop(context)
            if cancel.cancelled() {
                return err(hosting.failure(hosting.ErrorKind.Cancelled))
            }
            now := clock.now_ms()
            if now >= self.request_until {
                return err(hosting.failure(hosting.ErrorKind.TimedOut))
            }
            self.response_length = output.body().len
            if bodyless {
                self.response_length = 0
            }
            self.reuse = self.requests < config.requests_per_connection - 1 && driver.incoming_reusable()
            connection_value := b"close"
            if self.reuse {
                connection_value = b"keep-alive"
            }
            hosted.response_head(driver, &output, connection_value)?
            self.phase = 2
            self.deadline = hosting.earlier(self.request_until, hosting.deadline(now, config.server.write_timeout_ms))
        }
        return ok(Step.Progress)
    }
    fn drive<S, H, C, X>(&mut self, stream: &mut S, workspace: &mut[u8], request: &mut[u8], response: &mut[u8], router: &web.Router,
    handler: &mut H, config: &Config, clock: &mut C, next_id: &mut u64, cancel: &X) -> Step!hosting.Error {
        let some(slice.SplitMut { left: parser, right: rest }) = slice.split_at_mut(workspace, 16384) else {
            return err(hosting.failure(hosting.ErrorKind.Workspace))
        }
        let some(slice.SplitMut { left: input, right: tail }) = slice.split_at_mut(rest, 4096) else {
            return err(hosting.failure(hosting.ErrorKind.Workspace))
        }
        let some(slice.SplitMut { left: output, right: metadata }) = slice.split_at_mut(tail, 16384) else {
            return err(hosting.failure(hosting.ErrorKind.Workspace))
        }
        let some(slice.SplitMut { left: path, right: after_path }) = slice.split_at_mut(metadata, hosted.PATH_BYTES) else {
            return err(hosting.failure(hosting.ErrorKind.Workspace))
        }
        let some(slice.SplitMut { left: query, right: after_query }) = slice.split_at_mut(after_path, hosted.QUERY_BYTES) else {
            return err(hosting.failure(hosting.ErrorKind.Workspace))
        }
        let some(slice.SplitMut { left: retained, right: response_headers }) = slice.split_at_mut(after_query, hosted.REQUEST_HEADER_BYTES) else {
            return err(hosting.failure(hosting.ErrorKind.Workspace))
        }
        state := mem.replace(&mut self.state, connection.State.new(http.Role.Request, http.Limits.defaults()))
        driver: connection.Connection
        match connection.Connection.resume(state, parser, input, output) {
            ok(value) => {
                driver = value
            }
            err(reason) => {
                return err(hosting.connection_error(reason))
            }
        }
        for i in 0usize..config.events_per_turn {
            match self.advance(stream, &mut driver, router, handler, path, query, retained, response_headers, request, response, config, clock, next_id, cancel) {
                ok(step) => {
                    if step != Step.Progress || self.phase >= 5 {
                        self.writing = self.phase == 2 || driver.pending_output() != 0
                        self.state = driver.suspend()
                        return ok(step)
                    }
                }
                err(reason) => {
                    self.state = driver.suspend()
                    return err(reason)
                }
            }
        }
        self.writing = self.phase == 2 || driver.pending_output() != 0
        self.state = driver.suspend()
        return ok(Step.Progress)
    }
    fn reject(&mut self, workspace: &mut[u8], code: u16, now: u64, config: &Config) -> Step {
        if self.final_started {
            self.close();
            return Step.Failed
        }
        headers := [http.Header { name: b"Connection", value: b"close" }]
        response := http.Response { status: code, reason: b"", headers: &headers, body: http.Body.empty() }
        match http.write_response(&response, &mut workspace[20480..36864]) {
            ok(count) => {
                self.response_length = count
            }
            err(_) => {
                self.close();
                return Step.Failed
            }
        }
        self.phase = 4
        self.response_offset = 0
        self.writing = true
        self.deadline = hosting.deadline(now, config.server.write_timeout_ms)
        return Step.Progress
    }
    fn poll<S, H, C, X>(&mut self, stream: &mut S, workspace: &mut[u8], request: &mut[u8], response: &mut[u8], router: &web.Router,
    handler: &mut H, config: &Config, clock: &mut C, next_id: &mut u64, cancel: &X) -> Step {
        if cancel.cancelled() {
            self.close();
            return Step.Closed
        }
        now := clock.now_ms()
        if now >= self.deadline {
            if self.established && self.phase == 3 {
                self.phase = 7
                self.deadline = hosting.deadline(now, config.server.write_timeout_ms)
            } else {
                self.last_error = some(hosting.failure(hosting.ErrorKind.TimedOut))
                if!self.established || self.phase >= 4 {
                    self.close();
                    return Step.Failed
                }
                return self.reject(workspace, 408, now, config)
            }
        }
        if!self.established {
            match stream.handshake() {
                ok(ready) => {
                    if!ready {
                        return Step.Pending
                    }
                    self.established = true
                    self.begin(now, config)
                }
                err(reason) => {
                    self.last_error = some(reason)
                    self.close();
                    return Step.Failed
                }
            }
        }
        if self.phase >= 5 {
            match stream.finish() {
                ok(ready) => {
                    if!ready {
                        return Step.Pending
                    }
                    phase := self.phase
                    self.close()
                    if phase == 5 {
                        return Step.Complete
                    }
                    if phase == 6 {
                        return Step.Rejected
                    }
                    return Step.Closed
                }
                err(reason) => {
                    self.last_error = some(reason)
                    self.close();
                    return Step.Failed
                }
            }
        }
        if self.phase == 4 {
            match io.poll_write_once(stream, &workspace[20480 + self.response_offset..20480 + self.response_length]) {
                ok(progress) => {
                    self.response_offset += progress.transferred
                    if self.response_offset == self.response_length {
                        self.phase = 6;
                        return Step.Progress
                    }
                    if progress.state == io.PollState.Pending {
                        return Step.Pending
                    }
                    return Step.Progress
                }
                err(reason) => {
                    match stream.take_error() {
                        some(cause) => {
                            self.last_error = some(cause)
                        }
                        none => {
                            self.last_error = some(hosting.io_error(reason))
                        }
                    }
                    self.close();
                    return Step.Failed
                }
            }
        }
        match self.drive(stream, workspace, request, response, router, handler, config, clock, next_id, cancel) {
            ok(step) => {
                return step
            }
            err(reason) => {
                match stream.take_error() {
                    some(cause) => {
                        self.last_error = some(cause)
                        self.close();
                        return Step.Failed
                    }
                    none => {}
                }
                if reason.kind == hosting.ErrorKind.Cancelled {
                    self.close();
                    return Step.Closed
                }
                if reason.kind == hosting.ErrorKind.Transport || reason.kind == hosting.ErrorKind.Tls {
                    self.last_error = some(reason)
                    self.close();
                    return Step.Failed
                }
                code := hosted.status(&reason)
                self.last_error = some(reason)
                return self.reject(workspace, code, clock.now_ms(), config)
            }
        }
    }
    fn poll_transport<P, H, C, X>(&mut self, provider: &mut P, index: usize, workspace: &mut[u8],
    request: &mut[u8], response: &mut[u8], router: &web.Router, handler: &mut H,
    config: &Config, clock: &mut C, next_id: &mut u64, cancel: &X) -> Step {
        let some(slice.SplitMut { left: protocol, right: staging }) = slice.split_at_mut(workspace, WORKSPACE_BYTES) else {
            self.last_error = some(hosting.failure(hosting.ErrorKind.Workspace))
            self.close();
            return Step.Failed
        }
        // The resumed transport borrows the socket separately from HTTP state.
        // A close during this turn is applied to the real socket after suspend.
        socket := mem.replace(&mut self.socket, native.TcpConnection.closed())
        step := Step.Failed
        match provider.open(index, &mut socket, staging) {
            ok(stream) => {
                step = self.poll(&mut stream, protocol, request, response, router, handler, config, clock, next_id, cancel)
                if self.active && step != Step.Complete {
                    // TLS can produce ciphertext while reading, and consume
                    // input while writing. Drain it before choosing readiness.
                    match stream.prepare() {
                        ok(progressed) => {
                            if progressed && step == Step.Pending {
                                step = Step.Progress
                            }
                            self.writing = stream.writing(self.writing)
                        }
                        err(reason) => {
                            self.last_error = some(reason)
                            self.close()
                            step = Step.Failed
                        }
                    }
                }
                state := stream.suspend()
                provider.save(index, state)
            }
            err(reason) => {
                self.last_error = some(reason)
                self.close()
            }
        }
        self.socket = socket
        if!self.active {
            provider.close(index)
            self.close()
        }
        return step
    }

}
// A small ready-to-use slot array. Applications may instead supply any array
// or owned collection with 1..255 Slot.new() values and matching byte storage.
pub fn slots() -> [8]Slot {
    return [Slot.new(), Slot.new(), Slot.new(), Slot.new(), Slot.new(), Slot.new(), Slot.new(), Slot.new()]
}
struct Owner {
    slots: &mut[Slot]
    fn drop(&mut self) {
        for i in 0usize..self.slots.len {
            self.slots[i].close()
        }
    }
}
struct TransportOwner<P> {
    provider: &mut P
    count: usize
    fn drop(&mut self) {
        for i in 0usize..self.count {
            self.provider.close(i)
        }
    }
}
pub fn serve<H>(address: &[u8], routes: &[web.Route], handler: &mut H, slots: &mut[Slot], workspace: &mut[u8],
request: &mut[u8], response: &mut[u8], config: Config) -> hosted.Report!hosting.Error {
    clock := native.MonotonicClock {}
    cancel := net.NeverCancel {}
    return serve_with(address, routes, handler, slots, workspace, request, response, config, &mut clock, &cancel)
}
// Handlers run synchronously on this thread; waiting sockets do not block peers.
// Cancellation closes all owned sockets, including every error/return path.
pub fn serve_with<H, C, X>(address: &[u8], routes: &[web.Route], handler: &mut H, slots: &mut[Slot], workspace: &mut[u8],
request: &mut[u8], response: &mut[u8], config: Config, clock: &mut C, cancel: &X) -> hosted.Report!hosting.Error {
    provider := PlainProvider {}
    return serve_using(address, routes, handler, slots, workspace, request, response, config, &mut provider, clock, cancel)
}
// Providers declare staging_bytes and handshake_required.
// Provider.open(index, socket, staging) resumes a polling session; save retains
// its movable state and close releases it. Sessions supply polling I/O,
// handshake, flush, finish, prepare, writing, take_error and suspend methods.
// No session or byte-buffer borrow survives a reactor turn.
pub fn serve_using<P, H, C, X>(address: &[u8], routes: &[web.Route], handler: &mut H, slots: &mut[Slot], workspace: &mut[u8],
request: &mut[u8], response: &mut[u8], config: Config, provider: &mut P, clock: &mut C, cancel: &X) -> hosted.Report!hosting.Error {
    stride := WORKSPACE_BYTES + provider.staging_bytes()
    if slots.len == 0 || slots.len >= native.POLL_CAPACITY || workspace.len / slots.len < stride ||
        config.requests_per_connection == 0 || config.idle_timeout_ms == 0 || config.events_per_turn == 0 ||
        !config.server.valid() {
        return err(hosting.failure(hosting.ErrorKind.InvalidInput))
    }
    owner := Owner { slots: slots }
    transport := TransportOwner { provider: provider, count: owner.slots.len }
    request_size := request.len / owner.slots.len
    response_size := response.len / owner.slots.len
    index := [0usize; 2048]
    router: web.Router
    if routes.len <= index.len / 2 {
        match web.Router.indexed(routes, &mut index) {
            ok(value) => {
                router = value
            }
            err(reason) => {
                return err(hosting.web_error(web.failure(reason), hosting.ErrorKind.InvalidInput))
            }
        }
    } else {
        match web.Router.new(routes) {
            ok(value) => {
                router = value
            }
            err(reason) => {
                return err(hosting.web_error(web.failure(reason), hosting.ErrorKind.InvalidInput))
            }
        }
    }
    local: net.SocketAddress
    match net.parse_socket(address) {
        ok(value) => {
            local = value
        }
        err(reason) => {
            return err(hosting.network_error(reason, hosting.ErrorKind.InvalidInput))
        }
    }
    listener: native.TcpListener
    match native.TcpListener.bind(&local, config.server.backlog) {
        ok(value) => {
            listener = value
        }
        err(reason) => {
            return err(hosting.network_error(reason, hosting.ErrorKind.Connect))
        }
    }
    report := hosted.Report { accepted: 0, completed: 0, rejected: 0, failed: 0, cancelled: false, last_error: none }
    next_id := 0u64
    readiness := native.PollSet.new()
    for true {
        if cancel.cancelled() {
            report.cancelled = true;
            return ok(report)
        }
        readiness.clear()
        active := 0usize
        timeout := 10u32
        now := clock.now_ms()
        for i in 0usize..owner.slots.len {
            if owner.slots[i].active {
                active += 1
                interest := net.Interest.Read
                if owner.slots[i].writing {
                    interest = net.Interest.Write
                }
                match owner.slots[i].socket.register(&mut readiness, interest) {
                    ok(value) => {
                        owner.slots[i].poll_index = value
                    }
                    err(reason) => {
                        return err(hosting.network_error(reason, hosting.ErrorKind.Transport))
                    }
                }
                if owner.slots[i].runnable || now >= owner.slots[i].deadline {
                    timeout = 0
                } else if owner.slots[i].deadline - now < timeout as u64 {
                    timeout = (owner.slots[i].deadline - now) as u32
                }
            }
        }
        accepting := config.server.max_connections == 0 || report.accepted < config.server.max_connections
        if!accepting && active == 0 {
            return ok(report)
        }
        listener_index := native.POLL_CAPACITY
        if accepting && active < owner.slots.len {
            match listener.register(&mut readiness) {
                ok(value) => {
                    listener_index = value
                }
                err(reason) => {
                    return err(hosting.network_error(reason, hosting.ErrorKind.Transport))
                }
            }
        }
        match readiness.wait(timeout) {
            ok(_) => {}
            err(reason) => {
                if reason.kind == net.ErrorKind.Interrupted {
                    continue
                }
                return err(hosting.network_error(reason, hosting.ErrorKind.Transport))
            }
        }
        if cancel.cancelled() {
            report.cancelled = true;
            return ok(report)
        }
        if listener_index != native.POLL_CAPACITY && readiness.ready(listener_index) {
            for i in 0usize..owner.slots.len {
                if config.server.max_connections != 0 && report.accepted >= config.server.max_connections {
                    break
                }
                if!owner.slots[i].active {
                    match listener.accept() {
                        ok(pending) => {
                            match pending {
                                some(socket) => {
                                    owner.slots[i].start(socket, clock.now_ms(), &config, request_size,!transport.provider.handshake_required())
                                    report.accepted += 1
                                }
                                none => {
                                    break
                                }
                            }
                        }
                        err(reason) => {
                            if reason.kind == net.ErrorKind.Interrupted {
                                break
                            }
                            return err(hosting.network_error(reason, hosting.ErrorKind.Transport))
                        }
                    }
                }
            }
        }
        for i in 0usize..owner.slots.len {
            if owner.slots[i].active && (owner.slots[i].runnable || readiness.ready(owner.slots[i].poll_index) || clock.now_ms() >= owner.slots[i].deadline) {
                step := owner.slots[i].poll_transport(transport.provider, i, &mut workspace[i * stride..(i + 1) * stride],
                &mut request[i * request_size..(i + 1) * request_size], &mut response[i * response_size..(i + 1) * response_size],
                &router, handler, &config, clock, &mut next_id, cancel)
                owner.slots[i].runnable = step == Step.Progress || step == Step.Complete
                if step == Step.Complete {
                    report.completed += 1
                }
                match mem.replace(&mut owner.slots[i].last_error, none) {
                    some(reason) => {
                        report.last_error = some(reason)
                    }
                    none => {}
                }
                if step == Step.Rejected {
                    report.rejected += 1
                }
                if step == Step.Failed {
                    report.failed += 1
                }
            }
        }
    }
    return ok(report)
}

// Plain HTTP selects no TLS implementation or extra storage.
pub struct PlainProvider {
    pub fn handshake_required(&self) -> bool {
        return false
    }
    pub fn staging_bytes(&self) -> usize {
        return 0
    }
    pub fn open(&mut self, index: usize, socket: &mut native.TcpConnection, staging: &mut[u8]) -> PlainStream!hosting.Error from(socket) {
        return ok(PlainStream { socket: socket })
    }
    pub fn save(&mut self, index: usize, state: bool) {}
    pub fn close(&mut self, index: usize) {}
}
pub struct PlainStream {
    socket: &mut native.TcpConnection
    pub fn poll_read(&mut self, data: &mut[u8]) -> io.Poll!io.Error {
        return self.socket.poll_read(data)
    }
    pub fn poll_write(&mut self, data: &[u8]) -> io.Poll!io.Error {
        return self.socket.poll_write(data)
    }
    pub fn handshake(&mut self) -> bool!hosting.Error {
        return ok(true)
    }
    pub fn flush(&mut self) -> bool!hosting.Error {
        return ok(true)
    }
    pub fn finish(&mut self) -> bool!hosting.Error {
        return ok(true)
    }
    pub fn prepare(&mut self) -> bool!hosting.Error {
        return ok(false)
    }
    pub fn writing(&self, http_writing: bool) -> bool {
        return http_writing
    }
    pub fn take_error(&mut self) -> Option<hosting.Error> {
        return none
    }
    pub fn suspend(self) -> bool {
        return false
    }
}
