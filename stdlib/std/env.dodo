package env

import "std/platform/native"
import "std/platform/error"
import "std/env/native" as backend

// Native Unix bytes / Windows UTF-16 are preserved, including invalid UTF-8
// and unpaired surrogates. Portable callers provide both scratch types; only
// bytes on Unix or wide on Windows is written. Empty unused storage is valid.
pub fn snapshot(bytes: &mut[u8], wide: &mut[u16]) -> backend.Snapshot!error.Error from(bytes, wide) {
    return backend.capture(bytes, wide)
}
pub fn arguments(bytes: &mut[u8], wide: &mut[u16]) -> backend.Snapshot!error.Error from(bytes, wide) {
    return backend.arguments(bytes, wide)
}
pub fn current_dir(bytes: &mut[u8], wide: &mut[u16]) -> native.NativeString!error.Error from(bytes, wide) {
    return backend.current_dir(bytes, wide)
}
pub fn child_environment(bytes: &mut[u8], wide: &mut[u16]) -> backend.Builder from(bytes, wide) {
    return backend.Builder.new(bytes, wide)
}
// No safe process-global setenv/unsetenv/chdir API: these alter assumptions in
// every native thread. Perform working-directory and environment changes only
// in std/process spawn options. Foreign global mutation must be synchronized
// against all observations by its unsafe caller, including other libraries.
