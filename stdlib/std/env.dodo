package env

import "std/platform/native"
import "std/platform"
import "core/mem"
import "std/platform/error"
import "std/env/native" as backend

// Native Unix bytes / Windows UTF-16 are preserved, including invalid UTF-8
// and unpaired surrogates. Portable callers provide both scratch types; only
// bytes on Unix or wide on Windows is written. Empty unused storage is valid.
pub fn snapshot(bytes: &mut[u8], wide: &mut[u16]) -> backend.Snapshot!error.Error from(bytes, wide) {
    return backend.capture(bytes, wide)
}
pub fn arguments(bytes: &mut[u8], wide: &mut[u16]) -> backend.Snapshot!error.Error from(bytes, wide) {
    return backend.arguments(bytes, wide)
}
pub fn current_dir(bytes: &mut[u8], wide: &mut[u16]) -> native.NativeString!error.Error from(bytes, wide) {
    return backend.current_dir(bytes, wide)
}
pub fn child_environment(bytes: &mut[u8], wide: &mut[u16]) -> backend.Builder from(bytes, wide) {
    return backend.Builder.new(bytes, wide)
}
// No safe process-global setenv/unsetenv/chdir API: these alter assumptions in
// every native thread. Perform working-directory and environment changes only
// in std/process spawn options. Foreign global mutation must be synchronized
// against all observations by its unsafe caller, including other libraries.

// Two reusable 4096-unit native buffers. Output UTF-8 lives in caller storage,
// so looking up another variable does not invalidate an earlier returned string.
pub struct Workspace {
    name: native.Workspace
    value: native.Workspace
    pub fn new() -> Workspace {
        return Workspace { name: native.Workspace.new(), value: native.Workspace.new() }
    }
}
// none is absent; some("") is present and empty. Names are nonempty and may
// not contain NUL or '='. Native names are case sensitive on Linux and ordinal
// case insensitive on Windows. No process-global pointer escapes.
pub fn get(name: &str, output: &mut[u8], workspace: &mut Workspace, policy: platform.TextPolicy) -> Option<&str>!error.Error from(output) {
    bytes := mem.str_bytes(name)
    if bytes.len == 0 {
        return err(error.failure(error.Kind.InvalidInput))
    }
    for i in 0usize..bytes.len {
        if bytes[i] == 61 {
            return err(error.failure(error.Kind.InvalidInput))
        }
    }
    workspace.name.set(name)?
    key := workspace.name.get()?
    if!backend.lookup(&key, &mut workspace.value)? {
        return ok(none)
    }
    value := workspace.value.get()?
    result := platform.decode(&value, output, &policy)?
    return ok(some(result))
}
// Borrows an immutable native snapshot plus an iteration cursor, bounded at 32768 native
// units including one NUL per argument and argv[0]. The conversion policy is
// explicit once at capture. Failed get/next returns no string; next advances
// only after successful conversion, so retry with larger output is possible.
pub struct Arguments {
    storage: &mut native.ListWorkspace
    count: usize
    index: usize
    policy: platform.TextPolicy
    pub fn capture(storage: &mut native.ListWorkspace, policy: platform.TextPolicy) -> Arguments!error.Error from(storage) {
        backend.arguments_into(storage)?
        count := 0usize
        {
            snapshot := backend.view(storage.get()?);
            count = snapshot.len()
        }
        return ok(Arguments { storage: storage, count: count, index: 0, policy: policy })
    }
    pub fn len(&self) -> usize {
        return self.count
    }
    pub fn get(&self, index: usize, output: &mut[u8]) -> Option<&str>!error.Error from(output) {
        snapshot := backend.view(self.storage.get()?)
        match snapshot.at(index) {
            some(value) => {
                result := platform.decode(&value, output, &self.policy)?
                return ok(some(result))
            }
            none => {
                return ok(none)
            }
        }
    }
    pub fn next(&mut self, output: &mut[u8]) -> Option<&str>!error.Error from(output) {
        result := self.get(self.index, output)?
        match result {
            some(value) => {
                self.index += 1;
                return ok(some(value))
            }
            none => {
                return ok(none)
            }
        }
    }
    pub fn rewind(&mut self) {
        self.index = 0
    }
}
