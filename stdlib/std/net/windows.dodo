package windows

import "core/ptr"
import "std/time/hosted"
import "std/io"
import "std/net"

unsafe extern "C" fn dodo_net_error_kind(code: i32) -> u32
unsafe extern "C" fn dodo_net_open(address: *const u8, mode: u32, backlog: u32, error: *mut i32) -> isize
unsafe extern "C" fn dodo_net_close(handle: isize) -> i32
unsafe extern "C" fn dodo_net_accept(handle: isize, error: *mut i32) -> isize
unsafe extern "C" fn dodo_net_address(handle: isize, address: *mut u8, peer: u32) -> i32
unsafe extern "C" fn dodo_net_wait(handle: isize, writing: u32, milliseconds: u32, error: *mut i32) -> i32
unsafe extern "C" fn dodo_net_wait_many(handles: *const isize, interests: *const u32, ready: *mut u32, count: usize, milliseconds: u32, error: *mut i32) -> i32
unsafe extern "C" fn dodo_net_connected(handle: isize, error: *mut i32) -> i32
unsafe extern "C" fn dodo_net_read(handle: isize, data: *mut u8, size: usize, error: *mut i32) -> isize
unsafe extern "C" fn dodo_net_write(handle: isize, data: *const u8, size: usize, error: *mut i32) -> isize
unsafe extern "C" fn dodo_net_shutdown(handle: isize, direction: u32) -> i32
unsafe extern "C" fn dodo_net_sendto(handle: isize, data: *const u8, size: usize, address: *const u8, error: *mut i32) -> isize
unsafe extern "C" fn dodo_net_recvfrom(handle: isize, data: *mut u8, size: usize, address: *mut u8, truncated: *mut u32, original: *mut usize, error: *mut i32) -> isize
unsafe extern "C" fn dodo_net_resolve(host: *const u8, port: u16, output: *mut u8, capacity: usize, numeric_only: u32, error: *mut i32) -> isize

pub fn from_code(code: i32) -> net.Error {
    kind := net.ErrorKind.Other
    tag := 0u32
    unsafe {
        tag = dodo_net_error_kind(code)
    }
    if tag == 1 {
        kind = net.ErrorKind.WouldBlock
    }
    if tag == 2 {
        kind = net.ErrorKind.Interrupted
    }
    if tag == 3 {
        kind = net.ErrorKind.TimedOut
    }
    if tag == 4 {
        kind = net.ErrorKind.Closed
    }
    if tag == 5 {
        kind = net.ErrorKind.ConnectionReset
    }
    if tag == 6 {
        kind = net.ErrorKind.ConnectionRefused
    }
    if tag == 7 {
        kind = net.ErrorKind.AddressInUse
    }
    if tag == 8 {
        kind = net.ErrorKind.NetworkUnreachable
    }
    if tag == 9 {
        kind = net.ErrorKind.InvalidInput
    }
    if tag == 12 {
        kind = net.ErrorKind.NameNotFound
    }
    if tag == 13 {
        kind = net.ErrorKind.Exhausted
    }
    if tag == 14 {
        kind = net.ErrorKind.BufferTooSmall
    }
    return net.Error { kind: kind, code: code, transferred: 0 }
}
fn io_error(reason: net.Error) -> io.Error {
    kind := io.ErrorKind.Other
    if reason.kind == net.ErrorKind.WouldBlock {
        kind = io.ErrorKind.WouldBlock
    }
    if reason.kind == net.ErrorKind.Interrupted {
        kind = io.ErrorKind.Interrupted
    }
    if reason.kind == net.ErrorKind.Closed {
        kind = io.ErrorKind.Closed
    }
    if reason.kind == net.ErrorKind.ConnectionReset {
        kind = io.ErrorKind.ConnectionReset
    }
    if reason.kind == net.ErrorKind.ConnectionRefused {
        kind = io.ErrorKind.ConnectionRefused
    }
    if reason.kind == net.ErrorKind.InvalidInput {
        kind = io.ErrorKind.InvalidInput
    }
    return io.Error { kind: kind, code: reason.code, transferred: reason.transferred }
}
fn encode(address: &net.SocketAddress) -> [24]u8 {
    wire := [0u8; 24]
    wire[0] = 4
    if address.ip.family == net.Family.V6 {
        wire[0] = 6
    }
    wire[2] = (address.port >> 8) as u8
    wire[3] = (address.port & 255) as u8
    for i in 0usize..4 {
        wire[4 + i] = ((address.scope_id >> ((i * 8) as u32)) & 255) as u8
    }
    for i in 0usize..16 {
        wire[8 + i] = address.ip.octets[i]
    }
    return wire
}
fn decode(wire: &[u8]) -> net.SocketAddress {
    octets := [0u8; 16]
    for i in 0usize..16 {
        octets[i] = wire[8 + i]
    }
    family := net.Family.V4
    if wire[0] == 6 {
        family = net.Family.V6
    }
    ip := net.IpAddress { family: family, octets: octets }
    port := ((wire[2] as u16) << 8) | (wire[3] as u16)
    scope := 0u32
    for i in 0usize..4 {
        scope |=(wire[4 + i] as u32) << ((i * 8) as u32)
    }
    return net.SocketAddress { ip: ip, port: port, scope_id: scope }
}
fn open(address: &net.SocketAddress, mode: u32, backlog: u32) -> isize!net.Error {
    if address.ip.family == net.Family.V4 && address.scope_id != 0 {
        return err(net.failure(net.ErrorKind.InvalidInput))
    }
    wire := encode(address)
    code := 0i32
    unsafe {
        handle := dodo_net_open(ptr.as_ptr(&wire), mode, backlog, ptr.from_mut(&mut code))
        if handle == -1 {
            return err(from_code(code))
        }
        return ok(handle)
    }
}
fn address(handle: isize, peer: u32) -> net.SocketAddress!net.Error {
    if handle == -1 {
        return err(net.failure(net.ErrorKind.Closed))
    }
    wire := [0u8; 24]
    unsafe {
        code := dodo_net_address(handle, ptr.as_mut_ptr(&mut wire), peer)
        if code != 0 {
            return err(from_code(code))
        }
    }
    return ok(decode(&wire))
}
fn close(handle: &mut isize) -> void!net.Error {
    if *handle == -1 {
        return ok()
    }
    raw := *handle
    *handle = -1
    unsafe {
        code := dodo_net_close(raw)
        if code != 0 {
            return err(from_code(code))
        }
    }
    return ok()
}
fn wait(handle: isize, interest: &net.Interest, milliseconds: u32) -> bool!net.Error {
    if handle == -1 {
        return err(net.failure(net.ErrorKind.Closed))
    }
    writing := 0u32
    if *interest == net.Interest.Write {
        writing = 1
    }
    code := 0i32
    unsafe {
        result := dodo_net_wait(handle, writing, milliseconds, ptr.from_mut(&mut code))
        if result < 0 {
            return err(from_code(code))
        }
        return ok(result != 0)
    }
}

// A bounded readiness set; no socket ownership or pointer survives wait().
pub const POLL_CAPACITY: usize = 256
pub struct PollSet {
    handles: [256]isize
    interests: [256]u32
    events: [256]u32
    count: usize
    pub fn new() -> PollSet {
        return PollSet { handles: [-1isize; 256], interests: [0u32; 256], events: [0u32; 256], count: 0 }
    }
    pub fn clear(&mut self) {
        self.count = 0
    }
    fn add(&mut self, handle: isize, interest: net.Interest) -> usize!net.Error {
        if handle == -1 {
            return err(net.failure(net.ErrorKind.Closed))
        }
        if self.count == POLL_CAPACITY {
            return err(net.failure(net.ErrorKind.Exhausted))
        }
        index := self.count
        self.handles[index] = handle
        self.interests[index] = 0
        if interest == net.Interest.Write {
            self.interests[index] = 1
        }
        self.events[index] = 0
        self.count += 1
        return ok(index)
    }
    pub fn ready(&self, index: usize) -> bool {
        return index < self.count && self.events[index] != 0
    }
    pub fn wait(&mut self, milliseconds: u32) -> usize!net.Error {
        if self.count == 0 {
            return ok(0)
        }
        code := 0i32
        result := unsafe {
            dodo_net_wait_many(ptr.as_ptr(&self.handles), ptr.as_ptr(&self.interests),
            ptr.as_mut_ptr(&mut self.events), self.count, milliseconds, ptr.from_mut(&mut code))
        }
        if result < 0 {
            return err(from_code(code))
        }
        return ok(result as usize)
    }
}
pub struct TcpConnection {
    handle: isize
    connecting: bool
    failed: bool
    pub fn closed() -> TcpConnection {
        return TcpConnection { handle: -1, connecting: false, failed: false }
    }
    pub fn register(&self, set: &mut PollSet, interest: net.Interest) -> usize!net.Error {
        return set.add(self.handle, interest)
    }
    pub fn connect(address: &net.SocketAddress) -> TcpConnection!net.Error {
        handle := open(address, 0, 0)?
        return ok(TcpConnection { handle: handle, connecting: true, failed: false })
    }
    pub fn poll_connected(&mut self) -> bool!net.Error {
        if self.handle == -1 || self.failed {
            return err(net.failure(net.ErrorKind.Closed))
        }
        if!self.connecting {
            return ok(true)
        }
        code := 0i32
        unsafe {
            result := dodo_net_connected(self.handle, ptr.from_mut(&mut code))
            if result < 0 {
                self.failed = true
                return err(from_code(code))
            }
            if result == 0 {
                return ok(false)
            }
        }
        self.connecting = false
        return ok(true)
    }
    pub fn local_address(&self) -> net.SocketAddress!net.Error {
        return address(self.handle, 0)
    }
    pub fn peer_address(&self) -> net.SocketAddress!net.Error {
        return address(self.handle, 1)
    }
    pub fn wait_ready(&self, interest: net.Interest, milliseconds: u32) -> bool!net.Error {
        return wait(self.handle, &interest, milliseconds)
    }
    // Raw access neither transfers ownership nor permits close/retained I/O.
    pub unsafe fn raw_handle(&self) -> isize {
        return self.handle
    }
    pub fn close(&mut self) -> void!net.Error {
        self.failed = true
        return close(&mut self.handle)
    }
    fn drop(&mut self) {
        match self.close() {
            ok() => {}
            err(_) => {}
        }
    }
    pub fn read(&mut self, destination: &mut[u8]) -> usize!io.Error {
        if destination.len == 0 {
            return ok(0)
        }
        if self.handle == -1 || self.failed {
            return err(io.failure(io.ErrorKind.Closed, 0))
        }
        if self.connecting {
            return err(io.failure(io.ErrorKind.WouldBlock, 0))
        }
        code := 0i32
        unsafe {
            count := dodo_net_read(self.handle, ptr.as_mut_ptr(destination), destination.len, ptr.from_mut(&mut code))
            if count < 0 {
                return err(io_error(from_code(code)))
            }
            return ok(count as usize)
        }
    }
    pub fn write(&mut self, source: &[u8]) -> usize!io.Error {
        if source.len == 0 {
            return ok(0)
        }
        if self.handle == -1 || self.failed {
            return err(io.failure(io.ErrorKind.Closed, 0))
        }
        if self.connecting {
            return err(io.failure(io.ErrorKind.WouldBlock, 0))
        }
        code := 0i32
        unsafe {
            count := dodo_net_write(self.handle, ptr.as_ptr(source), source.len, ptr.from_mut(&mut code))
            if count < 0 {
                return err(io_error(from_code(code)))
            }
            return ok(count as usize)
        }
    }
    pub fn poll_read(&mut self, destination: &mut[u8]) -> io.Poll!io.Error {
        match self.read(destination) {
            ok(count) => {
                state := io.PollState.Ready
                if count == 0 && destination.len != 0 {
                    state = io.PollState.Eof
                }
                return ok(io.Poll { transferred: count, state: state })
            }
            err(reason) => {
                if reason.kind == io.ErrorKind.WouldBlock {
                    return ok(io.Poll { transferred: 0, state: io.PollState.Pending })
                }
                return err(reason)
            }
        }
    }
    pub fn poll_write(&mut self, source: &[u8]) -> io.Poll!io.Error {
        match self.write(source) {
            ok(count) => {
                return ok(io.Poll { transferred: count, state: io.PollState.Ready })
            }
            err(reason) => {
                if reason.kind == io.ErrorKind.WouldBlock {
                    return ok(io.Poll { transferred: 0, state: io.PollState.Pending })
                }
                return err(reason)
            }
        }
    }
    pub fn shutdown(&mut self, direction: net.Shutdown) -> void!net.Error {
        if self.handle == -1 {
            return err(net.failure(net.ErrorKind.Closed))
        }
        value := 2u32
        if direction == net.Shutdown.Read {
            value = 0
        }
        if direction == net.Shutdown.Write {
            value = 1
        }
        unsafe {
            code := dodo_net_shutdown(self.handle, value)
            if code != 0 {
                return err(from_code(code))
            }
        }
        return ok()
    }
}
pub struct TcpListener {
    handle: isize
    pub fn bind(address: &net.SocketAddress, backlog: u32) -> TcpListener!net.Error {
        if backlog == 0 {
            return err(net.failure(net.ErrorKind.InvalidInput))
        }
        handle := open(address, 1, backlog)?
        return ok(TcpListener { handle: handle })
    }
    pub fn register(&self, set: &mut PollSet) -> usize!net.Error {
        return set.add(self.handle, net.Interest.Read)
    }
    pub fn local_address(&self) -> net.SocketAddress!net.Error {
        return address(self.handle, 0)
    }
    pub fn wait_ready(&self, milliseconds: u32) -> bool!net.Error {
        interest := net.Interest.Read
        return wait(self.handle, &interest, milliseconds)
    }
    pub fn accept(&mut self) -> Option<TcpConnection>!net.Error {
        if self.handle == -1 {
            return err(net.failure(net.ErrorKind.Closed))
        }
        code := 0i32
        unsafe {
            handle := dodo_net_accept(self.handle, ptr.from_mut(&mut code))
            if handle == -1 {
                reason := from_code(code)
                if reason.kind == net.ErrorKind.WouldBlock {
                    return ok(none)
                }
                return err(reason)
            }
            return ok(some(TcpConnection { handle: handle, connecting: false, failed: false }))
        }
    }
    pub fn close(&mut self) -> void!net.Error {
        return close(&mut self.handle)
    }
    fn drop(&mut self) {
        match self.close() {
            ok() => {}
            err(_) => {}
        }
    }
}
pub struct Datagram {
    pub transferred: usize
    pub peer: net.SocketAddress
    pub truncated: bool
    // Windows cannot report original length after consuming an oversized packet.
    pub original_size: Option<usize>
}
pub struct UdpSocket {
    handle: isize
    pub fn bind(address: &net.SocketAddress) -> UdpSocket!net.Error {
        handle := open(address, 2, 0)?
        return ok(UdpSocket { handle: handle })
    }
    pub fn local_address(&self) -> net.SocketAddress!net.Error {
        return address(self.handle, 0)
    }
    pub fn wait_ready(&self, interest: net.Interest, milliseconds: u32) -> bool!net.Error {
        return wait(self.handle, &interest, milliseconds)
    }
    pub fn send_to(&mut self, data: &[u8], destination: &net.SocketAddress) -> usize!net.Error {
        if destination.ip.family == net.Family.V4 && destination.scope_id != 0 {
            return err(net.failure(net.ErrorKind.InvalidInput))
        }
        if self.handle == -1 {
            return err(net.failure(net.ErrorKind.Closed))
        }
        wire := encode(destination)
        code := 0i32
        unsafe {
            count := dodo_net_sendto(self.handle, ptr.as_ptr(data), data.len, ptr.as_ptr(&wire), ptr.from_mut(&mut code))
            if count < 0 {
                return err(from_code(code))
            }
            if count as usize != data.len {
                reason := net.failure(net.ErrorKind.Other)
                reason.transferred = count as usize
                return err(reason)
            }
            return ok(count as usize)
        }
    }
    // Exactly one packet is consumed, including an empty datagram or a zero
    // capacity destination. Truncated suffixes are discarded by the OS.
    pub fn receive_from(&mut self, data: &mut[u8]) -> Datagram!net.Error {
        if self.handle == -1 {
            return err(net.failure(net.ErrorKind.Closed))
        }
        wire := [0u8; 24]
        code := 0i32
        truncated := 0u32
        original := 0usize
        count := 0isize
        unsafe {
            count = dodo_net_recvfrom(self.handle, ptr.as_mut_ptr(data), data.len, ptr.as_mut_ptr(&mut wire), ptr.from_mut(&mut truncated), ptr.from_mut(&mut original), ptr.from_mut(&mut code))
        }
        if count < 0 {
            return err(from_code(code))
        }
        size: Option<usize> = none
        if original != ~0usize {
            size = some(original)
        }
        return ok(Datagram { transferred: count as usize, peer: decode(&wire), truncated: truncated != 0, original_size: size })
    }
    pub fn close(&mut self) -> void!net.Error {
        return close(&mut self.handle)
    }
    fn drop(&mut self) {
        match self.close() {
            ok() => {}
            err(_) => {}
        }
    }
}
// Explicitly selected platform resolver; synchronous and not interruptible.
// Result owns a checked borrow of caller storage containing 24-byte addresses.
pub struct Addresses {
    wire: &[u8]
    pub truncated: bool
    pub fn len(&self) -> usize {
        return self.wire.len / 24
    }
    pub fn get(&self, index: usize) -> net.SocketAddress!net.Error {
        if index >= self.len() {
            return err(net.failure(net.ErrorKind.InvalidInput))
        }
        return ok(decode(&self.wire[index * 24..index * 24 + 24]))
    }
}
pub fn resolve(host: &[u8], port: u16, workspace: &mut[u8]) -> Addresses!net.Error from(workspace) {
    return resolve_impl(host, port, workspace, 0)
}
// Select the platform numeric parser without consulting any name service.
pub fn resolve_numeric(host: &[u8], port: u16, workspace: &mut[u8]) -> Addresses!net.Error from(workspace) {
    return resolve_impl(host, port, workspace, 1)
}
fn resolve_impl(host: &[u8], port: u16, workspace: &mut[u8], numeric_only: u32) -> Addresses!net.Error from(workspace) {
    if host.len == 0 || host.len > 253 {
        return err(net.failure(net.ErrorKind.InvalidInput))
    }
    if workspace.len < 24 {
        return err(net.failure(net.ErrorKind.BufferTooSmall))
    }
    name := [0u8; 254]
    for i in 0usize..host.len {
        if host[i] == 0 || host[i] > 127 || host[i] <= 32 {
            return err(net.failure(net.ErrorKind.InvalidInput))
        }
        name[i] = host[i]
    }
    code := 0i32
    count := 0isize
    unsafe {
        count = dodo_net_resolve(ptr.as_ptr(&name), port, ptr.as_mut_ptr(workspace), workspace.len / 24, numeric_only, ptr.from_mut(&mut code))
    }
    if count < 0 {
        return err(from_code(code))
    }
    return ok(Addresses { wire: &workspace[..(count as usize) * 24], truncated: code != 0 })
}
pub struct MonotonicClock {
    pub fn now_ms(&mut self) -> u64 {
        clock := hosted.MonotonicClock.new()
        return clock.now_ms()
    }
}
// Blocking composition is explicit and bounded to at most 10ms per readiness
// wait. No worker or background operation is created. Cancellation has precedence.
pub fn connect_with<C, X>(address: &net.SocketAddress, operation: &net.Operation, clock: &mut C, cancel: &X) -> TcpConnection!net.Error {
    operation.check(clock, cancel)?
    connection := TcpConnection.connect(address)?
    for true {
        operation.check(clock, cancel)?
        if connection.poll_connected()? {
            return ok(connection)
        }
        ready := connection.wait_ready(net.Interest.Write, 10)?
    }
    return err(net.failure(net.ErrorKind.Other))
}
