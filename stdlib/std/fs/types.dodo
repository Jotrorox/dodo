package types

// Public OS-independent data contracts. Timestamp fields are Unix epoch based;
// absent platform data is identified by the corresponding capability flag.
pub enum FileKind {
    File, Directory, SymbolicLink, Other
}
pub struct Metadata {
    pub kind: FileKind
    pub size: u64
    pub modified_seconds: i64
    pub modified_nanoseconds: u32
    pub readonly: bool
    pub unix_metadata: bool
    pub mode: u32
    pub uid: u32
    pub gid: u32
    pub device: u64
    pub inode: u64
    pub links: u64
}
pub struct Capabilities {
    pub symbolic_links: bool
    pub unix_permissions: bool
    pub windows_sharing: bool
    pub directory_sync: bool
}
