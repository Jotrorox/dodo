package window

import "core/mem"
import "std/graphics"
import "std/time"
import "std/window/handle"
import "std/window/heap"
import "std/window/native" as backend
import "std/window/raw"

// Open desktop windows and draw into them with std/graphics.
//
// An App is the program's connection to the window system and its event
// loop; app.open() opens any number of windows on it. Every event names the
// window it belongs to, and all of them arrive through the App: wait_event()
// blocks for the next one, poll_event() returns none when nothing is pending,
// so a program's main loop is an ordinary loop with no callbacks.
//
// A window owns a pixel buffer the size of its drawing area. canvas() lends
// it out as a graphics.Canvas; update() shows the parts that changed. An
// animation asks for a Frame event with request_frame() and draws when it
// arrives, once per display refresh.
//
// Each operating system's own window system is used directly, with nothing
// to install: the X11 protocol over a socket on Linux, AppKit on macOS and
// user32/gdi32 on Windows. A process has at most one App at a time, and must
// use it and its windows from the thread that created it; on macOS that has
// to be the main thread.
//
// Desktop programs also get the system clipboard through the App
// (set_clipboard_text and clipboard_text), standard pointer shapes with
// set_cursor(), and control over a window's size, size limits and fullscreen
// state from code.
//
// A GPU draws into a window through native_handle(), which hands Vulkan,
// OpenGL or Metal the window system's own objects. A window opened with
// Options.gpu() has no pixel buffer at all, for programs that draw only on
// the GPU.

// Why a window could not be opened or used; see raw.Error for each variant.
pub type Error = raw.Error

// The window-system objects behind a window, for GPU APIs; see
// std/window/handle.
pub type NativeHandle = handle.NativeHandle

pub fn error_name(error: Error) -> &str from(static) {
    match error {
        Error.NoDisplay => {
            return "NoDisplay"
        }
        Error.AlreadyOpen => {
            return "AlreadyOpen"
        }
        Error.Closed => {
            return "Closed"
        }
        Error.InvalidInput => {
            return "InvalidInput"
        }
        Error.OutOfMemory => {
            return "OutOfMemory"
        }
        Error.Protocol => {
            return "Protocol"
        }
        Error.Unsupported => {
            return "Unsupported"
        }
        Error.System => {
            return "System"
        }
    }
}

// The largest accepted width or height, in pixels.
pub const MAX_SIZE: u32 = 16384

// Names one window of the App. Ids start at 1 and are never reused within a
// process, so an event can be told apart from those of a window closed
// earlier; 0 is no window.
pub type WindowId = u32

// How to open a window. The size is the drawing area's, excluding the title
// bar and borders, in the window system's own units: points on macOS and
// pixels at the system scale on Windows, so a window looks the same size on
// every display. The canvas is in physical pixels, scale_percent() / 100
// times larger. X11 has no system scale; there both are pixels.
pub struct Options {
    pub title: &str
    pub width: u32
    pub height: u32
    // Whether the user may resize the window.
    pub resizable: bool
    // Whether the window has a pixel buffer for canvas() and update(). A
    // window that only a GPU draws into needs none, which saves its memory
    // and the copy on every resize.
    pub pixel_buffer: bool

    // A resizable window with the given title and size and a pixel buffer.
    pub fn new(title: &str, width: u32, height: u32) -> Options from(title) {
        return Options { title: title, width: width, height: height, resizable: true, pixel_buffer: true }
    }
    // A resizable window without a pixel buffer, for drawing with Vulkan,
    // OpenGL or Metal through native_handle().
    pub fn gpu(title: &str, width: u32, height: u32) -> Options from(title) {
        return Options { title: title, width: width, height: height, resizable: true, pixel_buffer: false }
    }
}

// Something that happened to one of the App's windows, named by the
// WindowId each variant starts with; event_window() reads it from any event.
pub enum Event {
    // The user asked to close the window, for example with its close button.
    // The window stays open until close() or the end of its lifetime, so a
    // program may still ask "save changes?".
    Close(window: WindowId),
    // The drawing area changed size. The window's canvas() has the new size
    // from now on and keeps the old picture in its top-left corner; redraw
    // and update().
    Resize(window: WindowId, width: u32, height: u32),
    // The window gained (true) or lost (false) keyboard focus.
    Focus(window: WindowId, focused: bool),
    // A key went down, repeated, or came up in the focused window.
    Key(window: WindowId, key: KeyEvent),
    // Text typed through the keyboard layout, one Unicode scalar value per
    // event, after any Key event for the same keystroke. Control characters
    // are not reported; use Key events for Enter, Tab and Backspace.
    Text(window: WindowId, code_point: u32),
    // The pointer moved to (x, y) inside the drawing area.
    MouseMove(window: WindowId, x: i32, y: i32),
    // A mouse button went down or came up.
    MouseButton(window: WindowId, button: ButtonEvent),
    // The pointer left the drawing area.
    MouseLeave(window: WindowId),
    // A wheel or trackpad scrolled. 120 units are one wheel notch; trackpads
    // report finer amounts. Positive dx scrolls right, positive dy down.
    Scroll(window: WindowId, dx: i32, dy: i32),
    // Time to draw the window's next frame, which request_frame() asked for.
    Frame(window: WindowId),
    // The user asked the whole application to quit: Command-Q or the Quit
    // menu item on macOS. Other systems close windows one at a time and
    // never send it.
    Quit
}

// The window an event belongs to; 0 for Quit, which belongs to none.
pub fn event_window(event: &Event) -> WindowId {
    match event {
        Event.Close(id) => {
            return *id
        }
        Event.Resize(id, _, _) => {
            return *id
        }
        Event.Focus(id, _) => {
            return *id
        }
        Event.Key(id, _) => {
            return *id
        }
        Event.Text(id, _) => {
            return *id
        }
        Event.MouseMove(id, _, _) => {
            return *id
        }
        Event.MouseButton(id, _) => {
            return *id
        }
        Event.MouseLeave(id) => {
            return *id
        }
        Event.Scroll(id, _, _) => {
            return *id
        }
        Event.Frame(id) => {
            return *id
        }
        Event.Quit => {
            return 0
        }
    }
}

// A physical key press or release. `key` names the key's position on a US
// keyboard regardless of the active layout, so WASD stays under the left hand
// on AZERTY keyboards too; use Text events for the characters typed.
pub struct KeyEvent {
    pub key: Key
    pub pressed: bool
    // True for presses generated by holding the key down.
    pub repeat: bool
    pub modifiers: Modifiers
}

pub enum Button {
    Left,
    Middle,
    Right,
    // The side buttons many mice have.
    Back,
    Forward
}

pub struct ButtonEvent {
    pub button: Button
    pub pressed: bool
    // The pointer position in the drawing area.
    pub x: i32
    pub y: i32
    pub modifiers: Modifiers
}

// The modifier keys held during an input event.
pub struct Modifiers {
    bits: u32

    pub fn none() -> Modifiers {
        return Modifiers { bits: 0 }
    }
    pub fn shift(&self) -> bool {
        return (self.bits & raw.SHIFT) != 0
    }
    pub fn control(&self) -> bool {
        return (self.bits & raw.CONTROL) != 0
    }
    // Alt, called Option on Mac keyboards.
    pub fn alt(&self) -> bool {
        return (self.bits & raw.ALT) != 0
    }
    // The Windows or Super key, or Command on Mac keyboards.
    pub fn meta(&self) -> bool {
        return (self.bits & raw.META) != 0
    }
    pub fn caps_lock(&self) -> bool {
        return (self.bits & raw.CAPS_LOCK) != 0
    }
    // The platform's shortcut modifier: Command on macOS, Control elsewhere.
    pub fn shortcut(&self) -> bool {
        if backend.SHORTCUT_IS_META {
            return self.meta()
        }
        return self.control()
    }
}

// A standard mouse pointer shape for set_cursor(). Each system draws its own
// version, so the pointer looks like the rest of the desktop; on X11 the
// shapes come from the server's core cursor font, which is plainer than
// desktop cursor themes.
pub enum Cursor {
    // The ordinary arrow.
    Arrow,
    // The I-beam over editable or selectable text.
    Text,
    // The pointing hand over links and other clickable things.
    Hand,
    Crosshair,
    // Arrows in four directions, for moving something; an open hand on
    // macOS, which has no such arrow.
    Move,
    // Resizing left and right, as over a vertical divider.
    ResizeEW,
    // Resizing up and down, as over a horizontal divider.
    ResizeNS,
    // Resizing along the diagonal from top left to bottom right.
    ResizeNWSE,
    // Resizing along the diagonal from top right to bottom left.
    ResizeNESW,
    // The action under the pointer is not possible.
    NotAllowed,
    // The program is busy: an hourglass or spinning circle, and on macOS
    // the arrow with a spinning wheel.
    Wait
}

// The ordinal the adapters take, in the order of the variants above.
fn cursor_code(cursor: &Cursor) -> u32 {
    match cursor {
        Cursor.Arrow => {
            return 0
        }
        Cursor.Text => {
            return 1
        }
        Cursor.Hand => {
            return 2
        }
        Cursor.Crosshair => {
            return 3
        }
        Cursor.Move => {
            return 4
        }
        Cursor.ResizeEW => {
            return 5
        }
        Cursor.ResizeNS => {
            return 6
        }
        Cursor.ResizeNWSE => {
            return 7
        }
        Cursor.ResizeNESW => {
            return 8
        }
        Cursor.NotAllowed => {
            return 9
        }
        Cursor.Wait => {
            return 10
        }
    }
}

// Text read from the clipboard with App.clipboard_text(). It owns its bytes,
// so it stays valid while the program keeps working with the App.
pub struct ClipboardText {
    bytes: heap.Bytes

    // The text, always valid UTF-8: malformed bytes another program put on
    // the clipboard read as U+FFFD.
    pub fn as_str(&self) -> &str from(self) {
        return unsafe {
            mem.str_from_utf8(self.bytes.view())
        }
    }
    // Its length in bytes.
    pub fn len(&self) -> usize {
        return self.bytes.len()
    }
    // True when the clipboard held no text.
    pub fn is_empty(&self) -> bool {
        return self.bytes.len() == 0
    }
}

// The length of the well-formed UTF-8 sequence at `at`, or 0 when the byte
// there does not start one.
fn utf8_sequence(bytes: &[u8], at: usize) -> usize {
    first := bytes[at]
    if first < 0x80 {
        return 1
    }
    length := 0usize
    low := 0x80u8
    high := 0xbfu8
    if first >= 0xc2 && first <= 0xdf {
        length = 2
    } else if first >= 0xe0 && first <= 0xef {
        length = 3
        if first == 0xe0 {
            low = 0xa0
        } else if first == 0xed {
            high = 0x9f
        }
    } else if first >= 0xf0 && first <= 0xf4 {
        length = 4
        if first == 0xf0 {
            low = 0x90
        } else if first == 0xf4 {
            high = 0x8f
        }
    } else {
        return 0
    }
    if at + length > bytes.len {
        return 0
    }
    second := bytes[at + 1]
    if second < low || second > high {
        return 0
    }
    for i in 2usize..length {
        next := bytes[at + i]
        if next < 0x80 || next > 0xbf {
            return 0
        }
    }
    return length
}

// `bytes` with each byte that starts no well-formed UTF-8 sequence replaced
// by U+FFFD; `bytes` itself when it is valid already.
fn repair_utf8(bytes: heap.Bytes) -> heap.Bytes!Error {
    size := 0usize
    bad := false
    {
        view := bytes.view()
        at := 0usize
        for at < view.len {
            length := utf8_sequence(view, at)
            if length == 0 {
                bad = true
                size += 3
                at += 1
            } else {
                size += length
                at += length
            }
        }
    }
    if !bad {
        return ok(bytes)
    }
    repaired := match heap.Bytes.new(size) {
        some(memory) => memory,
        none => {
            return err(Error.OutOfMemory)
        }
    }
    {
        view := bytes.view()
        out := repaired.bytes()
        at := 0usize
        put := 0usize
        for at < view.len {
            length := utf8_sequence(view, at)
            if length == 0 {
                out[put] = 0xef
                out[put + 1] = 0xbf
                out[put + 2] = 0xbd
                put += 3
                at += 1
            } else {
                for i in 0usize..length {
                    out[put + i] = view[at + i]
                }
                put += length
                at += length
            }
        }
    }
    return ok(repaired)
}

fn button_from_code(code: u32) -> Button {
    if code == 1 {
        return Button.Middle
    }
    if code == 2 {
        return Button.Right
    }
    if code == 3 {
        return Button.Back
    }
    if code == 4 {
        return Button.Forward
    }
    return Button.Left
}

fn convert(event: &raw.Event) -> Option<Event> {
    kind := event.kind
    id := event.window
    if kind == raw.CLOSE {
        return some(Event.Close(id))
    }
    if kind == raw.RESIZE {
        return some(Event.Resize(id, event.x as u32, event.y as u32))
    }
    if kind == raw.FOCUS {
        return some(Event.Focus(id, (event.flags & raw.PRESSED) != 0))
    }
    if kind == raw.KEY {
        return some(Event.Key(id, KeyEvent { key: key_from_code(event.code), pressed: (event.flags & raw.PRESSED) != 0, repeat: (event.flags & raw.REPEAT) != 0, modifiers: Modifiers { bits: event.modifiers } }))
    }
    if kind == raw.TEXT {
        return some(Event.Text(id, event.code))
    }
    if kind == raw.MOUSE_MOVE {
        return some(Event.MouseMove(id, event.x, event.y))
    }
    if kind == raw.MOUSE_BUTTON {
        return some(Event.MouseButton(id, ButtonEvent { button: button_from_code(event.code), pressed: (event.flags & raw.PRESSED) != 0, x: event.x, y: event.y, modifiers: Modifiers { bits: event.modifiers } }))
    }
    if kind == raw.MOUSE_LEAVE {
        return some(Event.MouseLeave(id))
    }
    if kind == raw.SCROLL {
        return some(Event.Scroll(id, event.x, event.y))
    }
    if kind == raw.QUIT {
        return some(Event.Quit)
    }
    return none
}

// -- Frame pacing -------------------------------------------------------------

// The frame state of one open window, in backend clock() nanoseconds.
struct Pacer {
    window: u32
    // When the requested frame is due; 0 while none is requested.
    deadline: u64
    // When the last frame was.
    previous: u64
    // A FRAME event was requested from the window system and has not
    // arrived yet.
    native: bool
    // A FRAME event arrived: the display refreshed since the request.
    signalled: bool
}

// One Pacer per open window. Windows are handles that do not borrow their
// App, so the App finds the frames they asked for here.
static mut PACERS: heap.Table<Pacer> = heap.Table<Pacer> { address: 0, count: 0, capacity: 0 }

fn pacer_add(id: u32) -> bool {
    unsafe {
        return PACERS.push(Pacer { window: id, deadline: 0, previous: 0, native: false, signalled: false })
    }
}

fn pacer_remove(id: u32) {
    unsafe {
        count := PACERS.len()
        for i in 0usize..count {
            found := false
            {
                records := PACERS.records()
                found = records[i].window == id
            }
            if found {
                PACERS.remove(i)
                return
            }
        }
    }
}

fn frame_period(id: u32) -> u64 {
    period := backend.Backend.frame_period(id)
    if period == 0 {
        return 16666667
    }
    return period
}

// Set the deadline of window `id`'s next frame unless one is pending.
fn pacer_request(id: u32) -> void!Error {
    unsafe {
        records := PACERS.records()
        for i in 0usize..records.len {
            if records[i].window != id {
                continue
            }
            if records[i].deadline != 0 {
                return ok()
            }
            period := frame_period(id)
            if !records[i].native && !records[i].signalled {
                requested := backend.Backend.request_frame(id)?
                records[i].native = requested
            }
            now := backend.Backend.clock()
            if records[i].native || records[i].signalled {
                // The FRAME event ends the wait; this deadline only matters
                // when the display stops reporting refreshes.
                records[i].deadline = now + 2 * period
                return ok()
            }
            vblank := backend.Backend.next_vblank(id, now)
            if vblank > now {
                records[i].deadline = vblank
                return ok()
            }
            // A timer at the refresh rate that keeps its phase, skipping the
            // frames that were missed.
            deadline := records[i].previous + period
            if deadline <= now {
                deadline += ((now - deadline) / period + 1) * period
            }
            records[i].deadline = deadline
            return ok()
        }
    }
    return err(Error.Closed)
}

// The display of window `id` refreshed after a request_frame().
fn pacer_signal(id: u32) {
    unsafe {
        records := PACERS.records()
        for i in 0usize..records.len {
            if records[i].window == id {
                records[i].native = false
                records[i].signalled = true
                return
            }
        }
    }
}

// A window whose requested frame is due at `now`, marked as delivered, or 0.
fn pacer_due(now: u64) -> u32 {
    unsafe {
        records := PACERS.records()
        for i in 0usize..records.len {
            deadline := records[i].deadline
            if deadline == 0 || (!records[i].signalled && now < deadline) {
                continue
            }
            if records[i].signalled {
                records[i].previous = now
            } else {
                records[i].previous = deadline
            }
            records[i].signalled = false
            records[i].deadline = 0
            return records[i].window
        }
    }
    return 0
}

// The earliest pending frame deadline, or 0 when no frame is requested.
fn pacer_earliest() -> u64 {
    earliest := 0u64
    unsafe {
        records := PACERS.view()
        for i in 0usize..records.len {
            deadline := records[i].deadline
            if deadline != 0 && (earliest == 0 || deadline < earliest) {
                earliest = deadline
            }
        }
    }
    return earliest
}

fn pacer_clear() {
    unsafe {
        PACERS.clear()
    }
}

// -- App ----------------------------------------------------------------------

// The connection to the window system and the event loop of every window
// opened on it. Dropping the App, or close(), closes all its windows.
pub struct App {
    active: bool
    pending: raw.Event
    // A frame is requested, which keeps macOS from napping.
    animating: bool

    // Connect to the window system. Fails with NoDisplay without one,
    // AlreadyOpen while another App exists, and Unsupported off the main
    // thread on macOS.
    pub fn new() -> App!Error {
        backend.Backend.connect()?
        return ok(App { active: true, pending: raw.Event.empty(), animating: false })
    }

    // Open a window and show it. Fails with InvalidInput for a zero size or
    // one above MAX_SIZE.
    pub fn open(&mut self, options: Options) -> Window!Error {
        if !self.active {
            return err(Error.Closed)
        }
        if options.width == 0 || options.height == 0 || options.width > MAX_SIZE || options.height > MAX_SIZE {
            return err(Error.InvalidInput)
        }
        id := backend.Backend.open(options.title, options.width, options.height, options.resizable, options.pixel_buffer)?
        if !pacer_add(id) {
            backend.Backend.close(id)
            return err(Error.OutOfMemory)
        }
        win := Window { id: id, pixel_buffer: options.pixel_buffer, pixels: heap.Bytes.empty(), width: 0, height: 0, min_width: 0, min_height: 0, max_width: 0, max_height: 0 }
        if !win.sync() {
            return err(Error.OutOfMemory)
        }
        return ok(win)
    }

    // The next event of any window, waiting as long as it takes.
    pub fn wait_event(&mut self) -> Event!Error {
        for {
            if let some(event) = self.next(raw.FOREVER)? {
                return ok(event)
            }
        }
    }
    // The next event if one is pending, without waiting.
    pub fn poll_event(&mut self) -> Option<Event>!Error {
        return self.next(0)
    }
    // The next event, waiting at most `milliseconds` for one; none when the
    // time passes first.
    pub fn wait_event_timeout(&mut self, milliseconds: u32) -> Option<Event>!Error {
        limit := milliseconds
        if limit == raw.FOREVER {
            limit = raw.FOREVER - 1
        }
        return self.next(limit)
    }

    // -- Clipboard --------------------------------------------------------

    // Put `text` on the system clipboard, replacing what it held, for this
    // and other programs to paste. Line endings are kept as they are.
    //
    // On X11 the clipboard is a conversation between programs: the App
    // keeps the text and hands it to programs that paste while the App's
    // event loop runs, until another program copies something or the App
    // closes. A clipboard manager, which most desktops run, keeps the text
    // available after that.
    pub fn set_clipboard_text(&mut self, text: &str) -> void!Error {
        if !self.active {
            return err(Error.Closed)
        }
        return backend.Backend.set_clipboard(mem.str_bytes(text))
    }
    // The text on the system clipboard; empty when it holds none, such as
    // when an image was copied. Text this App copied comes back unchanged.
    //
    // On X11 this asks the program that copied for the text and waits for
    // it, at most a second for each part of a large transfer. Events that
    // arrive meanwhile are kept and returned by the next wait_event or
    // poll_event, in order. A program that never answers reads as empty.
    pub fn clipboard_text(&mut self) -> ClipboardText!Error {
        if !self.active {
            return err(Error.Closed)
        }
        bytes := backend.Backend.clipboard()?
        repaired := repair_utf8(bytes)?
        return ok(ClipboardText { bytes: repaired })
    }

    // Close every window and the connection. Later calls fail with Closed;
    // closing twice does nothing. The windows' handles stay valid but report
    // Closed, and their canvases are empty.
    pub fn close(&mut self) {
        if !self.active {
            return
        }
        self.active = false
        pacer_clear()
        if self.animating {
            self.animating = false
            backend.Backend.set_animating(false)
        }
        backend.Backend.disconnect()
    }
    fn drop(&mut self) {
        self.close()
    }

    // Frames that are due come first, so a stream of input does not hold
    // them back; waits for input end at the earliest frame deadline.
    fn next(&mut self, milliseconds: u32) -> Option<Event>!Error {
        if !self.active {
            return err(Error.Closed)
        }
        start := backend.Backend.clock()
        for {
            now := backend.Backend.clock()
            due := pacer_due(now)
            if due != 0 {
                return ok(some(Event.Frame(due)))
            }
            earliest := pacer_earliest()
            self.set_animating(earliest != 0)
            wait := milliseconds
            if milliseconds != raw.FOREVER {
                elapsed := (now - start) / 1000000
                if elapsed >= milliseconds as u64 {
                    wait = 0
                } else {
                    wait = milliseconds - elapsed as u32
                }
            }
            if earliest != 0 {
                // Round up so the wait never ends early and spins.
                until := (earliest - now + 999999) / 1000000
                if until > 1000 {
                    until = 1000
                }
                if wait == raw.FOREVER || until < wait as u64 {
                    wait = until as u32
                }
            }
            if backend.Backend.next_event(wait, &mut self.pending)? {
                if self.pending.kind == raw.FRAME {
                    pacer_signal(self.pending.window)
                } else if let some(event) = convert(&self.pending) {
                    return ok(some(event))
                }
                continue
            }
            if milliseconds != raw.FOREVER {
                after := backend.Backend.clock()
                if (after - start) / 1000000 >= milliseconds as u64 {
                    late := pacer_due(after)
                    if late != 0 {
                        return ok(some(Event.Frame(late)))
                    }
                    return ok(none)
                }
            }
        }
    }
    // macOS must not throttle the program with App Nap while it animates.
    fn set_animating(&mut self, animating: bool) {
        if animating != self.animating {
            self.animating = animating
            backend.Backend.set_animating(animating)
        }
    }
}

// -- Window -------------------------------------------------------------------

// An open window. Closing happens with close() or when the value is dropped.
// A window does not borrow its App; once the App is gone it reports Closed.
pub struct Window {
    id: u32
    // False for a window opened with Options.gpu(), which never has pixels.
    pixel_buffer: bool
    // The pixel buffer, owned here so that only this window's own methods
    // replace it, and its size. The window system repaints from it.
    pixels: heap.Bytes
    width: u32
    height: u32
    // The size limits from set_min_size and set_max_size; 0 is no limit.
    min_width: u32
    min_height: u32
    max_width: u32
    max_height: u32

    // The id its events carry.
    pub fn id(&self) -> WindowId {
        return self.id
    }
    // Size of the drawing area in pixels; also the size of canvas(). After a
    // Resize event it is the new size. 0 by 0 once the window is closed.
    pub fn size(&self) -> graphics.Size {
        width := 0u32
        height := 0u32
        backend.Backend.size(self.id, &mut width, &mut height)
        return graphics.Size { width: width, height: height }
    }
    pub fn width(&self) -> u32 {
        width := 0u32
        height := 0u32
        backend.Backend.size(self.id, &mut width, &mut height)
        return width
    }
    pub fn height(&self) -> u32 {
        width := 0u32
        height := 0u32
        backend.Backend.size(self.id, &mut width, &mut height)
        return height
    }
    // How much the window system enlarges content, in percent: 100 on a
    // classic display, 200 on a Retina or other high-density one. Canvases
    // are always in physical pixels; multiply sizes by this to keep them
    // readable, for example with font.medium().scaled(window.scale()).
    pub fn scale_percent(&self) -> u32 {
        return backend.Backend.scale_percent(self.id)
    }
    // scale_percent() rounded to a whole factor, at least 1.
    pub fn scale(&self) -> u32 {
        factor := (backend.Backend.scale_percent(self.id) + 50) / 100
        if factor == 0 {
            return 1
        }
        return factor
    }

    // Whether the window has a pixel buffer: false when it was opened with
    // Options.gpu().
    pub fn has_pixel_buffer(&self) -> bool {
        return self.pixel_buffer
    }

    // The window's pixel buffer as a canvas, in graphics.PixelFormat.Bgra8888.
    // It keeps what was drawn into it until the window is resized, when it
    // takes the new size here, keeping the old picture in its top-left
    // corner. Drawing shows nothing until update(). A window without a pixel
    // buffer lends out an empty 0x0 canvas.
    pub fn canvas(&mut self) -> graphics.Canvas from(self) {
        self.sync()
        width := self.width
        height := self.height
        return graphics.Canvas.with_stride(self.pixels.bytes(), width, height, width as usize * 4, graphics.PixelFormat.Bgra8888)!
    }
    // Show the `dirty` part of the pixel buffer, typically the rectangle
    // canvas.take_dirty() returned. An empty rectangle shows nothing. Fails
    // with Unsupported for a window without a pixel buffer, whose frames the
    // GPU presents.
    pub fn update(&mut self, dirty: graphics.Rect) -> void!Error {
        if !self.pixel_buffer {
            self.check()?
            return err(Error.Unsupported)
        }
        bounds := graphics.Rect { x: 0, y: 0, width: self.width, height: self.height }
        area := dirty.intersect(&bounds)
        if area.is_empty() {
            return self.check()
        }
        return backend.Backend.present(self.id, area.x, area.y, area.width, area.height)
    }
    // Show the whole pixel buffer. Fails with Unsupported for a window
    // without one.
    pub fn update_all(&mut self) -> void!Error {
        if !self.pixel_buffer {
            self.check()?
            return err(Error.Unsupported)
        }
        if self.width == 0 || self.height == 0 {
            return self.check()
        }
        return backend.Backend.present(self.id, 0, 0, self.width, self.height)
    }

    // Ask for one Frame event of this window when it is time to draw the
    // next frame. An animation draws on each Frame and asks again:
    //
    //     win.request_frame()?
    //     for {
    //         match app.wait_event()? {
    //             window.Event.Frame(_) => {
    //                 ...draw, then win.update(dirty)?...
    //                 win.request_frame()?
    //             }
    //             ...other events...
    //         }
    //     }
    //
    // Frames come once per display refresh, frame_interval() apart, however
    // many events arrive. Where the window system reports refreshes frames
    // follow them: a display link on macOS 14 and later, the compositor's
    // timing on Windows and the Present extension on X11; elsewhere a timer
    // keeps the pace. A program slower than the display skips refreshes
    // rather than falling behind, and a hidden window, whose display reports
    // no refreshes, still gets a frame every two intervals. Asking again
    // before the Frame arrives changes nothing. While any window waits for a
    // frame macOS does not put the program to sleep with App Nap.
    pub fn request_frame(&mut self) -> void!Error {
        return pacer_request(self.id)
    }
    // How long one display refresh lasts, such as about 16.7 ms at 60 Hz:
    // the time between Frame events, for advancing an animation by one
    // frame. 60 Hz when the window system does not say; on X11 the real
    // period is known after about half a second of frames.
    pub fn frame_interval(&self) -> time.Duration {
        return time.Duration.from_nanos(frame_period(self.id))
    }

    pub fn set_title(&mut self, title: &str) -> void!Error {
        return backend.Backend.set_title(self.id, title)
    }
    // Show or hide the mouse pointer while it is over the window.
    pub fn set_cursor_visible(&mut self, visible: bool) -> void!Error {
        return backend.Backend.set_cursor_visible(self.id, visible)
    }
    // Show `cursor` while the pointer is over the drawing area, until the
    // next call; new windows show Cursor.Arrow. A pointer hidden with
    // set_cursor_visible(false) stays hidden and takes the shape when shown
    // again.
    pub fn set_cursor(&mut self, cursor: Cursor) -> void!Error {
        return backend.Backend.set_cursor(self.id, cursor_code(&cursor))
    }

    // -- Size and fullscreen ------------------------------------------------

    // Resize the drawing area to `width` by `height` in the units of
    // Options: points on macOS, pixels at the system scale on Windows and
    // pixels on X11. The size is kept within set_min_size and set_max_size.
    // The window system may adjust it further, for example to fit the
    // screen; the size it settles on arrives as a Resize event, after which
    // size() and canvas() have it. Works on windows the user cannot resize
    // too. While the window is fullscreen the size applies when it leaves
    // fullscreen. Fails with InvalidInput for a zero size or one above
    // MAX_SIZE.
    pub fn set_size(&mut self, width: u32, height: u32) -> void!Error {
        if width == 0 || height == 0 || width > MAX_SIZE || height > MAX_SIZE {
            self.check()?
            return err(Error.InvalidInput)
        }
        return backend.Backend.set_size(self.id, limit(width, self.min_width, self.max_width), limit(height, self.min_height, self.max_height))
    }
    // The smallest size the user can shrink the drawing area to, in the
    // units of set_size; 0 leaves a dimension unlimited, and 0 by 0 removes
    // the limit. A window smaller than the new minimum grows to it. Fails
    // with InvalidInput above MAX_SIZE or above a maximum that is set.
    pub fn set_min_size(&mut self, width: u32, height: u32) -> void!Error {
        if width > MAX_SIZE || height > MAX_SIZE || (self.max_width != 0 && width > self.max_width) || (self.max_height != 0 && height > self.max_height) {
            self.check()?
            return err(Error.InvalidInput)
        }
        backend.Backend.set_size_limits(self.id, width, height, self.max_width, self.max_height)?
        self.min_width = width
        self.min_height = height
        return ok()
    }
    // The largest size the user can enlarge the drawing area to, in the
    // units of set_size; 0 leaves a dimension unlimited, and 0 by 0 removes
    // the limit. A larger window shrinks to it. Fullscreen ignores the
    // limit. Fails with InvalidInput above MAX_SIZE or below a minimum that
    // is set.
    pub fn set_max_size(&mut self, width: u32, height: u32) -> void!Error {
        if width > MAX_SIZE || height > MAX_SIZE || (width != 0 && width < self.min_width) || (height != 0 && height < self.min_height) {
            self.check()?
            return err(Error.InvalidInput)
        }
        backend.Backend.set_size_limits(self.id, self.min_width, self.min_height, width, height)?
        self.max_width = width
        self.max_height = height
        return ok()
    }
    // Make the window cover its whole screen without a title bar or
    // borders (true), or return it to its earlier size and place (false).
    // The new size arrives as a Resize event. macOS animates the change into
    // a space of its own, as its green title-bar button does; X11 asks the
    // window manager, and without one covers the screen itself.
    pub fn set_fullscreen(&mut self, fullscreen: bool) -> void!Error {
        return backend.Backend.set_fullscreen(self.id, fullscreen)
    }
    // Whether the window is fullscreen, or is changing to fullscreen after
    // set_fullscreen(true). On macOS it also follows the user entering or
    // leaving fullscreen with the title-bar button; X11 reports what the
    // program asked for. False once the window is closed.
    pub fn is_fullscreen(&self) -> bool {
        return backend.Backend.fullscreen(self.id)
    }

    // -- GPU access -------------------------------------------------------

    // The window system's objects behind this window, for creating a Vulkan,
    // OpenGL or Metal surface that draws straight into it: the X11 window
    // and a libxcb connection on Linux, the NSWindow and NSView on macOS,
    // the HWND and HINSTANCE on Windows. The drawing area's size in pixels
    // is size(); after a Resize event, resize the GPU's swapchain or
    // drawable to the new size.
    //
    // On Linux the first call loads libxcb (libxcb.so.1, part of every X11
    // installation) and opens a second connection to the X server, since
    // Vulkan and EGL need a library connection rather than std/window's own
    // socket; programs that never ask need nothing beyond libc. That
    // connection is shared by every window and closes with the App. Fails
    // with NoDisplay when libxcb is missing or cannot connect, and Closed
    // once the window or its App is closed.
    //
    // The addresses stay valid until the window closes: destroy every
    // surface made from them first. A window without a pixel buffer
    // (Options.gpu()) avoids keeping an unused one, but any window works.
    pub fn native_handle(&mut self) -> NativeHandle!Error {
        return backend.Backend.native_handle(self.id)
    }
    // macOS: make a CAMetalLayer the backing layer of the window's view and
    // return its address, a CAMetalLayer * that the view keeps alive until
    // the window closes. Metal renders into it through
    // metal.MetalLayer.from_object, Vulkan through VK_EXT_metal_surface.
    // Calling it again returns the same layer. std/window keeps the layer's
    // contentsScale and drawableSize at the window's scale and pixel size,
    // also across resizes. Fails with Unsupported on other systems and for a
    // window with a pixel buffer, whose own layer shows the buffer.
    pub fn metal_layer(&mut self) -> usize!Error {
        return backend.Backend.metal_layer(self.id)
    }

    // Close the window. Later calls fail with Closed; closing twice does
    // nothing. Dropping the window closes it too.
    pub fn close(&mut self) {
        backend.Backend.close(self.id)
        pacer_remove(self.id)
        self.pixels = heap.Bytes.empty()
        self.width = 0
        self.height = 0
    }
    fn drop(&mut self) {
        self.close()
    }

    // Closed when the window or its App has been closed.
    fn check(&self) -> void!Error {
        width := 0u32
        height := 0u32
        if !backend.Backend.size(self.id, &mut width, &mut height) {
            return err(Error.Closed)
        }
        return ok()
    }
    // Bring the pixel buffer to the drawing area's current size, keeping the
    // old picture in the top-left corner. False when memory runs out, which
    // keeps the old buffer.
    fn sync(&mut self) -> bool {
        if !self.pixel_buffer {
            return true
        }
        width := 0u32
        height := 0u32
        if !backend.Backend.size(self.id, &mut width, &mut height) {
            if self.pixels.len() != 0 {
                self.pixels = heap.Bytes.empty()
            }
            self.width = 0
            self.height = 0
            return true
        }
        if width == self.width && height == self.height && self.pixels.len() != 0 {
            return true
        }
        match heap.Bytes.new(width as usize * height as usize * 4) {
            some(next) => {
                rows := smaller(height, self.height) as usize
                row := smaller(width, self.width) as usize * 4
                old_stride := self.width as usize * 4
                new_stride := width as usize * 4
                {
                    source := self.pixels.view()
                    target := next.bytes()
                    for y in 0usize..rows {
                        for i in 0usize..row {
                            target[y * new_stride + i] = source[y * old_stride + i]
                        }
                    }
                }
                self.pixels = next
                self.width = width
                self.height = height
                backend.Backend.attach(self.id, self.pixels.pointer(), width, height)
                return true
            }
            none => {
                return false
            }
        }
    }

    // -- graphics.Display -------------------------------------------------

    // The format the pixel buffer uses; presenting a canvas in another
    // format converts it.
    pub fn format(&self) -> graphics.PixelFormat {
        return graphics.PixelFormat.Bgra8888
    }
    // Copy `dirty` from a canvas of your own into the window's pixel buffer
    // and show it, so a window works with graphics.present like any other
    // display. Like every display it shows only what lies inside both the
    // canvas's bounds() and the window and ignores the rest, so a smaller
    // canvas, one with an origin, or one left over from before a resize
    // updates just the part it covers. Fails with Device when the window
    // system fails or the window has no pixel buffer.
    pub fn present(&mut self, canvas: &graphics.Canvas, dirty: graphics.Rect) -> void!graphics.Error {
        if !self.pixel_buffer {
            return err(graphics.Error.Device)
        }
        self.sync()
        bounds := canvas.bounds()
        screen := graphics.Rect { x: 0, y: 0, width: self.width, height: self.height }
        inside := dirty.intersect(&bounds)
        area := inside.intersect(&screen)
        if area.is_empty() {
            return ok()
        }
        {
            pixels := self.canvas()
            pixels.blit_region(canvas, area.clone(), area.x, area.y)
        }
        match backend.Backend.present(self.id, area.x, area.y, area.width, area.height) {
            ok() => {
                return ok()
            }
            err(_) => {
                return err(graphics.Error.Device)
            }
        }
    }
}

// `value` kept within `low` and `high`, where 0 is no limit.
fn limit(value: u32, low: u32, high: u32) -> u32 {
    if high != 0 && value > high {
        return high
    }
    if value < low {
        return low
    }
    return value
}

fn smaller(a: u32, b: u32) -> u32 {
    if a < b {
        return a
    }
    return b
}

// Physical keys, named after their position on a US keyboard.
pub enum Key {
    Unknown,
    A,
    B,
    C,
    D,
    E,
    F,
    G,
    H,
    I,
    J,
    K,
