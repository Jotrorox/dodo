// A stable number for each key, for storing key bindings.
pub fn key_code(key: &Key) -> u32 {
    match key {
        Key.Unknown => {
            return 0
        }
        Key.A => {
            return 1
        }
        Key.B => {
            return 2
        }
        Key.C => {
            return 3
        }
        Key.D => {
            return 4
        }
        Key.E => {
            return 5
        }
        Key.F => {
            return 6
        }
        Key.G => {
            return 7
        }
        Key.H => {
            return 8
        }
        Key.I => {
            return 9
        }
        Key.J => {
            return 10
        }
        Key.K => {
            return 11
        }
        Key.L => {
            return 12
        }
        Key.M => {
            return 13
        }
        Key.N => {
            return 14
        }
        Key.O => {
            return 15
        }
        Key.P => {
            return 16
        }
        Key.Q => {
            return 17
        }
        Key.R => {
            return 18
        }
        Key.S => {
            return 19
        }
        Key.T => {
            return 20
        }
        Key.U => {
            return 21
        }
        Key.V => {
            return 22
        }
        Key.W => {
            return 23
        }
        Key.X => {
            return 24
        }
        Key.Y => {
            return 25
        }
        Key.Z => {
            return 26
        }
        Key.Digit0 => {
            return 27
        }
        Key.Digit1 => {
            return 28
        }
        Key.Digit2 => {
            return 29
        }
        Key.Digit3 => {
            return 30
        }
        Key.Digit4 => {
            return 31
        }
        Key.Digit5 => {
            return 32
        }
        Key.Digit6 => {
            return 33
        }
        Key.Digit7 => {
            return 34
        }
        Key.Digit8 => {
            return 35
        }
        Key.Digit9 => {
            return 36
        }
        Key.Escape => {
            return 37
        }
        Key.Enter => {
            return 38
        }
        Key.Tab => {
            return 39
        }
        Key.Backspace => {
            return 40
        }
        Key.Space => {
            return 41
        }
        Key.Minus => {
            return 42
        }
        Key.Equal => {
            return 43
        }
        Key.LeftBracket => {
            return 44
        }
        Key.RightBracket => {
            return 45
        }
