package window

import "std/graphics"
import "std/time"
import "std/window/native" as backend
import "std/window/raw"

// Open a desktop window and draw into it with std/graphics.
//
// A window owns a pixel buffer the size of its drawing area. canvas() lends
// it out as a graphics.Canvas; update() shows the parts that changed. Events
// are polled: wait_event() blocks for the next one, poll_event() returns
// none when nothing is pending, so a program's main loop is an ordinary loop
// with no callbacks. An animation's loop uses wait_event_until_frame()
// instead, which also says when to draw the next frame.
//
// Each operating system's own window system is used directly, with nothing
// to install: the X11 protocol over a socket on Linux, AppKit on macOS and
// user32/gdi32 on Windows. A process has at most one window open at a time,
// and must use it from the thread that opened it; on macOS that has to be
// the main thread.

// Why a window could not be opened or used; see raw.Error for each variant.
pub type Error = raw.Error

pub fn error_name(error: Error) -> &str from(static) {
    match error {
        Error.NoDisplay => {
            return "NoDisplay"
        }
        Error.AlreadyOpen => {
            return "AlreadyOpen"
        }
        Error.Closed => {
            return "Closed"
        }
        Error.InvalidInput => {
            return "InvalidInput"
        }
        Error.OutOfMemory => {
            return "OutOfMemory"
        }
        Error.Protocol => {
            return "Protocol"
        }
        Error.Unsupported => {
            return "Unsupported"
        }
        Error.System => {
            return "System"
        }
    }
}

// The largest accepted width or height, in pixels.
pub const MAX_SIZE: u32 = 16384

// How to open a window. The size is the drawing area's, excluding the title
// bar and borders, in the window system's own units: points on macOS and
// pixels at the system scale on Windows, so a window looks the same size on
// every display. The canvas is in physical pixels, scale_percent() / 100
// times larger. X11 has no system scale; there both are pixels.
pub struct Options {
    pub title: &str
    pub width: u32
    pub height: u32
    // Whether the user may resize the window.
    pub resizable: bool

    // A resizable window with the given title and size.
    pub fn new(title: &str, width: u32, height: u32) -> Options from(title) {
        return Options { title: title, width: width, height: height, resizable: true }
    }
}

// Open a window and show it. Fails with InvalidInput for a zero size or one
// above MAX_SIZE, NoDisplay without a window system, and AlreadyOpen while
// another window is open.
pub fn open(options: Options) -> Window!Error {
    if options.width == 0 || options.height == 0 || options.width > MAX_SIZE || options.height > MAX_SIZE {
        return err(Error.InvalidInput)
    }
    handle := backend.Backend.open(options.title, options.width, options.height, options.resizable)?
    return ok(Window { backend: handle, pending: raw.Event.empty(), frame_deadline: 0, frame_previous: 0, frame_requested: false, frame_signalled: false, animating: false })
}

// Something that happened to the window.
pub enum Event {
    // The user asked to close the window, for example with its close button.
    // The window stays open until close() or the end of its lifetime, so a
    // program may still ask "save changes?".
    Close,
    // The drawing area changed size. The pixel buffer now has the new size and
    // keeps the old picture in its top-left corner; redraw and update().
    Resize(width: u32, height: u32),
    // The window gained (true) or lost (false) keyboard focus.
    Focus(focused: bool),
    // A key went down, repeated, or came up.
    Key(KeyEvent),
    // Text typed through the keyboard layout, one Unicode scalar value per
    // event, after any Key event for the same keystroke. Control characters
    // are not reported; use Key events for Enter, Tab and Backspace.
    Text(code_point: u32),
    // The pointer moved to (x, y) inside the drawing area.
    MouseMove(x: i32, y: i32),
    // A mouse button went down or came up.
    MouseButton(ButtonEvent),
    // The pointer left the drawing area.
    MouseLeave,
    // A wheel or trackpad scrolled. 120 units are one wheel notch; trackpads
    // report finer amounts. Positive dx scrolls right, positive dy down.
    Scroll(dx: i32, dy: i32)
}

// A physical key press or release. `key` names the key's position on a US
// keyboard regardless of the active layout, so WASD stays under the left hand
// on AZERTY keyboards too; use Text events for the characters typed.
pub struct KeyEvent {
    pub key: Key
    pub pressed: bool
    // True for presses generated by holding the key down.
    pub repeat: bool
    pub modifiers: Modifiers
}

pub enum Button {
    Left,
    Middle,
    Right,
    // The side buttons many mice have.
    Back,
    Forward
}

pub struct ButtonEvent {
    pub button: Button
    pub pressed: bool
    // The pointer position in the drawing area.
    pub x: i32
    pub y: i32
    pub modifiers: Modifiers
}

// The modifier keys held during an input event.
pub struct Modifiers {
    bits: u32

    pub fn none() -> Modifiers {
        return Modifiers { bits: 0 }
    }
    pub fn shift(&self) -> bool {
        return (self.bits & raw.SHIFT) != 0
    }
    pub fn control(&self) -> bool {
        return (self.bits & raw.CONTROL) != 0
    }
    // Alt, called Option on Mac keyboards.
    pub fn alt(&self) -> bool {
        return (self.bits & raw.ALT) != 0
    }
    // The Windows or Super key, or Command on Mac keyboards.
    pub fn meta(&self) -> bool {
        return (self.bits & raw.META) != 0
    }
    pub fn caps_lock(&self) -> bool {
        return (self.bits & raw.CAPS_LOCK) != 0
    }
    // The platform's shortcut modifier: Command on macOS, Control elsewhere.
    pub fn shortcut(&self) -> bool {
        if backend.SHORTCUT_IS_META {
            return self.meta()
        }
        return self.control()
    }
}

fn button_from_code(code: u32) -> Button {
    if code == 1 {
        return Button.Middle
    }
    if code == 2 {
        return Button.Right
    }
    if code == 3 {
        return Button.Back
    }
    if code == 4 {
        return Button.Forward
    }
    return Button.Left
}

fn convert(event: &raw.Event) -> Option<Event> {
    kind := event.kind
    if kind == raw.CLOSE {
        return some(Event.Close)
    }
    if kind == raw.RESIZE {
        return some(Event.Resize(event.x as u32, event.y as u32))
    }
    if kind == raw.FOCUS {
        return some(Event.Focus((event.flags & raw.PRESSED) != 0))
    }
    if kind == raw.KEY {
        return some(Event.Key(KeyEvent { key: key_from_code(event.code), pressed: (event.flags & raw.PRESSED) != 0, repeat: (event.flags & raw.REPEAT) != 0, modifiers: Modifiers { bits: event.modifiers } }))
    }
    if kind == raw.TEXT {
        return some(Event.Text(event.code))
    }
    if kind == raw.MOUSE_MOVE {
        return some(Event.MouseMove(event.x, event.y))
    }
    if kind == raw.MOUSE_BUTTON {
        return some(Event.MouseButton(ButtonEvent { button: button_from_code(event.code), pressed: (event.flags & raw.PRESSED) != 0, x: event.x, y: event.y, modifiers: Modifiers { bits: event.modifiers } }))
    }
    if kind == raw.MOUSE_LEAVE {
        return some(Event.MouseLeave)
    }
    if kind == raw.SCROLL {
        return some(Event.Scroll(event.x, event.y))
    }
    return none
}

// An open window. Closing happens with close() or when the value is dropped.
pub struct Window {
    backend: backend.Backend
    pending: raw.Event
    // Frame pacing, in backend.clock() nanoseconds: when the awaited frame
    // is due (0 before it is scheduled) and when the last one was.
    frame_deadline: u64
    frame_previous: u64
    // A FRAME event was requested and has not arrived yet.
    frame_requested: bool
    // A FRAME event arrived: the display refreshed since the request.
    frame_signalled: bool
    // Frames were asked for since the last wait_event().
    animating: bool

    // Size of the drawing area in pixels; also the size of canvas().
    pub fn size(&self) -> graphics.Size {
        return graphics.Size { width: self.backend.width(), height: self.backend.height() }
    }
    pub fn width(&self) -> u32 {
        return self.backend.width()
    }
    pub fn height(&self) -> u32 {
        return self.backend.height()
    }
    // How much the window system enlarges content, in percent: 100 on a
    // classic display, 200 on a Retina or other high-density one. Canvases
    // are always in physical pixels; multiply sizes by this to keep them
    // readable, for example with font.medium().scaled(window.scale()).
    pub fn scale_percent(&self) -> u32 {
        return self.backend.scale_percent()
    }
    // scale_percent() rounded to a whole factor, at least 1.
    pub fn scale(&self) -> u32 {
        factor := (self.backend.scale_percent() + 50) / 100
        if factor == 0 {
            return 1
        }
        return factor
    }

    // The window's pixel buffer as a canvas, in graphics.PixelFormat.Bgra8888.
    // It keeps what was drawn into it until the window is resized. Drawing
    // shows nothing until update(); the borrow must end before the next
    // event call, since a resize replaces the buffer.
    pub fn canvas(&mut self) -> graphics.Canvas from(self) {
        width := self.backend.width()
        height := self.backend.height()
        stride := self.backend.stride()
        return graphics.Canvas.with_stride(self.backend.pixels(), width, height, stride, graphics.PixelFormat.Bgra8888)!
    }
    // Show the `dirty` part of the pixel buffer, typically the rectangle
    // canvas.take_dirty() returned. An empty rectangle shows nothing.
    pub fn update(&mut self, dirty: graphics.Rect) -> void!Error {
        bounds := graphics.Rect { x: 0, y: 0, width: self.backend.width(), height: self.backend.height() }
        area := dirty.intersect(&bounds)
        if area.is_empty() {
            return ok()
        }
        return self.backend.present(area.x, area.y, area.width, area.height)
    }
    // Show the whole pixel buffer.
    pub fn update_all(&mut self) -> void!Error {
        width := self.backend.width()
        height := self.backend.height()
        if width == 0 || height == 0 {
            return ok()
        }
        return self.backend.present(0, 0, width, height)
    }

    // The next event, waiting as long as it takes. A program that stops
    // animating calls this, which lets macOS throttle it again.
    pub fn wait_event(&mut self) -> Event!Error {
        if self.animating {
            self.animating = false
            self.backend.set_animating(false)
        }
        for {
            if let some(event) = self.next(raw.FOREVER)? {
                return ok(event)
            }
        }
    }
    // The next event, or none once it is time to draw the next frame. An
    // animation handles events until none, draws, calls update() and asks
    // again:
    //
    //     for {
    //         match win.wait_event_until_frame()? {
    //             some(event) => { ...handle it... }
    //             none => { ...draw, then win.update(dirty)?... }
    //         }
    //     }
    //
    // A frame is due once per display refresh, frame_interval() apart,
    // however many events arrive. Where the window system reports refreshes
    // frames follow them: a display link on macOS 14 and later, the
    // compositor's timing on Windows and the Present extension on X11;
    // elsewhere a timer keeps the pace. A program slower than the display
    // skips refreshes rather than falling behind, and a hidden window, whose
    // display reports no refreshes, still gets a frame every two intervals.
    // macOS does not put an animating program to sleep with App Nap until
    // it calls wait_event() again.
    pub fn wait_event_until_frame(&mut self) -> Option<Event>!Error {
        if self.frame_deadline == 0 {
            self.schedule_frame()?
        }
        for {
            now := self.backend.clock()
            if self.frame_signalled || now >= self.frame_deadline {
                if self.frame_signalled {
                    self.frame_previous = now
                } else {
                    self.frame_previous = self.frame_deadline
                }
                self.frame_signalled = false
                self.frame_deadline = 0
                return ok(none)
            }
            // Round up so the wait never ends early and spins.
            wait := (self.frame_deadline - now + 999999) / 1000000
            if wait > 1000 {
                wait = 1000
            }
            if self.backend.next_event(wait as u32, &mut self.pending)? {
                if self.pending.kind == raw.FRAME {
                    self.note_frame()
                } else if let some(event) = convert(&self.pending) {
                    return ok(some(event))
                }
            }
        }
    }
    // How long one display refresh lasts, such as about 16.7 ms at 60 Hz:
    // the time between frames of wait_event_until_frame(), for advancing an
    // animation by one frame. 60 Hz when the window system does not say; on
    // X11 the real period is known after about half a second of frames.
    pub fn frame_interval(&self) -> time.Duration {
        return time.Duration.from_nanos(self.frame_period())
    }
    fn frame_period(&self) -> u64 {
        period := self.backend.frame_period()
        if period == 0 {
            return 16666667
        }
        return period
    }
    // Set frame_deadline for the next frame.
    fn schedule_frame(&mut self) -> void!Error {
        if !self.animating {
            self.animating = true
            self.backend.set_animating(true)
        }
        period := self.frame_period()
        if !self.frame_requested && !self.frame_signalled {
            requested := self.backend.request_frame()?
            self.frame_requested = requested
        }
        now := self.backend.clock()
        if self.frame_requested {
            // The FRAME event ends the wait; this deadline only matters
            // when the display stops reporting refreshes.
            self.frame_deadline = now + 2 * period
            return ok()
        }
        vblank := self.backend.next_vblank(now)
        if vblank > now {
            self.frame_deadline = vblank
            return ok()
        }
        // A timer at the refresh rate that keeps its phase, skipping the
        // frames that were missed.
        deadline := self.frame_previous + period
        if deadline <= now {
            deadline += ((now - deadline) / period + 1) * period
        }
        self.frame_deadline = deadline
        return ok()
    }
    fn note_frame(&mut self) {
        self.frame_requested = false
        self.frame_signalled = true
    }
    // The next event if one is pending, without waiting.
    pub fn poll_event(&mut self) -> Option<Event>!Error {
        return self.next(0)
    }
    // The next event, waiting at most `milliseconds` for one; none when the
    // time passes first. Use it to pace animation without a timer thread.
    pub fn wait_event_timeout(&mut self, milliseconds: u32) -> Option<Event>!Error {
        limit := milliseconds
        if limit == raw.FOREVER {
            limit = raw.FOREVER - 1
        }
        return self.next(limit)
    }
    fn next(&mut self, milliseconds: u32) -> Option<Event>!Error {
        for {
            if !self.backend.next_event(milliseconds, &mut self.pending)? {
                return ok(none)
            }
            // A refresh that arrives here is kept for the next
            // wait_event_until_frame(), not reported.
            if self.pending.kind != raw.FRAME {
                return ok(convert(&self.pending))
            }
            self.note_frame()
        }
    }

    pub fn set_title(&mut self, title: &str) -> void!Error {
        return self.backend.set_title(title)
    }
    // Show or hide the mouse pointer while it is over the window.
    pub fn set_cursor_visible(&mut self, visible: bool) -> void!Error {
        return self.backend.set_cursor_visible(visible)
    }
    // Close the window. Later calls fail with Closed; closing twice does
    // nothing. Dropping the window closes it too.
    pub fn close(&mut self) {
        self.backend.close()
    }

    // -- graphics.Display -------------------------------------------------

    // The format the pixel buffer uses; presenting a canvas in another
    // format converts it.
    pub fn format(&self) -> graphics.PixelFormat {
        return graphics.PixelFormat.Bgra8888
    }
    // Copy `dirty` from a canvas of your own into the window's pixel buffer
    // and show it, so a window works with graphics.present like any other
    // display. Like every display it shows only what lies inside both the
    // canvas's bounds() and the window and ignores the rest, so a smaller
    // canvas, one with an origin, or one left over from before a resize
    // updates just the part it covers. Fails with Device when the window
    // system fails.
    pub fn present(&mut self, canvas: &graphics.Canvas, dirty: graphics.Rect) -> void!graphics.Error {
        bounds := canvas.bounds()
        screen := graphics.Rect { x: 0, y: 0, width: self.backend.width(), height: self.backend.height() }
        inside := dirty.intersect(&bounds)
        area := inside.intersect(&screen)
        if area.is_empty() {
            return ok()
        }
        {
            pixels := self.canvas()
            pixels.blit_region(canvas, area.clone(), area.x, area.y)
        }
        match self.backend.present(area.x, area.y, area.width, area.height) {
            ok() => {
                return ok()
            }
            err(_) => {
                return err(graphics.Error.Device)
            }
        }
    }
}

// Physical keys, named after their position on a US keyboard.
pub enum Key {
    Unknown,
    A,
    B,
    C,
    D,
    E,
    F,
    G,
    H,
    I,
    J,
    K,
    L,
    M,
    N,
    O,
    P,
    Q,
    R,
