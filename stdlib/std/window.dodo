// A stable number for each key, for storing key bindings.
pub fn key_code(key: &Key) -> u32 {
    match key {
        Key.Unknown => {
            return 0
        }
        Key.A => {
            return 1
        }
        Key.B => {
            return 2
        }
        Key.C => {
            return 3
        }
        Key.D => {
