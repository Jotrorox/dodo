package pool_bytes

import "alloc/pool"
import "alloc/error"
import "std/bytes_alloc"

pub fn new(allocator: &mut pool.Pool, capacity: usize, limit: usize) -> bytes_alloc.Buffer<pool.Pool>!error.AllocError from(allocator) {
    unsafe {
        return bytes_alloc.new(allocator, capacity, limit)
    }
}
