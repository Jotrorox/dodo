package web

import "core/bytes" as raw
import "std/text" as utf8
import "std/http"
import "std/io"

// Portable routing: byte paths decoded exactly once into caller storage.
// No allocation, I/O, clock, filesystem, TLS, or scheduler dependency.
pub enum Error {
    InvalidPath, InvalidPattern, InvalidMethod, AmbiguousRoute, BufferFull,
    NotFound, MethodNotAllowed, Cancelled, Handler, InvalidProgress,
    InvalidQuery, QueryLimit, InvalidHeader, InvalidStatus, HeaderLimit
}

fn hex(value: u8) -> u8!Error {
    if value >= 48 && value <= 57 {
        return ok(value - 48)
    }
    if value >= 65 && value <= 70 {
        return ok(value - 55)
    }
    if value >= 97 && value <= 102 {
        return ok(value - 87)
    }
    return err(Error.InvalidPath)
}

// Query remains separate. Encoded separators, controls, backslashes, fragments,
// invalid UTF-8, and dot segments are rejected, never silently normalized.
// Failure can modify a prefix; only the successful returned prefix is a path.
pub fn decode_path(target: &[u8], output: &mut[u8]) -> usize!Error {
    if target.len == 0 || target[0] != 47 {
        return err(Error.InvalidPath)
    }
    at := 0usize
    used := 0usize
    for at < target.len && target[at] != 63 {
        value := target[at]
        at += 1
        if value == 37 {
            if target.len - at < 2 {
                return err(Error.InvalidPath)
            }
            value = hex(target[at])? * 16 + hex(target[at + 1])?
            at += 2
            if value == 47 || value == 92 {
                return err(Error.InvalidPath)
            }
        }
        if value <= 31 || value == 127 || value == 92 || value == 35 {
            return err(Error.InvalidPath)
        }
        if used == output.len {
            return err(Error.BufferFull)
        }
        output[used] = value
        used += 1
    }
    validate_path(&output[..used])?
    return ok(used)
}

pub fn validate_path(path: &[u8]) -> void!Error {
    if path.len == 0 || path[0] != 47 {
        return err(Error.InvalidPath)
    }
    match utf8.validate(path) {
        ok() => {}
        err(_) => {
            return err(Error.InvalidPath)
        }
    }
    start := 1usize
    for at in 1usize..path.len + 1 {
        if at == path.len || path[at] == 47 {
            part := &path[start..at]
            if raw.equal(part, b".") || raw.equal(part, b"..") {
                return err(Error.InvalidPath)
            }
            start = at + 1
        } else if path[at] <= 31 || path[at] == 127 || path[at] == 92 || path[at] == 35 {
            return err(Error.InvalidPath)
        }
    }
    return ok()
}

// A borrowed proof of validation; the bytes cannot change while it is live.
pub struct Path {
    data: &[u8]
    pub fn new(data: &[u8]) -> Path!Error from(data) {
        validate_path(data)?
        return ok(Path { data: data })
    }
    pub fn decode(target: &[u8], output: &mut[u8]) -> Path!Error from(output) {
        used := decode_path(target, output)?
        return ok(Path { data: &output[..used] })
    }
    pub fn bytes(&self) -> &[u8] {
        return self.data
    }
}

pub fn valid_method(method: &[u8]) -> bool {
    if method.len == 0 {
        return false
    }
    for at in 0usize..method.len {
        value := method[at]
        if!((value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 33 || value == 35 ||
            value == 36 || value == 37 || value == 38 || value == 39 ||
            value == 42 || value == 43 || value == 45 || value == 46 ||
            value == 94 || value == 95 || value == 96 || value == 124 || value == 126) {
            return false
        }
    }
    return true
}

pub struct Route {
    pub method: &[u8]
    pub pattern: &[u8]
    pub id: usize
}

fn end_segment(path: &[u8], start: usize) -> usize {
    end := start
    for end < path.len && path[end] != 47 {
        end += 1
    }
    return end
}
fn segment_kind(path: &[u8], start: usize, end: usize) -> u8 {
    if start < end {
        if path[start] == 42 {
            return 1
        }
        if path[start] == 58 {
            return 2
        }
    }
    return 3
}
fn valid_name(name: &[u8]) -> bool {
    if name.len == 0 {
        return false
    }
    for at in 0usize..name.len {
        value := name[at]
        if!((value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 95) {
            return false
        }
    }
    return true
}
fn validate_pattern(path: &[u8]) -> void!Error {
    validate_path(path)?
    at := 1usize
    for at <= path.len {
        end := end_segment(path, at)
        kind := segment_kind(path, at, end)
        if kind != 3 {
            if!valid_name(&path[at + 1..end]) || (kind == 1 && end != path.len) {
                return err(Error.InvalidPattern)
            }
            previous := 1usize
            for previous < at {
                previous_end := end_segment(path, previous)
                if segment_kind(path, previous, previous_end) != 3 &&
                    raw.equal(&path[previous + 1..previous_end], &path[at + 1..end]) {
                    return err(Error.InvalidPattern)
                }
                previous = previous_end + 1
            }
        } else {
            for i in at..end {
                if path[i] == 37 || path[i] == 63 || path[i] == 58 || path[i] == 42 {
                    return err(Error.InvalidPattern)
                }
            }
        }
        at = end + 1
    }
    return ok()
}

fn same_shape(a: &[u8], b: &[u8]) -> bool {
    ai := 1usize
    bi := 1usize
    for ai <= a.len && bi <= b.len {
        ae := end_segment(a, ai)
        be := end_segment(b, bi)
        ak := segment_kind(a, ai, ae)
        bk := segment_kind(b, bi, be)
        if ak != bk || (ak == 3 && !raw.equal(&a[ai..ae], &b[bi..be])) {
            return false
        }
        ai = ae + 1
        bi = be + 1
    }
    return ai > a.len && bi > b.len
}
fn matches_path(pattern: &[u8], path: &[u8]) -> bool {
    pi := 1usize
    si := 1usize
    for pi <= pattern.len && si <= path.len {
        pe := end_segment(pattern, pi)
        se := end_segment(path, si)
        kind := segment_kind(pattern, pi, pe)
        if kind == 1 {
            return true
        }
        if kind == 2 && se == si {
            return false
        }
        if kind == 3 && !raw.equal(&pattern[pi..pe], &path[si..se]) {
            return false
        }
        pi = pe + 1
        si = se + 1
    }
    return pi > pattern.len && si > path.len
}
// Lexicographic specificity at the first different segment, independent of
// registration order: literal > parameter > terminal wildcard.
fn more_specific(a: &[u8], b: &[u8]) -> bool {
    ai := 1usize
    bi := 1usize
    for ai <= a.len && bi <= b.len {
        ae := end_segment(a, ai)
        be := end_segment(b, bi)
        ak := segment_kind(a, ai, ae)
        bk := segment_kind(b, bi, be)
        if ak != bk {
            return ak > bk
        }
        ai = ae + 1
        bi = be + 1
    }
    return false
}

pub struct Match {
    pub index: usize
    pub id: usize
    pub head: bool
}
pub struct Parameter {
    pub start: usize
    pub end: usize
}
const EMPTY_INDEX: [0]usize = []
fn literal_pattern(pattern: &[u8]) -> bool {
    for i in 0usize..pattern.len {
        if pattern[i] == 58 || pattern[i] == 42 {
            return false
        }
    }
    return true
}
// Bounded integer arithmetic also works on 32-bit freestanding targets.
fn path_hash(path: &[u8]) -> usize {
    hash := 5381usize
    for i in 0usize..path.len {
        hash = ((hash & 67108863usize) * 33usize) ^ (path[i] as usize)
    }
    return hash
}
// Dynamic keys end immediately before their first parameter or wildcard.
fn literal_prefix(pattern: &[u8]) -> usize {
    for i in 0usize..pattern.len {
        if pattern[i] == 58 || pattern[i] == 42 {
            return i
        }
    }
    return pattern.len
}
pub struct Router {
    routes: &[Route]
    index: &[usize]
    literal_sorted: bool
    dynamic: bool
    pub fn new(routes: &[Route]) -> Router!Error from(routes) {
        sorted := true
        dynamic := false
        for i in 0usize..routes.len {
            if!valid_method(routes[i].method) {
                return err(Error.InvalidMethod)
            }
            validate_pattern(routes[i].pattern)?
            if!literal_pattern(routes[i].pattern) {
                dynamic = true;
                sorted = false
            }
            if i != 0 && raw.compare(routes[i - 1].pattern, routes[i].pattern) > 0 {
                sorted = false
            }
        }
        for i in 0usize..routes.len {
            j := i
            for j != 0 {
                j -= 1
                if sorted && !raw.equal(routes[i].pattern, routes[j].pattern) {
                    break
                }
                if raw.equal(routes[i].method, routes[j].method) && same_shape(routes[i].pattern, routes[j].pattern) {
                    return err(Error.AmbiguousRoute)
                }
            }
        }
        return ok(Router { routes: routes, index: &EMPTY_INDEX, literal_sorted: sorted, dynamic: dynamic })
    }
    // Caller-owned hash table for literals and dynamic literal prefixes.
    // No allocation, route-count ceiling, or probabilistic match is involved.
    pub fn indexed(routes: &[Route], storage: &mut[usize]) -> Router!Error from(routes, storage) {
        if routes.len > storage.len / 2 {
            return err(Error.BufferFull)
        }
        dynamic := false
        for i in 0usize..routes.len {
            if!valid_method(routes[i].method) {
                return err(Error.InvalidMethod)
            }
            validate_pattern(routes[i].pattern)?
        }
        for i in 0usize..storage.len {
            storage[i] = 0
        }
        for i in 0usize..routes.len {
            prefix := literal_prefix(routes[i].pattern)
            if prefix != routes[i].pattern.len {
                dynamic = true
            }
            at := path_hash(&routes[i].pattern[..prefix]) % storage.len
            for storage[at] != 0 {
                previous := (storage[at] - 1) / 2
                if raw.equal(routes[i].method, routes[previous].method) && same_shape(routes[i].pattern, routes[previous].pattern) {
                    return err(Error.AmbiguousRoute)
                }
                at = (at + 1) % storage.len
            }
            // The low bit distinguishes dynamic prefixes from literal paths.
            storage[at] = i * 2 + 1
            if prefix != routes[i].pattern.len {
                storage[at] += 1
            }
        }
        return ok(Router { routes: routes, index: storage, literal_sorted: false, dynamic: dynamic })
    }

    pub fn find(&self, method: &[u8], path: &[u8]) -> Match!Error {
        if!valid_method(method) {
            return err(Error.InvalidMethod)
        }
        validate_path(path)?
        return self.find_validated(method, path)
    }
    pub fn find_path(&self, method: &[u8], validated: &Path) -> Match!Error {
        if!valid_method(method) {
            return err(Error.InvalidMethod)
        }
        return self.find_validated(method, validated.data)
    }
    fn find_validated(&self, method: &[u8], path: &[u8]) -> Match!Error {
        head := raw.equal(method, b"HEAD")
        fallback := self.routes.len
        if self.index.len != 0 {
            at := path_hash(path) % self.index.len
            matched := false
            for self.index[at] != 0 {
                i := (self.index[at] - 1) / 2
                if self.index[at] % 2 == 1 && raw.equal(self.routes[i].pattern, path) {
                    matched = true
                    if raw.equal(method, self.routes[i].method) {
                        return ok(Match { index: i, id: self.routes[i].id, head: head })
                    }
                    if head && raw.equal(self.routes[i].method, b"GET") {
                        fallback = i
                    }
                }
                at = (at + 1) % self.index.len
            }
            if fallback != self.routes.len {
                return ok(Match { index: fallback, id: self.routes[fallback].id, head: true })
            }
            if matched {
                return err(Error.MethodNotAllowed)
            }
            if!self.dynamic {
                return err(Error.NotFound)
            }
        } else if self.literal_sorted {
            lower := 0usize
            upper := self.routes.len
            for lower < upper {
                middle := lower + (upper - lower) / 2
                if raw.compare(self.routes[middle].pattern, path) < 0 {
                    lower = middle + 1
                } else {
                    upper = middle
                }
            }
            matched := false
            for lower < self.routes.len && raw.equal(self.routes[lower].pattern, path) {
                matched = true
                if raw.equal(method, self.routes[lower].method) {
                    return ok(Match { index: lower, id: self.routes[lower].id, head: head })
                }
                if head && raw.equal(self.routes[lower].method, b"GET") {
                    fallback = lower
                }
                lower += 1
            }
            if fallback != self.routes.len {
                return ok(Match { index: fallback, id: self.routes[fallback].id, head: true })
            }
            if matched {
                return err(Error.MethodNotAllowed)
            }
            return err(Error.NotFound)
        }
        best := self.routes.len
        selected := self.routes.len
        // For an indexed table, visit only buckets for prefixes ending at a
        // segment boundary. Hash collisions still require complete matching.
        prefix := 0usize
        at := 0usize
        if self.index.len != 0 {
            prefix = 1
            at = path_hash(&path[..prefix]) % self.index.len
        }
        scanned := 0usize
        for self.index.len != 0 || scanned < self.routes.len {
            i := scanned
            if self.index.len != 0 {
                if self.index[at] == 0 {
                    for prefix < path.len && path[prefix] != 47 {
                        prefix += 1
                    }
                    if prefix == path.len {
                        break
                    }
                    prefix += 1
                    at = path_hash(&path[..prefix]) % self.index.len
                    continue
                }
                entry := self.index[at]
                i = (entry - 1) / 2
                at = (at + 1) % self.index.len
                if entry % 2 == 1 {
                    continue
                }
                key := literal_prefix(self.routes[i].pattern)
                if key != prefix ||
                    !raw.equal(&self.routes[i].pattern[..key], &path[..prefix]) {
                    continue
                }
            } else {
                scanned += 1
            }
            if matches_path(self.routes[i].pattern, path) {
                if best == self.routes.len || more_specific(self.routes[i].pattern, self.routes[best].pattern) {
                    best = i
                    selected = self.routes.len
                    fallback = self.routes.len
                } else if!same_shape(self.routes[i].pattern, self.routes[best].pattern) {
                    continue
                }
                if raw.equal(method, self.routes[i].method) {
                    selected = i
                }
                if head && raw.equal(self.routes[i].method, b"GET") {
                    fallback = i
                }
            }
        }
        if selected != self.routes.len {
            return ok(Match { index: selected, id: self.routes[selected].id, head: head })
        }
        if fallback != self.routes.len {
            return ok(Match { index: fallback, id: self.routes[fallback].id, head: true })
        }
        if best == self.routes.len {
            return err(Error.NotFound)
        }
        return err(Error.MethodNotAllowed)
    }
    // Returns offsets in the supplied decoded path, never an unchecked pointer.
    pub fn parameter(&self, route: usize, path: &[u8], name: &[u8]) -> Option<Parameter> {
        if route >= self.routes.len {
            return none
        }
        pattern := self.routes[route].pattern
        if!matches_path(pattern, path) {
            return none
        }
        return self.parameter_matched(route, path, name)
    }
    fn parameter_matched(&self, route: usize, path: &[u8], name: &[u8]) -> Option<Parameter> {
        pattern := self.routes[route].pattern
        pi := 1usize
        si := 1usize
        for pi <= pattern.len && si <= path.len {
            pe := end_segment(pattern, pi)
            se := end_segment(path, si)
            kind := segment_kind(pattern, pi, pe)
            if kind != 3 && raw.equal(&pattern[pi + 1..pe], name) {
                if kind == 1 {
                    se = path.len
                }
                return some(Parameter { start: si, end: se })
            }
            pi = pe + 1
            si = se + 1
        }
        return none
    }
}

// Movable registration storage: cached indices contain no self-borrows.
// Mutation validates and rebuilds metadata; router() only borrows that metadata.
fn empty_route() -> Route from(static) {
    return Route { method: b"", pattern: b"", id: 0 }
}
pub struct RouteTable {
    entries: [8]Route
    count: usize
    index: [16]usize
    dynamic: bool
    pub fn new() -> RouteTable from(static) {
        return RouteTable { entries: [empty_route(), empty_route(), empty_route(), empty_route(),
        empty_route(), empty_route(), empty_route(), empty_route()], count: 0, index: [0usize; 16], dynamic: false }
    }
    pub fn routes(&self) -> &[Route] {
        return &self.entries[..self.count]
    }
    pub fn router(&self) -> Router from(self) {
        return Router { routes: self.routes(), index: &self.index, literal_sorted: false, dynamic: self.dynamic }
    }
    pub fn insert(self, method: &[u8], pattern: &[u8]) -> RouteInsertion from(self, method, pattern) {
        if self.count == 8 {
            return RouteInsertion { table: self, problem: some(Error.BufferFull) }
        }
        id := self.count
        self.entries[id] = Route { method: method, pattern: pattern, id: id }
        // Build into scratch so a failed insertion preserves the old index.
        index := [0usize; 16]
        problem: Option<Error> = none
        dynamic := false
        match Router.indexed(&self.entries[..id + 1], &mut index) {
            ok(router) => {
                dynamic = router.dynamic
            }
            err(reason) => {
                problem = some(reason)
            }
        }
        match problem {
            some(reason) => {
                self.entries[id] = Route { method: b"", pattern: b"", id: 0 }
                return RouteInsertion { table: self, problem: some(reason) }
            }
            none => {}
        }
        self.count += 1
        self.index = index
        self.dynamic = dynamic
        return RouteInsertion { table: self, problem: none }
    }
}
pub struct RouteInsertion {
    pub table: RouteTable
    pub problem: Option<Error>
}

pub struct Context {
    pub method: &[u8]
    pub path: &[u8]
    pub route_id: usize
    pub request_id: u64
    pub cancelled: bool
}
// Buffered application failures retain the protocol or UTF-8 diagnostic.
// Routing/streaming keep the small Error enum above for compatibility.
pub struct Failure {
    pub kind: Error
    pub protocol: Option<http.Error>
    pub encoding: Option<utf8.Error>
    // Zero keeps internal failures private (500); reject() sets an HTTP status.
    pub response_status: u16
    pub fn status(&self) -> u16 {
        if self.response_status >= 400 && self.response_status <= 599 {
            return self.response_status
        }
        return 500
    }
    pub fn format<F>(&self, output: &mut F) -> void!io.Error {
        output.string("web: ")?
        match &self.kind {
            Error.InvalidPath => {
                output.string("InvalidPath")?
            }
            Error.InvalidPattern => {
                output.string("InvalidPattern")?
            }
            Error.InvalidMethod => {
                output.string("InvalidMethod")?
            }
            Error.AmbiguousRoute => {
                output.string("AmbiguousRoute")?
            }
            Error.BufferFull => {
                output.string("BufferFull")?
            }
            Error.NotFound => {
                output.string("NotFound")?
            }
            Error.MethodNotAllowed => {
                output.string("MethodNotAllowed")?
            }
            Error.Cancelled => {
                output.string("Cancelled")?
            }
            Error.Handler => {
                output.string("Handler")?
            }
            Error.InvalidProgress => {
                output.string("InvalidProgress")?
            }
            Error.InvalidQuery => {
                output.string("InvalidQuery")?
            }
            Error.QueryLimit => {
                output.string("QueryLimit")?
            }
            Error.InvalidHeader => {
                output.string("InvalidHeader")?
            }
            Error.InvalidStatus => {
                output.string("InvalidStatus")?
            }
            Error.HeaderLimit => {
                output.string("HeaderLimit")?
            }
        }
        match &self.protocol {
            some(reason) => {
                output.string("; ")?;
                reason.format(output)?
            }
            none => {}
        }
        match &self.encoding {
            some(reason) => {
                output.string("; ")?;
                reason.format(output)?
            }
            none => {}
        }
        if self.response_status != 0 {
            output.string("; HTTP ")?
            output.natural(self.status() as u64)?
        }
        return ok()
    }

}
pub fn failure(kind: Error) -> Failure {
    return Failure { kind: kind, protocol: none, encoding: none, response_status: 0 }
}
// An intentional HTTP rejection. Invalid codes remain internal errors.
pub fn reject(status: u16) -> Failure {
    if status < 400 || status > 599 {
        return failure(Error.InvalidStatus)
    }
    result := failure(Error.Handler)
    result.response_status = status
    return result
}
pub fn protocol_failure(kind: Error, reason: http.Error) -> Failure {
    result := failure(kind)
    result.protocol = some(reason)
    return result
}
fn encoding_failure(kind: Error, reason: utf8.Error) -> Failure {
    result := failure(kind)
    result.encoding = some(reason)
    return result
}

// NUL-delimited name/value pairs. Only validated fields enter this storage.
// Mutators copy bytes, never retain their arguments. A failed append is atomic.
pub struct Fields {
    data: &mut[u8]
    used: usize
    count: usize
    limit: usize
    pub fn new(data: &mut[u8], limit: usize) -> Fields from(data) {
        return Fields { data: data, used: 0, count: 0, limit: limit }
    }
    pub fn resume(data: &mut[u8], used: usize, count: usize, limit: usize) -> Fields!Failure from(data) {
        if used > data.len || count > limit {
            return err(failure(Error.BufferFull))
        }
        return ok(Fields { data: data, used: used, count: count, limit: limit })
    }
    pub fn bytes(&self) -> &[u8] {
        return &self.data[..self.used]
    }
    pub fn len(&self) -> usize {
        return self.count
    }
    pub fn next(&self, cursor: &mut usize) -> Option<http.Header> from(self) {
        return field_next(self.bytes(), cursor)
    }
    pub fn append(&mut self, name: &[u8], value: &[u8]) -> void!Failure {
        if!http.valid_token(name) || !http.valid_value(value) {
            return err(protocol_failure(Error.InvalidHeader, http.failure(http.ErrorKind.InvalidHeader, self.count)))
        }
        if self.count == self.limit || name.len > self.data.len - self.used ||
            self.data.len - self.used - name.len < 2 || value.len > self.data.len - self.used - name.len - 2 {
            return err(protocol_failure(Error.HeaderLimit, http.failure(http.ErrorKind.BufferFull, self.count)))
        }
        for i in 0usize..name.len {
            self.data[self.used + i] = name[i]
        }
        self.used += name.len
        self.data[self.used] = 0
        self.used += 1
        for i in 0usize..value.len {
            self.data[self.used + i] = value[i]
        }
        self.used += value.len
        self.data[self.used] = 0
        self.used += 1
        self.count += 1
        return ok()
    }
}
pub fn field_at(data: &[u8], index: usize) -> Option<http.Header> from(data) {
    at := 0usize
    number := 0usize
    for at < data.len {
        end := at
        for end < data.len && data[end] != 0 {
            end += 1
        }
        if end == data.len {
            return none
        }
        start := end + 1
        last := start
        for last < data.len && data[last] != 0 {
            last += 1
        }
        if last == data.len {
            return none
        }
        if number == index {
            return some(http.Header { name: &data[at..end], value: &data[start..last] })
        }
        number += 1
        at = last + 1
    }
    return none
}
// Start at zero; each successful call advances past one complete field.
// Truncated fields and exhaustion return none and leave the cursor at the end.
pub fn field_next(data: &[u8], cursor: &mut usize) -> Option<http.Header> from(data) {
    at := *cursor
    *cursor = data.len
    if at < data.len {
        end := at
        for end < data.len && data[end] != 0 {
            end += 1
        }
        if end == data.len {
            return none
        }
        start := end + 1
        last := start
        for last < data.len && data[last] != 0 {
            last += 1
        }
        if last == data.len {
            return none
        }
        *cursor = last + 1
        return some(http.Header { name: &data[at..end], value: &data[start..last] })
    }
    return none
}
fn lookup(data: &[u8], name: &[u8], occurrence: usize, insensitive: bool) -> Option<&[u8]> from(data) {
    at := 0usize
    found := 0usize
    for at < data.len {
        end := at
        for end < data.len && data[end] != 0 {
            end += 1
        }
        if end == data.len {
            return none
        }
        start := end + 1
        last := start
        for last < data.len && data[last] != 0 {
            last += 1
        }
        if last == data.len {
            return none
        }
        equal := raw.equal(&data[at..end], name)
        if insensitive {
            equal = http.equal_ascii(&data[at..end], name)
        }
        if equal {
            if found == occurrence {
                return some(&data[start..last])
            }
            found += 1
        }
        at = last + 1
    }
    return none
}
fn has_field(data: &[u8], name: &[u8]) -> bool {
    match lookup(data, name, 0, true) {
        some(_) => {
            return true
        }
        none => {
            return false
        }
    }
}
fn query_part(raw: &[u8], output: &mut[u8], base: usize) -> usize!Failure {
    at := 0usize
    used := 0usize
    for at < raw.len {
        value := raw[at]
        position := at
        at += 1
        if value == 37 {
            if raw.len - at < 2 {
                return err(protocol_failure(Error.InvalidQuery, http.failure(http.ErrorKind.InvalidUri, base + position)))
            }
            high := 0u8
            low := 0u8
            match hex(raw[at]) {
                ok(v) => {
                    high = v
                }
                err(_) => {
                    return err(protocol_failure(Error.InvalidQuery, http.failure(http.ErrorKind.InvalidUri, base + at)))
                }
            }
            match hex(raw[at + 1]) {
                ok(v) => {
                    low = v
                }
                err(_) => {
                    return err(protocol_failure(Error.InvalidQuery, http.failure(http.ErrorKind.InvalidUri, base + at + 1)))
                }
            }
            value = high * 16 + low
            at += 2
        } else if value == 43 {
            value = 32
        }
        if value < 32 || value == 127 || value == 35 && raw[position] != 37 {
            return err(protocol_failure(Error.InvalidQuery, http.failure(http.ErrorKind.InvalidUri, base + position)))
        }
        if used == output.len {
            return err(failure(Error.QueryLimit))
        }
        output[used] = value
        used += 1
    }
    match utf8.validate(&output[..used]) {
        ok() => {}
        err(reason) => {
            return err(encoding_failure(Error.InvalidQuery, reason))
        }
    }
    return ok(used)
}
// Form-style query: split on &, then first =, then percent-decode once and
// turn + into space. Empty components are skipped; bare keys have empty values.
// Names are case sensitive. Controls and invalid UTF-8 are rejected.
// Failure may modify a prefix: only the successful prefix may be used.
pub fn decode_query(raw: &[u8], output: &mut[u8], limit: usize) -> usize!Failure {
    at := 0usize
    used := 0usize
    count := 0usize
    for at < raw.len {
        end := at
        for end < raw.len && raw[end] != 38 {
            end += 1
        }
        if end != at {
            if count == limit {
                return err(failure(Error.QueryLimit))
            }
            split := at
            for split < end && raw[split] != 61 {
                split += 1
            }
            used += query_part(&raw[at..split], &mut output[used..], at)?
            if used == output.len {
                return err(failure(Error.QueryLimit))
            }
            output[used] = 0
            used += 1
            start := split
            if start < end {
                start += 1
            }
            used += query_part(&raw[start..end], &mut output[used..], start)?
            if used == output.len {
                return err(failure(Error.QueryLimit))
            }
            output[used] = 0
            used += 1
            count += 1
        }
        at = end + 1
    }
    return ok(used)
}

pub struct Request {
    verb: &[u8]
    decoded_path: &[u8]
    headers: &[u8]
    queries: &[u8]
    data: &[u8]
    router: &Router
    route: usize
    captures: [32]usize
    capture_count: usize
    matched: bool
    capture_overflow: bool
    pub route_id: usize
    pub request_id: u64
    pub cancelled: bool
    // Header/query storage is the initialized prefix of Fields/decode_query.
    pub fn new(method: &[u8], path: &[u8], headers: &[u8], query: &[u8], body: &[u8],
    router: &Router, route: usize, route_id: usize, request_id: u64) -> Request from(method, path, headers, query, body, router) {
        result := Request { verb: method, decoded_path: path, headers: headers, queries: query, data: body,
        router: router, route: route, captures: [0usize; 32], capture_count: 0, matched: false, capture_overflow: false,
        route_id: route_id, request_id: request_id, cancelled: false }
        if route < router.routes.len {
            pattern := router.routes[route].pattern
            pi := 1usize
            si := 1usize
            for pi <= pattern.len && si <= path.len {
                pe := end_segment(pattern, pi)
                se := end_segment(path, si)
                kind := segment_kind(pattern, pi, pe)
                if (kind == 2 && se == si) || (kind == 3 && !raw.equal(&pattern[pi..pe], &path[si..se])) {
                    return result
                }
                if kind != 3 {
                    if kind == 1 {
                        se = path.len
                    }
                    if result.capture_count == 8 {
                        result.capture_overflow = true
                    } else {
                        at := result.capture_count * 4
                        result.captures[at] = pi + 1
                        result.captures[at + 1] = pe
                        result.captures[at + 2] = si
                        result.captures[at + 3] = se
                        result.capture_count += 1
                    }
                    if kind == 1 {
                        result.matched = true
                        return result
                    }
                }
                pi = pe + 1
                si = se + 1
            }
            result.matched = pi > pattern.len && si > path.len
        }
        return result
    }
    pub fn method(&self) -> &[u8] {
        return self.verb
    }
    pub fn path(&self) -> &[u8] {
        return self.decoded_path
    }
    pub fn body(&self) -> &[u8] {
        return self.data
    }
    pub fn header(&self, name: &[u8], occurrence: usize) -> Option<&[u8]> from(self) {
        return lookup(self.headers, name, occurrence, true)
    }
    pub fn query(&self, name: &[u8], occurrence: usize) -> Option<&[u8]> from(self) {
        return lookup(self.queries, name, occurrence, false)
    }
    // Common single-value access; occurrence-based access remains available.
    pub fn header_value(&self, name: &[u8]) -> Option<&[u8]> from(self) {
        return self.header(name, 0)
    }
    pub fn query_value(&self, name: &[u8]) -> Option<&[u8]> from(self) {
        return self.query(name, 0)
    }
    pub fn query_or(&self, name: &[u8], fallback: &[u8]) -> &[u8] from(self, fallback) {
        match self.query_value(name) {
            some(value) => {
                return value
            }
            none => {
                return fallback
            }
        }
    }
    pub fn require_query(&self, name: &[u8]) -> &[u8]!Failure from(self) {
        match self.query_value(name) {
            some(value) => {
                return ok(value)
            }
            none => {
                return err(reject(400))
            }
        }
    }
    pub fn require_header(&self, name: &[u8]) -> &[u8]!Failure from(self) {
        match self.header_value(name) {
            some(value) => {
                return ok(value)
            }
            none => {
                return err(reject(400))
            }
        }
    }
    pub fn param(&self, name: &[u8]) -> &[u8]!Failure from(self) {
        match self.parameter(name) {
            some(value) => {
                return ok(value)
            }
            none => {
                return err(reject(400))
            }
        }
    }
    pub fn param_u64(&self, name: &[u8]) -> u64!Failure {
        return decimal(self.param(name)?)
    }
    pub fn query_u64(&self, name: &[u8], fallback: u64) -> u64!Failure {
        match self.query_value(name) {
            some(value) => {
                return decimal(value)
            }
            none => {
                return ok(fallback)
            }
        }
    }
    pub fn parameter(&self, name: &[u8]) -> Option<&[u8]> from(self) {
        if!self.matched {
            return none
        }
        pattern := self.router.routes[self.route].pattern
        for i in 0usize..self.capture_count {
            at := i * 4
            if raw.equal(&pattern[self.captures[at]..self.captures[at + 1]], name) {
                return some(&self.decoded_path[self.captures[at + 2]..self.captures[at + 3]])
            }
        }
        if!self.capture_overflow {
            return none
        }
        match self.router.parameter_matched(self.route, self.decoded_path, name) {
            some(part) => {
                return some(&self.decoded_path[part.start..part.end])
            }
            none => {
                return none
            }
        }
    }
}

// HTTP numeric inputs are nonempty ASCII decimal digits; no signs or spaces.
fn decimal(value: &[u8]) -> u64!Failure {
    for digit in value {
        if *digit < 48 || *digit > 57 {
            return err(reject(400))
        }
    }
    match utf8.parse_u64(value, 10) {
        ok(number) => {
            return ok(number)
        }
        err(_) => {
            return err(reject(400))
        }
    }
}

// Response owns no allocation and stores no handler borrows. Headers and body
// are copied into explicit caller storage; getters borrow only this response.
pub struct Response {
    code: u16
    fields: Fields
    data: &mut[u8]
    used: usize
    pub fn new(headers: &mut[u8], header_fields: usize, body: &mut[u8]) -> Response from(headers, body) {
        return Response { code: 200, fields: Fields.new(headers, header_fields), data: body, used: 0 }
    }
    pub fn status(&self) -> u16 {
        return self.code
    }
    pub fn set_status(&mut self, code: u16) -> void!Failure {
        if code < 200 || code > 599 {
            return err(protocol_failure(Error.InvalidStatus, http.failure(http.ErrorKind.InvalidStatus, code as usize)))
        }
        self.code = code
        return ok()
    }
    // Append preserves duplicates in insertion order, including Set-Cookie.
    // Framing and connection management belong to the runner.
    pub fn header(&mut self, name: &[u8], value: &[u8]) -> void!Failure {
        if http.equal_ascii(name, b"Content-Length") || http.equal_ascii(name, b"Transfer-Encoding") ||
            http.equal_ascii(name, b"Connection") || http.equal_ascii(name, b"Trailer") ||
            http.equal_ascii(name, b"TE") || http.equal_ascii(name, b"Upgrade") ||
            http.equal_ascii(name, b"Keep-Alive") || http.equal_ascii(name, b"Proxy-Connection") ||
            http.equal_ascii(name, b"Content-Type") && has_field(self.fields.bytes(), b"Content-Type") {
            return err(protocol_failure(Error.InvalidHeader, http.failure(http.ErrorKind.InvalidHeader, self.fields.len())))
        }
        return self.fields.append(name, value)
    }
    pub fn header_at(&self, index: usize) -> Option<http.Header> from(self) {
        return field_at(self.fields.bytes(), index)
    }
    pub fn header_next(&self, cursor: &mut usize) -> Option<http.Header> from(self) {
        return self.fields.next(cursor)
    }
    pub fn header_bytes(&self) -> usize {
        return self.fields.bytes().len
    }
    pub fn header_value(&self, name: &[u8]) -> Option<&[u8]> from(self) {
        return lookup(self.fields.bytes(), name, 0, true)
    }
    pub fn body(&self) -> &[u8] {
        return &self.data[..self.used]
    }
    pub fn bytes(&mut self, body: &[u8]) -> void!Failure {
        if body.len > self.data.len {
            return err(protocol_failure(Error.BufferFull, http.failure(http.ErrorKind.BufferFull, body.len)))
        }
        for i in 0usize..body.len {
            self.data[i] = body[i]
        }
        self.used = body.len
        return ok()
    }
    // Append supports small dynamic responses without a second scratch buffer.
    pub fn append(&mut self, body: &[u8]) -> void!Failure {
        if body.len > self.data.len - self.used {
            return err(protocol_failure(Error.BufferFull, http.failure(http.ErrorKind.BufferFull, body.len)))
        }
        for i in 0usize..body.len {
            self.data[self.used + i] = body[i]
        }
        self.used += body.len
        return ok()
    }
    pub fn empty(&mut self, status: u16) -> void!Failure {
        self.set_status(status)?
        self.used = 0
        return ok()
    }
    pub fn redirect(&mut self, location: &[u8]) -> void!Failure {
        return self.redirect_to(location, 303)
    }
    pub fn redirect_to(&mut self, location: &[u8], status: u16) -> void!Failure {
        if status != 301 && status != 302 && status != 303 && status != 307 && status != 308 {
            return err(failure(Error.InvalidStatus))
        }
        if location.len == 0 || has_field(self.fields.bytes(), b"Location") {
            return err(failure(Error.InvalidHeader))
        }
        self.header(b"Location", location)?
        return self.empty(status)
    }
    fn textual(&mut self, body: &[u8], content_type: &[u8]) -> void!Failure {
        if body.len > self.data.len {
            return err(protocol_failure(Error.BufferFull, http.failure(http.ErrorKind.BufferFull, body.len)))
        }
        match utf8.validate(body) {
            ok() => {}
            err(reason) => {
                return err(encoding_failure(Error.Handler, reason))
            }
        }
        if!has_field(self.fields.bytes(), b"Content-Type") {
            self.header(b"Content-Type", content_type)?
        }
        return self.bytes(body)
    }
    pub fn text(&mut self, body: &[u8]) -> void!Failure {
        return self.textual(body, b"text/plain; charset=utf-8")
    }
    pub fn html(&mut self, body: &[u8]) -> void!Failure {
        return self.textual(body, b"text/html; charset=utf-8")
    }
    // Already serialized JSON; validates UTF-8, not JSON syntax.
    pub fn json(&mut self, body: &[u8]) -> void!Failure {
        return self.textual(body, b"application/json")
    }

}

// Shared buffered-response policy for hosted and in-process dispatch.
pub fn bodyless(method: &[u8], status: u16) -> bool {
    return raw.equal(method, b"HEAD") || status == 204 || status == 205 || status == 304
}

// The callback cannot retain request or response borrows in handler state.
pub fn handle<H>(handler: &mut H, request: &mut Request, response: &mut Response) -> void!Failure {
    if request.cancelled {
        return err(failure(Error.Cancelled))
    }
    return handler.handle(request, response)
}
// Static responses are ordinary handlers and work with every runner.
pub struct Reply {
    data: &[u8]
    content_type: &[u8]
    location: &[u8]
    redirecting: bool
    code: u16
    pub fn status(self, code: u16) -> Reply from(self) {
        self.code = code
        return self
    }
    pub fn handle(&mut self, request: &mut Request, response: &mut Response) -> void!Failure {
        if self.redirecting {
            return response.redirect_to(self.location, self.code)
        }
        response.set_status(self.code)?
        if self.content_type.len == 0 {
            return response.bytes(self.data)
        }
        return response.textual(self.data, self.content_type)
    }
}
pub fn text(body: &[u8]) -> Reply from(body) {
    return Reply { data: body, content_type: b"text/plain; charset=utf-8", location: b"", redirecting: false, code: 200 }
}
pub fn html(body: &[u8]) -> Reply from(body) {
    return Reply { data: body, content_type: b"text/html; charset=utf-8", location: b"", redirecting: false, code: 200 }
}
pub fn json(body: &[u8]) -> Reply from(body) {
    return Reply { data: body, content_type: b"application/json", location: b"", redirecting: false, code: 200 }
}
pub fn bytes(body: &[u8]) -> Reply from(body) {
    return Reply { data: body, content_type: b"", location: b"", redirecting: false, code: 200 }
}
pub fn redirect(location: &[u8]) -> Reply from(location) {
    return Reply { data: b"", content_type: b"", location: location, redirecting: true, code: 303 }
}
pub struct WithMiddleware<H, M> {
    pub handler: H
    pub middleware: M
    pub fn handle(&mut self, request: &mut Request, response: &mut Response) -> void!Failure {
        return dispatch(&mut self.middleware, &mut self.handler, request, response)
    }
}
pub fn with<H, M>(handler: H, middleware: M) -> WithMiddleware<H, M> from(handler, middleware) {
    return WithMiddleware { handler: handler, middleware: middleware }
}
pub struct Chain<A, B> {
    pub outer: A
    pub inner: B
    pub fn before(&mut self, request: &mut Request) -> void!Failure {
        self.outer.before(request)?
        return self.inner.before(request)
    }
    pub fn after(&mut self, request: &mut Request, status: u16) {
        self.inner.after(request, status)
        self.outer.after(request, status)
    }
}
pub struct NoMiddleware {
    pub fn before(&mut self, request: &mut Request) -> void!Failure {
        return ok()
    }
    pub fn after(&mut self, request: &mut Request, status: u16) {}
}
pub fn dispatch<M, H>(middleware: &mut M, handler: &mut H, request: &mut Request, response: &mut Response) -> void!Failure {
    if request.cancelled {
        return err(failure(Error.Cancelled))
    }
    middleware.before(request)?
    match handle(handler, request, response) {
        ok() => {
            middleware.after(request, response.status());
            return ok()
        }
        err(reason) => {
            middleware.after(request, reason.status());
            return err(reason)
        }
    }
}

// Explicit application policy, including which errors become public responses.
pub struct ErrorResponses {
    pub invalid: u16
    pub missing: u16
    pub method: u16
    pub internal: u16
    pub fn defaults() -> ErrorResponses {
        return ErrorResponses { invalid: 400, missing: 404, method: 405, internal: 500 }
    }
    pub fn status(&self, reason: Error) -> u16 {
        if reason == Error.NotFound {
            return self.missing
        }
        if reason == Error.MethodNotAllowed {
            return self.method
        }
        if reason == Error.InvalidPath || reason == Error.InvalidMethod {
            return self.invalid
        }
        return self.internal
    }
}
