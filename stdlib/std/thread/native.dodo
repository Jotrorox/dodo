package native

// C boundary uses pointer/word primitives only. Native pthread_t, HANDLE and
// callback ABIs are declared against target headers in the selected adapter.
pub extern "C" fn dodo_thread_start(storage: *mut u8, callback: *const u8, argument: *mut u8) -> i32
pub extern "C" fn dodo_thread_join(storage: *mut u8)
pub extern "C" fn dodo_thread_detach(storage: *mut u8)
pub extern "C" fn dodo_thread_yield()
pub extern "C" fn dodo_thread_sleep(milliseconds: u32)
pub extern "C" fn dodo_thread_allocate(size: usize, align: usize, error: *mut i32) -> *mut u8
pub extern "C" fn dodo_thread_free(pointer: *mut u8, size: usize)
