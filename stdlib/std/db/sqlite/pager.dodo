package sqlite

import "core/mem"
import "std/db"
import "std/fs"
import "std/platform"
import "std/platform/error"
import "std/thread"

// Pager: page cache, rollback journal, file locking, freelist. WAL mode
// (the -wal log and -shm index) is in wal.dodo.
//
// The rollback journal and the lock bytes follow SQLite's documented file
// format, so SQLite and this engine can share a database file and recover
// each other's interrupted transactions.

const WRITER_VERSION: u32 = 3045000

// Slot metadata: [0..4] page number (0 = free), [4] dirty, [8..16] stamp.

fn slot_meta(e: &Engine, s: usize) -> usize {
    e.meta_off + s * SLOT_META
}

fn slot_data(e: &Engine, s: usize) -> usize {
    e.cache_off + s * e.page_size
}

fn hash_slot(e: &Engine, pgno: u32) -> usize {
    (core.wrapping_mul(pgno, 2654435761u32) as usize) & (e.hash_cap - 1)
}

fn hash_find(e: &Engine, pgno: u32) -> usize {
    h := hash_slot(e, pgno)
    for {
        v := ldu(e.ws, e.hash_off + h * 4)
        if v == 0 {
            return 0
        }
        if ld32(e.ws, slot_meta(e, v - 1)) == pgno {
            return v
        }
        h = (h + 1) & (e.hash_cap - 1)
    }
}

fn hash_insert(e: &mut Engine, pgno: u32, s: usize) {
    h := hash_slot(e, pgno)
    for ldu(e.ws, e.hash_off + h * 4) != 0 {
        h = (h + 1) & (e.hash_cap - 1)
    }
    let hash_off2 = e.hash_off + h * 4
    stu(e.ws, hash_off2, s + 1)
}

fn hash_remove(e: &mut Engine, pgno: u32) {
    h := hash_slot(e, pgno)
    for {
        v := ldu(e.ws, e.hash_off + h * 4)
        if v == 0 {
            return
        }
        if ld32(e.ws, slot_meta(e, v - 1)) == pgno {
            break
        }
        h = (h + 1) & (e.hash_cap - 1)
    }
    // Backward-shift deletion keeps probe chains intact.
    let hash_off2 = e.hash_off + h * 4
    stu(e.ws, hash_off2, 0)
    j := h
    for {
        j = (j + 1) & (e.hash_cap - 1)
        v := ldu(e.ws, e.hash_off + j * 4)
        if v == 0 {
            return
        }
        let ld322 = ld32(e.ws, slot_meta(e, v - 1))
        home := hash_slot(e, ld322)
        // Move the entry back if its home is cyclically outside (h, j].
        between := false
        if h <= j {
            between = home > h && home <= j
        } else {
            between = home > h || home <= j
        }
        if !between {
            let hash_off3 = e.hash_off + h * 4
            stu(e.ws, hash_off3, v)
            let hash_off4 = e.hash_off + j * 4
            stu(e.ws, hash_off4, 0)
            h = j
        }
    }
}

fn cache_clear(e: &mut Engine) {
    for s in 0usize..e.nslots {
        m := slot_meta(e, s)
        st32(e.ws, m, 0)
        e.ws[m + 4] = 0
    }
    let hash_off2 = e.hash_off
    let hash_cap2 = e.hash_cap * 4
    zero_bytes(e.ws, hash_off2, hash_cap2)
}

fn cache_drop(e: &mut Engine, pgno: u32) {
    v := hash_find(e, pgno)
    if v != 0 {
        hash_remove(e, pgno)
        m := slot_meta(e, v - 1)
        st32(e.ws, m, 0)
        e.ws[m + 4] = 0
    }
}

// ---------------------------------------------------------------------------
// File access

fn file_read(e: &mut Engine, pos: u64, dst: usize, len: usize) -> usize!db.Error {
    failed := false
    got := 0usize
    match &mut e.file {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {},
                err(_) => {
                    failed = true
                },
            }
            for !failed && got < len {
                match f.read(&mut e.ws[dst + got..dst + len]) {
                    ok(n) => {
                        if n == 0 {
                            break
                        }
                        got += n
                    },
                    err(_) => {
                        failed = true
                    },
                }
            }
        },
        none => {},
    }
    if failed {
        return err(io_fail(e, "disk I/O error (read)"))
    }
    ok(got)
}

fn file_write(e: &mut Engine, pos: u64, src: usize, len: usize) -> void!db.Error {
    failed := false
    put := 0usize
    match &mut e.file {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {},
                err(_) => {
                    failed = true
                },
            }
            for !failed && put < len {
                match f.write(&e.ws[src + put..src + len]) {
                    ok(n) => {
                        if n == 0 {
                            failed = true
                        }
                        put += n
                    },
                    err(_) => {
                        failed = true
                    },
                }
            }
        },
        none => {},
    }
    if failed {
        return err(io_fail(e, "disk I/O error (write)"))
    }
    ok()
}

fn file_size(e: &mut Engine) -> u64!db.Error {
    size := 0u64
    failed := false
    match &e.file {
        some(f) => {
            match f.metadata() {
                ok(m) => {
                    size = m.size
                },
                err(_) => {
                    failed = true
                },
            }
        },
        none => {},
    }
    if failed {
        return err(io_fail(e, "disk I/O error (fstat)"))
    }
    ok(size)
}

fn file_sync(e: &mut Engine) -> void!db.Error {
    failed := false
    match &mut e.file {
        some(f) => {
            match f.sync() {
                ok() => {},
                err(_) => {
                    failed = true
                },
            }
        },
        none => {},
    }
    if failed {
        return err(io_fail(e, "disk I/O error (fsync)"))
    }
    ok()
}

fn file_truncate(e: &mut Engine, size: u64) -> void!db.Error {
    failed := false
    match &mut e.file {
        some(f) => {
            match f.set_len(size) {
                ok() => {},
                err(_) => {
                    failed = true
                },
            }
        },
        none => {},
    }
    if failed {
        return err(io_fail(e, "disk I/O error (truncate)"))
    }
    ok()
}

fn jread(e: &mut Engine, pos: u64, dst: usize, len: usize) -> usize!db.Error {
    failed := false
    got := 0usize
    match &mut e.journal {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {},
                err(_) => {
                    failed = true
                },
            }
            for !failed && got < len {
                match f.read(&mut e.ws[dst + got..dst + len]) {
                    ok(n) => {
                        if n == 0 {
                            break
                        }
                        got += n
                    },
                    err(_) => {
                        failed = true
                    },
                }
            }
        },
        none => {},
    }
    if failed {
        return err(io_fail(e, "disk I/O error (journal read)"))
    }
    ok(got)
}

fn jwrite_bytes(e: &mut Engine, pos: u64, src: &[u8]) -> void!db.Error {
    failed := false
    put := 0usize
    match &mut e.journal {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {},
                err(_) => {
                    failed = true
                },
            }
            for !failed && put < src.len {
                match f.write(&src[put..]) {
                    ok(n) => {
                        if n == 0 {
                            failed = true
                        }
                        put += n
                    },
                    err(_) => {
                        failed = true
                    },
                }
            }
        },
        none => {
            failed = true
        },
    }
    if failed {
        return err(io_fail(e, "disk I/O error (journal write)"))
    }
    ok()
}

fn jwrite(e: &mut Engine, pos: u64, src: usize, len: usize) -> void!db.Error {
    failed := false
    put := 0usize
    match &mut e.journal {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {},
                err(_) => {
                    failed = true
                },
            }
            for !failed && put < len {
                match f.write(&e.ws[src + put..src + len]) {
                    ok(n) => {
                        if n == 0 {
                            failed = true
                        }
                        put += n
                    },
                    err(_) => {
                        failed = true
                    },
                }
            }
        },
        none => {
            failed = true
        },
    }
    if failed {
        return err(io_fail(e, "disk I/O error (journal write)"))
    }
    ok()
}

fn jsync(e: &mut Engine) -> void!db.Error {
    failed := false
    match &mut e.journal {
        some(f) => {
            match f.sync() {
                ok() => {},
                err(_) => {
                    failed = true
                },
            }
        },
        none => {},
    }
    if failed {
        return err(io_fail(e, "disk I/O error (journal fsync)"))
    }
    ok()
}

fn jsize(e: &mut Engine) -> u64 {
    size := 0u64
    match &e.journal {
        some(f) => {
            match f.metadata() {
                ok(m) => {
                    size = m.size
                },
                err(_) => {},
            }
        },
        none => {},
    }
    size
}

fn journal_close(e: &mut Engine) {
    match &mut e.journal {
        some(f) => {
            match f.close() {
                ok() => {},
                err(_) => {},
            }
        },
        none => {},
    }
    e.journal = none
}

// Builds "<path><suffix>" in `out` and returns its length.
fn side_path(e: &Engine, suffix: &str, out: &mut[u8]) -> usize {
    n := e.path_len
    for i in 0usize..n {
        out[i] = e.ws[i]
    }
    s := mem.str_bytes(suffix)
    for i in 0usize..s.len {
        out[n + i] = s[i]
    }
    n + s.len
}

fn journal_exists(e: &mut Engine) -> bool {
    buf := [0u8; 1100]
    n := side_path(e, "-journal", &mut buf)
    text := unsafe {
        mem.str_from_utf8(&buf[..n])
    }
    ws := platform.workspace()
    match ws.set(text) {
        ok() => {},
        err(_) => {
            return false
        },
    }
    match ws.get() {
        ok(name) => {
            match fs.metadata(&name) {
                ok(m) => {
                    return m.size > 0
                },
                err(_) => {
                    return false
                },
            }
        },
        err(_) => {
            return false
        },
    }
}

fn journal_open_file(e: &mut Engine, create: bool) -> void!db.Error {
    buf := [0u8; 1100]
    n := side_path(e, "-journal", &mut buf)
    text := unsafe {
        mem.str_from_utf8(&buf[..n])
    }
    ws := platform.workspace()
    options := fs.OpenOptions.new()
    options.read = true
    options.write = true
    options.create = create
    options.truncate = create
    match fs.File.open_utf8(text, &options, &mut ws) {
        ok(file) => {
            e.journal = some(file)
        },
        err(_) => {
            return err(fail(e, SQLITE_CANTOPEN, "unable to open the rollback journal"))
        },
    }
    ok()
}

fn journal_delete(e: &mut Engine) -> void!db.Error {
    journal_close(e)
    buf := [0u8; 1100]
    n := side_path(e, "-journal", &mut buf)
    text := unsafe {
        mem.str_from_utf8(&buf[..n])
    }
    ws := platform.workspace()
    failed := false
    match ws.set(text) {
        ok() => {},
        err(_) => {
            failed = true
        },
    }
    if !failed {
        match ws.get() {
            ok(name) => {
                match fs.remove_file(&name) {
                    ok() => {},
                    err(reason) => {
                        if reason.kind != error.Kind.NotFound {
                            failed = true
                        }
                    },
                }
            },
            err(_) => {
                failed = true
            },
        }
    }
    if failed {
        return err(io_fail(e, "disk I/O error (journal delete)"))
    }
    ok()
}

// ---------------------------------------------------------------------------
// Locks: SQLite's lock-byte protocol. SHARED is a read lock on the
// 510-byte shared range, RESERVED a write lock on the reserved byte, and
// EXCLUSIVE adds write locks on the pending byte and the shared range.

fn try_lock(e: &mut Engine, start: u64, len: u64, shared: bool) -> bool!db.Error {
    got := false
    failed := false
    match &mut e.file {
        some(f) => {
            match f.try_lock_range(start, len, shared) {
                ok(v) => {
                    got = v
                },
                err(_) => {
                    failed = true
                },
            }
        },
        none => {
            got = true
        },
    }
    if failed {
        return err(io_fail(e, "disk I/O error (lock)"))
    }
    ok(got)
}

fn unlock(e: &mut Engine, start: u64, len: u64) {
    match &mut e.file {
        some(f) => {
            match f.unlock_range(start, len) {
                ok() => {},
                err(_) => {},
            }
        },
        none => {},
    }
}

fn busy(e: &mut Engine) -> db.Error {
    fail(e, SQLITE_BUSY, "database is locked")
}

fn lock_shared(e: &mut Engine) -> void!db.Error {
    if e.memory || e.lock >= LOCK_SHARED {
        e.lock = if e.lock >= LOCK_SHARED {
            e.lock
        } else {
            LOCK_SHARED
        }
        return ok()
    }
    attempts := 0u32
    for {
        // A pending writer (write lock on the pending byte) blocks new readers.
        if try_lock(e, PENDING_BYTE, 1, true)? {
            got := try_lock(e, SHARED_FIRST, SHARED_SIZE, true)?
            unlock(e, PENDING_BYTE, 1)
            if got {
                break
            }
        }
        attempts += 1
        if attempts > e.busy_retries {
            return err(busy(e))
        }
        pause()
    }
    e.lock = LOCK_SHARED
    ok()
}

fn lock_reserved(e: &mut Engine) -> void!db.Error {
    if e.memory || e.lock >= LOCK_RESERVED {
        e.lock = if e.lock >= LOCK_RESERVED {
            e.lock
        } else {
            LOCK_RESERVED
        }
        return ok()
    }
    attempts := 0u32
    for {
        if try_lock(e, RESERVED_BYTE, 1, false)? {
            break
        }
        attempts += 1
        if attempts > e.busy_retries {
            return err(busy(e))
        }
        pause()
    }
    e.lock = LOCK_RESERVED
    ok()
}

fn lock_exclusive(e: &mut Engine) -> void!db.Error {
    if e.memory || e.lock >= LOCK_EXCLUSIVE {
        e.lock = LOCK_EXCLUSIVE
        return ok()
    }
    if !try_lock(e, PENDING_BYTE, 1, false)? {
        return err(busy(e))
    }
    // Upgrade the shared range to a write lock; this fails while another
    // process reads. (Windows cannot convert locks, so release first; the
    // pending lock keeps new readers out meanwhile.)
    attempts := 0u32
    for {
        unlock(e, SHARED_FIRST, SHARED_SIZE)
        if try_lock(e, SHARED_FIRST, SHARED_SIZE, false)? {
            break
        }
        if !try_lock(e, SHARED_FIRST, SHARED_SIZE, true)? {
            // Lost the read lock entirely; give up the attempt.
            unlock(e, PENDING_BYTE, 1)
            return err(busy(e))
        }
        attempts += 1
        if attempts > e.busy_retries {
            unlock(e, PENDING_BYTE, 1)
            return err(busy(e))
        }
        pause()
    }
    e.lock = LOCK_EXCLUSIVE
    ok()
}

// One busy-wait step: 1 ms, so the retry count is a timeout in milliseconds.
fn pause() {
    thread.sleep_ms(1)
}

// Drops to SHARED (keep_shared) or no lock.
fn unlock_to(e: &mut Engine, keep_shared: bool) {
    if e.memory {
        e.lock = if keep_shared {
            LOCK_SHARED
        } else {
            LOCK_NONE
        }
        return
    }
    if e.w.open {
        // WAL mode: the SHARED lock on the database file is kept while the
        // log is open; transactions end by releasing WAL locks.
        wal_end_write(e)
        if !keep_shared {
            wal_end_read(e)
        }
        return
    }
    if e.lock >= LOCK_EXCLUSIVE {
        unlock(e, SHARED_FIRST, SHARED_SIZE)
        if keep_shared {
            match try_lock(e, SHARED_FIRST, SHARED_SIZE, true) {
                ok(_) => {},
                err(_) => {},
            }
        }
        unlock(e, PENDING_BYTE, 1)
    } else if !keep_shared && e.lock >= LOCK_SHARED {
        unlock(e, SHARED_FIRST, SHARED_SIZE)
    }
    if e.lock >= LOCK_RESERVED {
        unlock(e, RESERVED_BYTE, 1)
    }
    e.lock = if keep_shared && e.lock >= LOCK_SHARED {
        LOCK_SHARED
    } else {
        LOCK_NONE
    }
}

// ---------------------------------------------------------------------------
// Opening and the read transaction

// True while a read transaction is open.
fn read_active(e: &Engine) -> bool {
    if e.w.open {
        e.w.read_lock >= 0
    } else {
        e.lock >= LOCK_SHARED
    }
}

// Reads the header and starts a read transaction. Detects changes made by
// other connections and rolls back hot journals. A database whose header
// says WAL (read version 2) is read through its write-ahead log.
fn begin_read(e: &mut Engine) -> void!db.Error {
    if e.write_txn || (e.explicit_txn && read_active(e)) {
        return ok()
    }
    if e.memory {
        if !e.initialized {
            init_new_db_state(e)
        }
        e.lock = LOCK_SHARED
        return ok()
    }
    lock_shared(e)?
    e.w.read_fresh = true
    if e.w.open {
        return begin_read_wal(e)
    }
    if !e.readonly && journal_exists(e) {
        recover_hot_journal(e)?
    }
    size := file_size(e)?
    if size < 100 {
        if !e.initialized || e.db_pages != 0 {
            cache_clear(e)
            e.schema_loaded = false
        }
        init_new_db_state(e)
        return ok()
    }
    hdr := PATH_CAP
    // Read the 100-byte header into the message area (it is not in use).
    got := file_read(e, 0, hdr, 100)?
    if got < 100 {
        return err(fail(e, SQLITE_NOTADB, "file is not a database"))
    }
    if e.ws[hdr + 19] == 2 && !e.w.no_wal {
        ps := rd16(e.ws, hdr + 16)
        if ps == 1 {
            ps = 65536
        }
        if ps >= 512 && ps <= 65536 && (ps & (ps - 1)) == 0 && ps != e.page_size {
            e.page_size = ps
            layout_tail(e)?
            cache_clear(e)
        }
        wal_open(e)?
        return begin_read_wal(e)
    }
    apply_header(e, hdr, 0, size)
}

// Starts a WAL read transaction and reads the header of page 1 as of its
// snapshot.
fn begin_read_wal(e: &mut Engine) -> void!db.Error {
    changed := wal_begin_read(e)?
    if changed {
        cache_clear(e)
    }
    wps := wal_page_size(e)
    if wal_mx(e) > 0 && wps != e.page_size {
        e.page_size = wps
        layout_tail(e)?
        cache_clear(e)
    }
    size := file_size(e)?
    hdr := PATH_CAP
    wal_read_page(e, 1, hdr, 100)?
    let npage = wal_npage(e)
    apply_header(e, hdr, npage, size)
}

// Validates the database header at workspace offset `hdr` and adopts its
// state. The page count comes from the header when it is valid, else from
// `pages` (a WAL snapshot's size) or the file size.
fn apply_header(e: &mut Engine, hdr: usize, pages: u32, size: u64) -> void!db.Error {
    magic := "SQLite format 3"
    mb := mem.str_bytes(magic)
    for i in 0usize..15 {
        if e.ws[hdr + i] != mb[i] {
            return err(fail(e, SQLITE_NOTADB, "file is not a database"))
        }
    }
    if e.ws[hdr + 15] != 0 {
        return err(fail(e, SQLITE_NOTADB, "file is not a database"))
    }
    ps := rd16(e.ws, hdr + 16)
    if ps == 1 {
        ps = 65536
    }
    if ps < 512 || ps > 65536 || (ps & (ps - 1)) != 0 {
        return err(fail(e, SQLITE_NOTADB, "file is not a database"))
    }
    read_version := e.ws[hdr + 19]
    if read_version > 2 {
        return err(fail(e, SQLITE_CANTOPEN, "unsupported file format"))
    }
    if e.ws[hdr + 21] != 64 || e.ws[hdr + 22] != 32 || e.ws[hdr + 23] != 32 {
        return err(fail(e, SQLITE_NOTADB, "file is not a database"))
    }
    text_enc := rd32(e.ws, hdr + 56)
    if text_enc > 3 {
        return err(fail(e, SQLITE_CANTOPEN, "unsupported text encoding"))
    }
    reserved := e.ws[hdr + 20] as usize
    counter := rd32(e.ws, hdr + 24)
    cookie := rd32(e.ws, hdr + 40)
    npages := rd32(e.ws, hdr + 28)
    if npages == 0 || rd32(e.ws, hdr + 92) != counter {
        npages = if pages != 0 {
            pages
        } else {
            (size / (ps as u64)) as u32
        }
    }
    if ps != e.page_size {
        // The cache layout depends on the page size.
        e.page_size = ps
        layout_tail(e)?
        cache_clear(e)
    } else if !e.initialized || counter != e.change_counter {
        cache_clear(e)
    }
    if cookie != e.schema_cookie || !e.initialized {
        e.schema_loaded = false
    }
    e.reserved = reserved
    e.usable = ps - reserved
    e.change_counter = counter
    e.schema_cookie = cookie
    e.schema_format = rd32(e.ws, hdr + 44)
    if npages > 0 {
        e.enc = if text_enc == 0 {
            ENC_UTF8
        } else {
            text_enc as u8
        }
    }
    e.db_pages = npages
    e.file_pages = npages
    e.initialized = true
    ok()
}

fn init_new_db_state(e: &mut Engine) {
    if !e.initialized {
        e.change_counter = 0
        e.schema_cookie = 0
    }
    e.reserved = 0
    e.usable = e.page_size
    e.db_pages = 0
    e.file_pages = 0
    e.schema_format = 4
    e.enc = e.enc_new
    e.initialized = true
}

fn end_read(e: &mut Engine) {
    if e.write_txn || e.explicit_txn {
        return
    }
    unlock_to(e, false)
    if e.w.open {
        wal_auto_checkpoint(e)
    }
}

fn recover_hot_journal(e: &mut Engine) -> void!db.Error {
    // Not hot while another process holds RESERVED (it is mid-transaction).
    if !try_lock(e, RESERVED_BYTE, 1, false)? {
        return ok()
    }
    e.lock = LOCK_RESERVED
    match lock_exclusive(e) {
        ok() => {},
        err(reason) => {
            unlock(e, RESERVED_BYTE, 1)
            e.lock = LOCK_SHARED
            return err(reason)
        },
    }
    journal_open_file(e, false)?
    playback(e)?
    journal_delete(e)?
    cache_clear(e)
    e.schema_loaded = false
    unlock_to(e, true)
    ok()
}

// Replays a rollback journal into the database file. The page images are
// staged through the scratch page.
fn playback(e: &mut Engine) -> void!db.Error {
    hdr := PATH_CAP
    jlen := jsize(e)
    magic := [217u8, 213, 5, 249, 32, 161, 99, 215]
    // A journal is a sequence of segments, each a sector-sized header
    // followed by its records; SQLite starts a new segment whenever it syncs
    // the journal mid-transaction.
    off := 0u64
    first := true
    have_header := false
    initial := 0u32
    sector := 512u64
    ps := e.page_size
    page := e.scratch_page
    for {
        if off + 28 > jlen {
            break
        }
        got := jread(e, off, hdr, 28)?
        if got < 28 {
            break
        }
        good := true
        for i in 0usize..8 {
            if e.ws[hdr + i] != magic[i] {
                good = false
            }
        }
        if !good {
            break
        }
        nrec := rd32(e.ws, hdr + 8)
        nonce := rd32(e.ws, hdr + 12)
        if first {
            have_header = true
            initial = rd32(e.ws, hdr + 16)
            sector = rd32(e.ws, hdr + 20) as u64
            ps = rd32(e.ws, hdr + 24) as usize
            if ps == 0 || ps > 65536 || (ps & (ps - 1)) != 0 || sector < 32 || sector > 65536 {
                return ok()
            }
            if ps != e.page_size {
                // The journal decides the page size of the file it restores.
                e.page_size = ps
                layout_tail(e)?
                page = e.scratch_page
            }
        }
        rec := (ps as u64) + 8
        pos := off + sector
        if nrec == 4294967295u32 {
            nrec = if jlen > pos {
                ((jlen - pos) / rec) as u32
            } else {
                0u32
            }
        }
        stop := false
        for _ in 0u32..nrec {
            if pos + rec > jlen {
                stop = true
                break
            }
            tag := PATH_CAP + 32
            jread(e, pos, tag, 4)?
            pgno := rd32(e.ws, tag)
            jread(e, pos + 4, page, ps)?
            jread(e, pos + 4 + (ps as u64), tag + 4, 4)?
            sum := nonce
            k := ps - 200
            for k > 0 {
                sum = core.wrapping_add(sum, e.ws[page + k] as u32)
                if k < 200 {
                    break
                }
                k -= 200
            }
            if sum != rd32(e.ws, tag + 4) {
                stop = true
                break
            }
            if pgno != 0 && pgno <= initial {
                file_write(e, ((pgno - 1) as u64) * (ps as u64), page, ps)?
            }
            pos += rec
        }
        if stop || nrec == 0 {
            break
        }
        // The next segment starts at the next sector boundary.
        off = (pos + sector - 1) / sector * sector
        first = false
    }
    if !have_header {
        return ok()
    }
    file_truncate(e, (initial as u64) * (ps as u64))?
    file_sync(e)?
    ok()
}

// ---------------------------------------------------------------------------
// Page access

fn pending_page(e: &Engine) -> u32 {
    ((PENDING_BYTE / (e.page_size as u64)) + 1) as u32
}

fn pick_victim(e: &mut Engine) -> usize!db.Error {
    best := e.nslots
    best_stamp := 18446744073709551615u64
    for s in 0usize..e.nslots {
        m := slot_meta(e, s)
        if ld32(e.ws, m) == 0 {
            return ok(s)
        }
        if e.memory {
            continue
        }
        st := ld64(e.ws, m + 8)
        if st < best_stamp {
            best_stamp = st
            best = s
        }
    }
    if best == e.nslots {
        return err(full(e, "page cache (in-memory database is full)"))
    }
    m := slot_meta(e, best)
    pgno := ld32(e.ws, m)
    if e.ws[m + 4] != 0 {
        spill(e, best)?
    }
    hash_remove(e, pgno)
    st32(e.ws, m, 0)
    ok(best)
}

// Writes a dirty page to the database file before the transaction commits.
fn spill(e: &mut Engine, s: usize) -> void!db.Error {
    if e.w.open {
        // WAL mode: the page goes to the log as a non-commit frame.
        wal_restart_log(e)?
        m0 := slot_meta(e, s)
        let pgno0 = ld32(e.ws, m0)
        let data0 = slot_data(e, s)
        wal_append(e, pgno0, data0, 0)?
        e.ws[m0 + 4] = 0
        return ok()
    }
    journal_sync_header(e)?
    lock_exclusive(e)?
    m := slot_meta(e, s)
    pgno := ld32(e.ws, m)
    let value = ((pgno - 1) as u64) * (e.page_size as u64)
    let data = slot_data(e, s)
    let page_size2 = e.page_size
    file_write(e, value, data, page_size2)?
    e.ws[m + 4] = 0
    e.db_written = true
    if pgno > e.disk_pages {
        e.disk_pages = pgno
    }
    ok()
}

// Returns the workspace offset of page `pgno`'s data.
fn pg_fetch(e: &mut Engine, pgno: u32) -> usize!db.Error {
    if pgno == 0 || pgno > e.db_pages {
        return err(corrupt(e))
    }
    e.stamp += 1
    v := hash_find(e, pgno)
    if v != 0 {
        let meta = slot_meta(e, v - 1) + 8
        let stamp2 = e.stamp
        st64(e.ws, meta, stamp2)
        return ok(slot_data(e, v - 1))
    }
    s := pick_victim(e)?
    m := slot_meta(e, s)
    d := slot_data(e, s)
    // Pages of the file: those that existed when the transaction began and
    // new ones that were spilled to the file under cache pressure.
    frame := if e.w.open {
        wal_lookup(e, pgno)?
    } else {
        0u32
    }
    if frame != 0 {
        let pos = frame_offset(e, frame) + WAL_FRAME_HDR
        let page_size5 = e.page_size
        got := walf_read_ws(e, pos, d, page_size5)?
        if got < e.page_size {
            let page_size6 = e.page_size - got
            zero_bytes(e.ws, d + got, page_size6)
        }
    } else if !e.memory && (pgno <= e.file_pages || pgno <= e.disk_pages) {
        let value = ((pgno - 1) as u64) * (e.page_size as u64)
        let page_size2 = e.page_size
        got := file_read(e, value, d, page_size2)?
        if got < e.page_size {
            let page_size3 = e.page_size - got
            zero_bytes(e.ws, d + got, page_size3)
        }
    } else {
        let page_size4 = e.page_size
        zero_bytes(e.ws, d, page_size4)
    }
    st32(e.ws, m, pgno)
    e.ws[m + 4] = 0
    let stamp3 = e.stamp
    st64(e.ws, m + 8, stamp3)
    hash_insert(e, pgno, s)
    ok(d)
}

fn bitmap_test(e: &Engine, pgno: u32) -> bool {
    bit := pgno as usize
    (e.ws[e.bitmap_off + bit / 8] & ((1u8 << ((bit % 8) as u8)))) != 0
}

fn bitmap_set(e: &mut Engine, pgno: u32) {
    bit := pgno as usize
    o := e.bitmap_off + bit / 8
    e.ws[o] = e.ws[o] | (1u8 << ((bit % 8) as u8))
}

// Makes page `pgno` writable: journals its original content and marks it
// dirty. Returns the data offset.
fn pg_write(e: &mut Engine, pgno: u32) -> usize!db.Error {
    core.assert(e.write_txn)
    d := pg_fetch(e, pgno)?
    v := hash_find(e, pgno)
    m := slot_meta(e, v - 1)
    if pgno <= e.file_pages && !e.w.open {
        if (pgno as usize) / 8 >= e.bitmap_bytes {
            return err(full(e, "journal bitmap (database too large for this workspace)"))
        }
        if !bitmap_test(e, pgno) {
            journal_page(e, pgno, d)?
            bitmap_set(e, pgno)
        }
    }
    if e.sj_active || e.sp_n > 0 {
        stmt_save(e, pgno)?
    }
    d2 := pg_fetch(e, pgno)?
    let hash_find2 = hash_find(e, pgno) - 1
    e.ws[slot_meta(e, hash_find2) + 4] = 1
    if m != 0 {
        ok(d2)
    } else {
        ok(d2)
    }
}

fn journal_page(e: &mut Engine, pgno: u32, d: usize) -> void!db.Error {
    if e.memory {
        need := e.page_size + 4
        if e.mj_used + need > e.mj_cap {
            return err(full(e, "memory journal (transaction too large for an in-memory database)"))
        }
        o := e.mj_off + e.mj_used
        st32(e.ws, o, pgno)
        let page_size2 = e.page_size
        move_bytes(e.ws, d, o + 4, page_size2)
        e.mj_used += need
        return ok()
    }
    if !e.journal_open {
        journal_start(e)?
    }
    ps := e.page_size
    pos := 512u64 + (e.journal_records as u64) * ((ps as u64) + 8)
    tag := [0u8; 4]
    tag[0] = ((pgno >> 24) & 255) as u8
    tag[1] = ((pgno >> 16) & 255) as u8
    tag[2] = ((pgno >> 8) & 255) as u8
    tag[3] = (pgno & 255) as u8
    jwrite_bytes(e, pos, &tag)?
    d2 := pg_fetch(e, pgno)?
    jwrite(e, pos + 4, d2, ps)?
    sum := e.journal_nonce
    k := ps - 200
    for k > 0 {
        sum = core.wrapping_add(sum, e.ws[d2 + k] as u32)
        if k < 200 {
            break
        }
        k -= 200
    }
    tag[0] = ((sum >> 24) & 255) as u8
    tag[1] = ((sum >> 16) & 255) as u8
    tag[2] = ((sum >> 8) & 255) as u8
    tag[3] = (sum & 255) as u8
    jwrite_bytes(e, pos + 4 + (ps as u64), &tag)?
    e.journal_records += 1
    e.journal_synced = false
    ok()
}

fn journal_start(e: &mut Engine) -> void!db.Error {
    journal_open_file(e, true)?
    let value = (next_random(e) & 0xffffffffu64) as u32
    e.journal_nonce = value
    header := [0u8; 512]
    magic := [217u8, 213, 5, 249, 32, 161, 99, 215]
    for i in 0usize..8 {
        header[i] = magic[i]
    }
    wr32(&mut header, 12, e.journal_nonce)
    wr32(&mut header, 16, e.file_pages)
    wr32(&mut header, 20, 512)
    wr32(&mut header, 24, e.page_size as u32)
    jwrite_bytes(e, 0, &header)?
    e.journal_open = true
    e.journal_records = 0
    e.journal_synced = false
    ok()
}

// Makes the journal durable before the database file is modified: sync the
// records, then publish the record count in the header, then sync again.
fn journal_sync_header(e: &mut Engine) -> void!db.Error {
    if e.memory || e.journal_synced {
        return ok()
    }
    if !e.journal_open {
        journal_start(e)?
    }
    jsync(e)?
    count := [0u8; 4]
    wr32(&mut count, 0, e.journal_records)
    jwrite_bytes(e, 8, &count)?
    jsync(e)?
    e.journal_synced = true
    ok()
}

// ---------------------------------------------------------------------------
// Savepoint and statement journal. Each savepoint (and the statement running
// inside an explicit transaction, as an anonymous innermost level) saves the
// image a page had when the level began, the first time the page changes
// within that level. Records are appended in time order, so every level owns
// a contiguous suffix of them; RELEASE simply forgets level boundaries and
// ROLLBACK TO restores the level's suffix, newest first (the oldest image of
// a page wins). Records live in the workspace region; when it is full, a
// file database continues in a "<db>-stmtjrnl" spill file that is deleted
// when the transaction ends.
//
// Region layout: savepoint stack | savepoint names | page hash | records.
// Stack entry: [0] name offset, [4] name length, [8] first record, [12]
// database size when the savepoint began (SP_UNKNOWN until a write starts).
// Page hash entry: [0] page number, [4] newest level that saved the page.

const SP_MAX: usize = 128
const SP_ENTRY: usize = 16
const SP_NAMES: usize = 2048
const SP_UNKNOWN: u32 = 4294967295

fn sj_layout(e: &mut Engine) {
    // The page hash takes about an eighth of what is left after the stack,
    // the names and two page records.
    fixed := SP_MAX * SP_ENTRY + SP_NAMES + 2 * (e.page_size + 4)
    avail := if e.sj_cap > fixed {
        e.sj_cap - fixed
    } else {
        0usize
    }
    cap := 64usize
    for (cap * 2) * 8 <= avail / 8 {
        cap = cap * 2
    }
    e.sj_ht_cap = cap
    e.sj_ht_off = e.sj_off + SP_MAX * SP_ENTRY + SP_NAMES
    e.sj_rec_off = e.sj_ht_off + cap * 8
    rec := e.page_size + 4
    end := e.sj_off + e.sj_cap
    e.sj_ws_recs = if end > e.sj_rec_off {
        (end - e.sj_rec_off) / rec
    } else {
        0usize
    }
}

fn sp_entry(e: &Engine, k: usize) -> usize {
    e.sj_off + k * SP_ENTRY
}

fn sj_top_level(e: &Engine) -> usize {
    if e.sj_active {
        return e.sp_n + 1
    }
    e.sp_n
}

fn sj_top_pages(e: &Engine) -> u32 {
    if e.sj_active {
        return e.sj_pages
    }
    ld32(e.ws, sp_entry(e, e.sp_n - 1) + 12)
}

fn sj_ht_find(e: &Engine, pgno: u32) -> usize {
    mask := e.sj_ht_cap - 1
    h := ((pgno as usize) * 2654435761) & mask
    for _ in 0usize..e.sj_ht_cap {
        o := e.sj_ht_off + h * 8
        p := ld32(e.ws, o)
        if p == pgno || p == 0 {
            return o
        }
        h = (h + 1) & mask
    }
    0
}

fn sj_ht_level(e: &Engine, pgno: u32) -> usize {
    o := sj_ht_find(e, pgno)
    if o == 0 || ld32(e.ws, o) != pgno {
        return 0
    }
    ldu(e.ws, o + 4)
}

fn sj_ht_set(e: &mut Engine, pgno: u32, level: usize) {
    o := sj_ht_find(e, pgno)
    if o == 0 {
        return
    }
    if ld32(e.ws, o) == 0 {
        if (e.sj_ht_n + 1) * 2 > e.sj_ht_cap {
            // Full: later lookups miss and may save redundant images, which
            // is harmless because the oldest image wins on rollback.
            return
        }
        e.sj_ht_n += 1
        st32(e.ws, o, pgno)
    }
    stu(e.ws, o + 4, level)
}

// Lowers every hash level >= `lowest` to `to` (0 forgets the page).
fn sj_ht_lower(e: &mut Engine, lowest: usize, to: usize) {
    for i in 0usize..e.sj_ht_cap {
        o := e.sj_ht_off + i * 8
        if ld32(e.ws, o) != 0 && ldu(e.ws, o + 4) >= lowest {
            stu(e.ws, o + 4, to)
        }
    }
}

fn sj_clear(e: &mut Engine) {
    if e.sj_ht_n > 0 {
        let ht = e.sj_ht_off
        let bytes = e.sj_ht_cap * 8
        zero_bytes(e.ws, ht, bytes)
        e.sj_ht_n = 0
    }
    e.sj_used = 0
    e.sj_overflow = false
    sj_file_close(e)
}

fn sj_file_close(e: &mut Engine) {
    if !e.sj_file_open {
        return
    }
    match &mut e.sjf {
        some(f) => {
            match f.close() {
                ok() => {},
                err(_) => {},
            }
        },
        none => {},
    }
    e.sjf = none
    e.sj_file_open = false
    buf := [0u8; 1100]
    n := side_path(e, "-stmtjrnl", &mut buf)
    text := unsafe {
        mem.str_from_utf8(&buf[..n])
    }
    ws := platform.workspace()
    match ws.set(text) {
        ok() => {
            match ws.get() {
                ok(name) => {
                    match fs.remove_file(&name) {
                        ok() => {},
                        err(_) => {},
                    }
                },
                err(_) => {},
            }
        },
        err(_) => {},
    }
}

fn sj_file_open_now(e: &mut Engine) -> bool {
    if e.sj_file_open {
        return true
    }
    if e.memory || e.path_len == 0 {
        return false
    }
    buf := [0u8; 1100]
    n := side_path(e, "-stmtjrnl", &mut buf)
    text := unsafe {
        mem.str_from_utf8(&buf[..n])
    }
    ws := platform.workspace()
    options := fs.OpenOptions.new()
    options.read = true
    options.write = true
    options.create = true
    options.truncate = true
    match fs.File.open_utf8(text, &options, &mut ws) {
        ok(file) => {
            e.sjf = some(file)
            e.sj_file_open = true
            true
        },
        err(_) => false,
    }
}

// Writes `len` workspace bytes at `src` to the spill file at `pos`.
fn sj_file_write(e: &mut Engine, pos: u64, src: usize, len: usize) -> bool {
    good := false
    match &mut e.sjf {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {
                    good = true
                },
                err(_) => {},
            }
            put := 0usize
            for good && put < len {
                match f.write(&e.ws[src + put..src + len]) {
                    ok(n) => {
                        if n == 0 {
                            good = false
                        }
                        put += n
                    },
                    err(_) => {
                        good = false
                    },
                }
            }
        },
        none => {},
    }
    good
}

fn sj_file_write_bytes(e: &mut Engine, pos: u64, src: &[u8]) -> bool {
    good := false
    match &mut e.sjf {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {
                    good = true
                },
                err(_) => {},
            }
            put := 0usize
            for good && put < src.len {
                match f.write(&src[put..]) {
                    ok(n) => {
                        if n == 0 {
                            good = false
                        }
                        put += n
                    },
                    err(_) => {
                        good = false
                    },
                }
            }
        },
        none => {},
    }
    good
}

fn sj_file_read_bytes(e: &mut Engine, pos: u64, dst: &mut[u8]) -> bool {
    good := false
    match &mut e.sjf {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {
                    good = true
                },
                err(_) => {},
            }
            got := 0usize
            for good && got < dst.len {
                match f.read(&mut dst[got..]) {
                    ok(n) => {
                        if n == 0 {
                            good = false
                        }
                        got += n
                    },
                    err(_) => {
                        good = false
                    },
                }
            }
        },
        none => {},
    }
    good
}

fn sj_file_read(e: &mut Engine, pos: u64, dst: usize, len: usize) -> bool {
    good := false
    match &mut e.sjf {
        some(f) => {
            match f.seek(pos as usize) {
                ok(_) => {
                    good = true
                },
                err(_) => {},
            }
            got := 0usize
            for good && got < len {
                match f.read(&mut e.ws[dst + got..dst + len]) {
                    ok(n) => {
                        if n == 0 {
                            good = false
                        }
                        got += n
                    },
                    err(_) => {
                        good = false
                    },
                }
            }
        },
        none => {},
    }
    good
}

// Statement level: begins with every statement of a write transaction
// that is explicit (BEGIN or SAVEPOINT).
fn stmt_begin(e: &mut Engine) {
    if e.sp_n == 0 {
        sj_clear(e)
    }
    e.sj_pages = e.db_pages
    e.sj_active = e.explicit_txn && e.write_txn
    e.sj_stmt_first = e.sj_used
}

// Saves page `pgno` for the innermost level if this is its first change
// within that level.
fn stmt_save(e: &mut Engine, pgno: u32) -> void!db.Error {
    level := sj_top_level(e)
    if level == 0 || e.sj_overflow {
        return ok()
    }
    if pgno > sj_top_pages(e) {
        return ok()
    }
    if sj_ht_level(e, pgno) == level {
        return ok()
    }
    rec := e.page_size + 4
    i := e.sj_used
    d := pg_fetch(e, pgno)?
    if i < e.sj_ws_recs {
        dst := e.sj_rec_off + i * rec
        st32(e.ws, dst, pgno)
        let page_size2 = e.page_size
        move_bytes(e.ws, d, dst + 4, page_size2)
    } else {
        good := sj_file_open_now(e)
        if good {
            pos := ((i - e.sj_ws_recs) as u64) * (rec as u64)
            tag := [0u8; 4]
            st32(&mut tag, 0, pgno)
            good = sj_file_write_bytes(e, pos, &tag)
            if good {
                d2 := pg_fetch(e, pgno)?
                let page_size3 = e.page_size
                good = sj_file_write(e, pos + 4, d2, page_size3)
            }
        }
        if !good {
            if e.sp_n > 0 {
                return err(full(e, "savepoint journal (transaction too large for the workspace)"))
            }
            // Without savepoints a failing statement rolls back the whole
            // transaction instead.
            e.sj_overflow = true
            return ok()
        }
    }
    e.sj_used = i + 1
    sj_ht_set(e, pgno, level)
    ok()
}

// Restores records [first, sj_used) newest first, truncates them, and
// shrinks the database to `pages`.
fn sj_restore(e: &mut Engine, first: usize, pages: u32) -> void!db.Error {
    rec := e.page_size + 4
    i := e.sj_used
    for i > first {
        i -= 1
        if i < e.sj_ws_recs {
            o := e.sj_rec_off + i * rec
            pgno := ld32(e.ws, o)
            d := pg_fetch(e, pgno)?
            let src = e.sj_rec_off + i * rec + 4
            let page_size2 = e.page_size
            move_bytes(e.ws, src, d, page_size2)
            let slot = hash_find(e, pgno) - 1
            e.ws[slot_meta(e, slot) + 4] = 1
        } else {
            pos := ((i - e.sj_ws_recs) as u64) * (rec as u64)
            tag := [0u8; 4]
            if !sj_file_read_bytes(e, pos, &mut tag) {
                return err(io_fail(e, "disk I/O error (savepoint journal read)"))
            }
            pgno := ld32(&tag, 0)
            d := pg_fetch(e, pgno)?
            let page_size3 = e.page_size
            if !sj_file_read(e, pos + 4, d, page_size3) {
                return err(io_fail(e, "disk I/O error (savepoint journal read)"))
            }
            let slot2 = hash_find(e, pgno) - 1
            e.ws[slot_meta(e, slot2) + 4] = 1
        }
    }
    e.sj_used = first
    if pages != SP_UNKNOWN && pages < e.db_pages {
        for p in (pages + 1)..(e.db_pages + 1) {
            cache_drop(e, p)
        }
        e.db_pages = pages
    }
    e.schema_loaded = false
    ok()
}

// Undoes the current statement. Returns false when the statement journal
// overflowed and the whole transaction must be rolled back instead.
fn stmt_rollback(e: &mut Engine) -> bool!db.Error {
    if !e.sj_active {
        return ok(false)
    }
    level := e.sp_n + 1
    e.sj_active = false
    if e.sj_overflow {
        return ok(false)
    }
    let first = e.sj_stmt_first
    let pages = e.sj_pages
    sj_restore(e, first, pages)?
    sj_ht_lower(e, level, 0)
    ok(true)
}

// Ends the statement level; its records now belong to the enclosing
// savepoint, if any.
fn stmt_end(e: &mut Engine) {
    if e.sj_active && e.sp_n > 0 {
        let level = e.sp_n + 1
        let to = e.sp_n
        sj_ht_lower(e, level, to)
    }
    e.sj_active = false
    if e.sp_n == 0 {
        sj_clear(e)
    }
}

// Forgets every savepoint (transaction end).
fn sp_reset(e: &mut Engine) {
    e.sp_n = 0
    e.sp_names_used = 0
    e.sp_txn = false
    e.sj_active = false
    sj_clear(e)
}

// Fills in the database size of savepoints opened before the write
// transaction began.
fn sp_write_started(e: &mut Engine) {
    for k in 0usize..e.sp_n {
        o := sp_entry(e, k) + 12
        if ld32(e.ws, o) == SP_UNKNOWN {
            let pages = e.db_pages
            st32(e.ws, o, pages)
        }
    }
}

fn sp_find(e: &Engine, name: usize, nl: usize) -> usize {
    k := e.sp_n
    for k > 0 {
        k -= 1
        o := sp_entry(e, k)
        let so = ldu(e.ws, o)
        let sl = ldu(e.ws, o + 4)
        if names_eq(e, so, sl, name, nl) {
            return k
        }
    }
    NO_COL
}

fn sp_push(e: &mut Engine, name: usize, nl: usize) -> void!db.Error {
    if e.sp_n >= SP_MAX || e.sp_names_used + nl > SP_NAMES {
        return err(fail(e, SQLITE_FULL, "too many savepoints"))
    }
    dst := e.sj_off + SP_MAX * SP_ENTRY + e.sp_names_used
    move_bytes(e.ws, name, dst, nl)
    o := sp_entry(e, e.sp_n)
    stu(e.ws, o, dst)
    stu(e.ws, o + 4, nl)
    let used = e.sj_used
    stu(e.ws, o + 8, used)
    let pages = if e.write_txn {
        e.db_pages
    } else {
        SP_UNKNOWN
    }
    st32(e.ws, o + 12, pages)
    e.sp_names_used += nl
    e.sp_n += 1
    ok()
}

// RELEASE: drops savepoint k and every later one.
fn sp_release(e: &mut Engine, k: usize) {
    if k > 0 {
        sj_ht_lower(e, k + 1, k)
    }
    e.sp_names_used = ldu(e.ws, sp_entry(e, k)) - (e.sj_off + SP_MAX * SP_ENTRY)
    e.sp_n = k
    if k == 0 {
        sj_clear(e)
    }
}

// ROLLBACK TO: undoes every change since savepoint k began; k stays open.
fn sp_rollback_to(e: &mut Engine, k: usize) -> void!db.Error {
    o := sp_entry(e, k)
    first := ldu(e.ws, o + 8)
    pages := ld32(e.ws, o + 12)
    e.sp_names_used = ldu(e.ws, o) + ldu(e.ws, o + 4) - (e.sj_off + SP_MAX * SP_ENTRY)
    e.sp_n = k + 1
    if e.write_txn {
        sj_restore(e, first, pages)?
    }
    sj_ht_lower(e, k + 1, 0)
    ok()
}

// ---------------------------------------------------------------------------
// Write transactions

fn begin_write(e: &mut Engine) -> void!db.Error {
    if e.write_txn {
        return ok()
    }
    if e.readonly {
        return err(fail(e, SQLITE_READONLY, "attempt to write a readonly database"))
    }
    fresh := !read_active(e)
    begin_read(e)?
    if e.w.open {
        wal_begin_write(e, fresh)?
    } else {
        lock_reserved(e)?
    }
    e.write_txn = true
    e.db_written = false
    e.journal_open = false
    e.journal_synced = false
    e.journal_records = 0
    e.mj_used = 0
    e.file_pages = e.db_pages
    e.disk_pages = e.db_pages
    sp_write_started(e)
    n := (e.db_pages as usize) / 8 + 1
    let bitmap_off2 = e.bitmap_off
    let value = if n < e.bitmap_bytes {
        n
    } else {
        e.bitmap_bytes
    }
    zero_bytes(e.ws, bitmap_off2, value)
    if e.db_pages == 0 {
        create_page1(e)?
    }
    ok()
}

// Formats page 1 of a new database: header plus an empty sqlite_schema leaf.
fn create_page1(e: &mut Engine) -> void!db.Error {
    e.db_pages = 1
    d := pg_write(e, 1)?
    let page_size2 = e.page_size
    zero_bytes(e.ws, d, page_size2)
    magic := mem.str_bytes("SQLite format 3")
    copy_in(e.ws, d, magic)
    ps := if e.page_size == 65536 {
        1usize
    } else {
        e.page_size
    }
    wr16(e.ws, d + 16, ps)
    e.ws[d + 18] = 1
    e.ws[d + 19] = 1
    e.ws[d + 20] = 0
    e.ws[d + 21] = 64
    e.ws[d + 22] = 32
    e.ws[d + 23] = 32
    let change_counter2 = e.change_counter
    wr32(e.ws, d + 24, change_counter2)
    wr32(e.ws, d + 28, 1)
    let schema_cookie2 = e.schema_cookie
    wr32(e.ws, d + 40, schema_cookie2)
    wr32(e.ws, d + 44, 4)
    let enc2 = e.enc as u32
    wr32(e.ws, d + 56, enc2)
    let change_counter3 = e.change_counter
    wr32(e.ws, d + 92, change_counter3)
    wr32(e.ws, d + 96, WRITER_VERSION)
    e.ws[d + 100] = 13
    let page_size3 = e.page_size
    wr16(e.ws, d + 105, page_size3)
    e.schema_format = 4
    e.usable = e.page_size
    e.reserved = 0
    ok()
}

fn any_dirty(e: &Engine) -> bool {
    for s in 0usize..e.nslots {
        m := slot_meta(e, s)
        if ld32(e.ws, m) != 0 && e.ws[m + 4] != 0 {
            return true
        }
    }
    false
}

fn commit(e: &mut Engine) -> void!db.Error {
    if !e.write_txn {
        return ok()
    }
    if e.w.open {
        return commit_wal(e)
    }
    changed := e.db_written || e.db_pages != e.file_pages || any_dirty(e)
    if changed {
        d := pg_write(e, 1)?
        counter := core.wrapping_add(rd32(e.ws, d + 24), 1u32)
        wr32(e.ws, d + 24, counter)
        let db_pages2 = e.db_pages
        wr32(e.ws, d + 28, db_pages2)
        wr32(e.ws, d + 92, counter)
        wr32(e.ws, d + 96, WRITER_VERSION)
        e.change_counter = counter
        e.schema_cookie = rd32(e.ws, d + 40)
        if !e.memory {
            journal_sync_header(e)?
            lock_exclusive(e)?
            for s in 0usize..e.nslots {
                m := slot_meta(e, s)
                pgno := ld32(e.ws, m)
                if pgno != 0 && e.ws[m + 4] != 0 {
                    if pgno <= e.db_pages {
                        let value = ((pgno - 1) as u64) * (e.page_size as u64)
                        let data = slot_data(e, s)
                        let page_size2 = e.page_size
                        file_write(e, value, data, page_size2)?
                    }
                    e.ws[m + 4] = 0
                }
            }
            if e.db_pages < e.file_pages || e.db_written {
                let value2 = (e.db_pages as u64) * (e.page_size as u64)
                file_truncate(e, value2)?
            }
            file_sync(e)?
            journal_delete(e)?
        } else {
            for s in 0usize..e.nslots {
                m := slot_meta(e, s)
                e.ws[m + 4] = 0
                if ld32(e.ws, m) > e.db_pages {
                    let ld322 = ld32(e.ws, m)
                    hash_remove(e, ld322)
                    st32(e.ws, m, 0)
                }
            }
        }
    } else if e.journal_open {
        journal_delete(e)?
    }
    e.write_txn = false
    e.journal_open = false
    e.file_pages = e.db_pages
    e.mj_used = 0
    sp_reset(e)
    let explicit_txn2 = e.explicit_txn
    unlock_to(e, explicit_txn2)
    ok()
}

// WAL-mode commit. Page 1 is only rewritten when it changed, the database
// size changed, or the transaction spilled frames and needs a commit frame
// (SQLite does the same, so frame counts match).
fn commit_wal(e: &mut Engine) -> void!db.Error {
    spilled := e.w.appended
    v1 := hash_find(e, 1)
    p1_dirty := v1 != 0 && e.ws[slot_meta(e, v1 - 1) + 4] != 0
    if spilled || p1_dirty || e.db_pages != e.file_pages {
        d := pg_write(e, 1)?
        counter := core.wrapping_add(rd32(e.ws, d + 24), 1u32)
        wr32(e.ws, d + 24, counter)
        let db_pages3 = e.db_pages
        wr32(e.ws, d + 28, db_pages3)
        wr32(e.ws, d + 92, counter)
        wr32(e.ws, d + 96, WRITER_VERSION)
        e.change_counter = counter
        e.schema_cookie = rd32(e.ws, d + 40)
    }
    wal_commit(e)?
    e.write_txn = false
    e.file_pages = e.db_pages
    let explicit_txn4 = e.explicit_txn
    unlock_to(e, explicit_txn4)
    ok()
}

fn rollback(e: &mut Engine) -> void!db.Error {
    if !e.write_txn {
        return ok()
    }
    e.write_txn = false
    sp_reset(e)
    if e.w.open {
        cache_clear(e)
        undo := wal_undo(e)
        e.db_pages = e.file_pages
        e.schema_loaded = false
        let explicit_txn3 = e.explicit_txn
        unlock_to(e, explicit_txn3)
        return undo
    }
    if e.memory {
        // Restore saved images, newest first so the oldest image wins.
        rec := e.page_size + 4
        n := e.mj_used / rec
        for k in 0usize..n {
            o := e.mj_off + (n - 1 - k) * rec
            pgno := ld32(e.ws, o)
            v := hash_find(e, pgno)
            if v != 0 {
                let data = slot_data(e, v - 1)
                let page_size2 = e.page_size
                move_bytes(e.ws, o + 4, data, page_size2)
            }
        }
        for s in 0usize..e.nslots {
            m := slot_meta(e, s)
            e.ws[m + 4] = 0
            if ld32(e.ws, m) > e.file_pages {
                let ld322 = ld32(e.ws, m)
                hash_remove(e, ld322)
                st32(e.ws, m, 0)
            }
        }
        e.mj_used = 0
        e.db_pages = e.file_pages
        if e.db_pages == 0 {
            cache_clear(e)
        }
    } else {
        failure := false
        if e.db_written && e.journal_open {
            match jsync(e) {
                ok() => {},
                err(_) => {
                    failure = true
                },
            }
            match playback(e) {
                ok() => {},
                err(_) => {
                    failure = true
                },
            }
        }
        cache_clear(e)
        if e.journal_open || journal_exists(e) {
            match journal_delete(e) {
                ok() => {},
                err(_) => {
                    failure = true
                },
            }
        }
        e.journal_open = false
        e.db_pages = e.file_pages
        if failure {
            unlock_to(e, false)
            return err(io_fail(e, "disk I/O error during rollback"))
        }
    }
    e.schema_loaded = false
    let explicit_txn2 = e.explicit_txn
    unlock_to(e, explicit_txn2)
    ok()
}

// ---------------------------------------------------------------------------
// Header fields (page 1)

fn hdr_get(e: &mut Engine, off: usize) -> u32!db.Error {
    if e.db_pages == 0 {
        return ok(0)
    }
    d := pg_fetch(e, 1)?
    ok(rd32(e.ws, d + off))
}

fn hdr_set(e: &mut Engine, off: usize, v: u32) -> void!db.Error {
    d := pg_write(e, 1)?
    wr32(e.ws, d + off, v)
    ok()
}

// ---------------------------------------------------------------------------
// Freelist

fn alloc_page(e: &mut Engine) -> u32!db.Error {
    free_count := hdr_get(e, 36)?
    trunk := hdr_get(e, 32)?
    if free_count > 0 && trunk != 0 {
        if trunk > e.db_pages {
            return err(corrupt(e))
        }
        t := pg_fetch(e, trunk)?
        leaves := rd32(e.ws, t + 4)
        if leaves > 0 {
            t2 := pg_write(e, trunk)?
            leaf := rd32(e.ws, t2 + 8 + ((leaves - 1) as usize) * 4)
            wr32(e.ws, t2 + 4, leaves - 1)
            hdr_set(e, 36, free_count - 1)?
            if leaf == 0 || leaf > e.db_pages {
                return err(corrupt(e))
            }
            d := pg_write(e, leaf)?
            let page_size2 = e.page_size
            zero_bytes(e.ws, d, page_size2)
            return ok(leaf)
        }
        // The trunk itself becomes the allocated page.
        next := rd32(e.ws, t)
        hdr_set(e, 32, next)?
        hdr_set(e, 36, free_count - 1)?
        d := pg_write(e, trunk)?
        let page_size3 = e.page_size
        zero_bytes(e.ws, d, page_size3)
        return ok(trunk)
    }
    pgno := e.db_pages + 1
    if pgno == pending_page(e) {
        pgno += 1
    }
    if pgno > 2147483646u32 {
        return err(fail(e, SQLITE_FULL, "database or disk is full"))
    }
    e.db_pages = pgno
    d := pg_write(e, pgno)?
    let page_size4 = e.page_size
    zero_bytes(e.ws, d, page_size4)
    ok(pgno)
}

fn free_page(e: &mut Engine, pgno: u32) -> void!db.Error {
    if pgno < 2 || pgno > e.db_pages {
        return err(corrupt(e))
    }
    free_count := hdr_get(e, 36)?
    trunk := hdr_get(e, 32)?
    max_leaves := (e.usable / 4 - 8) as u32
    if trunk != 0 {
        t := pg_fetch(e, trunk)?
        leaves := rd32(e.ws, t + 4)
        if leaves < max_leaves {
            t2 := pg_write(e, trunk)?
            wr32(e.ws, t2 + 8 + (leaves as usize) * 4, pgno)
            wr32(e.ws, t2 + 4, leaves + 1)
            hdr_set(e, 36, free_count + 1)?
            return ok()
        }
    }
    d := pg_write(e, pgno)?
    let page_size2 = e.page_size
    zero_bytes(e.ws, d, page_size2)
    wr32(e.ws, d, trunk)
    wr32(e.ws, d + 4, 0)
    hdr_set(e, 32, pgno)?
    hdr_set(e, 36, free_count + 1)?
    ok()
}
