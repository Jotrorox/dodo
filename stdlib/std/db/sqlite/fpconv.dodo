const FP_MASK32: u64 = 4294967295

// 64 x 64 -> 128-bit product as (high, low).
fn fp_mul128(a: u64, b: u64) -> (u64, u64) {
    a0 := a & FP_MASK32
    a1 := a >> 32
    b0 := b & FP_MASK32
    b1 := b >> 32
    p00 := a0 * b0
    p01 := a0 * b1
    p10 := a1 * b0
    p11 := a1 * b1
    mid := (p00 >> 32) + (p01 & FP_MASK32) + (p10 & FP_MASK32)
    lo := (p00 & FP_MASK32) | ((mid & FP_MASK32) << 32)
    hi := p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)
    (hi, lo)
}

// floor(log2(10^p)) and floor(log10(2^p)), from 5-digit rational
// approximations (exact over the exponent range used here).
fn fp_p10_to_2(p: i32) -> i32 {
    (p * 108853) >> 15
}

fn fp_p2_to_10(p: i32) -> i32 {
    (p * 78913) >> 18
}

fn fp_bits(v: u64) -> i32 {
    n := 0i32
    x := v
    for x != 0 {
        n += 1
        x = x >> 1
    }
    n
}

// For m * 2^e (m with its top bit set) returns (d, p) with m * 2^e close to
// d * 10^p, where d has at least `n` (1..18) significant digits.
fn fp_bin_to_dec(m: u64, e: i32, n: i32) -> (u64, i32) {
    p := n - 1 - fp_p2_to_10(e + 63)
    let (h, _) = fp_mul128(m, FP_P10_HI[(p + 348) as usize])
    if n == 18 {
        h2 := h >> ((-(e + fp_p10_to_2(p) + 2)) as u64)
        return ((h2 + ((h2 & 1) * 2)) >> 1, -p)
    }
    (h >> ((-(e + fp_p10_to_2(p) + 1)) as u64), -p)
}

// The double nearest to d * 10^p as SQLite computes it (d > 0).
fn fp_dec_to_bin(d: u64, p: i32) -> f64 {
    if p < -348 {
        return 0.0
    }
    if p > 347 {
        return 1.0e308 * 10.0
    }
    b := fp_bits(d)
    lp := fp_p10_to_2(p)
    e := 53 - b - lp
    if e > 1074 {
        if e >= 1130 {
            return 0.0
        }
        e = 1074
    }
    s := -(e - (64 - b) + lp + 3)
    ph := FP_P10_HI[(p + 348) as usize]
    pl := FP_P10_LO[(p + 348) as usize] as u64
    if pl != 0 {
        ph += 1
        pl = (~pl) & FP_MASK32
    }
    x := d << ((64 - b) as u64)
    let (hi0, lo) = fp_mul128(x, ph)
    hi := hi0
    mid1 := lo >> 32
    sticky := 1u64
    if (hi & ((1u64 << (s as u64)) - 1)) == 0 {
        let (mh, _) = fp_mul128(x, pl << 32)
        mid2 := mh >> 32
        // 32-bit wrapping difference, as the reference arithmetic does.
        diff := (mid1 + 4294967296u64 - mid2) & FP_MASK32
        sticky = if diff > 1 {
            1u64
        } else {
            0u64
        }
        if mid1 < mid2 {
            hi -= 1
        }
    }
    u := (hi >> (s as u64)) | sticky
    if u >= (1u64 << 55) - 2 {
        u = (u >> 1) | (u & 1)
        e -= 1
    }
    m := (u + 1 + ((u >> 2) & 1)) >> 2
    if e <= -972 {
        return 1.0e308 * 10.0
    }
    if (m & (1u64 << 52)) != 0 {
        m = (m & ((1u64 << 52) - 1)) | (((1075 - e) as u64) << 52)
    }
    u2f(m)
}

// Decimal digits of r (finite, nonzero) rounded to `iround` significant
// digits (iround > 0) or to -iround places after the decimal point
// (iround <= 0), at most `mxround` digits. Writes ASCII digits to z[start..
// start + n] and returns (start, n, idp); the decimal point sits idp digits
// from the first. Trailing zeros are removed. z needs 24 bytes.
fn fp_decode(r: f64, iround_in: i32, mxround: i32, z: &mut[u8]) -> (usize, usize, i32) {
    a := if r < 0.0 {
        -r
    } else {
        r
    }
    bits := f2u(a)
    ex := ((bits >> 52) & 2047) as i32
    v := bits & ((1u64 << 52) - 1)
    if ex == 0 {
        nn := 64 - fp_bits(v)
        v = v << (nn as u64)
        ex = -1074 - nn
    } else {
        v = (v << 11) | (1u64 << 63)
        ex -= 1086
    }
    iround := iround_in
    want := if iround <= 0 || iround >= 18 {
        18i32
    } else {
        iround + 1
    }
    let (d, exp) = fp_bin_to_dec(v, ex, want)
    // Digits go to the end of z, leaving room in front for a carry.
    tmp := [0u8; 24]
    tn := 0usize
    x := d
    for x != 0 {
        tmp[tn] = 48 + ((x % 10) as u8)
        x = x / 10
        tn += 1
    }
    start := 2usize
    for k in 0usize..tn {
        z[start + k] = tmp[tn - 1 - k]
    }
    n := tn as i32
    idp := n + exp
    if iround <= 0 {
        iround = idp - iround
        if iround == 0 && z[start] >= 53 {
            iround = 1
            start -= 1
            z[start] = 48
            n += 1
            idp += 1
        }
    }
    if iround > 0 && (iround < n || n > mxround) {
        if iround > mxround {
            iround = mxround
        }
        if iround == 17 {
            // "%!.17g": use fewer digits when they round-trip, so 49.47
            // prints as 49.47 rather than 49.469999999999999.
            if z[start + 15] == 57 && z[start + 14] == 57 {
                jj := 14usize
                for jj > 0 && z[start + jj - 1] == 57 {
                    jj -= 1
                }
                v2 := 1u64
                if jj > 0 {
                    v2 = 0
                    for k in 0usize..jj {
                        v2 = v2 * 10 + ((z[start + k] - 48) as u64)
                    }
                    v2 += 1
                }
                if a == fp_dec_to_bin(v2, exp + n - (jj as i32)) {
                    iround = (jj as i32) + 1
                }
            } else if idp >= n || (z[start + 15] == 48 && z[start + 14] == 48 && z[start + 13] == 48) {
                jj := 13usize
                for z[start + jj - 1] == 48 {
                    jj -= 1
                }
                v2 := 0u64
                for k in 0usize..jj {
                    v2 = v2 * 10 + ((z[start + k] - 48) as u64)
                }
                if a == fp_dec_to_bin(v2, exp + n - (jj as i32)) {
                    iround = (jj as i32) + 1
                }
            }
        }
        n = iround
        if z[start + (iround as usize)] >= 53 {
            j := (iround as usize) - 1
            for {
                z[start + j] += 1
                if z[start + j] <= 57 {
                    break
                }
                z[start + j] = 48
                if j == 0 {
                    start -= 1
                    z[start] = 49
                    n += 1
                    idp += 1
                    break
                }
                j -= 1
            }
        }
    }
    nu := n as usize
    for nu > 1 && z[start + nu - 1] == 48 {
        nu -= 1
    }
    (start, nu, idp)
}

// Formats v for printf conversion `conv` (f, e, E, g, G) with SQLite's
// rules; `alt` is the '#' flag, `alt2` the '!' flag. Writes the sign too.
// Returns the length written to out.
fn fp_format(out: &mut[u8], v: f64, conv: u8, precision_in: i32, alt: bool, alt2: bool, plus: u8) -> usize {
    o := 0usize
    if v != v {
        return copy_str(out, 0, "NaN")
    }
    if v > 1.7976931348623157e308 || v < -1.7976931348623157e308 {
        if v < 0.0 {
            out[0] = 45
            o = 1
        } else if plus != 0 {
            out[0] = plus
            o = 1
        }
        return copy_str(out, o, "Inf")
    }
    xtype := conv | 32
    precision := precision_in
    iround := 0i32
    if xtype == 102 {
        iround = -precision
    } else if xtype == 103 {
        if precision == 0 {
            precision = 1
        }
        iround = precision
    } else {
        iround = precision + 1
    }
    z := [0u8; 24]
    start := 0usize
    nd := 1usize
    idp := 1i32
    neg := false
    if v == 0.0 {
        z[0] = 48
    } else {
        neg = v < 0.0
        let (s0, n0, d0) = fp_decode(v, iround, if alt2 {
            20i32
        } else {
            16i32
        }, &mut z)
        start = s0
        nd = n0
        idp = d0
    }
    prefix := plus
    if neg {
        prefix = if alt && plus == 0 && xtype == 102 && idp <= iround {
            0u8
        } else {
            45u8
        }
    }
    rtz := alt2
    exp := idp - 1
    if xtype == 103 {
        precision -= 1
        rtz = !alt
        if exp < -4 || exp > precision {
            xtype = 101
        } else {
            precision = precision - exp
            xtype = 102
        }
    }
    e2 := if xtype == 101 {
        0i32
    } else {
        idp - 1
    }
    dp := precision > 0 || alt || alt2
    if prefix != 0 {
        out[o] = prefix
        o += 1
    }
    j := 0usize
    if e2 < 0 {
        out[o] = 48
        o += 1
    } else {
        j = (e2 + 1) as usize
        if j > nd {
            j = nd
        }
        for k in 0usize..j {
            out[o] = z[start + k]
            o += 1
        }
        e2 -= j as i32
        if e2 >= 0 {
            for _ in 0i32..(e2 + 1) {
                out[o] = 48
                o += 1
            }
            e2 = -1
        }
    }
    if dp {
        out[o] = 46
        o += 1
    }
    if e2 < -1 && precision > 0 {
        nn := -1 - e2
        if nn > precision {
            nn = precision
        }
        for _ in 0i32..nn {
            out[o] = 48
            o += 1
        }
        precision -= nn
    }
    if precision > 0 {
        nn := (nd - j) as i32
        if nn > precision {
            nn = precision
        }
        if nn > 0 {
            for k in 0usize..(nn as usize) {
                out[o] = z[start + j + k]
                o += 1
            }
            precision -= nn
        }
        if precision > 0 && !rtz {
            for _ in 0i32..precision {
                out[o] = 48
                o += 1
            }
        }
    }
    if rtz && dp {
        for out[o - 1] == 48 {
            o -= 1
        }
        if out[o - 1] == 46 {
            if alt2 {
                out[o] = 48
                o += 1
            } else {
                o -= 1
            }
        }
    }
    if xtype == 101 {
        x := idp - 1
        out[o] = if conv == 69 || conv == 71 {
            69u8
        } else {
            101u8
        }
        o += 1
        if x < 0 {
            out[o] = 45
            x = -x
        } else {
            out[o] = 43
        }
        o += 1
        if x >= 100 {
            out[o] = 48 + ((x / 100) as u8)
            o += 1
            x = x % 100
        }
        out[o] = 48 + ((x / 10) as u8)
        out[o + 1] = 48 + ((x % 10) as u8)
        o += 2
    }
    o
}

// SQLite's text -> real conversion of a number's text [o, o + n) (an
// optional sign, digits, '.', exponent; the caller has checked the syntax).
fn fp_atof(b: &[u8], o: usize, n: usize) -> f64 {
    p := o
    end := o + n
    for p < end && is_space_b(b[p]) {
        p += 1
    }
    neg := false
    if p < end && (b[p] == 43 || b[p] == 45) {
        neg = b[p] == 45
        p += 1
    }
    lim := (18446744073709551615u64 - 9) / 10
    s := 0u64
    d := 0i32
    for p < end && is_digit(b[p]) {
        s = s * 10 + ((b[p] - 48) as u64)
        p += 1
        if s >= lim {
            for p < end && is_digit(b[p]) {
                p += 1
                d += 1
            }
            break
        }
    }
    if p < end && b[p] == 46 {
        p += 1
        for p < end && is_digit(b[p]) {
            if s < lim {
                s = s * 10 + ((b[p] - 48) as u64)
                d -= 1
            }
            p += 1
        }
    }
    if p < end && (b[p] == 101 || b[p] == 69) {
        p += 1
        esign := 1i32
        if p < end && b[p] == 45 {
            esign = -1
            p += 1
        } else if p < end && b[p] == 43 {
            p += 1
        }
        x := 0i32
        for p < end && is_digit(b[p]) {
            x = if x < 10000 {
                x * 10 + ((b[p] - 48) as i32)
            } else {
                10000i32
            }
            p += 1
        }
        d += esign * x
    }
    r := if s == 0 {
        0.0
    } else {
        fp_dec_to_bin(s, d)
    }
    if neg {
        -r
    } else {
        r
    }
}
