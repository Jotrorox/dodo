package sqlite

import "std/db"

// B-tree pages and cursors (SQLite file format, section "B-tree Pages").
//
// Page types: 2 index interior, 5 table interior, 10 index leaf, 13 table
// leaf. Table trees keep rows in leaves; index trees keep entries in both
// interior and leaf cells.

// Cursor record layout.
const C_ROOT: usize = 0
const C_INDEX: usize = 4
const C_STATE: usize = 5
const C_DEPTH: usize = 6
const C_PAYVALID: usize = 7
const C_NKEY: usize = 8
const C_NULLROW: usize = 12
const C_OPEN: usize = 13
const C_ROWID: usize = 16
const C_PAYOFF: usize = 24
const C_PAYLEN: usize = 28
const C_INFO: usize = 32
const C_PATH: usize = 96
const C_EXTRA: usize = 288

const ST_INVALID: u8 = 0
const ST_VALID: u8 = 1
const ST_EOF: u8 = 2

// Gather buffer layout.
const G_N: usize = 0
const G_USED: usize = 4
const G_RIGHT: usize = 8
const G_TYPE: usize = 12
const G_ENTRIES: usize = 16

fn cur(e: &Engine, c: usize) -> usize {
    core.assert(c < NCURSORS)
    e.cur_off + c * CURSOR_BYTES
}

fn hoff(pgno: u32) -> usize {
    if pgno == 1 {
        100
    } else {
        0
    }
}

fn is_leaf(t: u8) -> bool {
    t == 10 || t == 13
}

fn hdr_size(t: u8) -> usize {
    if is_leaf(t) {
        8
    } else {
        12
    }
}

fn pg_ncells(e: &Engine, d: usize, ho: usize) -> usize {
    rd16(e.ws, d + ho + 3)
}

fn cell_at(e: &Engine, d: usize, ho: usize, t: u8, i: usize) -> usize {
    d + rd16(e.ws, d + ho + hdr_size(t) + 2 * i)
}

fn child_at(e: &Engine, d: usize, ho: usize, t: u8, i: usize) -> u32 {
    if i >= pg_ncells(e, d, ho) {
        return rd32(e.ws, d + ho + 8)
    }
    rd32(e.ws, cell_at(e, d, ho, t, i))
}

fn path_pg(e: &Engine, c: usize, level: usize) -> u32 {
    ld32(e.ws, cur(e, c) + C_PATH + level * 8)
}

fn path_idx(e: &Engine, c: usize, level: usize) -> usize {
    ldu(e.ws, cur(e, c) + C_PATH + level * 8 + 4)
}

fn set_path(e: &mut Engine, c: usize, level: usize, pgno: u32, idx: usize) {
    o := cur(e, c) + C_PATH + level * 8
    st32(e.ws, o, pgno)
    stu(e.ws, o + 4, idx)
}

fn set_idx(e: &mut Engine, c: usize, level: usize, idx: usize) {
    let cursor = cur(e, c) + C_PATH + level * 8 + 4
    stu(e.ws, cursor, idx)
}

fn depth(e: &Engine, c: usize) -> usize {
    e.ws[cur(e, c) + C_DEPTH] as usize
}

fn set_depth(e: &mut Engine, c: usize, d: usize) {
    e.ws[cur(e, c) + C_DEPTH] = d as u8
}

fn set_state(e: &mut Engine, c: usize, s: u8) {
    o := cur(e, c)
    e.ws[o + C_STATE] = s
    e.ws[o + C_PAYVALID] = 0
}

fn cur_valid(e: &Engine, c: usize) -> bool {
    e.ws[cur(e, c) + C_STATE] == ST_VALID
}

fn cur_open(e: &mut Engine, c: usize, root: u32, index: bool) {
    o := cur(e, c)
    zero_bytes(e.ws, o, C_EXTRA)
    st32(e.ws, o + C_ROOT, root)
    e.ws[o + C_INDEX] = if index {
        1
    } else {
        0
    }
    e.ws[o + C_OPEN] = 1
}

fn cur_is_index(e: &Engine, c: usize) -> bool {
    e.ws[cur(e, c) + C_INDEX] != 0
}

fn cur_rowid(e: &Engine, c: usize) -> i64 {
    u2i(ld64(e.ws, cur(e, c) + C_ROWID))
}

// ---------------------------------------------------------------------------
// Cell parsing

fn max_local(e: &Engine, table_leaf: bool) -> usize {
    if table_leaf {
        return e.usable - 35
    }
    (e.usable - 12) * 64 / 255 - 23
}

fn local_size(e: &Engine, p: u64, table_leaf: bool) -> usize {
    x := max_local(e, table_leaf)
    if p <= (x as u64) {
        return p as usize
    }
    m := (e.usable - 12) * 32 / 255 - 23
    k := (m as u64) + ((p - (m as u64)) % ((e.usable - 4) as u64))
    if k <= (x as u64) {
        return k as usize
    }
    m
}

// (payload size, offset of payload from cell start, local bytes, rowid)
fn cell_info(e: &Engine, cell: usize, t: u8) -> (u64, usize, usize, i64) {
    if t == 5 {
        let (key, kn) = get_varint(e.ws, cell + 4)
        return (0u64, 4 + kn, 0usize, u2i(key))
    }
    p := cell
    if t == 2 {
        p += 4
    }
    let (size, n) = get_varint(e.ws, p)
    p += n
    rowid := 0i64
    if t == 13 {
        let (r, rn) = get_varint(e.ws, p)
        p += rn
        rowid = u2i(r)
    }
    (size, p - cell, local_size(e, size, t == 13), rowid)
}

fn cell_size(e: &Engine, cell: usize, t: u8) -> usize {
    let (size, off, local, _) = cell_info(e, cell, t)
    if t == 5 {
        return off
    }
    n := off + local
    if (local as u64) < size {
        n += 4
    }
    n
}

// ---------------------------------------------------------------------------
// Payload access

// Copies the full payload of `cell` (page data offset) into the arena.
// The cell's page may be evicted while overflow pages are read, so the
// local part is copied first.
fn load_payload(e: &mut Engine, cell: usize, t: u8) -> (usize, usize)!db.Error {
    let (size, off, local, _) = cell_info(e, cell, t)
    if size > 1000000000u64 {
        return err(corrupt(e))
    }
    total := size as usize
    dst := arena_alloc(e, total)?
    move_bytes(e.ws, cell + off, dst, local)
    if local < total {
        next := rd32(e.ws, cell + off + local)
        done := local
        chunk := e.usable - 4
        guard := 0usize
        for done < total {
            if next == 0 || next > e.db_pages {
                return err(corrupt(e))
            }
            d := pg_fetch(e, next)?
            n := if total - done < chunk {
                total - done
            } else {
                chunk
            }
            move_bytes(e.ws, d + 4, dst + done, n)
            done += n
            next = rd32(e.ws, d)
            guard += 1
            if guard > 1000000 {
                return err(corrupt(e))
            }
        }
    }
    ok((dst, total))
}

// Payload of the entry under cursor `c`, cached in the arena.
fn cur_payload(e: &mut Engine, c: usize) -> (usize, usize)!db.Error {
    o := cur(e, c)
    if e.ws[o + C_PAYVALID] != 0 {
        return ok((ldu(e.ws, o + C_PAYOFF), ldu(e.ws, o + C_PAYLEN)))
    }
    if e.ws[o + C_STATE] != ST_VALID {
        return err(fail(e, SQLITE_INTERNAL, "cursor is not positioned"))
    }
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    idx := path_idx(e, c, level)
    d := pg_fetch(e, pg)?
    ho := hoff(pg)
    t := e.ws[d + ho]
    if idx >= pg_ncells(e, d, ho) {
        return err(corrupt(e))
    }
    cell := cell_at(e, d, ho, t, idx)
    let (p, n) = load_payload(e, cell, t)?
    o2 := cur(e, c)
    stu(e.ws, o2 + C_PAYOFF, p)
    stu(e.ws, o2 + C_PAYLEN, n)
    e.ws[o2 + C_PAYVALID] = 1
    ok((p, n))
}

// ---------------------------------------------------------------------------
// Navigation

fn page_type(e: &mut Engine, pgno: u32) -> u8!db.Error {
    d := pg_fetch(e, pgno)?
    t := e.ws[d + hoff(pgno)]
    if t != 2 && t != 5 && t != 10 && t != 13 {
        return err(corrupt(e))
    }
    ok(t)
}

fn cur_root(e: &mut Engine, c: usize) {
    root := ld32(e.ws, cur(e, c) + C_ROOT)
    set_path(e, c, 0, root, 0)
    set_depth(e, c, 1)
    set_state(e, c, ST_INVALID)
}

fn push(e: &mut Engine, c: usize, pgno: u32, idx: usize) -> void!db.Error {
    dp := depth(e, c)
    if dp >= MAX_DEPTH {
        return err(corrupt(e))
    }
    set_path(e, c, dp, pgno, idx)
    set_depth(e, c, dp + 1)
    ok()
}

fn load_rowid(e: &mut Engine, c: usize) -> void!db.Error {
    if cur_is_index(e, c) {
        return ok()
    }
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    d := pg_fetch(e, pg)?
    ho := hoff(pg)
    t := e.ws[d + ho]
    let index = path_idx(e, c, level)
    cell := cell_at(e, d, ho, t, index)
    let (_, _, _, rowid) = cell_info(e, cell, t)
    let cursor = cur(e, c) + C_ROWID
    st64(e.ws, cursor, i2u(rowid))
    ok()
}

// Descends from the current top (an interior page with its index set) to
// the leftmost leaf below the selected child.
fn descend_left(e: &mut Engine, c: usize) -> void!db.Error {
    for {
        level := depth(e, c) - 1
        pg := path_pg(e, c, level)
        t := page_type(e, pg)?
        if is_leaf(t) {
            set_idx(e, c, level, 0)
            return ok()
        }
        d := pg_fetch(e, pg)?
        let index = path_idx(e, c, level)
        child := child_at(e, d, hoff(pg), t, index)
        push(e, c, child, 0)?
    }
}

fn top_count(e: &mut Engine, c: usize) -> (u8, usize)!db.Error {
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    t := page_type(e, pg)?
    d := pg_fetch(e, pg)?
    ok((t, pg_ncells(e, d, hoff(pg))))
}

fn cur_first(e: &mut Engine, c: usize) -> bool!db.Error {
    cur_root(e, c)
    descend_left(e, c)?
    let (_, n) = top_count(e, c)?
    if n == 0 {
        set_state(e, c, ST_EOF)
        return ok(false)
    }
    set_state(e, c, ST_VALID)
    load_rowid(e, c)?
    ok(true)
}

fn cur_last(e: &mut Engine, c: usize) -> bool!db.Error {
    cur_root(e, c)
    root := path_pg(e, c, 0)
    t := page_type(e, root)?
    d := pg_fetch(e, root)?
    n := pg_ncells(e, d, hoff(root))
    if is_leaf(t) {
        if n == 0 {
            set_state(e, c, ST_EOF)
            return ok(false)
        }
        set_idx(e, c, 0, n - 1)
    } else {
        set_idx(e, c, 0, n)
        child := child_at(e, d, hoff(root), t, n)
        push(e, c, child, 0)?
        descend_right_from_top(e, c)?
    }
    let (_, cnt) = top_count(e, c)?
    if cnt == 0 {
        set_state(e, c, ST_EOF)
        return ok(false)
    }
    set_state(e, c, ST_VALID)
    load_rowid(e, c)?
    ok(true)
}

// The top page is newly pushed; walk right-most children down to a leaf.
fn descend_right_from_top(e: &mut Engine, c: usize) -> void!db.Error {
    for {
        level := depth(e, c) - 1
        pg := path_pg(e, c, level)
        t := page_type(e, pg)?
        d := pg_fetch(e, pg)?
        n := pg_ncells(e, d, hoff(pg))
        if is_leaf(t) {
            set_idx(e, c, level, if n == 0 {
                0usize
            } else {
                n - 1
            })
            return ok()
        }
        set_idx(e, c, level, n)
        child := child_at(e, d, hoff(pg), t, n)
        push(e, c, child, 0)?
    }
}

// Climbs after the top leaf is exhausted; positions on the next entry.
fn climb_next(e: &mut Engine, c: usize) -> bool!db.Error {
    index := cur_is_index(e, c)
    for {
        dp := depth(e, c)
        if dp <= 1 {
            set_state(e, c, ST_EOF)
            return ok(false)
        }
        set_depth(e, c, dp - 1)
        level := dp - 2
        pg := path_pg(e, c, level)
        d := pg_fetch(e, pg)?
        n := pg_ncells(e, d, hoff(pg))
        pidx := path_idx(e, c, level)
        if pidx < n {
            if index {
                set_state(e, c, ST_VALID)
                return ok(true)
            }
            set_idx(e, c, level, pidx + 1)
            t := e.ws[d + hoff(pg)]
            child := child_at(e, d, hoff(pg), t, pidx + 1)
            push(e, c, child, 0)?
            descend_left(e, c)?
            let (_, cnt) = top_count(e, c)?
            if cnt > 0 {
                set_state(e, c, ST_VALID)
                load_rowid(e, c)?
                return ok(true)
            }
        }
    }
}

fn cur_next(e: &mut Engine, c: usize) -> bool!db.Error {
    o := cur(e, c)
    if e.ws[o + C_STATE] != ST_VALID {
        return ok(false)
    }
    e.ws[o + C_PAYVALID] = 0
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    t := page_type(e, pg)?
    if !is_leaf(t) {
        // Index interior entry k: continue with child k + 1.
        k := path_idx(e, c, level)
        set_idx(e, c, level, k + 1)
        d := pg_fetch(e, pg)?
        child := child_at(e, d, hoff(pg), t, k + 1)
        push(e, c, child, 0)?
        descend_left(e, c)?
        set_state(e, c, ST_VALID)
        return ok(true)
    }
    d := pg_fetch(e, pg)?
    n := pg_ncells(e, d, hoff(pg))
    idx := path_idx(e, c, level) + 1
    if idx < n {
        set_idx(e, c, level, idx)
        load_rowid(e, c)?
        return ok(true)
    }
    climb_next(e, c)
}

fn cur_prev(e: &mut Engine, c: usize) -> bool!db.Error {
    o := cur(e, c)
    if e.ws[o + C_STATE] != ST_VALID {
        return ok(false)
    }
    e.ws[o + C_PAYVALID] = 0
    index := cur_is_index(e, c)
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    t := page_type(e, pg)?
    if !is_leaf(t) {
        // Index interior entry k: the predecessor is the last entry of child k.
        k := path_idx(e, c, level)
        d := pg_fetch(e, pg)?
        child := child_at(e, d, hoff(pg), t, k)
        push(e, c, child, 0)?
        descend_right_from_top(e, c)?
        set_state(e, c, ST_VALID)
        return ok(true)
    }
    idx := path_idx(e, c, level)
    if idx > 0 {
        set_idx(e, c, level, idx - 1)
        load_rowid(e, c)?
        return ok(true)
    }
    for {
        dp := depth(e, c)
        if dp <= 1 {
            set_state(e, c, ST_EOF)
            return ok(false)
        }
        set_depth(e, c, dp - 1)
        lv := dp - 2
        ppg := path_pg(e, c, lv)
        pidx := path_idx(e, c, lv)
        if pidx > 0 {
            if index {
                set_idx(e, c, lv, pidx - 1)
                set_state(e, c, ST_VALID)
                return ok(true)
            }
            set_idx(e, c, lv, pidx - 1)
            pd := pg_fetch(e, ppg)?
            pt := e.ws[pd + hoff(ppg)]
            child := child_at(e, pd, hoff(ppg), pt, pidx - 1)
            push(e, c, child, 0)?
            descend_right_from_top(e, c)?
            let (_, cnt) = top_count(e, c)?
            if cnt > 0 {
                set_state(e, c, ST_VALID)
                load_rowid(e, c)?
                return ok(true)
            }
        }
    }
}

// Positions on `rowid`. Returns true when found; otherwise the top leaf
// index is the insertion point.
fn seek_rowid(e: &mut Engine, c: usize, rowid: i64) -> bool!db.Error {
    cur_root(e, c)
    for {
        level := depth(e, c) - 1
        pg := path_pg(e, c, level)
        t := page_type(e, pg)?
        d := pg_fetch(e, pg)?
        ho := hoff(pg)
        n := pg_ncells(e, d, ho)
        lo := 0usize
        hi := n
        for lo < hi {
            mid := (lo + hi) / 2
            let cell = cell_at(e, d, ho, t, mid)
            let (_, _, _, key) = cell_info(e, cell, t)
            if key < rowid {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        if t == 5 {
            set_idx(e, c, level, lo)
            child := child_at(e, d, ho, t, lo)
            push(e, c, child, 0)?
            continue
        }
        if t != 13 {
            return err(corrupt(e))
        }
        set_idx(e, c, level, lo)
        if lo < n {
            let cell2 = cell_at(e, d, ho, t, lo)
            let (_, _, _, key) = cell_info(e, cell2, t)
            if key == rowid {
                set_state(e, c, ST_VALID)
                let cursor = cur(e, c) + C_ROWID
                st64(e.ws, cursor, i2u(rowid))
                return ok(true)
            }
        }
        set_state(e, c, ST_INVALID)
        return ok(false)
    }
}

// After a failed seek, moves to the first entry after the insertion point.
fn settle_forward(e: &mut Engine, c: usize) -> bool!db.Error {
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    d := pg_fetch(e, pg)?
    n := pg_ncells(e, d, hoff(pg))
    if path_idx(e, c, level) < n {
        set_state(e, c, ST_VALID)
        load_rowid(e, c)?
        return ok(true)
    }
    set_state(e, c, ST_VALID)
    climb_next(e, c)
}

// Compares the payload of a cell with key registers. Overflowing payloads
// are assembled in the arena temporarily.
fn cell_compare(e: &mut Engine, pg: u32, idx: usize, key: usize, nkey: usize, info: usize) -> i32!db.Error {
    d := pg_fetch(e, pg)?
    ho := hoff(pg)
    t := e.ws[d + ho]
    cell := cell_at(e, d, ho, t, idx)
    let (size, off, local, _) = cell_info(e, cell, t)
    if (local as u64) == size {
        return record_compare(e, cell + off, local, key, nkey, info)
    }
    mark := e.arena_top
    let (p, n) = load_payload(e, cell, t)?
    r := record_compare(e, p, n, key, nkey, info)?
    arena_reset(e, mark)
    ok(r)
}

// Positions an index cursor on the first entry >= key (nkey fields).
// Returns 0 when that entry's prefix equals the key, nonzero otherwise
// (also when no such entry exists, with the cursor at EOF).
fn seek_index(e: &mut Engine, c: usize, key: usize, nkey: usize) -> i32!db.Error {
    info := cur(e, c) + C_INFO
    cur_root(e, c)
    for {
        level := depth(e, c) - 1
        pg := path_pg(e, c, level)
        t := page_type(e, pg)?
        d := pg_fetch(e, pg)?
        n := pg_ncells(e, d, hoff(pg))
        lo := 0usize
        hi := n
        for lo < hi {
            mid := (lo + hi) / 2
            if cell_compare(e, pg, mid, key, nkey, info)? < 0 {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        set_idx(e, c, level, lo)
        if t == 2 {
            d2 := pg_fetch(e, pg)?
            child := child_at(e, d2, hoff(pg), t, lo)
            push(e, c, child, 0)?
            continue
        }
        if t != 10 {
            return err(corrupt(e))
        }
        if !settle_forward(e, c)? {
            return ok(1)
        }
        lv := depth(e, c) - 1
        let pgno = path_pg(e, c, lv)
        let index = path_idx(e, c, lv)
        return cell_compare(e, pgno, index, key, nkey, info)
    }
}

// Descends to the leaf position where key would be inserted.
fn seek_index_leaf(e: &mut Engine, c: usize, key: usize, nkey: usize) -> void!db.Error {
    info := cur(e, c) + C_INFO
    cur_root(e, c)
    for {
        level := depth(e, c) - 1
        pg := path_pg(e, c, level)
        t := page_type(e, pg)?
        d := pg_fetch(e, pg)?
        n := pg_ncells(e, d, hoff(pg))
        lo := 0usize
        hi := n
        for lo < hi {
            mid := (lo + hi) / 2
            if cell_compare(e, pg, mid, key, nkey, info)? < 0 {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        set_idx(e, c, level, lo)
        if t == 2 {
            d2 := pg_fetch(e, pg)?
            child := child_at(e, d2, hoff(pg), t, lo)
            push(e, c, child, 0)?
            continue
        }
        set_state(e, c, ST_INVALID)
        return ok()
    }
}

// ---------------------------------------------------------------------------
// Page construction

fn page_init(e: &mut Engine, pgno: u32, t: u8) -> void!db.Error {
    d := pg_write(e, pgno)?
    ho := hoff(pgno)
    let usable2 = e.usable - ho
    zero_bytes(e.ws, d + ho, usable2)
    e.ws[d + ho] = t
    content := e.usable
    wr16(e.ws, d + ho + 5, if content == 65536 {
        0usize
    } else {
        content
    })
    ok()
}

fn content_start(e: &Engine, d: usize, ho: usize) -> usize {
    v := rd16(e.ws, d + ho + 5)
    if v == 0 {
        65536
    } else {
        v
    }
}

fn page_free(e: &Engine, d: usize, ho: usize) -> usize {
    t := e.ws[d + ho]
    n := pg_ncells(e, d, ho)
    top := ho + hdr_size(t) + 2 * n
    cs := content_start(e, d, ho)
    free := if cs > top {
        cs - top
    } else {
        0
    }
    fb := rd16(e.ws, d + ho + 1)
    guard := 0usize
    for fb != 0 && fb + 4 <= e.usable && guard < 10000 {
        free += rd16(e.ws, d + fb + 2)
        fb = rd16(e.ws, d + fb)
        guard += 1
    }
    free + (e.ws[d + ho + 7] as usize)
}

// Rewrites a page with its cells packed at the end (no freeblocks).
fn defragment(e: &mut Engine, pgno: u32) -> void!db.Error {
    d := pg_write(e, pgno)?
    ho := hoff(pgno)
    t := e.ws[d + ho]
    n := pg_ncells(e, d, ho)
    sp := e.scratch_page
    let page_size2 = e.page_size
    move_bytes(e.ws, d, sp, page_size2)
    content := e.usable
    hs := hdr_size(t)
    for i in 0usize..n {
        cell := sp + rd16(e.ws, sp + ho + hs + 2 * i)
        sz := cell_size(e, cell, t)
        alloc := if sz < 4 {
            4usize
        } else {
            sz
        }
        content -= alloc
        move_bytes(e.ws, cell, d + content, sz)
        wr16(e.ws, d + ho + hs + 2 * i, content)
    }
    top := ho + hs + 2 * n
    zero_bytes(e.ws, d + top, content - top)
    wr16(e.ws, d + ho + 1, 0)
    wr16(e.ws, d + ho + 5, if content == 65536 {
        0usize
    } else {
        content
    })
    e.ws[d + ho + 7] = 0
    ok()
}

// Inserts a cell at index `idx` if it fits; returns false otherwise.
fn cell_insert(e: &mut Engine, pgno: u32, idx: usize, cell: usize, size: usize) -> bool!db.Error {
    d := pg_fetch(e, pgno)?
    ho := hoff(pgno)
    alloc := if size < 4 {
        4usize
    } else {
        size
    }
    if page_free(e, d, ho) < alloc + 2 {
        return ok(false)
    }
    d2 := pg_write(e, pgno)?
    t := e.ws[d2 + ho]
    n := pg_ncells(e, d2, ho)
    hs := hdr_size(t)
    top := ho + hs + 2 * n
    cs := content_start(e, d2, ho)
    if cs < top + alloc + 2 {
        defragment(e, pgno)?
    }
    d3 := pg_fetch(e, pgno)?
    cs2 := content_start(e, d3, ho)
    at := cs2 - alloc
    move_bytes(e.ws, cell, d3 + at, size)
    if size < alloc {
        zero_bytes(e.ws, d3 + at + size, alloc - size)
    }
    ptrs := d3 + ho + hs
    move_bytes(e.ws, ptrs + 2 * idx, ptrs + 2 * idx + 2, 2 * (n - idx))
    wr16(e.ws, ptrs + 2 * idx, at)
    wr16(e.ws, d3 + ho + 3, n + 1)
    wr16(e.ws, d3 + ho + 5, at)
    ok(true)
}

// Removes cell `idx` and repacks the page.
fn cell_remove(e: &mut Engine, pgno: u32, idx: usize) -> void!db.Error {
    d := pg_write(e, pgno)?
    ho := hoff(pgno)
    t := e.ws[d + ho]
    n := pg_ncells(e, d, ho)
    hs := hdr_size(t)
    ptrs := d + ho + hs
    move_bytes(e.ws, ptrs + 2 * idx + 2, ptrs + 2 * idx, 2 * (n - idx - 1))
    wr16(e.ws, d + ho + 3, n - 1)
    defragment(e, pgno)
}

fn free_overflow(e: &mut Engine, cell: usize, t: u8) -> void!db.Error {
    let (size, off, local, _) = cell_info(e, cell, t)
    if (local as u64) >= size {
        return ok()
    }
    next := rd32(e.ws, cell + off + local)
    guard := 0usize
    for next != 0 {
        if next > e.db_pages || guard > 1000000 {
            return err(corrupt(e))
        }
        d := pg_fetch(e, next)?
        after := rd32(e.ws, d)
        free_page(e, next)?
        next = after
        guard += 1
    }
    ok()
}

// Builds a cell for a payload at `rec` into `dst`, writing overflow pages
// as needed. Returns the cell size.
fn build_cell(e: &mut Engine, t: u8, rowid: i64, rec: usize, size: usize, dst: usize) -> usize!db.Error {
    p := dst
    if t == 2 {
        p += 4
    }
    p += put_varint(e.ws, p, size as u64)
    if t == 13 {
        p += put_varint(e.ws, p, i2u(rowid))
    }
    local := local_size(e, size as u64, t == 13)
    move_bytes(e.ws, rec, p, local)
    p += local
    if local < size {
        first := 0u32
        prev := 0u32
        done := local
        chunk := e.usable - 4
        for done < size {
            pg := alloc_page(e)?
            if prev == 0 {
                first = pg
            } else {
                pd := pg_write(e, prev)?
                wr32(e.ws, pd, pg)
            }
            n := if size - done < chunk {
                size - done
            } else {
                chunk
            }
            d := pg_write(e, pg)?
            wr32(e.ws, d, 0)
            move_bytes(e.ws, rec + done, d + 4, n)
            done += n
            prev = pg
        }
        wr32(e.ws, p, first)
        p += 4
    }
    ok(p - dst)
}

// ---------------------------------------------------------------------------
// Gather buffers

fn g_entry_cap(e: &Engine) -> usize {
    (7 * e.page_size - G_ENTRIES) / 8
}

fn g_data(e: &Engine, g: usize) -> usize {
    g + 7 * e.page_size
}

fn g_reset(e: &mut Engine, g: usize, t: u8, right: u32) {
    stu(e.ws, g + G_N, 0)
    stu(e.ws, g + G_USED, 0)
    st32(e.ws, g + G_RIGHT, right)
    e.ws[g + G_TYPE] = t
}

fn g_n(e: &Engine, g: usize) -> usize {
    ldu(e.ws, g + G_N)
}

fn g_off(e: &Engine, g: usize, i: usize) -> usize {
    ldu(e.ws, g + G_ENTRIES + i * 8)
}

fn g_size(e: &Engine, g: usize, i: usize) -> usize {
    ldu(e.ws, g + G_ENTRIES + i * 8 + 4)
}

// Appends a cell. `skip` bytes are dropped from the front of the source;
// a nonzero `ptr` is written as a 4-byte child pointer before the rest.
fn g_push(e: &mut Engine, g: usize, src: usize, size: usize, skip: usize, with_ptr: bool, ptr: u32) -> usize!db.Error {
    n := g_n(e, g)
    used := ldu(e.ws, g + G_USED)
    total := size - skip + if with_ptr {
        4usize
    } else {
        0usize
    }
    if n >= g_entry_cap(e) || used + total > 6 * e.page_size {
        return err(corrupt(e))
    }
    dst := g_data(e, g) + used
    p := dst
    if with_ptr {
        wr32(e.ws, p, ptr)
        p += 4
    }
    move_bytes(e.ws, src + skip, p, size - skip)
    stu(e.ws, g + G_ENTRIES + n * 8, dst)
    stu(e.ws, g + G_ENTRIES + n * 8 + 4, total)
    stu(e.ws, g + G_N, n + 1)
    stu(e.ws, g + G_USED, used + total)
    ok(dst)
}

// Copies all cells of `pgno` into the gather buffer.
fn g_push_page(e: &mut Engine, g: usize, pgno: u32) -> void!db.Error {
    d := pg_fetch(e, pgno)?
    ho := hoff(pgno)
    t := e.ws[d + ho]
    n := pg_ncells(e, d, ho)
    for i in 0usize..n {
        d2 := pg_fetch(e, pgno)?
        cell := cell_at(e, d2, ho, t, i)
        sz := cell_size(e, cell, t)
        g_push(e, g, cell, sz, 0, false, 0)?
    }
    ok()
}

fn g_bytes(e: &Engine, g: usize, s: usize, n: usize) -> usize {
    total := 0usize
    for i in s..n {
        sz := g_size(e, g, i)
        total += (if sz < 4 {
            4usize
        } else {
            sz
        }) + 2
    }
    total
}

fn g_fits(e: &Engine, g: usize, pgno: u32) -> bool {
    t := e.ws[g + G_TYPE]
    let g_n2 = g_n(e, g)
    g_bytes(e, g, 0, g_n2) + hdr_size(t) + hoff(pgno) <= e.usable
}

fn g_underfull(e: &Engine, g: usize, pgno: u32) -> bool {
    t := e.ws[g + G_TYPE]
    let g_n2 = g_n(e, g)
    used := g_bytes(e, g, 0, g_n2) + hdr_size(t) + hoff(pgno)
    e.usable - used > e.usable * 2 / 3
}

// Writes cells [s, n) of gather buffer `g` into page `pgno` as type `t`.
fn page_build(e: &mut Engine, pgno: u32, t: u8, g: usize, s: usize, n: usize, right: u32) -> void!db.Error {
    d := pg_write(e, pgno)?
    ho := hoff(pgno)
    hs := hdr_size(t)
    count := n - s
    content := e.usable
    for i in s..n {
        sz := g_size(e, g, i)
        alloc := if sz < 4 {
            4usize
        } else {
            sz
        }
        if content < alloc || content - alloc < ho + hs + 2 * count {
            return err(corrupt(e))
        }
        content -= alloc
        let cell = g_off(e, g, i)
        move_bytes(e.ws, cell, d + content, sz)
        if sz < alloc {
            zero_bytes(e.ws, d + content + sz, alloc - sz)
        }
        wr16(e.ws, d + ho + hs + 2 * (i - s), content)
    }
    top := ho + hs + 2 * count
    zero_bytes(e.ws, d + top, content - top)
    e.ws[d + ho] = t
    wr16(e.ws, d + ho + 1, 0)
    wr16(e.ws, d + ho + 3, count)
    wr16(e.ws, d + ho + 5, if content == 65536 {
        0usize
    } else {
        content
    })
    e.ws[d + ho + 7] = 0
    if !is_leaf(t) {
        wr32(e.ws, d + ho + 8, right)
    }
    ok()
}

// ---------------------------------------------------------------------------
// Balancing
//
// rebalance(level) takes the node at `level` of cursor c's path, whose
// content is the virtual cell list in gather buffer B (it may not fit in a
// page or may be underfull), and redistributes it together with up to two
// siblings. The parent's new content is left in B and balanced in turn.

fn interior_of(t: u8) -> u8 {
    if t == 13 {
        return 5
    }
    if t == 10 {
        return 2
    }
    t
}

fn rebalance(e: &mut Engine, c: usize, level: usize) -> void!db.Error {
    gb := e.gather_b
    ga := e.gather_a
    lv := level
    for {
        if lv == 0 {
            return balance_root(e, c)
        }
        node := path_pg(e, c, lv)
        t := e.ws[gb + G_TYPE]
        parent := path_pg(e, c, lv - 1)
        pidx := path_idx(e, c, lv - 1)
        pd := pg_fetch(e, parent)?
        pho := hoff(parent)
        pt := e.ws[pd + pho]
        pn := pg_ncells(e, pd, pho)
        nchild := pn + 1
        first := 0usize
        cnt := nchild
        if nchild > 3 {
            cnt = 3
            first = if pidx == 0 {
                0usize
            } else {
                pidx - 1
            }
            if first + 3 > nchild {
                first = nchild - 3
            }
        }
        old := [0u32; 3]
        g_reset(e, ga, t, 0)
        final_right := 0u32
        for j in first..first + cnt {
            pd2 := pg_fetch(e, parent)?
            chpg := child_at(e, pd2, pho, pt, j)
            old[j - first] = chpg
            right_j := 0u32
            if j == pidx {
                if chpg != node {
                    return err(corrupt(e))
                }
                bn := g_n(e, gb)
                for i in 0usize..bn {
                    let cell2 = g_off(e, gb, i)
                    let size = g_size(e, gb, i)
                    g_push(e, ga, cell2, size, 0, false, 0)?
                }
                right_j = ld32(e.ws, gb + G_RIGHT)
            } else {
                ct := page_type(e, chpg)?
                if ct != t {
                    return err(corrupt(e))
                }
                g_push_page(e, ga, chpg)?
                if !is_leaf(t) {
                    cd := pg_fetch(e, chpg)?
                    right_j = rd32(e.ws, cd + 8)
                }
            }
            if j < first + cnt - 1 {
                pd3 := pg_fetch(e, parent)?
                sep := cell_at(e, pd3, pho, pt, j)
                ssz := cell_size(e, sep, pt)
                if t == 5 {
                    g_push(e, ga, sep, ssz, 4, true, right_j)?
                } else if t == 10 {
                    g_push(e, ga, sep, ssz, 4, false, 0)?
                } else if t == 2 {
                    g_push(e, ga, sep, ssz, 4, true, right_j)?
                }
            } else {
                final_right = right_j
            }
        }
        // Distribute cells over pages.
        n := g_n(e, ga)
        consuming := t != 13
        cap := e.usable - hdr_size(t)
        starts := [0usize; 8]
        ends := [0usize; 8]
        m := 0usize
        i := 0usize
        starts[0] = 0
        fill := 0usize
        for i < n {
            sz := g_size(e, ga, i)
            need := (if sz < 4 {
                4usize
            } else {
                sz
            }) + 2
            if fill + need > cap && i > starts[m] {
                ends[m] = i
                m += 1
                if m >= 7 {
                    return err(corrupt(e))
                }
                if consuming {
                    starts[m] = i + 1
                    i += 1
                    fill = 0
                } else {
                    starts[m] = i
                    fill = need
                    i += 1
                }
                continue
            }
            fill += need
            i += 1
        }
        ends[m] = n
        m += 1
        if consuming && m > 1 && starts[m - 1] >= ends[m - 1] {
            // The divider was the last cell: borrow one from the left page.
            k := m - 2
            if ends[k] - starts[k] < 2 {
                return err(corrupt(e))
            }
            ends[k] -= 1
            starts[m - 1] = ends[k] + 1
            ends[m - 1] = n
        }
        // Even out the last two pages so the right one is not nearly empty,
        // except when appending at the right edge of the tree (sequential
        // inserts then leave full pages behind, like SQLite's quick balance).
        if m > 1 && !e.bal_append {
            k := m - 2
            left := g_bytes(e, ga, starts[k], ends[k])
            right := g_bytes(e, ga, starts[k + 1], ends[k + 1])
            for ends[k] - starts[k] > 1 {
                // Move the last cell of the left page right. With dividers,
                // the old divider joins the right page and the left page's
                // last cell becomes the divider.
                lsz := g_bytes(e, ga, ends[k] - 1, ends[k])
                gain := if consuming {
                    g_bytes(e, ga, ends[k], ends[k] + 1)
                } else {
                    lsz
                }
                if right + gain > cap || (consuming && left - lsz <= right + gain) || (!consuming && left - lsz < right + gain) {
                    break
                }
                left -= lsz
                right += gain
                ends[k] -= 1
                starts[k + 1] -= 1
            }
        }
        // Assign pages.
        pages := [0u32; 8]
        for j in 0usize..m {
            if j < cnt {
                pages[j] = old[j]
            } else {
                pages[j] = alloc_page(e)?
            }
        }
        for j in m..cnt {
            free_page(e, old[j])?
        }
        for j in 0usize..m {
            right := 0u32
            if !is_leaf(t) {
                if j < m - 1 {
                    right = rd32(e.ws, g_off(e, ga, ends[j]))
                } else {
                    right = final_right
                }
            }
            page_build(e, pages[j], t, ga, starts[j], ends[j], right)?
        }
        // New parent content in B.
        pd4 := pg_fetch(e, parent)?
        let value = rd32(e.ws, pd4 + pho + 8)
        g_reset(e, gb, pt, value)
        for k in 0usize..first {
            pd5 := pg_fetch(e, parent)?
            cell := cell_at(e, pd5, pho, pt, k)
            let size2 = cell_size(e, cell, pt)
            g_push(e, gb, cell, size2, 0, false, 0)?
        }
        for j in 0usize..m - 1 {
            if t == 13 {
                // Divider key: the largest rowid on the left page.
                last := g_off(e, ga, ends[j] - 1)
                let (_, _, _, rowid) = cell_info(e, last, 13)
                tmp := e.scratch_page
                wr32(e.ws, tmp, pages[j])
                kn := put_varint(e.ws, tmp + 4, i2u(rowid))
                g_push(e, gb, tmp, 4 + kn, 0, false, 0)?
            } else if t == 10 {
                dv := ends[j]
                let cell3 = g_off(e, ga, dv)
                let size3 = g_size(e, ga, dv)
                g_push(e, gb, cell3, size3, 0, true, pages[j])?
            } else {
                dv := ends[j]
                let cell4 = g_off(e, ga, dv)
                let size4 = g_size(e, ga, dv)
                g_push(e, gb, cell4, size4, 4, true, pages[j])?
            }
        }
        last_child := first + cnt - 1
        for k in last_child..pn {
            pd6 := pg_fetch(e, parent)?
            cell := cell_at(e, pd6, pho, pt, k)
            if k == last_child {
                let size5 = cell_size(e, cell, pt)
                g_push(e, gb, cell, size5, 4, true, pages[m - 1])?
            } else {
                let size6 = cell_size(e, cell, pt)
                g_push(e, gb, cell, size6, 0, false, 0)?
            }
        }
        if last_child == pn {
            st32(e.ws, gb + G_RIGHT, pages[m - 1])
        }
        lv -= 1
        if lv == 0 {
            if g_fits(e, gb, parent) && g_n(e, gb) > 0 {
                let g_n2 = g_n(e, gb)
                let ld322 = ld32(e.ws, gb + G_RIGHT)
                return page_build(e, parent, pt, gb, 0, g_n2, ld322)
            }
            continue
        }
        if g_fits(e, gb, parent) && !g_underfull(e, gb, parent) {
            let g_n3 = g_n(e, gb)
            let ld323 = ld32(e.ws, gb + G_RIGHT)
            return page_build(e, parent, pt, gb, 0, g_n3, ld323)
        }
    }
}

// Root with virtual content in B: write it, deepen the tree, or (when an
// interior root lost its last divider) pull its only child up.
fn balance_root(e: &mut Engine, c: usize) -> void!db.Error {
    gb := e.gather_b
    ga := e.gather_a
    root := path_pg(e, c, 0)
    t := e.ws[gb + G_TYPE]
    n := g_n(e, gb)
    if n == 0 && !is_leaf(t) {
        child := ld32(e.ws, gb + G_RIGHT)
        ct := page_type(e, child)?
        g_reset(e, ga, ct, 0)
        g_push_page(e, ga, child)?
        if !is_leaf(ct) {
            cd := pg_fetch(e, child)?
            let value = rd32(e.ws, cd + 8)
            st32(e.ws, ga + G_RIGHT, value)
        }
        if g_fits(e, ga, root) {
            let g_n2 = g_n(e, ga)
            let ld322 = ld32(e.ws, ga + G_RIGHT)
            page_build(e, root, ct, ga, 0, g_n2, ld322)?
            free_page(e, child)?
            return ok()
        }
        return page_build(e, root, t, gb, 0, 0, child)
    }
    if g_fits(e, gb, root) {
        let ld323 = ld32(e.ws, gb + G_RIGHT)
        return page_build(e, root, t, gb, 0, n, ld323)
    }
    // Deeper: the root's content moves to a new child.
    child := alloc_page(e)?
    page_build(e, root, interior_of(t), ga, 0, 0, child)?
    set_path(e, c, 0, root, 0)
    set_path(e, c, 1, child, 0)
    set_depth(e, c, 2)
    rebalance(e, c, 1)
}

// ---------------------------------------------------------------------------
// Insert and delete

// Inserts a prepared cell at the cursor's leaf position.
fn insert_cell_at_cursor(e: &mut Engine, c: usize, cell: usize, size: usize) -> void!db.Error {
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    idx := path_idx(e, c, level)
    if cell_insert(e, pg, idx, cell, size)? {
        set_state(e, c, ST_INVALID)
        return ok()
    }
    // Overflow: gather the page's cells plus the new one and rebalance.
    // Appending past the last cell of the tree's right edge?
    append := true
    for lv in 0usize..level + 1 {
        lpg := path_pg(e, c, lv)
        ld := pg_fetch(e, lpg)?
        if path_idx(e, c, lv) < pg_ncells(e, ld, hoff(lpg)) {
            append = false
        }
    }
    e.bal_append = append
    gb := e.gather_b
    d := pg_fetch(e, pg)?
    ho := hoff(pg)
    t := e.ws[d + ho]
    right := if is_leaf(t) {
        0u32
    } else {
        rd32(e.ws, d + ho + 8)
    }
    g_reset(e, gb, t, right)
    n := pg_ncells(e, d, ho)
    for i in 0usize..n {
        if i == idx {
            g_push(e, gb, cell, size, 0, false, 0)?
        }
        d2 := pg_fetch(e, pg)?
        cc := cell_at(e, d2, ho, t, i)
        let size2 = cell_size(e, cc, t)
        g_push(e, gb, cc, size2, 0, false, 0)?
    }
    if idx >= n {
        g_push(e, gb, cell, size, 0, false, 0)?
    }
    res := rebalance(e, c, level)
    e.bal_append = false
    res?
    set_state(e, c, ST_INVALID)
    ok()
}

fn table_insert(e: &mut Engine, c: usize, rowid: i64, rec: usize, len: usize) -> void!db.Error {
    if seek_rowid(e, c, rowid)? {
        cur_delete(e, c)?
        seek_rowid(e, c, rowid)?
    }
    let cell_buf2 = e.cell_buf
    size := build_cell(e, 13, rowid, rec, len, cell_buf2)?
    let cell_buf3 = e.cell_buf
    insert_cell_at_cursor(e, c, cell_buf3, size)
}

// Inserts an index record (key fields followed by the rowid). The record's
// fields are decoded into the btree key registers for positioning.
fn index_insert(e: &mut Engine, c: usize, rec: usize, len: usize) -> void!db.Error {
    nkey := record_to_regs(e, rec, len, R_BTKEY)?
    seek_index_leaf(e, c, R_BTKEY, nkey)?
    let cell_buf2 = e.cell_buf
    size := build_cell(e, 10, 0, rec, len, cell_buf2)?
    let cell_buf3 = e.cell_buf
    insert_cell_at_cursor(e, c, cell_buf3, size)
}

// Decodes every field of a record into registers starting at `first`.
fn record_to_regs(e: &mut Engine, rec: usize, len: usize, first: usize) -> usize!db.Error {
    let (hsize, hn) = get_varint(e.ws, rec)
    hs := hsize as usize
    if hs > len {
        return err(corrupt(e))
    }
    p := rec + hn
    body := rec + hs
    i := 0usize
    for p < rec + hs {
        let (t, tn) = get_varint(e.ws, p)
        p += tn
        if first + i >= NREGS {
            return err(full(e, "too many key columns"))
        }
        decode_field(e, body, t, first + i)?
        body += serial_len(t)
        i += 1
    }
    ok(i)
}

// Removes the leaf cell under the cursor and rebalances if needed.
fn leaf_delete(e: &mut Engine, c: usize, free_ovfl: bool) -> void!db.Error {
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    idx := path_idx(e, c, level)
    d := pg_fetch(e, pg)?
    ho := hoff(pg)
    t := e.ws[d + ho]
    if free_ovfl {
        let cell = cell_at(e, d, ho, t, idx)
        free_overflow(e, cell, t)?
    }
    cell_remove(e, pg, idx)?
    set_state(e, c, ST_INVALID)
    if level == 0 {
        return ok()
    }
    d2 := pg_fetch(e, pg)?
    n := pg_ncells(e, d2, ho)
    free := page_free(e, d2, ho)
    if n > 0 && free <= e.usable * 2 / 3 {
        return ok()
    }
    gb := e.gather_b
    g_reset(e, gb, t, 0)
    g_push_page(e, gb, pg)?
    rebalance(e, c, level)
}

// Deletes the entry under the cursor. The cursor is invalid afterwards.
fn cur_delete(e: &mut Engine, c: usize) -> void!db.Error {
    level := depth(e, c) - 1
    pg := path_pg(e, c, level)
    t := page_type(e, pg)?
    if is_leaf(t) {
        return leaf_delete(e, c, true)
    }
    // Index interior entry: replace it with its predecessor from a leaf.
    let (tp, tn) = cur_payload(e, c)?
    target_n := record_to_regs(e, tp, tn, R_BTKEY)?
    // Move to the predecessor (the last entry of the left subtree).
    k := path_idx(e, c, level)
    d := pg_fetch(e, pg)?
    child := child_at(e, d, hoff(pg), t, k)
    push(e, c, child, 0)?
    descend_right_from_top(e, c)?
    lv := depth(e, c) - 1
    lpg := path_pg(e, c, lv)
    ld := pg_fetch(e, lpg)?
    lho := hoff(lpg)
    lt := e.ws[ld + lho]
    let index = path_idx(e, c, lv)
    pcell := cell_at(e, ld, lho, lt, index)
    psz := cell_size(e, pcell, lt)
    // Keep the predecessor cell (it keeps its overflow chain).
    pred := e.cell_buf2
    move_bytes(e.ws, pcell, pred, psz)
    set_state(e, c, ST_VALID)
    leaf_delete(e, c, false)?
    // Find the target again; balancing may have moved it.
    if seek_index(e, c, R_BTKEY, target_n)? != 0 {
        return err(corrupt(e))
    }
    lv2 := depth(e, c) - 1
    tpg := path_pg(e, c, lv2)
    tt := page_type(e, tpg)?
    td := pg_fetch(e, tpg)?
    tho := hoff(tpg)
    tidx := path_idx(e, c, lv2)
    tcell := cell_at(e, td, tho, tt, tidx)
    free_overflow(e, tcell, tt)?
    if is_leaf(tt) {
        leaf_delete(e, c, false)?
        // Reinsert the predecessor as an ordinary leaf entry.
        let (pp, pn) = load_payload(e, pred, 10)?
        pk := record_to_regs(e, pp, pn, R_BTKEY)?
        seek_index_leaf(e, c, R_BTKEY, pk)?
        return insert_cell_at_cursor(e, c, pred, psz)
    }
    td2 := pg_fetch(e, tpg)?
    left := rd32(e.ws, cell_at(e, td2, tho, tt, tidx))
    // New interior cell: the target's child pointer + predecessor payload.
    nc := e.cell_buf
    wr32(e.ws, nc, left)
    move_bytes(e.ws, pred, nc + 4, psz)
    cell_remove(e, tpg, tidx)?
    set_idx(e, c, lv2, tidx)
    if cell_insert(e, tpg, tidx, nc, psz + 4)? {
        set_state(e, c, ST_INVALID)
        return ok()
    }
    gb := e.gather_b
    td3 := pg_fetch(e, tpg)?
    let value = rd32(e.ws, td3 + tho + 8)
    g_reset(e, gb, tt, value)
    n := pg_ncells(e, td3, tho)
    for i in 0usize..n {
        if i == tidx {
            g_push(e, gb, nc, psz + 4, 0, false, 0)?
        }
        td4 := pg_fetch(e, tpg)?
        cc := cell_at(e, td4, tho, tt, i)
        let size = cell_size(e, cc, tt)
        g_push(e, gb, cc, size, 0, false, 0)?
    }
    if tidx >= n {
        g_push(e, gb, nc, psz + 4, 0, false, 0)?
    }
    rebalance(e, c, lv2)?
    set_state(e, c, ST_INVALID)
    ok()
}

// ---------------------------------------------------------------------------
// Whole trees

fn btree_create(e: &mut Engine, index: bool) -> u32!db.Error {
    pg := alloc_page(e)?
    page_init(e, pg, if index {
        10
    } else {
        13
    })?
    ok(pg)
}

fn free_subtree(e: &mut Engine, pgno: u32, depth_left: usize) -> void!db.Error {
    if depth_left == 0 || pgno == 0 || pgno > e.db_pages {
        return err(corrupt(e))
    }
    t := page_type(e, pgno)?
    d := pg_fetch(e, pgno)?
    ho := hoff(pgno)
    n := pg_ncells(e, d, ho)
    for i in 0usize..n {
        d2 := pg_fetch(e, pgno)?
        cell := cell_at(e, d2, ho, t, i)
        if t != 5 {
            free_overflow(e, cell, t)?
        }
        if !is_leaf(t) {
            d3 := pg_fetch(e, pgno)?
            child := rd32(e.ws, cell_at(e, d3, ho, t, i))
            free_subtree(e, child, depth_left - 1)?
        }
    }
    if !is_leaf(t) {
        d4 := pg_fetch(e, pgno)?
        right := rd32(e.ws, d4 + ho + 8)
        free_subtree(e, right, depth_left - 1)?
    }
    if pgno != 1 {
        free_page(e, pgno)?
    }
    ok()
}

// Frees every page of the tree except the root, which becomes an empty leaf.
fn btree_clear(e: &mut Engine, root: u32) -> void!db.Error {
    t := page_type(e, root)?
    d := pg_fetch(e, root)?
    ho := hoff(root)
    n := pg_ncells(e, d, ho)
    for i in 0usize..n {
        d2 := pg_fetch(e, root)?
        cell := cell_at(e, d2, ho, t, i)
        if t != 5 {
            free_overflow(e, cell, t)?
        }
        if !is_leaf(t) {
            d3 := pg_fetch(e, root)?
            let value = rd32(e.ws, cell_at(e, d3, ho, t, i))
            free_subtree(e, value, MAX_DEPTH)?
        }
    }
    if !is_leaf(t) {
        d4 := pg_fetch(e, root)?
        let value2 = rd32(e.ws, d4 + ho + 8)
        free_subtree(e, value2, MAX_DEPTH)?
    }
    leaf := if t == 2 || t == 10 {
        10u8
    } else {
        13u8
    }
    page_init(e, root, leaf)
}

fn btree_drop(e: &mut Engine, root: u32) -> void!db.Error {
    btree_clear(e, root)?
    free_page(e, root)
}

// Number of entries in a tree.
fn btree_count(e: &mut Engine, pgno: u32, depth_left: usize) -> u64!db.Error {
    if depth_left == 0 {
        return err(corrupt(e))
    }
    t := page_type(e, pgno)?
    d := pg_fetch(e, pgno)?
    ho := hoff(pgno)
    n := pg_ncells(e, d, ho)
    if is_leaf(t) {
        return ok(n as u64)
    }
    total := if t == 2 {
        n as u64
    } else {
        0u64
    }
    for i in 0usize..n + 1 {
        d2 := pg_fetch(e, pgno)?
        child := child_at(e, d2, ho, t, i)
        total += btree_count(e, child, depth_left - 1)?
    }
    ok(total)
}
