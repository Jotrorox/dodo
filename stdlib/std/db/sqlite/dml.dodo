package sqlite

import "std/db"

// INSERT, UPDATE, DELETE and the constraint checks they share.

// Write-statement info block (statement node field g).
const W_TABLE: usize = 0
const W_CUR: usize = 4
const W_NCOL: usize = 8
const W_BASE: usize = 12
const W_COLMAP: usize = 16
const W_NLIST: usize = 20
const W_DEFAULTS: usize = 24
const W_IDX: usize = 28
const W_NIDX: usize = 32
const W_CHECKS: usize = 36
const W_SEL: usize = 40
const W_SETS: usize = 44
const W_NSET: usize = 48
const W_KEYREG: usize = 52
const W_OLD: usize = 56
const W_CONF: usize = 60
const W_SEQ: usize = 64
const W_SEQCUR: usize = 68
const W_UPSERT: usize = 72
const W_RET: usize = 76
const W_RETREG: usize = 80
const W_NRET: usize = 84
const W_TRIG: usize = 88
const W_NTRIG: usize = 92
const W_TNEW: usize = 96
const W_VIEW: usize = 100
const W_TOLD: usize = 104
// WITHOUT ROWID tables: 3 x npk registers: the identity (PRIMARY KEY) of
// the row being changed, the new row's key, and a conflicting row's key.
const W_PK: usize = 108
const W_BYTES: usize = 112

const ROWID_TARGET: usize = 4294967294

// Index array entry of a write: [0] index object, [4] cursor, [8] key
// expressions bound to the new row (W_BASE), [12] bound to the old row
// (W_OLD). Expression arrays hold one node per index column (0 for plain
// columns) followed by the partial-index WHERE (0 for none); 0 when the
// index has neither.
const IDX_ENTRY: usize = 16

fn wget(e: &Engine, w: usize, f: usize) -> usize {
    ldu(e.ws, w + f)
}

// Parses SQL text (schema pool) as one expression appended to the current
// statement's nodes.
fn parse_fragment_expr(e: &mut Engine, o: usize, l: usize) -> usize!db.Error {
    e.src = o
    e.src_end = o + l
    e.pos = o
    e.ts = o
    e.tl = 0
    e.last_end = o
    next_token(e)
    parse_expr(e)
}

fn parse_fragment_stmt(e: &mut Engine, o: usize, l: usize) -> usize!db.Error {
    e.src = o
    e.src_end = o + l
    e.pos = o
    e.ts = o
    e.tl = 0
    e.last_end = o
    next_token(e)
    parse_statement(e)
}

fn table_for_write(e: &mut Engine, o: usize, l: usize) -> usize!db.Error {
    t := find_obj(e, OT_TABLE, o, l)
    if t == NO_COL {
        if find_obj(e, OT_VIEW, o, l) != NO_COL {
            e.msg_len = 0
            msg_add(e, "cannot modify ")
            msg_add_ws(e, o, l)
            msg_add(e, " because it is a view")
            return err(make_error(e, SQLITE_ERROR))
        }
        if name_is(e, o, l, "sqlite_schema") || name_is(e, o, l, "sqlite_master") {
            return err(fail(e, SQLITE_ERROR, "table sqlite_master may not be modified"))
        }
        e.msg_len = 0
        msg_add(e, "no such table: ")
        msg_add_ws(e, o, l)
        return err(make_error(e, SQLITE_ERROR))
    }
    flags := obj_flags(e, t)
    if (flags & OF_UNSUPPORTED) != 0 {
        return err(fail(e, SQLITE_ERROR, "table uses unsupported features"))
    }
    if (flags & OF_HAS_TRIGGER) != 0 {
        return err(fail(e, SQLITE_ERROR, "table has a trigger this driver cannot read"))
    }
    if (flags & OF_UNSUPPORTED_INDEX) != 0 {
        return err(fail(e, SQLITE_ERROR, "table has an index this driver cannot read"))
    }
    ok(t)
}

// Common setup: registers, cursors, indexes, CHECK constraints.
fn write_info(e: &mut Engine, s: usize, t: usize) -> usize!db.Error {
    w := pool_alloc(e, W_BYTES)?
    zero_bytes(e.ws, w, W_BYTES)
    set_nf(e, s, 6, w)
    ncol := obj_ncol(e, t)
    stu(e.ws, w + W_TABLE, t)
    stu(e.ws, w + W_NCOL, ncol)
    base := alloc_regs(e, ncol + 1)?
    stu(e.ws, w + W_BASE, base)
    old := alloc_regs(e, ncol + 1)?
    stu(e.ws, w + W_OLD, old)
    let npk_w = pk_count(e, t)
    keys := alloc_regs(e, 34 + npk_w)?
    if is_wr(e, t) {
        let pkr = alloc_regs(e, 3 * npk_w)?
        stu(e.ws, w + W_PK, pkr)
    }
    stu(e.ws, w + W_KEYREG, keys)
    c := alloc_cursor(e)?
    stu(e.ws, w + W_CUR, c)
    // Index cursors.
    nidx := 0usize
    x := next_index_of(e, t, NO_COL)
    for x != NO_COL {
        nidx += 1
        x = next_index_of(e, t, x)
    }
    arr := pool_alloc(e, nidx * IDX_ENTRY + 4)?
    x = next_index_of(e, t, NO_COL)
    k := 0usize
    for x != NO_COL {
        ic := alloc_cursor(e)?
        stu(e.ws, arr + k * IDX_ENTRY, x)
        stu(e.ws, arr + k * IDX_ENTRY + 4, ic)
        k += 1
        x = next_index_of(e, t, x)
    }
    stu(e.ws, w + W_IDX, arr)
    stu(e.ws, w + W_NIDX, nidx)
    for k2 in 0usize..nidx {
        x2 := ldu(e.ws, arr + k2 * IDX_ENTRY)
        let eb = index_exprs(e, x2, t, base)?
        stu(e.ws, arr + k2 * IDX_ENTRY + 8, eb)
        let eo = index_exprs(e, x2, t, old)?
        stu(e.ws, arr + k2 * IDX_ENTRY + 12, eo)
    }
    let nop2 = nop(e, s) as usize
    stu(e.ws, w + W_CONF, nop2)
    // CHECK constraints: re-parse the table definition here and resolve
    // column names to the new-row registers.
    sql := obj_u(e, t, O_SQL)
    sqll := obj_u(e, t, O_SQLL)
    checks := 0usize
    if sqll > 0 && t_has_check(e, sql, sqll) {
        ct := parse_fragment_stmt(e, sql, sqll)?
        cd := nc(e, ct)
        for cd != 0 {
            if ng(e, cd) != 0 {
                let cd_g = ng(e, cd)
                checks = add_check(e, checks, cd_g)?
            }
            cd = nnext(e, cd)
        }
        tc := ndd(e, ct)
        for tc != 0 {
            if nop(e, tc) == 3 {
                let tc_e = ne_(e, tc)
                checks = add_check(e, checks, tc_e)?
            }
            tc = nnext(e, tc)
        }
        if checks != 0 {
            e.regctx_t = t
            e.regctx_base = base
            res := resolve_expr(e, checks, 0, false)
            e.regctx_t = NO_COL
            res?
        }
    }
    stu(e.ws, w + W_CHECKS, checks)
    // AUTOINCREMENT bookkeeping.
    if (obj_flags(e, t) & OF_AUTOINC) != 0 && rowid_col(e, t) != NO_COL {
        seq := find_obj(e, OT_TABLE, 0, 0)
        seqname := mem_bytes("sqlite_sequence")
        for i in 0usize..e.schema_objs {
            let name = obj_u(e, i, O_NAME)
            let name_len = obj_u(e, i, O_NAMEL)
            if obj_type(e, i) == OT_TABLE && name_is(e, name, name_len, "sqlite_sequence") {
                seq = i
            }
        }
        if seq != NO_COL && seqname.len > 0 {
            stu(e.ws, w + W_SEQ, seq + 1)
            sc := alloc_cursor(e)?
            stu(e.ws, w + W_SEQCUR, sc)
        }
    }
    ok(w)
}

fn t_has_check(e: &Engine, o: usize, l: usize) -> bool {
    contains_ci(e, o, l, "CHECK")
}

fn add_check(e: &mut Engine, head: usize, x: usize) -> usize!db.Error {
    if head == 0 {
        return ok(x)
    }
    binary(e, OP_AND, head, x)
}

fn open_write_cursors(e: &mut Engine, w: usize) {
    t := wget(e, w, W_TABLE)
    c := wget(e, w, W_CUR)
    open_table_cursor(e, c, t)
    arr := wget(e, w, W_IDX)
    for k in 0usize..wget(e, w, W_NIDX) {
        x := ldu(e.ws, arr + k * IDX_ENTRY)
        ic := ldu(e.ws, arr + k * IDX_ENTRY + 4)
        open_index_cursor(e, ic, x)
    }
}

// ---------------------------------------------------------------------------
// INSERT

fn resolve_insert(e: &mut Engine, s: usize) -> void!db.Error {
    let s_a0 = na(e, s)
    let s_b0 = nb(e, s)
    view := view_target(e, s_a0, s_b0, TE_INSERT)
    resolve_insert_rows(e, s, view)?
    w := sget_w(e, s)
    t := wget(e, w, W_TABLE)
    compile_triggers(e, s, w, t, TE_INSERT)?
    view_needs_trigger(e, w)
}

// Marks a constraint failure under OR FAIL / OR ROLLBACK, which keep the
// statement's earlier changes or abandon the whole transaction.
fn conf_mark(e: &mut Engine, conf: u8) {
    if conf == OE_FAIL {
        e.raise_kind = RAISE_FAIL
    } else if conf == OE_ROLLBACK {
        e.raise_kind = RAISE_ROLLBACK
    }
}

fn resolve_insert_rows(e: &mut Engine, s: usize, view: usize) -> void!db.Error {
    let s_a = na(e, s)
    let s_b = nb(e, s)
    t := 0usize
    if view != 0 {
        if nff(e, s) != 0 {
            return err(fail(e, SQLITE_ERROR, "cannot UPSERT a view"))
        }
        t = view_columns(e, view - 1)?
    } else {
        t = table_for_write(e, s_a, s_b)?
    }
    w := write_info(e, s, t)?
    stu(e.ws, w + W_VIEW, view)
    ncol := obj_ncol(e, t)
    ipk := rowid_col(e, t)
    // Target list.
    list := nc(e, s)
    nlist := if list == 0 {
        ncol
    } else {
        list_len(e, list)
    }
    colmap := pool_alloc(e, nlist * 4 + 4)?
    seen := pool_alloc(e, ncol + 1)?
    zero_bytes(e.ws, seen, ncol + 1)
    if list == 0 {
        for i in 0usize..ncol {
            stu(e.ws, colmap + i * 4, if i == ipk {
                ROWID_TARGET
            } else {
                i
            })
        }
    } else {
        id := list
        k := 0usize
        for id != 0 {
            let id_a = na(e, id)
            let id_b = nb(e, id)
            c := find_column(e, t, id_a, id_b)
            if c == NO_COL {
                let id_a2 = na(e, id)
                let id_b2 = nb(e, id)
                if is_rowid_name(e, id_a2, id_b2) {
                    stu(e.ws, colmap + k * 4, ROWID_TARGET)
                } else {
                    e.msg_len = 0
                    msg_add(e, "table ")
                    let name = obj_u(e, t, O_NAME)
                    let name_len = obj_u(e, t, O_NAMEL)
                    msg_add_ws(e, name, name_len)
                    msg_add(e, " has no column named ")
                    let id_a3 = na(e, id)
                    let id_b3 = nb(e, id)
                    msg_add_ws(e, id_a3, id_b3)
                    return err(make_error(e, SQLITE_ERROR))
                }
            } else {
                stu(e.ws, colmap + k * 4, if c == ipk {
                    ROWID_TARGET
                } else {
                    c
                })
                e.ws[seen + c] = 1
            }
            k += 1
            id = nnext(e, id)
        }
    }
    stu(e.ws, w + W_COLMAP, colmap)
    stu(e.ws, w + W_NLIST, nlist)
    // Defaults for columns not in the list.
    defaults := pool_alloc(e, ncol * 4 + 4)?
    zero_bytes(e.ws, defaults, ncol * 4 + 4)
    for c in 0usize..ncol {
        if (list == 0 && (nflags(e, s) & 1) == 0) || e.ws[seen + c] != 0 {
            continue
        }
        r := col_rec(e, t, c)
        if e.ws[r + K_HASDFLT] != 0 {
            let o = ldu(e.ws, r + K_DFLT)
            let l = ldu(e.ws, r + K_DFLTL)
            x := parse_fragment_expr(e, o, l)?
            resolve_expr(e, x, 0, false)?
            stu(e.ws, defaults + c * 4, x)
        }
    }
    // Defaults also apply to NOT NULL columns under OR REPLACE.
    for c in 0usize..ncol {
        if ldu(e.ws, defaults + c * 4) == 0 {
            r := col_rec(e, t, c)
            if e.ws[r + K_HASDFLT] != 0 {
                let o = ldu(e.ws, r + K_DFLT)
                let l = ldu(e.ws, r + K_DFLTL)
                x := parse_fragment_expr(e, o, l)?
                resolve_expr(e, x, 0, false)?
                stu(e.ws, defaults + c * 4, x | 2147483648)
            }
        }
    }
    stu(e.ws, w + W_DEFAULTS, defaults)
    if nff(e, s) != 0 {
        resolve_upsert(e, s, w, t)?
    }
    // Values.
    if (nflags(e, s) & 1) != 0 {
        return ok()
    }
    rows := ndd(e, s)
    if rows != 0 {
        row := rows
        for row != 0 {
            let row_a = na(e, row)
            n := list_len(e, row_a)
            if n != nlist {
                e.msg_len = 0
                if list == 0 {
                    msg_add(e, "table ")
                    let name2 = obj_u(e, t, O_NAME)
                    let name_len2 = obj_u(e, t, O_NAMEL)
                    msg_add_ws(e, name2, name_len2)
                    msg_add(e, " has ")
                    msg_add_int(e, ncol as i64)
                    msg_add(e, " columns but ")
                    msg_add_int(e, n as i64)
                    msg_add(e, " values were supplied")
                } else {
                    msg_add_int(e, n as i64)
                    msg_add(e, " values for ")
                    msg_add_int(e, nlist as i64)
                    msg_add(e, " columns")
                }
                return err(make_error(e, SQLITE_ERROR))
            }
            x := na(e, row)
            for x != 0 {
                resolve_expr(e, x, 0, false)?
                x = nnext(e, x)
            }
            row = nnext(e, row)
        }
        return ok()
    }
    sel := ne_(e, s)
    resolve_select(e, sel)?
    if select_ncols(e, sel) != nlist {
        e.msg_len = 0
        msg_add(e, "table ")
        let name3 = obj_u(e, t, O_NAME)
        let name_len3 = obj_u(e, t, O_NAMEL)
        msg_add_ws(e, name3, name_len3)
        msg_add(e, " has ")
        msg_add_int(e, nlist as i64)
        msg_add(e, " columns but ")
        let select_ncols2 = select_ncols(e, sel) as i64
        msg_add_int(e, select_ncols2)
        msg_add(e, " values were supplied")
        return err(make_error(e, SQLITE_ERROR))
    }
    ok()
}

// RETURNING: resolves the result columns against the new row registers
// (INSERT, UPDATE) or the old row registers (DELETE). Returns the result
// register base and count.
fn resolve_returning(e: &mut Engine, s: usize, deleting: bool) -> (usize, usize)!db.Error {
    w := sget_w(e, s)
    t := wget(e, w, W_TABLE)
    head := nx(e, s) as usize
    // Expand * into the table's columns.
    out := 0usize
    tail := 0usize
    rc := head
    for rc != 0 {
        next := nnext(e, rc)
        set_next(e, rc, 0)
        let rc_a = na(e, rc)
        if nkind(e, rc_a) == N_STAR {
            for c in 0usize..obj_ncol(e, t) {
                r := col_rec(e, t, c)
                id := new_node(e, N_ID)?
                let cn = ldu(e.ws, r + K_NAME)
                let cl = ldu(e.ws, r + K_NAMEL)
                set_nf(e, id, 0, cn)
                set_nf(e, id, 1, cl)
                item := new_node(e, N_RESCOL)?
                set_nf(e, item, 0, id)
                set_nf(e, item, 1, cn)
                set_nf(e, item, 2, cl)
                let (h, tl) = list_append(e, out, tail, item)
                out = h
                tail = tl
            }
        } else {
            let (h, tl) = list_append(e, out, tail, rc)
            out = h
            tail = tl
        }
        rc = next
    }
    set_x(e, s, out as u64)
    n := list_len(e, out)
    e.regctx_t = t
    let value = if deleting {
        wget(e, w, W_OLD)
    } else {
        wget(e, w, W_BASE)
    }
    e.regctx_base = value
    rc = out
    for rc != 0 {
        let rc_a2 = na(e, rc)
        match resolve_expr(e, rc_a2, 0, false) {
            ok() => {},
            err(reason) => {
                e.regctx_t = NO_COL
                return err(reason)
            },
        }
        rc = nnext(e, rc)
    }
    e.regctx_t = NO_COL
    resreg := alloc_regs(e, n)?
    stu(e.ws, w + W_RET, out)
    stu(e.ws, w + W_RETREG, resreg)
    stu(e.ws, w + W_NRET, n)
    ok((resreg, n))
}

// Appends one RETURNING row for the row just written or deleted.
fn push_returning(e: &mut Engine, w: usize) -> void!db.Error {
    head := wget(e, w, W_RET)
    if head == 0 {
        return ok()
    }
    r := wget(e, w, W_RETREG)
    k := 0usize
    rc := head
    for rc != 0 {
        let rc_a = na(e, rc)
        eval(e, rc_a, r + k)?
        k += 1
        rc = nnext(e, rc)
    }
    sort_push(e, r, k)?
    ok()
}

// Upsert info: [0] target (index object, ROWID_TARGET, or NO_COL for any
// constraint), [4] action (0 nothing, 1 update), [8] sets array, [12] count,
// [16] WHERE of DO UPDATE.
fn resolve_upsert(e: &mut Engine, s: usize, w: usize, t: usize) -> void!db.Error {
    u := nff(e, s)
    info := pool_alloc(e, 20)?
    zero_bytes(e.ws, info, 20)
    stu(e.ws, w + W_UPSERT, info)
    target := NO_COL
    tl := na(e, u)
    if tl != 0 {
        n := list_len(e, tl)
        ipk := rowid_col(e, t)
        to := na(e, tl)
        tlen := nb(e, tl)
        c0 := find_column(e, t, to, tlen)
        if is_wr(e, t) && wr_list_is_pk(e, t, tl) {
            target = ROWID_TARGET
        } else if n == 1 && ((c0 == ipk && ipk != NO_COL) || (c0 == NO_COL && is_rowid_name(e, to, tlen))) {
            target = ROWID_TARGET
        } else {
            x := next_index_of(e, t, NO_COL)
            for x != NO_COL {
                if (obj_flags(e, x) & OF_UNIQUE) != 0 && obj_ncol(e, x) == n {
                    all := true
                    id := tl
                    for id != 0 {
                        let id_a = na(e, id)
                        let id_b = nb(e, id)
                        c := find_column(e, t, id_a, id_b)
                        found := false
                        for k in 0usize..n {
                            if idx_col(e, x, k) == c && c != NO_COL {
                                found = true
                            }
                        }
                        if !found {
                            all = false
                        }
                        id = nnext(e, id)
                    }
                    if all {
                        target = x
                        break
                    }
                }
                x = next_index_of(e, t, x)
            }
            if target == NO_COL {
                return err(fail(e, SQLITE_ERROR, "ON CONFLICT clause does not match any PRIMARY KEY or UNIQUE constraint"))
            }
        }
    }
    stu(e.ws, info, target)
    let nop2 = nop(e, u) as usize
    stu(e.ws, info + 4, nop2)
    if nop(e, u) == 0 {
        return ok()
    }
    // DO UPDATE: names refer to the existing row, excluded.* to the new one.
    let u_d = ndd(e, u)
    nset := list_len(e, u_d)
    sets := pool_alloc(e, nset * 8 + 4)?
    st := ndd(e, u)
    k := 0usize
    e.regctx_t = t
    let old = wget(e, w, W_OLD)
    e.regctx_base = old
    let base = wget(e, w, W_BASE)
    e.excluded_base = base
    for st != 0 {
        let st_a = na(e, st)
        let st_b = nb(e, st)
        col := find_column(e, t, st_a, st_b)
        if col == NO_COL || col == rowid_col(e, t) {
            let st_a2 = na(e, st)
            let st_b2 = nb(e, st)
            if col == NO_COL && !is_rowid_name(e, st_a2, st_b2) {
                e.regctx_t = NO_COL
                e.excluded_base = 0
                e.msg_len = 0
                msg_add(e, "no such column: ")
                let st_a3 = na(e, st)
                let st_b3 = nb(e, st)
                msg_add_ws(e, st_a3, st_b3)
                return err(make_error(e, SQLITE_ERROR))
            }
            col = ROWID_TARGET
        }
        let st_c = nc(e, st)
        match resolve_expr(e, st_c, 0, false) {
            ok() => {},
            err(reason) => {
                e.regctx_t = NO_COL
                e.excluded_base = 0
                return err(reason)
            },
        }
        stu(e.ws, sets + k * 8, col)
        let st_c2 = nc(e, st)
        stu(e.ws, sets + k * 8 + 4, st_c2)
        k += 1
        st = nnext(e, st)
    }
    wr := ne_(e, u)
    if wr != 0 {
        match resolve_expr(e, wr, 0, false) {
            ok() => {},
            err(reason) => {
                e.regctx_t = NO_COL
                e.excluded_base = 0
                return err(reason)
            },
        }
    }
    e.regctx_t = NO_COL
    e.excluded_base = 0
    stu(e.ws, info + 8, sets)
    stu(e.ws, info + 12, nset)
    stu(e.ws, info + 16, wr)
    ok()
}

// True when the upsert clause of `w` handles a conflict on `target`.
fn upsert_applies(e: &Engine, w: usize, target: usize) -> bool {
    info := wget(e, w, W_UPSERT)
    if info == 0 {
        return false
    }
    want := ldu(e.ws, info)
    want == NO_COL || want == target
}

// Resolves a conflict with existing row `r` by the upsert action. The insert
// itself never happens.
fn do_upsert(e: &mut Engine, w: usize, r: i64) -> void!db.Error {
    info := wget(e, w, W_UPSERT)
    if ldu(e.ws, info + 4) == 0 {
        return ok()
    }
    t := wget(e, w, W_TABLE)
    c := wget(e, w, W_CUR)
    base := wget(e, w, W_BASE)
    old := wget(e, w, W_OLD)
    ncol := wget(e, w, W_NCOL)
    ipk := rowid_col(e, t)
    if is_wr(e, t) {
        let pk = wget(e, w, W_PK)
        if !wr_seek(e, c, t, pk)? {
            return err(corrupt(e))
        }
        wr_load_row(e, t, c, old)?
    } else {
        if !seek_rowid(e, c, r)? {
            return err(corrupt(e))
        }
        let (p, len) = cur_payload(e, c)?
        for i in 0usize..ncol {
            if i == ipk {
                set_int(e, old + i, r)
            } else if !record_column(e, p, len, i, old + i)? {
                column_default(e, t, i, old + i)?
            }
            reg_own(e, old + i)?
        }
        set_int(e, old + ncol, r)
    }
    for i in 0usize..(ncol + 1) {
        reg_own(e, base + i)?
    }
    wr := ldu(e.ws, info + 16)
    if wr != 0 && eval_truth(e, wr)? != 1 {
        return ok()
    }
    sets := ldu(e.ws, info + 8)
    nset := ldu(e.ws, info + 12)
    save := e.rtop
    first := e.rtop
    for k in 0usize..nset {
        reg := reg_push(e)?
        let ldu2 = ldu(e.ws, sets + k * 8 + 4)
        eval(e, ldu2, reg)?
    }
    // The updated row: the old values with the assignments applied.
    for i in 0usize..(ncol + 1) {
        copy_reg(e, base + i, old + i)
    }
    for k in 0usize..nset {
        col := ldu(e.ws, sets + k * 8)
        if col == ROWID_TARGET {
            copy_reg(e, base + ncol, first + k)
            if ipk != NO_COL {
                copy_reg(e, base + ipk, first + k)
            }
        } else {
            copy_reg(e, base + col, first + k)
        }
    }
    for i in 0usize..(ncol + 1) {
        reg_own(e, base + i)?
    }
    e.rtop = save
    if has_triggers(e, w, trig_mask(TE_UPDATE, TT_BEFORE)) {
        load_trigger_old(e, w, old)?
        for i in 0usize..ncol {
            if i != ipk {
                let aff = col_aff(e, t, i)
                apply_affinity(e, base + i, aff)?
            }
        }
        if !fire_triggers(e, w, trig_mask(TE_UPDATE, TT_BEFORE))? {
            return ok()
        }
    } else {
        load_trigger_old(e, w, old)?
    }
    last := e.last_rowid
    written := write_row(e, w, OE_ABORT, true, r)?
    e.last_rowid = last
    if written && has_triggers(e, w, trig_mask(TE_UPDATE, TT_AFTER)) {
        fire_triggers(e, w, trig_mask(TE_UPDATE, TT_AFTER))?
    }
    ok()
}

fn set_target(e: &mut Engine, w: usize, k: usize, src: usize) {
    base := wget(e, w, W_BASE)
    ncol := wget(e, w, W_NCOL)
    target := ldu(e.ws, wget(e, w, W_COLMAP) + k * 4)
    if target == ROWID_TARGET {
        copy_reg(e, base + ncol, src)
    } else {
        copy_reg(e, base + target, src)
    }
}

fn clear_row(e: &mut Engine, w: usize) {
    base := wget(e, w, W_BASE)
    ncol := wget(e, w, W_NCOL)
    for i in 0usize..(ncol + 1) {
        set_null(e, base + i)
    }
}

// Fills unspecified columns from defaults.
fn fill_defaults(e: &mut Engine, w: usize, given: usize) -> void!db.Error {
    base := wget(e, w, W_BASE)
    ncol := wget(e, w, W_NCOL)
    defaults := wget(e, w, W_DEFAULTS)
    for c in 0usize..ncol {
        x := ldu(e.ws, defaults + c * 4)
        if x != 0 && (x & 2147483648) == 0 {
            eval(e, x, base + c)?
        }
    }
    if given == 0 {
        return ok()
    }
    ok()
}

fn exec_insert(e: &mut Engine, s: usize) -> void!db.Error {
    w := sget_w(e, s)
    open_write_cursors(e, w)
    conf := wget(e, w, W_CONF) as u8
    nlist := wget(e, w, W_NLIST)
    e.ret_start = e.sort_top
    if (nflags(e, s) & 1) != 0 {
        mark := e.arena_top
        clear_row(e, w)
        fill_defaults(e, w, 0)?
        insert_row(e, w, conf)?
        arena_reset(e, mark)
        return ok()
    }
    rows := ndd(e, s)
    if rows != 0 {
        row := rows
        for row != 0 {
            mark := e.arena_top
            clear_row(e, w)
            fill_defaults(e, w, 1)?
            save := e.rtop
            tmp := reg_push(e)?
            x := na(e, row)
            k := 0usize
            for x != 0 {
                eval(e, x, tmp)?
                set_target(e, w, k, tmp)
                k += 1
                x = nnext(e, x)
            }
            e.rtop = save
            insert_row(e, w, conf)?
            arena_reset(e, mark)
            row = nnext(e, row)
        }
        return ok()
    }
    // INSERT ... SELECT: materialize first (the source may be the target).
    sel := ne_(e, s)
    select_reset(e, sel)
    resreg := select_resreg(e, sel)
    start := e.sort_top
    hi := e.sort_hi
    mark := e.arena_top
    got := select_next(e, sel)?
    lend := list_begin(e)
    for got {
        rec := sort_push(e, resreg, nlist)?
        list_push(e, rec)?
        arena_reset(e, mark)
        got = select_next(e, sel)?
    }
    let (idx, n) = list_finish(e, lend)
    e.ret_start = e.sort_top
    for i in 0usize..n {
        p := ldu(e.ws, idx + i * 4)
        mark := e.arena_top
        clear_row(e, w)
        fill_defaults(e, w, 1)?
        for k in 0usize..nlist {
            let len = rec_len(e, p)
            record_column(e, p + 4, len, k, R_TMP)?
            set_target(e, w, k, R_TMP)
        }
        insert_row(e, w, conf)?
        arena_reset(e, mark)
    }
    e.sort_hi = hi
    ok()
}

fn insert_row(e: &mut Engine, w: usize, conf: u8) -> void!db.Error {
    if wget(e, w, W_VIEW) != 0 {
        fire_triggers(e, w, trig_mask(TE_INSERT, TT_INSTEAD))?
        return ok()
    }
    write_row(e, w, conf, false, 0)?
    ok()
}

fn sget_w(e: &Engine, s: usize) -> usize {
    ng(e, s)
}

// ---------------------------------------------------------------------------
// Row writing with constraints

fn constraint_fail(e: &mut Engine, code: i32, kind: &str, t: usize, cols: usize, ncols: usize, x: usize) -> db.Error {
    e.msg_len = 0
    msg_add(e, kind)
    msg_add(e, " constraint failed: ")
    tn := obj_u(e, t, O_NAME)
    tl := obj_u(e, t, O_NAMEL)
    if x == NO_COL {
        // Single column `cols`.
        msg_add_ws(e, tn, tl)
        msg_add(e, ".")
        if cols == NO_COL {
            msg_add(e, "rowid")
        } else {
            r := col_rec(e, t, cols)
            let name = ldu(e.ws, r + K_NAME)
            let name_len = ldu(e.ws, r + K_NAMEL)
            msg_add_ws(e, name, name_len)
        }
    } else if index_has_expr(e, x) {
        msg_add(e, "index '")
        let xn = obj_u(e, x, O_NAME)
        let xl = obj_u(e, x, O_NAMEL)
        msg_add_ws(e, xn, xl)
        msg_add(e, "'")
    } else {
        for k in 0usize..ncols {
            if k > 0 {
                msg_add(e, ", ")
            }
            msg_add_ws(e, tn, tl)
            msg_add(e, ".")
            c := idx_col(e, x, k)
            if c == NO_COL {
                msg_add(e, "rowid")
            } else {
                r := col_rec(e, t, c)
                let name2 = ldu(e.ws, r + K_NAME)
                let name_len2 = ldu(e.ws, r + K_NAMEL)
                msg_add_ws(e, name2, name_len2)
            }
        }
    }
    make_error(e, code)
}

// Parses and resolves the key expressions and WHERE clause of index x
// against the row registers at `regs`; returns the expression array (or 0
// for a plain index).
fn index_exprs(e: &mut Engine, x: usize, t: usize, regs: usize) -> usize!db.Error {
    n := obj_ncol(e, x)
    partial := obj_u(e, x, O_WHEREL) != 0
    plain := !partial
    for k in 0usize..n {
        if idx_col(e, x, k) == EXPR_COL {
            plain = false
        }
    }
    if plain {
        return ok(0)
    }
    arr := pool_alloc(e, (n + 1) * 4)?
    zero_bytes(e.ws, arr, (n + 1) * 4)
    for k in 0usize..(n + 1) {
        if k < n && idx_col(e, x, k) != EXPR_COL {
            continue
        }
        let (so, sl) = if k == n {
            (obj_u(e, x, O_WHERE), obj_u(e, x, O_WHEREL))
        } else {
            let r = col_rec(e, x, k)
            (ldu(e.ws, r + K_DFLT), ldu(e.ws, r + K_DFLTL))
        }
        if sl == 0 {
            continue
        }
        node := parse_fragment_expr(e, so, sl)?
        e.regctx_t = t
        e.regctx_base = regs
        res := resolve_expr(e, node, 0, false)
        e.regctx_t = NO_COL
        res?
        stu(e.ws, arr + k * 4, node)
    }
    ok(arr)
}

// True when the row in the registers bound to entry k's expressions
// belongs in that (possibly partial) index.
fn index_applies(e: &mut Engine, w: usize, k: usize, old: bool) -> bool!db.Error {
    arr := wget(e, w, W_IDX)
    ex := ldu(e.ws, arr + k * IDX_ENTRY + if old {
        12usize
    } else {
        8usize
    })
    if ex == 0 {
        return ok(true)
    }
    x := ldu(e.ws, arr + k * IDX_ENTRY)
    n := obj_ncol(e, x)
    cond := ldu(e.ws, ex + n * 4)
    if cond == 0 {
        return ok(true)
    }
    ok(eval_truth(e, cond)? == 1)
}

fn index_has_expr(e: &Engine, x: usize) -> bool {
    for k in 0usize..obj_ncol(e, x) {
        if idx_col(e, x, k) == EXPR_COL {
            return true
        }
    }
    false
}

// Builds the key registers of index entry k from the row registers;
// returns false if any key column is NULL.
fn index_key(e: &mut Engine, w: usize, k0: usize, row: usize, rowid: i64, old: bool) -> bool!db.Error {
    keys := wget(e, w, W_KEYREG)
    t := wget(e, w, W_TABLE)
    arr := wget(e, w, W_IDX)
    x := ldu(e.ws, arr + k0 * IDX_ENTRY)
    ex := ldu(e.ws, arr + k0 * IDX_ENTRY + if old {
        12usize
    } else {
        8usize
    })
    n := obj_ncol(e, x)
    any_null := false
    for k in 0usize..n {
        c := idx_col(e, x, k)
        if c == EXPR_COL {
            let node = ldu(e.ws, ex + k * 4)
            eval(e, node, keys + k)?
            reg_own(e, keys + k)?
            if rtype(e, keys + k) == T_NULL {
                any_null = true
            }
        } else if c == NO_COL || c == rowid_col(e, t) {
            set_int(e, keys + k, rowid)
        } else {
            copy_reg(e, keys + k, row + c)
            if rtype(e, keys + k) == T_NULL {
                any_null = true
            }
        }
    }
    if is_wr(e, t) {
        for j in 0usize..index_ntail(e, x) {
            let tc = tail_col(e, x, j)
            copy_reg(e, keys + n + j, row + tc)
        }
    } else {
        set_int(e, keys + n, rowid)
    }
    ok(!any_null)
}

// Inserts the row in the W_BASE registers. Returns false when skipped by
// OR IGNORE. For updates, `old_rowid` is the row being replaced (already
// checked but not yet deleted).
fn write_row(e: &mut Engine, w: usize, conf: u8, update: bool, old_rowid: i64) -> bool!db.Error {
    t := wget(e, w, W_TABLE)
    c := wget(e, w, W_CUR)
    base := wget(e, w, W_BASE)
    ncol := wget(e, w, W_NCOL)
    ipk := rowid_col(e, t)
    rid := base + ncol
    seq_obj := wget(e, w, W_SEQ)
    seq_value := 0i64
    seq_rowid := 0i64
    wr := is_wr(e, t)
    if wr {
        set_null(e, rid)
    }
    if !update && has_triggers(e, w, trig_mask(TE_INSERT, TT_BEFORE)) {
        // NEW for BEFORE INSERT: values with affinity applied; an automatic
        // rowid reads as -1.
        tnew := wget(e, w, W_TNEW)
        for i in 0usize..ncol {
            copy_reg(e, tnew + i, base + i)
            if i != ipk {
                let aff0 = col_aff(e, t, i)
                apply_affinity(e, tnew + i, aff0)?
            }
        }
        copy_reg(e, tnew + ncol, rid)
        if rtype(e, tnew + ncol) == T_NULL && !wr {
            set_int(e, tnew + ncol, -1)
        } else {
            compare_affinity(e, tnew + ncol, AFF_NUMERIC)?
            if rtype(e, tnew + ncol) == T_REAL {
                let (exact0, iv0) = real_as_int(rreal(e, tnew + ncol))
                if exact0 {
                    set_int(e, tnew + ncol, iv0)
                }
            }
        }
        if ipk != NO_COL {
            copy_reg(e, tnew + ipk, tnew + ncol)
        }
        if !fire_triggers(e, w, trig_mask(TE_INSERT, TT_BEFORE))? {
            return ok(false)
        }
    }
    // Rowid.
    if !wr && rtype(e, rid) != T_NULL {
        compare_affinity(e, rid, AFF_NUMERIC)?
        if rtype(e, rid) == T_REAL {
            let (exact, iv) = real_as_int(rreal(e, rid))
            if exact {
                set_int(e, rid, iv)
            }
        }
        if rtype(e, rid) != T_INT {
            return err(fail(e, SQLITE_MISMATCH, "datatype mismatch"))
        }
    }
    if seq_obj != 0 {
        let (sv, sr) = read_sequence(e, w)?
        seq_value = sv
        seq_rowid = sr
    }
    if !wr && rtype(e, rid) == T_NULL {
        next := 1i64
        if cur_last(e, c)? {
            maxr := cur_rowid(e, c)
            if maxr == 9223372036854775807 {
                if seq_obj != 0 {
                    return err(fail(e, SQLITE_FULL, "database or disk is full"))
                }
                // Try random rowids.
                found := false
                for _ in 0usize..100 {
                    cand := u2i(next_random(e) >> 1)
                    if cand > 0 && !seek_rowid(e, c, cand)? {
                        next = cand
                        found = true
                        break
                    }
                }
                if !found {
                    return err(fail(e, SQLITE_FULL, "database or disk is full"))
                }
            } else {
                next = maxr + 1
            }
        }
        if seq_obj != 0 && seq_value >= next {
            if seq_value == 9223372036854775807 {
                return err(fail(e, SQLITE_FULL, "database or disk is full"))
            }
            next = seq_value + 1
        }
        set_int(e, rid, next)
    }
    rowid := if wr {
        0i64
    } else {
        rint(e, rid)
    }
    // SQLite advances the AUTOINCREMENT sequence as soon as a rowid is
    // chosen, even when OR IGNORE then skips the row.
    if seq_obj != 0 && rowid > seq_value {
        write_sequence(e, w, rowid, seq_rowid)?
        seq_value = rowid
        if seq_rowid == 0 {
            let (sv, sr) = read_sequence(e, w)?
            seq_value = sv
            seq_rowid = sr
        }
    }
    // Affinity.
    for i in 0usize..ncol {
        if i != ipk {
            let affinity = col_aff(e, t, i)
            apply_affinity(e, base + i, affinity)?
        }
    }
    if ipk != NO_COL {
        set_int(e, base + ipk, rowid)
    }
    // NOT NULL.
    defaults := wget(e, w, W_DEFAULTS)
    for i in 0usize..ncol {
        if i == ipk || (col_flags(e, t, i) & CF_NOTNULL) == 0 || rtype(e, base + i) != T_NULL {
            continue
        }
        if conf == OE_IGNORE {
            return ok(false)
        }
        dx := if defaults != 0 {
            ldu(e.ws, defaults + i * 4) & 2147483647
        } else {
            0usize
        }
        if conf == OE_REPLACE && dx != 0 {
            eval(e, dx, base + i)?
            let affinity2 = col_aff(e, t, i)
            apply_affinity(e, base + i, affinity2)?
            if rtype(e, base + i) != T_NULL {
                continue
            }
        }
        conf_mark(e, conf)
        return err(constraint_fail(e, SQLITE_CONSTRAINT_NOTNULL, "NOT NULL", t, i, 0, NO_COL))
    }
    // CHECK.
    checks := wget(e, w, W_CHECKS)
    if checks != 0 {
        if eval_truth(e, checks)? == 0 {
            if conf == OE_IGNORE {
                return ok(false)
            }
            e.msg_len = 0
            msg_add(e, "CHECK constraint failed: ")
            let name = obj_u(e, t, O_NAME)
            let name_len = obj_u(e, t, O_NAMEL)
            msg_add_ws(e, name, name_len)
            conf_mark(e, conf)
            return err(make_error(e, SQLITE_CONSTRAINT_CHECK))
        }
    }
    // Rowid (or WITHOUT ROWID primary key) uniqueness.
    if wr {
        pk := wget(e, w, W_PK)
        npk := pk_count(e, t)
        newk := pk + npk
        for k in 0usize..npk {
            let pc = pk_col(e, t, k)
            copy_reg(e, newk + k, base + pc)
        }
        if wr_seek(e, c, t, newk)? && !(update && wr_same_key(e, t, newk, pk)) {
            if !update && upsert_applies(e, w, ROWID_TARGET) {
                wr_set_identity(e, w, newk)
                do_upsert(e, w, 0)?
                return ok(false)
            }
            if conf == OE_IGNORE {
                return ok(false)
            }
            if conf == OE_REPLACE {
                wr_delete_by(e, w, newk)?
            } else {
                conf_mark(e, conf)
                return err(wr_pk_fail(e, t))
            }
        }
    } else if !update || rowid != old_rowid {
        if seek_rowid(e, c, rowid)? {
            if !update && upsert_applies(e, w, ROWID_TARGET) {
                do_upsert(e, w, rowid)?
                return ok(false)
            }
            if conf == OE_IGNORE {
                return ok(false)
            }
            if conf == OE_REPLACE {
                delete_row(e, w, rowid)?
            } else {
                conf_mark(e, conf)
                return err(constraint_fail(e, SQLITE_CONSTRAINT_PRIMARYKEY, "UNIQUE", t, ipk, 0, NO_COL))
            }
        }
    }
    // UNIQUE indexes.
    arr := wget(e, w, W_IDX)
    nidx := wget(e, w, W_NIDX)
    keys := wget(e, w, W_KEYREG)
    for k in 0usize..nidx {
        x := ldu(e.ws, arr + k * IDX_ENTRY)
        if (obj_flags(e, x) & OF_UNIQUE) == 0 {
            continue
        }
        ic := ldu(e.ws, arr + k * IDX_ENTRY + 4)
        n := obj_ncol(e, x)
        if !index_applies(e, w, k, false)? {
            continue
        }
        if !index_key(e, w, k, base, rowid, false)? {
            continue
        }
        for {
            if seek_index(e, ic, keys, n)? != 0 {
                break
            }
            let (p, len) = cur_payload(e, ic)?
            other := 0i64
            otherk := 0usize
            if wr {
                otherk = wget(e, w, W_PK) + 2 * pk_count(e, t)
                index_entry_pk(e, x, t, p, len, otherk)?
                let oldk = wget(e, w, W_PK)
                if update && wr_same_key(e, t, otherk, oldk) {
                    break
                }
            } else {
                nf := record_count(e, p, len)
                record_column(e, p, len, nf - 1, R_TMP)?
                other = rint(e, R_TMP)
                if other == rowid || (update && other == old_rowid) {
                    break
                }
            }
            if !update && upsert_applies(e, w, x) {
                if wr {
                    wr_set_identity(e, w, otherk)
                }
                do_upsert(e, w, other)?
                return ok(false)
            }
            if conf == OE_IGNORE {
                return ok(false)
            }
            if conf == OE_REPLACE {
                if wr {
                    wr_delete_by(e, w, otherk)?
                    index_key(e, w, k, base, rowid, false)?
                    continue
                }
                delete_row(e, w, other)?
                index_key(e, w, k, base, rowid, false)?
                continue
            }
            code := if (obj_flags(e, x) & OF_PK) != 0 {
                SQLITE_CONSTRAINT_PRIMARYKEY
            } else {
                SQLITE_CONSTRAINT_UNIQUE
            }
            conf_mark(e, conf)
            return err(constraint_fail(e, code, "UNIQUE", t, 0, n, x))
        }
    }
    if update {
        delete_row(e, w, old_rowid)?
    }
    store_row(e, w, rowid)?
    if !update && has_triggers(e, w, trig_mask(TE_INSERT, TT_AFTER)) {
        fire_triggers(e, w, trig_mask(TE_INSERT, TT_AFTER))?
    }
    ok(true)
}

// Trigger OLD registers: a copy of the row as it was before the change.
fn load_trigger_old(e: &mut Engine, w: usize, src: usize) -> void!db.Error {
    told := wget(e, w, W_TOLD)
    if told == 0 {
        return ok()
    }
    ncol := wget(e, w, W_NCOL)
    for k in 0usize..(ncol + 1) {
        copy_reg(e, told + k, src + k)
        reg_own(e, told + k)?
    }
    ok()
}

fn store_row(e: &mut Engine, w: usize, rowid: i64) -> void!db.Error {
    t := wget(e, w, W_TABLE)
    c := wget(e, w, W_CUR)
    base := wget(e, w, W_BASE)
    ncol := wget(e, w, W_NCOL)
    ipk := rowid_col(e, t)
    wr := is_wr(e, t)
    if wr {
        // Fields in record order: PRIMARY KEY columns first.
        save := e.rtop
        tmp := e.rtop
        for _ in 0usize..ncol {
            reg_push(e)?
        }
        for col in 0usize..ncol {
            let pos = rec_pos(e, t, col)
            copy_reg(e, tmp + pos, base + col)
        }
        wsize := record_size(e, tmp, ncol)
        wrec := arena_alloc(e, wsize)?
        record_write(e, tmp, ncol, wrec)
        e.rtop = save
        index_insert(e, c, wrec, wsize)?
    } else {
        // The INTEGER PRIMARY KEY column is stored as NULL (it is the rowid).
        if ipk != NO_COL {
            set_null(e, base + ipk)
        }
        size := record_size(e, base, ncol)
        rec := arena_alloc(e, size)?
        record_write(e, base, ncol, rec)
        if ipk != NO_COL {
            set_int(e, base + ipk, rowid)
        }
        table_insert(e, c, rowid, rec, size)?
    }
    arr := wget(e, w, W_IDX)
    keys := wget(e, w, W_KEYREG)
    for k in 0usize..wget(e, w, W_NIDX) {
        x := ldu(e.ws, arr + k * IDX_ENTRY)
        ic := ldu(e.ws, arr + k * IDX_ENTRY + 4)
        n := obj_ncol(e, x)
        if !index_applies(e, w, k, false)? {
            continue
        }
        index_key(e, w, k, base, rowid, false)?
        for i in 0usize..n {
            c2 := idx_col(e, x, i)
            if c2 != NO_COL && c2 != ipk && c2 != EXPR_COL {
                let affinity = col_aff(e, t, c2)
                apply_affinity(e, keys + i, affinity)?
            }
        }
        nt := index_ntail(e, x)
        isize := record_size(e, keys, n + nt)
        irec := arena_alloc(e, isize)?
        record_write(e, keys, n + nt, irec)
        index_insert(e, ic, irec, isize)?
    }
    e.changes += 1
    if !wr {
        e.last_rowid = rowid
    }
    push_returning(e, w)
}

// Deletes row `rowid` and its index entries.
fn delete_row(e: &mut Engine, w: usize, rowid: i64) -> void!db.Error {
    t := wget(e, w, W_TABLE)
    if is_wr(e, t) {
        let pk = wget(e, w, W_PK)
        return wr_delete_by(e, w, pk)
    }
    c := wget(e, w, W_CUR)
    old := wget(e, w, W_OLD)
    ncol := wget(e, w, W_NCOL)
    if !seek_rowid(e, c, rowid)? {
        return ok()
    }
    ipk := rowid_col(e, t)
    let (p, len) = cur_payload(e, c)?
    for i in 0usize..ncol {
        if i == ipk {
            set_int(e, old + i, rowid)
        } else if !record_column(e, p, len, i, old + i)? {
            column_default(e, t, i, old + i)?
        }
        reg_own(e, old + i)?
    }
    set_int(e, old + ncol, rowid)
    delete_index_entries(e, w, rowid)?
    if seek_rowid(e, c, rowid)? {
        cur_delete(e, c)?
    }
    ok()
}

// Removes the index entries of the row in the W_OLD registers.
fn delete_index_entries(e: &mut Engine, w: usize, rowid: i64) -> void!db.Error {
    t := wget(e, w, W_TABLE)
    old := wget(e, w, W_OLD)
    ipk := rowid_col(e, t)
    arr := wget(e, w, W_IDX)
    keys := wget(e, w, W_KEYREG)
    for k in 0usize..wget(e, w, W_NIDX) {
        x := ldu(e.ws, arr + k * IDX_ENTRY)
        ic := ldu(e.ws, arr + k * IDX_ENTRY + 4)
        n := obj_ncol(e, x)
        if !index_applies(e, w, k, true)? {
            continue
        }
        index_key(e, w, k, old, rowid, true)?
        for i in 0usize..n {
            c2 := idx_col(e, x, i)
            if c2 != NO_COL && c2 != ipk && c2 != EXPR_COL {
                let affinity = col_aff(e, t, c2)
                apply_affinity(e, keys + i, affinity)?
            }
        }
        let nt = index_ntail(e, x)
        if seek_index(e, ic, keys, n + nt)? == 0 {
            cur_delete(e, ic)?
        }
    }
    ok()
}

// sqlite_sequence: (name, seq) rows.
fn read_sequence(e: &mut Engine, w: usize) -> (i64, i64)!db.Error {
    seq := wget(e, w, W_SEQ) - 1
    sc := wget(e, w, W_SEQCUR)
    t := wget(e, w, W_TABLE)
    let root = obj_root(e, seq)
    cur_open(e, sc, root, false)
    more := cur_first(e, sc)?
    for more {
        let (p, n) = cur_payload(e, sc)?
        record_column(e, p, n, 0, R_TMP)?
        let off = roff(e, R_TMP)
        let len = rlen(e, R_TMP)
        let name = obj_u(e, t, O_NAME)
        let name_len = obj_u(e, t, O_NAMEL)
        if rtype(e, R_TMP) == T_TEXT && names_eq_exact(e, off, len, name, name_len) {
            record_column(e, p, n, 1, R_TMP)?
            return ok((to_int(e, R_TMP), cur_rowid(e, sc)))
        }
        more = cur_next(e, sc)?
    }
    ok((0i64, 0i64))
}

fn write_sequence(e: &mut Engine, w: usize, value: i64, row: i64) -> void!db.Error {
    seq := wget(e, w, W_SEQ) - 1
    sc := wget(e, w, W_SEQCUR)
    t := wget(e, w, W_TABLE)
    let root = obj_root(e, seq)
    cur_open(e, sc, root, false)
    rowid := row
    if rowid == 0 {
        rowid = 1
        if cur_last(e, sc)? {
            rowid = cur_rowid(e, sc) + 1
        }
    }
    save := e.rtop
    r := reg_push(e)?
    r2 := reg_push(e)?
    if r2 != r + 1 {
        return err(fail(e, SQLITE_INTERNAL, "register stack"))
    }
    let name = obj_u(e, t, O_NAME)
    let name_len = obj_u(e, t, O_NAMEL)
    set_bytes(e, r, T_TEXT, name, name_len)
    set_int(e, r2, value)
    size := record_size(e, r, 2)
    rec := arena_alloc(e, size)?
    record_write(e, r, 2, rec)
    e.rtop = save
    table_insert(e, sc, rowid, rec, size)
}

// ---------------------------------------------------------------------------
// UPDATE and DELETE: a synthesized "SELECT rowid FROM t WHERE ..." finds the
// rows first; changes are applied afterwards.

fn synth_select(e: &mut Engine, s: usize, t: usize) -> usize!db.Error {
    sel := new_node(e, S_SELECT)?
    src := new_node(e, N_SRC)?
    let s_a = na(e, s)
    set_nf(e, src, 0, s_a)
    let s_b = nb(e, s)
    set_nf(e, src, 1, s_b)
    set_nf(e, sel, 1, src)
    // The result is the rowid of the scanned table, or the PRIMARY KEY of
    // a WITHOUT ROWID table.
    nres := if is_wr(e, t) {
        pk_count(e, t)
    } else {
        1usize
    }
    head := 0usize
    tail := 0usize
    for _ in 0usize..nres {
        rc := new_node(e, N_RESCOL)?
        ph := new_node(e, N_NULL)?
        set_nf(e, rc, 0, ph)
        let (h, tl) = list_append(e, head, tail, rc)
        head = h
        tail = tl
    }
    set_nf(e, sel, 0, head)
    let s_d = ndd(e, s)
    set_nf(e, sel, 2, s_d)
    resolve_select(e, sel)?
    c := (nx(e, src) & 0xffffffffu64) as usize
    rc2 := head
    k := 0usize
    for rc2 != 0 {
        ph2 := na(e, rc2)
        set_kind(e, ph2, N_COL)
        set_nf(e, ph2, 0, c)
        let col = if is_wr(e, t) {
            pk_col(e, t, k)
        } else {
            NO_COL
        }
        set_nf(e, ph2, 1, col)
        set_nf(e, ph2, 2, t)
        k += 1
        rc2 = nnext(e, rc2)
    }
    ok(sel)
}

fn resolve_update(e: &mut Engine, s: usize) -> void!db.Error {
    let s_a0 = na(e, s)
    let s_b0 = nb(e, s)
    view := view_target(e, s_a0, s_b0, TE_UPDATE)
    if view != 0 {
        resolve_view_update(e, s, view)?
    } else {
        resolve_update_table(e, s)?
    }
    w := sget_w(e, s)
    t := wget(e, w, W_TABLE)
    compile_triggers(e, s, w, t, TE_UPDATE)?
    view_needs_trigger(e, w)
}

fn resolve_view_update(e: &mut Engine, s: usize, view: usize) -> void!db.Error {
    t := view_columns(e, view - 1)?
    w := write_info(e, s, t)?
    stu(e.ws, w + W_VIEW, view)
    ncol := obj_ncol(e, t)
    told := alloc_regs(e, ncol + 1)?
    stu(e.ws, w + W_TOLD, told)
    sel := view_rows_select(e, s)?
    stu(e.ws, w + W_SEL, sel)
    let s_c = nc(e, s)
    nset := list_len(e, s_c)
    sets := pool_alloc(e, nset * 8 + 4)?
    st := nc(e, s)
    k := 0usize
    for st != 0 {
        let st_a = na(e, st)
        let st_b = nb(e, st)
        col := find_column(e, t, st_a, st_b)
        if col == NO_COL {
            return err(fail2(e, SQLITE_ERROR, "no such column: ", st_a, st_b))
        }
        let x = nc(e, st)
        e.regctx_t = t
        e.regctx_base = told
        res := resolve_expr(e, x, 0, false)
        e.regctx_t = NO_COL
        res?
        stu(e.ws, sets + k * 8, col)
        stu(e.ws, sets + k * 8 + 4, x)
        k += 1
        st = nnext(e, st)
    }
    stu(e.ws, w + W_SETS, sets)
    stu(e.ws, w + W_NSET, nset)
    ok()
}

fn resolve_update_table(e: &mut Engine, s: usize) -> void!db.Error {
    let s_a = na(e, s)
    let s_b = nb(e, s)
    t := table_for_write(e, s_a, s_b)?
    w := write_info(e, s, t)?
    sel := synth_select(e, s, t)?
    stu(e.ws, w + W_SEL, sel)
    ncol := obj_ncol(e, t)
    // SET targets resolve against the scanned table.
    let s_c = nc(e, s)
    nset := list_len(e, s_c)
    sets := pool_alloc(e, nset * 8 + 4)?
    st := nc(e, s)
    k := 0usize
    src := nb(e, sel)
    ctx_push(e, src, 0)?
    for st != 0 {
        let st_a = na(e, st)
        let st_b = nb(e, st)
        col := find_column(e, t, st_a, st_b)
        if col == NO_COL {
            let st_a2 = na(e, st)
            let st_b2 = nb(e, st)
            if is_rowid_name(e, st_a2, st_b2) {
                col = ROWID_TARGET
            } else {
                ctx_pop(e)
                e.msg_len = 0
                msg_add(e, "no such column: ")
                let st_a3 = na(e, st)
                let st_b3 = nb(e, st)
                msg_add_ws(e, st_a3, st_b3)
                return err(make_error(e, SQLITE_ERROR))
            }
        } else if col == rowid_col(e, t) {
            col = ROWID_TARGET
        }
        let st_c = nc(e, st)
        match resolve_expr(e, st_c, 0, false) {
            ok() => {},
            err(reason) => {
                ctx_pop(e)
                return err(reason)
            },
        }
        stu(e.ws, sets + k * 8, col)
        let st_c2 = nc(e, st)
        stu(e.ws, sets + k * 8 + 4, st_c2)
        k += 1
        st = nnext(e, st)
    }
    ctx_pop(e)
    stu(e.ws, w + W_SETS, sets)
    stu(e.ws, w + W_NSET, nset)
    if ncol == 0 {
        return err(corrupt(e))
    }
    ok()
}

// Collects matching rowids on the sort stack; returns (start, count).
fn collect_rowids(e: &mut Engine, sel: usize) -> (usize, usize)!db.Error {
    select_reset(e, sel)
    resreg := select_resreg(e, sel)
    start := e.sort_top
    n := 0usize
    mark := e.arena_top
    for select_next(e, sel)? {
        o := sort_alloc(e, 8)?
        let bits = i2u(rint(e, resreg))
        st64(e.ws, o, bits)
        n += 1
        arena_reset(e, mark)
    }
    ok((start, n))
}

fn exec_update(e: &mut Engine, s: usize) -> void!db.Error {
    w := sget_w(e, s)
    if wget(e, w, W_VIEW) != 0 {
        return exec_view_update(e, w)
    }
    has_before := has_triggers(e, w, trig_mask(TE_UPDATE, TT_BEFORE))
    has_after := has_triggers(e, w, trig_mask(TE_UPDATE, TT_AFTER))
    sel := wget(e, w, W_SEL)
    t := wget(e, w, W_TABLE)
    wr := is_wr(e, t)
    let (start, n) = if wr {
        let npk0 = pk_count(e, t)
        wr_collect(e, sel, npk0)?
    } else {
        collect_rowids(e, sel)?
    }
    e.ret_start = e.sort_top
    // Rows were collected; open the write cursors (the scan used its own).
    open_write_cursors(e, w)
    base := wget(e, w, W_BASE)
    ncol := wget(e, w, W_NCOL)
    ipk := rowid_col(e, t)
    conf := wget(e, w, W_CONF) as u8
    sets := wget(e, w, W_SETS)
    nset := wget(e, w, W_NSET)
    sinfo_ := sinfo(e, sel)
    scan := ldu(e.ws, lev(e, sinfo_, 0) + L_CUR)
    pk := wget(e, w, W_PK)
    for i in 0usize..n {
        mark := e.arena_top
        rowid := 0i64
        if wr {
            let krec = ldu(e.ws, start + i * 4)
            wr_take_identity(e, w, krec)?
            open_table_cursor(e, scan, t)
            if !wr_seek(e, scan, t, pk)? {
                arena_reset(e, mark)
                continue
            }
            wr_load_row(e, t, scan, base)?
        } else {
            rowid = u2i(ld64(e.ws, start + i * 8))
            let root = obj_root(e, t)
            cur_open(e, scan, root, false)
            if !seek_rowid(e, scan, rowid)? {
                continue
            }
            // Start from the old values.
            let (p, len) = cur_payload(e, scan)?
            for k in 0usize..ncol {
                if k == ipk {
                    set_int(e, base + k, rowid)
                } else if !record_column(e, p, len, k, base + k)? {
                    column_default(e, t, k, base + k)?
                }
            }
            set_int(e, base + ncol, rowid)
        }
        if has_before || has_after {
            load_trigger_old(e, w, base)?
        }
        // Evaluate every SET expression against the old row first.
        save := e.rtop
        first := e.rtop
        for k in 0usize..nset {
            r := reg_push(e)?
            let ldu2 = ldu(e.ws, sets + k * 8 + 4)
            eval(e, ldu2, r)?
        }
        for k in 0usize..nset {
            col := ldu(e.ws, sets + k * 8)
            if col == ROWID_TARGET {
                copy_reg(e, base + ncol, first + k)
                if ipk != NO_COL {
                    copy_reg(e, base + ipk, first + k)
                }
            } else {
                copy_reg(e, base + col, first + k)
            }
        }
        for k in 0usize..(ncol + 1) {
            reg_own(e, base + k)?
        }
        e.rtop = save
        if !wr && rtype(e, base + ncol) == T_NULL {
            return err(fail(e, SQLITE_MISMATCH, "datatype mismatch"))
        }
        if has_before {
            for k in 0usize..ncol {
                if k != ipk {
                    let aff = col_aff(e, t, k)
                    apply_affinity(e, base + k, aff)?
                }
            }
            if !fire_triggers(e, w, trig_mask(TE_UPDATE, TT_BEFORE))? {
                arena_reset(e, mark)
                continue
            }
            // The trigger may have deleted the row or changed the columns
            // this UPDATE does not assign.
            open_table_cursor(e, scan, t)
            still := if wr {
                wr_seek(e, scan, t, pk)?
            } else {
                seek_rowid(e, scan, rowid)?
            }
            if !still {
                arena_reset(e, mark)
                continue
            }
            let (p2, len2) = cur_payload(e, scan)?
            for k in 0usize..ncol {
                assigned := false
                for j in 0usize..nset {
                    if ldu(e.ws, sets + j * 8) == k {
                        assigned = true
                    }
                }
                if assigned || k == ipk {
                    continue
                }
                if !row_column(e, t, p2, len2, k, base + k)? {
                    column_default(e, t, k, base + k)?
                }
                reg_own(e, base + k)?
            }
        }
        written := write_row(e, w, conf, true, rowid)?
        if written && has_after {
            fire_triggers(e, w, trig_mask(TE_UPDATE, TT_AFTER))?
        }
        arena_reset(e, mark)
    }
    ok()
}

fn resolve_delete(e: &mut Engine, s: usize) -> void!db.Error {
    let s_a = na(e, s)
    let s_b = nb(e, s)
    view := view_target(e, s_a, s_b, TE_DELETE)
    if view != 0 {
        t := view_columns(e, view - 1)?
        w := write_info(e, s, t)?
        stu(e.ws, w + W_VIEW, view)
        let ncol = obj_ncol(e, t)
        told := alloc_regs(e, ncol + 1)?
        stu(e.ws, w + W_TOLD, told)
        sel := view_rows_select(e, s)?
        stu(e.ws, w + W_SEL, sel)
        compile_triggers(e, s, w, t, TE_DELETE)?
        return view_needs_trigger(e, w)
    }
    t := table_for_write(e, s_a, s_b)?
    w := write_info(e, s, t)?
    sel := synth_select(e, s, t)?
    stu(e.ws, w + W_SEL, sel)
    compile_triggers(e, s, w, t, TE_DELETE)
}

fn exec_delete(e: &mut Engine, s: usize) -> void!db.Error {
    w := sget_w(e, s)
    if wget(e, w, W_VIEW) != 0 {
        return exec_view_delete(e, w)
    }
    t := wget(e, w, W_TABLE)
    has_before := has_triggers(e, w, trig_mask(TE_DELETE, TT_BEFORE))
    has_after := has_triggers(e, w, trig_mask(TE_DELETE, TT_AFTER))
    if ndd(e, s) == 0 && wget(e, w, W_RET) == 0 && !has_before && !has_after {
        // DELETE without WHERE: clear the table and its indexes.
        let root = obj_root(e, t)
        count := btree_count(e, root, MAX_DEPTH)?
        let root2 = obj_root(e, t)
        btree_clear(e, root2)?
        arr := wget(e, w, W_IDX)
        for k in 0usize..wget(e, w, W_NIDX) {
            x := ldu(e.ws, arr + k * IDX_ENTRY)
            let root3 = obj_root(e, x)
            btree_clear(e, root3)?
        }
        e.changes += count
        return ok()
    }
    sel := wget(e, w, W_SEL)
    wr := is_wr(e, t)
    let (start, n) = if wr {
        let npk0 = pk_count(e, t)
        wr_collect(e, sel, npk0)?
    } else {
        collect_rowids(e, sel)?
    }
    e.ret_start = e.sort_top
    open_write_cursors(e, w)
    c := wget(e, w, W_CUR)
    pk := wget(e, w, W_PK)
    for i in 0usize..n {
        mark := e.arena_top
        rowid := 0i64
        if wr {
            let krec = ldu(e.ws, start + i * 4)
            wr_take_identity(e, w, krec)?
            if !wr_seek(e, c, t, pk)? {
                arena_reset(e, mark)
                continue
            }
        } else {
            rowid = u2i(ld64(e.ws, start + i * 8))
        }
        if has_before || has_after {
            if !load_old_row(e, w, rowid)? {
                arena_reset(e, mark)
                continue
            }
            let old0 = wget(e, w, W_OLD)
            load_trigger_old(e, w, old0)?
        }
        if has_before {
            if !fire_triggers(e, w, trig_mask(TE_DELETE, TT_BEFORE))? {
                arena_reset(e, mark)
                continue
            }
            still := if wr {
                wr_seek(e, c, t, pk)?
            } else {
                seek_rowid(e, c, rowid)?
            }
            if !still {
                arena_reset(e, mark)
                continue
            }
        }
        delete_row(e, w, rowid)?
        e.changes += 1
        push_returning(e, w)?
        if has_after {
            fire_triggers(e, w, trig_mask(TE_DELETE, TT_AFTER))?
        }
        arena_reset(e, mark)
    }
    ok()
}

// Decodes row `rowid` into the W_OLD registers; false when it is gone.
fn load_old_row(e: &mut Engine, w: usize, rowid: i64) -> bool!db.Error {
    t := wget(e, w, W_TABLE)
    c := wget(e, w, W_CUR)
    old := wget(e, w, W_OLD)
    ncol := wget(e, w, W_NCOL)
    if is_wr(e, t) {
        let pk = wget(e, w, W_PK)
        if !wr_seek(e, c, t, pk)? {
            return ok(false)
        }
        wr_load_row(e, t, c, old)?
        return ok(true)
    }
    if !seek_rowid(e, c, rowid)? {
        return ok(false)
    }
    ipk := rowid_col(e, t)
    let (p, len) = cur_payload(e, c)?
    for i in 0usize..ncol {
        if i == ipk {
            set_int(e, old + i, rowid)
        } else if !record_column(e, p, len, i, old + i)? {
            column_default(e, t, i, old + i)?
        }
        reg_own(e, old + i)?
    }
    set_int(e, old + ncol, rowid)
    ok(true)
}
