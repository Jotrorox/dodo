package sqlite

import "std/db"

// CREATE / DROP / ALTER and sqlite_schema maintenance.

const SCHEMA_CUR: usize = 46

// Inserts a sqlite_schema row; returns its rowid. `sql` may be 0 (NULL).
fn schema_insert(e: &mut Engine, kind: &str, name: usize, nl: usize, tbl: usize, tl: usize, root: u32, sql: usize, sqll: usize) -> i64!db.Error {
    c := SCHEMA_CUR
    cur_open(e, c, 1, false)
    rowid := 1i64
    if cur_last(e, c)? {
        rowid = cur_rowid(e, c) + 1
    }
    save := e.rtop
    r := e.rtop
    for _ in 0usize..5 {
        reg_push(e)?
    }
    set_text_str(e, r, kind)?
    set_bytes(e, r + 1, T_TEXT, name, nl)
    set_bytes(e, r + 2, T_TEXT, tbl, tl)
    set_int(e, r + 3, root as i64)
    if sqll == 0 && sql == 0 {
        set_null(e, r + 4)
    } else {
        set_bytes(e, r + 4, T_TEXT, sql, sqll)
    }
    size := record_size(e, r, 5)
    rec := arena_alloc(e, size)?
    record_write(e, r, 5, rec)
    e.rtop = save
    table_insert(e, c, rowid, rec, size)?
    ok(rowid)
}

fn schema_delete(e: &mut Engine, rowid: i64) -> void!db.Error {
    c := SCHEMA_CUR
    cur_open(e, c, 1, false)
    if seek_rowid(e, c, rowid)? {
        cur_delete(e, c)?
    }
    ok()
}

// Rewrites the sql column of schema row `rowid`.
fn schema_update(e: &mut Engine, rowid: i64, name: usize, nl: usize, tbl: usize, tl: usize, sql: usize, sqll: usize, sql_null: bool) -> void!db.Error {
    c := SCHEMA_CUR
    cur_open(e, c, 1, false)
    if !seek_rowid(e, c, rowid)? {
        return err(corrupt(e))
    }
    let (p, n) = cur_payload(e, c)?
    save := e.rtop
    r := e.rtop
    for _ in 0usize..5 {
        reg_push(e)?
    }
    record_column(e, p, n, 0, r)?
    set_bytes(e, r + 1, T_TEXT, name, nl)
    set_bytes(e, r + 2, T_TEXT, tbl, tl)
    record_column(e, p, n, 3, r + 3)?
    if sql_null {
        set_null(e, r + 4)
    } else {
        set_bytes(e, r + 4, T_TEXT, sql, sqll)
    }
    size := record_size(e, r, 5)
    rec := arena_alloc(e, size)?
    record_write(e, r, 5, rec)
    e.rtop = save
    table_insert(e, c, rowid, rec, size)
}

// Increments the current database's schema cookie and reloads the catalog.
fn schema_changed(e: &mut Engine) -> void!db.Error {
    schema_cookie_bump(e)?
    load_schema(e)
}

fn schema_cookie_bump(e: &mut Engine) -> void!db.Error {
    cookie := hdr_get(e, 40)?
    hdr_set(e, 40, core.wrapping_add(cookie, 1u32))?
    if hdr_get(e, 44)? < 4 {
        // New features may need the newest schema format.
        hdr_set(e, 44, 4)?
        e.schema_format = 4
    }
    e.schema_cookie = core.wrapping_add(cookie, 1u32)
    e.schema_loaded = false
    ok()
}

fn name_taken(e: &mut Engine, d: usize, o: usize, l: usize) -> db.Error {
    t := find_obj(e, d, 0, o, l)
    e.msg_len = 0
    if t != NO_COL && obj_type(e, t) == OT_INDEX {
        msg_add(e, "there is already an index named ")
    } else {
        msg_add(e, "table ")
        msg_add_ws(e, o, l)
        msg_add(e, " already exists")
        return make_error(e, SQLITE_ERROR)
    }
    msg_add_ws(e, o, l)
    make_error(e, SQLITE_ERROR)
}

fn reserved_name(e: &Engine, o: usize, l: usize) -> bool {
    l >= 7 && name_is(e, o, 7, "sqlite_")
}

// Writes "<prefix><text from start to end>" into the arena.
fn normalized_sql(e: &mut Engine, prefix: &str, start: usize, end: usize) -> (usize, usize)!db.Error {
    p := mem_bytes(prefix)
    len := p.len + (end - start)
    o := arena_alloc(e, len)?
    copy_in(e.ws, o, p)
    move_bytes(e.ws, start, o + p.len, end - start)
    ok((o, len))
}

fn exec_create_table(e: &mut Engine, s: usize) -> void!db.Error {
    name := na(e, s)
    nl := nb(e, s)
    d := stmt_target_db(e, s)
    enter_db(e, d)?
    if find_obj(e, d, 0, name, nl) != NO_COL {
        if (nflags(e, s) & 1) != 0 && find_obj(e, d, OT_TABLE, name, nl) != NO_COL {
            return ok()
        }
        return err(name_taken(e, d, name, nl))
    }
    if reserved_name(e, name, nl) && !name_is(e, name, nl, "sqlite_sequence") {
        e.msg_len = 0
        msg_add(e, "object name reserved for internal use: ")
        msg_add_ws(e, name, nl)
        return err(make_error(e, SQLITE_ERROR))
    }
    // Validate the definition by building a catalog entry.
    t := new_obj(e)?
    o := obj(e, t)
    e.ws[o + O_TYPE] = OT_TABLE
    e.ws[o + O_DB] = d as u8
    stu(e.ws, o + O_NAME, name)
    stu(e.ws, o + O_NAMEL, nl)
    table_from_ast(e, t, s)?
    // AUTOINCREMENT is only allowed on an INTEGER PRIMARY KEY.
    if (obj_flags(e, t) & OF_AUTOINC) != 0 && rowid_col(e, t) == NO_COL {
        e.schema_objs -= 1
        return err(fail(e, SQLITE_ERROR, "AUTOINCREMENT is only allowed on an INTEGER PRIMARY KEY"))
    }
    nauto := autoindex_constraint(e, t, s, 0)?
    autoinc := (obj_flags(e, t) & OF_AUTOINC) != 0
    wr := is_wr(e, t)
    skip_auto := if wr {
        autoindex_pk_number(e, t, s)
    } else {
        0usize
    }
    e.schema_objs -= 1
    let s_e = ne_(e, s)
    let s_f = nff(e, s)
    let (sql, sqll) = normalized_sql(e, "CREATE TABLE ", s_e, s_f)?
    root := btree_create(e, wr)?
    schema_insert(e, "table", name, nl, name, nl, root, sql, sqll)?
    // Automatic indexes for PRIMARY KEY and UNIQUE constraints.
    for k in 1usize..(nauto + 1) {
        if k == skip_auto {
            continue
        }
        buf := [0u8; 300]
        b := mem_bytes("sqlite_autoindex_")
        m := 0usize
        for i in 0usize..b.len {
            buf[m] = b[i]
            m += 1
        }
        for i in 0usize..nl {
            if m < 270 {
                buf[m] = e.ws[name + i]
                m += 1
            }
        }
        buf[m] = 95
        m += 1
        digits := [0u8; 24]
        dn := format_i64(&mut digits, k as i64)
        for i in 0usize..dn {
            buf[m] = digits[i]
            m += 1
        }
        io := arena_alloc(e, m)?
        copy_in(e.ws, io, &buf[..m])
        iroot := btree_create(e, true)?
        schema_insert(e, "index", io, m, name, nl, iroot, 0, 0)?
    }
    if autoinc {
        seqo := arena_alloc(e, 15)?
        copy_in(e.ws, seqo, mem_bytes("sqlite_sequence"))
        if find_obj(e, d, OT_TABLE, seqo, 15) == NO_COL {
            sroot := btree_create(e, false)?
            sq := mem_bytes("CREATE TABLE sqlite_sequence(name,seq)")
            so := arena_alloc(e, sq.len)?
            copy_in(e.ws, so, sq)
            schema_insert(e, "table", seqo, 15, seqo, 15, sroot, so, sq.len)?
        }
    }
    schema_changed(e)
}

fn exec_create_view(e: &mut Engine, s: usize) -> void!db.Error {
    name := na(e, s)
    nl := nb(e, s)
    d := stmt_target_db(e, s)
    enter_db(e, d)?
    if find_obj(e, d, 0, name, nl) != NO_COL {
        if (nflags(e, s) & 1) != 0 && find_obj(e, d, OT_VIEW, name, nl) != NO_COL {
            return ok()
        }
        e.msg_len = 0
        let value = if find_obj(e, d, OT_VIEW, name, nl) != NO_COL {
            "view "
        } else {
            "table "
        }
        msg_add(e, value)
        msg_add_ws(e, name, nl)
        msg_add(e, " already exists")
        return err(make_error(e, SQLITE_ERROR))
    }
    if reserved_name(e, name, nl) {
        e.msg_len = 0
        msg_add(e, "object name reserved for internal use: ")
        msg_add_ws(e, name, nl)
        return err(make_error(e, SQLITE_ERROR))
    }
    if d != DB_TEMP {
        check_fixed_refs(e, "view", name, nl, d, false)?
    }
    let start = ne_(e, s)
    let end = nff(e, s)
    let (sql, sqll) = normalized_sql(e, "CREATE VIEW ", start, end)?
    schema_insert(e, "view", name, nl, name, nl, 0, sql, sqll)?
    schema_changed(e)
}

fn exec_create_index(e: &mut Engine, s: usize) -> void!db.Error {
    name := na(e, s)
    nl := nb(e, s)
    // The index goes into its table's database.
    d := stmt_target_db(e, s)
    enter_db(e, d)?
    if find_obj(e, d, 0, name, nl) != NO_COL {
        if (nflags(e, s) & 1) != 0 && find_obj(e, d, OT_INDEX, name, nl) != NO_COL {
            return ok()
        }
        return err(name_taken(e, d, name, nl))
    }
    if reserved_name(e, name, nl) {
        e.msg_len = 0
        msg_add(e, "object name reserved for internal use: ")
        msg_add_ws(e, name, nl)
        return err(make_error(e, SQLITE_ERROR))
    }
    let s_c = nc(e, s)
    let s_d = ndd(e, s)
    t := find_obj(e, d, OT_TABLE, s_c, s_d)
    if t == NO_COL {
        e.msg_len = 0
        msg_add(e, "no such table: ")
        let s_c2 = nc(e, s)
        let s_d2 = ndd(e, s)
        msg_add_ws(e, s_c2, s_d2)
        return err(make_error(e, SQLITE_ERROR))
    }
    let s_c3 = nc(e, s)
    let s_d3 = ndd(e, s)
    if reserved_name(e, s_c3, s_d3) {
        return err(fail(e, SQLITE_ERROR, "table sqlite_master may not be indexed"))
    }
    // Validate columns through a temporary catalog entry.
    x := new_obj(e)?
    o := obj(e, x)
    e.ws[o + O_TYPE] = OT_INDEX
    e.ws[o + O_DB] = d as u8
    stu(e.ws, o + O_TABLE, t)
    match index_from_ast(e, x, t, s) {
        ok() => {},
        err(reason) => {
            e.schema_objs -= 1
            return err(reason)
        },
    }
    index_add_tail(e, x, t)?
    unique := (nflags(e, s) & 2) != 0
    prefix := if unique {
        "CREATE UNIQUE INDEX "
    } else {
        "CREATE INDEX "
    }
    let s_f = nff(e, s)
    let s_g = ng(e, s)
    let (sql, sqll) = normalized_sql(e, prefix, s_f, s_g)?
    root := btree_create(e, true)?
    let obj2 = obj(e, x) + O_ROOT
    st32(e.ws, obj2, root)
    // Populate from the table.
    tc := SCHEMA_CUR - 1
    ic := SCHEMA_CUR - 2
    open_table_cursor(e, tc, t)
    open_index_cursor(e, ic, x)
    n := obj_ncol(e, x)
    nt := index_ntail(e, x)
    wr := is_wr(e, t)
    ipk := rowid_col(e, t)
    ncol := obj_ncol(e, t)
    save := e.rtop
    keys := e.rtop
    for _ in 0usize..(n + nt) {
        reg_push(e)?
    }
    // Expression and partial indexes evaluate against the whole row.
    base := e.rtop
    for _ in 0usize..(ncol + 1) {
        reg_push(e)?
    }
    e.reg_alloc = e.rtop
    exprs := match index_exprs(e, x, t, base) {
        ok(v) => v,
        err(reason) => {
            e.rtop = save
            e.schema_objs -= 1
            return err(reason)
        },
    }
    if e.reg_alloc > e.rtop {
        e.rtop = e.reg_alloc
    }
    more := cur_first(e, tc)?
    for more {
        mark := e.arena_top
        rowid := if wr {
            0i64
        } else {
            cur_rowid(e, tc)
        }
        let (p, len) = cur_payload(e, tc)?
        any_null := false
        skip := false
        full := exprs != 0 || wr
        if full {
            for c2 in 0usize..ncol {
                if c2 == ipk {
                    set_int(e, base + c2, rowid)
                } else if !row_column(e, t, p, len, c2, base + c2)? {
                    column_default(e, t, c2, base + c2)?
                }
                reg_own(e, base + c2)?
            }
            set_int(e, base + ncol, rowid)
        }
        if exprs != 0 {
            cond := ldu(e.ws, exprs + n * 4)
            if cond != 0 && eval_truth(e, cond)? != 1 {
                skip = true
            }
        }
        for k in 0usize..n {
            c := idx_col(e, x, k)
            if skip {
                break
            }
            if c == EXPR_COL {
                let node = ldu(e.ws, exprs + k * 4)
                eval(e, node, keys + k)?
                reg_own(e, keys + k)?
                if rtype(e, keys + k) == T_NULL {
                    any_null = true
                }
            } else if c == NO_COL || c == ipk {
                set_int(e, keys + k, rowid)
            } else {
                if full {
                    copy_reg(e, keys + k, base + c)
                } else if !record_column(e, p, len, c, keys + k)? {
                    column_default(e, t, c, keys + k)?
                }
                if rtype(e, keys + k) == T_NULL {
                    any_null = true
                }
            }
        }
        if wr {
            for j in 0usize..nt {
                let tcol = tail_col(e, x, j)
                copy_reg(e, keys + n + j, base + tcol)
            }
        } else {
            set_int(e, keys + n, rowid)
        }
        if skip {
            arena_reset(e, mark)
            more = cur_next(e, tc)?
            continue
        }
        if unique && !any_null {
            if seek_index(e, ic, keys, n)? == 0 {
                e.rtop = save
                e.schema_objs -= 1
                return err(constraint_fail(e, SQLITE_CONSTRAINT_UNIQUE, "UNIQUE", t, 0, n, x))
            }
        }
        size := record_size(e, keys, n + nt)
        rec := arena_alloc(e, size)?
        record_write(e, keys, n + nt, rec)
        index_insert(e, ic, rec, size)?
        arena_reset(e, mark)
        // The table cursor is unaffected by index inserts; continue.
        more = cur_next(e, tc)?
    }
    e.rtop = save
    e.schema_objs -= 1
    tname := obj_u(e, t, O_NAME)
    tl := obj_u(e, t, O_NAMEL)
    schema_insert(e, "index", name, nl, tname, tl, root, sql, sqll)?
    schema_changed(e)
}

fn exec_drop(e: &mut Engine, s: usize) -> void!db.Error {
    name := na(e, s)
    nl := nb(e, s)
    kind := if nop(e, s) == 1 {
        OT_TABLE
    } else if nop(e, s) == 3 {
        OT_VIEW
    } else if nop(e, s) == 4 {
        OT_TRIGGER
    } else {
        OT_INDEX
    }
    let q = ndb_of(e, s)
    i := find_obj(e, q, kind, name, nl)
    if i == NO_COL {
        if (nflags(e, s) & 1) != 0 {
            return ok()
        }
        e.msg_len = 0
        msg_add(e, if kind == OT_TABLE {
            "no such table: "
        } else if kind == OT_VIEW {
            "no such view: "
        } else if kind == OT_TRIGGER {
            "no such trigger: "
        } else {
            "no such index: "
        })
        msg_add_ws(e, name, nl)
        return err(make_error(e, SQLITE_ERROR))
    }
    d := obj_db(e, i)
    enter_db(e, d)?
    temp_changed := false
    if kind == OT_TABLE {
        if reserved_name(e, name, nl) && !name_is(e, name, nl, "sqlite_sequence") || obj_root(e, i) == 1 {
            return err(fail(e, SQLITE_ERROR, "table sqlite_master may not be dropped"))
        }
        // Indexes and triggers of the table go with it (TEMP triggers on
        // it too).
        for j in 0usize..e.schema_objs {
            k := obj_type(e, j)
            let tbl = obj_u(e, j, O_TBL)
            let tbl_len = obj_u(e, j, O_TBLL)
            let jd = obj_db(e, j)
            link := obj_u(e, j, O_TABLE)
            mine := jd == d && names_eq(e, tbl, tbl_len, name, nl) && (k == OT_INDEX || k == OT_TRIGGER && (link == i || link == NO_COL))
            other := jd != d && k == OT_TRIGGER && link == i
            if mine {
                if k == OT_INDEX && obj_root(e, j) != 0 {
                    let root = obj_root(e, j)
                    btree_drop(e, root)?
                }
                let schema_rowid = obj_u(e, j, O_ROWNO) as i64
                schema_delete(e, schema_rowid)?
            } else if other {
                let schema_rowid_t = obj_u(e, j, O_ROWNO) as i64
                use_db(e, jd)
                schema_delete(e, schema_rowid_t)?
                use_db(e, d)
                temp_changed = true
            }
        }
        let root2 = obj_root(e, i)
        btree_drop(e, root2)?
        let schema_rowid2 = obj_u(e, i, O_ROWNO) as i64
        schema_delete(e, schema_rowid2)?
        // Forget its AUTOINCREMENT sequence.
        for j in 0usize..e.schema_objs {
            let name2 = obj_u(e, j, O_NAME)
            let name_len = obj_u(e, j, O_NAMEL)
            if obj_type(e, j) == OT_TABLE && obj_db(e, j) == d && name_is(e, name2, name_len, "sqlite_sequence") {
                let root3 = obj_root(e, j)
                drop_sequence_row(e, root3, name, nl)?
            }
        }
    } else if kind == OT_VIEW {
        for j in 0usize..e.schema_objs {
            if obj_type(e, j) == OT_TRIGGER && obj_u(e, j, O_TABLE) == i {
                let trow = obj_u(e, j, O_ROWNO) as i64
                let jd2 = obj_db(e, j)
                use_db(e, jd2)
                schema_delete(e, trow)?
                use_db(e, d)
                if jd2 != d {
                    temp_changed = true
                }
            }
        }
        let rowno = obj_u(e, i, O_ROWNO) as i64
        schema_delete(e, rowno)?
    } else if kind == OT_TRIGGER {
        let trow2 = obj_u(e, i, O_ROWNO) as i64
        schema_delete(e, trow2)?
    } else {
        if (obj_flags(e, i) & OF_AUTO) != 0 || obj_u(e, i, O_SQLL) == 0 {
            return err(fail(e, SQLITE_ERROR, "index associated with UNIQUE or PRIMARY KEY constraint cannot be dropped"))
        }
        let root4 = obj_root(e, i)
        btree_drop(e, root4)?
        let schema_rowid3 = obj_u(e, i, O_ROWNO) as i64
        schema_delete(e, schema_rowid3)?
    }
    if temp_changed {
        use_db(e, DB_TEMP)
        schema_cookie_bump(e)?
        use_db(e, d)
    }
    schema_changed(e)
}

fn drop_sequence_row(e: &mut Engine, root: u32, name: usize, nl: usize) -> void!db.Error {
    c := SCHEMA_CUR - 1
    cur_open(e, c, root, false)
    more := cur_first(e, c)?
    for more {
        let (p, n) = cur_payload(e, c)?
        record_column(e, p, n, 0, R_TMP)?
        let off = roff(e, R_TMP)
        let len = rlen(e, R_TMP)
        if rtype(e, R_TMP) == T_TEXT && names_eq_exact(e, off, len, name, nl) {
            cur_delete(e, c)?
            return ok()
        }
        more = cur_next(e, c)?
    }
    ok()
}

// Finds the span of the first identifier token after `from` in [o, o+l)
// that names `name` (quoted or not). Returns (start, end) or (0, 0).
fn find_name_token(e: &mut Engine, o: usize, l: usize, skip: usize, name: usize, nl: usize) -> (usize, usize) {
    e.src = o
    e.src_end = o + l
    e.pos = o
    e.ts = o
    e.tl = 0
    e.last_end = o
    next_token(e)
    count := 0usize
    for e.tk != TK_EOF {
        if e.tk == TK_ID || e.tk == TK_QID {
            start := e.ts
            end := e.ts + e.tl
            inner_o := if e.tk == TK_ID {
                start
            } else {
                start + 1
            }
            inner_l := if e.tk == TK_ID {
                e.tl
            } else {
                e.tl - 2
            }
            if names_eq(e, inner_o, inner_l, name, nl) {
                if count == skip {
                    return (start, end)
                }
                count += 1
            }
        }
        next_token(e)
    }
    (0usize, 0usize)
}

// Copies [o, o+l) to the arena replacing [a, b) with `rep`.
fn splice(e: &mut Engine, o: usize, l: usize, a: usize, b: usize, rep: usize, rl: usize) -> (usize, usize)!db.Error {
    len := l - (b - a) + rl
    d := arena_alloc(e, len)?
    move_bytes(e.ws, o, d, a - o)
    move_bytes(e.ws, rep, d + (a - o), rl)
    move_bytes(e.ws, b, d + (a - o) + rl, o + l - b)
    ok((d, len))
}

// Quotes a name if needed: "name" with doubled quotes.
fn quoted_name(e: &mut Engine, o: usize, l: usize) -> (usize, usize)!db.Error {
    quotes := 0usize
    for i in 0usize..l {
        if e.ws[o + i] == 34 {
            quotes += 1
        }
    }
    d := arena_alloc(e, l + quotes + 2)?
    e.ws[d] = 34
    k := 1usize
    for i in 0usize..l {
        b := e.ws[o + i]
        e.ws[d + k] = b
        k += 1
        if b == 34 {
            e.ws[d + k] = 34
            k += 1
        }
    }
    e.ws[d + k] = 34
    ok((d, k + 1))
}

fn exec_alter(e: &mut Engine, s: usize) -> void!db.Error {
    name := na(e, s)
    nl := nb(e, s)
    let q = ndb_of(e, s)
    t := find_obj(e, q, OT_TABLE, name, nl)
    if t != NO_COL {
        let td = obj_db(e, t)
        enter_db(e, td)?
    }
    if t == NO_COL {
        e.msg_len = 0
        msg_add(e, "no such table: ")
        msg_add_ws(e, name, nl)
        return err(make_error(e, SQLITE_ERROR))
    }
    if reserved_name(e, name, nl) {
        e.msg_len = 0
        msg_add(e, "table ")
        msg_add_ws(e, name, nl)
        msg_add(e, " may not be altered")
        return err(make_error(e, SQLITE_ERROR))
    }
    op := nop(e, s)
    sql := obj_u(e, t, O_SQL)
    sqll := obj_u(e, t, O_SQLL)
    if op == 1 {
        // RENAME TO
        nn := nc(e, s)
        nnl := ndd(e, s)
        let adb = obj_db(e, t)
        if find_obj(e, adb, 0, nn, nnl) != NO_COL {
            e.msg_len = 0
            msg_add(e, "there is already another table or index with this name: ")
            msg_add_ws(e, nn, nnl)
            return err(make_error(e, SQLITE_ERROR))
        }
        if reserved_name(e, nn, nnl) {
            return err(fail(e, SQLITE_ERROR, "object name reserved for internal use"))
        }
        // Copy the new name: the statement text stays valid, but be safe.
        nd_ := arena_alloc(e, nnl)?
        move_bytes(e.ws, nn, nd_, nnl)
        let (qo, ql) = quoted_name(e, nd_, nnl)?
        let (a, b) = find_name_token(e, sql, sqll, 0, name, nl)
        if b == 0 {
            return err(corrupt(e))
        }
        let (ns, nsl) = splice(e, sql, sqll, a, b, qo, ql)?
        let schema_rowid = obj_u(e, t, O_ROWNO) as i64
        schema_update(e, schema_rowid, nd_, nnl, nd_, nnl, ns, nsl, false)?
        for j in 0usize..e.schema_objs {
            let tbl = obj_u(e, j, O_TBL)
            let tbl_len = obj_u(e, j, O_TBLL)
            if obj_type(e, j) != OT_INDEX || obj_db(e, j) != adb || !names_eq(e, tbl, tbl_len, name, nl) {
                continue
            }
            isql := obj_u(e, j, O_SQL)
            isqll := obj_u(e, j, O_SQLL)
            if isqll == 0 {
                // sqlite_autoindex_<old>_N becomes sqlite_autoindex_<new>_N.
                iname := obj_u(e, j, O_NAME)
                inl := obj_u(e, j, O_NAMEL)
                pre := 17usize
                suffix := iname + pre + nl
                sl := inl - pre - nl
                newl := pre + nnl + sl
                d := arena_alloc(e, newl)?
                move_bytes(e.ws, iname, d, pre)
                move_bytes(e.ws, nd_, d + pre, nnl)
                move_bytes(e.ws, suffix, d + pre + nnl, sl)
                let schema_rowid2 = obj_u(e, j, O_ROWNO) as i64
                schema_update(e, schema_rowid2, d, newl, nd_, nnl, 0, 0, true)?
            } else {
                // The table name is the first matching identifier after the
                // index name.
                let name2 = obj_u(e, j, O_NAME)
                let name_len = obj_u(e, j, O_NAMEL)
                let value2 = if names_eq(e, name2, name_len, name, nl) {
                    1usize
                } else {
                    0usize
                }
                let (ia, ib) = find_name_token(e, isql, isqll, value2, name, nl)
                if ib == 0 {
                    return err(corrupt(e))
                }
                let (is, isl) = splice(e, isql, isqll, ia, ib, qo, ql)?
                let schema_rowid3 = obj_u(e, j, O_ROWNO) as i64
                let name3 = obj_u(e, j, O_NAME)
                let name_len2 = obj_u(e, j, O_NAMEL)
                schema_update(e, schema_rowid3, name3, name_len2, nd_, nnl, is, isl, false)?
            }
        }
        rename_table_refs(e, t, name, nl, nd_, nnl, qo, ql)?
        return schema_changed(e)
    }
    if op == 2 {
        // ADD COLUMN: append the definition before the closing parenthesis.
        cd := ne_(e, s)
        flags := nflags(e, cd)
        if (flags & (CF_PK | CF_UNIQUE)) != 0 {
            return err(fail(e, SQLITE_ERROR, "Cannot add a PRIMARY KEY or UNIQUE column"))
        }
        if (flags & CF_NOTNULL) != 0 && ne_(e, cd) == 0 {
            return err(fail(e, SQLITE_ERROR, "Cannot add a NOT NULL column with default value NULL"))
        }
        let cd_a = na(e, cd)
        let cd_b = nb(e, cd)
        if find_column(e, t, cd_a, cd_b) != NO_COL {
            e.msg_len = 0
            msg_add(e, "duplicate column name: ")
            let cd_a2 = na(e, cd)
            let cd_b2 = nb(e, cd)
            msg_add_ws(e, cd_a2, cd_b2)
            return err(make_error(e, SQLITE_ERROR))
        }
        // SQLite inserts the column after the last column definition,
        // before any table constraints.
        let (_, _, col_end) = table_items(e, sql, sqll, NO_COL - 1)
        if col_end == 0 {
            return err(corrupt(e))
        }
        close := col_end - sql + 1
        start := nff(e, s)
        end := ng(e, s)
        add := end - start
        len := sqll + add + 2
        d := arena_alloc(e, len)?
        move_bytes(e.ws, sql, d, close - 1)
        e.ws[d + close - 1] = 44
        e.ws[d + close] = 32
        move_bytes(e.ws, start, d + close + 1, add)
        move_bytes(e.ws, sql + close - 1, d + close + 1 + add, sqll - close + 1)
        let schema_rowid4 = obj_u(e, t, O_ROWNO) as i64
        let name4 = obj_u(e, t, O_NAME)
        let name_len3 = obj_u(e, t, O_NAMEL)
        let name5 = obj_u(e, t, O_NAME)
        let name_len4 = obj_u(e, t, O_NAMEL)
        schema_update(e, schema_rowid4, name4, name_len3, name5, name_len4, d, len, false)?
        return schema_changed(e)
    }
    if op == 3 {
        // RENAME COLUMN old TO new: rewrite the table and index definitions.
        co := ne_(e, s)
        cl := nff(e, s)
        c := find_column(e, t, co, cl)
        if c == NO_COL {
            e.msg_len = 0
            msg_add(e, "no such column: \"")
            msg_add_ws(e, co, cl)
            msg_add(e, "\"")
            return err(make_error(e, SQLITE_ERROR))
        }
        nn := nc(e, s)
        nnl := ndd(e, s)
        if find_column(e, t, nn, nnl) != NO_COL {
            e.msg_len = 0
            msg_add(e, "duplicate column name: ")
            msg_add_ws(e, nn, nnl)
            return err(make_error(e, SQLITE_ERROR))
        }
        nd_ := arena_alloc(e, nnl)?
        move_bytes(e.ws, nn, nd_, nnl)
        let (qo, ql) = quoted_name(e, nd_, nnl)?
        // Like SQLite, a new name typed without quotes replaces unquoted
        // references as is.
        bl := if new_name_bare(e, nn, nnl) {
            nnl
        } else {
            0usize
        }
        let (ts, tsl) = rename_tokens(e, sql, sqll, co, cl, qo, ql, nd_, bl)?
        let schema_rowid5 = obj_u(e, t, O_ROWNO) as i64
        let name6 = obj_u(e, t, O_NAME)
        let name_len5 = obj_u(e, t, O_NAMEL)
        let name7 = obj_u(e, t, O_NAME)
        let name_len6 = obj_u(e, t, O_NAMEL)
        schema_update(e, schema_rowid5, name6, name_len5, name7, name_len6, ts, tsl, false)?
        for j in 0usize..e.schema_objs {
            if obj_type(e, j) != OT_INDEX || obj_u(e, j, O_TABLE) != t || obj_u(e, j, O_SQLL) == 0 {
                continue
            }
            let sql_value = obj_u(e, j, O_SQL)
            let sql_len = obj_u(e, j, O_SQLL)
            let (is, isl) = rename_tokens(e, sql_value, sql_len, co, cl, qo, ql, nd_, bl)?
            let schema_rowid6 = obj_u(e, j, O_ROWNO) as i64
            let name8 = obj_u(e, j, O_NAME)
            let name_len7 = obj_u(e, j, O_NAMEL)
            let tbl2 = obj_u(e, j, O_TBL)
            let tbl_len2 = obj_u(e, j, O_TBLL)
            schema_update(e, schema_rowid6, name8, name_len7, tbl2, tbl_len2, is, isl, false)?
        }
        rename_column_refs(e, t, co, cl, qo, ql, nd_, bl)?
        return schema_changed(e)
    }
    if op == 4 {
        check_schema_resolves(e)?
        let co2 = ne_(e, s)
        let cl2 = nff(e, s)
        return drop_column(e, t, co2, cl2)
    }
    err(fail(e, SQLITE_ERROR, "unsupported ALTER TABLE"))
}

// True when the new name in the ALTER statement was typed as a bare
// identifier.
fn new_name_bare(e: &Engine, o: usize, l: usize) -> bool {
    if o == 0 || l == 0 {
        return false
    }
    p := e.ws[o - 1]
    if p == 34 || p == 39 || p == 96 || p == 91 {
        return false
    }
    for i in 0usize..l {
        if !is_id_char(e.ws[o + i]) {
            return false
        }
    }
    !is_digit(e.ws[o])
}

// Renames identifier tokens equal to `old` that follow the first "(".
fn rename_tokens(e: &mut Engine, o: usize, l: usize, old: usize, ol: usize, qo: usize, ql: usize, bo: usize, bl: usize) -> (usize, usize)!db.Error {
    tok_start(e, o, l)
    for e.tk != TK_EOF && e.tk != TK_LP {
        next_token(e)
    }
    start := e.ts
    edits := arena_alloc(e, EDIT_MAX * 8)?
    n := scan_col_refs(e, o, l, start, old, ol, false, edits)
    apply_edits(e, o, l, edits, n, qo, ql, bo, bl)
}

// ---------------------------------------------------------------------------
// Column list geometry of CREATE TABLE text, as SQLite's ALTER TABLE uses
// it: the start of column `want`'s name token, the start of the next
// column's name token (0 for the last column), and the end of the column
// definitions (the comma before the first table constraint, or the closing
// parenthesis).
fn table_items(e: &mut Engine, o: usize, l: usize, want: usize) -> (usize, usize, usize) {
    e.src = o
    e.src_end = o + l
    e.pos = o
    e.ts = o
    e.tl = 0
    e.last_end = o
    next_token(e)
    for e.tk != TK_EOF && e.tk != TK_LP {
        next_token(e)
    }
    if e.tk == TK_EOF {
        return (0usize, 0usize, 0usize)
    }
    next_token(e)
    depth := 0usize
    item := 0usize
    at_start := true
    want_start := 0usize
    next_start := 0usize
    last_sep := 0usize
    for e.tk != TK_EOF {
        if at_start {
            at_start = false
            constraint := e.tk == TK_ID && (is_kw(e, "CONSTRAINT") || is_kw(e, "PRIMARY") || is_kw(e, "UNIQUE") || is_kw(e, "CHECK") || is_kw(e, "FOREIGN"))
            if constraint {
                return (want_start, next_start, last_sep)
            }
            if item == want {
                want_start = e.ts
            } else if item == want + 1 {
                next_start = e.ts
            }
            item += 1
        }
        if e.tk == TK_LP {
            depth += 1
        } else if e.tk == TK_RP {
            if depth == 0 {
                return (want_start, next_start, e.ts)
            }
            depth -= 1
        } else if e.tk == TK_COMMA && depth == 0 {
            last_sep = e.ts
            at_start = true
        }
        next_token(e)
    }
    (want_start, next_start, 0usize)
}

// True when nodes (lo, e.node_n] contain a reference to column `name`.
fn nodes_reference(e: &Engine, lo: usize, name: usize, nl: usize) -> bool {
    for n in (lo + 1)..(e.node_n + 1) {
        if nkind(e, n) == N_ID {
            let no = na(e, n)
            let nn = nb(e, n)
            if names_eq(e, no, nn, name, nl) {
                return true
            }
        }
    }
    false
}

// True when a FOREIGN KEY(...) column list in CREATE TABLE text names
// `name`.
fn foreign_key_uses(e: &mut Engine, o: usize, l: usize, name: usize, nl: usize) -> bool {
    e.src = o
    e.src_end = o + l
    e.pos = o
    e.ts = o
    e.tl = 0
    e.last_end = o
    next_token(e)
    for e.tk != TK_EOF {
        if e.tk == TK_ID && is_kw(e, "FOREIGN") {
            next_token(e)
            if e.tk == TK_ID && is_kw(e, "KEY") {
                next_token(e)
                if e.tk == TK_LP {
                    next_token(e)
                    for e.tk != TK_EOF && e.tk != TK_RP {
                        if e.tk == TK_ID || e.tk == TK_QID {
                            io := if e.tk == TK_ID {
                                e.ts
                            } else {
                                e.ts + 1
                            }
                            il := if e.tk == TK_ID {
                                e.tl
                            } else {
                                e.tl - 2
                            }
                            if names_eq(e, io, il, name, nl) {
                                return true
                            }
                        }
                        next_token(e)
                    }
                }
            }
            continue
        }
        next_token(e)
    }
    false
}

fn drop_error(e: &mut Engine, what: &str, oname: usize, onl: usize, col: usize, cl: usize) -> db.Error {
    e.msg_len = 0
    msg_add(e, "error in ")
    msg_add(e, what)
    msg_add(e, " ")
    msg_add_ws(e, oname, onl)
    msg_add(e, " after drop column: no such column: ")
    msg_add_ws(e, col, cl)
    make_error(e, SQLITE_ERROR)
}

// Resolves a view's SELECT against the current schema (used to validate
// schema changes). Resolution state of the running statement is kept.
fn check_view(e: &mut Engine, v: usize) -> void!db.Error {
    save_cur := e.cur_alloc
    save_reg := e.reg_alloc
    save_ctx_n := e.ctx_n
    save_ctx := e.ctx_off
    save_agg := e.agg_list
    save_aggn := e.agg_n
    save_subq := e.subq_list
    save_subqn := e.subq_n
    save_cte := e.cte_off
    save_cten := e.cte_n
    save_min := e.min_ctx
    save_rt := e.regctx_t
    save_nodes := e.node_n
    save_pool := e.pool_lo
    e.cur_alloc = 0
    e.reg_alloc = e.rtop
    e.ctx_n = 0
    e.agg_list = 0
    e.agg_n = 0
    e.subq_list = 0
    e.subq_n = 0
    e.cte_off = 0
    e.cte_n = 0
    e.min_ctx = NO_COL
    e.regctx_t = NO_COL
    res := check_view_inner(e, v)
    e.cur_alloc = save_cur
    e.reg_alloc = save_reg
    e.ctx_n = save_ctx_n
    e.ctx_off = save_ctx
    e.agg_list = save_agg
    e.agg_n = save_aggn
    e.subq_list = save_subq
    e.subq_n = save_subqn
    e.cte_off = save_cte
    e.cte_n = save_cten
    e.min_ctx = save_min
    e.regctx_t = save_rt
    e.node_n = save_nodes
    e.pool_lo = save_pool
    res
}

fn check_view_inner(e: &mut Engine, v: usize) -> void!db.Error {
    let ctx = pool_alloc(e, 16 * 8)?
    e.ctx_off = ctx
    let (sel, _) = view_select(e, v)?
    resolve_select(e, sel)
}

// ALTER TABLE ... DROP COLUMN: edits the CREATE TABLE text the way SQLite
// does, checks that nothing else refers to the column, and rewrites every
// row without it.
fn drop_column(e: &mut Engine, t: usize, co: usize, cl: usize) -> void!db.Error {
    name := obj_u(e, t, O_NAME)
    nl := obj_u(e, t, O_NAMEL)
    sql := obj_u(e, t, O_SQL)
    sqll := obj_u(e, t, O_SQLL)
    c := find_column(e, t, co, cl)
    if c == NO_COL {
        e.msg_len = 0
        msg_add(e, "no such column: \"")
        msg_add_ws(e, co, cl)
        msg_add(e, "\"")
        return err(make_error(e, SQLITE_ERROR))
    }
    flags := col_flags(e, t, c)
    if (flags & CF_PK) != 0 || (flags & CF_UNIQUE) != 0 {
        e.msg_len = 0
        if (flags & CF_PK) != 0 {
            msg_add(e, "cannot drop PRIMARY KEY column: \"")
        } else {
            msg_add(e, "cannot drop UNIQUE column: \"")
        }
        msg_add_ws(e, co, cl)
        msg_add(e, "\"")
        return err(make_error(e, SQLITE_ERROR))
    }
    ncol := obj_ncol(e, t)
    if ncol <= 1 {
        e.msg_len = 0
        msg_add(e, "cannot drop column \"")
        msg_add_ws(e, co, cl)
        msg_add(e, "\": no other columns exist")
        return err(make_error(e, SQLITE_ERROR))
    }
    let (a, b, end) = table_items(e, sql, sqll, c)
    if a == 0 || end == 0 {
        return err(corrupt(e))
    }
    start := a
    stop := b
    if c == ncol - 1 {
        // The last column takes the comma before it.
        for start > sql && e.ws[start] != 44 {
            start -= 1
        }
        stop = end
    }
    len := sqll - (stop - start)
    ns := arena_alloc(e, len)?
    move_bytes(e.ws, sql, ns, start - sql)
    move_bytes(e.ws, stop, ns + (start - sql), sql + sqll - stop)
    // Nothing else in the table definition may use the column.
    lo := e.node_n
    match parse_fragment_stmt(e, ns, len) {
        ok(_) => {},
        err(reason) => {
            e.node_n = lo
            return err(reason)
        },
    }
    uses := nodes_reference(e, lo, co, cl) || foreign_key_uses(e, ns, len, co, cl)
    e.node_n = lo
    if uses {
        return err(drop_error(e, "table", name, nl, co, cl))
    }
    for j in 0usize..e.schema_objs {
        if obj_type(e, j) != OT_INDEX || obj_u(e, j, O_TABLE) != t || obj_u(e, j, O_SQLL) == 0 {
            continue
        }
        let isql = obj_u(e, j, O_SQL)
        let isqll = obj_u(e, j, O_SQLL)
        lo2 := e.node_n
        parse_fragment_stmt(e, isql, isqll)?
        used := nodes_reference(e, lo2, co, cl)
        e.node_n = lo2
        if used {
            let iname = obj_u(e, j, O_NAME)
            let inl = obj_u(e, j, O_NAMEL)
            return err(drop_error(e, "index", iname, inl, co, cl))
        }
    }
    // Rewrite the rows first, while the catalog still describes them.
    root := obj_root(e, t)
    cur := SCHEMA_CUR - 1
    if is_wr(e, t) {
        wr_drop_field(e, t, c, cur)?
    } else {
        rewrite_without(e, t, c, cur, root)?
    }
    let schema_rowid = obj_u(e, t, O_ROWNO) as i64
    schema_update(e, schema_rowid, name, nl, name, nl, ns, len, false)?
    schema_changed(e)?
    return drop_column_checks(e, t, co, cl)
}

// Rewrites every row of WITHOUT ROWID table t without column c.
fn wr_drop_field(e: &mut Engine, t: usize, c: usize, cur: usize) -> void!db.Error {
    ncol := obj_ncol(e, t)
    npk := pk_count(e, t)
    open_table_cursor(e, cur, t)
    save := e.rtop
    base := e.rtop
    for _ in 0usize..(2 * ncol + npk + 1) {
        reg_push(e)?
    }
    out := base + ncol + 1
    key := out + ncol
    more := cur_first(e, cur)?
    for more {
        mark := e.arena_top
        wr_load_row(e, t, cur, base)?
        k := 0usize
        for q in 0usize..ncol {
            for col in 0usize..ncol {
                if rec_pos(e, t, col) == q && col != c {
                    copy_reg(e, out + k, base + col)
                    k += 1
                }
            }
        }
        for j in 0usize..npk {
            let pc = pk_col(e, t, j)
            copy_reg(e, key + j, base + pc)
        }
        size := record_size(e, out, ncol - 1)
        rec := arena_alloc(e, size)?
        record_write(e, out, ncol - 1, rec)
        cur_delete(e, cur)?
        index_insert(e, cur, rec, size)?
        if seek_index(e, cur, key, npk)? != 0 {
            e.rtop = save
            return err(corrupt(e))
        }
        arena_reset(e, mark)
        more = cur_next(e, cur)?
    }
    e.rtop = save
    ok()
}

// Rewrites every row of rowid table t without column c.
fn rewrite_without(e: &mut Engine, t: usize, c: usize, cur: usize, root: u32) -> void!db.Error {
    ncol := obj_ncol(e, t)
    cur_open(e, cur, root, false)
    save := e.rtop
    base := e.rtop
    for _ in 0usize..ncol {
        reg_push(e)?
    }
    ipk := rowid_col(e, t)
    more := cur_first(e, cur)?
    for more {
        mark := e.arena_top
        rowid := cur_rowid(e, cur)
        let (p, n) = cur_payload(e, cur)?
        k := 0usize
        for i in 0usize..ncol {
            if i == c {
                continue
            }
            if i == ipk {
                set_null(e, base + k)
            } else if !record_column(e, p, n, i, base + k)? {
                column_default(e, t, i, base + k)?
            }
            reg_own(e, base + k)?
            k += 1
        }
        size := record_size(e, base, ncol - 1)
        rec := arena_alloc(e, size)?
        record_write(e, base, ncol - 1, rec)
        table_insert(e, cur, rowid, rec, size)?
        arena_reset(e, mark)
        seek_rowid(e, cur, rowid)?
        more = cur_next(e, cur)?
    }
    e.rtop = save
    ok()
}

fn drop_column_checks(e: &mut Engine, t: usize, co: usize, cl: usize) -> void!db.Error {
    if e.legacy_alter {
        return ok()
    }
    // Views and triggers must not use the dropped column.
    for v in 0usize..e.schema_objs {
        k := obj_type(e, v)
        if k == OT_VIEW {
            match check_view(e, v) {
                ok() => {},
                err(_) => {
                    let vname = obj_u(e, v, O_NAME)
                    let vnl = obj_u(e, v, O_NAMEL)
                    return err(drop_error(e, "view", vname, vnl, co, cl))
                },
            }
        } else if k == OT_TRIGGER && trigger_uses_column(e, v, t, co, cl)? {
            let tname = obj_u(e, v, O_NAME)
            let tnl = obj_u(e, v, O_NAMEL)
            return err(drop_error(e, "trigger", tname, tnl, co, cl))
        }
    }
    ok()
}

// Like SQLite, ALTER TABLE first checks that the existing schema resolves;
// a view broken by an earlier change blocks further alterations.
fn check_schema_resolves(e: &mut Engine) -> void!db.Error {
    for v in 0usize..e.schema_objs {
        if obj_type(e, v) != OT_VIEW {
            continue
        }
        match check_view(e, v) {
            ok() => {},
            err(_) => {
                return err(fail(e, SQLITE_ERROR, "SQL logic error"))
            },
        }
    }
    ok()
}

// ---------------------------------------------------------------------------
// Token edits of schema SQL for ALTER TABLE (modern, non-legacy rules):
// references to a renamed table or column inside views, triggers and
// foreign keys are rewritten to the new, quoted name.

const EDIT_MAX: usize = 512

fn tok_start(e: &mut Engine, o: usize, l: usize) {
    e.src = o
    e.src_end = o + l
    e.pos = o
    e.ts = o
    e.tl = 0
    e.last_end = o
    next_token(e)
}

// The current identifier token's unquoted text.
fn tok_name(e: &Engine) -> (usize, usize) {
    if e.tk == TK_QID && e.tl >= 2 {
        return (e.ts + 1, e.tl - 2)
    }
    (e.ts, e.tl)
}

fn tok_is_name(e: &Engine, name: usize, nl: usize) -> bool {
    if e.tk != TK_ID && e.tk != TK_QID {
        return false
    }
    let (o, l) = tok_name(e)
    names_eq(e, o, l, name, nl)
}

// Edit: [0] start (bit 31 set when the token was quoted), [4] end.
fn add_edit(e: &mut Engine, edits: usize, n: usize, a: usize, b: usize, quoted: bool) -> usize {
    if n >= EDIT_MAX {
        return n
    }
    let flag = if quoted {
        2147483648usize
    } else {
        0usize
    }
    stu(e.ws, edits + n * 8, a | flag)
    stu(e.ws, edits + n * 8 + 4, b)
    n + 1
}

// Copies [o, o+l) replacing every edit range with the quoted name, or with
// the bare name (when bl > 0) for tokens that were not quoted.
fn apply_edits(e: &mut Engine, o: usize, l: usize, edits: usize, n: usize, qo: usize, ql: usize, bo: usize, bl: usize) -> (usize, usize)!db.Error {
    len := l
    for i in 0usize..n {
        raw := ldu(e.ws, edits + i * 8)
        a := raw & 2147483647
        b := ldu(e.ws, edits + i * 8 + 4)
        rl := if bl > 0 && (raw & 2147483648) == 0 {
            bl
        } else {
            ql
        }
        len = len - (b - a) + rl
    }
    d := arena_alloc(e, len)?
    src := o
    k := 0usize
    for i in 0usize..n {
        raw := ldu(e.ws, edits + i * 8)
        a := raw & 2147483647
        b := ldu(e.ws, edits + i * 8 + 4)
        move_bytes(e.ws, src, d + k, a - src)
        k += a - src
        if bl > 0 && (raw & 2147483648) == 0 {
            move_bytes(e.ws, bo, d + k, bl)
            k += bl
        } else {
            move_bytes(e.ws, qo, d + k, ql)
            k += ql
        }
        src = b
    }
    move_bytes(e.ws, src, d + k, o + l - src)
    ok((d, len))
}

fn ends_from(e: &Engine) -> bool {
    e.tk == TK_SEMI || e.tk == TK_ID && (is_kw(e, "WHERE") || is_kw(e, "GROUP") || is_kw(e, "ORDER") || is_kw(e, "LIMIT") || is_kw(e, "HAVING") || is_kw(e, "WINDOW") || is_kw(e, "UNION") || is_kw(e, "EXCEPT") || is_kw(e, "INTERSECT") || is_kw(e, "ON") || is_kw(e, "USING") || is_kw(e, "SELECT") || is_kw(e, "SET") || is_kw(e, "VALUES") || is_kw(e, "RETURNING"))
}

// Finds identifier tokens naming table `old` in table positions (after
// FROM, JOIN, INTO, UPDATE, TABLE, REFERENCES, in a FROM list, in a
// trigger's ON clause, or qualifying a column). With `header_only` only the
// trigger's ON clause is considered.
fn scan_table_refs(e: &mut Engine, o: usize, l: usize, old: usize, ol: usize, edits: usize, header_only: bool) -> usize {
    tok_start(e, o, l)
    n := 0usize
    depth := 0usize
    in_from := false
    from_depth := 0usize
    table_next := false
    before_begin := true
    pending_a := 0usize
    pending_b := 0usize
    pending_q := false
    prev_dot := false
    for e.tk != TK_EOF {
        if pending_b != 0 {
            if e.tk == TK_DOT && !header_only {
                n = add_edit(e, edits, n, pending_a, pending_b, pending_q)
            }
            pending_b = 0
        }
        if e.tk == TK_ID && is_kw(e, "BEGIN") {
            before_begin = false
            if header_only {
                break
            }
        }
        if e.tk == TK_LP {
            depth += 1
        } else if e.tk == TK_RP {
            if depth > 0 {
                depth -= 1
            }
            if in_from && depth < from_depth {
                in_from = false
            }
        }
        if tok_is_name(e, old, ol) && !prev_dot {
            let ta = e.ts
            let tb = e.ts + e.tl
            let tq = e.tk == TK_QID
            if table_next {
                n = add_edit(e, edits, n, ta, tb, tq)
            } else {
                pending_a = ta
                pending_b = tb
                pending_q = tq
            }
            table_next = false
            prev_dot = false
            next_token(e)
            continue
        }
        if in_from && ends_from(e) {
            in_from = false
        }
        was_table_kw := false
        if e.tk == TK_ID {
            if before_begin && is_kw(e, "ON") && !in_from {
                was_table_kw = true
            } else if !header_only && (is_kw(e, "FROM") || is_kw(e, "JOIN")) {
                was_table_kw = true
                in_from = true
                from_depth = depth
            } else if !header_only && (is_kw(e, "INTO") || is_kw(e, "UPDATE") || is_kw(e, "TABLE") || is_kw(e, "REFERENCES")) {
                was_table_kw = true
            }
        }
        if e.tk == TK_COMMA && in_from && depth == from_depth {
            was_table_kw = true
        }
        table_next = was_table_kw
        prev_dot = e.tk == TK_DOT
        next_token(e)
    }
    if pending_b != 0 && e.tk == TK_DOT && !header_only {
        n = add_edit(e, edits, n, pending_a, pending_b, pending_q)
    }
    n
}

// Finds identifier tokens equal to column `old` from offset `start` on,
// skipping function names and, with `skip_newold`, NEW.x / OLD.x.
fn scan_col_refs(e: &mut Engine, o: usize, l: usize, start: usize, old: usize, ol: usize, skip_newold: bool, edits: usize) -> usize {
    tok_start(e, o, l)
    n := 0usize
    prev_newold := false
    prev2_newold := false
    pending_a := 0usize
    pending_b := 0usize
    pending_q := false
    for e.tk != TK_EOF {
        if pending_b != 0 {
            if e.tk != TK_LP {
                n = add_edit(e, edits, n, pending_a, pending_b, pending_q)
            }
            pending_b = 0
        }
        if e.ts >= start && tok_is_name(e, old, ol) && !(skip_newold && prev2_newold) {
            pending_a = e.ts
            pending_b = e.ts + e.tl
            pending_q = e.tk == TK_QID
        }
        // prev2_newold: the token before is "." preceded by NEW or OLD.
        is_newold := e.tk == TK_ID && (is_kw(e, "NEW") || is_kw(e, "OLD"))
        prev2_newold = e.tk == TK_DOT && prev_newold
        prev_newold = is_newold
        next_token(e)
    }
    if pending_b != 0 {
        n = add_edit(e, edits, n, pending_a, pending_b, pending_q)
    }
    n
}

// Offset just after the object name of a CREATE statement, or after the
// first AS of a view (the start of its SELECT).
fn after_object_name(e: &mut Engine, o: usize, l: usize, view: bool) -> usize {
    tok_start(e, o, l)
    count := 0usize
    for e.tk != TK_EOF {
        if view && e.tk == TK_ID && is_kw(e, "AS") {
            return e.ts + e.tl
        }
        if !view && (e.tk == TK_ID || e.tk == TK_QID || e.tk == TK_STR) && !is_kw(e, "CREATE") && !is_kw(e, "TEMP") && !is_kw(e, "TEMPORARY") && !is_kw(e, "TRIGGER") && !is_kw(e, "IF") && !is_kw(e, "NOT") && !is_kw(e, "EXISTS") {
            end := e.ts + e.tl
            next_token(e)
            if e.tk == TK_DOT {
                next_token(e)
                return e.ts + e.tl
            }
            return end
        }
        count += 1
        next_token(e)
    }
    o + l
}

fn update_sql(e: &mut Engine, j: usize, tbl: usize, tl: usize, sql: usize, sqll: usize) -> void!db.Error {
    let row = obj_u(e, j, O_ROWNO) as i64
    let jn = obj_u(e, j, O_NAME)
    let jl = obj_u(e, j, O_NAMEL)
    schema_update(e, row, jn, jl, tbl, tl, sql, sqll, false)
}

// RENAME TABLE: triggers on the table follow it (tbl_name and ON clause);
// without legacy_alter_table, references in views, trigger bodies and
// foreign keys are rewritten as well.
fn rename_table_refs(e: &mut Engine, t: usize, old: usize, ol: usize, nn: usize, nnl: usize, qo: usize, ql: usize) -> void!db.Error {
    edits := arena_alloc(e, EDIT_MAX * 8)?
    for j in 0usize..e.schema_objs {
        k := obj_type(e, j)
        if j == t || k == OT_INDEX || obj_db(e, j) != obj_db(e, t) {
            continue
        }
        sql := obj_u(e, j, O_SQL)
        sqll := obj_u(e, j, O_SQLL)
        if sqll == 0 {
            continue
        }
        on_t := k == OT_TRIGGER && obj_u(e, j, O_TABLE) == t
        if e.legacy_alter && !on_t {
            continue
        }
        let legacy = e.legacy_alter
        n := scan_table_refs(e, sql, sqll, old, ol, edits, legacy)
        if n == 0 && !on_t {
            continue
        }
        let (ns, nsl) = apply_edits(e, sql, sqll, edits, n, qo, ql, 0, 0)?
        let (to, tl) = if on_t {
            (nn, nnl)
        } else {
            (obj_u(e, j, O_TBL), obj_u(e, j, O_TBLL))
        }
        update_sql(e, j, to, tl, ns, nsl)?
    }
    ok()
}

// RENAME COLUMN: column references in triggers on the table, and in views
// and triggers that use the table.
fn rename_column_refs(e: &mut Engine, t: usize, co: usize, cl: usize, qo: usize, ql: usize, bo: usize, bl: usize) -> void!db.Error {
    if e.legacy_alter {
        return ok()
    }
    tn := obj_u(e, t, O_NAME)
    tnl := obj_u(e, t, O_NAMEL)
    edits := arena_alloc(e, EDIT_MAX * 8)?
    for j in 0usize..e.schema_objs {
        k := obj_type(e, j)
        if obj_db(e, j) != obj_db(e, t) {
            continue
        }
        if k == OT_TABLE && j != t {
            // Foreign keys: REFERENCES t(col, ...).
            sql0 := obj_u(e, j, O_SQL)
            sqll0 := obj_u(e, j, O_SQLL)
            n0 := scan_fk_cols(e, sql0, sqll0, tn, tnl, co, cl, edits)
            if n0 > 0 {
                let (ns0, nsl0) = apply_edits(e, sql0, sqll0, edits, n0, qo, ql, bo, bl)?
                let jt0 = obj_u(e, j, O_TBL)
                let jtl0 = obj_u(e, j, O_TBLL)
                update_sql(e, j, jt0, jtl0, ns0, nsl0)?
            }
            continue
        }
        if k != OT_TRIGGER && k != OT_VIEW {
            continue
        }
        sql := obj_u(e, j, O_SQL)
        sqll := obj_u(e, j, O_SQLL)
        on_t := k == OT_TRIGGER && obj_u(e, j, O_TABLE) == t
        uses := scan_table_refs(e, sql, sqll, tn, tnl, edits, false) > 0
        if !on_t && !uses {
            continue
        }
        start := after_object_name(e, sql, sqll, k == OT_VIEW)
        n := scan_col_refs(e, sql, sqll, start, co, cl, !on_t, edits)
        if n == 0 {
            continue
        }
        let (ns, nsl) = apply_edits(e, sql, sqll, edits, n, qo, ql, bo, bl)?
        let jt = obj_u(e, j, O_TBL)
        let jtl = obj_u(e, j, O_TBLL)
        update_sql(e, j, jt, jtl, ns, nsl)?
    }
    ok()
}

// DROP COLUMN: triggers must not refer to the dropped column.
fn trigger_uses_column(e: &mut Engine, j: usize, t: usize, co: usize, cl: usize) -> bool!db.Error {
    sql := obj_u(e, j, O_SQL)
    sqll := obj_u(e, j, O_SQLL)
    tn := obj_u(e, t, O_NAME)
    tnl := obj_u(e, t, O_NAMEL)
    on_t := obj_u(e, j, O_TABLE) == t
    edits := arena_alloc(e, EDIT_MAX * 8)?
    uses_t := scan_table_refs(e, sql, sqll, tn, tnl, edits, false) > 0
    if !on_t && !uses_t {
        return ok(false)
    }
    lo := e.node_n
    save := e.trig_parse
    e.trig_parse = true
    res := parse_fragment_stmt(e, sql, sqll)
    e.trig_parse = save
    match res {
        ok(_) => {},
        err(_) => {
            e.node_n = lo
            return ok(false)
        },
    }
    found := false
    for n in (lo + 1)..(e.node_n + 1) {
        if nkind(e, n) != N_ID {
            continue
        }
        let no = na(e, n)
        let nl = nb(e, n)
        if !names_eq(e, no, nl, co, cl) {
            continue
        }
        q := nc(e, n)
        ql := ndd(e, n)
        newold := q != 0 && (name_is(e, q, ql, "new") || name_is(e, q, ql, "old"))
        if newold && on_t || !newold && uses_t && (q == 0 || names_eq(e, q, ql, tn, tnl)) {
            found = true
        }
    }
    e.node_n = lo
    ok(found)
}

// Column names inside "REFERENCES table(...)" lists naming `col`.
fn scan_fk_cols(e: &mut Engine, o: usize, l: usize, tn: usize, tnl: usize, col: usize, cl: usize, edits: usize) -> usize {
    tok_start(e, o, l)
    n := 0usize
    for e.tk != TK_EOF {
        if e.tk == TK_ID && is_kw(e, "REFERENCES") {
            next_token(e)
            if !tok_is_name(e, tn, tnl) {
                continue
            }
            next_token(e)
            if e.tk != TK_LP {
                continue
            }
            next_token(e)
            for e.tk != TK_EOF && e.tk != TK_RP {
                if tok_is_name(e, col, cl) {
                    let a = e.ts
                    let b = e.ts + e.tl
                    let q = e.tk == TK_QID
                    n = add_edit(e, edits, n, a, b, q)
                }
                next_token(e)
            }
            continue
        }
        next_token(e)
    }
    n
}
