    fn drop(&mut self) {
        // Every object borrowing the device is gone; only the graveyard is
        // left. Destroy it once the GPU is idle.
        submitted := self.life.submitted
        if submitted != 0 {
            match self.raw_wait(submitted) {
                ok() => {}
                err(_) => {}
            }
        }
        for i in 0usize..self.life.count {
            handle := hal.Handle { a: self.life.a[i], b: self.life.b[i], c: self.life.c[i], d: self.life.d[i] }
            self.raw_destroy(self.life.object[i], &handle)
        }
        self.life.count = 0
    }
}

// The more informative of two failures to open a backend.
fn worse(current: Error, next: Error) -> Error {
    match &next {
        Error.NoBackend => {
            return current
        }
        Error.Unsupported => {
            match &current {
                Error.NoBackend => {
                    return next
                }
                _ => {
                    return current
                }
            }
        }
        _ => {
            match &current {
                Error.NoBackend => {
                    return next
                }
                Error.Unsupported => {
                    return next
                }
                _ => {
                    return current
                }
            }
        }
    }
}

// Whether [offset, offset + length) lies within `size` bytes.
fn fits(offset: u64, length: u64, size: u64) -> bool {
    return length <= size && offset <= size - length
}

// Whether a copy of `region` between `texture` and `available` bytes
// starting at `offset`, rows `bytes_per_row` apart, stays in bounds.
fn texture_copy_fits(texture: &TextureDescriptor, region: &Region, available: u64, offset: u64, bytes_per_row: u32) -> bool {
    texel := hal.texel_size(texture.format) as u64
    if region.x as u64 + region.width as u64 > texture.width as u64 || region.y as u64 + region.height as u64 > texture.height as u64 {
        return false
    }
    row := region.width as u64 * texel
    if (bytes_per_row as u64) < row || bytes_per_row as u64 % texel != 0 {
        return false
    }
    if region.width == 0 || region.height == 0 {
        return true
    }
    needed := (region.height as u64 - 1) * bytes_per_row as u64 + row
    return fits(offset, needed, available)
}

// Check a binding layout and record it in `pipeline`.
fn check_bindings(bindings: &[BindingLayout], allowed: u32, pipeline: &mut hal.Pipeline) -> void!Error {
    for i in 0usize..bindings.len {
        binding := &bindings[i]
        slot := binding.slot
        if slot >= hal.MAX_SLOTS || pipeline.kinds[slot as usize] != hal.BINDING_NONE {
            return err(Error.InvalidInput)
        }
        if binding.kind == hal.BINDING_NONE || binding.kind > hal.BINDING_STORAGE_TEXTURE {
            return err(Error.InvalidInput)
        }
        if binding.stages == 0 || (binding.stages & ~allowed) != 0 {
            return err(Error.InvalidInput)
        }
        // Storage buffers and textures are writable, which vertex shaders
        // cannot be on every backend.
        if (binding.kind == hal.BINDING_STORAGE_BUFFER || binding.kind == hal.BINDING_STORAGE_TEXTURE) && (binding.stages & hal.STAGE_VERTEX) != 0 {
            return err(Error.InvalidInput)
        }
        if binding.kind == hal.BINDING_STORAGE_TEXTURE && !hal.is_storage(binding.format) {
            return err(Error.InvalidInput)
        }
        pipeline.kinds[slot as usize] = binding.kind
        pipeline.stages[slot as usize] = binding.stages
        pipeline.formats[slot as usize] = binding.format
    }
    return ok()
}

// GPU memory. Dropping it frees the memory once the GPU has finished every
// submission that may use it.
pub struct Buffer {
    device: &Device
    handle: hal.Handle
    size: u64
    usage: u32

    pub fn size(&self) -> u64 {
        return self.size
    }
    pub fn usage(&self) -> u32 {
        return self.usage
    }

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_BUFFER, &self.handle)
    }
}

// A two-dimensional image on the GPU.
pub struct Texture {
    device: &Device
    handle: hal.Handle
    descriptor: hal.TextureDescriptor

    pub fn width(&self) -> u32 {
        return self.descriptor.width
    }
    pub fn height(&self) -> u32 {
        return self.descriptor.height
    }
    pub fn format(&self) -> u32 {
        return self.descriptor.format
    }
    pub fn usage(&self) -> u32 {
        return self.descriptor.usage
    }
    // The bytes one row of the whole texture takes, tightly packed.
    pub fn bytes_per_row(&self) -> u32 {
        return self.descriptor.width * hal.texel_size(self.descriptor.format)
    }
    // The region covering the whole texture.
    pub fn region(&self) -> Region {
        return Region { x: 0, y: 0, width: self.descriptor.width, height: self.descriptor.height }
    }

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_TEXTURE, &self.handle)
    }
}

pub struct Sampler {
    device: &Device
    handle: hal.Handle

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_SAMPLER, &self.handle)
    }
}

pub struct ComputePipeline {
    device: &Device
    pipeline: hal.Pipeline

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_COMPUTE_PIPELINE, &self.pipeline.handle)
    }
}

pub struct RenderPipeline {
    device: &Device
    pipeline: hal.Pipeline

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_RENDER_PIPELINE, &self.pipeline.handle)
    }
}

// The color attachment of a render pass. LOAD_CLEAR fills it with the
// clear color first; LOAD_KEEP draws over what it holds.
pub struct ColorAttachment {
    pub texture: &Texture
    pub load: u32
    pub red: f64
    pub green: f64
    pub blue: f64
    pub alpha: f64

    pub fn clear(texture: &Texture, red: f64, green: f64, blue: f64, alpha: f64) -> ColorAttachment from(texture) {
        return ColorAttachment { texture: texture, load: hal.LOAD_CLEAR, red: red, green: green, blue: blue, alpha: alpha }
    }
    pub fn keep(texture: &Texture) -> ColorAttachment from(texture) {
        return ColorAttachment { texture: texture, load: hal.LOAD_KEEP, red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 }
    }
}

// The depth attachment of a render pass.
pub struct DepthAttachment {
    pub texture: &Texture
    pub load: u32
    pub depth: f32

    pub fn clear(texture: &Texture, depth: f32) -> DepthAttachment from(texture) {
        return DepthAttachment { texture: texture, load: hal.LOAD_CLEAR, depth: depth }
    }
    pub fn keep(texture: &Texture) -> DepthAttachment from(texture) {
        return DepthAttachment { texture: texture, load: hal.LOAD_KEEP, depth: 0.0 }
    }
}

// Records commands for the GPU. Nothing runs until submit(); dropping an
// encoder without submitting discards its commands.
pub struct CommandEncoder {
    device: &Device
    handle: hal.Handle
    open: bool

    // Record a compute pass. The encoder is busy until the pass ends.
    pub fn compute_pass(&mut self) -> ComputePass from(self) {
        device := self.device
        device.raw_begin_compute_pass(&mut self.handle)
        return ComputePass { encoder: self, state: hal.PassState.new(), tracked: Tracked.new() }
    }

    // Record a render pass drawing into `color`. It needs TEXTURE_RENDER
    // and a color format.
    pub fn render_pass(&mut self, color: ColorAttachment) -> RenderPass from(self) {
        return self.begin_render(&color, false, color.texture, hal.LOAD_KEEP, 0.0)
    }

    // Record a render pass drawing into `color` with the depth buffer
    // `depth`, a TEXTURE_RENDER depth texture of the same size.
    pub fn render_pass_with_depth(&mut self, color: ColorAttachment, depth: DepthAttachment) -> RenderPass from(self) {
        return self.begin_render(&color, true, depth.texture, depth.load, depth.depth)
    }

    fn begin_render(&mut self, color: &ColorAttachment, has_depth: bool, depth: &Texture, depth_load: u32, clear_depth: f32) -> RenderPass from(self) {
        device := self.device
        target := color.texture
        device.check_owner(target.device)
        assert((target.descriptor.usage & hal.TEXTURE_RENDER) != 0, "a render pass attachment needs TEXTURE_RENDER")
        assert(!hal.is_depth(target.descriptor.format), "the color attachment has a depth format")
        assert(color.load <= hal.LOAD_KEEP && depth_load <= hal.LOAD_KEEP, "unknown load action")
        tracked := Tracked.new()
        tracked.color_a = target.handle.a
        tracked.color_format = target.descriptor.format
        tracked.depth_format = hal.FORMAT_NONE
        tracked.width = target.descriptor.width
        tracked.height = target.descriptor.height
        info := hal.RenderPassInfo {
            color: target.handle.copy(),
            color_format: target.descriptor.format,
            width: target.descriptor.width,
            height: target.descriptor.height,
            load: color.load,
            clear_red: color.red,
            clear_green: color.green,
            clear_blue: color.blue,
            clear_alpha: color.alpha,
            has_depth: has_depth,
            depth: hal.Handle.null(),
            depth_load: depth_load,
            clear_depth: clear_depth
        }
        if has_depth {
            device.check_owner(depth.device)
            assert((depth.descriptor.usage & hal.TEXTURE_RENDER) != 0, "a render pass attachment needs TEXTURE_RENDER")
            assert(hal.is_depth(depth.descriptor.format), "the depth attachment has a color format")
            assert(depth.descriptor.width == target.descriptor.width && depth.descriptor.height == target.descriptor.height, "the attachments differ in size")
            info.depth = depth.handle.copy()
            tracked.depth_a = depth.handle.a
            tracked.depth_format = depth.descriptor.format
        }
        device.raw_begin_render_pass(&mut self.handle, &info)
        return RenderPass { encoder: self, state: hal.PassState.new(), tracked: tracked }
    }

    // Copy `size` bytes between buffers. Offsets and size are multiples
    // of 4, the source has BUFFER_COPY_SRC, the destination
    // BUFFER_COPY_DST, and copies within one buffer do not overlap.
    pub fn copy_buffer(&mut self, source: &Buffer, source_offset: u64, destination: &Buffer, destination_offset: u64, size: u64) {
        device := self.device
        device.check_owner(source.device)
        device.check_owner(destination.device)
        assert((source.usage & hal.BUFFER_COPY_SRC) != 0, "the copy source needs BUFFER_COPY_SRC")
        assert((destination.usage & hal.BUFFER_COPY_DST) != 0, "the copy destination needs BUFFER_COPY_DST")
        assert((source_offset & 3) == 0 && (destination_offset & 3) == 0 && (size & 3) == 0, "buffer copies need offsets and sizes in multiples of 4")
        assert(fits(source_offset, size, source.size) && fits(destination_offset, size, destination.size), "the copy range lies outside the buffer")
        if ptr.from_ref(source) == ptr.from_ref(destination) {
            assert(source_offset + size <= destination_offset || destination_offset + size <= source_offset, "the copy ranges overlap")
        }
        if size == 0 {
            return
        }
        device.raw_copy_buffer(&mut self.handle, &source.handle, source_offset, &destination.handle, destination_offset, size)
    }

    // Copy texels from `source`, starting `offset` bytes in with rows
    // `bytes_per_row` apart, into `region` of `destination`. The offset
    // is a multiple of 4 and of the texel size; the rest follows
    // write_texture.
    pub fn copy_buffer_to_texture(&mut self, source: &Buffer, offset: u64, bytes_per_row: u32, destination: &Texture, region: Region) {
        device := self.device
        device.check_owner(source.device)
        device.check_owner(destination.device)
        assert((source.usage & hal.BUFFER_COPY_SRC) != 0, "the copy source needs BUFFER_COPY_SRC")
        assert((destination.descriptor.usage & hal.TEXTURE_COPY_DST) != 0, "the copy destination needs TEXTURE_COPY_DST")
        check_texture_copy(&destination.descriptor, &region, source.size, offset, bytes_per_row)
        if region.width == 0 || region.height == 0 {
            return
        }
        device.raw_copy_buffer_to_texture(&mut self.handle, &source.handle, offset, bytes_per_row, &destination.handle, &destination.descriptor, &region)
    }

    // Copy texels of `region` of `source` into `destination`, starting
    // `offset` bytes in with rows `bytes_per_row` apart.
    pub fn copy_texture_to_buffer(&mut self, source: &Texture, region: Region, destination: &Buffer, offset: u64, bytes_per_row: u32) {
        device := self.device
        device.check_owner(source.device)
        device.check_owner(destination.device)
        assert((source.descriptor.usage & hal.TEXTURE_COPY_SRC) != 0, "the copy source needs TEXTURE_COPY_SRC")
        assert((destination.usage & hal.BUFFER_COPY_DST) != 0, "the copy destination needs BUFFER_COPY_DST")
        check_texture_copy(&source.descriptor, &region, destination.size, offset, bytes_per_row)
        if region.width == 0 || region.height == 0 {
            return
        }
        device.raw_copy_texture_to_buffer(&mut self.handle, &source.handle, &source.descriptor, &region, &destination.handle, offset, bytes_per_row)
    }

    // Run the recorded commands after everything submitted before.
    pub fn submit(self) -> void!Error {
        device := self.device
        index := device.raw_submit(&mut self.handle)?
        self.open = false
        device.close_encoder(index)
        device.bury(hal.OBJECT_ENCODER, &self.handle, index)
        device.collect(false)
        return ok()
    }

    fn drop(&mut self) {
        if self.open {
            device := self.device
            device.raw_destroy(hal.OBJECT_ENCODER, &self.handle)
            device.close_encoder(0)
        }
    }
}

fn check_texture_copy(texture: &TextureDescriptor, region: &Region, buffer_size: u64, offset: u64, bytes_per_row: u32) {
    texel := hal.texel_size(texture.format) as u64
    assert(offset % 4 == 0 && offset % texel == 0, "the buffer offset of a texture copy is not a multiple of 4 and of the texel size")
    assert(!hal.is_depth(texture.format) || (texture.usage & hal.TEXTURE_COPY_DST) == 0, "depth textures cannot be copied into")
    assert(texture_copy_fits(texture, region, buffer_size, offset, bytes_per_row), "the texture copy lies outside the texture or the buffer, or bytes_per_row is too small or not a multiple of the texel size")
}

// What a pass knows about the objects bound to it, for checking draws.
struct Tracked {
    usage: [16]u32
    format: [16]u32
    texture_a: [16]u64
    vertex_size: [8]u64
    index_size: u64
    color_a: u64
    depth_a: u64
    color_format: u32
    depth_format: u32
    width: u32
    height: u32

    fn new() -> Tracked {
        return Tracked { usage: [0u32; 16], format: [0u32; 16], texture_a: [0u64; 16], vertex_size: [0u64; 8], index_size: 0, color_a: 0, depth_a: 0, color_format: 0, depth_format: 0, width: 0, height: 0 }
    }
}

fn bind_buffer(state: &mut hal.PassState, tracked: &mut Tracked, slot: u32, buffer: &Buffer, offset: u64, size: u64) {
    assert(slot < hal.MAX_SLOTS, "binding slot out of range")
    assert(offset % BINDING_ALIGNMENT == 0, "bound buffer offsets are multiples of BINDING_ALIGNMENT (256)")
    assert(size != 0 && fits(offset, size, buffer.size), "the bound range lies outside the buffer")
    index := slot as usize
    state.bound[index] = hal.BOUND_BUFFER
    state.object_a[index] = buffer.handle.a
    state.object_b[index] = buffer.handle.b
    state.object_c[index] = buffer.handle.c
    state.sampler[index] = 0
    state.offset[index] = offset
    state.size[index] = size
    state.dirty = state.dirty | (1u32 << slot)
    tracked.usage[index] = buffer.usage
    tracked.format[index] = 0
    tracked.texture_a[index] = 0
}

fn bind_texture(state: &mut hal.PassState, tracked: &mut Tracked, slot: u32, texture: &Texture, sampler: &hal.Handle, kind: u32) {
    assert(slot < hal.MAX_SLOTS, "binding slot out of range")
    index := slot as usize
    state.bound[index] = kind
    state.object_a[index] = texture.handle.a
    state.object_b[index] = texture.handle.b
    state.object_c[index] = texture.handle.c
    state.sampler[index] = sampler.a
    state.offset[index] = 0
    state.size[index] = 0
    state.dirty = state.dirty | (1u32 << slot)
    tracked.usage[index] = texture.descriptor.usage
    tracked.format[index] = texture.descriptor.format
    tracked.texture_a[index] = texture.handle.a
}

// Check that the bound objects fit the pipeline's layout.
fn check_bound(state: &hal.PassState, tracked: &Tracked, limits: &hal.Limits) {
    assert(state.has_pipeline, "no pipeline is set")
    for i in 0usize..16 {
        kind := state.pipeline.kinds[i]
        bound := state.bound[i]
        usage := tracked.usage[i]
        if kind == hal.BINDING_UNIFORM_BUFFER {
            assert(bound == hal.BOUND_BUFFER, "the pipeline expects a buffer in a slot that holds none")
            assert((usage & hal.BUFFER_UNIFORM) != 0, "a uniform buffer slot holds a buffer without BUFFER_UNIFORM")
            assert(state.size[i] <= limits.max_uniform_binding_size, "the bound uniform range exceeds limits().max_uniform_binding_size")
        } else if kind == hal.BINDING_STORAGE_BUFFER || kind == hal.BINDING_READ_ONLY_STORAGE_BUFFER {
            assert(bound == hal.BOUND_BUFFER, "the pipeline expects a buffer in a slot that holds none")
            assert((usage & hal.BUFFER_STORAGE) != 0, "a storage buffer slot holds a buffer without BUFFER_STORAGE")
            assert(state.size[i] <= limits.max_storage_binding_size, "the bound storage range exceeds limits().max_storage_binding_size")
        } else if kind == hal.BINDING_SAMPLED_TEXTURE {
            assert(bound == hal.BOUND_SAMPLED_TEXTURE, "the pipeline expects a texture and sampler in a slot that holds none")
            assert((usage & hal.TEXTURE_SAMPLED) != 0, "a sampled texture slot holds a texture without TEXTURE_SAMPLED")
        } else if kind == hal.BINDING_STORAGE_TEXTURE {
            assert(bound == hal.BOUND_STORAGE_TEXTURE, "the pipeline expects a storage texture in a slot that holds none")
            assert((usage & hal.TEXTURE_STORAGE) != 0, "a storage texture slot holds a texture without TEXTURE_STORAGE")
            assert(tracked.format[i] == state.pipeline.formats[i], "the storage texture's format differs from the layout's")
        }
        if kind == hal.BINDING_SAMPLED_TEXTURE || kind == hal.BINDING_STORAGE_TEXTURE {
            a := tracked.texture_a[i]
            assert(a != tracked.color_a && (tracked.depth_a == 0 || a != tracked.depth_a), "a texture is bound while it is an attachment of the pass")
        }
    }
}

// A compute pass. It ends when dropped or with end().
pub struct ComputePass {
    encoder: &mut CommandEncoder
    state: hal.PassState
    tracked: Tracked

    pub fn set_pipeline(&mut self, pipeline: &ComputePipeline) {
        device := self.encoder.device
        device.check_owner(pipeline.device)
        self.state.pipeline = pipeline.pipeline.copy()
        self.state.has_pipeline = true
        self.state.pipeline_dirty = true
        self.state.dirty = 0xffff
    }

    // Bind all of `buffer` to `slot`.
    pub fn set_buffer(&mut self, slot: u32, buffer: &Buffer) {
        self.set_buffer_range(slot, buffer, 0, buffer.size)
    }

    // Bind `size` bytes of `buffer` from `offset`, a multiple of
    // BINDING_ALIGNMENT, to `slot`.
    pub fn set_buffer_range(&mut self, slot: u32, buffer: &Buffer, offset: u64, size: u64) {
        device := self.encoder.device
        device.check_owner(buffer.device)
        bind_buffer(&mut self.state, &mut self.tracked, slot, buffer, offset, size)
    }

    // Bind `texture`, read through `sampler`, to `slot`.
    pub fn set_texture(&mut self, slot: u32, texture: &Texture, sampler: &Sampler) {
        device := self.encoder.device
        device.check_owner(texture.device)
        device.check_owner(sampler.device)
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &sampler.handle, hal.BOUND_SAMPLED_TEXTURE)
    }

    // Bind `texture` for reading and writing single texels to `slot`.
    pub fn set_storage_texture(&mut self, slot: u32, texture: &Texture) {
        device := self.encoder.device
        device.check_owner(texture.device)
        empty := hal.Handle.null()
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &empty, hal.BOUND_STORAGE_TEXTURE)
    }

    // Run x * y * z workgroups of the pipeline's workgroup size. Each
    // dispatch sees the writes of the ones before it.
    pub fn dispatch(&mut self, x: u32, y: u32, z: u32) {
        device := self.encoder.device
        check_bound(&self.state, &self.tracked, &device.limits)
        maximum := device.limits.max_workgroups
        assert(x <= maximum && y <= maximum && z <= maximum, "the dispatch exceeds limits().max_workgroups")
        if x == 0 || y == 0 || z == 0 {
            return
        }
        device.raw_dispatch(&mut self.encoder.handle, &mut self.state, x, y, z)
    }

    pub fn end(self) {}

    fn drop(&mut self) {
        device := self.encoder.device
        device.raw_end_compute_pass(&mut self.encoder.handle)
    }
}

// A render pass. It ends when dropped or with end(). The viewport and
// scissor start out covering the whole attachment.
pub struct RenderPass {
    encoder: &mut CommandEncoder
    state: hal.PassState
    tracked: Tracked

    pub fn set_pipeline(&mut self, pipeline: &RenderPipeline) {
        device := self.encoder.device
        device.check_owner(pipeline.device)
        assert(pipeline.pipeline.color_format == self.tracked.color_format, "the pipeline's color format differs from the attachment's")
        assert(pipeline.pipeline.depth_format == self.tracked.depth_format, "the pipeline's depth format differs from the pass's depth attachment")
        self.state.pipeline = pipeline.pipeline.copy()
        self.state.has_pipeline = true
        self.state.pipeline_dirty = true
        self.state.dirty = 0xffff
        self.state.vertex_dirty = 0xff
        self.state.index_dirty = true
    }

    pub fn set_buffer(&mut self, slot: u32, buffer: &Buffer) {
        self.set_buffer_range(slot, buffer, 0, buffer.size)
    }

    pub fn set_buffer_range(&mut self, slot: u32, buffer: &Buffer, offset: u64, size: u64) {
        device := self.encoder.device
        device.check_owner(buffer.device)
        bind_buffer(&mut self.state, &mut self.tracked, slot, buffer, offset, size)
    }

    pub fn set_texture(&mut self, slot: u32, texture: &Texture, sampler: &Sampler) {
        device := self.encoder.device
        device.check_owner(texture.device)
        device.check_owner(sampler.device)
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &sampler.handle, hal.BOUND_SAMPLED_TEXTURE)
    }

    pub fn set_storage_texture(&mut self, slot: u32, texture: &Texture) {
        device := self.encoder.device
        device.check_owner(texture.device)
        empty := hal.Handle.null()
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &empty, hal.BOUND_STORAGE_TEXTURE)
    }

    // Read vertex buffer `slot` of the pipeline from `buffer`, starting
    // `offset` bytes in. It needs BUFFER_VERTEX.
    pub fn set_vertex_buffer(&mut self, slot: u32, buffer: &Buffer, offset: u64) {
        device := self.encoder.device
        device.check_owner(buffer.device)
        assert(slot < hal.MAX_VERTEX_BUFFERS, "vertex buffer slot out of range")
        assert((buffer.usage & hal.BUFFER_VERTEX) != 0, "a vertex buffer needs BUFFER_VERTEX")
        assert(offset % 4 == 0 && offset <= buffer.size, "the vertex buffer offset is past the end or not a multiple of 4")
        index := slot as usize
        self.state.vertex_a[index] = buffer.handle.a
        self.state.vertex_offset[index] = offset
        self.state.vertex_set = self.state.vertex_set | (1u32 << slot)
        self.state.vertex_dirty = self.state.vertex_dirty | (1u32 << slot)
        self.tracked.vertex_size[index] = buffer.size
    }

    // Read indices of `format` (INDEX_UINT16 or INDEX_UINT32) from
    // `buffer`, starting `offset` bytes in. It needs BUFFER_INDEX.
    pub fn set_index_buffer(&mut self, buffer: &Buffer, format: u32, offset: u64) {
        device := self.encoder.device
        device.check_owner(buffer.device)
        assert(format == hal.INDEX_UINT16 || format == hal.INDEX_UINT32, "unknown index format")
        assert((buffer.usage & hal.BUFFER_INDEX) != 0, "an index buffer needs BUFFER_INDEX")
        assert(offset % index_size(format) == 0 && offset <= buffer.size, "the index buffer offset is past the end or not a multiple of the index size")
        self.state.index_a = buffer.handle.a
        self.state.index_offset = offset
        self.state.index_format = format
        self.state.index_set = true
        self.state.index_dirty = true
        self.tracked.index_size = buffer.size
    }

    // Draw into this part of the attachment, in pixels from its top-left
    // corner, with depths mapped to `min_depth`..`max_depth` (0.0 to 1.0).
    pub fn set_viewport(&mut self, x: f32, y: f32, width: f32, height: f32, min_depth: f32, max_depth: f32) {
        assert(width > 0.0 && height > 0.0 && x >= 0.0 && y >= 0.0, "the viewport is empty or starts outside the attachment")
        assert(x + width <= self.tracked.width as f32 && y + height <= self.tracked.height as f32, "the viewport extends past the attachment")
        assert(min_depth >= 0.0 && max_depth <= 1.0 && min_depth <= max_depth, "viewport depths lie outside 0.0 to 1.0")
        device := self.encoder.device
        device.raw_set_viewport(&mut self.encoder.handle, x, y, width, height, min_depth, max_depth)
    }

    // Discard pixels outside this rectangle.
    pub fn set_scissor(&mut self, x: u32, y: u32, width: u32, height: u32) {
        assert(x as u64 + width as u64 <= self.tracked.width as u64 && y as u64 + height as u64 <= self.tracked.height as u64, "the scissor rectangle extends past the attachment")
        device := self.encoder.device
        device.raw_set_scissor(&mut self.encoder.handle, x, y, width, height)
    }

    // Draw `vertex_count` vertices from `first_vertex`, `instance_count`
    // times from `first_instance`. Every vertex buffer the pipeline reads
    // must be set and long enough.
    pub fn draw(&mut self, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32) {
        device := self.encoder.device
        check_bound(&self.state, &self.tracked, &device.limits)
        check_vertices(&self.state, &self.tracked, first_vertex as u64 + vertex_count as u64, first_instance as u64 + instance_count as u64)
        if vertex_count == 0 || instance_count == 0 {
            return
        }
        device.raw_draw(&mut self.encoder.handle, &mut self.state, vertex_count, instance_count, first_vertex, first_instance)
    }

    // Draw `index_count` indices of the index buffer from `first_index`,
    // adding `base_vertex` to each. Index values are not checked against
    // the vertex buffers: an index past their end reads undefined values.
    pub fn draw_indexed(&mut self, index_count: u32, instance_count: u32, first_index: u32, base_vertex: i32, first_instance: u32) {
        device := self.encoder.device
        check_bound(&self.state, &self.tracked, &device.limits)
        assert(self.state.index_set, "no index buffer is set")
        needed := self.state.index_offset + (first_index as u64 + index_count as u64) * index_size(self.state.index_format)
        assert(needed <= self.tracked.index_size, "the indices extend past the end of the index buffer")
        // Vertices come from the indices; only instance data is checked.
        check_vertices(&self.state, &self.tracked, 0, first_instance as u64 + instance_count as u64)
        if index_count == 0 || instance_count == 0 {
            return
        }
        device.raw_draw_indexed(&mut self.encoder.handle, &mut self.state, index_count, instance_count, first_index, base_vertex, first_instance)
    }

    pub fn end(self) {}

    fn drop(&mut self) {
        device := self.encoder.device
        device.raw_end_render_pass(&mut self.encoder.handle)
    }
}

fn check_vertices(state: &hal.PassState, tracked: &Tracked, vertices: u64, instances: u64) {
    pipeline := &state.pipeline
    for i in 0usize..pipeline.vertex_buffer_count as usize {
        assert((state.vertex_set >> i as u32 & 1) != 0, "a vertex buffer the pipeline reads is not set")
        count := vertices
        if pipeline.steps[i] == hal.STEP_INSTANCE {
            count = instances
        }
        if count != 0 && pipeline.extents[i] != 0 {
            needed := state.vertex_offset[i] + (count - 1) * pipeline.strides[i] as u64 + pipeline.extents[i] as u64
            assert(needed <= tracked.vertex_size[i], "the draw reads past the end of a vertex buffer")
        }
    }
}

fn index_size(format: u32) -> u64 {
    if format == hal.INDEX_UINT16 {
        return 2
    }
    return 4
}

// The bytes of `values` in native byte order, for write_buffer.
pub fn f32_bytes(values: &[f32]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 4, values)
    }
}
pub fn u32_bytes(values: &[u32]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 4, values)
    }
}
pub fn i32_bytes(values: &[i32]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 4, values)
    }
}
pub fn u16_bytes(values: &[u16]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 2, values)
    }
}

// The bytes of `values` to fill with read_buffer. Any bytes make valid
// numbers of these types.
pub fn f32_bytes_mut(values: &mut[f32]) -> &mut[u8] from(values) {
    unsafe {
        return ptr.borrow_slice_mut(ptr.as_mut_ptr(values) as *mut u8, values.len * 4, values)
    }
}
pub fn u32_bytes_mut(values: &mut[u32]) -> &mut[u8] from(values) {
    unsafe {
        return ptr.borrow_slice_mut(ptr.as_mut_ptr(values) as *mut u8, values.len * 4, values)
    }
}
pub fn i32_bytes_mut(values: &mut[i32]) -> &mut[u8] from(values) {
    unsafe {
        return ptr.borrow_slice_mut(ptr.as_mut_ptr(values) as *mut u8, values.len * 4, values)
    }
}
