package gpu

import "core/mem"
import "core/ptr"
import "std/gpu/hal"
import "std/gpu/hal/native" as native_hal
import "std/gpu/hal/opengl" as opengl_hal
import "std/gpu/hal/vulkan" as vulkan_hal
import "std/window/handle"

// Portable GPU computing and rendering on Vulkan, Metal and OpenGL.
//
// One API runs on whichever GPU interface the machine has: Metal on macOS,
// Vulkan on Linux and Windows, and OpenGL 4.5 where Vulkan is missing. The
// model follows WebGPU: a Device creates buffers, textures, samplers and
// pipelines; a CommandEncoder records compute passes, render passes and
// copies; submit() runs them in order. std/gpu checks every call against
// the rules below before the backend sees it, and keeps every object alive
// until the GPU has finished with it, so safe code cannot make the GPU read
// freed memory or write outside a buffer through std/gpu.
//
// Resources borrow their device, so the device outlives them. Recording
// mistakes, such as a draw without a pipeline or a buffer bound without
// the usage its slot needs, panic like an out-of-bounds index; creating
// objects and copying data return errors.
//
// The CPU runs ahead of the GPU: write_buffer and write_texture copy the
// data into a staging ring and record the copy into an upload command
// buffer that runs just before the next submission, so they never wait
// for the GPU. A Surface keeps two or three frames in flight. Reading
// results back waits for every submission so far; on Vulkan the data comes
// through memory the CPU caches.
//
// std/gpu tracks how each command uses every buffer and texture, and asks
// the backend for a barrier only where a command depends on an earlier one
// of the same command encoder, with exactly the stages and accesses
// involved. Each submission starts after the ones before it have finished.
// Within one render pass, draws are not ordered against each other: a
// draw cannot read what an earlier draw of the same pass wrote to a
// storage buffer or texture.
//
// Shaders are given in each backend's language at once (ShaderSource):
// SPIR-V words for Vulkan, Metal Shading Language source for Metal, GLSL
// source for OpenGL. Bindings are numbered slots, the same number in every
// language. Use a device from the thread that opened it.

pub type Error = hal.Error
pub type Api = hal.Api
pub type Limits = hal.Limits
pub type TextureDescriptor = hal.TextureDescriptor
pub type SamplerDescriptor = hal.SamplerDescriptor
pub type Region = hal.Region
pub type ShaderSource = hal.ShaderSource
pub type BindingLayout = hal.BindingLayout
pub type VertexAttribute = hal.VertexAttribute
pub type VertexBufferLayout = hal.VertexBufferLayout
pub type ComputePipelineDescriptor = hal.ComputePipelineDescriptor
pub type RenderPipelineDescriptor = hal.RenderPipelineDescriptor

pub fn error_name(error: Error) -> &str from(static) {
    match error {
        Error.NoBackend => {
            return "NoBackend"
        }
        Error.Unsupported => {
            return "Unsupported"
        }
        Error.InvalidInput => {
            return "InvalidInput"
        }
        Error.MissingShader => {
            return "MissingShader"
        }
        Error.InvalidShader => {
            return "InvalidShader"
        }
        Error.OutOfMemory => {
            return "OutOfMemory"
        }
        Error.DeviceLost => {
            return "DeviceLost"
        }
        Error.Outdated => {
            return "Outdated"
        }
        Error.System => {
            return "System"
        }
    }
}

pub fn api_name(api: &Api) -> &str from(static) {
    match api {
        Api.Vulkan => {
            return "Vulkan"
        }
        Api.Metal => {
            return "Metal"
        }
        Api.OpenGl => {
            return "OpenGL"
        }
    }
}

// Buffer usages, combined with `|`. A buffer can only be used in the ways
// it was created for.
// The source of copies, and readable with read_buffer.
pub const BUFFER_COPY_SRC: u32 = 1
// The destination of copies, and writable with write_buffer.
pub const BUFFER_COPY_DST: u32 = 2
pub const BUFFER_INDEX: u32 = 4
pub const BUFFER_VERTEX: u32 = 8
pub const BUFFER_UNIFORM: u32 = 16
pub const BUFFER_STORAGE: u32 = 32

// Texture usages, combined with `|`.
// The source of copies, and readable with read_texture.
pub const TEXTURE_COPY_SRC: u32 = 1
// The destination of copies, and writable with write_texture.
pub const TEXTURE_COPY_DST: u32 = 2
pub const TEXTURE_SAMPLED: u32 = 4
pub const TEXTURE_STORAGE: u32 = 8
// A render pass attachment.
pub const TEXTURE_RENDER: u32 = 16

// Texture formats.
pub const FORMAT_NONE: u32 = 0
pub const FORMAT_R8_UNORM: u32 = 1
pub const FORMAT_RG8_UNORM: u32 = 2
pub const FORMAT_RGBA8_UNORM: u32 = 3
pub const FORMAT_RGBA8_UNORM_SRGB: u32 = 4
pub const FORMAT_BGRA8_UNORM: u32 = 5
pub const FORMAT_BGRA8_UNORM_SRGB: u32 = 6
pub const FORMAT_R16_FLOAT: u32 = 7
pub const FORMAT_RG16_FLOAT: u32 = 8
pub const FORMAT_RGBA16_FLOAT: u32 = 9
pub const FORMAT_R32_FLOAT: u32 = 10
pub const FORMAT_RG32_FLOAT: u32 = 11
pub const FORMAT_RGBA32_FLOAT: u32 = 12
pub const FORMAT_R32_UINT: u32 = 13
pub const FORMAT_R32_SINT: u32 = 14
pub const FORMAT_RGBA32_UINT: u32 = 15
pub const FORMAT_DEPTH32_FLOAT: u32 = 16

// The size of one texel of `format` in bytes, or 0 for an unknown format.
pub fn texel_size(format: u32) -> u32 {
    return hal.texel_size(format)
}

// Shader stages that use a binding, combined with `|`.
pub const STAGE_VERTEX: u32 = 1
pub const STAGE_FRAGMENT: u32 = 2
pub const STAGE_COMPUTE: u32 = 4

// Vertex attribute formats.
pub const VERTEX_FLOAT32: u32 = 1
pub const VERTEX_FLOAT32X2: u32 = 2
pub const VERTEX_FLOAT32X3: u32 = 3
pub const VERTEX_FLOAT32X4: u32 = 4
pub const VERTEX_UINT32: u32 = 5
pub const VERTEX_UINT32X2: u32 = 6
pub const VERTEX_UINT32X3: u32 = 7
pub const VERTEX_UINT32X4: u32 = 8
pub const VERTEX_SINT32: u32 = 9
pub const VERTEX_SINT32X2: u32 = 10
pub const VERTEX_SINT32X3: u32 = 11
pub const VERTEX_SINT32X4: u32 = 12
pub const VERTEX_UNORM8X4: u32 = 13

pub const TOPOLOGY_TRIANGLE_LIST: u32 = 0
pub const TOPOLOGY_TRIANGLE_STRIP: u32 = 1
pub const TOPOLOGY_LINE_LIST: u32 = 2
pub const TOPOLOGY_LINE_STRIP: u32 = 3
pub const TOPOLOGY_POINT_LIST: u32 = 4

pub const CULL_NONE: u32 = 0
pub const CULL_FRONT: u32 = 1
pub const CULL_BACK: u32 = 2

// The winding of front faces, seen with y pointing up in clip space.
pub const FRONT_CCW: u32 = 0
pub const FRONT_CW: u32 = 1

pub const INDEX_UINT16: u32 = 1
pub const INDEX_UINT32: u32 = 2

pub const BLEND_REPLACE: u32 = 0
pub const BLEND_ALPHA: u32 = 1
pub const BLEND_PREMULTIPLIED: u32 = 2
pub const BLEND_ADDITIVE: u32 = 3

pub const COMPARE_NEVER: u32 = 1
pub const COMPARE_LESS: u32 = 2
pub const COMPARE_EQUAL: u32 = 3
pub const COMPARE_LESS_EQUAL: u32 = 4
pub const COMPARE_GREATER: u32 = 5
pub const COMPARE_NOT_EQUAL: u32 = 6
pub const COMPARE_GREATER_EQUAL: u32 = 7
pub const COMPARE_ALWAYS: u32 = 8

pub const FILTER_NEAREST: u32 = 0
pub const FILTER_LINEAR: u32 = 1

pub const ADDRESS_CLAMP: u32 = 0
pub const ADDRESS_REPEAT: u32 = 1
pub const ADDRESS_MIRROR: u32 = 2

pub const LOAD_CLEAR: u32 = 0
pub const LOAD_KEEP: u32 = 1

// Binding slots per pipeline, numbered from 0.
pub const MAX_SLOTS: u32 = 16
pub const MAX_VERTEX_BUFFERS: u32 = 8
pub const MAX_VERTEX_ATTRIBUTES: u32 = 16
// Buffer offsets bound to a slot are multiples of this.
pub const BINDING_ALIGNMENT: u64 = 256

// Which backend Device.open tries.
pub enum Preference {
    // The operating system's own API (Metal on macOS), then Vulkan, then
    // OpenGL.
    Auto,
    Vulkan,
    Metal,
    OpenGl
}

pub struct Options {
    pub backend: Preference
    // Turn on the API's validation where it exists: the Khronos validation
    // layer for Vulkan when installed, a debug context for OpenGL.
    pub debug: bool

    pub fn default() -> Options {
        return Options { backend: Preference.Auto, debug: false }
    }
    pub fn with_backend(backend: Preference) -> Options {
        return Options { backend: backend, debug: false }
    }
}

enum Raw {
    Vulkan(vulkan_hal.Device),
    Native(native_hal.Device),
    OpenGl(opengl_hal.Device)
}

// Objects dropped while the GPU may still use them wait here.
const GRAVEYARD: usize = 64
// Marks an object that an open encoder may use.
const PENDING: u64 = 0xffffffffffffffff

struct Life {
    open_encoders: u32
    submitted: u64
    count: usize
    object: [64]u32
    a: [64]u64
    b: [64]u64
    c: [64]u64
    d: [64]u64
    wait: [64]u64
}

// The staging ring starts at RING_START bytes and doubles up to RING_MAX
// when it runs out of room while the GPU still reads it; writes of more
// than a quarter of RING_MAX get a staging buffer of their own.
const RING_START: u64 = 4 * 1024 * 1024
const RING_MAX: u64 = 64 * 1024 * 1024
// Ring offsets keep every texel size's alignment.
const RING_ALIGNMENT: u64 = 16
const MARKS: usize = 32

// Staged transfers: the upload encoder, the ring it copies from, and the
// buffer reads come back through.
struct Uploads {
    // The upload encoder is recording; it counts as an open encoder.
    open: bool
    encoder: hal.Handle
    hazards: Hazards
    ring: hal.Handle
    ring_size: u64
    ring_address: usize
    // Positions in the ring count bytes ever allocated: `head` is the next
    // one, everything from `tail` on may still be read by the GPU.
    head: u64
    tail: u64
    // Submitted uploads, oldest first: once submission `mark_index[i]`
    // has finished, the ring is free up to `mark_end[i]`.
    mark_index: [32]u64
    mark_end: [32]u64
    marks: usize
    readback: hal.Handle
    readback_size: u64
    readback_address: usize
}

// The handles of Uploads, for get_handle and set_handle.
const UPLOAD_ENCODER: u32 = 0
const UPLOAD_RING: u32 = 1
const UPLOAD_READBACK: u32 = 2

// Uploads is changed through a pointer from &Device, which allows reading
// and writing its fields but no borrows of them.
fn get_handle(which: u32, uploads: *mut Uploads) -> hal.Handle {
    unsafe {
        if which == UPLOAD_ENCODER {
            return hal.Handle { a: (*uploads).encoder.a, b: (*uploads).encoder.b, c: (*uploads).encoder.c, d: (*uploads).encoder.d }
        }
        if which == UPLOAD_RING {
            return hal.Handle { a: (*uploads).ring.a, b: (*uploads).ring.b, c: (*uploads).ring.c, d: (*uploads).ring.d }
        }
        return hal.Handle { a: (*uploads).readback.a, b: (*uploads).readback.b, c: (*uploads).readback.c, d: (*uploads).readback.d }
    }
}

fn set_handle(which: u32, uploads: *mut Uploads, handle: &hal.Handle) {
    unsafe {
        if which == UPLOAD_ENCODER {
            (*uploads).encoder.a = handle.a
            (*uploads).encoder.b = handle.b
            (*uploads).encoder.c = handle.c
            (*uploads).encoder.d = handle.d
        } else if which == UPLOAD_RING {
            (*uploads).ring.a = handle.a
            (*uploads).ring.b = handle.b
            (*uploads).ring.c = handle.c
            (*uploads).ring.d = handle.d
        } else {
            (*uploads).readback.a = handle.a
            (*uploads).readback.b = handle.b
            (*uploads).readback.c = handle.c
            (*uploads).readback.d = handle.d
        }
    }
}

fn take_hazards(uploads: *mut Uploads) -> Hazards {
    unsafe {
        return Hazards { table: (*uploads).hazards.table, capacity: (*uploads).hazards.capacity, count: (*uploads).hazards.count, off: (*uploads).hazards.off, degraded: (*uploads).hazards.degraded }
    }
}

fn put_hazards(uploads: *mut Uploads, hazards: &Hazards) {
    unsafe {
        (*uploads).hazards.table = hazards.table
        (*uploads).hazards.capacity = hazards.capacity
        (*uploads).hazards.count = hazards.count
        (*uploads).hazards.off = hazards.off
        (*uploads).hazards.degraded = hazards.degraded
    }
}

// Where a staged write's bytes go: `address` maps `offset` of `buffer`.
struct Staging {
    buffer: hal.Handle
    offset: u64
    address: usize
    // A buffer of its own, retired once the upload has run.
    dedicated: bool
}

// A GPU and the queue its work runs on.
pub struct Device {
    raw: Raw
    limits: hal.Limits
    name: [256]u8
    name_length: usize
    life: Life
    uploads: Uploads
    // Whether std/gpu stages transfers itself and tracks hazards for
    // barriers (both off for OpenGL and Metal respectively).
    staged: bool
    tracks: bool

    // Open a device. With Preference.Auto, tries the operating system's
    // own API, then Vulkan, then OpenGL. Fails with NoBackend when no
    // backend could be used and Unsupported when the requested one lacks
    // what std/gpu needs, such as Vulkan before 1.2 or OpenGL before 4.5.
    pub fn open(options: Options) -> Device!Error {
        debug := options.debug
        match &options.backend {
            Preference.Vulkan => {
                return Device.from_raw(Raw.Vulkan(vulkan_hal.Device.open(debug)?))
            }
            Preference.Metal => {
                return Device.from_raw(Raw.Native(native_hal.Device.open(debug)?))
            }
            Preference.OpenGl => {
                return Device.from_raw(Raw.OpenGl(opengl_hal.Device.open(debug)?))
            }
            Preference.Auto => {}
        }
        // Keep the most telling failure: an error other than a missing
        // backend explains more.
        failure := Error.NoBackend
        match native_hal.Device.open(debug) {
            ok(device) => {
                return Device.from_raw(Raw.Native(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match vulkan_hal.Device.open(debug) {
            ok(device) => {
                return Device.from_raw(Raw.Vulkan(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match opengl_hal.Device.open(debug) {
            ok(device) => {
                return Device.from_raw(Raw.OpenGl(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        return err(failure)
    }

    // Open a device that can present to a window, for a Surface. OpenGL
    // devices draw with the window's own context, so only this window can
    // have a Surface on them; Vulkan prefers a GPU that can present to it.
    // Fails like open().
    pub fn open_for_window(native: &handle.NativeHandle, options: Options) -> Device!Error {
        debug := options.debug
        match &options.backend {
            Preference.Vulkan => {
                return Device.from_raw(Raw.Vulkan(vulkan_hal.Device.open_for_window(native, debug)?))
            }
            Preference.Metal => {
                return Device.from_raw(Raw.Native(native_hal.Device.open_for_window(native, debug)?))
            }
            Preference.OpenGl => {
                return Device.from_raw(Raw.OpenGl(opengl_hal.Device.open_for_window(native, debug)?))
            }
            Preference.Auto => {}
        }
        failure := Error.NoBackend
        match native_hal.Device.open_for_window(native, debug) {
            ok(device) => {
                return Device.from_raw(Raw.Native(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match vulkan_hal.Device.open_for_window(native, debug) {
            ok(device) => {
                return Device.from_raw(Raw.Vulkan(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match opengl_hal.Device.open_for_window(native, debug) {
            ok(device) => {
                return Device.from_raw(Raw.OpenGl(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        return err(failure)
    }

    fn from_raw(raw: Raw) -> Device!Error {
        device := Device {
            raw: raw,
            limits: hal.Limits { max_texture_size: 0, max_buffer_size: 0, max_uniform_binding_size: 0, max_storage_binding_size: 0, max_workgroups: 0, max_workgroup_size_x: 0, max_workgroup_size_y: 0, max_workgroup_size_z: 0, max_workgroup_invocations: 0 },
            name: [0u8; 256],
            name_length: 0,
            life: Life { open_encoders: 0, submitted: 0, count: 0, object: [0u32; 64], a: [0u64; 64], b: [0u64; 64], c: [0u64; 64], d: [0u64; 64], wait: [0u64; 64] },
            uploads: Uploads {
                open: false,
                encoder: hal.Handle.null(),
                hazards: Hazards.new(false),
                ring: hal.Handle.null(),
                ring_size: 0,
                ring_address: 0,
                head: 0,
                tail: 0,
                mark_index: [0u64; 32],
                mark_end: [0u64; 32],
                marks: 0,
                readback: hal.Handle.null(),
                readback_size: 0,
                readback_address: 0
            },
            staged: false,
            tracks: false
        }
        device.staged = device.raw_staged()
        device.tracks = match device.api() {
            Api.Metal => false,
            _ => true,
        }
        device.uploads.hazards = Hazards.new(device.tracks)
        device.limits = device.raw_limits()
        name := [0u8; 256]
        length := device.raw_name(&mut name)
        // Names are shown as ASCII.
        for i in 0usize..length {
            if name[i] >= 128 {
                name[i] = 63
            }
        }
        device.name = name
        device.name_length = length
        return ok(device)
    }

    // The API this device uses.
    pub fn api(&self) -> Api {
        match &self.raw {
            Raw.Vulkan(raw) => {
                return raw.api()
            }
            Raw.Native(raw) => {
                return raw.api()
            }
            Raw.OpenGl(raw) => {
                return raw.api()
            }
        }
    }

    // The GPU's name as the driver reports it, such as "Apple M2" or
    // "llvmpipe (LLVM 19.1.7, 256 bits)".
    pub fn name(&self) -> &str from(self) {
        unsafe {
            return mem.str_from_utf8(&self.name[..self.name_length])
        }
    }

    pub fn limits(&self) -> Limits {
        return self.limits.copy()
    }

    // A buffer of `size` bytes, initially zero, usable in the ways `usage`
    // combines (BUFFER_*). Fails with InvalidInput for a zero size, one
    // above limits().max_buffer_size or an empty or unknown usage.
    pub fn create_buffer(&self, size: u64, usage: u32) -> Buffer!Error from(self) {
        if size == 0 || size > self.limits.max_buffer_size || usage == 0 || (usage & ~hal.BUFFER_USAGES) != 0 {
            return err(Error.InvalidInput)
        }
        // Whole words, so that shaders reading u32s stay in bounds.
        rounded := (size + 3) & ~3u64
        handle := self.raw_create_buffer(rounded, usage)?
        // Mapped buffers start out zero; the others are cleared on the GPU
        // before anything else uses them.
        if self.staged && self.raw_mapped(&handle) == 0 {
            match self.upload_encoder() {
                ok(encoder) => {
                    self.use_uploaded(&mut encoder, handle.a, hal.USE_COPY_DST)
                    self.raw_clear_buffer(&mut encoder, &handle, 0, rounded)
                    self.upload_done(&encoder)
                }
                err(error) => {
                    self.raw_destroy(hal.OBJECT_BUFFER, &handle)
                    return err(error)
                }
            }
        }
        return ok(Buffer { device: self, handle: handle, size: size, usage: usage })
    }

    // A buffer holding a copy of `data`, which must not be empty. The
    // usage needs no BUFFER_COPY_DST for this first write.
    pub fn create_buffer_with_data(&self, data: &[u8], usage: u32) -> Buffer!Error from(self) {
        buffer := self.create_buffer(data.len as u64, usage)?
        if !self.staged {
            self.raw_write_buffer(&buffer.handle, 0, data)?
            return ok(buffer)
        }
        // Nothing uses a new buffer yet: write a mapped one directly.
        address := self.raw_mapped(&buffer.handle)
        if address != 0 {
            unsafe {
                ptr.copy_nonoverlapping(ptr.as_ptr(data), address as *mut u8, data.len)
            }
            return ok(buffer)
        }
        self.stage_buffer_write(&buffer.handle, 0, data)?
        return ok(buffer)
    }

    // Copy `data` into `buffer` at `offset`. The write happens after every
    // submission made before it and before every later one, as if it were
    // a command of its own. Needs BUFFER_COPY_DST; fails with InvalidInput
    // when the range does not fit.
    pub fn write_buffer(&self, buffer: &Buffer, offset: u64, data: &[u8]) -> void!Error {
        self.check_owner(buffer.device)
        if (buffer.usage & hal.BUFFER_COPY_DST) == 0 || !fits(offset, data.len as u64, buffer.size) {
            return err(Error.InvalidInput)
        }
        if data.len == 0 {
            return ok()
        }
        if !self.staged {
            return self.raw_write_buffer(&buffer.handle, offset, data)
        }
        address := self.raw_mapped(&buffer.handle)
        if address != 0 && ((offset | data.len as u64) & 3) != 0 {
            // Copies move whole words on some GPUs: write a mapped buffer
            // directly instead, once the GPU is done with it.
            self.finish()?
            unsafe {
                ptr.copy_nonoverlapping(ptr.as_ptr(data), (address + offset as usize) as *mut u8, data.len)
            }
            return ok()
        }
        return self.stage_buffer_write(&buffer.handle, offset, data)
    }

    // Copy bytes of `buffer` from `offset` into `out`, after waiting for
    // every submission made so far. Needs BUFFER_COPY_SRC; fails with
    // InvalidInput when the range does not fit.
    pub fn read_buffer(&self, buffer: &Buffer, offset: u64, out: &mut[u8]) -> void!Error {
        self.check_owner(buffer.device)
        if (buffer.usage & hal.BUFFER_COPY_SRC) == 0 || !fits(offset, out.len as u64, buffer.size) {
            return err(Error.InvalidInput)
        }
        if out.len == 0 {
            return ok()
        }
        if !self.staged {
            return self.raw_read_buffer(&buffer.handle, offset, out)
        }
        self.finish()?
        address := self.raw_mapped(&buffer.handle)
        if address != 0 {
            self.raw_invalidate(&buffer.handle, offset, out.len as u64)
            unsafe {
                ptr.copy_nonoverlapping((address + offset as usize) as *const u8, ptr.as_mut_ptr(out), out.len)
            }
            return ok()
        }
        // Copy the words holding the range into the readback buffer.
        start := offset & ~3u64
        end := (offset + out.len as u64 + 3) & ~3u64
        readback := self.readback(end - start)?
        encoder := self.raw_begin_encoder()?
        self.raw_copy_buffer(&mut encoder, &buffer.handle, start, &readback, 0, end - start)
        self.run_readback(&mut encoder, &readback, end - start)?
        unsafe {
            source := (*self.uploads()).readback_address + (offset - start) as usize
            ptr.copy_nonoverlapping(source as *const u8, ptr.as_mut_ptr(out), out.len)
        }
        return ok()
    }

    // A two-dimensional texture. Fails with InvalidInput for a zero size,
    // one above limits().max_texture_size, an unknown format, or a usage
    // the format does not allow: depth formats can only be rendered to,
    // sampled and copied from, and TEXTURE_STORAGE needs one of the
    // formats every backend can store to (rgba8unorm, rgba16float,
    // r32float, rg32float, rgba32float, r32uint, r32sint, rgba32uint).
    pub fn create_texture(&self, descriptor: TextureDescriptor) -> Texture!Error from(self) {
        width := descriptor.width
        height := descriptor.height
        format := descriptor.format
        usage := descriptor.usage
        if width == 0 || height == 0 || width > self.limits.max_texture_size || height > self.limits.max_texture_size {
            return err(Error.InvalidInput)
        }
        if format == hal.FORMAT_NONE || format >= hal.FORMAT_COUNT || usage == 0 || (usage & ~hal.TEXTURE_USAGES) != 0 {
            return err(Error.InvalidInput)
        }
        if hal.is_depth(format) && (usage & (hal.TEXTURE_COPY_DST | hal.TEXTURE_STORAGE)) != 0 {
            return err(Error.InvalidInput)
        }
        if (usage & hal.TEXTURE_STORAGE) != 0 && !hal.is_storage(format) {
            return err(Error.InvalidInput)
        }
        handle := self.raw_create_texture(&descriptor)?
        if self.staged {
            match self.upload_encoder() {
                ok(encoder) => {
                    self.use_uploaded(&mut encoder, handle.a ^ TEXTURE_KEY, hal.USE_COPY_DST)
                    self.raw_initialize_texture(&mut encoder, &handle, &descriptor)
                    self.upload_done(&encoder)
                }
                err(error) => {
                    self.raw_destroy(hal.OBJECT_TEXTURE, &handle)
                    return err(error)
                }
            }
        }
        return ok(Texture { device: self, handle: handle, descriptor: descriptor, external: false })
    }

    // Copy texels from `data` into `region` of `texture`, rows
    // `bytes_per_row` apart, top row first. Ordered like write_buffer.
    // Needs TEXTURE_COPY_DST; fails with InvalidInput when the region is
    // outside the texture, a row is shorter than the region or not a
    // multiple of the texel size, or `data` is too short.
    pub fn write_texture(&self, texture: &Texture, region: Region, data: &[u8], bytes_per_row: u32) -> void!Error {
        self.check_owner(texture.device)
        if (texture.descriptor.usage & hal.TEXTURE_COPY_DST) == 0 || hal.is_depth(texture.descriptor.format) || !texture_copy_fits(&texture.descriptor, &region, data.len as u64, 0, bytes_per_row) {
            return err(Error.InvalidInput)
        }
        if region.width == 0 || region.height == 0 {
            return ok()
        }
        if !self.staged {
            return self.raw_write_texture(&texture.handle, &texture.descriptor, &region, data, bytes_per_row)
        }
        size := copy_size(&texture.descriptor, &region, bytes_per_row)
        staging := self.stage(&data[..size as usize])?
        encoder := self.upload_encoder()?
        self.use_uploaded(&mut encoder, staging.buffer.a, hal.USE_COPY_SRC)
        self.use_uploaded(&mut encoder, texture.handle.a ^ TEXTURE_KEY, hal.USE_COPY_DST)
        self.raw_copy_buffer_to_texture(&mut encoder, &staging.buffer, staging.offset, bytes_per_row, &texture.handle, &texture.descriptor, &region)
        self.upload_done(&encoder)
        self.unstage(&staging)
        return ok()
    }

    // Copy texels of `region` into `out`, rows `bytes_per_row` apart, top
    // row first, after waiting for every submission made so far. Needs
    // TEXTURE_COPY_SRC; fails like write_texture.
    pub fn read_texture(&self, texture: &Texture, region: Region, out: &mut[u8], bytes_per_row: u32) -> void!Error {
        self.check_owner(texture.device)
        if (texture.descriptor.usage & hal.TEXTURE_COPY_SRC) == 0 || !texture_copy_fits(&texture.descriptor, &region, out.len as u64, 0, bytes_per_row) {
            return err(Error.InvalidInput)
        }
        if region.width == 0 || region.height == 0 {
            return ok()
        }
        if !self.staged {
            return self.raw_read_texture(&texture.handle, &texture.descriptor, &region, out, bytes_per_row)
        }
        self.finish()?
        size := copy_size(&texture.descriptor, &region, bytes_per_row)
        readback := self.readback(size)?
        encoder := self.raw_begin_encoder()?
        self.raw_copy_texture_to_buffer(&mut encoder, &texture.handle, &texture.descriptor, &region, &readback, 0, bytes_per_row)
        self.run_readback(&mut encoder, &readback, size)?
        unsafe {
            ptr.copy_nonoverlapping((*self.uploads()).readback_address as *const u8, ptr.as_mut_ptr(out), size as usize)
        }
        return ok()
    }

    pub fn create_sampler(&self, descriptor: SamplerDescriptor) -> Sampler!Error from(self) {
        if descriptor.mag_filter > hal.FILTER_LINEAR || descriptor.min_filter > hal.FILTER_LINEAR || descriptor.address_u > hal.ADDRESS_MIRROR || descriptor.address_v > hal.ADDRESS_MIRROR {
            return err(Error.InvalidInput)
        }
        handle := self.raw_create_sampler(&descriptor)?
        return ok(Sampler { device: self, handle: handle })
    }

    // A compute pipeline. Fails with MissingShader when the source has no
    // code for this device's API, InvalidShader when it does not compile
    // or lacks the entry point, and InvalidInput for a bad binding layout
    // or a workgroup size outside the limits.
    pub fn create_compute_pipeline(&self, descriptor: ComputePipelineDescriptor) -> ComputePipeline!Error from(self) {
        pipeline := hal.Pipeline.empty()
        check_bindings(descriptor.bindings, hal.STAGE_COMPUTE, &mut pipeline)?
        x := descriptor.workgroup_size_x
        y := descriptor.workgroup_size_y
        z := descriptor.workgroup_size_z
        limits := &self.limits
        if x == 0 || y == 0 || z == 0 || x > limits.max_workgroup_size_x || y > limits.max_workgroup_size_y || z > limits.max_workgroup_size_z {
            return err(Error.InvalidInput)
        }
        if x as u64 * y as u64 * z as u64 > limits.max_workgroup_invocations as u64 {
            return err(Error.InvalidInput)
        }
        if mem.str_bytes(descriptor.entry).len == 0 {
            return err(Error.InvalidInput)
        }
        self.check_source(descriptor.source)?
        pipeline.workgroup_size_x = x
        pipeline.workgroup_size_y = y
        pipeline.workgroup_size_z = z
        pipeline.handle = self.raw_create_compute_pipeline(&descriptor)?
        return ok(ComputePipeline { device: self, pipeline: pipeline })
    }

    // A render pipeline. Fails like create_compute_pipeline, and with
    // InvalidInput for vertex layouts beyond MAX_VERTEX_BUFFERS or
    // MAX_VERTEX_ATTRIBUTES, a repeated location, an attribute outside its
    // stride, a color format that cannot be rendered to (or blended, with
    // blending on), or a depth format that is not one.
    pub fn create_render_pipeline(&self, descriptor: RenderPipelineDescriptor) -> RenderPipeline!Error from(self) {
        pipeline := hal.Pipeline.empty()
        check_bindings(descriptor.bindings, hal.STAGE_VERTEX | hal.STAGE_FRAGMENT, &mut pipeline)?
        layouts := descriptor.vertex_buffers
        if layouts.len > hal.MAX_VERTEX_BUFFERS as usize {
            return err(Error.InvalidInput)
        }
        locations := 0u32
        attribute_count := 0usize
        for i in 0usize..layouts.len {
            layout := &layouts[i]
            if layout.step > hal.STEP_INSTANCE || layout.stride > 2048 || (layout.stride & 3) != 0 {
                return err(Error.InvalidInput)
            }
            extent := 0u32
            for j in 0usize..layout.attributes.len {
                attribute := &layout.attributes[j]
                size := hal.vertex_size(attribute.format)
                if size == 0 || attribute.location >= hal.MAX_VERTEX_ATTRIBUTES || (locations >> attribute.location & 1) != 0 || (attribute.offset & 3) != 0 {
                    return err(Error.InvalidInput)
                }
                end := attribute.offset as u64 + size as u64
                if end > 2048 || (layout.stride != 0 && end > layout.stride as u64) {
                    return err(Error.InvalidInput)
                }
                if end as u32 > extent {
                    extent = end as u32
                }
                locations = locations | (1u32 << attribute.location)
                attribute_count += 1
            }
            // A zero stride repeats one vertex; it still needs its bytes.
            pipeline.strides[i] = layout.stride
            pipeline.steps[i] = layout.step
            pipeline.extents[i] = extent
        }
        if attribute_count > hal.MAX_VERTEX_ATTRIBUTES as usize {
            return err(Error.InvalidInput)
        }
        pipeline.vertex_buffer_count = layouts.len as u32
        color := descriptor.color_format
        if color == hal.FORMAT_NONE || color >= hal.FORMAT_COUNT || hal.is_depth(color) {
            return err(Error.InvalidInput)
        }
        if descriptor.blend > hal.BLEND_ADDITIVE || (descriptor.blend != hal.BLEND_REPLACE && !hal.is_blendable(color)) {
            return err(Error.InvalidInput)
        }
        if descriptor.depth_format != hal.FORMAT_NONE && !hal.is_depth(descriptor.depth_format) {
            return err(Error.InvalidInput)
        }
        if descriptor.topology > hal.TOPOLOGY_POINT_LIST || descriptor.cull_mode > hal.CULL_BACK || descriptor.front_face > hal.FRONT_CW {
            return err(Error.InvalidInput)
        }
        if descriptor.depth_compare < hal.COMPARE_NEVER || descriptor.depth_compare > hal.COMPARE_ALWAYS {
            return err(Error.InvalidInput)
        }
        if mem.str_bytes(descriptor.vertex_entry).len == 0 || mem.str_bytes(descriptor.fragment_entry).len == 0 {
            return err(Error.InvalidInput)
        }
        self.check_source(descriptor.vertex)?
        self.check_source(descriptor.fragment)?
        pipeline.topology = descriptor.topology
        pipeline.color_format = color
        pipeline.depth_format = descriptor.depth_format
        pipeline.handle = self.raw_create_render_pipeline(&descriptor)?
        return ok(RenderPipeline { device: self, pipeline: pipeline })
    }

    // Start recording commands.
    pub fn encoder(&self) -> CommandEncoder!Error from(self) {
        self.collect(false)
        handle := self.raw_begin_encoder()?
        unsafe {
            (*self.life()).open_encoders += 1
        }
        return ok(CommandEncoder { device: self, handle: handle, open: true, hazards: Hazards.new(self.tracks) })
    }

    // Wait until the GPU has finished everything submitted so far,
    // including writes not yet followed by a submission.
    pub fn wait(&self) -> void!Error {
        self.finish()?
        self.collect(false)
        return ok()
    }

    // Destroy dropped objects the GPU has finished with, and start staged
    // writes not yet followed by a submission. submit() and wait() do this
    // too; call it in programs that drop objects and then submit nothing
    // for a while.
    pub fn poll(&self) {
        match self.flush() {
            ok() => {}
            err(_) => {}
        }
        self.collect(false)
    }

    fn uploads(&self) -> *mut Uploads {
        unsafe {
            return ptr.from_ref(&self.uploads) as *mut Uploads
        }
    }

    // Submit staged writes, then wait for every submission.
    fn finish(&self) -> void!Error {
        self.flush()?
        submitted := unsafe {
            (*self.life()).submitted
        }
        if submitted != 0 {
            self.raw_wait(submitted)?
        }
        return ok()
    }

    // The upload encoder, begun if it is not recording. Record into the
    // copy, then store it back with upload_done.
    fn upload_encoder(&self) -> hal.Handle!Error {
        uploads := self.uploads()
        unsafe {
            if !(*uploads).open {
                encoder := self.raw_begin_encoder()?
                set_handle(UPLOAD_ENCODER, uploads, &encoder)
                (*uploads).open = true
                (*self.life()).open_encoders += 1
                return ok(encoder)
            }
        }
        return ok(get_handle(UPLOAD_ENCODER, uploads))
    }

    fn upload_done(&self, encoder: &hal.Handle) {
        set_handle(UPLOAD_ENCODER, self.uploads(), encoder)
    }

    // Record a use by the upload encoder, with the barrier it needs.
    fn use_uploaded(&self, encoder: &mut hal.Handle, key: u64, usage: u32) {
        uploads := self.uploads()
        before := 0u32
        after := 0u32
        hazards := take_hazards(uploads)
        hazards.use_resource(key, usage, (usage & hal.USE_WRITES) != 0, &mut before, &mut after)
        put_hazards(uploads, &hazards)
        if before != 0 {
            self.raw_barrier(encoder, before, after)
        }
    }

    // Submit the upload encoder, if it recorded anything.
    fn flush(&self) -> void!Error {
        uploads := self.uploads()
        open := unsafe {
            (*uploads).open
        }
        if !open {
            return ok()
        }
        encoder := get_handle(UPLOAD_ENCODER, uploads)
        hazards := take_hazards(uploads)
        hazards.clear()
        put_hazards(uploads, &hazards)
        unsafe {
            (*uploads).open = false
        }
        index := match self.raw_submit(&mut encoder) {
            ok(index) => index,
            err(error) => {
                self.raw_destroy(hal.OBJECT_ENCODER, &encoder)
                self.close_encoder(0)
                return err(error)
            }
        }
        unsafe {
            // Room for the mark: forget the oldest after waiting for it.
            if (*uploads).marks == MARKS {
                match self.raw_wait((*uploads).mark_index[0]) {
                    ok() => {}
                    err(_) => {}
                }
                self.reclaim()
            }
            if (*uploads).marks < MARKS {
                (*uploads).mark_index[(*uploads).marks] = index
                (*uploads).mark_end[(*uploads).marks] = (*uploads).head
                (*uploads).marks += 1
            }
        }
        self.close_encoder(index)
        self.bury(hal.OBJECT_ENCODER, &encoder, index)
        return ok()
    }

    // Free the ring space of finished uploads.
    fn reclaim(&self) {
        uploads := self.uploads()
        completed := self.raw_completed()
        unsafe {
            kept := 0usize
            for i in 0usize..(*uploads).marks {
                if (*uploads).mark_index[i] <= completed {
                    (*uploads).tail = (*uploads).mark_end[i]
                } else {
                    (*uploads).mark_index[kept] = (*uploads).mark_index[i]
                    (*uploads).mark_end[kept] = (*uploads).mark_end[i]
                    kept += 1
                }
            }
            (*uploads).marks = kept
            // Nothing submitted or recording uses the ring.
            if kept == 0 && !(*uploads).open {
                (*uploads).tail = (*uploads).head
            }
        }
    }

    // Copy `data` into staging memory for the upload encoder.
    fn stage(&self, data: &[u8]) -> Staging!Error {
        size := data.len as u64
        staging := self.staging_space(size)?
        unsafe {
            ptr.copy_nonoverlapping(ptr.as_ptr(data), staging.address as *mut u8, data.len)
        }
        return ok(staging)
    }

    // A staged write is recorded: retire its own buffer once it has run.
    fn unstage(&self, staging: &Staging) {
        if staging.dedicated {
            self.retire(hal.OBJECT_BUFFER, &staging.buffer)
        }
    }

    // `size` bytes of staging memory: in the ring when it fits, otherwise
    // in a buffer of its own.
    fn staging_space(&self, size: u64) -> Staging!Error {
        if size > RING_MAX / 4 {
            buffer := self.raw_create_buffer((size + 3) & ~3u64, hal.BUFFER_UPLOAD)?
            address := self.raw_mapped(&buffer)
            return ok(Staging { buffer: buffer, offset: 0, address: address, dedicated: true })
        }
        uploads := self.uploads()
        for {
            self.reclaim()
            ring_size := unsafe {
                (*uploads).ring_size
            }
            if ring_size != 0 {
                unsafe {
                    start := ((*uploads).head + RING_ALIGNMENT - 1) & ~(RING_ALIGNMENT - 1)
                    position := start % ring_size
                    // Allocations never wrap around the end of the ring.
                    if position + size > ring_size {
                        start += ring_size - position
                    }
                    if start + size - (*uploads).tail <= ring_size {
                        (*uploads).head = start + size
                        offset := start % ring_size
                        return ok(Staging { buffer: get_handle(UPLOAD_RING, uploads), offset: offset, address: (*uploads).ring_address + offset as usize, dedicated: false })
                    }
                }
            }
            if ring_size < RING_MAX {
                self.grow_ring(size)?
            } else {
                // The ring is as large as it gets: wait for the oldest
                // upload still using it.
                self.flush()?
                oldest := unsafe {
                    (*uploads).mark_index[0]
                }
                self.raw_wait(oldest)?
            }
        }
    }

    // Replace the ring with one at least twice as large and four times
    // `size`; the old one is retired once the GPU is done with it.
    fn grow_ring(&self, size: u64) -> void!Error {
        uploads := self.uploads()
        old_size := unsafe {
            (*uploads).ring_size
        }
        new_size := RING_START
        if old_size * 2 > new_size {
            new_size = old_size * 2
        }
        for new_size < size * 4 && new_size < RING_MAX {
            new_size = new_size * 2
        }
        if new_size > RING_MAX {
            new_size = RING_MAX
        }
        ring := self.raw_create_buffer(new_size, hal.BUFFER_UPLOAD)?
        address := self.raw_mapped(&ring)
        if old_size != 0 {
            old := get_handle(UPLOAD_RING, uploads)
            self.retire(hal.OBJECT_BUFFER, &old)
        }
        set_handle(UPLOAD_RING, uploads, &ring)
        unsafe {
            (*uploads).ring_size = new_size
            (*uploads).ring_address = address
            (*uploads).head = 0
            (*uploads).tail = 0
            (*uploads).marks = 0
        }
        return ok()
    }

    fn stage_buffer_write(&self, buffer: &hal.Handle, offset: u64, data: &[u8]) -> void!Error {
        staging := self.stage(data)?
        encoder := self.upload_encoder()?
        self.use_uploaded(&mut encoder, staging.buffer.a, hal.USE_COPY_SRC)
        self.use_uploaded(&mut encoder, buffer.a, hal.USE_COPY_DST)
        self.raw_copy_buffer(&mut encoder, &staging.buffer, staging.offset, buffer, offset, data.len as u64)
        self.upload_done(&encoder)
        self.unstage(&staging)
        return ok()
    }

    // The readback buffer, with room for `size` bytes. It is only used
    // while a read waits for it, so replacing it needs no care.
    fn readback(&self, size: u64) -> hal.Handle!Error {
        uploads := self.uploads()
        current := get_handle(UPLOAD_READBACK, uploads)
        if unsafe {
            (*uploads).readback_size
        } >= size {
            return ok(current)
        }
        unsafe {
            if (*uploads).readback_size != 0 {
                self.raw_destroy(hal.OBJECT_BUFFER, &current)
                (*uploads).readback_size = 0
            }
        }
        rounded := (size + 65535) & ~65535u64
        readback := self.raw_create_buffer(rounded, hal.BUFFER_READBACK)?
        address := self.raw_mapped(&readback)
        set_handle(UPLOAD_READBACK, uploads, &readback)
        unsafe {
            (*uploads).readback_size = rounded
            (*uploads).readback_address = address
        }
        return ok(readback)
    }

    // Submit a readback encoder, wait for it and make its writes visible.
    fn run_readback(&self, encoder: &mut hal.Handle, readback: &hal.Handle, size: u64) -> void!Error {
        index := match self.raw_submit(encoder) {
            ok(index) => index,
            err(error) => {
                self.raw_destroy(hal.OBJECT_ENCODER, encoder)
                return err(error)
            }
        }
        self.note_submission(index)
        result := self.raw_wait(index)
        self.raw_destroy(hal.OBJECT_ENCODER, encoder)
        result?
        self.raw_invalidate(readback, 0, size)
        return ok()
    }

    // The backend made submission `index` outside any encoder.
    fn note_submission(&self, index: u64) {
        if index != 0 {
            unsafe {
                (*self.life()).submitted = index
            }
        }
    }

    fn life(&self) -> *mut Life {
        unsafe {
            return ptr.from_ref(&self.life) as *mut Life
        }
    }

    fn check_owner(&self, owner: &Device) {
        assert(ptr.from_ref(owner) == ptr.from_ref(self), "the object belongs to another std/gpu device")
    }

    fn check_source(&self, source: &ShaderSource) -> void!Error {
        present := match self.api() {
            Api.Vulkan => source.spirv.len != 0,
            Api.Metal => mem.str_bytes(source.msl).len != 0,
            Api.OpenGl => mem.str_bytes(source.glsl).len != 0,
        }
        if !present {
            return err(Error.MissingShader)
        }
        return ok()
    }

    // An object was dropped: destroy it now if the GPU cannot be using it,
    // otherwise once it has finished.
    fn retire(&self, object: u32, handle: &hal.Handle) {
        life := self.life()
        open := unsafe {
            (*life).open_encoders
        }
        submitted := unsafe {
            (*life).submitted
        }
        if open == 0 && (submitted == 0 || self.raw_completed() >= submitted) {
            self.raw_destroy(object, handle)
            return
        }
        wait := submitted
        if open != 0 {
            wait = PENDING
        }
        self.bury(object, handle, wait)
    }

    fn bury(&self, object: u32, handle: &hal.Handle, wait: u64) {
        life := self.life()
        if unsafe {
            (*life).count
        } == GRAVEYARD {
            // Staged writes keep the graveyard's objects pending: start them
            // so that waiting can free some.
            match self.flush() {
                ok() => {}
                err(_) => {}
            }
            self.collect(true)
        }
        unsafe {
            index := (*life).count
            (*life).object[index] = object
            (*life).a[index] = handle.a
            (*life).b[index] = handle.b
            (*life).c[index] = handle.c
            (*life).d[index] = handle.d
            (*life).wait[index] = wait
            (*life).count = index + 1
        }
    }

    // Destroy the objects whose submissions have finished. With `block`,
    // wait for the GPU to make room when nothing can be destroyed yet.
    fn collect(&self, block: bool) {
        life := self.life()
        if unsafe {
            (*life).count
        } == 0 {
            return
        }
        completed := self.raw_completed()
        if block {
            // Objects of submitted work can be waited for even while
            // encoders are open; those of open encoders stay.
            submitted := unsafe {
                (*life).submitted
            }
            if completed < submitted {
                // A failed wait means the device is lost: destroying is
                // then safe anyway.
                match self.raw_wait(submitted) {
                    ok() => {}
                    err(_) => {}
                }
            }
            completed = submitted
        }
        kept := 0usize
        count := unsafe {
            (*life).count
        }
        for i in 0usize..count {
            wait := unsafe {
                (*life).wait[i]
            }
            handle := unsafe {
                hal.Handle { a: (*life).a[i], b: (*life).b[i], c: (*life).c[i], d: (*life).d[i] }
            }
            object := unsafe {
                (*life).object[i]
            }
            if wait != PENDING && wait <= completed {
                self.raw_destroy(object, &handle)
            } else {
                unsafe {
                    (*life).object[kept] = object
                    (*life).a[kept] = handle.a
                    (*life).b[kept] = handle.b
                    (*life).c[kept] = handle.c
                    (*life).d[kept] = handle.d
                    (*life).wait[kept] = wait
                }
                kept += 1
            }
        }
        unsafe {
            (*life).count = kept
        }
        assert(!block || kept < GRAVEYARD, "too many std/gpu objects dropped while command encoders are open")
    }

    // An encoder was submitted (`index` > 0) or abandoned (0).
    fn close_encoder(&self, index: u64) {
        life := self.life()
        unsafe {
            if index != 0 {
                (*life).submitted = index
            }
            (*life).open_encoders -= 1
            if (*life).open_encoders == 0 {
                // Every encoder that may have used these has been
                // submitted by now, or abandoned.
                for i in 0usize..(*life).count {
                    if (*life).wait[i] == PENDING {
                        (*life).wait[i] = (*life).submitted
                    }
                }
            }
        }
    }

    // Dispatch to the backend.

    fn raw_limits(&self) -> hal.Limits {
        match &self.raw {
            Raw.Vulkan(raw) => {
                return raw.limits()
            }
            Raw.Native(raw) => {
                return raw.limits()
            }
            Raw.OpenGl(raw) => {
                return raw.limits()
            }
        }
    }
    fn raw_name(&self, out: &mut[u8]) -> usize {
        match &self.raw {
            Raw.Vulkan(raw) => {
                return raw.name(out)
            }
            Raw.Native(raw) => {
                return raw.name(out)
            }
            Raw.OpenGl(raw) => {
                return raw.name(out)
            }
        }
    }
    fn raw_create_buffer(&self, size: u64, usage: u32) -> hal.Handle!Error {
        match &self.raw {
            Raw.Vulkan(raw) => {
                return raw.create_buffer(size, usage)
            }
            Raw.Native(raw) => {
                return raw.create_buffer(size, usage)
            }
            Raw.OpenGl(raw) => {
                return raw.create_buffer(size, usage)
            }
        }
    }
    fn raw_write_buffer(&self, buffer: &hal.Handle, offset: u64, data: &[u8]) -> void!Error {
        match &self.raw {
            Raw.Vulkan(raw) => {
                return raw.write_buffer(buffer, offset, data)
            }
            Raw.Native(raw) => {
                return raw.write_buffer(buffer, offset, data)
            }
            Raw.OpenGl(raw) => {
                return raw.write_buffer(buffer, offset, data)
            }
        }
    }
    fn raw_read_buffer(&self, buffer: &hal.Handle, offset: u64, out: &mut[u8]) -> void!Error {
        match &self.raw {
            Raw.Vulkan(raw) => {
                return raw.read_buffer(buffer, offset, out)
            }
            Raw.Native(raw) => {
                return raw.read_buffer(buffer, offset, out)
            }
            Raw.OpenGl(raw) => {
                return raw.read_buffer(buffer, offset, out)
            }
        }
    }
    fn raw_create_texture(&self, descriptor: &TextureDescriptor) -> hal.Handle!Error {
        match &self.raw {
            Raw.Vulkan(raw) => {
