package gpu

import "core/ascii"
import "core/mem"
import "core/ptr"
import "std/gpu/hal"
import "std/gpu/hal/native" as native_hal
import "std/gpu/hal/opengl" as opengl_hal
import "std/gpu/hal/vulkan" as vulkan_hal
import "std/window/handle"

// Portable GPU computing and rendering on Vulkan, Metal and OpenGL.
//
// One API runs on whichever GPU interface the machine has: Metal on macOS,
// Vulkan on Linux and Windows, and OpenGL 4.5 where Vulkan is missing. The
// model follows WebGPU: a Device creates buffers, textures, samplers and
// pipelines; a CommandEncoder records compute passes, render passes and
// copies; submit() runs them in order. std/gpu checks every call against
// the rules below before the backend sees it, and keeps every object alive
// until the GPU has finished with it, so safe code cannot make the GPU read
// freed memory or write outside a buffer through std/gpu.
//
// Resources borrow their device, so the device outlives them. Recording
// mistakes, such as a draw without a pipeline or a buffer bound without
// the usage its slot needs, panic like an out-of-bounds index; creating
// objects and copying data return errors.
//
// The CPU runs ahead of the GPU: write_buffer and write_texture copy the
// data into a staging ring and record the copy into an upload command
// buffer that runs just before the next submission, so they never wait
// for the GPU. A Surface keeps two or three frames in flight. Reading
// results back waits for every submission so far; on Vulkan the data comes
// through memory the CPU caches.
//
// std/gpu tracks how each command uses every buffer and texture, and asks
// the backend for a barrier only where a command depends on an earlier one
// of the same command encoder, with exactly the stages and accesses
// involved. Each submission starts after the ones before it have finished.
// Within one render pass, draws are not ordered against each other: a
// draw cannot read what an earlier draw of the same pass wrote to a
// storage buffer or texture.
//
// Shaders are given in each backend's language at once (ShaderSource):
// SPIR-V words for Vulkan, Metal Shading Language source for Metal, GLSL
// source for OpenGL. Bindings are numbered slots, the same number in every
// language. Use a device from the thread that opened it.

pub type Error = hal.Error
pub type Api = hal.Api
pub type Limits = hal.Limits
pub type TextureDescriptor = hal.TextureDescriptor
pub type SamplerDescriptor = hal.SamplerDescriptor
pub type Region = hal.Region
pub type ShaderSource = hal.ShaderSource
pub type BindingLayout = hal.BindingLayout
pub type VertexAttribute = hal.VertexAttribute
pub type VertexBufferLayout = hal.VertexBufferLayout
pub type ComputePipelineDescriptor = hal.ComputePipelineDescriptor
pub type RenderPipelineDescriptor = hal.RenderPipelineDescriptor
pub type Blend = hal.Blend
pub type ColorTarget = hal.ColorTarget

// A shader written once in WGSL, translated when the program is compiled
// into SPIR-V for Vulkan, Metal Shading Language for Metal and GLSL 4.50 for
// OpenGL. The argument is one or more string literals, joined with line
// breaks; a mistake in the shader is a compile error pointing into them.
// The result borrows static storage, so a function declared
// `-> gpu.ShaderSource from(static)` may return it.
//
// Bindings follow std/gpu's slots: slot N is `@group(0) @binding(N)` for
// buffers, sampled textures and storage textures, and the sampler read
// with the sampled texture in slot N is `@group(1) @binding(N)`. Vertex
// attribute location N is `@location(N)`. Entry points keep their WGSL
// names on every backend, so pass those names to the pipeline
// descriptors; a name Metal reserves, such as `main`, is rejected.
// Clip space and depth are as WGSL defines them, as everywhere in std/gpu.
// Immediate data (push constants) is not available.
@compiler(wgsl)
pub fn wgsl(source: &str) -> ShaderSource

pub fn error_name(error: Error) -> &str from(static) {
    match error {
        Error.NoBackend => {
            return "NoBackend"
        }
        Error.Unsupported => {
            return "Unsupported"
        }
        Error.InvalidInput => {
            return "InvalidInput"
        }
        Error.MissingShader => {
            return "MissingShader"
        }
        Error.InvalidShader => {
            return "InvalidShader"
        }
        Error.OutOfMemory => {
            return "OutOfMemory"
        }
        Error.DeviceLost => {
            return "DeviceLost"
        }
        Error.Outdated => {
            return "Outdated"
        }
        Error.System => {
            return "System"
        }
    }
}

pub fn api_name(api: &Api) -> &str from(static) {
    match api {
        Api.Vulkan => {
            return "Vulkan"
        }
        Api.Metal => {
            return "Metal"
        }
        Api.OpenGl => {
            return "OpenGL"
        }
    }
}

// Buffer usages, combined with `|`. A buffer can only be used in the ways
// it was created for.
// The source of copies, and readable with read_buffer.
pub const BUFFER_COPY_SRC: u32 = 1
// The destination of copies, and writable with write_buffer.
pub const BUFFER_COPY_DST: u32 = 2
pub const BUFFER_INDEX: u32 = 4
pub const BUFFER_VERTEX: u32 = 8
pub const BUFFER_UNIFORM: u32 = 16
pub const BUFFER_STORAGE: u32 = 32

// Texture usages, combined with `|`.
// The source of copies, and readable with read_texture.
pub const TEXTURE_COPY_SRC: u32 = 1
// The destination of copies, and writable with write_texture.
pub const TEXTURE_COPY_DST: u32 = 2
pub const TEXTURE_SAMPLED: u32 = 4
pub const TEXTURE_STORAGE: u32 = 8
// A render pass attachment.
pub const TEXTURE_RENDER: u32 = 16

// Texture formats.
pub const FORMAT_NONE: u32 = 0
pub const FORMAT_R8_UNORM: u32 = 1
pub const FORMAT_RG8_UNORM: u32 = 2
pub const FORMAT_RGBA8_UNORM: u32 = 3
pub const FORMAT_RGBA8_UNORM_SRGB: u32 = 4
pub const FORMAT_BGRA8_UNORM: u32 = 5
pub const FORMAT_BGRA8_UNORM_SRGB: u32 = 6
pub const FORMAT_R16_FLOAT: u32 = 7
pub const FORMAT_RG16_FLOAT: u32 = 8
pub const FORMAT_RGBA16_FLOAT: u32 = 9
pub const FORMAT_R32_FLOAT: u32 = 10
pub const FORMAT_RG32_FLOAT: u32 = 11
pub const FORMAT_RGBA32_FLOAT: u32 = 12
pub const FORMAT_R32_UINT: u32 = 13
pub const FORMAT_R32_SINT: u32 = 14
pub const FORMAT_RGBA32_UINT: u32 = 15
pub const FORMAT_DEPTH32_FLOAT: u32 = 16

// The size of one texel of `format` in bytes, or 0 for an unknown format.
pub fn texel_size(format: u32) -> u32 {
    return hal.texel_size(format)
}

// How many mipmap levels a `width` by `height` texture has at most, down to
// one texel; TextureDescriptor.mipmapped uses it.
pub fn mip_level_count(width: u32, height: u32) -> u32 {
    return hal.mip_level_count(width, height)
}

// The width (or height) of mipmap `level` of a texture `size` texels wide.
pub fn level_size(size: u32, level: u32) -> u32 {
    return hal.level_size(size, level)
}

// Samples per pixel of a multisampled texture: 4 on every backend.
pub const MULTISAMPLE_COUNT: u32 = 4

// Shader stages that use a binding, combined with `|`.
pub const STAGE_VERTEX: u32 = 1
pub const STAGE_FRAGMENT: u32 = 2
pub const STAGE_COMPUTE: u32 = 4

// Vertex attribute formats.
pub const VERTEX_FLOAT32: u32 = 1
pub const VERTEX_FLOAT32X2: u32 = 2
pub const VERTEX_FLOAT32X3: u32 = 3
pub const VERTEX_FLOAT32X4: u32 = 4
pub const VERTEX_UINT32: u32 = 5
pub const VERTEX_UINT32X2: u32 = 6
pub const VERTEX_UINT32X3: u32 = 7
pub const VERTEX_UINT32X4: u32 = 8
pub const VERTEX_SINT32: u32 = 9
pub const VERTEX_SINT32X2: u32 = 10
pub const VERTEX_SINT32X3: u32 = 11
pub const VERTEX_SINT32X4: u32 = 12
pub const VERTEX_UNORM8X4: u32 = 13

pub const TOPOLOGY_TRIANGLE_LIST: u32 = 0
pub const TOPOLOGY_TRIANGLE_STRIP: u32 = 1
pub const TOPOLOGY_LINE_LIST: u32 = 2
pub const TOPOLOGY_LINE_STRIP: u32 = 3
pub const TOPOLOGY_POINT_LIST: u32 = 4

pub const CULL_NONE: u32 = 0
pub const CULL_FRONT: u32 = 1
pub const CULL_BACK: u32 = 2

// The winding of front faces, seen with y pointing up in clip space.
pub const FRONT_CCW: u32 = 0
pub const FRONT_CW: u32 = 1

pub const INDEX_UINT16: u32 = 1
pub const INDEX_UINT32: u32 = 2

// Blending presets for RenderPipelineDescriptor.blend: none, straight
// alpha, premultiplied alpha, additive.
pub const BLEND_REPLACE: u32 = 0
pub const BLEND_ALPHA: u32 = 1
pub const BLEND_PREMULTIPLIED: u32 = 2
pub const BLEND_ADDITIVE: u32 = 3

// Blend factors for Blend: what the shader's output (source) and the
// attachment's value (destination) are multiplied by. CONSTANT reads the
// pass's blend constant.
pub const BLEND_FACTOR_ZERO: u32 = 0
pub const BLEND_FACTOR_ONE: u32 = 1
pub const BLEND_FACTOR_SRC: u32 = 2
pub const BLEND_FACTOR_ONE_MINUS_SRC: u32 = 3
pub const BLEND_FACTOR_SRC_ALPHA: u32 = 4
pub const BLEND_FACTOR_ONE_MINUS_SRC_ALPHA: u32 = 5
pub const BLEND_FACTOR_DST: u32 = 6
pub const BLEND_FACTOR_ONE_MINUS_DST: u32 = 7
pub const BLEND_FACTOR_DST_ALPHA: u32 = 8
pub const BLEND_FACTOR_ONE_MINUS_DST_ALPHA: u32 = 9
pub const BLEND_FACTOR_SRC_ALPHA_SATURATED: u32 = 10
pub const BLEND_FACTOR_CONSTANT: u32 = 11
pub const BLEND_FACTOR_ONE_MINUS_CONSTANT: u32 = 12

// Blend operations. MIN and MAX ignore the factors.
pub const BLEND_OP_ADD: u32 = 0
pub const BLEND_OP_SUBTRACT: u32 = 1
pub const BLEND_OP_REVERSE_SUBTRACT: u32 = 2
pub const BLEND_OP_MIN: u32 = 3
pub const BLEND_OP_MAX: u32 = 4

// The channels a color target writes, combined with `|`.
pub const COLOR_WRITE_RED: u32 = 1
pub const COLOR_WRITE_GREEN: u32 = 2
pub const COLOR_WRITE_BLUE: u32 = 4
pub const COLOR_WRITE_ALPHA: u32 = 8
pub const COLOR_WRITE_ALL: u32 = 15

// Depth comparisons, for depth tests and comparison samplers.
// COMPARE_NONE marks a sampler that does not compare.
pub const COMPARE_NONE: u32 = 0
pub const COMPARE_NEVER: u32 = 1
pub const COMPARE_LESS: u32 = 2
pub const COMPARE_EQUAL: u32 = 3
pub const COMPARE_LESS_EQUAL: u32 = 4
pub const COMPARE_GREATER: u32 = 5
pub const COMPARE_NOT_EQUAL: u32 = 6
pub const COMPARE_GREATER_EQUAL: u32 = 7
pub const COMPARE_ALWAYS: u32 = 8

pub const FILTER_NEAREST: u32 = 0
pub const FILTER_LINEAR: u32 = 1

pub const ADDRESS_CLAMP: u32 = 0
pub const ADDRESS_REPEAT: u32 = 1
pub const ADDRESS_MIRROR: u32 = 2
pub const ADDRESS_BORDER: u32 = 3

// The color a sampler reads outside the texture with ADDRESS_BORDER.
pub const BORDER_TRANSPARENT_BLACK: u32 = 0
pub const BORDER_OPAQUE_BLACK: u32 = 1
pub const BORDER_OPAQUE_WHITE: u32 = 2

pub const LOAD_CLEAR: u32 = 0
pub const LOAD_KEEP: u32 = 1

// Binding slots per pipeline, numbered from 0.
pub const MAX_SLOTS: u32 = 16
pub const MAX_VERTEX_BUFFERS: u32 = 8
pub const MAX_VERTEX_ATTRIBUTES: u32 = 16
// Color attachments of a render pass at most; limits().max_color_attachments
// says how many the device takes (at least 4).
pub const MAX_COLOR_ATTACHMENTS: u32 = 8
// Buffer offsets bound to a slot are multiples of this.
pub const BINDING_ALIGNMENT: u64 = 256

// Which backend Device.open tries.
pub enum Preference {
    // The operating system's own API (Metal on macOS), then Vulkan, then
    // OpenGL.
    Auto,
    Vulkan,
    Metal,
    OpenGl
}

pub struct Options {
    pub backend: Preference
    // Turn on the API's validation where it exists: the Khronos validation
    // layer for Vulkan when installed, a debug context for OpenGL.
    pub debug: bool

    pub fn default() -> Options {
        return Options { backend: Preference.Auto, debug: false }
    }
    pub fn with_backend(backend: Preference) -> Options {
        return Options { backend: backend, debug: false }
    }
}

enum Raw {
    Vulkan(vulkan_hal.Device),
    Native(native_hal.Device),
    OpenGl(opengl_hal.Device)
}

// Marks an object that an open encoder may use.
const PENDING: u64 = 0xffffffffffffffff

// An object dropped while the GPU may still use it, destroyed once
// submission `wait` has finished (PENDING: once the encoders recording now
// have been submitted).
struct Grave {
    object: u32
    handle: hal.Handle
    wait: u64
}

// Every encoder, upload encoders included, gets the next serial number.
// Slot `serial % SERIALS` remembers what became of the last SERIALS of
// them: still RECORDING, abandoned (0) or the number of their submission.
const SERIALS: usize = 64
const RECORDING: u64 = 0xffffffffffffffff
// What outcome() says about a serial too old to remember.
const FORGOTTEN: u64 = 0xfffffffffffffffe
// What needed_by() says about a buffer the upload encoder writes.
const UPLOADING: u64 = 0xffffffffffffffff

// Which submissions may still use the device's objects.
struct Life {
    open_encoders: u32
    submitted: u64
    graves: Growing<Grave>
    serial: u64
    serials: [64]u64
    outcomes: [64]u64
    // A cleared hazard table, kept for the next encoder.
    spare: Hazards

    fn new(tracks: bool) -> Life {
        return Life { open_encoders: 0, submitted: 0, graves: Growing.new(), serial: 0, serials: [0u64; 64], outcomes: [0u64; 64], spare: Hazards.new(tracks) }
    }
}

// The staging ring starts at RING_START bytes and doubles up to RING_MAX
// when it runs out of room while the GPU still reads it; writes of more
// than a quarter of RING_MAX get a staging buffer of their own.
const RING_START: u64 = 4 * 1024 * 1024
const RING_MAX: u64 = 64 * 1024 * 1024
// Ring offsets keep every texel size's alignment.
const RING_ALIGNMENT: u64 = 16

// A submitted upload: once submission `index` has finished, the ring is
// free up to position `end`.
struct Mark {
    index: u64
    end: u64
}

// Staged transfers: the upload encoder, the ring it copies from, and the
// buffer reads come back through.
struct Uploads {
    // The upload encoder is recording; it counts as an open encoder.
    open: bool
    encoder: hal.Handle
    serial: u64
    hazards: Hazards
    ring: hal.Handle
    ring_size: u64
    ring_address: usize
    // Positions in the ring count bytes ever allocated: `head` is the next
    // one, everything from `tail` on may still be read by the GPU.
    head: u64
    tail: u64
    // Submitted uploads, oldest first.
    marks: Growing<Mark>
    readback: hal.Handle
    readback_size: u64
    readback_address: usize

    fn new(tracks: bool) -> Uploads {
        return Uploads { open: false, encoder: hal.Handle.null(), serial: 0, hazards: Hazards.new(tracks), ring: hal.Handle.null(), ring_size: 0, ring_address: 0, head: 0, tail: 0, marks: Growing.new(), readback: hal.Handle.null(), readback_size: 0, readback_address: 0 }
    }
}

// Where a staged write's bytes go: `address` maps `offset` of `buffer`.
struct Staging {
    buffer: hal.Handle
    offset: u64
    address: usize
    // A buffer of its own, retired once the upload has run.
    dedicated: bool
}

// A GPU and the queue its work runs on.
pub struct Device {
    raw: Raw
    limits: hal.Limits
    name: [256]u8
    name_length: usize
    life: hal.Mutable<Life>
    uploads: hal.Mutable<Uploads>
    // Whether std/gpu stages transfers itself (not on OpenGL), and tracks
    // hazards and lifetimes itself (not on Metal, which does both).
    staged: bool
    tracks: bool

    // Open a device. With Preference.Auto, tries the operating system's
    // own API, then Vulkan, then OpenGL. Fails with NoBackend when no
    // backend could be used and Unsupported when the requested one lacks
    // what std/gpu needs, such as Vulkan before 1.2 or OpenGL before 4.5.
    pub fn open(options: Options) -> Device!Error {
        debug := options.debug
        match &options.backend {
            Preference.Vulkan => {
                return Device.from_raw(Raw.Vulkan(vulkan_hal.Device.open(debug)?))
            }
            Preference.Metal => {
                return Device.from_raw(Raw.Native(native_hal.Device.open(debug)?))
            }
            Preference.OpenGl => {
                return Device.from_raw(Raw.OpenGl(opengl_hal.Device.open(debug)?))
            }
            Preference.Auto => {}
        }
        // Keep the most telling failure: an error other than a missing
        // backend explains more.
        failure := Error.NoBackend
        match native_hal.Device.open(debug) {
            ok(device) => {
                return Device.from_raw(Raw.Native(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match vulkan_hal.Device.open(debug) {
            ok(device) => {
                return Device.from_raw(Raw.Vulkan(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match opengl_hal.Device.open(debug) {
            ok(device) => {
                return Device.from_raw(Raw.OpenGl(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        return err(failure)
    }

    // Open a device that can present to a window, for a Surface. OpenGL
    // devices draw with the window's own context, so only this window can
    // have a Surface on them; Vulkan prefers a GPU that can present to it.
    // Fails like open().
    pub fn open_for_window(native: &handle.NativeHandle, options: Options) -> Device!Error {
        debug := options.debug
        match &options.backend {
            Preference.Vulkan => {
                return Device.from_raw(Raw.Vulkan(vulkan_hal.Device.open_for_window(native, debug)?))
            }
            Preference.Metal => {
                return Device.from_raw(Raw.Native(native_hal.Device.open_for_window(native, debug)?))
            }
            Preference.OpenGl => {
                return Device.from_raw(Raw.OpenGl(opengl_hal.Device.open_for_window(native, debug)?))
            }
            Preference.Auto => {}
        }
        failure := Error.NoBackend
        match native_hal.Device.open_for_window(native, debug) {
            ok(device) => {
                return Device.from_raw(Raw.Native(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match vulkan_hal.Device.open_for_window(native, debug) {
            ok(device) => {
                return Device.from_raw(Raw.Vulkan(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        match opengl_hal.Device.open_for_window(native, debug) {
            ok(device) => {
                return Device.from_raw(Raw.OpenGl(device))
            }
            err(error) => {
                failure = worse(failure, error)
            }
        }
        return err(failure)
    }

    fn from_raw(raw: Raw) -> Device!Error {
        device := Device {
            raw: raw,
            limits: hal.Limits { max_texture_size: 0, max_buffer_size: 0, max_uniform_binding_size: 0, max_storage_binding_size: 0, max_workgroups: 0, max_workgroup_size_x: 0, max_workgroup_size_y: 0, max_workgroup_size_z: 0, max_workgroup_invocations: 0, max_color_attachments: 0 },
            name: [0u8; 256],
            name_length: 0,
            life: hal.Mutable.new(Life.new(false)),
            uploads: hal.Mutable.new(Uploads.new(false)),
            staged: false,
            tracks: false
        }
        device.staged = device.backend().staged()
        device.tracks = !device.backend().tracks_resources()
        device.life = hal.Mutable.new(Life.new(device.tracks))
        device.uploads = hal.Mutable.new(Uploads.new(device.tracks))
        device.limits = device.backend().limits()
        name := [0u8; 256]
        length := device.backend().name(&mut name)
        // Names are shown as ASCII.
        for i in 0usize..length {
            if !ascii.is_ascii(name[i]) {
                name[i] = b'?'
            }
        }
        device.name = name
        device.name_length = length
        return ok(device)
    }

    // The API this device uses.
    pub fn api(&self) -> Api {
        return self.backend().api()
    }

    // The GPU's name as the driver reports it, such as "Apple M2" or
    // "llvmpipe (LLVM 19.1.7, 256 bits)".
    pub fn name(&self) -> &str from(self) {
        unsafe {
            return mem.str_from_utf8(&self.name[..self.name_length])
        }
    }

    pub fn limits(&self) -> Limits {
        return self.limits.copy()
    }

    // A buffer of `size` bytes, initially zero, usable in the ways `usage`
    // combines (BUFFER_*). Fails with InvalidInput for a zero size, one
    // above limits().max_buffer_size or an empty or unknown usage.
    pub fn create_buffer(&self, size: u64, usage: u32) -> Buffer!Error from(self) {
        if size == 0 || size > self.limits.max_buffer_size || usage == 0 || (usage & ~hal.BUFFER_USAGES) != 0 {
            return err(Error.InvalidInput)
        }
        // Whole words, so that shaders reading u32s stay in bounds.
        rounded := (size + 3) & ~3u64
        handle := self.backend().create_buffer(rounded, usage)?
        buffer := Buffer { device: self, handle: handle, size: size, usage: usage, uses: hal.Mutable.new(BufferUse.new()) }
        // Mapped buffers start out zero; the others are cleared on the GPU
        // before anything else uses them. A failure drops the buffer.
        if self.staged && self.backend().mapped(&buffer.handle) == 0 {
            encoder := self.upload_encoder()?
            self.use_uploaded(&mut encoder, buffer.handle.a, hal.USE_COPY_DST)
            self.backend().clear_buffer(&mut encoder, &buffer.handle, 0, rounded)
            self.upload_done(&encoder)
            self.note_use(&buffer, self.uploads.read().serial)
        }
        return ok(buffer)
    }

    // A buffer holding a copy of `data`, which must not be empty. The
    // usage needs no BUFFER_COPY_DST for this first write.
    pub fn create_buffer_with_data(&self, data: &[u8], usage: u32) -> Buffer!Error from(self) {
        buffer := self.create_buffer(data.len as u64, usage)?
        if !self.staged {
            self.backend().write_buffer(&buffer.handle, 0, data)?
            return ok(buffer)
        }
        // Nothing uses a new buffer yet: write a mapped one directly.
        address := self.backend().mapped(&buffer.handle)
        if address != 0 {
            unsafe {
                ptr.copy_nonoverlapping(ptr.as_ptr(data), address as *mut u8, data.len)
            }
            return ok(buffer)
        }
        self.stage_buffer_write(&buffer, 0, data)?
        return ok(buffer)
    }

    // Copy `data` into `buffer` at `offset`. The write happens after every
    // submission made before it and before every later one, as if it were
    // a command of its own. Needs BUFFER_COPY_DST; fails with InvalidInput
    // when the range does not fit.
    pub fn write_buffer(&self, buffer: &Buffer, offset: u64, data: &[u8]) -> void!Error {
        self.check_owner(buffer.device)
        if (buffer.usage & hal.BUFFER_COPY_DST) == 0 || !fits(offset, data.len as u64, buffer.size) {
            return err(Error.InvalidInput)
        }
        if data.len == 0 {
            return ok()
        }
        if !self.staged {
            return self.backend().write_buffer(&buffer.handle, offset, data)
        }
        address := self.backend().mapped(&buffer.handle)
        if address != 0 {
            // No submitted work uses the buffer any more, and no earlier
            // write waits in the upload encoder: write it directly. So
            // must a write copies cannot make, as they move whole words on
            // some GPUs, once the GPU is done with the buffer.
            idle := self.buffer_idle(buffer)
            if !idle && ((offset | data.len as u64) & 3) != 0 {
                self.settle(buffer)?
                idle = true
            }
            if idle {
                unsafe {
                    ptr.copy_nonoverlapping(ptr.as_ptr(data), (address + offset as usize) as *mut u8, data.len)
                }
                return ok()
            }
        }
        return self.stage_buffer_write(buffer, offset, data)
    }

    // Copy bytes of `buffer` from `offset` into `out`, after waiting for
    // every submission made so far that uses it. Needs BUFFER_COPY_SRC;
    // fails with InvalidInput when the range does not fit.
    pub fn read_buffer(&self, buffer: &Buffer, offset: u64, out: &mut[u8]) -> void!Error {
        self.check_owner(buffer.device)
        if (buffer.usage & hal.BUFFER_COPY_SRC) == 0 || !fits(offset, out.len as u64, buffer.size) {
            return err(Error.InvalidInput)
        }
        if out.len == 0 {
            return ok()
        }
        if !self.staged {
            return self.backend().read_buffer(&buffer.handle, offset, out)
        }
        address := self.backend().mapped(&buffer.handle)
        if address != 0 {
            self.settle(buffer)?
            self.backend().invalidate(&buffer.handle, offset, out.len as u64)
            unsafe {
                ptr.copy_nonoverlapping((address + offset as usize) as *const u8, ptr.as_mut_ptr(out), out.len)
            }
            return ok()
        }
        // Copy the words holding the range into the readback buffer.
        start := offset & ~3u64
        end := (offset + out.len as u64 + 3) & ~3u64
        readback := self.readback(end - start)?
        encoder := self.backend().begin_encoder()?
        self.backend().copy_buffer(&mut encoder, &buffer.handle, start, &readback, 0, end - start)
        self.run_readback(&mut encoder, &readback, end - start)?
        self.collect()
        unsafe {
            source := self.uploads.read().readback_address + (offset - start) as usize
            ptr.copy_nonoverlapping(source as *const u8, ptr.as_mut_ptr(out), out.len)
        }
        return ok()
    }

    // Start copying `size` bytes of `buffer` from `offset` back to the CPU
    // without waiting for the GPU: collect them with Readback.read() once
    // ready() says so (or earlier, which waits). The copy is ordered like
    // a submission made now. Needs BUFFER_COPY_SRC; fails with
    // InvalidInput when the range does not fit or is empty.
    pub fn start_read_buffer(&self, buffer: &Buffer, offset: u64, size: u64) -> Readback!Error from(self) {
        self.check_owner(buffer.device)
        if (buffer.usage & hal.BUFFER_COPY_SRC) == 0 || size == 0 || !fits(offset, size, buffer.size) {
            return err(Error.InvalidInput)
        }
        start := offset & ~3u64
        end := (offset + size + 3) & ~3u64
        readback := self.start_readback(end - start, offset - start, size)?
        if !self.staged {
            out := readback.host_bytes()
            self.backend().read_buffer(&buffer.handle, offset, out)?
            return ok(readback)
        }
        encoder := self.encoder()?
        self.note_use(buffer, encoder.serial)
        copy_hazards(self, &mut encoder.hazards, &mut encoder.handle, buffer.handle.a, readback.buffer.a)
        self.backend().copy_buffer(&mut encoder.handle, &buffer.handle, start, &readback.buffer, 0, end - start)
        readback.index = encoder.submit_numbered()?
        return ok(readback)
    }

    // A two-dimensional texture. Fails with InvalidInput for a zero size,
    // one above limits().max_texture_size, an unknown format, a usage the
    // format does not allow, or a bad mip level or sample count: depth
    // formats can only be rendered to, sampled and copied from;
    // TEXTURE_STORAGE needs one of the formats every backend can store to
    // (rgba8unorm, rgba16float, r32float, rg32float, rgba32float, r32uint,
    // r32sint, rgba32uint); mip_levels runs from 1 to mip_level_count();
    // and a multisampled texture (samples MULTISAMPLE_COUNT rather than 1)
    // has one level, a format other than an integer one, and usage
    // TEXTURE_RENDER alone. Fails with Unsupported when the GPU lacks the
    // combination.
    pub fn create_texture(&self, descriptor: TextureDescriptor) -> Texture!Error from(self) {
        width := descriptor.width
        height := descriptor.height
        format := descriptor.format
        usage := descriptor.usage
        if width == 0 || height == 0 || width > self.limits.max_texture_size || height > self.limits.max_texture_size {
            return err(Error.InvalidInput)
        }
        if format == hal.FORMAT_NONE || format >= hal.FORMAT_COUNT || usage == 0 || (usage & ~hal.TEXTURE_USAGES) != 0 {
            return err(Error.InvalidInput)
        }
        if hal.is_depth(format) && (usage & (hal.TEXTURE_COPY_DST | hal.TEXTURE_STORAGE)) != 0 {
            return err(Error.InvalidInput)
        }
        if (usage & hal.TEXTURE_STORAGE) != 0 && !hal.is_storage(format) {
            return err(Error.InvalidInput)
        }
        if descriptor.mip_levels == 0 || descriptor.mip_levels > hal.mip_level_count(width, height) {
            return err(Error.InvalidInput)
        }
        if descriptor.samples != 1 && (descriptor.samples != hal.MULTISAMPLE_COUNT || descriptor.mip_levels != 1 || usage != hal.TEXTURE_RENDER || hal.is_integer(format)) {
            return err(Error.InvalidInput)
        }
        handle := self.backend().create_texture(&descriptor)?
        texture := Texture { device: self, handle: handle, descriptor: descriptor, external: false }
        // A failure drops the texture.
        if self.staged {
            encoder := self.upload_encoder()?
            self.use_uploaded(&mut encoder, texture.handle.a ^ TEXTURE_KEY, hal.USE_COPY_DST)
            self.backend().initialize_texture(&mut encoder, &texture.handle, &texture.descriptor)
            self.upload_done(&encoder)
        }
        return ok(texture)
    }

    // Copy texels from `data` into `region` of `texture`, rows
    // `bytes_per_row` apart, top row first. Ordered like write_buffer.
    // Needs TEXTURE_COPY_DST; fails with InvalidInput when the region is
    // outside the texture, a row is shorter than the region or not a
    // multiple of the texel size, or `data` is too short.
    pub fn write_texture(&self, texture: &Texture, region: Region, data: &[u8], bytes_per_row: u32) -> void!Error {
        self.check_owner(texture.device)
        if (texture.descriptor.usage & hal.TEXTURE_COPY_DST) == 0 || hal.is_depth(texture.descriptor.format) || !texture_copy_fits(&texture.descriptor, &region, data.len as u64, 0, bytes_per_row) {
            return err(Error.InvalidInput)
        }
        if region.width == 0 || region.height == 0 {
            return ok()
        }
        if !self.staged {
            return self.backend().write_texture(&texture.handle, &texture.descriptor, &region, data, bytes_per_row)
        }
        size := copy_size(&texture.descriptor, &region, bytes_per_row)
        staging := self.stage(&data[..size as usize])?
        encoder := self.upload_encoder()?
        self.use_uploaded(&mut encoder, staging.buffer.a, hal.USE_COPY_SRC)
        self.use_uploaded(&mut encoder, texture.handle.a ^ TEXTURE_KEY, hal.USE_COPY_DST)
        self.backend().copy_buffer_to_texture(&mut encoder, &staging.buffer, staging.offset, bytes_per_row, &texture.handle, &texture.descriptor, &region)
        self.upload_done(&encoder)
        self.unstage(&staging)
        return ok()
    }

    // Copy texels of `region` into `out`, rows `bytes_per_row` apart, top
    // row first, after waiting for every submission made so far. Needs
    // TEXTURE_COPY_SRC; fails like write_texture.
    pub fn read_texture(&self, texture: &Texture, region: Region, out: &mut[u8], bytes_per_row: u32) -> void!Error {
        self.check_owner(texture.device)
        if (texture.descriptor.usage & hal.TEXTURE_COPY_SRC) == 0 || !texture_copy_fits(&texture.descriptor, &region, out.len as u64, 0, bytes_per_row) {
            return err(Error.InvalidInput)
        }
        if region.width == 0 || region.height == 0 {
            return ok()
        }
        if !self.staged {
            return self.backend().read_texture(&texture.handle, &texture.descriptor, &region, out, bytes_per_row)
        }
        size := copy_size(&texture.descriptor, &region, bytes_per_row)
        readback := self.readback(size)?
        encoder := self.backend().begin_encoder()?
        self.backend().copy_texture_to_buffer(&mut encoder, &texture.handle, &texture.descriptor, &region, &readback, 0, bytes_per_row)
        self.run_readback(&mut encoder, &readback, size)?
        unsafe {
            ptr.copy_nonoverlapping(self.uploads.read().readback_address as *const u8, ptr.as_mut_ptr(out), size as usize)
        }
        return ok()
    }

    // Start copying texels of `region` back to the CPU, rows
    // `bytes_per_row` apart, without waiting for the GPU, as
    // start_read_buffer does. Needs TEXTURE_COPY_SRC; fails with
    // InvalidInput like read_texture, and for an empty region.
    pub fn start_read_texture(&self, texture: &Texture, region: Region, bytes_per_row: u32) -> Readback!Error from(self) {
        self.check_owner(texture.device)
        if (texture.descriptor.usage & hal.TEXTURE_COPY_SRC) == 0 || region.width == 0 || region.height == 0 || !texture_copy_fits(&texture.descriptor, &region, 0xffffffffffffffff, 0, bytes_per_row) {
            return err(Error.InvalidInput)
        }
        size := copy_size(&texture.descriptor, &region, bytes_per_row)
        readback := self.start_readback(size, 0, size)?
        if !self.staged {
            out := readback.host_bytes()
            self.backend().read_texture(&texture.handle, &texture.descriptor, &region, out, bytes_per_row)?
            return ok(readback)
        }
        encoder := self.encoder()?
        copy_hazards(self, &mut encoder.hazards, &mut encoder.handle, texture.handle.a ^ TEXTURE_KEY, readback.buffer.a)
        self.backend().copy_texture_to_buffer(&mut encoder.handle, &texture.handle, &texture.descriptor, &region, &readback.buffer, 0, bytes_per_row)
        readback.index = encoder.submit_numbered()?
        return ok(readback)
    }

    // A sampler. Fails with InvalidInput for an unknown filter, address
    // mode, border color or comparison, a level range that is negative or
    // runs backwards, or max_anisotropy outside 1 to 16 or above 1 with a
    // nearest filter. A sampler with a comparison only reads depth textures
    // in BindingLayout.comparison_texture slots, and only those.
    pub fn create_sampler(&self, descriptor: SamplerDescriptor) -> Sampler!Error from(self) {
        if descriptor.mag_filter > hal.FILTER_LINEAR || descriptor.min_filter > hal.FILTER_LINEAR || descriptor.mipmap_filter > hal.FILTER_LINEAR || descriptor.address_u > hal.ADDRESS_BORDER || descriptor.address_v > hal.ADDRESS_BORDER {
            return err(Error.InvalidInput)
        }
        if descriptor.border > hal.BORDER_OPAQUE_WHITE || descriptor.compare > hal.COMPARE_ALWAYS {
            return err(Error.InvalidInput)
        }
        // Written so that NaN fails too.
        if !(descriptor.lod_min >= 0.0) || !(descriptor.lod_max >= descriptor.lod_min) {
            return err(Error.InvalidInput)
        }
        anisotropy := descriptor.max_anisotropy
        if anisotropy == 0 || anisotropy > 16 {
            return err(Error.InvalidInput)
        }
        if anisotropy > 1 && (descriptor.mag_filter != hal.FILTER_LINEAR || descriptor.min_filter != hal.FILTER_LINEAR || descriptor.mipmap_filter != hal.FILTER_LINEAR) {
            return err(Error.InvalidInput)
        }
        handle := self.backend().create_sampler(&descriptor)?
        return ok(Sampler { device: self, handle: handle, compare: descriptor.compare != hal.COMPARE_NONE })
    }

    // A compute pipeline. Fails with MissingShader when the source has no
    // code for this device's API, InvalidShader when it does not compile
    // or lacks the entry point, and InvalidInput for a bad binding layout
    // or a workgroup size outside the limits.
    pub fn create_compute_pipeline(&self, descriptor: ComputePipelineDescriptor) -> ComputePipeline!Error from(self) {
        pipeline := hal.Pipeline.empty()
        check_bindings(descriptor.bindings, hal.STAGE_COMPUTE, &mut pipeline)?
        x := descriptor.workgroup_size_x
        y := descriptor.workgroup_size_y
        z := descriptor.workgroup_size_z
        limits := &self.limits
        if x == 0 || y == 0 || z == 0 || x > limits.max_workgroup_size_x || y > limits.max_workgroup_size_y || z > limits.max_workgroup_size_z {
            return err(Error.InvalidInput)
        }
        if x as u64 * y as u64 * z as u64 > limits.max_workgroup_invocations as u64 {
            return err(Error.InvalidInput)
        }
        if mem.str_bytes(descriptor.entry).len == 0 {
            return err(Error.InvalidInput)
        }
        self.check_source(descriptor.source)?
        pipeline.workgroup_size_x = x
        pipeline.workgroup_size_y = y
        pipeline.workgroup_size_z = z
        pipeline.handle = self.backend().create_compute_pipeline(&descriptor)?
        return ok(ComputePipeline { device: self, pipeline: pipeline })
    }

    // A render pipeline. Fails like create_compute_pipeline, and with
    // InvalidInput for vertex layouts beyond MAX_VERTEX_BUFFERS or
    // MAX_VERTEX_ATTRIBUTES, a repeated location, an attribute outside its
    // stride; color targets given both ways, more than
    // limits().max_color_attachments of them, with a format that cannot be
    // rendered to (or blended, with blending on) or an unknown blend factor,
    // operation or write mask; color targets without a fragment stage, or
    // neither color targets nor depth; a depth format that is not one;
    // samples other than 1 and MULTISAMPLE_COUNT, multisampled integer
    // targets or alpha_to_coverage without multisampling; or a depth bias
    // that is not finite or is set for lines or points. Fails with
    // Unsupported when the GPU cannot blend targets differently, or clamp
    // depth bias, and the pipeline asks for it.
    pub fn create_render_pipeline(&self, descriptor: RenderPipelineDescriptor) -> RenderPipeline!Error from(self) {
        pipeline := hal.Pipeline.empty()
        check_bindings(descriptor.bindings, hal.STAGE_VERTEX | hal.STAGE_FRAGMENT, &mut pipeline)?
        layouts := descriptor.vertex_buffers
        if layouts.len > hal.MAX_VERTEX_BUFFERS as usize {
            return err(Error.InvalidInput)
        }
        locations := 0u32
        attribute_count := 0usize
        for i in 0usize..layouts.len {
            layout := &layouts[i]
            if layout.step > hal.STEP_INSTANCE || layout.stride > 2048 || (layout.stride & 3) != 0 {
                return err(Error.InvalidInput)
            }
            extent := 0u32
            for j in 0usize..layout.attributes.len {
                attribute := &layout.attributes[j]
                size := hal.vertex_size(attribute.format)
                if size == 0 || attribute.location >= hal.MAX_VERTEX_ATTRIBUTES || (locations >> attribute.location & 1) != 0 || (attribute.offset & 3) != 0 {
                    return err(Error.InvalidInput)
                }
                end := attribute.offset as u64 + size as u64
                if end > 2048 || (layout.stride != 0 && end > layout.stride as u64) {
                    return err(Error.InvalidInput)
                }
                if end as u32 > extent {
                    extent = end as u32
                }
                locations = locations | (1u32 << attribute.location)
                attribute_count += 1
            }
            // A zero stride repeats one vertex; it still needs its bytes.
            pipeline.strides[i] = layout.stride
            pipeline.steps[i] = layout.step
            pipeline.extents[i] = extent
        }
        if attribute_count > hal.MAX_VERTEX_ATTRIBUTES as usize {
            return err(Error.InvalidInput)
        }
        pipeline.vertex_buffer_count = layouts.len as u32
        // The color targets: the one of `color_format`, or `targets`.
        single := [hal.ColorTarget { format: descriptor.color_format, blend: hal.Blend.preset(descriptor.blend), write_mask: hal.COLOR_WRITE_ALL }]
        if descriptor.color_format != hal.FORMAT_NONE && (descriptor.targets.len != 0 || descriptor.blend > hal.BLEND_ADDITIVE) {
            return err(Error.InvalidInput)
        }
        if descriptor.color_format == hal.FORMAT_NONE && descriptor.blend != hal.BLEND_REPLACE {
            return err(Error.InvalidInput)
        }
        targets := if descriptor.color_format != hal.FORMAT_NONE {
            &single[0..1]
        } else {
            descriptor.targets
        }
        fragment := descriptor.has_fragment()
        if targets.len > self.limits.max_color_attachments as usize || (!fragment && targets.len != 0) {
            return err(Error.InvalidInput)
        }
        if targets.len == 0 && descriptor.depth_format == hal.FORMAT_NONE {
            return err(Error.InvalidInput)
        }
        samples := descriptor.samples
        if samples != 1 && samples != hal.MULTISAMPLE_COUNT {
            return err(Error.InvalidInput)
        }
        if descriptor.alpha_to_coverage && (samples == 1 || targets.len == 0) {
            return err(Error.InvalidInput)
        }
        for i in 0usize..targets.len {
            target := &targets[i]
            format := target.format
            if format == hal.FORMAT_NONE || format >= hal.FORMAT_COUNT || hal.is_depth(format) || target.write_mask > hal.COLOR_WRITE_ALL {
                return err(Error.InvalidInput)
            }
            if !valid_blend(&target.blend) || (target.blend.enabled() && !hal.is_blendable(format)) {
                return err(Error.InvalidInput)
            }
            if samples != 1 && hal.is_integer(format) {
                return err(Error.InvalidInput)
            }
            pipeline.color_formats[i] = format
        }
        pipeline.color_count = targets.len as u32
        if descriptor.depth_format != hal.FORMAT_NONE && !hal.is_depth(descriptor.depth_format) {
            return err(Error.InvalidInput)
        }
        if descriptor.topology > hal.TOPOLOGY_POINT_LIST || descriptor.cull_mode > hal.CULL_BACK || descriptor.front_face > hal.FRONT_CW {
            return err(Error.InvalidInput)
        }
        if descriptor.depth_compare < hal.COMPARE_NEVER || descriptor.depth_compare > hal.COMPARE_ALWAYS {
            return err(Error.InvalidInput)
        }
        biased := descriptor.depth_bias != 0 || descriptor.depth_bias_slope_scale != 0.0 || descriptor.depth_bias_clamp != 0.0
        if !finite(descriptor.depth_bias_slope_scale) || !finite(descriptor.depth_bias_clamp) {
            return err(Error.InvalidInput)
        }
        if biased && descriptor.topology >= hal.TOPOLOGY_LINE_LIST {
            return err(Error.InvalidInput)
        }
        if mem.str_bytes(descriptor.vertex_entry).len == 0 {
            return err(Error.InvalidInput)
        }
        self.check_source(descriptor.vertex)?
        if fragment {
            self.check_source(descriptor.fragment)?
        }
        // Backends see every color target in `targets`.
        normalized := hal.RenderPipelineDescriptor {
            vertex: descriptor.vertex,
            vertex_entry: descriptor.vertex_entry,
            fragment: descriptor.fragment,
            fragment_entry: descriptor.fragment_entry,
            bindings: descriptor.bindings,
            vertex_buffers: descriptor.vertex_buffers,
            topology: descriptor.topology,
            cull_mode: descriptor.cull_mode,
            front_face: descriptor.front_face,
            color_format: hal.FORMAT_NONE,
            blend: hal.BLEND_REPLACE,
            targets: targets,
            depth_format: descriptor.depth_format,
            depth_compare: descriptor.depth_compare,
            depth_write: descriptor.depth_write,
            depth_bias: descriptor.depth_bias,
            depth_bias_slope_scale: descriptor.depth_bias_slope_scale,
            depth_bias_clamp: descriptor.depth_bias_clamp,
            samples: samples,
            alpha_to_coverage: descriptor.alpha_to_coverage
        }
        pipeline.topology = descriptor.topology
        pipeline.depth_format = descriptor.depth_format
        pipeline.samples = samples
        pipeline.handle = self.backend().create_render_pipeline(&normalized)?
        return ok(RenderPipeline { device: self, pipeline: pipeline })
    }


    // Start recording commands.
    pub fn encoder(&self) -> CommandEncoder!Error from(self) {
        self.collect()
        handle := self.backend().begin_encoder()?
        serial := self.begin_serial()
        tracks := self.tracks
        hazards := self.life.update(fn(life) {
            life.open_encoders += 1
            mem.replace(&mut life.spare, Hazards.new(tracks))
        })
        return ok(CommandEncoder { device: self, handle: handle, open: true, hazards: hazards, serial: serial })
    }

    // Wait until the GPU has finished everything submitted so far,
    // including writes not yet followed by a submission.
    pub fn wait(&self) -> void!Error {
        self.finish()?
        self.collect()
        return ok()
    }

    // Destroy dropped objects the GPU has finished with, and start staged
    // writes not yet followed by a submission. submit() and wait() do this
    // too; call it in programs that drop objects and then submit nothing
    // for a while.
    pub fn poll(&self) {
        hal.ignore(self.flush())
        self.collect()
    }

    fn backend(&self) -> &dyn hal.Backend from(self) {
        match &self.raw {
            Raw.Vulkan(raw) => {
                return raw
            }
            Raw.Native(raw) => {
                return raw
            }
            Raw.OpenGl(raw) => {
                return raw
            }
        }
    }

    // Submit staged writes, then wait for every submission.
    fn finish(&self) -> void!Error {
        self.flush()?
        submitted := self.life.read().submitted
        if submitted != 0 {
            self.backend().wait(submitted)?
        }
        return ok()
    }

    // The upload encoder, begun if it is not recording. Record into the
    // copy, then store it back with upload_done.
    fn upload_encoder(&self) -> hal.Handle!Error {
        if self.uploads.read().open {
            return ok(self.uploads.read().encoder.copy())
        }
        encoder := self.backend().begin_encoder()?
        serial := self.begin_serial()
        self.uploads.update(fn(uploads) {
            uploads.encoder = encoder.copy()
            uploads.serial = serial
            uploads.open = true
        })
        self.life.update(fn(life) {
            life.open_encoders += 1
        })
        return ok(encoder)
    }

    fn upload_done(&self, encoder: &hal.Handle) {
        self.uploads.update(fn(uploads) {
            uploads.encoder = encoder.copy()
        })
    }

    // Record a use by the upload encoder, with the barrier it needs.
    fn use_uploaded(&self, encoder: &mut hal.Handle, key: u64, usage: u32) {
        before := 0u32
        after := 0u32
        self.uploads.update(fn(uploads) {
            uploads.hazards.use_resource(key, usage, (usage & hal.USE_WRITES) != 0, &mut before, &mut after)
        })
        if before != 0 {
            self.backend().barrier(encoder, before, after)
        }
    }

    // Submit the upload encoder, if it recorded anything.
    fn flush(&self) -> void!Error {
        if !self.uploads.read().open {
            return ok()
        }
        uploads := self.take_uploads()
        nothing := hal.Handle.null()
        match self.backend().submit(&mut nothing, &mut uploads) {
            ok(index) => {
                self.uploads_submitted(&uploads, index)
                // Programs that only write and read reclaim objects here.
                self.collect()
                return ok()
            }
            err(error) => {
                self.uploads_failed(&uploads)
                return err(error)
            }
        }
    }

    // Submit `encoder` with the upload encoder's commands, if it recorded
    // any, running first in the same submission.
    fn submit_encoder(&self, encoder: &mut hal.Handle) -> u64!Error {
        if !self.uploads.read().open {
            nothing := hal.Handle.null()
            return self.backend().submit(&mut nothing, encoder)
        }
        uploads := self.take_uploads()
        match self.backend().submit(&mut uploads, encoder) {
            ok(index) => {
                self.uploads_submitted(&uploads, index)
                return ok(index)
            }
            err(error) => {
                self.uploads_failed(&uploads)
                return err(error)
            }
        }
    }

    // Stop recording uploads, for submitting what was recorded.
    fn take_uploads(&self) -> hal.Handle {
        return self.uploads.update(fn(uploads) {
            uploads.open = false
            uploads.hazards.clear()
            uploads.encoder.copy()
        })
    }

    fn uploads_submitted(&self, encoder: &hal.Handle, index: u64) {
        serial := self.uploads.read().serial
        self.uploads.update(fn(uploads) {
            mark := Mark { index: index, end: uploads.head }
            uploads.marks.push(mark)
        })
        self.end_serial(serial, index)
        self.close_encoder(index)
        self.dispose_encoder(encoder, index)
    }

    fn uploads_failed(&self, encoder: &hal.Handle) {
        self.end_serial(self.uploads.read().serial, 0)
        self.backend().destroy(hal.OBJECT_ENCODER, encoder)
        self.close_encoder(0)
    }

    // Free the ring space of finished uploads.
    fn reclaim(&self) {
        completed := self.backend().completed()
        self.uploads.update(fn(uploads) {
            kept := 0usize
            for i in 0usize..uploads.marks.len() {
                index := uploads.marks.get(i).index
                end := uploads.marks.get(i).end
                if index <= completed {
                    // Merged submissions can finish out of position order.
                    if end > uploads.tail {
                        uploads.tail = end
                    }
                } else {
                    uploads.marks.set(kept, Mark { index: index, end: end })
                    kept += 1
                }
            }
            uploads.marks.truncate(kept)
            // Nothing submitted or recording uses the ring.
            if kept == 0 && !uploads.open {
                uploads.tail = uploads.head
            }
        })
    }

    // Copy `data` into staging memory for the upload encoder.
    fn stage(&self, data: &[u8]) -> Staging!Error {
        size := data.len as u64
        staging := self.staging_space(size)?
        unsafe {
            ptr.copy_nonoverlapping(ptr.as_ptr(data), staging.address as *mut u8, data.len)
        }
        return ok(staging)
    }

    // A staged write is recorded: retire its own buffer once it has run.
    fn unstage(&self, staging: &Staging) {
        if staging.dedicated {
            self.retire(hal.OBJECT_BUFFER, &staging.buffer)
        }
    }

    // `size` bytes of staging memory: in the ring when it fits, otherwise
    // in a buffer of its own.
    fn staging_space(&self, size: u64) -> Staging!Error {
        if size > RING_MAX / 4 {
            buffer := self.backend().create_buffer((size + 3) & ~3u64, hal.BUFFER_UPLOAD)?
            address := self.backend().mapped(&buffer)
            return ok(Staging { buffer: buffer, offset: 0, address: address, dedicated: true })
        }
        for {
            self.reclaim()
            space := self.uploads.update(fn(uploads) {
                ring_size := uploads.ring_size
                if ring_size == 0 {
                    return none
                }
                start := (uploads.head + RING_ALIGNMENT - 1) & ~(RING_ALIGNMENT - 1)
                position := start % ring_size
                // Allocations never wrap around the end of the ring.
                if position + size > ring_size {
                    start += ring_size - position
                }
                if start + size - uploads.tail > ring_size {
                    return none
                }
                uploads.head = start + size
                offset := start % ring_size
                return some(Staging { buffer: uploads.ring.copy(), offset: offset, address: uploads.ring_address + offset as usize, dedicated: false })
            })
            match space {
                some(staging) => {
                    return ok(staging)
                }
                none => {}
            }
            if self.uploads.read().ring_size < RING_MAX {
                self.grow_ring(size)?
            } else {
                // The ring is as large as it gets: wait for the oldest
                // upload still using it.
                self.flush()?
                oldest := self.uploads.read().marks.get(0).index
                self.backend().wait(oldest)?
            }
        }
    }

    // Replace the ring with one at least twice as large and four times
    // `size`; the old one is retired once the GPU is done with it.
    fn grow_ring(&self, size: u64) -> void!Error {
        old_size := self.uploads.read().ring_size
        new_size := RING_START
        if old_size * 2 > new_size {
            new_size = old_size * 2
        }
        for new_size < size * 4 && new_size < RING_MAX {
            new_size = new_size * 2
        }
        if new_size > RING_MAX {
            new_size = RING_MAX
        }
        ring := self.backend().create_buffer(new_size, hal.BUFFER_UPLOAD)?
        address := self.backend().mapped(&ring)
        if old_size != 0 {
            old := self.uploads.read().ring.copy()
            self.retire(hal.OBJECT_BUFFER, &old)
        }
        self.uploads.update(fn(uploads) {
            uploads.ring = ring.copy()
            uploads.ring_size = new_size
            uploads.ring_address = address
            uploads.head = 0
            uploads.tail = 0
            uploads.marks.truncate(0)
        })
        return ok()
    }

    fn stage_buffer_write(&self, buffer: &Buffer, offset: u64, data: &[u8]) -> void!Error {
        staging := self.stage(data)?
        encoder := self.upload_encoder()?
        self.use_uploaded(&mut encoder, staging.buffer.a, hal.USE_COPY_SRC)
        self.use_uploaded(&mut encoder, buffer.handle.a, hal.USE_COPY_DST)
        self.backend().copy_buffer(&mut encoder, &staging.buffer, staging.offset, &buffer.handle, offset, data.len as u64)
        self.upload_done(&encoder)
        self.note_use(buffer, self.uploads.read().serial)
        self.unstage(&staging)
        return ok()
    }

    // The readback buffer, with room for `size` bytes. It is only used
    // while a read waits for it, so replacing it needs no care.
    fn readback(&self, size: u64) -> hal.Handle!Error {
        if self.uploads.read().readback_size >= size {
            return ok(self.uploads.read().readback.copy())
        }
        if self.uploads.read().readback_size != 0 {
            current := self.uploads.read().readback.copy()
            self.backend().destroy(hal.OBJECT_BUFFER, &current)
            self.uploads.update(fn(uploads) {
                uploads.readback_size = 0
            })
        }
        rounded := (size + 65535) & ~65535u64
        readback := self.backend().create_buffer(rounded, hal.BUFFER_READBACK)?
        address := self.backend().mapped(&readback)
        self.uploads.update(fn(uploads) {
            uploads.readback = readback.copy()
            uploads.readback_size = rounded
            uploads.readback_address = address
        })
        return ok(readback)
    }

    // Submit a readback encoder after the staged writes, wait for it and
    // make its writes visible.
    fn run_readback(&self, encoder: &mut hal.Handle, readback: &hal.Handle, size: u64) -> void!Error {
        index := match self.submit_encoder(encoder) {
            ok(index) => index,
            err(error) => {
                self.backend().destroy(hal.OBJECT_ENCODER, encoder)
                return err(error)
            }
        }
        self.note_submission(index)
        result := self.backend().wait(index)
        self.backend().destroy(hal.OBJECT_ENCODER, encoder)
        result?
        self.backend().invalidate(readback, 0, size)
        return ok()
    }

    // A Readback of `size` bytes, `skip` bytes into a copy of `copied`:
    // a readback buffer on staged backends, CPU memory on the others.
    fn start_readback(&self, copied: u64, skip: u64, size: u64) -> Readback!Error {
        if !self.staged {
            host := unsafe {
                malloc(size as usize) as usize
            }
            if host == 0 {
                return err(Error.OutOfMemory)
            }
            return ok(Readback { device: self, buffer: hal.Handle.null(), address: host, skip: 0, size: size, index: 0 })
        }
        buffer := self.backend().create_buffer(copied, hal.BUFFER_READBACK)?
        address := self.backend().mapped(&buffer)
        return ok(Readback { device: self, buffer: buffer, address: address, skip: skip, size: size, index: 0 })
    }

    // The backend made submission `index` outside any encoder.
    fn note_submission(&self, index: u64) {
        if index != 0 {
            self.life.update(fn(life) {
                life.submitted = index
            })
        }
    }

    fn check_owner(&self, owner: &Device) {
        assert(ptr.from_ref(owner) == ptr.from_ref(self), "the object belongs to another std/gpu device")
    }

    fn check_source(&self, source: &ShaderSource) -> void!Error {
        present := match self.api() {
            Api.Vulkan => source.spirv.len != 0,
            Api.Metal => mem.str_bytes(source.msl).len != 0,
            Api.OpenGl => mem.str_bytes(source.glsl).len != 0,
        }
        if !present {
            return err(Error.MissingShader)
        }
        return ok()
    }

    // Encoder serials.

    fn begin_serial(&self) -> u64 {
        return self.life.update(fn(life) {
            life.serial += 1
            slot := (life.serial % SERIALS as u64) as usize
            life.serials[slot] = life.serial
            life.outcomes[slot] = RECORDING
            life.serial
        })
    }

    // Encoder `serial` was submitted as submission `index`, or abandoned (0).
    fn end_serial(&self, serial: u64, index: u64) {
        self.life.update(fn(life) {
            slot := (serial % SERIALS as u64) as usize
            if life.serials[slot] == serial {
                life.outcomes[slot] = index
            }
        })
    }

    // What became of encoder `serial`: RECORDING, FORGOTTEN, abandoned (0)
    // or the number of its submission.
    fn outcome(&self, serial: u64) -> u64 {
        life := self.life.read()
        slot := (serial % SERIALS as u64) as usize
        if life.serials[slot] != serial {
            return FORGOTTEN
        }
        return life.outcomes[slot]
    }

    // Per-buffer use tracking: which submissions may still use a buffer,
    // so that mapped buffers can be written and read directly when no
    // submission uses them.

    // Encoder `serial` records a use of `buffer`. Runs at every binding,
    // so it touches the buffer's record directly.
    fn note_use(&self, buffer: &Buffer, serial: u64) {
        unsafe {
            uses := buffer.uses.get()
            if (*uses).serial == serial {
                return
            }
            if (*uses).older != 0 && self.fold((*uses).older, uses) {
                (*uses).older = 0
            }
            previous := (*uses).serial
            if previous != 0 && !self.fold(previous, uses) {
                // Still recording: keep it, or give up on knowing.
                if (*uses).older == 0 {
                    (*uses).older = previous
                } else {
                    (*uses).shared = true
                }
            }
            (*uses).serial = serial
        }
    }

    // Count the submission of encoder `serial` into `busy`; false while the
    // encoder is still recording.
    fn fold(&self, serial: u64, uses: *mut BufferUse) -> bool {
        outcome := self.outcome(serial)
        if outcome == RECORDING {
            return false
        }
        if outcome == FORGOTTEN {
            outcome = self.life.read().submitted
        }
        unsafe {
            if outcome > (*uses).busy {
                (*uses).busy = outcome
            }
        }
        return true
    }

    // The submission after which no submitted work uses `buffer` (0: none
    // does), or UPLOADING when the upload encoder writes it. Encoders still
    // recording do not count: they run after anything the CPU does now.
    fn needed_by(&self, buffer: &Buffer) -> u64 {
        uploads := self.uploads.read()
        uploading := if uploads.open {
            uploads.serial
        } else {
            0
        }
        life := self.life.read()
        uses := unsafe {
            buffer.uses.get()
        }
        needed := 0u64
        unsafe {
            if (*uses).shared {
                if life.open_encoders == 0 {
                    // Every use is part of a submission by now.
                    if life.submitted > (*uses).busy {
                        (*uses).busy = life.submitted
                    }
                    (*uses).shared = false
                } else {
                    if uploading != 0 {
                        return UPLOADING
                    }
                    needed = life.submitted
                }
            }
            if (*uses).serial == uploading && uploading != 0 || (*uses).older == uploading && uploading != 0 {
                return UPLOADING
            }
            if (*uses).older != 0 && self.fold((*uses).older, uses) {
                (*uses).older = 0
            }
            if (*uses).serial != 0 {
                self.fold((*uses).serial, uses)
            }
            if (*uses).busy > needed {
                needed = (*uses).busy
            }
        }
        return needed
    }

    // Whether the CPU may access a mapped buffer now.
    fn buffer_idle(&self, buffer: &Buffer) -> bool {
        needed := self.needed_by(buffer)
        return needed == 0 || (needed != UPLOADING && self.backend().completed() >= needed)
    }

    // Wait until the CPU may access a mapped buffer.
    fn settle(&self, buffer: &Buffer) -> void!Error {
        needed := self.needed_by(buffer)
        if needed == UPLOADING {
            self.flush()?
            needed = self.needed_by(buffer)
        }
        if needed != 0 {
            self.backend().wait(needed)?
        }
        return ok()
    }

    // Object lifetimes.

    // An object was dropped: destroy it now if the GPU cannot be using it,
    // otherwise once it has finished.
    fn retire(&self, object: u32, handle: &hal.Handle) {
        life := self.life.read()
        open := life.open_encoders
        submitted := life.submitted
        if open == 0 && (!self.tracks || submitted == 0 || self.backend().completed() >= submitted) {
            self.backend().destroy(object, handle)
            return
        }
        wait := submitted
        if open != 0 {
            wait = PENDING
        }
        self.bury(object, handle, wait)
    }

    fn bury(&self, object: u32, handle: &hal.Handle, wait: u64) {
        self.life.update(fn(life) {
            life.graves.push(Grave { object: object, handle: handle.copy(), wait: wait })
        })
    }

    // A submitted (`index` > 0) or abandoned encoder is no longer needed
    // once its submission has finished, or at once where the API keeps it.
    fn dispose_encoder(&self, encoder: &hal.Handle, index: u64) {
        if self.tracks && index != 0 {
            self.bury(hal.OBJECT_ENCODER, encoder, index)
        } else {
            self.backend().destroy(hal.OBJECT_ENCODER, encoder)
        }
    }

    // Destroy the objects whose submissions have finished.
    fn collect(&self) {
        if self.life.read().graves.len() == 0 {
            return
        }
        // Without tracking, the API keeps what submitted work uses alive.
        completed := PENDING - 1
        if self.tracks {
            completed = self.backend().completed()
        }
        backend := self.backend()
        self.life.update(fn(life) {
            kept := 0usize
            for i in 0usize..life.graves.len() {
                wait := life.graves.get(i).wait
                if wait != PENDING && wait <= completed {
                    grave := life.graves.get(i)
                    backend.destroy(grave.object, &grave.handle)
                } else {
                    life.graves.copy_within(i, kept)
                    kept += 1
                }
            }
            life.graves.truncate(kept)
        })
    }

    // An encoder was submitted (`index` > 0) or abandoned (0).
    fn close_encoder(&self, index: u64) {
        self.life.update(fn(life) {
            if index != 0 {
                life.submitted = index
            }
            life.open_encoders -= 1
            if life.open_encoders == 0 {
                // Every encoder that may have used these has been
                // submitted by now, or abandoned.
                for i in 0usize..life.graves.len() {
                    if life.graves.get(i).wait == PENDING {
                        life.graves.get_mut(i).wait = life.submitted
                    }
                }
            }
        })
    }

    // An encoder's hazard table is cleared and kept for the next one.
    fn return_hazards(&self, hazards: Hazards) {
        hazards.clear()
        if self.life.read().spare.capacity == 0 {
            self.life.update(fn(life) {
                mem.swap(&mut life.spare, &mut hazards)
            })
        }
        // An empty table now, or one more than needed.
        hazards.free()
    }

    fn drop(&mut self) {
        // Every object borrowing the device is gone; only the graveyard and
        // the staging buffers are left. Staged writes no one can see any
        // more are discarded. Destroy the rest once the GPU is idle.
        backend := self.backend()
        submitted := self.life.read().submitted
        self.uploads.update(fn(uploads) {
            if uploads.open {
                backend.destroy(hal.OBJECT_ENCODER, &uploads.encoder)
                uploads.open = false
            }
            uploads.hazards.free()
            uploads.marks.free()
        })
        if submitted != 0 {
            hal.ignore(backend.wait(submitted))
        }
        self.life.update(fn(life) {
            for i in 0usize..life.graves.len() {
                grave := life.graves.get(i)
                backend.destroy(grave.object, &grave.handle)
            }
            life.graves.free()
            life.spare.free()
        })
        uploads := self.uploads.read()
        if uploads.ring_size != 0 {
            backend.destroy(hal.OBJECT_BUFFER, &uploads.ring)
        }
        if uploads.readback_size != 0 {
            backend.destroy(hal.OBJECT_BUFFER, &uploads.readback)
        }
    }
}

// The more informative of two failures to open a backend.
fn worse(current: Error, next: Error) -> Error {
    match &next {
        Error.NoBackend => {
            return current
        }
        Error.Unsupported => {
            match &current {
                Error.NoBackend => {
                    return next
                }
                _ => {
                    return current
                }
            }
        }
        _ => {
            match &current {
                Error.NoBackend => {
                    return next
                }
                Error.Unsupported => {
                    return next
                }
                _ => {
                    return current
                }
            }
        }
    }
}

// Whether [offset, offset + length) lies within `size` bytes.
fn fits(offset: u64, length: u64, size: u64) -> bool {
    return length <= size && offset <= size - length
}

// Neither infinite nor NaN.
fn finite(value: f32) -> bool {
    return value - value == 0.0
}

fn valid_blend(blend: &hal.Blend) -> bool {
    factors := blend.color_source <= hal.BLEND_FACTOR_ONE_MINUS_CONSTANT && blend.color_destination <= hal.BLEND_FACTOR_ONE_MINUS_CONSTANT && blend.alpha_source <= hal.BLEND_FACTOR_ONE_MINUS_CONSTANT && blend.alpha_destination <= hal.BLEND_FACTOR_ONE_MINUS_CONSTANT
    return factors && blend.color_operation <= hal.BLEND_OP_MAX && blend.alpha_operation <= hal.BLEND_OP_MAX
}

// The bytes a texture copy of `region` spans, rows `bytes_per_row` apart.
fn copy_size(texture: &TextureDescriptor, region: &Region, bytes_per_row: u32) -> u64 {
    row := region.width as u64 * hal.texel_size(texture.format) as u64
    return (region.height as u64 - 1) * bytes_per_row as u64 + row
}

// Whether a copy of `region` between `texture` and `available` bytes
// starting at `offset`, rows `bytes_per_row` apart, stays in bounds.
fn texture_copy_fits(texture: &TextureDescriptor, region: &Region, available: u64, offset: u64, bytes_per_row: u32) -> bool {
    texel := hal.texel_size(texture.format) as u64
    if region.level >= texture.mip_levels {
        return false
    }
    width := hal.level_size(texture.width, region.level) as u64
    height := hal.level_size(texture.height, region.level) as u64
    if region.x as u64 + region.width as u64 > width || region.y as u64 + region.height as u64 > height {
        return false
    }
    row := region.width as u64 * texel
    if (bytes_per_row as u64) < row || bytes_per_row as u64 % texel != 0 {
        return false
    }
    if region.width == 0 || region.height == 0 {
        return true
    }
    needed := (region.height as u64 - 1) * bytes_per_row as u64 + row
    return fits(offset, needed, available)
}

// Check a binding layout and record it in `pipeline`.
fn check_bindings(bindings: &[BindingLayout], allowed: u32, pipeline: &mut hal.Pipeline) -> void!Error {
    for i in 0usize..bindings.len {
        binding := &bindings[i]
        slot := binding.slot
        if slot >= hal.MAX_SLOTS || pipeline.kinds[slot as usize] != hal.BINDING_NONE {
            return err(Error.InvalidInput)
        }
        if binding.kind == hal.BINDING_NONE || binding.kind > hal.BINDING_COMPARISON_TEXTURE {
            return err(Error.InvalidInput)
        }
        if binding.stages == 0 || (binding.stages & ~allowed) != 0 {
            return err(Error.InvalidInput)
        }
        // Storage buffers and textures are writable, which vertex shaders
        // cannot be on every backend.
        if (binding.kind == hal.BINDING_STORAGE_BUFFER || binding.kind == hal.BINDING_STORAGE_TEXTURE) && (binding.stages & hal.STAGE_VERTEX) != 0 {
            return err(Error.InvalidInput)
        }
        if binding.kind == hal.BINDING_STORAGE_TEXTURE && !hal.is_storage(binding.format) {
            return err(Error.InvalidInput)
        }
        pipeline.slots = pipeline.slots | (1u32 << slot)
        pipeline.kinds[slot as usize] = binding.kind
        pipeline.stages[slot as usize] = binding.stages
        pipeline.formats[slot as usize] = binding.format
    }
    return ok()
}

// GPU memory. Dropping it frees the memory once the GPU has finished every
// submission that may use it.
pub struct Buffer {
    device: &Device
    handle: hal.Handle
    size: u64
    usage: u32
    uses: hal.Mutable<BufferUse>

    pub fn size(&self) -> u64 {
        return self.size
    }
    pub fn usage(&self) -> u32 {
        return self.usage
    }

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_BUFFER, &self.handle)
    }
}

// Which encoders used a buffer: the last one, an older one still
// recording when the last began using it, and the submission all other
// uses were part of (see Device.note_use).
struct BufferUse {
    serial: u64
    older: u64
    busy: u64
    // More encoders recording at once used it than are kept: until none
    // records, assume every submission does.
    shared: bool

    fn new() -> BufferUse {
        return BufferUse { serial: 0, older: 0, busy: 0, shared: false }
    }
}

// Bytes on their way back from the GPU, from Device.start_read_buffer or
// start_read_texture. Dropping it discards them.
pub struct Readback {
    device: &Device
    // The readback buffer, or a null handle where the bytes were copied
    // into CPU memory at once (OpenGL).
    buffer: hal.Handle
    address: usize
    // The bytes start `skip` bytes into the copy.
    skip: u64
    size: u64
    index: u64

    pub fn size(&self) -> u64 {
        return self.size
    }

    // Whether the GPU has made the copy, so that read() returns at once.
    pub fn ready(&self) -> bool {
        return self.index == 0 || self.device.backend().completed() >= self.index
    }

    // Copy the bytes into `out`, which holds size() bytes, after waiting
    // for the GPU to copy them if it has not yet. For a texture, rows are
    // the bytes_per_row apart that the read started with.
    pub fn read(&self, out: &mut[u8]) -> void!Error {
        if out.len as u64 != self.size {
            return err(Error.InvalidInput)
        }
        device := self.device
        if self.index != 0 {
            device.backend().wait(self.index)?
            device.backend().invalidate(&self.buffer, 0, self.skip + self.size)
        }
        unsafe {
            ptr.copy_nonoverlapping((self.address + self.skip as usize) as *const u8, ptr.as_mut_ptr(out), out.len)
        }
        return ok()
    }

    // The CPU memory of a read made at once.
    fn host_bytes(&mut self) -> &mut[u8] from(self) {
        unsafe {
            return ptr.borrow_slice_mut(self.address as *mut u8, self.size as usize, self)
        }
    }

    fn drop(&mut self) {
        if self.buffer.a == 0 {
            unsafe {
                free(self.address as *mut u8)
            }
        } else {
            self.device.retire(hal.OBJECT_BUFFER, &self.buffer)
        }
    }
}

// A two-dimensional image on the GPU, with one or more mipmap levels.
pub struct Texture {
    device: &Device
    handle: hal.Handle
    descriptor: hal.TextureDescriptor
    // A surface's image, which belongs to the surface.
    external: bool

    pub fn width(&self) -> u32 {
        return self.descriptor.width
    }
    pub fn height(&self) -> u32 {
        return self.descriptor.height
    }
    pub fn format(&self) -> u32 {
        return self.descriptor.format
    }
    pub fn usage(&self) -> u32 {
        return self.descriptor.usage
    }
    pub fn mip_levels(&self) -> u32 {
        return self.descriptor.mip_levels
    }
    pub fn samples(&self) -> u32 {
        return self.descriptor.samples
    }
    // The bytes one row of the first level takes, tightly packed.
    pub fn bytes_per_row(&self) -> u32 {
        return self.descriptor.width * hal.texel_size(self.descriptor.format)
    }
    // The bytes one row of mipmap `level` takes, tightly packed.
    pub fn level_bytes_per_row(&self, level: u32) -> u32 {
        return hal.level_size(self.descriptor.width, level) * hal.texel_size(self.descriptor.format)
    }
    // The region covering the whole first level.
    pub fn region(&self) -> Region {
        return hal.Region.new(0, 0, self.descriptor.width, self.descriptor.height)
    }
    // The region covering all of mipmap `level`.
    pub fn level_region(&self, level: u32) -> Region {
        return hal.Region.at_level(level, 0, 0, hal.level_size(self.descriptor.width, level), hal.level_size(self.descriptor.height, level))
    }

    fn drop(&mut self) {
        if !self.external {
            self.device.retire(hal.OBJECT_TEXTURE, &self.handle)
        }
    }
}

pub struct Sampler {
    device: &Device
    handle: hal.Handle
    compare: bool

    // Whether the sampler compares, for BindingLayout.comparison_texture.
    pub fn compares(&self) -> bool {
        return self.compare
    }

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_SAMPLER, &self.handle)
    }
}

pub struct ComputePipeline {
    device: &Device
    pipeline: hal.Pipeline

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_COMPUTE_PIPELINE, &self.pipeline.handle)
    }
}

pub struct RenderPipeline {
    device: &Device
    pipeline: hal.Pipeline

    fn drop(&mut self) {
        self.device.retire(hal.OBJECT_RENDER_PIPELINE, &self.pipeline.handle)
    }
}

// A color attachment of a render pass. LOAD_CLEAR fills it with the
// clear color first; LOAD_KEEP draws over what it holds. A multisampled
// attachment can resolve into a texture of the same size and format with
// one sample (with_resolve): the average of each pixel's samples is
// written there when the pass ends.
pub struct ColorAttachment {
    pub texture: &Texture
    pub load: u32
    pub red: f64
    pub green: f64
    pub blue: f64
    pub alpha: f64
    // Keep what the pass drew (true), or let the GPU drop it, leaving the
    // contents undefined, which saves memory traffic for multisampled
    // attachments that are only resolved.
    pub store: bool
    pub resolve: &Texture
    pub has_resolve: bool

    pub fn clear(texture: &Texture, red: f64, green: f64, blue: f64, alpha: f64) -> ColorAttachment from(texture) {
        return ColorAttachment { texture: texture, load: hal.LOAD_CLEAR, red: red, green: green, blue: blue, alpha: alpha, store: true, resolve: texture, has_resolve: false }
    }
    pub fn keep(texture: &Texture) -> ColorAttachment from(texture) {
        return ColorAttachment { texture: texture, load: hal.LOAD_KEEP, red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0, store: true, resolve: texture, has_resolve: false }
    }
    // Resolve this multisampled attachment into `target` (TEXTURE_RENDER).
    pub fn with_resolve(self, target: &Texture) -> ColorAttachment from(self, target) {
        return ColorAttachment { texture: self.texture, load: self.load, red: self.red, green: self.green, blue: self.blue, alpha: self.alpha, store: self.store, resolve: target, has_resolve: true }
    }
    // Drop the attachment's contents after the pass (after resolving).
    pub fn discard(self) -> ColorAttachment from(self) {
        return ColorAttachment { texture: self.texture, load: self.load, red: self.red, green: self.green, blue: self.blue, alpha: self.alpha, store: false, resolve: self.resolve, has_resolve: self.has_resolve }
    }
}

// The depth attachment of a render pass.
pub struct DepthAttachment {
    pub texture: &Texture
    pub load: u32
    pub depth: f32
    // Keep the depths after the pass (true), or let the GPU drop them.
    pub store: bool

    pub fn clear(texture: &Texture, depth: f32) -> DepthAttachment from(texture) {
        return DepthAttachment { texture: texture, load: hal.LOAD_CLEAR, depth: depth, store: true }
    }
    pub fn keep(texture: &Texture) -> DepthAttachment from(texture) {
        return DepthAttachment { texture: texture, load: hal.LOAD_KEEP, depth: 0.0, store: true }
    }
    // Drop the depths after the pass: they were only needed for its tests.
    pub fn discard(self) -> DepthAttachment from(self) {
        return DepthAttachment { texture: self.texture, load: self.load, depth: self.depth, store: false }
    }
}

const NO_COLORS: [0]ColorAttachment = []
const NO_DEPTH: [0]DepthAttachment = []

// Records commands for the GPU. Nothing runs until submit(); dropping an
// encoder without submitting discards its commands.
pub struct CommandEncoder {
    device: &Device
    handle: hal.Handle
    open: bool
    hazards: Hazards
    serial: u64

    // Record a compute pass. The encoder is busy until the pass ends.
    pub fn compute_pass(&mut self) -> ComputePass from(self) {
        device := self.device
        device.backend().begin_compute_pass(&mut self.handle)
        return ComputePass { encoder: self, state: hal.PassState.new(), tracked: Tracked.new() }
    }

    // Record a render pass drawing into `color`. It needs TEXTURE_RENDER
    // and a color format.
    pub fn render_pass(&mut self, color: ColorAttachment) -> RenderPass from(self) {
        colors := [color]
        return self.begin_render(&colors, &NO_DEPTH)
    }

    // Record a render pass drawing into `color` with the depth buffer
    // `depth`, a TEXTURE_RENDER depth texture of the same size.
    pub fn render_pass_with_depth(&mut self, color: ColorAttachment, depth: DepthAttachment) -> RenderPass from(self) {
        colors := [color]
        depths := [depth]
        return self.begin_render(&colors, &depths)
    }

    // Record a render pass drawing into several color attachments (at most
    // limits().max_color_attachments) of one size and sample count:
    // attachment N takes the fragment shader's output at @location(N).
    pub fn render_pass_targets(&mut self, colors: &[ColorAttachment]) -> RenderPass from(self) {
        assert(colors.len != 0, "a render pass needs an attachment")
        return self.begin_render(colors, &NO_DEPTH)
    }

    pub fn render_pass_targets_with_depth(&mut self, colors: &[ColorAttachment], depth: DepthAttachment) -> RenderPass from(self) {
        depths := [depth]
        return self.begin_render(colors, &depths)
    }

    // Record a render pass that only writes `depth`, drawn with depth-only
    // pipelines (RenderPipelineDescriptor.depth_only), such as a shadow map.
    pub fn depth_pass(&mut self, depth: DepthAttachment) -> RenderPass from(self) {
        depths := [depth]
        return self.begin_render(&NO_COLORS, &depths)
    }

    // `depths` holds the depth attachment, or nothing.
    fn begin_render(&mut self, colors: &[ColorAttachment], depths: &[DepthAttachment]) -> RenderPass from(self) {
        device := self.device
        assert(colors.len <= device.limits.max_color_attachments as usize, "the pass has more color attachments than limits().max_color_attachments")
        first := if colors.len != 0 {
            colors[0].texture
        } else {
            depths[0].texture
        }
        width := first.descriptor.width
        height := first.descriptor.height
        samples := first.descriptor.samples
        info := hal.RenderPassInfo.new(width, height, samples)
        tracked := Tracked.new()
        tracked.width = width
        tracked.height = height
        tracked.samples = samples
        tracked.depth_format = hal.FORMAT_NONE
        before := 0u32
        after := 0u32
        for i in 0usize..colors.len {
            color := &colors[i]
            target := color.texture
            device.check_owner(target.device)
            check_attachment(target, width, height, samples)
            assert(!hal.is_depth(target.descriptor.format), "the color attachment has a depth format")
            assert(color.load <= hal.LOAD_KEEP, "unknown load action")
            tracked.attach(target.handle.a)
            info.colors[i] = hal.Attachment {
                texture: target.handle.copy(),
                format: target.descriptor.format,
                load: color.load,
                store: color.store,
                clear_red: color.red,
                clear_green: color.green,
                clear_blue: color.blue,
                clear_alpha: color.alpha,
                clear_depth: 0.0,
                has_resolve: color.has_resolve,
                resolve: hal.Handle.null()
            }
            if color.has_resolve {
                resolve := color.resolve
                device.check_owner(resolve.device)
                assert(samples != 1, "only multisampled attachments resolve")
                check_attachment(resolve, width, height, 1)
                assert(resolve.descriptor.format == target.descriptor.format, "the resolve target's format differs from its attachment's")
                tracked.attach(resolve.handle.a)
                info.colors[i].resolve = resolve.handle.copy()
                self.hazards.use_resource(resolve.handle.a ^ TEXTURE_KEY, hal.USE_COLOR, true, &mut before, &mut after)
            }
            tracked.color_formats[i] = target.descriptor.format
            self.hazards.use_resource(target.handle.a ^ TEXTURE_KEY, hal.USE_COLOR, true, &mut before, &mut after)
        }
        tracked.color_count = colors.len as u32
        info.color_count = colors.len as u32
        if depths.len != 0 {
            depth := &depths[0]
            texture := depth.texture
            device.check_owner(texture.device)
            check_attachment(texture, width, height, samples)
            assert(hal.is_depth(texture.descriptor.format), "the depth attachment has a color format")
            assert(depth.load <= hal.LOAD_KEEP, "unknown load action")
            tracked.attach(texture.handle.a)
            tracked.depth_format = texture.descriptor.format
            info.has_depth = true
            info.depth = hal.Attachment {
                texture: texture.handle.copy(),
                format: texture.descriptor.format,
                load: depth.load,
                store: depth.store,
                clear_red: 0.0,
                clear_green: 0.0,
                clear_blue: 0.0,
                clear_alpha: 0.0,
                clear_depth: depth.depth,
                has_resolve: false,
                resolve: hal.Handle.null()
            }
            self.hazards.use_resource(texture.handle.a ^ TEXTURE_KEY, hal.USE_DEPTH, true, &mut before, &mut after)
        }
        device.backend().begin_render_pass(&mut self.handle, &info)
        if before != 0 {
            device.backend().barrier(&mut self.handle, before, after)
        }
        return RenderPass { encoder: self, state: hal.PassState.new(), tracked: tracked }
    }

    // Fill every mipmap level of `texture` after the first by filtering
    // down the one before it, as for a texture whose first level was just
    // written or rendered. It needs a filterable color format (8-bit and
    // 16-bit float ones); with one level it does nothing.
    pub fn generate_mipmaps(&mut self, texture: &Texture) {
        device := self.device
        device.check_owner(texture.device)
        assert(hal.is_filterable(texture.descriptor.format) && texture.descriptor.samples == 1, "generating mipmaps needs a filterable color format")
        if texture.descriptor.mip_levels < 2 {
            return
        }
        before := 0u32
        after := 0u32
        self.hazards.use_resource(texture.handle.a ^ TEXTURE_KEY, hal.USE_COPY_SRC | hal.USE_COPY_DST, true, &mut before, &mut after)
        if before != 0 {
            device.backend().barrier(&mut self.handle, before, after)
        }
        device.backend().generate_mipmaps(&mut self.handle, &texture.handle, &texture.descriptor)
    }

    // Copy `size` bytes between buffers. Offsets and size are multiples
    // of 4, the source has BUFFER_COPY_SRC, the destination
    // BUFFER_COPY_DST, and copies within one buffer do not overlap.
    pub fn copy_buffer(&mut self, source: &Buffer, source_offset: u64, destination: &Buffer, destination_offset: u64, size: u64) {
        device := self.device
        device.check_owner(source.device)
        device.check_owner(destination.device)
        assert((source.usage & hal.BUFFER_COPY_SRC) != 0, "the copy source needs BUFFER_COPY_SRC")
        assert((destination.usage & hal.BUFFER_COPY_DST) != 0, "the copy destination needs BUFFER_COPY_DST")
        assert((source_offset & 3) == 0 && (destination_offset & 3) == 0 && (size & 3) == 0, "buffer copies need offsets and sizes in multiples of 4")
        assert(fits(source_offset, size, source.size) && fits(destination_offset, size, destination.size), "the copy range lies outside the buffer")
        if ptr.from_ref(source) == ptr.from_ref(destination) {
            assert(source_offset + size <= destination_offset || destination_offset + size <= source_offset, "the copy ranges overlap")
        }
        if size == 0 {
            return
        }
        device.note_use(source, self.serial)
        device.note_use(destination, self.serial)
        copy_hazards(device, &mut self.hazards, &mut self.handle, source.handle.a, destination.handle.a)
        device.backend().copy_buffer(&mut self.handle, &source.handle, source_offset, &destination.handle, destination_offset, size)
    }

    // Copy texels from `source`, starting `offset` bytes in with rows
    // `bytes_per_row` apart, into `region` of `destination`. The offset
    // is a multiple of 4 and of the texel size; the rest follows
    // write_texture.
    pub fn copy_buffer_to_texture(&mut self, source: &Buffer, offset: u64, bytes_per_row: u32, destination: &Texture, region: Region) {
        device := self.device
        device.check_owner(source.device)
        device.check_owner(destination.device)
        assert((source.usage & hal.BUFFER_COPY_SRC) != 0, "the copy source needs BUFFER_COPY_SRC")
        assert((destination.descriptor.usage & hal.TEXTURE_COPY_DST) != 0, "the copy destination needs TEXTURE_COPY_DST")
        check_texture_copy(&destination.descriptor, &region, source.size, offset, bytes_per_row)
        if region.width == 0 || region.height == 0 {
            return
        }
        device.note_use(source, self.serial)
        copy_hazards(device, &mut self.hazards, &mut self.handle, source.handle.a, destination.handle.a ^ TEXTURE_KEY)
        device.backend().copy_buffer_to_texture(&mut self.handle, &source.handle, offset, bytes_per_row, &destination.handle, &destination.descriptor, &region)
    }

    // Copy texels of `region` of `source` into `destination`, starting
    // `offset` bytes in with rows `bytes_per_row` apart.
    pub fn copy_texture_to_buffer(&mut self, source: &Texture, region: Region, destination: &Buffer, offset: u64, bytes_per_row: u32) {
        device := self.device
        device.check_owner(source.device)
        device.check_owner(destination.device)
        assert((source.descriptor.usage & hal.TEXTURE_COPY_SRC) != 0, "the copy source needs TEXTURE_COPY_SRC")
        assert((destination.usage & hal.BUFFER_COPY_DST) != 0, "the copy destination needs BUFFER_COPY_DST")
        check_texture_copy(&source.descriptor, &region, destination.size, offset, bytes_per_row)
        if region.width == 0 || region.height == 0 {
            return
        }
        device.note_use(destination, self.serial)
        copy_hazards(device, &mut self.hazards, &mut self.handle, source.handle.a ^ TEXTURE_KEY, destination.handle.a)
        device.backend().copy_texture_to_buffer(&mut self.handle, &source.handle, &source.descriptor, &region, &destination.handle, offset, bytes_per_row)
    }

    // Run the recorded commands after everything submitted before, and
    // after the writes made with write_buffer and write_texture so far.
    pub fn submit(self) -> void!Error {
        self.submit_numbered()?
        self.device.collect()
        return ok()
    }

    // Submit, after the staged writes so far, and return the number of
    // the submission.
    fn submit_numbered(&mut self) -> u64!Error {
        device := self.device
        index := device.submit_encoder(&mut self.handle)?
        self.open = false
        device.end_serial(self.serial, index)
        device.close_encoder(index)
        device.dispose_encoder(&self.handle, index)
        return ok(index)
    }

    fn drop(&mut self) {
        device := self.device
        device.return_hazards(mem.replace(&mut self.hazards, Hazards.new(false)))
        if self.open {
            device.backend().destroy(hal.OBJECT_ENCODER, &self.handle)
            device.end_serial(self.serial, 0)
            device.close_encoder(0)
        }
    }
}

// A copy from `source` to `destination` (tracking keys) follows.
fn copy_hazards(device: &Device, hazards: &mut Hazards, encoder: &mut hal.Handle, source: u64, destination: u64) {
    before := 0u32
    after := 0u32
    hazards.use_resource(source, hal.USE_COPY_SRC, false, &mut before, &mut after)
    hazards.use_resource(destination, hal.USE_COPY_DST, true, &mut before, &mut after)
    if before != 0 {
        device.backend().barrier(encoder, before, after)
    }
}

// Check one attachment of a pass whose attachments are `width` by
// `height` with `samples` samples.
fn check_attachment(texture: &Texture, width: u32, height: u32, samples: u32) {
    assert((texture.descriptor.usage & hal.TEXTURE_RENDER) != 0, "a render pass attachment needs TEXTURE_RENDER")
    assert(texture.descriptor.width == width && texture.descriptor.height == height, "the attachments differ in size")
    assert(texture.descriptor.samples == samples, "the attachments differ in their sample counts")
}

fn check_texture_copy(texture: &TextureDescriptor, region: &Region, buffer_size: u64, offset: u64, bytes_per_row: u32) {
    texel := hal.texel_size(texture.format) as u64
    assert(offset % 4 == 0 && offset % texel == 0, "the buffer offset of a texture copy is not a multiple of 4 and of the texel size")
    assert(!hal.is_depth(texture.format) || (texture.usage & hal.TEXTURE_COPY_DST) == 0, "depth textures cannot be copied into")
    assert(texture_copy_fits(texture, region, buffer_size, offset, bytes_per_row), "the texture copy lies outside the texture or the buffer, or bytes_per_row is too small or not a multiple of the texel size")
}

// What a pass knows about the objects bound to it, for checking draws.
struct Tracked {
    usage: [16]u32
    format: [16]u32
    texture_a: [16]u64
    // The bound sampler compares.
    comparison: [16]bool
    vertex_size: [8]u64
    index_size: u64
    // The handles' first words of every attachment and resolve target.
    attachments: [17]u64
    attachment_count: usize
    color_count: u32
    color_formats: [8]u32
    depth_format: u32
    samples: u32
    width: u32
    height: u32
    // Nothing changed since a draw or dispatch checked the bindings
    // against the pipeline (`checked`), or recorded the hazards of the
    // bindings and vertex buffers (`recorded`) and of the index buffer
    // (`index_recorded`). Draws repeating those skip the work.
    checked: bool
    recorded: bool
    index_recorded: bool
    // The pipeline's storage slots: dispatches writing them depend on each
    // other, so their hazards are recorded every time.
    writes: u32

    fn new() -> Tracked {
        return Tracked { usage: [0u32; 16], format: [0u32; 16], texture_a: [0u64; 16], comparison: [false; 16], vertex_size: [0u64; 8], index_size: 0, attachments: [0u64; 17], attachment_count: 0, color_count: 0, color_formats: [0u32; 8], depth_format: 0, samples: 1, width: 0, height: 0, checked: false, recorded: false, index_recorded: false, writes: 0 }
    }

    fn attached(&self, a: u64) -> bool {
        for i in 0usize..self.attachment_count {
            if self.attachments[i] == a {
                return true
            }
        }
        return false
    }

    fn attach(&mut self, a: u64) {
        assert(!self.attached(a), "a texture is attached to the pass twice")
        self.attachments[self.attachment_count] = a
        self.attachment_count += 1
    }

    // The bindings changed.
    fn rebound(&mut self) {
        self.checked = false
        self.recorded = false
    }
}

// The pipeline of a pass changes to `pipeline`.
fn use_pipeline(state: &mut hal.PassState, tracked: &mut Tracked, pipeline: &hal.Pipeline) {
    // Bindings carry over to a pipeline of the same layout; for another
    // layout the backend applies every one again.
    if !state.has_pipeline || !state.pipeline.same_layout(pipeline) {
        state.dirty = state.dirty | state.bound_slots
    }
    state.pipeline = pipeline.copy()
    state.has_pipeline = true
    state.pipeline_dirty = true
    tracked.rebound()
    tracked.writes = writable_slots(pipeline)
}

// Whether a pass already uses `pipeline`.
fn same_pipeline(state: &hal.PassState, pipeline: &hal.Pipeline) -> bool {
    return state.has_pipeline && state.pipeline.handle.a == pipeline.handle.a && state.pipeline.handle.b == pipeline.handle.b
}

// The slots of a pipeline's layout that shaders may write.
fn writable_slots(pipeline: &hal.Pipeline) -> u32 {
    slots := 0u32
    for i in 0usize..hal.MAX_SLOTS as usize {
        kind := pipeline.kinds[i]
        if kind == hal.BINDING_STORAGE_BUFFER || kind == hal.BINDING_STORAGE_TEXTURE {
            slots = slots | (1u32 << i as u32)
        }
    }
    return slots
}

fn bind_buffer(encoder: &CommandEncoder, state: &mut hal.PassState, tracked: &mut Tracked, slot: u32, buffer: &Buffer, offset: u64, size: u64) {
    device := encoder.device
    device.check_owner(buffer.device)
    assert(slot < hal.MAX_SLOTS, "binding slot out of range")
    index := slot as usize
    // Binding the same range again, as programs do before each draw,
    // changes nothing.
    if state.bound[index] == hal.BOUND_BUFFER && state.object_a[index] == buffer.handle.a && state.offset[index] == offset && state.size[index] == size {
        return
    }
    assert(offset % BINDING_ALIGNMENT == 0, "bound buffer offsets are multiples of BINDING_ALIGNMENT (256)")
    assert(size != 0 && fits(offset, size, buffer.size), "the bound range lies outside the buffer")
    device.note_use(buffer, encoder.serial)
    state.bound[index] = hal.BOUND_BUFFER
    state.object_a[index] = buffer.handle.a
    state.object_b[index] = buffer.handle.b
    state.object_c[index] = buffer.handle.c
    state.object_d[index] = buffer.handle.d
    state.sampler[index] = 0
    state.offset[index] = offset
    state.size[index] = size
    state.dirty = state.dirty | (1u32 << slot)
    state.bound_slots = state.bound_slots | (1u32 << slot)
    tracked.usage[index] = buffer.usage
    tracked.format[index] = 0
    tracked.texture_a[index] = 0
    tracked.comparison[index] = false
    tracked.rebound()
}

fn bind_texture(state: &mut hal.PassState, tracked: &mut Tracked, slot: u32, texture: &Texture, sampler: &hal.Handle, compare: bool, kind: u32) {
    assert(slot < hal.MAX_SLOTS, "binding slot out of range")
    index := slot as usize
    if state.bound[index] == kind && state.object_a[index] == texture.handle.a && state.sampler[index] == sampler.a {
        return
    }
    state.bound[index] = kind
    state.object_a[index] = texture.handle.a
    state.object_b[index] = texture.handle.b
    state.object_c[index] = texture.handle.c
    state.object_d[index] = texture.handle.d
    state.sampler[index] = sampler.a
    state.offset[index] = 0
    state.size[index] = 0
    state.dirty = state.dirty | (1u32 << slot)
    state.bound_slots = state.bound_slots | (1u32 << slot)
    tracked.usage[index] = texture.descriptor.usage
    tracked.format[index] = texture.descriptor.format
    tracked.texture_a[index] = texture.handle.a
    tracked.comparison[index] = compare
    tracked.rebound()
}

// Check that the bound objects fit the pipeline's layout, unless nothing
// changed since the last check.
fn check_bound(state: &hal.PassState, tracked: &mut Tracked, limits: &hal.Limits) {
    if tracked.checked {
        return
    }
    assert(state.has_pipeline, "no pipeline is set")
    remaining := state.pipeline.slots
    for remaining != 0 {
        i := hal.lowest_bit(remaining) as usize
        remaining = remaining & (remaining - 1)
        kind := state.pipeline.kinds[i]
        bound := state.bound[i]
        usage := tracked.usage[i]
        if kind == hal.BINDING_UNIFORM_BUFFER {
            assert(bound == hal.BOUND_BUFFER, "the pipeline expects a buffer in a slot that holds none")
            assert((usage & hal.BUFFER_UNIFORM) != 0, "a uniform buffer slot holds a buffer without BUFFER_UNIFORM")
            assert(state.size[i] <= limits.max_uniform_binding_size, "the bound uniform range exceeds limits().max_uniform_binding_size")
        } else if kind == hal.BINDING_STORAGE_BUFFER || kind == hal.BINDING_READ_ONLY_STORAGE_BUFFER {
            assert(bound == hal.BOUND_BUFFER, "the pipeline expects a buffer in a slot that holds none")
            assert((usage & hal.BUFFER_STORAGE) != 0, "a storage buffer slot holds a buffer without BUFFER_STORAGE")
            assert(state.size[i] <= limits.max_storage_binding_size, "the bound storage range exceeds limits().max_storage_binding_size")
        } else if kind == hal.BINDING_SAMPLED_TEXTURE {
            assert(bound == hal.BOUND_SAMPLED_TEXTURE, "the pipeline expects a texture and sampler in a slot that holds none")
            assert((usage & hal.TEXTURE_SAMPLED) != 0, "a sampled texture slot holds a texture without TEXTURE_SAMPLED")
            assert(!tracked.comparison[i], "a sampled texture slot holds a comparison sampler (use BindingLayout.comparison_texture)")
        } else if kind == hal.BINDING_COMPARISON_TEXTURE {
            assert(bound == hal.BOUND_SAMPLED_TEXTURE, "the pipeline expects a depth texture and comparison sampler in a slot that holds none")
            assert((usage & hal.TEXTURE_SAMPLED) != 0, "a sampled texture slot holds a texture without TEXTURE_SAMPLED")
            assert(hal.is_depth(tracked.format[i]), "a comparison texture slot holds a texture without a depth format")
            assert(tracked.comparison[i], "a comparison texture slot holds a sampler that does not compare")
        } else if kind == hal.BINDING_STORAGE_TEXTURE {
            assert(bound == hal.BOUND_STORAGE_TEXTURE, "the pipeline expects a storage texture in a slot that holds none")
            assert((usage & hal.TEXTURE_STORAGE) != 0, "a storage texture slot holds a texture without TEXTURE_STORAGE")
            assert(tracked.format[i] == state.pipeline.formats[i], "the storage texture's format differs from the layout's")
        }
        if kind == hal.BINDING_SAMPLED_TEXTURE || kind == hal.BINDING_COMPARISON_TEXTURE || kind == hal.BINDING_STORAGE_TEXTURE {
            assert(!tracked.attached(tracked.texture_a[i]), "a texture is bound while it is an attachment of the pass")
        }
    }
    tracked.checked = true
}

// A compute pass. It ends when dropped or with end().
pub struct ComputePass {
    encoder: &mut CommandEncoder
    state: hal.PassState
    tracked: Tracked

    pub fn set_pipeline(&mut self, pipeline: &ComputePipeline) {
        device := self.encoder.device
        device.check_owner(pipeline.device)
        if same_pipeline(&self.state, &pipeline.pipeline) {
            return
        }
        use_pipeline(&mut self.state, &mut self.tracked, &pipeline.pipeline)
    }

    // Bind all of `buffer` to `slot`.
    pub fn set_buffer(&mut self, slot: u32, buffer: &Buffer) {
        self.set_buffer_range(slot, buffer, 0, buffer.size)
    }

    // Bind `size` bytes of `buffer` from `offset`, a multiple of
    // BINDING_ALIGNMENT, to `slot`.
    pub fn set_buffer_range(&mut self, slot: u32, buffer: &Buffer, offset: u64, size: u64) {
        bind_buffer(self.encoder, &mut self.state, &mut self.tracked, slot, buffer, offset, size)
    }

    // Bind `texture`, read through `sampler`, to `slot`.
    pub fn set_texture(&mut self, slot: u32, texture: &Texture, sampler: &Sampler) {
        device := self.encoder.device
        device.check_owner(texture.device)
        device.check_owner(sampler.device)
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &sampler.handle, sampler.compare, hal.BOUND_SAMPLED_TEXTURE)
    }

    // Bind `texture` for reading and writing single texels to `slot`.
    pub fn set_storage_texture(&mut self, slot: u32, texture: &Texture) {
        device := self.encoder.device
        device.check_owner(texture.device)
        empty := hal.Handle.null()
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &empty, false, hal.BOUND_STORAGE_TEXTURE)
    }

    // Run x * y * z workgroups of the pipeline's workgroup size. Each
    // dispatch sees the writes of the ones before it.
    pub fn dispatch(&mut self, x: u32, y: u32, z: u32) {
        device := self.encoder.device
        check_bound(&self.state, &mut self.tracked, &device.limits)
        maximum := device.limits.max_workgroups
        assert(x <= maximum && y <= maximum && z <= maximum, "the dispatch exceeds limits().max_workgroups")
        if x == 0 || y == 0 || z == 0 {
            return
        }
        if !self.encoder.hazards.off && (!self.tracked.recorded || self.tracked.writes != 0) {
            before := 0u32
            after := 0u32
            binding_hazards(&self.state, &mut self.encoder.hazards, &mut before, &mut after)
            if before != 0 {
                device.backend().barrier(&mut self.encoder.handle, before, after)
            }
            self.tracked.recorded = true
        }
        device.backend().dispatch(&mut self.encoder.handle, &mut self.state, x, y, z)
    }

    pub fn end(self) {}

    fn drop(&mut self) {
        device := self.encoder.device
        device.backend().end_compute_pass(&mut self.encoder.handle)
    }
}

// A render pass. It ends when dropped or with end(). The viewport and
// scissor start out covering the whole attachment.
pub struct RenderPass {
    encoder: &mut CommandEncoder
    state: hal.PassState
    tracked: Tracked

    pub fn set_pipeline(&mut self, pipeline: &RenderPipeline) {
        device := self.encoder.device
        device.check_owner(pipeline.device)
        expected := &pipeline.pipeline
        if same_pipeline(&self.state, expected) {
            return
        }
        same := expected.color_count == self.tracked.color_count
        for i in 0usize..expected.color_count as usize {
            if expected.color_formats[i] != self.tracked.color_formats[i] {
                same = false
            }
        }
        assert(same, "the pipeline's color formats differ from the pass's color attachments")
        assert(expected.depth_format == self.tracked.depth_format, "the pipeline's depth format differs from the pass's depth attachment")
        assert(expected.samples == self.tracked.samples, "the pipeline's sample count differs from the pass's attachments")
        use_pipeline(&mut self.state, &mut self.tracked, expected)
    }

    pub fn set_buffer(&mut self, slot: u32, buffer: &Buffer) {
        self.set_buffer_range(slot, buffer, 0, buffer.size)
    }

    pub fn set_buffer_range(&mut self, slot: u32, buffer: &Buffer, offset: u64, size: u64) {
        bind_buffer(self.encoder, &mut self.state, &mut self.tracked, slot, buffer, offset, size)
    }

    pub fn set_texture(&mut self, slot: u32, texture: &Texture, sampler: &Sampler) {
        device := self.encoder.device
        device.check_owner(texture.device)
        device.check_owner(sampler.device)
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &sampler.handle, sampler.compare, hal.BOUND_SAMPLED_TEXTURE)
    }

    pub fn set_storage_texture(&mut self, slot: u32, texture: &Texture) {
        device := self.encoder.device
        device.check_owner(texture.device)
        empty := hal.Handle.null()
        bind_texture(&mut self.state, &mut self.tracked, slot, texture, &empty, false, hal.BOUND_STORAGE_TEXTURE)
    }

    // Read vertex buffer `slot` of the pipeline from `buffer`, starting
    // `offset` bytes in. It needs BUFFER_VERTEX.
    pub fn set_vertex_buffer(&mut self, slot: u32, buffer: &Buffer, offset: u64) {
        device := self.encoder.device
        device.check_owner(buffer.device)
        assert(slot < hal.MAX_VERTEX_BUFFERS, "vertex buffer slot out of range")
        index := slot as usize
        if (self.state.vertex_set >> slot & 1) != 0 && self.state.vertex_a[index] == buffer.handle.a && self.state.vertex_offset[index] == offset {
            return
        }
        assert((buffer.usage & hal.BUFFER_VERTEX) != 0, "a vertex buffer needs BUFFER_VERTEX")
        assert(offset % 4 == 0 && offset <= buffer.size, "the vertex buffer offset is past the end or not a multiple of 4")
        device.note_use(buffer, self.encoder.serial)
        self.state.vertex_a[index] = buffer.handle.a
        self.state.vertex_offset[index] = offset
        self.state.vertex_set = self.state.vertex_set | (1u32 << slot)
        self.state.vertex_dirty = self.state.vertex_dirty | (1u32 << slot)
        self.tracked.vertex_size[index] = buffer.size
        self.tracked.recorded = false
    }

    // Read indices of `format` (INDEX_UINT16 or INDEX_UINT32) from
    // `buffer`, starting `offset` bytes in. It needs BUFFER_INDEX.
    pub fn set_index_buffer(&mut self, buffer: &Buffer, format: u32, offset: u64) {
        device := self.encoder.device
        device.check_owner(buffer.device)
        assert(format == hal.INDEX_UINT16 || format == hal.INDEX_UINT32, "unknown index format")
        assert((buffer.usage & hal.BUFFER_INDEX) != 0, "an index buffer needs BUFFER_INDEX")
        assert(offset % index_size(format) == 0 && offset <= buffer.size, "the index buffer offset is past the end or not a multiple of the index size")
        device.note_use(buffer, self.encoder.serial)
        self.state.index_a = buffer.handle.a
        self.state.index_offset = offset
        self.state.index_format = format
        self.state.index_set = true
        self.state.index_dirty = true
        self.tracked.index_size = buffer.size
        self.tracked.index_recorded = false
    }

    // Draw into this part of the attachment, in pixels from its top-left
    // corner, with depths mapped to `min_depth`..`max_depth` (0.0 to 1.0).
    pub fn set_viewport(&mut self, x: f32, y: f32, width: f32, height: f32, min_depth: f32, max_depth: f32) {
        assert(width > 0.0 && height > 0.0 && x >= 0.0 && y >= 0.0, "the viewport is empty or starts outside the attachment")
        assert(x + width <= self.tracked.width as f32 && y + height <= self.tracked.height as f32, "the viewport extends past the attachment")
        assert(min_depth >= 0.0 && max_depth <= 1.0 && min_depth <= max_depth, "viewport depths lie outside 0.0 to 1.0")
        device := self.encoder.device
        device.backend().set_viewport(&mut self.encoder.handle, x, y, width, height, min_depth, max_depth)
    }

    // The color BLEND_FACTOR_CONSTANT reads, until the pass ends; each pass
    // starts with transparent black.
    pub fn set_blend_constant(&mut self, red: f64, green: f64, blue: f64, alpha: f64) {
        device := self.encoder.device
        device.backend().set_blend_constant(&mut self.encoder.handle, red, green, blue, alpha)
    }

    // Discard pixels outside this rectangle.
    pub fn set_scissor(&mut self, x: u32, y: u32, width: u32, height: u32) {
        assert(x as u64 + width as u64 <= self.tracked.width as u64 && y as u64 + height as u64 <= self.tracked.height as u64, "the scissor rectangle extends past the attachment")
        device := self.encoder.device
        device.backend().set_scissor(&mut self.encoder.handle, x, y, width, height)
    }

    // Draw `vertex_count` vertices from `first_vertex`, `instance_count`
    // times from `first_instance`. Every vertex buffer the pipeline reads
    // must be set and long enough.
    pub fn draw(&mut self, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32) {
        device := self.encoder.device
        check_bound(&self.state, &mut self.tracked, &device.limits)
        check_vertices(&self.state, &self.tracked, first_vertex as u64 + vertex_count as u64, first_instance as u64 + instance_count as u64)
        if vertex_count == 0 || instance_count == 0 {
            return
        }
        if !self.tracked.recorded {
            draw_hazards(device, &self.state, &mut self.encoder.hazards, &mut self.encoder.handle, false)
            self.tracked.recorded = true
        }
        device.backend().draw(&mut self.encoder.handle, &mut self.state, vertex_count, instance_count, first_vertex, first_instance)
    }

    // Draw `index_count` indices of the index buffer from `first_index`,
    // adding `base_vertex` to each. Index values are not checked against
    // the vertex buffers: an index past their end reads undefined values.
    pub fn draw_indexed(&mut self, index_count: u32, instance_count: u32, first_index: u32, base_vertex: i32, first_instance: u32) {
        device := self.encoder.device
        check_bound(&self.state, &mut self.tracked, &device.limits)
        assert(self.state.index_set, "no index buffer is set")
        needed := self.state.index_offset + (first_index as u64 + index_count as u64) * index_size(self.state.index_format)
        assert(needed <= self.tracked.index_size, "the indices extend past the end of the index buffer")
        // Vertices come from the indices; only instance data is checked.
        check_vertices(&self.state, &self.tracked, 0, first_instance as u64 + instance_count as u64)
        if index_count == 0 || instance_count == 0 {
            return
        }
        if !self.tracked.recorded || !self.tracked.index_recorded {
            draw_hazards(device, &self.state, &mut self.encoder.hazards, &mut self.encoder.handle, true)
            self.tracked.recorded = true
            self.tracked.index_recorded = true
        }
        device.backend().draw_indexed(&mut self.encoder.handle, &mut self.state, index_count, instance_count, first_index, base_vertex, first_instance)
    }

    pub fn end(self) {}

    fn drop(&mut self) {
        device := self.encoder.device
        device.backend().end_render_pass(&mut self.encoder.handle)
    }
}

// A draw follows: barriers for its bindings, vertex buffers and, when
// `indexed`, index buffer. Backends run them before the pass.
fn draw_hazards(device: &Device, state: &hal.PassState, hazards: &mut Hazards, encoder: &mut hal.Handle, indexed: bool) {
    if hazards.off {
        return
    }
    before := 0u32
    after := 0u32
    binding_hazards(state, hazards, &mut before, &mut after)
    for i in 0usize..state.pipeline.vertex_buffer_count as usize {
        hazards.use_resource(state.vertex_a[i], hal.USE_VERTEX_INPUT, false, &mut before, &mut after)
    }
    if indexed {
        hazards.use_resource(state.index_a, hal.USE_INDEX, false, &mut before, &mut after)
    }
    if before != 0 {
        device.backend().barrier(encoder, before, after)
    }
}

fn check_vertices(state: &hal.PassState, tracked: &Tracked, vertices: u64, instances: u64) {
    pipeline := &state.pipeline
    for i in 0usize..pipeline.vertex_buffer_count as usize {
        assert((state.vertex_set >> i as u32 & 1) != 0, "a vertex buffer the pipeline reads is not set")
        count := vertices
        if pipeline.steps[i] == hal.STEP_INSTANCE {
            count = instances
        }
        if count != 0 && pipeline.extents[i] != 0 {
            needed := state.vertex_offset[i] + (count - 1) * pipeline.strides[i] as u64 + pipeline.extents[i] as u64
            assert(needed <= tracked.vertex_size[i], "the draw reads past the end of a vertex buffer")
        }
    }
}

fn index_size(format: u32) -> u64 {
    if format == hal.INDEX_UINT16 {
        return 2
    }
    return 4
}

// The bytes of `values` in native byte order, for write_buffer.
pub fn f32_bytes(values: &[f32]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 4, values)
    }
}
pub fn u32_bytes(values: &[u32]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 4, values)
    }
}
pub fn i32_bytes(values: &[i32]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 4, values)
    }
}
pub fn u16_bytes(values: &[u16]) -> &[u8] from(values) {
    unsafe {
        return ptr.borrow_slice(ptr.as_ptr(values) as *const u8, values.len * 2, values)
    }
}

// The bytes of `values` to fill with read_buffer. Any bytes make valid
// numbers of these types.
pub fn f32_bytes_mut(values: &mut[f32]) -> &mut[u8] from(values) {
    unsafe {
        return ptr.borrow_slice_mut(ptr.as_mut_ptr(values) as *mut u8, values.len * 4, values)
    }
}
pub fn u32_bytes_mut(values: &mut[u32]) -> &mut[u8] from(values) {
    unsafe {
        return ptr.borrow_slice_mut(ptr.as_mut_ptr(values) as *mut u8, values.len * 4, values)
    }
}
pub fn i32_bytes_mut(values: &mut[i32]) -> &mut[u8] from(values) {
    unsafe {
        return ptr.borrow_slice_mut(ptr.as_mut_ptr(values) as *mut u8, values.len * 4, values)
    }
}

// Hazard tracking. Every buffer and texture an encoder uses gets an entry,
// keyed by its handle's first word (textures with TEXTURE_KEY flipped, as
// OpenGL buffer and texture names overlap), holding the USE_* bits of its
// last write, the reads since then, and the uses that write was made
// visible to. Each encoder starts with empty entries: the backend orders
// it after earlier submissions as a whole.

unsafe extern "C" fn malloc(size: usize) -> *mut u8
unsafe extern "C" fn realloc(block: *mut u8, size: usize) -> *mut u8
unsafe extern "C" fn free(block: *mut u8)

const TEXTURE_KEY: u64 = 0x8000000000000000
const FIRST_CAPACITY: usize = 64
// Every USE_* bit, for a barrier against everything.
const ALL_USES: u32 = 0x7ff

// One resource's uses in an encoder; key 0 marks a free entry.
struct Entry {
    key: u64
    written: u32
    reads: u32
    visible: u32
}

struct Hazards {
    // Open addressing with linear probing, `capacity` entries in malloc'd
    // memory. The table is kept when cleared, for the next encoder.
    table: *mut Entry
    capacity: usize
    count: usize
    // Tracking is off (Metal, which tracks hazards itself).
    off: bool
    // Memory ran out: every use waits for everything before it.
    degraded: bool

    fn new(on: bool) -> Hazards {
        return Hazards { table: null_entries(), capacity: 0, count: 0, off: !on, degraded: false }
    }

    // Forget every entry, keeping the table.
    fn clear(&mut self) {
        if self.count != 0 {
            unsafe {
                ptr.write_bytes(self.table, 0u8, self.capacity)
            }
        }
        self.count = 0
        self.degraded = false
    }

    fn free(&mut self) {
        if self.capacity != 0 {
            unsafe {
                free(self.table as *mut u8)
            }
        }
        self.table = null_entries()
        self.capacity = 0
        self.count = 0
    }

    fn entries(&mut self) -> &mut[Entry] from(self) {
        unsafe {
            return ptr.borrow_slice_mut(self.table, self.capacity, self)
        }
    }

    // A command uses the resource `key` as `usage` says, writing it when
    // `write`: add the barrier it needs to `before` and `after`.
    fn use_resource(&mut self, key: u64, usage: u32, write: bool, before: &mut u32, after: &mut u32) {
        if self.off {
            return
        }
        found := self.find(key)
        if found == self.capacity {
            *before = ALL_USES
            *after = *after | usage
            return
        }
        entries := self.entries()
        entry := &mut entries[found]
        if entry.key != key {
            // First use in this encoder.
            entry.key = key
            entry.visible = 0
            if write {
                entry.written = usage
                entry.reads = 0
            } else {
                entry.written = 0
                entry.reads = usage
            }
            return
        }
        written := entry.written
        reads := entry.reads
        // Read after write, or write after write.
        if written != 0 && (write || (usage & ~entry.visible) != 0) {
            *before = *before | written
            *after = *after | usage
        }
        // Write after read.
        if write && reads != 0 {
            *before = *before | reads
            *after = *after | usage
        }
        if write {
            entry.written = usage
            entry.reads = 0
            entry.visible = 0
        } else {
            entry.reads = reads | usage
            if written != 0 {
                entry.visible = entry.visible | usage
            }
        }
    }

    // The index of `key`'s entry, or of the free entry it goes into;
    // `capacity` when memory ran out.
    fn find(&mut self, key: u64) -> usize {
        if self.degraded {
            return self.capacity
        }
        if (self.count + 1) * 2 > self.capacity && !self.grow() {
            self.degraded = true
            return self.capacity
        }
        mask := self.capacity - 1
        index := hash(key) & mask
        entries := self.entries()
        for {
            stored := entries[index].key
            if stored == key {
                return index
            }
            if stored == 0 {
                self.count += 1
                return index
            }
            index = (index + 1) & mask
        }
    }

    // Double the table (or make the first one); false when out of memory.
    fn grow(&mut self) -> bool {
        capacity := FIRST_CAPACITY
        if self.capacity != 0 {
            capacity = self.capacity * 2
        }
        table := unsafe {
            malloc(capacity * mem.size_of::<Entry>()) as *mut Entry
        }
        if ptr.is_null(table) {
            return false
        }
        unsafe {
            ptr.write_bytes(table, 0u8, capacity)
        }
        // The new table belongs to no one yet: a local owns the borrow.
        owner := 0u8
        bigger := unsafe {
            ptr.borrow_slice_mut(table, capacity, &mut owner)
        }
        old := unsafe {
            ptr.borrow_slice(self.table, self.capacity, self)
        }
        mask := capacity - 1
        for i in 0usize..old.len {
            key := old[i].key
            if key != 0 {
                index := hash(key) & mask
                for bigger[index].key != 0 {
                    index = (index + 1) & mask
                }
                bigger[index] = Entry { key: key, written: old[i].written, reads: old[i].reads, visible: old[i].visible }
            }
        }
        self.free_table()
        self.table = table
        self.capacity = capacity
        return true
    }

    fn free_table(&mut self) {
        if self.capacity != 0 {
            unsafe {
                free(self.table as *mut u8)
            }
        }
    }
}

fn null_entries() -> *mut Entry {
    return unsafe {
        0usize as *mut Entry
    }
}

// Handles are mostly aligned addresses: mix their higher bits down.
fn hash(key: u64) -> usize {
    return ((key >> 4) ^ (key >> 20) ^ (key >> 36) ^ (key >> 63)) as usize
}

// A growable array of plain values (without drop) in malloc'd memory, for
// the device's bookkeeping. Running out of memory panics.
struct Growing<T> {
    data: *mut T
    count: usize
    capacity: usize

    fn new() -> Growing<T> {
        return Growing { data: unsafe {
            0usize as *mut T
        }, count: 0, capacity: 0 }
    }

    fn len(&self) -> usize {
        return self.count
    }

    fn get(&self, index: usize) -> &T from(self) {
        assert(index < self.count, "index out of range")
        unsafe {
            return ptr.borrow(ptr.offset(self.data, index as isize), self)
        }
    }

    fn get_mut(&mut self, index: usize) -> &mut T from(self) {
        assert(index < self.count, "index out of range")
        unsafe {
            return ptr.borrow_mut(ptr.offset(self.data, index as isize), self)
        }
    }

    fn set(&mut self, index: usize, value: T) {
        assert(index < self.count, "index out of range")
        unsafe {
            ptr.write(ptr.offset(self.data, index as isize), value)
        }
    }

    fn push(&mut self, value: T) {
        if self.count == self.capacity {
            capacity := 16usize
            if self.capacity != 0 {
                capacity = self.capacity * 2
            }
            data := unsafe {
                realloc(self.data as *mut u8, capacity * mem.size_of::<T>()) as *mut T
            }
            assert(!ptr.is_null(data), "std/gpu ran out of memory")
            self.data = data
            self.capacity = capacity
        }
        unsafe {
            ptr.write(ptr.offset(self.data, self.count as isize), value)
        }
        self.count += 1
    }

    // Move element `source` to `to`, overwriting it.
    fn copy_within(&mut self, source: usize, to: usize) {
        assert(source < self.count && to < self.count, "index out of range")
        if source != to {
            unsafe {
                ptr.copy_nonoverlapping(ptr.offset(self.data, source as isize), ptr.offset(self.data, to as isize), 1)
            }
        }
    }

    fn truncate(&mut self, count: usize) {
        if count < self.count {
            self.count = count
        }
    }

    fn free(&mut self) {
        if self.capacity != 0 {
            unsafe {
                free(self.data as *mut u8)
            }
        }
        self.data = unsafe {
            0usize as *mut T
        }
        self.count = 0
        self.capacity = 0
    }
}

// The uses of the pipeline's bound slots by a draw or dispatch.
fn binding_hazards(state: &hal.PassState, hazards: &mut Hazards, before: &mut u32, after: &mut u32) {
    remaining := state.pipeline.slots
    for remaining != 0 {
        slot := hal.lowest_bit(remaining) as usize
        remaining = remaining & (remaining - 1)
        kind := state.pipeline.kinds[slot]
        stages := state.pipeline.stages[slot]
        usage := 0u32
        if (stages & hal.STAGE_VERTEX) != 0 {
            usage = usage | hal.USE_VERTEX_READ
        }
        if (stages & hal.STAGE_FRAGMENT) != 0 {
            usage = usage | hal.USE_FRAGMENT_READ
        }
        if (stages & hal.STAGE_COMPUTE) != 0 {
            usage = usage | hal.USE_COMPUTE_READ
        }
        writable := kind == hal.BINDING_STORAGE_BUFFER || kind == hal.BINDING_STORAGE_TEXTURE
        if writable {
            // Vertex shaders never write (see check_bindings).
            if (stages & hal.STAGE_FRAGMENT) != 0 {
                usage = usage | hal.USE_FRAGMENT_WRITE
            }
            if (stages & hal.STAGE_COMPUTE) != 0 {
                usage = usage | hal.USE_COMPUTE_WRITE
            }
        }
        key := state.object_a[slot]
        if state.bound[slot] != hal.BOUND_BUFFER {
            key = key ^ TEXTURE_KEY
        }
        hazards.use_resource(key, usage, writable, before, after)
    }
}

// How a Surface presents. Surface.create uses the defaults: vsync on, two
// frames in flight.
pub struct SurfaceOptions {
    // Wait for the display's refresh to show each frame (no tearing).
    pub vsync: bool
    // How many frames the CPU may record before the GPU has finished the
    // oldest: 2 or 3. More hides GPU latency, fewer cuts input lag.
    pub frames_in_flight: u32

    pub fn default() -> SurfaceOptions {
        return SurfaceOptions { vsync: true, frames_in_flight: 2 }
    }
}

// The images a window shows. Each frame, acquire() a Frame, render into
// its texture() and present() it.
//
// On Vulkan the surface is a swapchain (VK_KHR_xcb_surface on Linux,
// VK_KHR_win32_surface on Windows), on Metal the view's CAMetalLayer (the
// one Window.metal_layer() made, or a new one), and on OpenGL a texture
// copied into the window by the window's own context, which needs a device
// from Device.open_for_window. The images have format(), an 8-bit sRGB
// format, and usages TEXTURE_RENDER, TEXTURE_COPY_SRC and TEXTURE_COPY_DST.
//
// Call resize() with the window's size in pixels whenever it changes
// (window.Event.Resize). The window must stay open while the surface
// exists; use both from the thread that opened the window.
pub struct Surface {
    device: &Device
    handle: hal.Handle
    config: hal.SurfaceConfig

    // A surface for `native`'s window, `width` by `height` pixels, with
    // the default SurfaceOptions. Fails with Unsupported when the device
    // cannot present to this window, as an OpenGL device not opened for it
    // with Device.open_for_window, or a Vulkan device on macOS (use Metal).
    pub fn create(device: &Device, native: &handle.NativeHandle, width: u32, height: u32) -> Surface!Error from(device) {
        return Surface.create_with(device, native, width, height, SurfaceOptions.default())
    }

    pub fn create_with(device: &Device, native: &handle.NativeHandle, width: u32, height: u32, options: SurfaceOptions) -> Surface!Error from(device) {
        if options.frames_in_flight < 2 || options.frames_in_flight > 3 || width > device.limits.max_texture_size || height > device.limits.max_texture_size {
            return err(Error.InvalidInput)
        }
        handle := device.backend().create_surface(native)?
        surface := Surface { device: device, handle: handle, config: hal.SurfaceConfig { width: width, height: height, vsync: options.vsync, frames: options.frames_in_flight, format: hal.FORMAT_NONE } }
        surface.configure()?
        return ok(surface)
    }

    // The format of the images: FORMAT_BGRA8_UNORM_SRGB or
    // FORMAT_RGBA8_UNORM_SRGB. Render pipelines drawing into them use it.
    pub fn format(&self) -> u32 {
        return self.config.format
    }
    // The images' size in pixels, which can differ from the one asked for
    // where the window system decides.
    pub fn width(&self) -> u32 {
        return self.config.width
    }
    pub fn height(&self) -> u32 {
        return self.config.height
    }

    // Make the images `width` by `height` pixels, the window's new size.
    // A size of 0, as for a minimized window, makes acquire() fail with
    // Outdated until the next resize.
    pub fn resize(&mut self, width: u32, height: u32) -> void!Error {
        limit := self.device.limits.max_texture_size
        if width > limit || height > limit {
            return err(Error.InvalidInput)
        }
        self.config.width = width
        self.config.height = height
        return self.configure()
    }

    pub fn set_vsync(&mut self, vsync: bool) -> void!Error {
        self.config.vsync = vsync
        return self.configure()
    }

    // Wait for the next image, at most frames_in_flight frames after the
    // oldest one the GPU is still working on. Fails with Outdated when the
    // window's size changed in a way the surface could not follow by
    // itself; resize() it then.
    pub fn acquire(&mut self) -> Frame!Error from(self) {
        device := self.device
        texture := hal.Handle.null()
        if self.config.width == 0 || self.config.height == 0 {
            return err(Error.Outdated)
        }
        index := match device.backend().acquire(&mut self.handle, &mut texture) {
            ok(index) => index,
            err(Error.Outdated) => {
                // Rebuild for the window's current size and try once more.
                configure_surface(device, &mut self.handle, &mut self.config)?
                if self.config.width == 0 || self.config.height == 0 {
                    return err(Error.Outdated)
                }
                device.backend().acquire(&mut self.handle, &mut texture)?
            }
            err(error) => {
                return err(error)
            }
        }
        device.note_submission(index)
        descriptor := hal.TextureDescriptor.new(self.config.width, self.config.height, self.config.format, hal.TEXTURE_RENDER | hal.TEXTURE_COPY_SRC | hal.TEXTURE_COPY_DST)
        image := Texture { device: device, handle: texture, descriptor: descriptor, external: true }
        return ok(Frame { surface: self, texture: image, presented: false })
    }

    fn configure(&mut self) -> void!Error {
        return configure_surface(self.device, &mut self.handle, &mut self.config)
    }

    fn drop(&mut self) {
        device := self.device
        hal.ignore(device.finish())
        device.backend().destroy_surface(&self.handle)
    }
}

// Wait for the GPU, then make a surface's images for its settings.
fn configure_surface(device: &Device, surface: &mut hal.Handle, config: &mut hal.SurfaceConfig) -> void!Error {
    device.finish()?
    return device.backend().configure_surface(surface, config)
}

// One image of a Surface, to render into and present. Dropping a frame
// without present() presents it anyway.
pub struct Frame {
    surface: &mut Surface
    texture: Texture
    presented: bool

    // The image: a color attachment or copy destination of the surface's
    // format and size.
    pub fn texture(&self) -> &Texture from(self) {
        return &self.texture
    }

    // Show the image once every submission so far has finished drawing it.
    pub fn present(self) -> void!Error {
        self.presented = true
        return self.show()
    }

    fn show(&mut self) -> void!Error {
        device := self.surface.device
        device.flush()?
        index := device.backend().present(&mut self.surface.handle)?
        device.note_submission(index)
        device.collect()
        return ok()
    }

    fn drop(&mut self) {
        if !self.presented {
            self.presented = true
            hal.ignore(self.show())
        }
    }
}
