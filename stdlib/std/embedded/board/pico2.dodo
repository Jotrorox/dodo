package pico2

import "std/embedded/hal"
import "std/embedded/chip/rp2350"
import "std/embedded/chip/rp_dma"
import "std/embedded/chip/rp_flash"
import "std/embedded/chip/rp_multicore"
import "std/embedded/chip/rp_usb"
import "std/embedded/chip/rp_watchdog"

// Raspberry Pi Pico 2: an RP2350A with a 12 MHz crystal, 4 MiB of flash, and
// a green user LED on GP25. Build with `board = "pico2"` and import this
// package as `std/embedded/board`, so the program also builds for other
// boards:
//
//     import "std/embedded/board"
//
//     fn main() {
//         b := board.take()!
//         for {
//             b.led.toggle()
//             b.timer.delay_ms(500)
//         }
//     }
//
// It follows the board contract described in std/embedded/hal. GP0 to GP22 and
// GP26 to GP28 are on the header; GP23 (power-supply mode), GP24 (VBUS sense),
// and GP29 (VSYS/3 on ADC3) are wired on the board. The Pico 2 W wires its LED
// to the wireless chip instead and needs its own board package.

pub const NAME: &str = "Raspberry Pi Pico 2"
pub const LED_PIN: u32 = 25
pub const CRYSTAL_HZ: u32 = 12_000_000

// The usual bus pins, as in the Pico SDK and Raspberry Pi's pinout diagrams:
// I2C0 on GP4 (SDA) and GP5 (SCL), SPI0 on GP16 (RX), GP18 (clock), and GP19
// (TX), with GP17 free for a chip select, and UART0 on GP0 (TX) and GP1 (RX),
// where the Raspberry Pi Debug Probe's UART connects:
//
//     i2c := b.pins.i2c(I2C_SDA_PIN, I2C_SCL_PIN, hal.I2C_FAST_HZ)!
//     serial := b.pins.uart(UART_TX_PIN, some(UART_RX_PIN), 115_200)!
pub const I2C_SDA_PIN: u32 = 4
pub const I2C_SCL_PIN: u32 = 5
pub const SPI_RX_PIN: u32 = 16
pub const SPI_SELECT_PIN: u32 = 17
pub const SPI_CLOCK_PIN: u32 = 18
pub const SPI_TX_PIN: u32 = 19
pub const UART_TX_PIN: u32 = 0
pub const UART_RX_PIN: u32 = 1

pub struct Board {
    // The user LED, an output pin that is on when high.
    pub led: rp2350.Pin
    // The remaining GPIOs, and the I2C, SPI, and UART ports on them; GP25 is
    // already taken by `led`.
    pub pins: rp2350.Pins
    // The 1 MHz system timer: delay_us, delay_ms, and now_us.
    pub timer: rp2350.Timer
    // The watchdog, stopped until `start(timeout_ms)`: it then resets the
    // board unless `feed()` is called in time; see
    // std/embedded/chip/rp_watchdog.
    pub watchdog: rp_watchdog.Watchdog
    // The USB port: `serial()` makes the board a USB serial port, for
    // printing over the USB cable.
    pub usb: Usb
    // The DMA channels: `channel()` claims one, for transfers that run
    // while the program does other work.
    pub dma: rp_dma.Dma
    // The second core, `start`ed with a task of its own, and the FIFOs and
    // spinlocks the two cores share; see std/embedded/chip/rp_multicore.
    pub core1: rp_multicore.Core1
    pub fifos: rp_multicore.Fifos
    pub spinlocks: rp_multicore.Spinlocks
    // The program flash: the free flash above `flash.program_end()` keeps
    // data across restarts and reflashing, for example a
    // std/embedded/storage key-value store; see std/embedded/chip/rp_flash.
    pub flash: rp_flash.Flash
}

// Start the chip with the Pico 2's crystal and claim the LED. A second call
// returns hal.Error.Busy.
pub fn take() -> Board!hal.Error {
    chip := rp2350.take(rp2350.Config { crystal_hz: CRYSTAL_HZ })?
    led := chip.pins.output(LED_PIN)?
    let rp2350.Peripherals { pins, timer, watchdog, usb, dma, core1, fifos, spinlocks, flash } = chip
    return ok(Board { led, pins, timer, watchdog, usb: Usb { usb }, dma, core1, fifos, spinlocks, flash })
}

// The USB port, as `b.usb`.
pub struct Usb {
    usb: rp2350.Usb

    // Make the board a USB serial port named after it, with rp_usb's
    // default identity, for printing and reading over the USB cable;
    // rp_usb documents the port. After a restart into the bootloader
    // through the port, as `dodo run` does,
    // the LED lights while the bootloader's drive is accessed. Busy if a port is open.
    pub fn serial(&mut self) -> rp_usb.Serial!hal.Error {
        return self.usb.serial_with(rp_usb.default_identity(NAME), LED_PIN)
    }

    // `serial`, with the `identity` the host sees in place of the default:
    // the vendor and product IDs and strings of a product of your own.
    // `dodo run` finds only the default IDs, so a board with others needs
    // BOOTSEL held to flash it.
    pub fn serial_with(&mut self, identity: rp_usb.Identity) -> rp_usb.Serial!hal.Error {
        return self.usb.serial_with(identity, LED_PIN)
    }

    // Give back the port: the board disconnects from the host.
    pub fn release_serial(&mut self, serial: rp_usb.Serial) {
        self.usb.release_serial(serial)
    }
}

// Write a failed check's message to every serial port claimed from
// `b.pins.uart` and to the USB serial port, as the default panic hook does
// before it halts. For a panic
// hook of your own, for example one that restarts into the bootloader so
// `dodo run` works again without pressing BOOTSEL:
//
//     extern "C" fn dodo_board_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
//         unsafe {
//             board.report_panic(check, file, line, column)
//         }
//         board.reboot_to_bootloader()
//     }
//
// SAFETY: `check` and `file` must be the hook's NUL-terminated strings, and
// the caller must halt or reset afterwards, as this takes over the ports.
pub unsafe fn report_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
    unsafe {
        rp2350.report_panic(check, file, line, column)
    }
}

// Restart into the USB bootloader, as if BOOTSEL were held at power-up: the
// Pico 2 reappears as the RP2350 drive, ready for `dodo run`. The LED shows
// drive activity on chip revisions after A2. Does not return.
pub fn reboot_to_bootloader() {
    rp2350.reboot_to_bootloader(LED_PIN)
}
