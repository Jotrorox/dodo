package esp_i2c

import "std/embedded/hal"

// The I2C controller of Espressif's RISC-V chips (I2C0 of the ESP32-C6, and
// the same controller in the ESP32-C3, C5, H2, and others), as a bus
// master. `Controller` implements the std/embedded/hal I2C bus protocol over
// any hal.Registers: a `hal.RegisterBlock` on the chip, or a simulated
// controller in a desktop test, so device drivers use it unchanged.
//
// The controller runs a list of up to eight commands (start, write bytes,
// read bytes, stop, end) from its own registers and moves the bytes through
// a 32-byte FIFO, so each transaction is queued whole and the driver only
// waits for it. Longer transfers are split into runs that end with an END
// command, which holds the bus with SCL low until the next run, so the
// device sees one transaction.
//
// Chip packages enable the controller's clock, route SDA and SCL as
// open-drain lines through the GPIO matrix, and pass the frequency of its
// function clock. Errors: NoAcknowledge when no device answers its address
// or a device refuses a data byte, Bus when another master won arbitration,
// and Timeout when a device holds SCL low for too long or the controller
// does not finish; the controller's state machine is reset after each, so
// the next transaction starts afresh.
//
// Register names follow the ESP32-C6 technical reference manual (I2C
// Controller).

const SCL_LOW_PERIOD: usize = 0x00
// CTR: lines driven open-drain, master mode, start, clock on, reset the
// state machine, latch the configuration.
const CTR: usize = 0x04
const MASTER: u32 = 1 << 4
const TRANS_START: u32 = 1 << 5
const CLOCK_ON: u32 = 1 << 8
const FSM_RESET: u32 = 1 << 10
const CONF_UPDATE: u32 = 1 << 11
// The reset value's receive-FIFO-full acknowledge level, kept.
const RX_FULL_ACK_LEVEL: u32 = 1 << 3
// SR: the bus is busy, and bytes in the receive FIFO.
const SR: usize = 0x08
const BUS_BUSY: u32 = 1 << 4
const RX_COUNT: u32 = 0x3F << 8
// TO: give up when SCL stays in one state for 2^value function clock
// cycles: 2^22, 105 ms at 40 MHz.
const TO: usize = 0x0C
const TIMEOUT_ENABLE: u32 = 1 << 5
const TIMEOUT_EXPONENT: u32 = 22
// FIFO_CONF: reset both FIFOs, with the reset value's thresholds and FIFO
// pointer protection.
const FIFO_CONF: usize = 0x18
const FIFO_RESET: u32 = 0x7101
const FIFO_RUN: u32 = 0x4101
const DATA: usize = 0x1C
const INT_RAW: usize = 0x20
const INT_CLR: usize = 0x24
const INT_ENA: usize = 0x28
const END_DETECT: u32 = 1 << 3
const ARBITRATION_LOST: u32 = 1 << 5
const TRANS_COMPLETE: u32 = 1 << 7
const TIME_OUT: u32 = 1 << 8
const NACK: u32 = 1 << 10
const SCL_STATE_TIMEOUT: u32 = 1 << 13
const SCL_MAIN_TIMEOUT: u32 = 1 << 14
const ALL_INTERRUPTS: u32 = 0x3_FFFF
const TIMEOUTS: u32 = TIME_OUT | SCL_STATE_TIMEOUT | SCL_MAIN_TIMEOUT
const SDA_HOLD: usize = 0x30
const SDA_SAMPLE: usize = 0x34
// SCL_HIGH_PERIOD: the high time, and from bit 9 the time to wait for SCL
// to rise before counting it.
const SCL_HIGH_PERIOD: usize = 0x38
const SCL_START_HOLD: usize = 0x40
const SCL_RSTART_SETUP: usize = 0x44
const SCL_STOP_HOLD: usize = 0x48
const SCL_STOP_SETUP: usize = 0x4C
// FILTER_CFG: ignore pulses shorter than 7 function clock cycles on both
// lines.
const FILTER_CFG: usize = 0x50
const FILTERS: u32 = 0x377
const COMMANDS: usize = 0x58
const COMMAND_DONE: u32 = 1 << 31
// SCL_ST_TIME_OUT, SCL_MAIN_ST_TIME_OUT: the state machines' own limits,
// at their largest.
const SCL_ST_TIME_OUT: usize = 0x78
const SCL_MAIN_ST_TIME_OUT: usize = 0x7C
const STATE_TIMEOUT: u32 = 23
// SCL_SP_CONF: send SCL pulses, from bit 1 how many, to free a device that
// holds SDA low; the enable clears itself when they are out.
const SCL_SP_CONF: usize = 0x80
const SCL_PULSES: u32 = 1 << 0
const NINE_PULSES: u32 = 9 << 1

// Commands: the operation from bit 11, the byte count, whether the
// device's acknowledges are checked, and the acknowledge sent after reads.
const OP_WRITE: u32 = 1 << 11
const OP_STOP: u32 = 2 << 11
const OP_READ: u32 = 3 << 11
const OP_END: u32 = 4 << 11
const OP_RSTART: u32 = 6 << 11
const ACK_CHECK: u32 = 1 << 8
const SEND_NACK: u32 = 1 << 10

// Bytes in the FIFO, and the most one command moves.
pub const FIFO_DEPTH: usize = 32
const CHUNK: usize = 31

// Status polls before a transaction that does not end is abandoned: far
// longer than the controller's own timeouts.
const POLLS: u32 = 5_000_000
// Status polls for the bus to go idle before it is cleared: about a
// millisecond, many bit times at 1 kHz.
const IDLE_POLLS: u32 = 100_000

// The bus timing for one SCL frequency, from `timing`.
pub struct Timing {
    // The function clock it counts.
    pub clock_hz: u32
    // Half an SCL period in function clock cycles.
    pub half_cycle: u32
    // The resulting SCL frequency.
    pub frequency_hz: u32
}

// The timing for an SCL frequency of `frequency_hz` from a function clock
// of `clock_hz`. InvalidInput above hal.I2C_FAST_PLUS_HZ, or where half a
// period does not fit the controller's counters (below clock_hz / 1022, or
// above clock_hz / 20); a chip package divides the clock first for slower
// buses.
pub fn timing(clock_hz: u32, frequency_hz: u32) -> Timing!hal.Error {
    if frequency_hz == 0 || frequency_hz > hal.I2C_FAST_PLUS_HZ {
        return err(hal.Error.InvalidInput)
    }
    half := clock_hz / frequency_hz / 2
    if half < 10 || half > 511 {
        return err(hal.Error.InvalidInput)
    }
    return ok(Timing { clock_hz, half_cycle: half, frequency_hz: clock_hz / (2 * half) })
}

// The function clock divider a chip package sets for `frequency_hz` from
// its source clock: the smallest that keeps half a period within the
// counters.
pub fn prescaler(source_hz: u32, frequency_hz: u32) -> u32 {
    if frequency_hz == 0 {
        return 1
    }
    return source_hz / (frequency_hz * 1024) + 1
}

// An I2C bus master on one controller with registers R. Implements the
// std/embedded/hal I2C bus protocol.
pub struct Controller<R: hal.Registers>: hal.I2c {
    registers: R
    timing: Timing
    // Commands queued for the next run, and how many.
    commands: [8]u32
    count: usize

    // Configure a controller fresh out of reset as a master at the SCL
    // frequency of `timing`.
    pub fn new(registers: R, timing: Timing) -> Controller<R> {
        bus := Controller<R> { registers, timing, commands: [0u32; 8], count: 0 }
        bus.registers.write(CTR, MASTER | CLOCK_ON | RX_FULL_ACK_LEVEL)
        bus.registers.write(INT_ENA, 0)
        bus.registers.write(FILTER_CFG, FILTERS)
        bus.registers.write(TO, TIMEOUT_ENABLE | TIMEOUT_EXPONENT)
        bus.registers.write(SCL_ST_TIME_OUT, STATE_TIMEOUT)
        bus.registers.write(SCL_MAIN_ST_TIME_OUT, STATE_TIMEOUT)
        bus.configure()
        // Start from a reset state machine, as after a failed transaction.
        bus.registers.write(CTR, MASTER | CLOCK_ON | RX_FULL_ACK_LEVEL | FSM_RESET)
        bus.reset()
        return bus
    }

    // The SCL frequency, the closest the controller makes to the request.
    pub fn frequency_hz(&self) -> u32 {
        return self.timing.frequency_hz
    }

    // Change the SCL frequency, from the same function clock.
    pub fn set_frequency(&mut self, frequency_hz: u32) -> void!hal.Error {
        self.timing = timing(self.timing.clock_hz, frequency_hz)?
        self.configure()
        return ok()
    }

    // Change the timing, for a chip package that changes the function
    // clock too.
    pub fn set_timing(&mut self, settings: Timing) {
        self.timing = settings
        self.configure()
    }

    pub fn write(&mut self, address: u8, bytes: &[u8]) -> void!hal.Error {
        empty: [0]u8 = []
        return self.transfer(address_header(address)?, 0, false, bytes, &mut empty)
    }

    pub fn read(&mut self, address: u8, buffer: &mut[u8]) -> void!hal.Error {
        empty: [0]u8 = []
        return self.transfer(address_header(address)?, 0, false, &empty, buffer)
    }

    // Write `bytes`, then read `buffer.len` bytes after a repeated start,
    // without releasing the bus.
    pub fn write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        return self.transfer(address_header(address)?, 0, false, bytes, buffer)
    }

    // The 10-bit address forms: InvalidInput above 0x3FF.
    pub fn write_ten_bit(&mut self, address: u16, bytes: &[u8]) -> void!hal.Error {
        empty: [0]u8 = []
        return self.transfer(ten_bit_header(address)?, (address & 0xFF) as u8, true, bytes, &mut empty)
    }

    pub fn read_ten_bit(&mut self, address: u16, buffer: &mut[u8]) -> void!hal.Error {
        empty: [0]u8 = []
        return self.transfer(ten_bit_header(address)?, (address & 0xFF) as u8, true, &empty, buffer)
    }

    pub fn write_read_ten_bit(&mut self, address: u16, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        return self.transfer(ten_bit_header(address)?, (address & 0xFF) as u8, true, bytes, buffer)
    }

    // Whether a device answers `address`: its address, then a stop, with no
    // data.
    pub fn probe(&mut self, address: u8) -> bool!hal.Error {
        nothing: [0]u8 = []
        empty: [0]u8 = []
        match self.transfer(address_header(address)?, 0, false, &nothing, &mut empty) {
            ok() => {
                return ok(true)
            }
            err(error) => {
                if error == hal.Error.NoAcknowledge {
                    return ok(false)
                }
                return err(error)
            }
        }
    }

    // Give back the registers, with the controller stopped.
    pub fn release(self) -> R {
        self.registers.write(INT_ENA, 0)
        self.registers.write(CTR, FSM_RESET)
        let Controller { registers, timing, commands, count } = self
        return registers
    }

    // One transaction: a start and the address (`header`, and `low` after
    // it for a 10-bit address), `bytes` written, then after a repeated
    // start `buffer` read, and a stop. A transaction without bytes or reads
    // only addresses the device.
    fn transfer(&mut self, header: u8, low: u8, ten_bit: bool, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        match self.run_transfer(header, low, ten_bit, bytes, buffer) {
            ok() => {
                return ok()
            }
            err(error) => {
                self.recover()
                return err(error)
            }
        }
    }

    fn run_transfer(&mut self, header: u8, low: u8, ten_bit: bool, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        self.wait_idle()
        reading := buffer.len > 0
        writing := bytes.len > 0 || !reading
        if writing {
            // The address, as a write, and the bytes, CHUNK at a time.
            self.begin()
            self.add(OP_RSTART)
            self.push(header << 1)
            address_bytes := 1u32
            if ten_bit {
                self.push(low)
                address_bytes = 2
            }
            sent := 0usize
            first := bytes.len
            if first > CHUNK - address_bytes as usize {
                first = CHUNK - address_bytes as usize
            }
            for index in 0..first {
                self.push(bytes[index])
            }
            self.add(OP_WRITE | ACK_CHECK | (address_bytes + first as u32))
            sent = first
            for {
                last := sent == bytes.len
                if last && !reading {
                    self.add(OP_STOP)
                } else {
                    self.add(OP_END)
                }
                self.execute()?
                if last {
                    break
                }
                count := bytes.len - sent
                if count > CHUNK {
                    count = CHUNK
                }
                self.begin()
                for index in 0..count {
                    self.push(bytes[sent + index])
                }
                self.add(OP_WRITE | ACK_CHECK | count as u32)
                sent += count
            }
        }
        if !reading {
            return ok()
        }
        // A (repeated) start and the address as a read; a 10-bit address
        // repeats only its header.
        self.begin()
        self.add(OP_RSTART)
        if ten_bit && !writing {
            // A 10-bit read starts with the whole address as a write.
            self.push(header << 1)
            self.push(low)
            self.add(OP_WRITE | ACK_CHECK | 2)
            self.add(OP_RSTART)
        }
        self.push((header << 1) | 1)
        self.add(OP_WRITE | ACK_CHECK | 1)
        received := 0usize
        for {
            count := buffer.len - received
            last := count <= CHUNK
            if !last {
                count = CHUNK
            }
            if last {
                // Acknowledge all but the final byte, which ends the read.
                if count > 1 {
                    self.add(OP_READ | (count as u32 - 1))
                }
                self.add(OP_READ | SEND_NACK | 1)
                self.add(OP_STOP)
            } else {
                self.add(OP_READ | count as u32)
                self.add(OP_END)
            }
            self.execute()?
            if hal.decode(RX_COUNT, self.registers.read(SR)) < count as u32 {
                return err(hal.Error.Bus)
            }
            for index in 0..count {
                buffer[received + index] = (self.registers.read(DATA) & 0xFF) as u8
            }
            received += count
            if last {
                return ok()
            }
            self.begin()
        }
    }

    // Start a run: empty the FIFOs and the command list.
    fn begin(&mut self) {
        self.registers.write(INT_CLR, ALL_INTERRUPTS)
        self.registers.write(FIFO_CONF, FIFO_RESET)
        self.registers.write(FIFO_CONF, FIFO_RUN)
        self.count = 0
    }

    fn push(&mut self, byte: u8) {
        self.registers.write(DATA, byte as u32)
    }

    fn add(&mut self, command: u32) {
        self.commands[self.count] = command
        self.count += 1
    }

    // Run the queued commands and wait until they are done or fail.
    fn execute(&mut self) -> void!hal.Error {
        for index in 0..8usize {
            command := 0u32
            if index < self.count {
                command = self.commands[index]
            }
            self.registers.write(COMMANDS + 4 * index, command)
        }
        control := self.registers.read(CTR)
        self.registers.write(CTR, control | CONF_UPDATE)
        self.registers.write(CTR, control | TRANS_START)
        for _ in 0..POLLS {
            raw := self.registers.read(INT_RAW)
            if (raw & NACK) != 0 {
                // The controller still ends the transaction on the bus,
                // with the stop that follows; let it, or its completion
                // would land in the next transaction.
                self.finish()
                return err(hal.Error.NoAcknowledge)
            }
            if (raw & ARBITRATION_LOST) != 0 {
                return err(hal.Error.Bus)
            }
            if (raw & TIMEOUTS) != 0 {
                return err(hal.Error.Timeout)
            }
            if (raw & (TRANS_COMPLETE | END_DETECT)) != 0 {
                return self.check_done()
            }
        }
        return err(hal.Error.Timeout)
    }

    // Wait until the running commands end, after a failure.
    fn finish(&mut self) {
        for _ in 0..IDLE_POLLS {
            if (self.registers.read(INT_RAW) & (TRANS_COMPLETE | END_DETECT | TIMEOUTS)) != 0 {
                return
            }
        }
    }

    // Every queued command up to the stop or end ran.
    fn check_done(&mut self) -> void!hal.Error {
        for index in 0..self.count {
            command := self.commands[index]
            if (self.registers.read(COMMANDS + 4 * index) & COMMAND_DONE) == 0 {
                return err(hal.Error.Bus)
            }
            if command == OP_STOP || command == OP_END {
                return ok()
            }
        }
        return ok()
    }

    // Reset the state machine after a failed transaction, so the next one
    // starts afresh; the controller sends a stop if it held the bus.
    fn recover(&mut self) {
        control := self.registers.read(CTR)
        self.registers.write(CTR, control | FSM_RESET)
        self.reset()
        self.wait_idle()
    }

    // Wait until the bus is idle: the controller finishes a stop it is
    // sending after a failed transaction. A bus that stays busy, as when a
    // device holds SDA low, gets nine SCL pulses and a stop, which free it.
    fn wait_idle(&mut self) {
        for _ in 0..IDLE_POLLS {
            if (self.registers.read(SR) & BUS_BUSY) == 0 {
                return
            }
        }
        self.registers.write(SCL_SP_CONF, NINE_PULSES | SCL_PULSES)
        control := self.registers.read(CTR)
        self.registers.write(CTR, control | CONF_UPDATE)
        for _ in 0..IDLE_POLLS {
            if (self.registers.read(SCL_SP_CONF) & SCL_PULSES) == 0 {
                break
            }
        }
        self.registers.write(SCL_SP_CONF, 0)
        self.registers.write(CTR, control | FSM_RESET)
    }

    fn reset(&mut self) {
        self.registers.write(INT_CLR, ALL_INTERRUPTS)
        self.registers.write(FIFO_CONF, FIFO_RESET)
        self.registers.write(FIFO_CONF, FIFO_RUN)
        for index in 0..8usize {
            self.registers.write(COMMANDS + 4 * index, 0)
        }
    }

    // Write the timing registers for `self.timing` and latch them.
    fn configure(&mut self) {
        half := self.timing.half_cycle
        wait_high := half / 4
        if self.timing.frequency_hz >= 80_000 {
            wait_high = half / 2 - 2
        }
        self.registers.write(SCL_LOW_PERIOD, half - 1)
        self.registers.write(SCL_HIGH_PERIOD, (half - wait_high) | (wait_high << 9))
        self.registers.write(SDA_HOLD, half / 4 - 1)
        self.registers.write(SDA_SAMPLE, half / 2 - 1)
        self.registers.write(SCL_RSTART_SETUP, half - 1)
        self.registers.write(SCL_STOP_SETUP, half - 1)
        self.registers.write(SCL_START_HOLD, half - 1)
        self.registers.write(SCL_STOP_HOLD, half - 1)
        control := self.registers.read(CTR)
        self.registers.write(CTR, control | CONF_UPDATE)
    }
}

// A 7-bit address; InvalidInput above 0x7F.
fn address_header(address: u8) -> u8!hal.Error {
    if address > 0x7F {
        return err(hal.Error.InvalidInput)
    }
    return ok(address)
}

// The first byte of a 10-bit address, 0b11110 and its top two bits, before
// the read/write bit; InvalidInput above 0x3FF.
fn ten_bit_header(address: u16) -> u8!hal.Error {
    if address > 0x3FF {
        return err(hal.Error.InvalidInput)
    }
    return ok((0x78 | (address >> 8)) as u8)
}
