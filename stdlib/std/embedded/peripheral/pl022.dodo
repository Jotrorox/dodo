package pl022

import "core/cpu"
import "core/ptr"
import "std/embedded/hal"

// The Arm PrimeCell PL022 synchronous serial port, as an SPI bus master or
// as a target (slave) that a master clocks. Chip vendors license this
// controller, so the same registers appear in many microcontrollers, among
// them the RP2040 and RP2350 (SPI0 and SPI1). `Controller` implements
// hal.Spi over any hal.Registers: a `hal.RegisterBlock` on the chip, or a
// simulated controller in a desktop test. `Target` answers another master.
//
// Chip packages pulse the controller's reset, route its pins, and pass the
// frequency of the clock that feeds it. Frames start as 8 bits, most
// significant bit first, in the Motorola SPI format with the hal.SpiMode
// given; `set_frame_bits` chooses 4 to 16 bits and `set_frame_format` the
// Texas Instruments synchronous serial or National Microwire formats. The
// byte methods of the hal protocol need frames of at most 8 bits; the word
// methods (`transfer_words`, `write_words`) carry any size. Transfers keep
// both 8-entry FIFOs busy, so frames follow each other without gaps, and
// never queue more than the receive FIFO holds, so no frame is lost.
// `Bus.dma` hands out a `DmaBus`, whose transfers run by DMA while the
// program does other work.
//
// Chip select is usually left to a GPIO and hal.SpiDevice: in modes 0 and 2
// the PL022's own frame signal rises between every two frames, which most
// devices take as the end of a command. The TI and Microwire formats need
// that frame signal, so chip packages can route it to a pin as well. As the
// master generates the clock itself, a transfer always completes and SPI
// operations never time out.
//
// Register names follow the PrimeCell PL022 technical reference manual, as
// reproduced in the RP2040 datasheet (4.4.4).

const CR0: usize = 0x000
const CR1: usize = 0x004
const DR: usize = 0x008
const SR: usize = 0x00C
const CPSR: usize = 0x010
const IMSC: usize = 0x014
const RIS: usize = 0x018
const ICR: usize = 0x020
const DMACR: usize = 0x024

// CR0: data size minus one, frame format, clock polarity and phase, and the
// serial clock rate divisor minus one.
const DATA_SIZE: u32 = 0b1111
const FRAME_FORMAT: u32 = 0b11 << 4
const CLOCK_POLARITY: u32 = 1 << 6
const CLOCK_PHASE: u32 = 1 << 7
const CLOCK_RATE: u32 = 0xFF << 8

// CR1: internal loopback, port enable, target (slave) mode, and the
// target's output disabled.
const LOOPBACK: u32 = 1 << 0
const PORT_ENABLE: u32 = 1 << 1
const TARGET_MODE: u32 = 1 << 2
const TARGET_OUTPUT_DISABLE: u32 = 1 << 3

// SR.
const TX_NOT_FULL: u32 = 1 << 1
const RX_NOT_EMPTY: u32 = 1 << 2
const BUSY: u32 = 1 << 4

// RIS and ICR: the receive FIFO overflowed.
const RX_OVERRUN: u32 = 1 << 0

// DMACR: raise DMA requests for the receive and transmit FIFOs.
const RX_DMA: u32 = 1 << 0
const TX_DMA: u32 = 1 << 1

// Entries in each FIFO.
const FIFO_DEPTH: usize = 8

// The frame sizes the controller supports, in bits.
pub const MIN_FRAME_BITS: u32 = 4
pub const MAX_FRAME_BITS: u32 = 16

// How frames look on the wire.
pub enum FrameFormat {
    // Motorola SPI, the usual format, with the clock polarity and phase of
    // the bus's hal.SpiMode. The frame signal stays low during a frame.
    Motorola,
    // Texas Instruments synchronous serial: the frame signal pulses high
    // for one clock before each frame, and data changes on rising edges
    // and is sampled on falling ones. The SpiMode does not apply.
    TexasInstruments,
    // National Microwire, half duplex: the master sends an 8-bit control
    // word, waits one clock, and receives a frame of the configured size
    // while the frame signal stays low. Words sent carry the control word
    // in their low 8 bits. The SpiMode does not apply.
    Microwire
}

// CR0's frame format field for `format`.
fn frame_format(format: FrameFormat) -> u32 {
    match format {
        FrameFormat.Motorola => {
            return 0
        }
        FrameFormat.TexasInstruments => {
            return hal.encode(FRAME_FORMAT, 1)
        }
        FrameFormat.Microwire => {
            return hal.encode(FRAME_FORMAT, 2)
        }
    }
}

fn check_frame_bits(bits: u32) -> void!hal.Error {
    if bits < MIN_FRAME_BITS || bits > MAX_FRAME_BITS {
        return err(hal.Error.InvalidInput)
    }
    return ok()
}

// The clock dividers for one SPI clock frequency, from `divisors`.
pub struct Divisors {
    // The controller's input clock, in hertz.
    pub clock_hz: u32
    // The prescaler, an even number from 2 to 254.
    pub prescale: u32
    // The second divider, 1 to 256.
    pub rate: u32
    // The resulting SPI clock, clock_hz / (prescale * rate), in hertz.
    pub frequency_hz: u32
}

// The fastest SPI clock from an input clock of `clock_hz` that does not
// exceed `frequency_hz`. The fastest possible is clock_hz / 2; a request
// above it gets that. InvalidInput below clock_hz / 65024, about 1.9 kHz at
// 125 MHz, the slowest possible.
pub fn divisors(clock_hz: u32, frequency_hz: u32) -> Divisors!hal.Error {
    if frequency_hz == 0 || clock_hz == 0 {
        return err(hal.Error.InvalidInput)
    }
    clock := clock_hz as u64
    // The clock stays at or below the request exactly when the total
    // division is at least this.
    needed := (clock + frequency_hz as u64 - 1) / frequency_hz as u64
    // The smallest total division at or above `needed`: for each prescaler,
    // the smallest second divider that gets there. On a tie the smaller
    // prescaler wins.
    best_prescale := 0u64
    best_rate := 0u64
    prescale := 2u64
    for prescale <= 254 {
        rate := (needed + prescale - 1) / prescale
        if rate <= 256 && (best_prescale == 0 || prescale * rate < best_prescale * best_rate) {
            best_prescale = prescale
            best_rate = rate
        }
        prescale += 2
    }
    if best_prescale == 0 {
        return err(hal.Error.InvalidInput)
    }
    return ok(Divisors {
        clock_hz,
        prescale: best_prescale as u32,
        rate: best_rate as u32,
        frequency_hz: (clock / (best_prescale * best_rate)) as u32,
    })
}

// CR0's clock polarity and phase bits for `mode`.
fn format(mode: hal.SpiMode) -> u32 {
    match mode {
        hal.SpiMode.Mode0 => {
            return 0
        }
        hal.SpiMode.Mode1 => {
            return CLOCK_PHASE
        }
        hal.SpiMode.Mode2 => {
            return CLOCK_POLARITY
        }
        hal.SpiMode.Mode3 => {
            return CLOCK_POLARITY | CLOCK_PHASE
        }
    }
}

// An SPI bus master on one PL022 with registers R, any hal.Registers, such as
// a hal.RegisterBlock or a simulated controller in a test.
pub struct Controller<R: hal.Registers>: hal.Spi {
    registers: R
    divisors: Divisors
    // CR0's clock polarity and phase bits for the mode.
    mode: u32
    // CR0's frame format field.
    format: u32
    frame_bits: u32

    // Configure a controller fresh out of reset as a master with `divisors`,
    // computed from the clock that feeds it, 8-bit Motorola frames in
    // `mode`, and enable it.
    pub fn new(registers: R, divisors: Divisors, mode: hal.SpiMode) -> Controller<R> {
        bus := Controller<R> { registers, divisors, mode: format(mode), format: 0, frame_bits: 8 }
        bus.registers.write(CR1, 0)
        // Transfers poll the FIFO levels; no interrupts.
        bus.registers.write(IMSC, 0)
        bus.configure()
        bus.registers.write(CR1, PORT_ENABLE)
        return bus
    }

    // The SPI clock frequency, in hertz.
    pub fn frequency_hz(&self) -> u32 {
        return self.divisors.frequency_hz
    }

    // Change the clock between transfers, for example to talk to devices
    // with different limits on a shared bus. InvalidInput leaves it
    // unchanged.
    pub fn set_frequency(&mut self, frequency_hz: u32) -> void!hal.Error {
        self.divisors = divisors(self.divisors.clock_hz, frequency_hz)?
        self.reconfigure()
        return ok()
    }

    // Change the clock polarity and phase between transfers.
    pub fn set_mode(&mut self, mode: hal.SpiMode) {
        self.mode = format(mode)
        self.reconfigure()
    }

    // The frame size, in bits.
    pub fn frame_bits(&self) -> u32 {
        return self.frame_bits
    }

    // Change the frame size between transfers: MIN_FRAME_BITS to
    // MAX_FRAME_BITS. Frames above 8 bits move with the word methods only.
    // InvalidInput leaves it unchanged.
    pub fn set_frame_bits(&mut self, bits: u32) -> void!hal.Error {
        check_frame_bits(bits)?
        self.frame_bits = bits
        self.reconfigure()
        return ok()
    }

    // Change the frame format between transfers.
    pub fn set_frame_format(&mut self, format: FrameFormat) {
        self.format = frame_format(format)
        self.reconfigure()
    }

    // Connect the transmitter to the receiver inside the controller, so
    // every transfer reads back what it sent and the pins stay idle. Meant
    // for self-tests.
    pub fn set_loopback(&mut self, on: bool) {
        control := self.registers.read(CR1) & ~LOOPBACK
        if on {
            control |= LOOPBACK
        }
        self.registers.write(CR1, control)
    }

    // Send `bytes` and replace each with the byte received at the same
    // time. Overrun if received bytes were lost to a full receive FIFO,
    // which the driver's pacing prevents unless something else used the
    // controller; Unsupported for frames above 8 bits.
    pub fn transfer(&mut self, bytes: &mut[u8]) -> void!hal.Error {
        self.check_bytes()?
        return self.exchange(bytes)
    }

    // Send `bytes` and discard what arrives. Returns once the last bit has
    // left, so a chip select can be raised right after. Unsupported for
    // frames above 8 bits.
    pub fn write(&mut self, bytes: &[u8]) -> void!hal.Error {
        self.check_bytes()?
        self.send(bytes)
        return ok()
    }

    // `transfer` and `write` with one frame per word, for frames of any
    // size. Bits above the frame size are ignored when sending and zero
    // when receiving.
    pub fn transfer_words(&mut self, words: &mut[u16]) -> void!hal.Error {
        return self.exchange(words)
    }

    pub fn write_words(&mut self, words: &[u16]) -> void!hal.Error {
        self.send(words)
        return ok()
    }

    // Move bytes between `buffer` and the bus by DMA until the returned
    // DmaBus is dropped: `tx` feeds the transmit FIFO and `rx` empties the
    // receive FIFO, while the processor does other work. `data` is the
    // address of the controller's data register as the channels see it,
    // which chip packages know; `Bus.dma` passes it. Unsupported for frames
    // above 8 bits; InvalidInput for an empty buffer; Busy if a channel is
    // still running.
    pub fn dma_at(&mut self, data: usize, tx: &mut dyn hal.DmaChannel, rx: &mut dyn hal.DmaChannel, buffer: &mut[u8]) -> DmaBus!hal.Error from(self, tx, rx, buffer) {
        self.check_bytes()?
        if buffer.len == 0 {
            return err(hal.Error.InvalidInput)
        }
        if tx.is_busy() || rx.is_busy() {
            return err(hal.Error.Busy)
        }
        self.settle()
        return ok(DmaBus { registers: &mut self.registers, data, tx, rx, buffer, running: false })
    }

    // Disable the controller and give back its registers.
    pub fn release(self) -> R {
        self.registers.write(CR1, 0)
        let Controller { registers, divisors, mode, format, frame_bits } = self
        return registers
    }

    fn check_bytes(&self) -> void!hal.Error {
        if self.frame_bits > 8 {
            return err(hal.Error.Unsupported)
        }
        return ok()
    }

    // Exchange frames, each T holding one, keeping the transmit FIFO busy
    // but never more frames in flight than the receive FIFO holds.
    fn exchange<T>(&mut self, frames: &mut[T]) -> void!hal.Error {
        mask := frame_mask(self.frame_bits)
        self.drain()
        sent := 0usize
        received := 0usize
        for received < frames.len {
            status := self.registers.read(SR)
            if sent < frames.len && sent - received < FIFO_DEPTH && (status & TX_NOT_FULL) != 0 {
                self.registers.write(DR, (frames[sent] as u32) & mask)
                sent += 1
            }
            if (status & RX_NOT_EMPTY) != 0 {
                frames[received] = (self.registers.read(DR) & mask) as T
                received += 1
            } else if (self.registers.read(RIS) & RX_OVERRUN) != 0 {
                // A reply was lost, and waiting for it would never end.
                // Every frame either reaches the receive FIFO or raises this
                // flag, so unlike the controller going idle, which it can do
                // before the last reply has crossed into the FIFO, the flag
                // never fires early.
                self.settle()
                return err(hal.Error.Overrun)
            }
        }
        if (self.registers.read(RIS) & RX_OVERRUN) != 0 {
            self.registers.write(ICR, RX_OVERRUN)
            return err(hal.Error.Overrun)
        }
        return ok()
    }

    fn send<T>(&mut self, frames: &[T]) {
        mask := frame_mask(self.frame_bits)
        for index in 0..frames.len {
            for (self.registers.read(SR) & TX_NOT_FULL) == 0 {
                self.drain()
            }
            self.registers.write(DR, (frames[index] as u32) & mask)
        }
        self.settle()
    }

    fn configure(&mut self) {
        control := hal.encode(DATA_SIZE, self.frame_bits - 1) | self.format | hal.encode(CLOCK_RATE, self.divisors.rate - 1) | self.polarity()
        self.registers.write(CPSR, self.divisors.prescale)
        self.registers.write(CR0, control)
    }

    // The clock polarity and phase bits, which only the Motorola format
    // has; the others must leave them clear.
    fn polarity(&self) -> u32 {
        if self.format == 0 {
            return self.mode
        }
        return 0
    }

    // The format registers may change only while the port is disabled.
    fn reconfigure(&mut self) {
        enabled := self.registers.read(CR1)
        self.registers.write(CR1, enabled & ~PORT_ENABLE)
        self.configure()
        self.registers.write(CR1, enabled)
    }

    // Wait until the last frame is out, then discard what arrived and the
    // overflow it may have caused. BUSY stays set until the transmit FIFO is
    // empty and the shift register idle.
    fn settle(&mut self) {
        for (self.registers.read(SR) & BUSY) != 0 {
            self.drain()
        }
        self.drain()
        self.registers.write(ICR, RX_OVERRUN)
    }

    fn drain(&mut self) {
        for (self.registers.read(SR) & RX_NOT_EMPTY) != 0 {
            self.registers.read(DR)
        }
    }
}

// The bits of a frame of `bits` bits.
fn frame_mask(bits: u32) -> u32 {
    return (1u32 << bits) - 1
}

fn succeeded(result: void!hal.Error) -> bool {
    match result {
        ok() => {
            return true
        }
        err(error) => {
            return false
        }
    }
}

// Where write-only DMA transfers drop the bytes they receive. Every bus
// writes here; nothing reads it.
static mut DISCARD: u8 = 0

// An SPI bus master that moves bytes between a buffer it holds and the bus
// by DMA, from `Bus.dma(tx, rx, buffer)`. A transfer runs while the
// program does other work, without gaps between frames at any clock rate:
//
//     dma := bus.dma(&mut tx, &mut rx, &mut buffer)!
//     // fill dma.buffer()!, then:
//     dma.start_transfer(count)!
//     // ... other work, or return Pending from a task ...
//     if !dma.is_busy() {
//         dma.finish()!
//     }
//
// The bus holds the controller, both channels, and the buffer until it is
// dropped, and lends the buffer out only between transfers, so the program
// never touches memory the channels are moving. A task keeps the DmaBus in
// a field and waits for `rx`'s signal (rp_dma.Channel.set_signal), which
// is raised once the last byte has arrived. Dropping the bus aborts a
// running transfer; the device then saw only part of it.
pub struct DmaBus {
    registers: &mut dyn hal.Registers
    data: usize
    tx: &mut dyn hal.DmaChannel
    rx: &mut dyn hal.DmaChannel
    buffer: &mut[u8]
    // A transfer started and not yet finished.
    running: bool

    // The buffer, to fill before a transfer or read after one. Busy from
    // `start_transfer` or `start_write` until `finish`.
    pub fn buffer(&mut self) -> &mut[u8]!hal.Error from(self) {
        if self.running {
            return err(hal.Error.Busy)
        }
        return ok(&mut self.buffer[..])
    }

    // The buffer's length, the most a transfer moves.
    pub fn capacity(&self) -> usize {
        return self.buffer.len
    }

    // Start sending buffer[..count] and replacing each byte with the one
    // received at the same time, and return at once. InvalidInput for 0
    // or more than the buffer holds; Busy until the last transfer is
    // finished.
    pub fn start_transfer(&mut self, count: usize) -> void!hal.Error {
        return self.begin(count, true)
    }

    // Start sending buffer[..count] and discard what arrives, as for
    // `start_transfer`; the buffer stays as it is.
    pub fn start_write(&mut self, count: usize) -> void!hal.Error {
        return self.begin(count, false)
    }

    // True while a transfer runs: until the last byte has been received.
    pub fn is_busy(&mut self) -> bool {
        return self.running && (self.tx.is_busy() || self.rx.is_busy())
    }

    // Wait until the running transfer is done, if one is, and end it, so
    // the buffer is free again. Overrun if received bytes were lost, which
    // happens only if the receive channel was held up, and Bus if a
    // channel hit a bus error; either way the transfer is over.
    pub fn finish(&mut self) -> void!hal.Error {
        if !self.running {
            return ok()
        }
        for self.tx.is_busy() || self.rx.is_busy() {}
        return self.end()
    }

    // `start_transfer`, then `finish`.
    pub fn transfer(&mut self, count: usize) -> void!hal.Error {
        self.start_transfer(count)?
        return self.finish()
    }

    // `start_write`, then `finish`.
    pub fn write(&mut self, count: usize) -> void!hal.Error {
        self.start_write(count)?
        return self.finish()
    }

    fn begin(&mut self, count: usize, keep: bool) -> void!hal.Error {
        if self.running {
            return err(hal.Error.Busy)
        }
        if count == 0 || count > self.buffer.len || count as u64 > self.tx.max_count() as u64 || count as u64 > self.rx.max_count() as u64 {
            return err(hal.Error.InvalidInput)
        }
        start := hal.address_of(self.buffer)
        destination := start
        if !keep {
            // SAFETY: the address is a number here; the channel writes
            // single bytes there, which nothing reads.
            destination = unsafe {
                ptr.from_mut(&mut DISCARD) as usize
            }
        }
        receive := hal.DmaTransfer {
            source: self.data,
            destination,
            count: count as u32,
            width: hal.DmaWidth.Byte,
            increment_source: false,
            increment_destination: keep,
            pace: hal.DmaPace.Source,
            ring: hal.DmaRing.None,
        }
        send := hal.DmaTransfer {
            source: start,
            destination: self.data,
            count: count as u32,
            width: hal.DmaWidth.Byte,
            increment_source: true,
            increment_destination: false,
            pace: hal.DmaPace.Destination,
            ring: hal.DmaRing.None,
        }
        self.registers.write(ICR, RX_OVERRUN)
        // The fence makes the buffer's contents visible to the channels.
        // SAFETY: the buffer stays borrowed by this bus, which lends it out
        // again only once both channels are done or aborted.
        cpu.fence()
        unsafe {
            self.rx.start(receive)?
            match self.tx.start(send) {
                ok() => {}
                err(error) => {
                    self.rx.abort()
                    return err(error)
                }
            }
        }
        self.running = true
        // The receiver's request goes first, so no frame waits for it.
        self.registers.write(DMACR, RX_DMA | TX_DMA)
        return ok()
    }

    // End a transfer whose channels have stopped.
    fn end(&mut self) -> void!hal.Error {
        self.registers.write(DMACR, 0)
        self.running = false
        cpu.fence()
        for (self.registers.read(SR) & BUSY) != 0 {}
        overrun := (self.registers.read(RIS) & RX_OVERRUN) != 0
        for (self.registers.read(SR) & RX_NOT_EMPTY) != 0 {
            self.registers.read(DR)
        }
        self.registers.write(ICR, RX_OVERRUN)
        // Clear both channels' errors before reporting either.
        sent := succeeded(self.tx.take_error())
        received := succeeded(self.rx.take_error())
        if !sent || !received {
            return err(hal.Error.Bus)
        }
        if overrun {
            return err(hal.Error.Overrun)
        }
        return ok()
    }

    fn drop(&mut self) {
        if self.running {
            self.tx.abort()
            self.rx.abort()
            // An aborted transfer has nothing to report.
            succeeded(self.end())
        }
    }
}

// An SPI target (slave) on one PL022 with registers R: a master drives the
// clock and the chip select, and the target shifts out what it queued
// while it shifts in what the master sends. The controller follows a clock
// of up to a twelfth of its own input clock (10.4 MHz at 125 MHz).
//
// Queue replies before the master clocks them: a frame the master clocks
// while the transmit FIFO is empty repeats the last frame sent, and the
// controller cannot tell. In modes 0 and 2 the PL022 needs the chip select
// raised between every two frames; masters that keep it low for a whole
// transfer need modes 1 or 3. The frame size and format work as for
// Controller.
pub struct Target<R: hal.Registers> {
    registers: R
    mode: u32
    format: u32
    frame_bits: u32

    // Configure a controller fresh out of reset as a target with 8-bit
    // Motorola frames in `mode`, and enable it.
    pub fn new(registers: R, mode: hal.SpiMode) -> Target<R> {
        target := Target<R> { registers, mode: format(mode), format: 0, frame_bits: 8 }
        target.registers.write(CR1, TARGET_MODE)
        target.registers.write(IMSC, 0)
        // The prescaler matters only to a master, but must hold a valid
        // value.
        target.registers.write(CPSR, 2)
        target.configure()
        target.registers.write(ICR, RX_OVERRUN)
        target.registers.write(CR1, TARGET_MODE | PORT_ENABLE)
        return target
    }

    // Change the clock polarity and phase, while the master is idle.
    pub fn set_mode(&mut self, mode: hal.SpiMode) {
        self.mode = format(mode)
        self.reconfigure()
    }

    // The frame size, in bits.
    pub fn frame_bits(&self) -> u32 {
        return self.frame_bits
    }

    // Change the frame size, as for Controller.set_frame_bits.
    pub fn set_frame_bits(&mut self, bits: u32) -> void!hal.Error {
        check_frame_bits(bits)?
        self.frame_bits = bits
        self.reconfigure()
        return ok()
    }

    // Change the frame format, while the master is idle.
    pub fn set_frame_format(&mut self, format: FrameFormat) {
        self.format = frame_format(format)
        self.reconfigure()
    }

    // Drive the data output while selected (on, the default), or never,
    // for a target that only listens on a bus where another target
    // answers.
    pub fn set_output(&mut self, on: bool) {
        control := self.registers.read(CR1) & ~TARGET_OUTPUT_DISABLE
        if !on {
            control |= TARGET_OUTPUT_DISABLE
        }
        self.registers.write(CR1, control)
    }

    // Queue the start of `bytes` as replies, as many as the transmit FIFO
    // has room for, without waiting; returns how many. Unsupported for
    // frames above 8 bits.
    pub fn queue(&mut self, bytes: &[u8]) -> usize!hal.Error {
        self.check_bytes()?
        return ok(self.push(bytes))
    }

    // Move what the master sent, up to `buffer.len` frames, into `buffer`
    // without waiting; returns how many. Overrun, after them, if frames
    // were lost to a full receive FIFO; the program then has to find the
    // next frame boundary with the master, for example at the next chip
    // select. Unsupported for frames above 8 bits.
    pub fn read(&mut self, buffer: &mut[u8]) -> usize!hal.Error {
        self.check_bytes()?
        return self.pop(buffer)
    }

    // Exchange `bytes` with the master: send them, replacing each with the
    // byte received in its place. Waits as long as the master takes, and
    // keeps the transmit FIFO ahead of the master but never more frames in
    // flight than the receive FIFO holds; a master that clocks faster than
    // the program refills gets repeated frames. Overrun as for `read`,
    // Unsupported for frames above 8 bits.
    pub fn transfer(&mut self, bytes: &mut[u8]) -> void!hal.Error {
        self.check_bytes()?
        return self.exchange(bytes)
    }

    // `queue`, `read`, and `transfer` with one frame per word, for frames
    // of any size.
    pub fn queue_words(&mut self, words: &[u16]) -> usize {
        return self.push(words)
    }

    pub fn read_words(&mut self, buffer: &mut[u16]) -> usize!hal.Error {
        return self.pop(buffer)
    }

    pub fn transfer_words(&mut self, words: &mut[u16]) -> void!hal.Error {
        return self.exchange(words)
    }

    // Disable the controller and give back its registers.
    pub fn release(self) -> R {
        self.registers.write(CR1, 0)
        let Target { registers, mode, format, frame_bits } = self
        return registers
    }

    fn check_bytes(&self) -> void!hal.Error {
        if self.frame_bits > 8 {
            return err(hal.Error.Unsupported)
        }
        return ok()
    }

    fn push<T>(&mut self, frames: &[T]) -> usize {
        mask := frame_mask(self.frame_bits)
        count := 0usize
        for count < frames.len && (self.registers.read(SR) & TX_NOT_FULL) != 0 {
            self.registers.write(DR, (frames[count] as u32) & mask)
            count += 1
        }
        return count
    }

    fn pop<T>(&mut self, frames: &mut[T]) -> usize!hal.Error {
        mask := frame_mask(self.frame_bits)
        count := 0usize
        for count < frames.len && (self.registers.read(SR) & RX_NOT_EMPTY) != 0 {
            frames[count] = (self.registers.read(DR) & mask) as T
            count += 1
        }
        if (self.registers.read(RIS) & RX_OVERRUN) != 0 {
            self.registers.write(ICR, RX_OVERRUN)
            return err(hal.Error.Overrun)
        }
        return ok(count)
    }

    fn exchange<T>(&mut self, frames: &mut[T]) -> void!hal.Error {
        mask := frame_mask(self.frame_bits)
        sent := 0usize
        received := 0usize
        for received < frames.len {
            status := self.registers.read(SR)
            if sent < frames.len && sent - received < FIFO_DEPTH && (status & TX_NOT_FULL) != 0 {
                self.registers.write(DR, (frames[sent] as u32) & mask)
                sent += 1
            }
            if (status & RX_NOT_EMPTY) != 0 {
                frames[received] = (self.registers.read(DR) & mask) as T
                received += 1
            } else if (self.registers.read(RIS) & RX_OVERRUN) != 0 {
                self.registers.write(ICR, RX_OVERRUN)
                return err(hal.Error.Overrun)
            }
        }
        return ok()
    }

    fn configure(&mut self) {
        polarity := 0u32
        if self.format == 0 {
            polarity = self.mode
        }
        self.registers.write(CR0, hal.encode(DATA_SIZE, self.frame_bits - 1) | self.format | polarity)
    }

    fn reconfigure(&mut self) {
        enabled := self.registers.read(CR1)
        self.registers.write(CR1, enabled & ~PORT_ENABLE)
        self.configure()
        self.registers.write(CR1, enabled)
    }
}

// A PL022 on the chip, as chip packages hand it to applications. It
// implements hal.Spi like Controller but keeps
// the register block: `RegisterBlock` trusts its owner with every offset,
// which only the driver may be.
pub struct Bus: hal.Spi {
    controller: Controller<hal.RegisterBlock>

    // SAFETY: as for hal.RegisterBlock.at, with `base` a PL022 whose reset
    // and pins the caller has set up and that only this bus uses.
    pub unsafe fn at(base: usize, divisors: Divisors, mode: hal.SpiMode) -> Bus {
        unsafe {
            return Bus { controller: Controller.new(hal.RegisterBlock.at(base), divisors, mode) }
        }
    }

    pub fn transfer(&mut self, bytes: &mut[u8]) -> void!hal.Error {
        return self.controller.transfer(bytes)
    }

    pub fn write(&mut self, bytes: &[u8]) -> void!hal.Error {
        return self.controller.write(bytes)
    }

    // The clock frequency, in hertz: the fastest the controller can make
    // that does not exceed the requested one.
    pub fn frequency_hz(&self) -> u32 {
        return self.controller.frequency_hz()
    }

    // Change the clock between transfers, for devices with different limits
    // on one bus.
    pub fn set_frequency(&mut self, frequency_hz: u32) -> void!hal.Error {
        return self.controller.set_frequency(frequency_hz)
    }

    // Change the clock polarity and phase between transfers.
    pub fn set_mode(&mut self, mode: hal.SpiMode) {
        self.controller.set_mode(mode)
    }

    // The frame size, in bits.
    pub fn frame_bits(&self) -> u32 {
        return self.controller.frame_bits()
    }

    // Change the frame size: 4 to 16 bits. Frames above 8 bits move with
    // the word methods only.
    pub fn set_frame_bits(&mut self, bits: u32) -> void!hal.Error {
        return self.controller.set_frame_bits(bits)
    }

    // Change the frame format. The TI and Microwire formats need the
    // controller's own chip select on a pin.
    pub fn set_frame_format(&mut self, format: FrameFormat) {
        self.controller.set_frame_format(format)
    }

    // `transfer` and `write` with one frame per word, for frames of any
    // size.
    pub fn transfer_words(&mut self, words: &mut[u16]) -> void!hal.Error {
        return self.controller.transfer_words(words)
    }

    pub fn write_words(&mut self, words: &[u16]) -> void!hal.Error {
        return self.controller.write_words(words)
    }

    // Loop the transmitter back to the receiver inside the chip, for
    // self-tests: transfers read back what they send.
    pub fn set_loopback(&mut self, on: bool) {
        self.controller.set_loopback(on)
    }

    // Move bytes between `buffer` and the bus by DMA, `tx` feeding it and
    // `rx` emptying it, until the returned DmaBus is dropped; see DmaBus.
    // Unsupported for frames above 8 bits; InvalidInput for an empty
    // buffer or a channel that cannot serve this controller.
    pub fn dma(&mut self, tx: &mut dyn hal.DmaChannel, rx: &mut dyn hal.DmaChannel, buffer: &mut[u8]) -> DmaBus!hal.Error from(self, tx, rx, buffer) {
        data := self.controller.registers.base() + DR
        return self.controller.dma_at(data, tx, rx, buffer)
    }

    // Disable the controller and return its base address, for the chip
    // package to take the bus back.
    pub fn release(self) -> usize {
        let Bus { controller } = self
        registers := controller.release()
        return registers.base()
    }
}

// A PL022 on the chip as a target, as chip packages hand it to
// applications; see Target.
pub struct TargetBus {
    target: Target<hal.RegisterBlock>

    // SAFETY: as for Bus.at.
    pub unsafe fn at(base: usize, mode: hal.SpiMode) -> TargetBus {
        unsafe {
            return TargetBus { target: Target.new(hal.RegisterBlock.at(base), mode) }
        }
    }

    pub fn set_mode(&mut self, mode: hal.SpiMode) {
        self.target.set_mode(mode)
    }

    pub fn frame_bits(&self) -> u32 {
        return self.target.frame_bits()
    }

    pub fn set_frame_bits(&mut self, bits: u32) -> void!hal.Error {
        return self.target.set_frame_bits(bits)
    }

    pub fn set_frame_format(&mut self, format: FrameFormat) {
        self.target.set_frame_format(format)
    }

    pub fn set_output(&mut self, on: bool) {
        self.target.set_output(on)
    }

    // Queue replies without waiting; see Target.queue.
    pub fn queue(&mut self, bytes: &[u8]) -> usize!hal.Error {
        return self.target.queue(bytes)
    }

    // What the master sent, without waiting; see Target.read.
    pub fn read(&mut self, buffer: &mut[u8]) -> usize!hal.Error {
        return self.target.read(buffer)
    }

    // Exchange bytes with the master, waiting for it; see Target.transfer.
    pub fn transfer(&mut self, bytes: &mut[u8]) -> void!hal.Error {
        return self.target.transfer(bytes)
    }

    pub fn queue_words(&mut self, words: &[u16]) -> usize {
        return self.target.queue_words(words)
    }

    pub fn read_words(&mut self, buffer: &mut[u16]) -> usize!hal.Error {
        return self.target.read_words(buffer)
    }

    pub fn transfer_words(&mut self, words: &mut[u16]) -> void!hal.Error {
        return self.target.transfer_words(words)
    }

    // Disable the controller and return its base address, for the chip
    // package to take it back.
    pub fn release(self) -> usize {
        let TargetBus { target } = self
        registers := target.release()
        return registers.base()
    }
}
