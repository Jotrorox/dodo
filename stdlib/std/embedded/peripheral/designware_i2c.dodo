package designware_i2c

import "std/embedded/hal"

// The Synopsys DesignWare DW_apb_i2c controller, as the only master on an
// I2C bus or as a target (slave) that a master addresses. Chip vendors
// license this controller, so the same registers appear in many
// microcontrollers, among them the RP2040 and RP2350 (I2C0 and I2C1).
// `Controller` implements hal.I2c and hal.I2cPoll over any hal.Registers: a
// `hal.RegisterBlock` on the chip, or a simulated controller in a desktop
// test. `Target` answers another master and implements hal.I2cTarget.
//
// Chip packages pulse the controller's reset, route its two pins, pass the
// frequency of the clock that feeds it, and hand the controller to
// applications as a `Bus` or `TargetBus`. A master supports 7-bit and
// 10-bit addresses, standard, fast, and fast-plus speeds (up to 1 MHz), and
// transfers of any length, with the register FIFOs kept busy so bytes follow
// each other without gaps. The blocking methods bound every wait, so a
// device that holds the clock low forever yields hal.Error.Timeout instead
// of a hang. The polling methods, `poll_write`, `poll_read`, and
// `poll_write_read`, run the same transactions while the program does other
// work: each call moves what the FIFOs allow and returns, and `listen` makes
// the controller's interrupt say when the next call can move more.
//
// Two things the controller cannot do. It has no way to send an address
// without at least one data byte after it, so empty transfers are
// InvalidInput; `probe` finds devices with a one-byte read instead, as
// i2cdetect does. And high-speed mode (3.4 MHz) needs timing registers and
// a master code that the RP2040 and RP2350 leave out of their controllers:
// their IC_CON accepts fast mode plus at most, so `timing` stops at 1 MHz.
//
// Register names follow the DW_apb_i2c databook, as reproduced in the RP2040
// datasheet (4.3.17).

const CON: usize = 0x00
const TAR: usize = 0x04
const SAR: usize = 0x08
const DATA_CMD: usize = 0x10
const FS_SCL_HCNT: usize = 0x1C
const FS_SCL_LCNT: usize = 0x20
const INTR_MASK: usize = 0x30
const RAW_INTR_STAT: usize = 0x34
const RX_TL: usize = 0x38
const TX_TL: usize = 0x3C
const CLR_INTR: usize = 0x40
const CLR_RX_OVER: usize = 0x4C
const CLR_RD_REQ: usize = 0x50
const CLR_TX_ABRT: usize = 0x54
const CLR_RX_DONE: usize = 0x58
const CLR_STOP_DET: usize = 0x60
const ENABLE: usize = 0x6C
const STATUS: usize = 0x70
const SDA_HOLD: usize = 0x7C
const TX_ABRT_SOURCE: usize = 0x80
const ACK_GENERAL_CALL: usize = 0x98
const ENABLE_STATUS: usize = 0x9C
const FS_SPKLEN: usize = 0xA0
const COMP_PARAM_1: usize = 0xF4

// CON: master mode, fast-mode timing registers (which also serve standard
// mode and fast mode plus), 10-bit addressing as a target and as a master,
// repeated starts, the target disabled, STOP detected only in transactions
// that address the target, TX_EMPTY only once the last command has left the
// shift register, and SCL held low while the receive FIFO is full.
const MASTER_MODE: u32 = 1 << 0
const SPEED: u32 = 0b11 << 1
const SPEED_FAST: u32 = 2
const TARGET_TEN_BIT: u32 = 1 << 3
const MASTER_TEN_BIT: u32 = 1 << 4
const RESTART_ENABLE: u32 = 1 << 5
const SLAVE_DISABLE: u32 = 1 << 6
const STOP_IF_ADDRESSED: u32 = 1 << 7
const TX_EMPTY_CONTROL: u32 = 1 << 8
const RX_FULL_HOLD: u32 = 1 << 9

// TAR: 10-bit addressing, where the integration lets TAR change it rather
// than CON (I2C_DYNAMIC_TAR_UPDATE). The driver sets both.
const TAR_TEN_BIT: u32 = 1 << 12

// DATA_CMD: a data byte to send, or a read command, plus the condition to
// generate around it. A received byte comes with FIRST_DATA_BYTE when it is
// the first after an address.
const READ: u32 = 1 << 8
const STOP: u32 = 1 << 9
const RESTART: u32 = 1 << 10
const FIRST_DATA_BYTE: u32 = 1 << 11

// RAW_INTR_STAT and INTR_MASK. RX_FULL is raised while the receive FIFO
// holds more than RX_TL entries, TX_EMPTY while the transmit FIFO holds at
// most TX_TL and the last command popped has left the shift register.
const RX_OVER: u32 = 1 << 1
const RX_FULL: u32 = 1 << 2
const TX_EMPTY: u32 = 1 << 4
const READ_REQUEST: u32 = 1 << 5
const TX_ABORT: u32 = 1 << 6
const RX_DONE: u32 = 1 << 7
const STOP_DETECTED: u32 = 1 << 9

// ENABLE and ENABLE_STATUS.
const ENABLED: u32 = 1 << 0
const ABORT: u32 = 1 << 1

// STATUS.
const TX_NOT_FULL: u32 = 1 << 1
const RX_NOT_EMPTY: u32 = 1 << 3
const MASTER_ACTIVE: u32 = 1 << 5

// TX_ABRT_SOURCE: an address or data byte, including a general call, that
// no device acknowledged. Other sources, such as lost arbitration, are bus
// faults.
const NOT_ACKNOWLEDGED: u32 = 0b1_1111

const SDA_TX_HOLD: u32 = 0xFFFF
// COMP_PARAM_1: the receive and transmit FIFO depths minus one. Zero when
// the integration leaves the parameter register out.
const RX_BUFFER_DEPTH: u32 = 0xFF << 8
const TX_BUFFER_DEPTH: u32 = 0xFF << 16
// Every DW_apb_i2c configuration has FIFOs at least this deep.
const MINIMUM_DEPTH: usize = 2

// Polls of a status register without progress before the bus counts as
// stuck: around a second at 125 MHz in an optimized build, several times
// that unoptimized, and far beyond the clock stretching of real devices.
const POLLS: u32 = 10_000_000
// Polls for the abort and disable that follow a stuck bus. An abort
// finishes within a byte time when the bus moves, 8 ms at the slowest
// clock, and never while a device holds SCL low, so these waits must not
// add seconds to the Timeout.
const CLEANUP_POLLS: u32 = POLLS / 16

// Input clock cycles the controller adds to every SCL period: the high
// period lasts HCNT + SPKLEN + 7 cycles and the low period LCNT + 1.
const HIGH_EXTRA: u64 = 7
const LOW_EXTRA: u64 = 1

// TAR before the first transaction, so the first one programs it.
const NO_TARGET: u32 = 0xFFFF_FFFF

// The phases of a polled transaction: none runs; it runs; or the controller
// aborted it and is ending it on the bus, after which the poll reports why.
const IDLE: u8 = 0
const RUNNING: u8 = 1
const ABORTING: u8 = 2
// INTR_MASK before `listen` has written one, so it writes the first.
const NO_MASK: u32 = 0xFFFF_FFFF

// The controller settings for one SCL frequency, from `timing`.
pub struct Timing {
    // The controller's input clock, in hertz.
    pub clock_hz: u32
    // The SCL high and low count registers. SCL is high for
    // `high + spike + 7` input clock cycles and low for `low + 1`.
    pub high: u32
    pub low: u32
    // Longest glitch the input filters suppress, in input clock cycles.
    pub spike: u32
    // How long SDA is held after SCL falls, in input clock cycles.
    pub hold: u32
    // The resulting SCL frequency, in hertz, counting the controller's
    // extra cycles but not the bus's rise times, which stretch it further.
    pub frequency_hz: u32
}

// Controller settings for an SCL frequency of `frequency_hz` (1 Hz to
// hal.I2C_FAST_PLUS_HZ) from an input clock of `clock_hz`. SCL is low for 60%
// of each period, which meets the I2C specification's minimum low times at
// 100 kHz, 400 kHz, and 1 MHz. Returns InvalidInput for a frequency the
// controller cannot produce from this clock: below about 1.2 kHz at 125 MHz,
// or 1 MHz from a clock below about 36 MHz.
pub fn timing(clock_hz: u32, frequency_hz: u32) -> Timing!hal.Error {
    if frequency_hz == 0 || frequency_hz > hal.I2C_FAST_PLUS_HZ || clock_hz == 0 {
        return err(hal.Error.InvalidInput)
    }
    period := ((clock_hz as u64) + (frequency_hz / 2) as u64) / frequency_hz as u64
    low_cycles := period * 3 / 5
    // Suppress glitches up to a sixteenth of the low period, which the
    // 50 ns spikes the specification allows fit into at every speed.
    spike := 1u64
    if low_cycles >= 16 {
        spike = low_cycles / 16
    }
    if spike > 0xFF {
        spike = 0xFF
    }
    high_cycles := period - low_cycles
    // The counts the databook allows: HCNT above SPKLEN + 5 and LCNT above
    // SPKLEN + 7.
    if high_cycles < HIGH_EXTRA + spike + spike + 6 || low_cycles < LOW_EXTRA + spike + 8 {
        return err(hal.Error.InvalidInput)
    }
    high := high_cycles - HIGH_EXTRA - spike
    low := low_cycles - LOW_EXTRA
    if high > 0xFFFF || low > 0xFFFF {
        return err(hal.Error.InvalidInput)
    }
    // SDA must change at least 300 ns after SCL falls, 120 ns in fast mode
    // plus, to clear the falling edge's undefined region.
    hold := (clock_hz as u64) * 3 / 10_000_000 + 1
    if frequency_hz >= hal.I2C_FAST_PLUS_HZ {
        hold = (clock_hz as u64) * 3 / 25_000_000 + 1
    }
    if hold + 2 > low {
        return err(hal.Error.InvalidInput)
    }
    return ok(Timing {
        clock_hz,
        high: high as u32,
        low: low as u32,
        spike: spike as u32,
        hold: hold as u32,
        frequency_hz: (clock_hz as u64 / period) as u32,
    })
}

// CON for the bus's only master.
fn master_control() -> u32 {
    return MASTER_MODE | hal.encode(SPEED, SPEED_FAST) | RESTART_ENABLE | SLAVE_DISABLE | TX_EMPTY_CONTROL
}

// TAR for a 7-bit or a 10-bit address.
fn seven_bit(address: u8) -> u32!hal.Error {
    if address > 0x7F {
        return err(hal.Error.InvalidInput)
    }
    return ok(address as u32)
}

fn ten_bit(address: u16) -> u32!hal.Error {
    if address > 0x3FF {
        return err(hal.Error.InvalidInput)
    }
    return ok(TAR_TEN_BIT | address as u32)
}

// An I2C bus master on one DW_apb_i2c controller with registers R, any
// hal.Registers, such as a hal.RegisterBlock or a simulated controller in a
// test.
//
// Transactions of any length run two ways. The blocking methods (`write`,
// `read`, `write_read`) return once the transaction has ended. The polling
// methods (`poll_write`, `poll_read`, `poll_write_read`) never wait: each
// call drains the bytes received into the caller's buffer, tops up the
// transmit FIFO with bytes to send and read commands, and reports whether
// the transaction has ended, so a program does other work meanwhile, or an
// executor task returns Pending until the controller's interrupt (with
// `listen`) or a timer wakes it. Both keep no more read commands
// outstanding than the receive FIFO holds, so it never overflows.
//
// A polled transaction holds the bus between polls. When the transmit FIFO
// runs empty before the command that ends the transaction with STOP, the
// controller holds SCL low and waits for more commands instead of ending
// it: the RP2040 and RP2350 integrate the controller with
// IC_EMPTYFIFO_HOLD_MASTER_EN set, which the blocking methods rely on just
// as much whenever an interrupt delays them between two bytes.
// Every device accepts the held clock as clock stretching, but a polled
// transaction that is never polled again holds the bus forever: finish it
// or `cancel` it. A transaction that never ends, because a device holds SCL
// low, stays unfinished; bound the wait with a timer, as hal.BlockingI2c
// does with a poll count, and cancel it.
pub struct Controller<R: hal.Registers>: hal.I2c + hal.I2cPoll {
    registers: R
    timing: Timing
    // Read commands that may be outstanding without overflowing the
    // receive FIFO.
    rx_depth: usize
    // Commands the transmit FIFO holds.
    tx_depth: usize
    // The address programmed in TAR, or NO_TARGET. While a transaction
    // runs, the address it was started for.
    target: u32
    // The transaction under way: its phase, the bytes it writes and reads,
    // the commands queued in the transmit FIFO so far (bytes written, then
    // reads), and the bytes taken from the receive FIFO.
    phase: u8
    writing: usize
    reading: usize
    queued: usize
    received: usize
    // TX_ABRT_SOURCE of an aborted transaction, while it ends.
    abort_source: u32
    // Whether `listen` asked for the interrupt, and the INTR_MASK value
    // written last, or NO_MASK.
    listening: bool
    mask: u32

    // Configure a controller fresh out of reset as the bus's only master,
    // using `timing` from the same clock that feeds it. It is enabled by the
    // first transaction.
    pub fn new(registers: R, timing: Timing) -> Controller<R> {
        bus := Controller<R> {
            registers,
            timing,
            rx_depth: MINIMUM_DEPTH,
            tx_depth: MINIMUM_DEPTH,
            target: NO_TARGET,
            phase: IDLE,
            writing: 0,
            reading: 0,
            queued: 0,
            received: 0,
            abort_source: 0,
            listening: false,
            mask: 0,
        }
        bus.registers.write(ENABLE, 0)
        bus.registers.write(CON, master_control())
        // No interrupts until `listen`, and no DMA requests.
        bus.registers.write(INTR_MASK, 0)
        bus.apply_timing()
        parameters := bus.registers.read(COMP_PARAM_1)
        depth := hal.decode(RX_BUFFER_DEPTH, parameters) as usize + 1
        if depth > MINIMUM_DEPTH {
            bus.rx_depth = depth
        }
        depth = hal.decode(TX_BUFFER_DEPTH, parameters) as usize + 1
        if depth > MINIMUM_DEPTH {
            bus.tx_depth = depth
        }
        // Interrupt thresholds for polled transactions: TX_EMPTY once the
        // transmit FIFO is half empty, RX_FULL once the receive FIFO is half
        // full, so each interrupt lets a poll move half a FIFO. The last
        // bytes of a read, fewer than that, end with STOP_DET.
        bus.registers.write(TX_TL, (bus.tx_depth / 2) as u32)
        bus.registers.write(RX_TL, (bus.rx_depth / 2 - 1) as u32)
        return bus
    }

    // The SCL frequency, in hertz, as computed by `timing`: the request,
    // rounded to whole input clock cycles.
    pub fn frequency_hz(&self) -> u32 {
        return self.timing.frequency_hz
    }

    // Change the SCL frequency between transactions, for example to talk to
    // a slower device. InvalidInput leaves the frequency unchanged; Busy
    // while a polled transaction runs.
    pub fn set_frequency(&mut self, frequency_hz: u32) -> void!hal.Error {
        if self.phase != IDLE {
            return err(hal.Error.Busy)
        }
        settings := timing(self.timing.clock_hz, frequency_hz)?
        self.disable()?
        self.timing = settings
        self.apply_timing()
        return ok()
    }

    // Send `bytes` to the device at `address`, then a STOP condition.
    // NoAcknowledge if the address or a byte is not acknowledged, Bus if
    // another master won arbitration, Timeout if the bus is stuck,
    // InvalidInput for an empty transfer or an address above 0x7F, and Busy
    // while a polled transaction runs.
    pub fn write(&mut self, address: u8, bytes: &[u8]) -> void!hal.Error {
        none: [0]u8 = []
        return self.transfer(seven_bit(address)?, bytes, &mut none)
    }

    // Fill `buffer` from the device at `address`, then a STOP condition.
    // Errors as for `write`.
    pub fn read(&mut self, address: u8, buffer: &mut[u8]) -> void!hal.Error {
        none: [0]u8 = []
        return self.transfer(seven_bit(address)?, &none, buffer)
    }

    // Send `bytes`, then fill `buffer` after a repeated START, all in one
    // transaction, so no other master can get in between; the usual way to
    // read a numbered register. With one of them empty it is a plain read
    // or write. Errors as for `write`, and InvalidInput only when both are
    // empty.
    pub fn write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        return self.transfer(seven_bit(address)?, bytes, buffer)
    }

    // `write`, `read`, and `write_read` for a device with a 10-bit
    // address, 0 to 0x3FF. The controller sends the two address bytes the
    // I2C specification prescribes (11110, the top two bits, then the low
    // eight) and repeats the first with the read bit before reading.
    // InvalidInput for an address above 0x3FF.
    pub fn write_ten_bit(&mut self, address: u16, bytes: &[u8]) -> void!hal.Error {
        none: [0]u8 = []
        return self.transfer(ten_bit(address)?, bytes, &mut none)
    }

    pub fn read_ten_bit(&mut self, address: u16, buffer: &mut[u8]) -> void!hal.Error {
        none: [0]u8 = []
        return self.transfer(ten_bit(address)?, &none, buffer)
    }

    pub fn write_read_ten_bit(&mut self, address: u16, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        return self.transfer(ten_bit(address)?, bytes, buffer)
    }

    // Whether a device acknowledges `address`, found by reading one byte
    // from it, as `i2cdetect -r` does, since the controller cannot send an
    // address alone. The byte is discarded. Errors other than NoAcknowledge
    // as for `read`. A few write-only devices take an unexpected read
    // badly; probe only addresses that may hold such a device if its
    // datasheet allows reads.
    pub fn probe(&mut self, address: u8) -> bool!hal.Error {
        byte: [1]u8 = [0]
        match self.read(address, &mut byte) {
            ok() => {
                return ok(true)
            }
            err(error) => {
                if error == hal.Error.NoAcknowledge {
                    return ok(false)
                }
                return err(error)
            }
        }
    }

    // Advance a write of `bytes` to the device at `address`, then a STOP,
    // without waiting: false while it runs, true once it has ended. The
    // first call starts the transaction, as many bytes as the transmit FIFO
    // holds; later calls pass the same address and bytes and queue the
    // rest as the FIFO drains. Errors as for `write`, after which the
    // transaction is over, except that a stuck bus is never reported: the
    // transaction stays unfinished until `cancel`. InvalidInput for a call
    // whose address or lengths differ from the running transaction's, which
    // keeps running. Starting a transaction to another address than the
    // last waits for the controller to disable, which it does at once
    // between transactions.
    pub fn poll_write(&mut self, address: u8, bytes: &[u8]) -> bool!hal.Error {
        none: [0]u8 = []
        return self.advance(seven_bit(address)?, bytes, &mut none)
    }

    // Advance a read of `buffer.len` bytes, as for `poll_write`. Each call
    // moves the bytes received so far into `buffer`; they are all there
    // once it returns true.
    pub fn poll_read(&mut self, address: u8, buffer: &mut[u8]) -> bool!hal.Error {
        none: [0]u8 = []
        return self.advance(seven_bit(address)?, &none, buffer)
    }

    // Advance `write_read` as one transaction, as for `poll_write` and
    // `poll_read`: the bytes, a repeated START, and the read.
    pub fn poll_write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> bool!hal.Error {
        return self.advance(seven_bit(address)?, bytes, buffer)
    }

    // The polled transactions above for a device with a 10-bit address, as
    // for `write_ten_bit`.
    pub fn poll_write_ten_bit(&mut self, address: u16, bytes: &[u8]) -> bool!hal.Error {
        none: [0]u8 = []
        return self.advance(ten_bit(address)?, bytes, &mut none)
    }

    pub fn poll_read_ten_bit(&mut self, address: u16, buffer: &mut[u8]) -> bool!hal.Error {
        none: [0]u8 = []
        return self.advance(ten_bit(address)?, &none, buffer)
    }

    pub fn poll_write_read_ten_bit(&mut self, address: u16, bytes: &[u8], buffer: &mut[u8]) -> bool!hal.Error {
        return self.advance(ten_bit(address)?, bytes, buffer)
    }

    // True while a polled transaction runs: from its first poll until a
    // poll reports its end or it is cancelled.
    pub fn is_busy(&self) -> bool {
        return self.phase != IDLE
    }

    // Abandon the running polled transaction, if any: the controller aborts
    // it, which ends it with a STOP within a byte time, and is disabled, so
    // the next transaction starts afresh. Waits for that, at most about a
    // tenth of a second while a device holds SCL low.
    pub fn cancel(&mut self) {
        if self.phase != IDLE {
            self.reset()
        }
    }

    // Raise the controller's interrupt (I2C0_IRQ or I2C1_IRQ on the RP2040
    // and RP2350) whenever a poll of the running transaction can make
    // progress: the transmit FIFO is half empty while commands remain to
    // queue, the receive FIFO is half full, or the transaction ended with a
    // STOP or an abort. Each poll sets INTR_MASK for what it waits on next,
    // and an idle controller raises nothing. The condition lasts until a
    // poll has dealt with it, so a handler masks the interrupt in the NVIC
    // and raises an executor signal, and the task, woken, polls and enables
    // the interrupt again.
    pub fn listen(&mut self) {
        self.listening = true
        self.mask = NO_MASK
        self.update_mask()
    }

    // Stop raising the interrupt.
    pub fn ignore(&mut self) {
        self.listening = false
        self.mask = 0
        self.registers.write(INTR_MASK, 0)
    }

    // Disable the controller and give back its registers. A polled
    // transaction still running is cut off.
    pub fn release(self) -> R {
        // A stuck controller is given back as it is.
        match self.disable() {
            ok() => {}
            err(_) => {}
        }
        let Controller { registers, timing, rx_depth, tx_depth, target, phase, writing, reading, queued, received, abort_source, listening, mask } = self
        return registers
    }

    // A whole transaction, polled until it ends: `bytes` then a read into
    // `buffer`, addressed with a TAR value from seven_bit or ten_bit. The
    // bus is stuck once POLLS polls in a row move nothing.
    fn transfer(&mut self, target: u32, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        if self.phase != IDLE {
            return err(hal.Error.Busy)
        }
        polls := 0u32
        for {
            queued := self.queued
            received := self.received
            if self.advance(target, bytes, buffer)? {
                return ok()
            }
            if self.queued != queued || self.received != received {
                polls = 0
            } else {
                polls += 1
                if polls >= POLLS {
                    return self.stuck()
                }
            }
        }
    }

    // One poll of the transaction `bytes`, then a read into `buffer`, to
    // TAR value `target`: start it if none runs, then move what the FIFOs
    // allow now and see whether it has ended.
    fn advance(&mut self, target: u32, bytes: &[u8], buffer: &mut[u8]) -> bool!hal.Error {
        if self.phase == IDLE {
            // The controller cannot send an address alone.
            if bytes.len == 0 && buffer.len == 0 {
                return err(hal.Error.InvalidInput)
            }
            self.start(target)?
            self.phase = RUNNING
            self.writing = bytes.len
            self.reading = buffer.len
            self.queued = 0
            self.received = 0
        } else if target != self.target || bytes.len != self.writing || buffer.len != self.reading {
            return err(hal.Error.InvalidInput)
        }
        if self.phase == ABORTING {
            return self.end_abort()
        }
        // Received bytes first, which makes room for more read commands.
        for self.received < self.reading && (self.registers.read(STATUS) & RX_NOT_EMPTY) != 0 {
            buffer[self.received] = (self.registers.read(DATA_CMD) & 0xFF) as u8
            self.received += 1
        }
        total := self.writing + self.reading
        for self.queued < total && self.may_queue() && (self.registers.read(STATUS) & TX_NOT_FULL) != 0 {
            index := self.queued
            command := READ
            if index < self.writing {
                command = bytes[index] as u32
            } else if index == self.writing && self.writing != 0 {
                command |= RESTART
            }
            if index + 1 == total {
                command |= STOP
            }
            // Ignored, like any command, if the transaction has just
            // aborted; the check below sees that.
            self.registers.write(DATA_CMD, command)
            self.queued += 1
        }
        // An abort is flagged before the STOP it causes.
        raw := self.registers.read(RAW_INTR_STAT)
        if (raw & TX_ABORT) != 0 {
            self.abort_source = self.registers.read(TX_ABRT_SOURCE)
            self.phase = ABORTING
            return self.end_abort()
        }
        if self.queued == total && self.received == self.reading && (raw & STOP_DETECTED) != 0 {
            self.registers.read(CLR_STOP_DET)
            self.phase = IDLE
            self.update_mask()
            return ok(true)
        }
        self.update_mask()
        return ok(false)
    }

    // Whether the next command may go into the transmit FIFO now: a byte
    // to write, or a read with room in the receive FIFO for its byte and
    // those of the reads before it.
    fn may_queue(&self) -> bool {
        return self.queued < self.writing || self.queued - self.writing - self.received < self.rx_depth
    }

    // The controller aborted the transaction: it has flushed its FIFOs and,
    // unless another master took over, sends a STOP. Once the bus is idle,
    // release the FIFOs and report why; until then the transaction runs. A
    // STOP that never comes, because a device holds SCL low, makes the bus
    // stuck: releasing the FIFOs then could let bytes of the aborted
    // transfer into them.
    fn end_abort(&mut self) -> bool!hal.Error {
        if (self.registers.read(STATUS) & MASTER_ACTIVE) != 0 {
            self.update_mask()
            return ok(false)
        }
        self.registers.read(CLR_TX_ABRT)
        self.registers.read(CLR_STOP_DET)
        self.phase = IDLE
        self.update_mask()
        if (self.abort_source & NOT_ACKNOWLEDGED) != 0 {
            return err(hal.Error.NoAcknowledge)
        }
        // Lost arbitration, or a protocol fault.
        return err(hal.Error.Bus)
    }

    // INTR_MASK for what the transaction waits on, while `listen` is on:
    // the end, received bytes while it reads, and room in the transmit FIFO
    // while commands remain that may be queued. A read held back by the
    // receive FIFO waits for RX_FULL instead, which a full FIFO's worth of
    // outstanding reads raises; leaving TX_EMPTY on then would interrupt
    // without anything to do. An aborted transaction waits for its STOP
    // only (from another master, after lost arbitration), as TX_ABRT stays
    // raised until it ends.
    fn update_mask(&mut self) {
        if !self.listening {
            return
        }
        mask := 0u32
        if self.phase == ABORTING {
            mask = STOP_DETECTED
        } else if self.phase == RUNNING {
            mask = TX_ABORT | STOP_DETECTED
            if self.reading != 0 {
                mask |= RX_FULL
            }
            if self.queued < self.writing + self.reading && self.may_queue() {
                mask |= TX_EMPTY
            }
        }
        if mask != self.mask {
            self.registers.write(INTR_MASK, mask)
            self.mask = mask
        }
    }

    fn apply_timing(&mut self) {
        self.registers.write(FS_SCL_HCNT, self.timing.high)
        self.registers.write(FS_SCL_LCNT, self.timing.low)
        self.registers.write(FS_SPKLEN, self.timing.spike)
        hold := self.registers.read(SDA_HOLD)
        self.registers.write(SDA_HOLD, (hold & ~SDA_TX_HOLD) | self.timing.hold)
    }

    // Address the device, a TAR value from seven_bit or ten_bit, and clear
    // what the last transaction left behind. TAR and CON can change only
    // while the controller is disabled.
    fn start(&mut self, target: u32) -> void!hal.Error {
        if self.target != target {
            self.disable()?
            control := master_control()
            if (target & TAR_TEN_BIT) != 0 {
                control |= MASTER_TEN_BIT
            }
            self.registers.write(CON, control)
            self.registers.write(TAR, target)
            self.target = target
        }
        // Reading CLR_INTR clears every flag, including a stale STOP.
        self.registers.read(CLR_INTR)
        self.registers.write(ENABLE, ENABLED)
        return ok()
    }

    fn disable(&mut self) -> void!hal.Error {
        self.registers.write(ENABLE, 0)
        for _ in 0..POLLS {
            if (self.registers.read(ENABLE_STATUS) & ENABLED) == 0 {
                return ok()
            }
        }
        return err(hal.Error.Timeout)
    }

    // No progress within POLLS: a device holds SCL low or the controller
    // hangs. Abort the transfer and disable the controller, so the next
    // transaction starts afresh.
    fn stuck(&mut self) -> void!hal.Error {
        self.reset()
        return err(hal.Error.Timeout)
    }

    // Abort the running transaction and disable the controller, waiting at
    // most CLEANUP_POLLS for each.
    fn reset(&mut self) {
        self.registers.write(ENABLE, ENABLED | ABORT)
        for _ in 0..CLEANUP_POLLS {
            if (self.registers.read(ENABLE) & ABORT) == 0 {
                break
            }
        }
        self.registers.read(CLR_INTR)
        self.target = NO_TARGET
        self.phase = IDLE
        // The next transaction disables it again if this gives up.
        self.registers.write(ENABLE, 0)
        for _ in 0..CLEANUP_POLLS {
            if (self.registers.read(ENABLE_STATUS) & ENABLED) == 0 {
                break
            }
        }
        self.update_mask()
    }
}

// The SAR value for a target address: a 7-bit address outside the ranges
// the I2C specification reserves (0x00 to 0x07 and 0x78 to 0x7F), or with
// `ten_bit` any 10-bit address, 0 to 0x3FF. InvalidInput otherwise.
pub fn target_address(address: u16, ten_bit: bool) -> u32!hal.Error {
    if ten_bit {
        if address > 0x3FF {
            return err(hal.Error.InvalidInput)
        }
    } else if address < 0x08 || address > 0x77 {
        return err(hal.Error.InvalidInput)
    }
    return ok(address as u32)
}

// No byte held back between two polls.
const NO_ENTRY: u32 = 0xFFFF_FFFF

// A target (slave) on an I2C bus, answering a master at one address with
// one DW_apb_i2c controller with registers R, any hal.Registers; it
// implements hal.I2cTarget. The program polls for what the master does:
// written bytes arrive in order, each read waits for `respond`, and a STOP
// ends the transaction.
//
//     match target.poll(&mut buffer)? {
//         hal.I2cTargetEvent.Write(count, start) => { ... }
//         hal.I2cTargetEvent.Read => { target.respond(&reply)? }
//         ...
//     }
//
// The controller holds SCL low while its receive FIFO is full or a read
// waits, so a slow program delays the master but loses nothing; masters
// accept such clock stretching, unless they give up after a timeout of
// their own (SMBus allows 25 ms). Bytes queued by `respond` beyond what the
// master reads are dropped when it next reads. General calls (address 0)
// are not acknowledged.
pub struct Target<R: hal.Registers>: hal.I2cTarget {
    registers: R
    // A received FIFO entry that starts a new write, read by the last poll
    // and held back for the next, or NO_ENTRY.
    held: u32

    // Configure a controller fresh out of reset as a target at `address`,
    // a 10-bit address with `ten_bit`, and enable it. The address must pass
    // `target_address`; chip packages check it before they take the
    // controller. `timing`, for the
    // bus's SCL frequency from the clock that feeds the controller, sets
    // the spike filter and SDA hold time; a target follows the master's
    // clock whatever its frequency.
    pub fn new(registers: R, timing: Timing, address: u16, ten_bit: bool) -> Target<R> {
        sar := 0u32
        match target_address(address, ten_bit) {
            ok(value) => {
                sar = value
            }
            err(_) => {
                core.assert(false)
            }
        }
        target := Target<R> { registers, held: NO_ENTRY }
        target.registers.write(ENABLE, 0)
        control := hal.encode(SPEED, SPEED_FAST) | STOP_IF_ADDRESSED | RX_FULL_HOLD
        if ten_bit {
            control |= TARGET_TEN_BIT
        }
        target.registers.write(CON, control)
        target.registers.write(SAR, sar)
        target.registers.write(INTR_MASK, 0)
        target.registers.write(TX_TL, 0)
        target.registers.write(RX_TL, 0)
        target.registers.write(ACK_GENERAL_CALL, 0)
        target.registers.write(FS_SPKLEN, timing.spike)
        hold := target.registers.read(SDA_HOLD)
        target.registers.write(SDA_HOLD, (hold & ~SDA_TX_HOLD) | timing.hold)
        target.registers.read(CLR_INTR)
        target.registers.write(ENABLE, ENABLED)
        return target
    }

    // What the master did since the last poll, in order: first the bytes
    // it wrote, as many as fit `buffer`, then a STOP, then a read that
    // waits for `respond`. Never waits. A program that polls more slowly
    // than whole transactions arrive may see one Stop for several; `start`
    // still marks where each write begins. Overrun if the receive FIFO
    // overflowed and written bytes were lost (RX_OVER), which cannot happen
    // while the controller holds SCL low on a full FIFO, as configured
    // here, but would on an integration without that hold; the bytes still
    // in the FIFO come with later polls. The controller detects no other
    // failure a target could report.
    pub fn poll(&mut self, buffer: &mut[u8]) -> hal.I2cTargetEvent!hal.Error {
        raw := self.registers.read(RAW_INTR_STAT)
        if (raw & RX_OVER) != 0 {
            self.registers.read(CLR_RX_OVER)
            return err(hal.Error.Overrun)
        }
        if (raw & TX_ABORT) != 0 {
            // A read began while bytes of an earlier reply were still
            // queued, and the controller dropped them. It refuses new
            // bytes until this is cleared.
            self.registers.read(CLR_TX_ABRT)
        }
        if (raw & RX_DONE) != 0 {
            // The master acknowledged no more bytes of a reply.
            self.registers.read(CLR_RX_DONE)
        }
        count := 0usize
        start := false
        for count < buffer.len {
            entry := self.held
            if entry == NO_ENTRY {
                if (self.registers.read(STATUS) & RX_NOT_EMPTY) == 0 {
                    break
                }
                entry = self.registers.read(DATA_CMD)
            }
            self.held = NO_ENTRY
            first := (entry & FIRST_DATA_BYTE) != 0
            if first && count > 0 {
                self.held = entry
                break
            }
            if count == 0 {
                start = first
            }
            buffer[count] = (entry & 0xFF) as u8
            count += 1
        }
        if count > 0 {
            return ok(hal.I2cTargetEvent.Write(count, start))
        }
        if self.held != NO_ENTRY || (self.registers.read(STATUS) & RX_NOT_EMPTY) != 0 {
            // Written bytes wait for a buffer; anything after them is later.
            return ok(hal.I2cTargetEvent.Idle)
        }
        // A STOP and a waiting read can both be flagged only when the STOP
        // came first: the master cannot end a read the target holds up.
        if (raw & STOP_DETECTED) != 0 {
            self.registers.read(CLR_STOP_DET)
            return ok(hal.I2cTargetEvent.Stop)
        }
        if (raw & READ_REQUEST) != 0 {
            return ok(hal.I2cTargetEvent.Read)
        }
        return ok(hal.I2cTargetEvent.Idle)
    }

    // Answer a Read from `poll` with `bytes`, as many as the transmit FIFO
    // holds; returns how many. The master reads them one by one and may
    // stop early; if it reads on, the next poll reports another Read. An
    // empty `bytes` sends 0xFF, which is what the master would read from an
    // idle bus, so that it is never left waiting, and returns 0. Never
    // fails: the error is there for hal.I2cTarget.
    pub fn respond(&mut self, bytes: &[u8]) -> usize!hal.Error {
        count := 0usize
        if bytes.len == 0 {
            self.registers.write(DATA_CMD, 0xFF)
        }
        for count < bytes.len && (self.registers.read(STATUS) & TX_NOT_FULL) != 0 {
            self.registers.write(DATA_CMD, bytes[count] as u32)
            count += 1
        }
        self.registers.read(CLR_RD_REQ)
        return ok(count)
    }

    // Answer at `address` from the next transaction on, a 10-bit address
    // with `ten_bit`, as for `target_address`. Waits, at most about a
    // second, for the current transaction to end; Timeout if it does not,
    // InvalidInput for a reserved or too large address. Either leaves the
    // address unchanged.
    pub fn set_address(&mut self, address: u16, ten_bit: bool) -> void!hal.Error {
        sar := target_address(address, ten_bit)?
        self.registers.write(ENABLE, 0)
        for _ in 0..POLLS {
            if (self.registers.read(ENABLE_STATUS) & ENABLED) == 0 {
                control := self.registers.read(CON) & ~TARGET_TEN_BIT
                if ten_bit {
                    control |= TARGET_TEN_BIT
                }
                self.registers.write(CON, control)
                self.registers.write(SAR, sar)
                self.held = NO_ENTRY
                self.registers.read(CLR_INTR)
                self.registers.write(ENABLE, ENABLED)
                return ok()
            }
        }
        self.registers.write(ENABLE, ENABLED)
        return err(hal.Error.Timeout)
    }

    // Stop answering, disable the controller, and give back its registers.
    pub fn release(self) -> R {
        self.registers.write(ENABLE, 0)
        for _ in 0..CLEANUP_POLLS {
            if (self.registers.read(ENABLE_STATUS) & ENABLED) == 0 {
                break
            }
        }
        let Target { registers, held } = self
        return registers
    }
}

// A DW_apb_i2c on the chip, as chip packages hand it to applications. It
// implements hal.I2c and hal.I2cPoll like Controller but keeps the register
// block: `RegisterBlock` trusts its owner with every offset, which only the
// driver may be.
pub struct Bus: hal.I2c + hal.I2cPoll {
    controller: Controller<hal.RegisterBlock>

    // SAFETY: as for hal.RegisterBlock.at, with `base` a DW_apb_i2c whose
    // reset and pins the caller has set up and that only this bus uses.
    pub unsafe fn at(base: usize, timing: Timing) -> Bus {
        unsafe {
            return Bus { controller: Controller.new(hal.RegisterBlock.at(base), timing) }
        }
    }

    pub fn write(&mut self, address: u8, bytes: &[u8]) -> void!hal.Error {
        return self.controller.write(address, bytes)
    }

    pub fn read(&mut self, address: u8, buffer: &mut[u8]) -> void!hal.Error {
        return self.controller.read(address, buffer)
    }

    pub fn write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        return self.controller.write_read(address, bytes, buffer)
    }

    // The transactions above for a device with a 10-bit address.
    pub fn write_ten_bit(&mut self, address: u16, bytes: &[u8]) -> void!hal.Error {
        return self.controller.write_ten_bit(address, bytes)
    }

    pub fn read_ten_bit(&mut self, address: u16, buffer: &mut[u8]) -> void!hal.Error {
        return self.controller.read_ten_bit(address, buffer)
    }

    pub fn write_read_ten_bit(&mut self, address: u16, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        return self.controller.write_read_ten_bit(address, bytes, buffer)
    }

    // Whether a device acknowledges `address`, from a one-byte read.
    pub fn probe(&mut self, address: u8) -> bool!hal.Error {
        return self.controller.probe(address)
    }

    // The transactions without waiting, for programs that do other work
    // meanwhile; see Controller.poll_write.
    pub fn poll_write(&mut self, address: u8, bytes: &[u8]) -> bool!hal.Error {
        return self.controller.poll_write(address, bytes)
    }

    pub fn poll_read(&mut self, address: u8, buffer: &mut[u8]) -> bool!hal.Error {
        return self.controller.poll_read(address, buffer)
    }

    pub fn poll_write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> bool!hal.Error {
        return self.controller.poll_write_read(address, bytes, buffer)
    }

    pub fn poll_write_ten_bit(&mut self, address: u16, bytes: &[u8]) -> bool!hal.Error {
        return self.controller.poll_write_ten_bit(address, bytes)
    }

    pub fn poll_read_ten_bit(&mut self, address: u16, buffer: &mut[u8]) -> bool!hal.Error {
        return self.controller.poll_read_ten_bit(address, buffer)
    }

    pub fn poll_write_read_ten_bit(&mut self, address: u16, bytes: &[u8], buffer: &mut[u8]) -> bool!hal.Error {
        return self.controller.poll_write_read_ten_bit(address, bytes, buffer)
    }

    pub fn is_busy(&self) -> bool {
        return self.controller.is_busy()
    }

    pub fn cancel(&mut self) {
        self.controller.cancel()
    }

    // Raise the bus's interrupt whenever a poll can make progress; see
    // Controller.listen.
    pub fn listen(&mut self) {
        self.controller.listen()
    }

    pub fn ignore(&mut self) {
        self.controller.ignore()
    }

    // The SCL frequency, in hertz.
    pub fn frequency_hz(&self) -> u32 {
        return self.controller.frequency_hz()
    }

    // Change the SCL frequency between transactions.
    pub fn set_frequency(&mut self, frequency_hz: u32) -> void!hal.Error {
        return self.controller.set_frequency(frequency_hz)
    }

    // Disable the controller and return its base address, for the chip
    // package to take the bus back.
    pub fn release(self) -> usize {
        let Bus { controller } = self
        registers := controller.release()
        return registers.base()
    }
}

// A DW_apb_i2c on the chip as a target, as chip packages hand it to
// applications. It implements hal.I2cTarget; see Target.
pub struct TargetBus: hal.I2cTarget {
    target: Target<hal.RegisterBlock>

    // SAFETY: as for Bus.at. `address` and `ten_bit` must pass
    // target_address.
    pub unsafe fn at(base: usize, timing: Timing, address: u16, ten_bit: bool) -> TargetBus {
        unsafe {
            return TargetBus { target: Target.new(hal.RegisterBlock.at(base), timing, address, ten_bit) }
        }
    }

    // What the master did since the last poll; see Target.poll.
    pub fn poll(&mut self, buffer: &mut[u8]) -> hal.I2cTargetEvent!hal.Error {
        return self.target.poll(buffer)
    }

    // Answer a Read with `bytes`; see Target.respond.
    pub fn respond(&mut self, bytes: &[u8]) -> usize!hal.Error {
        return self.target.respond(bytes)
    }

    // Answer at another address; see Target.set_address.
    pub fn set_address(&mut self, address: u16, ten_bit: bool) -> void!hal.Error {
        return self.target.set_address(address, ten_bit)
    }

    // Disable the controller and return its base address, for the chip
    // package to take it back.
    pub fn release(self) -> usize {
        let TargetBus { target } = self
        registers := target.release()
        return registers.base()
    }
}
