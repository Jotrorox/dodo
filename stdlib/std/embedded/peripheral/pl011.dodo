package pl011

import "core/cpu"
import "std/embedded/hal"
import "std/io"

// The Arm PrimeCell PL011 UART, an asynchronous serial port. Chip vendors
// license this controller, so the same registers appear in many
// microcontrollers, among them the RP2040 and RP2350 (UART0 and UART1).
// `Controller` implements the std/io Reader and Writer interfaces over any
// hal.Registers: a `hal.RegisterBlock` on the chip, or a simulated
// controller in a desktop test. A port therefore works with every std/io
// helper and with std/fmt formatting:
//
//     fmt.printf(&mut serial, "{} degrees\n", celsius)!
//
// Chip packages pulse the controller's reset, route its pins, and pass the
// frequency of the clock that feeds it. Frames start as 8N1 (eight data
// bits, no parity, one stop bit), which nearly every device and terminal
// expects; `set_format` changes that. Both 32-entry FIFOs are on. Transfers
// are polled: a write waits only while the transmit FIFO is full, and a read
// returns what the receive FIFO holds, waiting only for the first byte.
// Nothing buffers input beyond the FIFO, so a program must read at least
// every 32 bytes' time (2.8 ms at 115200 baud) while data arrives, or bytes
// are lost and a read reports OVERRUN; with hardware flow control, see
// `set_flow_control`, the controller asks the other end to pause instead.
// `Port.dma` lifts the limit: a `DmaPort` receives into a ring buffer by
// DMA, and writes in the background. Ports implement hal.Serial and, with
// `poll_read`, `poll_write`, and `poll_flush`, which never wait,
// hal.SerialPoll.
// `set_break` holds the line low, for protocols that signal with breaks.
//
// Waits are counted in status polls, not time. A write, `flush`, and the
// settings that wait for output give up with TimedOut after
// DEFAULT_POLL_LIMIT polls without progress (around a second), which only a
// transmitter held up by flow control reaches; `set_poll_limit` changes
// that. A read waits for its first byte as long as it takes, as a terminal
// does, unless `set_read_poll_limit` bounds it too.
//
// Register names follow the PrimeCell PL011 technical reference manual, as
// reproduced in the RP2040 datasheet (4.2).

const DR: usize = 0x000
const RSR: usize = 0x004
const FR: usize = 0x018
const IBRD: usize = 0x024
const FBRD: usize = 0x028
const LCR_H: usize = 0x02C
const CR: usize = 0x030
const IFLS: usize = 0x034
const IMSC: usize = 0x038
const RIS: usize = 0x03C
const MIS: usize = 0x040
const ICR: usize = 0x044
const DMACR: usize = 0x048

// DR: a received byte, and above it the errors it arrived with.
const DATA: u32 = 0xFF
const ERRORS: u32 = 0xF << 8

// RSR: the receive FIFO overflowed. Unlike DR's flag, it stays set until a
// write to RSR (ECR) clears it.
const RSR_OVERRUN: u32 = 1 << 3

// FR.
const BUSY: u32 = 1 << 3
const RX_EMPTY: u32 = 1 << 4
const TX_FULL: u32 = 1 << 5

// LCR_H: send a break, parity on and even, two stop bits, the FIFOs on,
// and the number of data bits minus five.
const SEND_BREAK: u32 = 1 << 0
const PARITY_ENABLE: u32 = 1 << 1
const EVEN_PARITY: u32 = 1 << 2
const TWO_STOP_BITS: u32 = 1 << 3
const FIFO_ENABLE: u32 = 1 << 4
const WORD_LENGTH: u32 = 0b11 << 5

// CR: the controller, internal loopback, the transmitter and receiver, and
// hardware flow control on nUARTRTS and nUARTCTS.
const ENABLE: u32 = 1 << 0
const LOOPBACK: u32 = 1 << 7
const TX_ENABLE: u32 = 1 << 8
const RX_ENABLE: u32 = 1 << 9
const RTS_FLOW: u32 = 1 << 14
const CTS_FLOW: u32 = 1 << 15

// IFLS: the receive FIFO level, here 3/4 (24 bytes), from which RTS flow
// control asks the other end to pause, leaving room for the bytes it sends
// before it reacts; the transmit level keeps its reset value, 1/2.
const FIFO_LEVELS: u32 = (0b011 << 3) | 0b010

// ICR: every interrupt.
const ALL_INTERRUPTS: u32 = 0x7FF
// RIS and ICR: framing, parity, break, and overrun errors, in the order of
// their codes below.
const RECEIVE_ERRORS: u32 = 0xF << 7
// DMACR: raise DMA requests for the receive and transmit FIFOs.
const RX_DMA: u32 = 1 << 0
const TX_DMA: u32 = 1 << 1

// Interrupt sources, as bits of `listen`, `ignore`, `pending_interrupts`,
// and `clear_interrupts`. The controller raises its one interrupt line
// while any listened-to source is pending; the chip package names the line,
// such as UART0_IRQ, for an @interrupt handler.
//
// RX_INTERRUPT: the receive FIFO holds 24 bytes or more (3/4 full).
// RX_TIMEOUT_INTERRUPT: received bytes have waited for 32 bit times with no
// more arriving, so a handler also hears about a short message. Both stay
// pending until reads drain the FIFO below their condition.
pub const RX_INTERRUPT: u32 = 1 << 4
// The transmit FIFO has drained to 16 bytes or fewer: room to write more.
// Pending until writes fill it again or `clear_interrupts`.
pub const TX_INTERRUPT: u32 = 1 << 5
pub const RX_TIMEOUT_INTERRUPT: u32 = 1 << 6
// A received frame had a framing or parity error, was a break, or found the
// receive FIFO full. Pending until `clear_interrupts`.
pub const ERROR_INTERRUPTS: u32 = 0xF << 7

// Status polls without progress before a wait for output gives up.
pub const DEFAULT_POLL_LIMIT: u32 = 10_000_000
// A poll limit of zero waits as long as it takes.
pub const NO_POLL_LIMIT: u32 = 0

// Entries in each FIFO.
const FIFO_DEPTH: u32 = 32

const LINE_FEED: u8 = 10
const CARRIAGE_RETURN: u8 = 13

// Receive errors: a failed read's io.Error has kind Other and these bits in
// its code. A byte with a framing or parity error, or a break, is dropped:
// the line is noisy, the two ends disagree on the baud rate or format, or
// the other end holds the line low. An overrun means bytes were lost
// because the receive FIFO was full: the bytes read are good, but bytes are
// missing among them.
pub const FRAMING_ERROR: i32 = 1
pub const PARITY_ERROR: i32 = 2
pub const BREAK: i32 = 4
pub const OVERRUN: i32 = 8

// The baud rate divisor for one baud rate, from `divisors`.
pub struct Divisors {
    // The controller's input clock, in hertz.
    pub clock_hz: u32
    // The divisor, clock_hz / (16 * baud): its integer part, 1 to 65535,
    pub integer: u32
    // and its fraction in 64ths, 0 to 63.
    pub fraction: u32
    // The resulting baud rate, rounded to whole bits per second.
    pub baud: u32
}

// The divisor from an input clock of `clock_hz` that comes closest to
// `baud`. It is exact to 1/128, so the rate is within 0.1 % of the request
// up to clock_hz / 128 (976 kbaud at 125 MHz), and within 0.8 % above;
// receivers tolerate about 2 %. InvalidInput above clock_hz / 16 (7.8
// Mbaud at 125 MHz), the fastest possible, and below clock_hz / 1048560
// (120 baud at 125 MHz), the slowest.
pub fn divisors(clock_hz: u32, baud: u32) -> Divisors!hal.Error {
    if baud == 0 || clock_hz == 0 {
        return err(hal.Error.InvalidInput)
    }
    clock := 4 * clock_hz as u64
    rate := baud as u64
    // The divisor in 64ths, rounded to the nearest.
    scaled := (clock + rate / 2) / rate
    if scaled < 64 || scaled > 65_535 * 64 {
        return err(hal.Error.InvalidInput)
    }
    return ok(Divisors {
        clock_hz,
        integer: (scaled / 64) as u32,
        fraction: (scaled % 64) as u32,
        baud: ((clock + scaled / 2) / scaled) as u32,
    })
}

// The parity bit after each frame's data bits.
pub enum Parity {
    // No parity bit, the usual setting.
    None,
    // A parity bit that makes the number of ones even.
    Even,
    // A parity bit that makes the number of ones odd.
    Odd
}

// LCR_H's format bits.
fn line_format(data_bits: u32, parity: Parity, stop_bits: u32) -> u32!hal.Error {
    if data_bits < 5 || data_bits > 8 || stop_bits < 1 || stop_bits > 2 {
        return err(hal.Error.InvalidInput)
    }
    line := hal.encode(WORD_LENGTH, data_bits - 5)
    if stop_bits == 2 {
        line |= TWO_STOP_BITS
    }
    match parity {
        Parity.None => {}
        Parity.Even => {
            line |= PARITY_ENABLE | EVEN_PARITY
        }
        Parity.Odd => {
            line |= PARITY_ENABLE
        }
    }
    return ok(line)
}

// A serial port on one PL011 with registers R, any hal.Registers. Implements
// the std/io Reader and Writer interfaces and their polling forms.
pub struct Controller<R: hal.Registers>: hal.Serial + hal.SerialPoll {
    registers: R
    divisors: Divisors
    // Status polls without progress before a wait for output, or for the
    // first byte of a read, gives up; NO_POLL_LIMIT for none.
    poll_limit: u32
    read_poll_limit: u32
    // LCR_H's format bits.
    format: u32
    // Translate newlines; see set_crlf.
    crlf: bool
    // With crlf: the last byte received was a carriage return, so a line
    // feed right after it belongs to the same newline.
    after_return: bool
    // With crlf: the carriage return for a line feed went out, but the
    // line feed did not fit.
    feed_pending: bool

    // Configure a controller fresh out of reset for 8N1 frames at the baud
    // rate of `divisors`, computed from the clock that feeds it, and enable
    // it.
    pub fn new(registers: R, divisors: Divisors) -> Controller<R> {
        port := Controller<R> {
            registers,
            divisors,
            poll_limit: DEFAULT_POLL_LIMIT,
            read_poll_limit: NO_POLL_LIMIT,
            format: hal.encode(WORD_LENGTH, 3),
            crlf: false,
            after_return: false,
            feed_pending: false,
        }
        port.registers.write(CR, 0)
        // Transfers poll the FIFO flags; no interrupts or DMA requests.
        port.registers.write(IMSC, 0)
        port.registers.write(DMACR, 0)
        port.registers.write(IFLS, FIFO_LEVELS)
        port.registers.write(ICR, ALL_INTERRUPTS)
        port.registers.write(RSR, 0)
        port.configure()
        port.registers.write(CR, ENABLE | TX_ENABLE | RX_ENABLE)
        return port
    }

    // The baud rate, in bits per second: the closest the controller can
    // make to the requested one.
    pub fn baud(&self) -> u32 {
        return self.divisors.baud
    }

    // Bound waits for output: status polls without progress before a
    // write, `flush`, or a setting that waits for output gives up with
    // TimedOut (Timeout for settings). NO_POLL_LIMIT waits as long as it
    // takes.
    pub fn set_poll_limit(&mut self, polls: u32) {
        self.poll_limit = polls
    }

    // Bound the wait for a read's first byte the same way; reads wait as
    // long as it takes at first.
    pub fn set_read_poll_limit(&mut self, polls: u32) {
        self.read_poll_limit = polls
    }

    // Change the baud rate. Waits until everything written is out first, so
    // no byte goes out at the wrong rate. InvalidInput or Timeout leaves it
    // unchanged.
    pub fn set_baud(&mut self, baud: u32) -> void!hal.Error {
        settings := divisors(self.divisors.clock_hz, baud)?
        self.settle()?
        self.divisors = settings
        self.reconfigure()
        return ok()
    }

    // Change the frame format: 5 to 8 data bits, the parity bit, and 1 or 2
    // stop bits. Modbus devices, for example, use 8E1:
    // `set_format(8, pl011.Parity.Even, 1)`. Waits like set_baud;
    // InvalidInput or Timeout leaves the format unchanged.
    pub fn set_format(&mut self, data_bits: u32, parity: Parity, stop_bits: u32) -> void!hal.Error {
        line := line_format(data_bits, parity, stop_bits)?
        self.settle()?
        self.format = line
        self.reconfigure()
        return ok()
    }

    // Translate newlines for a serial terminal: write each "\n" as "\r\n",
    // and read the carriage return that a terminal's Enter key sends, alone
    // or followed by "\n", as one "\n", so `io.read_line` ends at Enter.
    // Off at first, so bytes pass unchanged, as binary protocols need.
    pub fn set_crlf(&mut self, on: bool) {
        self.crlf = on
        self.after_return = false
        self.feed_pending = false
    }

    // Turn hardware flow control on or off, once everything written is
    // out. With `cts`, the transmitter sends only while the other end holds
    // CTS low; with `rts`, the controller holds RTS low while its receive
    // FIFO has room and raises it, asking the other end to pause, from 24
    // bytes on, so input is not lost while the program is busy. Both need
    // the pins routed, which chip packages do for ports claimed with flow
    // control. While CTS stays high nothing leaves, so waits for output
    // end in TimedOut. Timeout, with flow control unchanged, if what was
    // written does not get out.
    pub fn set_flow_control(&mut self, cts: bool, rts: bool) -> void!hal.Error {
        control := self.registers.read(CR) & ~(CTS_FLOW | RTS_FLOW)
        if cts {
            control |= CTS_FLOW
        }
        if rts {
            control |= RTS_FLOW
        }
        self.settle()?
        self.registers.write(CR, control & ~ENABLE)
        self.registers.write(CR, control)
        return ok()
    }

    // Raise the controller's interrupt for these sources, such as
    // RX_INTERRUPT | RX_TIMEOUT_INTERRUPT, in addition to those already
    // listened to. Ports start with none.
    pub fn listen(&mut self, sources: u32) {
        mask := self.registers.read(IMSC)
        self.registers.write(IMSC, (mask | sources) & ALL_INTERRUPTS)
    }

    // Stop raising the interrupt for these sources.
    pub fn ignore(&mut self, sources: u32) {
        mask := self.registers.read(IMSC)
        self.registers.write(IMSC, mask & ~sources)
    }

    // The listened-to sources that are pending now: what an interrupt
    // handler has to serve.
    pub fn pending_interrupts(&mut self) -> u32 {
        return self.registers.read(MIS)
    }

    // Acknowledge sources whose condition does not end by itself, such as
    // TX_INTERRUPT or ERROR_INTERRUPTS.
    pub fn clear_interrupts(&mut self, sources: u32) {
        self.registers.write(ICR, sources & ALL_INTERRUPTS)
    }

    // Hold the transmit line low, a break, from once everything written is
    // out until `set_break(false)`. A receiver sees a break when the line
    // stays low for longer than a frame, so keep it on for at least two
    // frame times (174 us at 115200 baud, 8N1); LIN and DMX, for example,
    // start their frames with breaks. Timeout if what was written does not
    // get out before a break starts.
    pub fn set_break(&mut self, on: bool) -> void!hal.Error {
        line := self.format | FIFO_ENABLE
        if on {
            line |= SEND_BREAK
            self.settle()?
        }
        // The controller reports BUSY for as long as a break lasts, so
        // ending one must not wait for idle.
        // Rewriting LCR_H latches the same divisor again, so a break may
        // start and end while the controller runs.
        self.registers.write(LCR_H, line)
        return ok()
    }

    // Connect the transmitter to the receiver inside the controller, so
    // reads return what was written and the TX pin stays idle. Meant for
    // self-tests. Timeout if what was written does not get out.
    pub fn set_loopback(&mut self, on: bool) -> void!hal.Error {
        control := self.registers.read(CR) & ~LOOPBACK
        if on {
            control |= LOOPBACK
        }
        self.settle()?
        self.registers.write(CR, control & ~ENABLE)
        self.registers.write(CR, control)
        return ok()
    }

    // Send `bytes`, waiting while the transmit FIFO is full. Returns once
    // the last byte is queued; `flush` waits until it is sent. TimedOut,
    // with the bytes queued before it in `transferred`, if the FIFO stays
    // full for the poll limit.
    pub fn write(&mut self, bytes: &[u8]) -> usize!io.Error {
        sent := 0usize
        polls := 0u32
        for sent < bytes.len {
            count := self.queue(&bytes[sent..])
            if count == 0 {
                polls += 1
                if self.poll_limit != NO_POLL_LIMIT && polls >= self.poll_limit {
                    return err(io.failure(io.ErrorKind.TimedOut, sent))
                }
            } else {
                sent += count
                polls = 0
            }
        }
        return ok(bytes.len)
    }

    // Queue as much of `bytes` as the transmit FIFO has room for, without
    // waiting; Pending, with what was queued, once it is full.
    pub fn poll_write(&mut self, bytes: &[u8]) -> io.Poll!io.Error {
        count := self.queue(bytes)
        state := io.PollState.Ready
        if count < bytes.len {
            state = io.PollState.Pending
        }
        return ok(io.Poll { transferred: count, state })
    }

    // Wait until every byte written has left, stop bits included: before
    // the other end may power down, or before restarting. TimedOut, with
    // nothing transferred and nothing discarded, after the poll limit.
    pub fn flush(&mut self) -> void!io.Error {
        if !self.idle() {
            return err(io.failure(io.ErrorKind.TimedOut, 0))
        }
        return ok()
    }

    // `flush` without waiting: true once every byte written has left,
    // false while some are still queued or being sent.
    pub fn poll_flush(&mut self) -> bool!io.Error {
        return ok((self.registers.read(FR) & BUSY) == 0)
    }

    // Wait for the first byte, then return what has arrived, up to
    // `buffer.len`. A serial port has no end of input, so a read never
    // returns 0 bytes for a nonempty buffer. On a receive error, the bytes
    // before it are in buffer[..transferred] and io.Error.code holds its
    // bits; see FRAMING_ERROR. The next read continues after it.
    pub fn read(&mut self, buffer: &mut[u8]) -> usize!io.Error {
        polls := 0u32
        for {
            progress := self.poll_read(buffer)?
            if progress.transferred != 0 || buffer.len == 0 {
                return ok(progress.transferred)
            }
            polls += 1
            if self.read_poll_limit != NO_POLL_LIMIT && polls >= self.read_poll_limit {
                return err(io.failure(io.ErrorKind.TimedOut, 0))
            }
        }
    }

    // Return what the receive FIFO holds, up to `buffer.len`, without
    // waiting: Pending, with nothing, while it is empty. Errors as for
    // `read`.
    pub fn poll_read(&mut self, buffer: &mut[u8]) -> io.Poll!io.Error {
        count := 0usize
        for count < buffer.len && (self.registers.read(FR) & RX_EMPTY) == 0 {
            entry := self.registers.read(DR)
            errors := hal.decode(ERRORS, entry) as i32
            if (errors & (FRAMING_ERROR | PARITY_ERROR | BREAK)) != 0 {
                self.after_return = false
                return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: errors })
            }
            byte := (entry & DATA) as u8
            if self.crlf && self.after_return && byte == LINE_FEED {
                // The second half of a "\r\n", already read as "\n".
                self.after_return = false
            } else {
                self.after_return = self.crlf && byte == CARRIAGE_RETURN
                if self.after_return {
                    byte = LINE_FEED
                }
                buffer[count] = byte
                count += 1
            }
            if errors != 0 {
                return self.overrun(count)
            }
        }
        if (self.registers.read(RSR) & RSR_OVERRUN) != 0 {
            return self.overrun(count)
        }
        state := io.PollState.Ready
        if count == 0 && buffer.len != 0 {
            state = io.PollState.Pending
        }
        return ok(io.Poll { transferred: count, state })
    }

    // Receive into `ring` and send from `output` by DMA until the returned
    // DmaPort is dropped; see DmaPort. `data` is the address of the
    // controller's data register as the channels see it, which chip
    // packages know; `Port.dma` passes it. InvalidInput if `ring` holds no
    // aligned block of MIN_RING bytes or `output` is empty, or if a channel
    // cannot serve this controller; Busy if a channel is still running.
    pub fn dma_at(&mut self, data: usize, rx: &mut dyn hal.DmaChannel, ring: &mut[u8], tx: &mut dyn hal.DmaChannel, output: &mut[u8]) -> DmaPort!hal.Error from(self, rx, ring, tx, output) {
        bits := ring_bits(hal.address_of(ring), ring.len)
        if bits == 0 || output.len == 0 {
            return err(hal.Error.InvalidInput)
        }
        if rx.is_busy() || tx.is_busy() {
            return err(hal.Error.Busy)
        }
        size := 1usize << bits as usize
        start := (size - hal.address_of(ring) % size) % size
        port := DmaPort {
            registers: &mut self.registers,
            data,
            rx,
            ring,
            start,
            bits,
            run_count: 0,
            run_offset: 0,
            consumed: 0,
            tx,
            output,
            sending: false,
            poll_limit: self.poll_limit,
            read_poll_limit: self.read_poll_limit,
            crlf: self.crlf,
            after_return: self.after_return,
            feed_pending: self.feed_pending,
        }
        // Errors latched before the ring existed belong to no byte in it.
        port.registers.write(ICR, RECEIVE_ERRORS)
        port.receive()?
        port.registers.write(DMACR, RX_DMA | TX_DMA)
        return ok(port)
    }

    // Wait until everything written is out, within the poll limit, disable
    // the controller, and give back its registers. Output still stuck after
    // the poll limit is dropped.
    pub fn release(self) -> R {
        self.idle()
        self.registers.write(CR, 0)
        self.registers.write(IMSC, 0)
        let Controller { registers, divisors, poll_limit, read_poll_limit, format, crlf, after_return, feed_pending } = self
        return registers
    }

    // Wait until everything written has left; false if it has not after
    // the poll limit for each byte the transmit FIFO and shift register
    // hold, as the controller does not show how far it got.
    fn idle(&mut self) -> bool {
        budget := self.poll_limit as u64 * (FIFO_DEPTH as u64 + 1)
        polls := 0u64
        for (self.registers.read(FR) & BUSY) != 0 {
            polls += 1
            if self.poll_limit != NO_POLL_LIMIT && polls >= budget {
                return false
            }
        }
        return true
    }

    // `idle` for the settings that may change only between frames.
    fn settle(&mut self) -> void!hal.Error {
        if !self.idle() {
            return err(hal.Error.Timeout)
        }
        return ok()
    }

    // Report an overrun once, after `count` bytes read.
    fn overrun(&mut self, count: usize) -> io.Poll!io.Error {
        self.registers.write(RSR, 0)
        return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: OVERRUN })
    }

    // Queue the start of `bytes` while the transmit FIFO has room; returns
    // how many went in.
    fn queue(&mut self, bytes: &[u8]) -> usize {
        count := 0usize
        for count < bytes.len && (self.registers.read(FR) & TX_FULL) == 0 {
            byte := bytes[count]
            if self.crlf && byte == LINE_FEED && !self.feed_pending {
                self.registers.write(DR, CARRIAGE_RETURN as u32)
                self.feed_pending = true
            } else {
                self.registers.write(DR, byte as u32)
                self.feed_pending = false
                count += 1
            }
        }
        return count
    }

    fn configure(&mut self) {
        self.registers.write(IBRD, self.divisors.integer)
        self.registers.write(FBRD, self.divisors.fraction)
        // Writing LCR_H also latches the divisor registers.
        self.registers.write(LCR_H, self.format | FIFO_ENABLE)
    }

    // The divisor and format registers may change only while the
    // controller is disabled, and only between frames: callers settle
    // first.
    fn reconfigure(&mut self) {
        control := self.registers.read(CR)
        self.registers.write(CR, control & ~ENABLE)
        self.configure()
        self.registers.write(CR, control)
    }
}

// The smallest receive ring a DmaPort uses: the receive FIFO's size.
pub const MIN_RING: usize = 32
const MIN_RING_BITS: u32 = 5
// The largest, 32 KiB, as DMA rings go.
const MAX_RING_BITS: u32 = 15

// The size, as a power of two, of the largest block aligned to its size
// within `length` bytes at `address`, up to MAX_RING_BITS; 0 if none of
// MIN_RING bytes fits.
fn ring_bits(address: usize, length: usize) -> u32 {
    bits := MAX_RING_BITS
    for bits >= MIN_RING_BITS {
        size := 1usize << bits as usize
        start := (size - address % size) % size
        if start <= length && length - start >= size {
            return bits
        }
        bits -= 1
    }
    return 0
}

// A serial port that receives into a ring buffer and sends from an output
// buffer by DMA, from `Port.dma(rx, ring, tx, output)`. It implements the
// std/io Reader and Writer protocols like Port, with two differences:
//
// - Input is kept in the ring, not just the 32-byte FIFO, so the program
//   reads at its own pace: a 1 KiB ring holds 89 ms of input at 115200
//   baud. `rx` moves each byte into the ring as it arrives, round and
//   round; bytes the program has not read when the ring comes round again
//   are lost, and the next read reports OVERRUN.
// - A write copies its bytes into `output` and returns once `tx` is
//   sending them, waiting only while the previous write is still going
//   out, so printing hardly ever waits for the line.
//
// The ring is the largest block within `ring` whose size is a power of two
// and whose address is a multiple of its size, as the channel needs: a
// static buffer with `@align(N)` and N bytes gives all N, any other buffer
// at least a quarter of its length (`ring_size()` tells). Bytes with
// framing or parity errors, and breaks, arrive in the ring like others;
// a read reports the error, with the code bits of FRAMING_ERROR and the
// rest, after the bytes it returns, without telling which byte it was.
//
// A task waits for input with the executor: `rx`'s signal is raised only
// when its transfer ends, so poll on a ticker, or listen for
// RX_TIMEOUT_INTERRUPT and RX_INTERRUPT as with a polled port. Dropping
// the DmaPort stops both channels and hands the port back; input still in
// the ring is lost and output not yet sent is cut short.
pub struct DmaPort: hal.Serial + hal.SerialPoll {
    registers: &mut dyn hal.Registers
    data: usize
    rx: &mut dyn hal.DmaChannel
    ring: &mut[u8]
    // The ring within `ring`: its first byte and its size as a power of
    // two.
    start: usize
    bits: u32
    // The running receive transfer: its count, the ring position it
    // started at, and the bytes of it read so far.
    run_count: u32
    run_offset: usize
    consumed: u32
    tx: &mut dyn hal.DmaChannel
    output: &mut[u8]
    // A write's transfer started and not yet seen done.
    sending: bool
    poll_limit: u32
    read_poll_limit: u32
    crlf: bool
    after_return: bool
    feed_pending: bool

    // The ring's size in bytes: how much input waits for the program.
    pub fn ring_size(&self) -> usize {
        return 1usize << self.bits as usize
    }

    // The bytes received and not yet read, up to the ring's size.
    pub fn available(&mut self) -> usize {
        waiting := core.wrapping_sub(self.received(), self.consumed) as usize
        if waiting > self.ring_size() {
            return self.ring_size()
        }
        return waiting
    }

    // Wait for the first byte, then return what has arrived, up to
    // `buffer.len`; errors as for `poll_read`. The read poll limit bounds
    // the wait as on Port.
    pub fn read(&mut self, buffer: &mut[u8]) -> usize!io.Error {
        polls := 0u32
        for {
            progress := self.poll_read(buffer)?
            if progress.transferred != 0 || buffer.len == 0 {
                return ok(progress.transferred)
            }
            polls += 1
            if self.read_poll_limit != NO_POLL_LIMIT && polls >= self.read_poll_limit {
                return err(io.failure(io.ErrorKind.TimedOut, 0))
            }
        }
    }

    // Return what the ring holds, up to `buffer.len`, without waiting:
    // Pending, with nothing, while it is empty. An error has kind Other and
    // the bits of FRAMING_ERROR, PARITY_ERROR, BREAK, and OVERRUN in its
    // code, after the bytes before it in buffer[..transferred]; OVERRUN
    // here means the ring came round over unread bytes, which are dropped.
    pub fn poll_read(&mut self, buffer: &mut[u8]) -> io.Poll!io.Error {
        written := self.received()
        if core.wrapping_sub(written, self.consumed) as usize > self.ring_size() {
            return self.overrun(0, written)
        }
        count := 0usize
        mask := self.ring_size() - 1
        cpu.fence()
        for count < buffer.len && self.consumed != written {
            position := self.start + (core.wrapping_add(self.run_offset, self.consumed as usize) & mask)
            byte := self.ring[position]
            self.consumed += 1
            if self.crlf && self.after_return && byte == LINE_FEED {
                self.after_return = false
            } else {
                self.after_return = self.crlf && byte == CARRIAGE_RETURN
                if self.after_return {
                    byte = LINE_FEED
                }
                buffer[count] = byte
                count += 1
            }
        }
        // The channel may have come round over the bytes while they were
        // copied.
        now := self.received()
        if core.wrapping_sub(now, self.consumed) as usize > self.ring_size() {
            return self.overrun(count, now)
        }
        if self.consumed == self.run_count && !self.rx.is_busy() {
            self.restart()
        }
        errors := self.registers.read(RIS) & RECEIVE_ERRORS
        if errors != 0 {
            self.registers.write(ICR, errors)
            self.after_return = false
            return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: (errors >> 7) as i32 })
        }
        state := io.PollState.Ready
        if count == 0 && buffer.len != 0 {
            state = io.PollState.Pending
        }
        return ok(io.Poll { transferred: count, state })
    }

    // Send `bytes`: copy them into the output buffer, chunk by chunk, each
    // once the previous one has gone into the transmit FIFO, and return
    // when the last chunk is on its way; `flush` waits until it has left.
    // TimedOut, with the bytes handed over before it, if a chunk makes no
    // progress for the poll limit.
    pub fn write(&mut self, bytes: &[u8]) -> usize!io.Error {
        sent := 0usize
        for sent < bytes.len {
            if !self.wait_output() {
                return err(io.failure(io.ErrorKind.TimedOut, sent))
            }
            sent += self.send(&bytes[sent..])
        }
        return ok(bytes.len)
    }

    // Hand over as much of `bytes` as the output buffer takes if the
    // previous write is out of it, without waiting; Pending, with what was
    // handed over, otherwise.
    pub fn poll_write(&mut self, bytes: &[u8]) -> io.Poll!io.Error {
        count := 0usize
        if !self.output_busy() && bytes.len != 0 {
            count = self.send(bytes)
        }
        state := io.PollState.Ready
        if count < bytes.len {
            state = io.PollState.Pending
        }
        return ok(io.Poll { transferred: count, state })
    }

    // Wait until everything written has left; TimedOut after the poll
    // limit, as on Port.
    // `flush` without waiting: true once everything written has left the
    // output buffer and the transmitter.
    pub fn poll_flush(&mut self) -> bool!io.Error {
        if self.output_busy() {
            return ok(false)
        }
        return ok((self.registers.read(FR) & BUSY) == 0)
    }

    pub fn flush(&mut self) -> void!io.Error {
        if !self.wait_output() {
            return err(io.failure(io.ErrorKind.TimedOut, 0))
        }
        polls := 0u64
        budget := self.poll_limit as u64 * (FIFO_DEPTH as u64 + 1)
        for (self.registers.read(FR) & BUSY) != 0 {
            polls += 1
            if self.poll_limit != NO_POLL_LIMIT && polls >= budget {
                return err(io.failure(io.ErrorKind.TimedOut, 0))
            }
        }
        return ok()
    }

    // Translate newlines, as Port.set_crlf does.
    pub fn set_crlf(&mut self, on: bool) {
        self.crlf = on
        self.after_return = false
        self.feed_pending = false
    }

    // Bound waits for output, and for a read's first byte, in polls, as
    // on Port.
    pub fn set_poll_limit(&mut self, polls: u32) {
        self.poll_limit = polls
    }

    pub fn set_read_poll_limit(&mut self, polls: u32) {
        self.read_poll_limit = polls
    }

    // Interrupts, as on Port: with RX_TIMEOUT_INTERRUPT, a pause in the
    // input raises the port's interrupt, so a task can wait for a message
    // to end. Reading the ring does not end that condition; the channel
    // emptying the FIFO does.
    pub fn listen(&mut self, sources: u32) {
        mask := self.registers.read(IMSC)
        self.registers.write(IMSC, (mask | sources) & ALL_INTERRUPTS)
    }

    pub fn ignore(&mut self, sources: u32) {
        mask := self.registers.read(IMSC)
        self.registers.write(IMSC, mask & ~sources)
    }

    pub fn pending_interrupts(&mut self) -> u32 {
        return self.registers.read(MIS)
    }

    pub fn clear_interrupts(&mut self, sources: u32) {
        self.registers.write(ICR, sources & ALL_INTERRUPTS)
    }

    // Bytes the receive channel has written in its running transfer.
    fn received(&mut self) -> u32 {
        return core.wrapping_sub(self.run_count, self.rx.remaining())
    }

    // Start a receive transfer where the last one ended, as long as a
    // transfer may be: at 921600 baud the RP2040's runs for 13 hours and
    // the RP2350's for 48 minutes, after which the next read starts
    // another while the FIFO holds what arrives meanwhile.
    fn receive(&mut self) -> void!hal.Error {
        count := self.rx.max_count()
        transfer := hal.DmaTransfer {
            source: self.data,
            destination: hal.address_of(self.ring) + self.start + self.run_offset,
            count,
            width: hal.DmaWidth.Byte,
            increment_source: false,
            increment_destination: true,
            pace: hal.DmaPace.Source,
            ring: hal.DmaRing.Destination(self.bits),
        }
        // SAFETY: the ring stays borrowed by this port, which aborts the
        // channel before it is dropped, and the port only reads the bytes
        // the channel has written.
        unsafe {
            self.rx.start(transfer)?
        }
        self.run_count = count
        self.consumed = 0
        return ok()
    }

    // Start the next receive transfer once the running one has ended and
    // been read; a bus error that ended it early drops the rest.
    fn restart(&mut self) {
        self.run_offset = core.wrapping_add(self.run_offset, self.consumed as usize) & (self.ring_size() - 1)
        succeeded(self.rx.take_error())
        // The channel was just found idle and serves this port.
        succeeded(self.receive())
    }

    // Report lost input once, skipping to the newest byte, after `count`
    // bytes read.
    fn overrun(&mut self, count: usize, written: u32) -> io.Poll!io.Error {
        self.consumed = written
        self.after_return = false
        self.registers.write(ICR, RECEIVE_ERRORS)
        return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: OVERRUN })
    }

    fn output_busy(&mut self) -> bool {
        if self.sending && !self.tx.is_busy() {
            self.sending = false
            succeeded(self.tx.take_error())
        }
        return self.sending
    }

    // Wait while the previous write is in the output buffer; false after
    // the poll limit.
    fn wait_output(&mut self) -> bool {
        polls := 0u64
        budget := self.poll_limit as u64 * FIFO_DEPTH as u64
        for self.output_busy() {
            polls += 1
            if self.poll_limit != NO_POLL_LIMIT && polls >= budget {
                return false
            }
        }
        return true
    }

    // Copy the start of `bytes` into the free output buffer, translating
    // newlines, and start sending it; returns how many bytes went in.
    fn send(&mut self, bytes: &[u8]) -> usize {
        taken := 0usize
        filled := 0usize
        for taken < bytes.len && filled < self.output.len {
            byte := bytes[taken]
            if self.crlf && byte == LINE_FEED && !self.feed_pending {
                self.output[filled] = CARRIAGE_RETURN
                self.feed_pending = true
            } else {
                self.output[filled] = byte
                self.feed_pending = false
                taken += 1
            }
            filled += 1
        }
        transfer := hal.DmaTransfer {
            source: hal.address_of(self.output),
            destination: self.data,
            count: filled as u32,
            width: hal.DmaWidth.Byte,
            increment_source: true,
            increment_destination: false,
            pace: hal.DmaPace.Destination,
            ring: hal.DmaRing.None,
        }
        cpu.fence()
        // SAFETY: the output buffer stays borrowed by this port, which
        // writes to it again only once the channel is done, and aborts the
        // channel before it is dropped. The channel is idle and serves
        // this port, so starting cannot fail.
        unsafe {
            succeeded(self.tx.start(transfer))
        }
        self.sending = true
        return taken
    }

    fn drop(&mut self) {
        self.rx.abort()
        self.tx.abort()
        self.registers.write(DMACR, 0)
    }
}

fn succeeded(result: void!hal.Error) -> bool {
    match result {
        ok() => {
            return true
        }
        err(error) => {
            return false
        }
    }
}

// Send `bytes` through the PL011 with registers `registers`, configured by
// its owner, and wait until they are out. Does nothing if the transmitter
// is off. This is for panic hooks, which run while the owner is suspended
// for good; everything else goes through a Controller.
pub fn send<R: hal.Registers>(registers: &mut R, bytes: &[u8]) {
    if (registers.read(CR) & (ENABLE | TX_ENABLE)) != (ENABLE | TX_ENABLE) {
        return
    }
    for index in 0..bytes.len {
        for (registers.read(FR) & TX_FULL) != 0 {}
        registers.write(DR, bytes[index] as u32)
    }
    for (registers.read(FR) & BUSY) != 0 {}
}

// A PL011 on the chip, as chip packages hand it to applications. It
// implements the std/io Reader and Writer protocols like Controller but keeps
// the register block: `RegisterBlock` trusts its owner with every offset,
// which only the driver may be.
pub struct Port: hal.Serial + hal.SerialPoll {
    controller: Controller<hal.RegisterBlock>

    // SAFETY: as for hal.RegisterBlock.at, with `base` a PL011 whose reset
    // and pins the caller has set up and that only this port uses.
    pub unsafe fn at(base: usize, divisors: Divisors) -> Port {
        unsafe {
            return Port { controller: Controller.new(hal.RegisterBlock.at(base), divisors) }
        }
    }

    // Send `bytes`, waiting while the transmit FIFO is full. Returns once
    // the last byte is queued; `flush` waits until it is sent. TimedOut
    // after the poll limit.
    pub fn write(&mut self, bytes: &[u8]) -> usize!io.Error {
        return self.controller.write(bytes)
    }

    // Queue what fits in the transmit FIFO without waiting; Pending once it
    // is full.
    pub fn poll_write(&mut self, bytes: &[u8]) -> io.Poll!io.Error {
        return self.controller.poll_write(bytes)
    }

    // Wait until every byte written has left; TimedOut after the poll
    // limit.
    pub fn flush(&mut self) -> void!io.Error {
        return self.controller.flush()
    }

    pub fn poll_flush(&mut self) -> bool!io.Error {
        return self.controller.poll_flush()
    }

    // Bound waits for output, in status polls; see Controller.
    pub fn set_poll_limit(&mut self, polls: u32) {
        self.controller.set_poll_limit(polls)
    }

    // Bound the wait for a read's first byte; unbounded at first.
    pub fn set_read_poll_limit(&mut self, polls: u32) {
        self.controller.set_read_poll_limit(polls)
    }

    // Wait for the first byte, then return what has arrived. A receive
    // error fails with its bits in io.Error.code; see FRAMING_ERROR.
    pub fn read(&mut self, buffer: &mut[u8]) -> usize!io.Error {
        return self.controller.read(buffer)
    }

    // Return what has arrived without waiting; Pending while nothing has.
    pub fn poll_read(&mut self, buffer: &mut[u8]) -> io.Poll!io.Error {
        return self.controller.poll_read(buffer)
    }

    // The baud rate: the closest the controller can make to the requested
    // one.
    pub fn baud(&self) -> u32 {
        return self.controller.baud()
    }

    // Change the baud rate, once everything written is out.
    pub fn set_baud(&mut self, baud: u32) -> void!hal.Error {
        return self.controller.set_baud(baud)
    }

    // Change the frame format: 5 to 8 data bits, parity, and 1 or 2 stop
    // bits.
    pub fn set_format(&mut self, data_bits: u32, parity: Parity, stop_bits: u32) -> void!hal.Error {
        return self.controller.set_format(data_bits, parity, stop_bits)
    }

    // Translate newlines for a serial terminal: "\n" goes out as "\r\n",
    // and Enter reads as "\n".
    pub fn set_crlf(&mut self, on: bool) {
        self.controller.set_crlf(on)
    }

    // Turn hardware flow control on or off: the transmitter waits for CTS,
    // and RTS asks the other end to pause while the receive FIFO is nearly
    // full. Needs a port claimed with its flow control pins.
    pub fn set_flow_control(&mut self, cts: bool, rts: bool) -> void!hal.Error {
        return self.controller.set_flow_control(cts, rts)
    }

    // Hold the transmit line low, a break, once everything written is out,
    // until `set_break(false)`.
    pub fn set_break(&mut self, on: bool) -> void!hal.Error {
        return self.controller.set_break(on)
    }

    // Loop the transmitter back to the receiver inside the chip, for
    // self-tests: reads return what was written.
    pub fn set_loopback(&mut self, on: bool) -> void!hal.Error {
        return self.controller.set_loopback(on)
    }

    // Raise the port's interrupt for these sources, such as RX_INTERRUPT |
    // RX_TIMEOUT_INTERRUPT; see Controller.listen.
    pub fn listen(&mut self, sources: u32) {
        self.controller.listen(sources)
    }

    // Stop raising the interrupt for these sources.
    pub fn ignore(&mut self, sources: u32) {
        self.controller.ignore(sources)
    }

    // The listened-to sources pending now.
    pub fn pending_interrupts(&mut self) -> u32 {
        return self.controller.pending_interrupts()
    }

    // Acknowledge TX_INTERRUPT or ERROR_INTERRUPTS.
    pub fn clear_interrupts(&mut self, sources: u32) {
        self.controller.clear_interrupts(sources)
    }

    // Receive into `ring` and send from `output` by DMA, with channels
    // `rx` and `tx`, until the returned DmaPort is dropped; see DmaPort.
    // InvalidInput if `ring` holds no aligned block of MIN_RING bytes,
    // `output` is empty, or a channel cannot serve this port.
    pub fn dma(&mut self, rx: &mut dyn hal.DmaChannel, ring: &mut[u8], tx: &mut dyn hal.DmaChannel, output: &mut[u8]) -> DmaPort!hal.Error from(self, rx, ring, tx, output) {
        data := self.controller.registers.base() + DR
        return self.controller.dma_at(data, rx, ring, tx, output)
    }

    // Wait until everything written is out, within the poll limit, disable
    // the controller, and return its base address, for the chip package to
    // take the port back.
    pub fn release(self) -> usize {
        let Port { controller } = self
        registers := controller.release()
        return registers.base()
    }
}
