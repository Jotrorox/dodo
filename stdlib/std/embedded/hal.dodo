package hal

import "core/cpu"
import "core/ptr"
import "std/time"

// Portable hardware abstraction layer. Nothing here requires an OS, allocator,
// or particular chip, and every package that imports it also compiles for
// hosted targets, so drivers can be tested on a desktop with
// `std/embedded/hal/fake`.
//
// Three layers, from the bottom up:
//
// 1. Registers. `Reg<T>` gives typed volatile access to one memory-mapped
//    register, and mask constants name its fields. `RegisterBlock` is a
//    peripheral's run of 32-bit registers at offsets from one base address.
//    Creating either is the single unsafe step; reading and writing an owned
//    handle afterwards is safe.
// 2. Interrupts. `Critical` masks interrupts on the current core until it is
//    dropped. It never excludes other threads or cores.
// 3. Device protocols. The interfaces below (OutputPin, InputPin, Delay,
//    Counter, Alarm, I2c, Spi, PwmOutput, AnalogInput, Rtc, RtcAlarm,
//    Watchdog, and Registers) name what drivers need
//    from a device. Any value with
//    matching methods implements them. Drivers are usually generic over a
//    bounded parameter, `fn probe<B: hal.I2c>(bus: &mut B)`, which is
//    statically dispatched and reports a wrong argument where it is passed.
//    `&mut dyn hal.I2c` instead dispatches at run time, for drivers chosen at
//    run time or a list of different devices. Serial ports implement the
//    `std/io` Reader and Writer interfaces, so ports work with `std/io`
//    helpers and `std/fmt` formatting unchanged.
//
// Addresses are 7-bit I2C addresses; controllers that also reach 10-bit
// addresses offer that through methods of their own. Times are
// microseconds: counters and alarms count them in a u64, which no program
// outlives; real-time clocks count Unix milliseconds. Pin, delay, and
// counter operations cannot fail; alarm, bus, PWM, analog, and clock
// operations report the shared
// `Error` below, because such a device may itself sit on a bus. A bus is
// configured when it is created, with a frequency and for SPI a `SpiMode`,
// and so is a PWM output, with its frequency; the protocols then only move
// bytes and duty cycles, so drivers never depend on how a device was set up.
//
// The register block protocol is for peripheral drivers rather than device
// drivers. Microcontroller vendors license the same peripheral designs, so
// one I2C, SPI, or UART controller appears in many chips at different
// addresses. `std/embedded/peripheral` drives such controllers through any
// register block: a `RegisterBlock` on the chip, or a simulated controller in
// a desktop test. Reads take `&mut self` because reading a device register can
// change it, for example by popping a FIFO.
//
// Chips and boards. A chip package (`std/embedded/chip/NAME`) turns one
// microcontroller's registers into values with the protocols above. A board
// package (`std/embedded/board/NAME`) configures its chip for one circuit
// board and names what is wired on it. Firmware builds select both with
// `board = "NAME"` in dodo.toml, and `import "std/embedded/board"` (or
// `std/embedded/chip` for a custom board) resolves to the selected package.
// Every board package provides the same entry points, so applications move
// between boards unchanged:
//
//    NAME: &str                    the board's name
//    take() -> Board!Error         start the chip once; Busy on a second call
//    Board.led                     the user LED, an output pin, on when high
//    Board.pins                    output(n) / input(n) -> Pin!Error per GPIO,
//                                  and i2c(sda, scl, hz),
//                                  spi(clock, tx, rx, mode, hz), and
//                                  uart(tx, rx, baud), with rx an
//                                  Option<u32>, for buses with the I2C and
//                                  SPI bus and serial port protocols on
//                                  those pins (Busy if a pin or the
//                                  controller is taken, InvalidInput if the
//                                  pins cannot carry the bus);
//                                  pwm(pin, hz) for a PWM output and
//                                  analog(pin) for an analog input on
//                                  that pin, and temperature() for the
//                                  chip's temperature sensor, an analog
//                                  input too;
//                                  release(pin), release_i2c(bus),
//                                  release_spi(bus), release_uart(port),
//                                  release_pwm(output), and
//                                  release_analog(input) give them back.
//                                  Chips may offer more,
//                                  as the RP2040 and RP2350 do: targets
//                                  (slaves) with i2c_target and spi_target,
//                                  spi_with_select, and uart_flow
//    Board.timer                   the Delay and Counter protocols:
//                                  delay_us, delay_ms, now_us(&self) -> u64;
//                                  chips may hand out alarms with the Alarm
//                                  protocol that are also
//                                  std/embedded/executor clocks, as the
//                                  RP2040 and RP2350 do with alarm(n)
//    Board.rtc                     the chip's real-time clock, with the Rtc
//                                  and RtcAlarm protocols: the RP2040's
//                                  RTC, the RP2350's always-on timer
//    Board.watchdog                start(timeout_ms) -> void!Error, feed(),
//                                  stop(), with the Watchdog protocol:
//                                  resets the chip unless fed in time
//                                  (InvalidInput for a timeout of 0 or
//                                  above max_timeout_ms()); reset_reason()
//                                  tells whether it did, and the
//                                  scratch(n) words survive its reset
//    Board.usb                     serial() -> port!Error, a USB serial
//                                  port on the board's USB connector with
//                                  the serial port protocols (Busy if one
//                                  is open), and release_serial(port)
//    Board.dma                     chips with DMA hand out channels with
//                                  the DmaChannel protocol, as the RP2040
//                                  and RP2350 do with channel() and
//                                  release(channel)
//    Board.core1, Board.fifos,     on boards with a dual-core chip, as the
//    Board.spinlocks               RP2040 and RP2350 boards: start(stack,
//                                  task) runs a task on the second core,
//                                  and claim() hands out the cores' FIFO
//                                  ends and spinlocks
//    I2C_SDA_PIN, I2C_SCL_PIN      the board's usual I2C pins
//    SPI_CLOCK_PIN, SPI_TX_PIN,    the board's usual SPI pins, and a free
//    SPI_RX_PIN, SPI_SELECT_PIN    pin for one device's chip select
//    UART_TX_PIN, UART_RX_PIN      the board's usual serial port pins
//    reboot_to_bootloader()        restart into the board's flashing mode
//    report_panic(check, file,     unsafe; write a panic hook's failure to
//                 line, column)    the serial ports and the USB serial
//                                  port, which the default hook also does
//                                  before it halts

// Bus and device failures shared by every driver and chip implementation.
// A single payload-free enum keeps drivers composable and comparable with ==.
pub enum Error {
    // The device did not respond or a flag did not change in time.
    Timeout,
    // No device acknowledged its address or a data byte.
    NoAcknowledge,
    // Electrical or protocol fault, including lost bus arbitration.
    Bus,
    // Data arrived faster than it was consumed.
    Overrun,
    // The peripheral is in use or not ready for this request.
    Busy,
    // An argument is outside what the device or bus accepts.
    InvalidInput,
    // The implementation does not support this operation.
    Unsupported
}

pub fn error_name(error: Error) -> &str from(static) {
    match error {
        Error.Timeout => {
            return "Timeout"
        }
        Error.NoAcknowledge => {
            return "NoAcknowledge"
        }
        Error.Bus => {
            return "Bus"
        }
        Error.Overrun => {
            return "Overrun"
        }
        Error.Busy => {
            return "Busy"
        }
        Error.InvalidInput => {
            return "InvalidInput"
        }
        Error.Unsupported => {
            return "Unsupported"
        }
    }
}

// A digital output, such as a pin driving an LED or a chip select.
pub interface OutputPin {
    fn set_high(&mut self)
    fn set_low(&mut self)
}

// A digital input.
pub interface InputPin {
    fn is_high(&self) -> bool
}

// A busy-waiting delay source, such as a timer.
pub interface Delay {
    fn delay_us(&mut self, microseconds: u32)
}

// A free-running counter that keeps time, such as a chip's microsecond
// timer. Drivers measure intervals and give up on stuck devices with it,
// through Deadline and Ticker below, without naming a chip.
pub interface Counter {
    // Microseconds since some fixed start, such as the chip's start; never
    // decreases.
    fn now_us(&self) -> u64
}

// A one-shot alarm on a counter: it fires once when now_us() reaches the
// time it was given. Code polls `fired`, or a chip's interrupt for the
// alarm runs a handler, which calls `clear`. Raising that interrupt is
// chip-specific, as for the RP2040's and RP2350's `listen` and `irq`; the
// protocol only sets times and reports them. An alarm is also a Counter.
pub interface Alarm {
    // Microseconds on the counter the alarm compares with.
    fn now_us(&self) -> u64
    // Fire once when now_us() reaches `time_us`, replacing any earlier time
    // and clearing an earlier firing. A time already reached fires at once.
    // InvalidInput if the time lies further ahead than the alarm reaches,
    // which each implementation states.
    fn schedule_at_us(&mut self, time_us: u64) -> void!Error
    // Disarm: a scheduled time no longer fires. An earlier firing stays
    // reported until `clear`.
    fn cancel(&mut self)
    // True once the scheduled time was reached, until `clear` or the next
    // schedule.
    fn fired(&self) -> bool
    // Acknowledge a firing. An interrupt handler has to, or the interrupt
    // stays raised.
    fn clear(&mut self)
}

// An I2C bus controller. Addresses are 7-bit device addresses.
pub interface I2c {
    fn write(&mut self, address: u8, bytes: &[u8]) -> void!Error
    fn read(&mut self, address: u8, buffer: &mut[u8]) -> void!Error
    // Write `bytes`, then read `buffer.len` bytes without releasing the bus.
    fn write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> void!Error
}

// An SPI bus controller. Chip select is a separate output pin; see SpiDevice.
pub interface Spi {
    // Full-duplex exchange in place: each byte sent is replaced by the byte read.
    fn transfer(&mut self, bytes: &mut[u8]) -> void!Error
    fn write(&mut self, bytes: &[u8]) -> void!Error
}

// A pulse-width modulated output: a square wave that is high for
// duty / max_duty() of each period, which dims an LED, sets a motor's speed,
// or positions a servo. Its frequency is set when the output is created.
// A duty of 0 holds it low and max_duty() high.
pub interface PwmOutput {
    // The duty that holds the output high, at least 1.
    fn max_duty(&self) -> u16
    // InvalidInput if `duty` is above max_duty().
    fn set_duty(&mut self, duty: u16) -> void!Error
}

// An input of an analog-to-digital converter. Each read converts the voltage
// once: 0 at ground, max_value() at the converter's reference voltage, and
// proportionally in between.
pub interface AnalogInput {
    // The value read at the reference voltage, such as 4095 for a 12-bit
    // converter.
    fn max_value(&self) -> u16
    fn read(&mut self) -> u16!Error
}

// A real-time clock: the time of day, kept by a counter that runs on while
// the processor sleeps, such as the RP2040's RTC, the RP2350's always-on
// timer, which also keeps counting through resets, or a clock chip on I2C
// with a backup battery.
//
// Times are milliseconds since the Unix epoch, 1970-01-01 00:00:00 UTC, the
// count std/time's Timestamp holds; `rtc_now` and `rtc_set` below convert
// them to and from a `time.DateTime`. A clock that counts whole seconds
// reports whole seconds, and `resolution_ms` says how long its steps are.
// A clock runs only once its time is set: until then, and again after it
// lost power, `is_set` is false and reading it reports Busy.
pub interface Rtc {
    // True while the clock runs from a time it was given.
    fn is_set(&mut self) -> bool!Error
    // The time, a multiple of resolution_ms(). Busy if it is not set.
    fn now_ms(&mut self) -> u64!Error
    // Set the time and start the clock; times between its steps round
    // down. InvalidInput if the clock cannot count that far.
    fn set_ms(&mut self, time_ms: u64) -> void!Error
    // How long one step of the clock is: 1 for a clock that counts
    // milliseconds, 1000 for one that counts seconds.
    fn resolution_ms(&self) -> u32
}

// A real-time clock's alarm: it fires once, when the clock reaches the time
// it was given, like a counter's Alarm. Chips raise an interrupt when it
// fires, and some wake from sleep for it; their clock types say how.
pub interface RtcAlarm {
    // Fire when now_ms() reaches `time_ms`, replacing an earlier alarm and
    // clearing an earlier firing. A time already reached fires at once.
    // Busy if the clock is not set; InvalidInput if the alarm cannot reach
    // that far ahead.
    fn set_alarm_ms(&mut self, time_ms: u64) -> void!Error
    // True once the alarm has fired, until clear_alarm.
    fn alarm_fired(&mut self) -> bool!Error
    // Disarm the alarm and acknowledge it if it fired. An interrupt handler
    // has to, or the interrupt stays raised.
    fn clear_alarm(&mut self) -> void!Error
}

// A watchdog: once started, it resets the chip unless the program feeds it
// again within its timeout, so firmware that hangs restarts instead of
// staying stuck. Its timeout is set when it is started; drivers and tasks
// that run long loops only feed it.
pub interface Watchdog {
    // Count down from the timeout again.
    fn feed(&mut self)
}

// Why the chip last started, as its watchdog reports it.
pub enum ResetReason {
    // Not the watchdog: power-up, the reset pin, a debugger, or the boot
    // ROM, for example after flashing.
    Other,
    // The watchdog was not fed before its timeout, or a panic halted the
    // program while the watchdog ran.
    Timeout,
    // The program reset the chip through the watchdog on purpose.
    Restart
}

pub fn reset_reason_name(reason: ResetReason) -> &str from(static) {
    match reason {
        ResetReason.Other => {
            return "Other"
        }
        ResetReason.Timeout => {
            return "Timeout"
        }
        ResetReason.Restart => {
            return "Restart"
        }
    }
}

// A peripheral's 32-bit registers at byte offsets, for peripheral drivers.
pub interface Registers {
    fn read(&mut self, offset: usize) -> u32
    fn write(&mut self, offset: usize, value: u32)
}

// The size of each element a DMA transfer moves.
pub enum DmaWidth {
    Byte,
    HalfWord,
    Word
}

// What paces a DMA transfer.
pub enum DmaPace {
    // Nothing: the channel moves elements as fast as the bus allows, as
    // for a copy between two buffers.
    Unpaced,
    // The peripheral register the transfer writes to: an element moves
    // whenever the peripheral has room, such as a UART's transmit FIFO.
    Destination,
    // The peripheral register the transfer reads from: an element moves
    // whenever the peripheral has one, such as a UART's receive FIFO.
    Source
}

// An address that wraps around a ring of `1 << bits` bytes, aligned to its
// size, instead of running on: a receiver keeps writing into the same
// buffer, or a transmitter keeps reading from it.
pub enum DmaRing {
    None,
    Source(u32),
    Destination(u32)
}

// One DMA transfer: `count` elements of `width` from `source` to
// `destination`. An address that increments advances by one element after
// each; one that does not stays on a peripheral register.
pub struct DmaTransfer {
    pub source: usize
    pub destination: usize
    pub count: u32
    pub width: DmaWidth
    pub increment_source: bool
    pub increment_destination: bool
    pub pace: DmaPace
    pub ring: DmaRing
}

// The address of `bytes`' first byte, for a DMA transfer's source or
// destination. Taking it is safe; the channel's start is the unsafe step.
pub fn address_of(bytes: &[u8]) -> usize {
    // SAFETY: the pointer becomes a number and is never dereferenced here.
    unsafe {
        return ptr.as_ptr(bytes) as usize
    }
}

// A DMA channel: moves data between memory and peripherals while the
// processor does other work. Peripheral drivers start transfers through it
// and chip packages implement it, so drivers that use DMA name no chip.
// Drivers keep their buffers borrowed until the transfer is done or
// aborted, as starting one is unsafe; applications use their safe methods.
pub interface DmaChannel {
    // Start `transfer`. InvalidInput if the channel cannot pace by the
    // peripheral named, wrap a ring of that size, or move that many
    // elements; Busy if a transfer is still running.
    // SAFETY: the memory the transfer reads and writes must stay valid,
    // and nothing else may access the memory it writes, until it is done or
    // aborted.
    unsafe fn start(&mut self, transfer: DmaTransfer) -> void!Error
    // True while a transfer is running.
    fn is_busy(&mut self) -> bool
    // The elements the running transfer has yet to move: 0 once it is done.
    fn remaining(&mut self) -> u32
    // The largest count a transfer may have.
    fn max_count(&mut self) -> u32
    // Stop the running transfer, if any, and wait until the channel no
    // longer touches memory.
    fn abort(&mut self)
    // Bus if a transfer since the last call hit a bus error, such as an
    // address with nothing behind it, which stops it.
    fn take_error(&mut self) -> void!Error
}

// Common I2C bus frequencies: standard mode, fast mode, and fast mode plus.
// Every device supports standard mode; most sensors also fast mode.
pub const I2C_STANDARD_HZ: u32 = 100_000
pub const I2C_FAST_HZ: u32 = 400_000
pub const I2C_FAST_PLUS_HZ: u32 = 1_000_000

// SPI clock polarity and phase, as numbered in device datasheets. Mode 0,
// clock idle low and data sampled on the rising edge, is the most common.
pub enum SpiMode {
    // Clock idles low; data is sampled on the rising (first) edge.
    Mode0,
    // Clock idles low; data is sampled on the falling (second) edge.
    Mode1,
    // Clock idles high; data is sampled on the falling (first) edge.
    Mode2,
    // Clock idles high; data is sampled on the rising (second) edge.
    Mode3
}

// Register fields are plain mask constants of the register's type, as in a
// datasheet or C header, so they cost nothing and can be reused freely:
//
//     const ENABLE: u32 = 1 << 0
//     const MODE: u32 = 0b111 << 4
//
// A mask must be nonzero and its bits contiguous.

// The lowest set bit of a nonzero mask, the factor that moves a field value
// into register position. Division and multiplication by it compile to shifts.
fn unit<T>(mask: T) -> T {
    one: T = 1
    return mask & ~(mask - one)
}

// `value` moved into the position of `mask`. Traps if it does not fit, so a
// wrong value never silently changes a neighbouring field.
pub fn encode<T>(mask: T, value: T) -> T {
    step := unit(mask)
    core.assert(value <= mask / step)
    return value * step
}

// The field `mask` extracted from a whole register value.
pub fn decode<T>(mask: T, register: T) -> T {
    return (register & mask) / unit(mask)
}

// One memory-mapped register holding T (u8, u16, u32, or u64 up to the target
// pointer width). Every access is a single volatile load or store of T; the
// compiler never merges, removes, or splits it.
//
// A Reg is move-only. Owning it is the permission to touch that register, so
// build peripheral structs from Reg fields and hand them out once.
pub struct Reg<T> {
    address: usize

    // SAFETY: `address` must be a valid, T-aligned device register for this
    // target, accessible with T-sized loads and stores, and no other handle
    // or code may access it in a conflicting way while this handle exists.
    pub unsafe fn at(address: usize) -> Reg<T> {
        return Reg<T> { address }
    }

    pub fn address(&self) -> usize {
        return self.address
    }

    pub fn read(&self) -> T {
        // SAFETY: `at` guarantees a valid register owned by this handle.
        unsafe {
            return ptr.read_volatile(self.address as *const T)
        }
    }

    pub fn write(&mut self, value: T) {
        // SAFETY: `at` guarantees a valid register owned by this handle.
        unsafe {
            ptr.write_volatile(self.address as *mut T, value)
        }
    }

    // Read-modify-write: clear the `clear` bits, then set the `set` bits.
    // Not atomic with respect to interrupts; wrap shared registers in a
    // `Critical` section or use the chip's set/clear aliases instead.
    pub fn modify(&mut self, clear: T, set: T) {
        value := self.read()
        self.write((value & ~clear) | set)
    }

    pub fn set_bits(&mut self, mask: T) {
        value := self.read()
        self.write(value | mask)
    }

    pub fn clear_bits(&mut self, mask: T) {
        value := self.read()
        self.write(value & ~mask)
    }

    // True when any bit in `mask` reads as one.
    pub fn any(&self, mask: T) -> bool {
        zero: T = 0
        return (self.read() & mask) != zero
    }

    // The value of the field `mask`.
    pub fn get(&self, mask: T) -> T {
        return decode(mask, self.read())
    }

    // Read-modify-write of the field `mask`. Traps if `value` does not fit.
    pub fn set(&mut self, mask: T, value: T) {
        bits := encode(mask, value)
        self.modify(mask, bits)
    }

    // Poll until every bit in `mask` reads one, at most `attempts` reads.
    // Use it for ready flags; a stuck device then yields Error.Timeout
    // instead of hanging forever.
    pub fn wait_set(&self, mask: T, attempts: u32) -> void!Error {
        for _ in 0..attempts {
            if (self.read() & mask) == mask {
                return ok()
            }
        }
        return err(Error.Timeout)
    }

    // Poll until every bit in `mask` reads zero, at most `attempts` reads.
    pub fn wait_clear(&self, mask: T, attempts: u32) -> void!Error {
        zero: T = 0
        for _ in 0..attempts {
            if (self.read() & mask) == zero {
                return ok()
            }
        }
        return err(Error.Timeout)
    }
}

// A peripheral's 32-bit registers at byte offsets from one base address.
// Implements Registers, so drivers in
// `std/embedded/peripheral` reach the hardware through it. Every access is
// one volatile 32-bit load or store, like `Reg<u32>`. Move-only: owning it is
// the permission to use the whole block.
pub struct RegisterBlock: Registers {
    base: usize

    // SAFETY: `base` must be the 4-aligned base address of one peripheral on
    // this target, every offset its driver uses must be a valid 32-bit
    // register of it, and no other handle or code may access those registers
    // in a conflicting way while this handle exists.
    pub unsafe fn at(base: usize) -> RegisterBlock {
        return RegisterBlock { base }
    }

    pub fn base(&self) -> usize {
        return self.base
    }

    pub fn read(&mut self, offset: usize) -> u32 {
        // SAFETY: `at` guarantees a valid register block owned by this handle.
        unsafe {
            return ptr.read_volatile((self.base + offset) as *const u32)
        }
    }

    pub fn write(&mut self, offset: usize, value: u32) {
        // SAFETY: `at` guarantees a valid register block owned by this handle.
        unsafe {
            ptr.write_volatile((self.base + offset) as *mut u32, value)
        }
    }
}

// Masks interrupts on the current core while it is alive and restores the
// previous state when dropped, so sections nest correctly:
//
//     section := hal.Critical.enter()
//     unsafe { TICKS += 1 }
//     core.drop(section)
//
// Bare-metal Cortex-M and RISC-V mask interrupts; hosted OS targets have no
// interrupts visible to programs and make this a no-op. It never excludes
// other threads or cores; use `std/sync` for those.
pub struct Critical {
    were_enabled: bool

    pub fn enter() -> Critical {
        return Critical { were_enabled: cpu.disable_interrupts() }
    }

    fn drop(&mut self) {
        // SAFETY: restores exactly the state saved by the matching enter.
        unsafe {
            cpu.restore_interrupts(self.were_enabled)
        }
    }
}

// A slot for an interrupt handler registered at run time. The vector-table
// entry point stays an `extern "C"` function with the interrupt's name and
// calls `run`, so firmware can switch handlers without rebuilding:
//
//     static mut TIMER: hal.Handler = hal.NO_HANDLER
//
//     extern "C" fn TIMER_IRQ_0() {
//         unsafe { TIMER.run() }
//     }
//
//     section := hal.Critical.enter()
//     unsafe { TIMER.set(on_tick) }
//     core.drop(section)
//
// A handler is a plain function pointer, so it captures no locals and stays
// valid for the whole program; it keeps state in `static mut` storage. Change
// a shared slot inside a critical section, which also orders the store before
// the next interrupt on this core.
pub struct Handler {
    function: Option<fn()>

    pub fn set(&mut self, function: fn()) {
        self.function = some(function)
    }
    pub fn clear(&mut self) {
        self.function = none
    }
    pub fn is_set(&self) -> bool {
        match &self.function {
            some(_) => true,
            none => false,
        }
    }
    // Calls the registered handler; false when the slot is empty.
    pub fn run(&self) -> bool {
        match &self.function {
            some(function) => {
                function()
                true
            },
            none => false,
        }
    }
}

// An empty handler slot, for initializing `static mut` storage.
pub const NO_HANDLER: Handler = Handler { function: none }

// Drive an output pin to `high`.
pub fn write_pin<P: OutputPin>(pin: &mut P, high: bool) {
    if high {
        pin.set_high()
    } else {
        pin.set_low()
    }
}

pub fn delay_ms<D: Delay>(delay: &mut D, milliseconds: u32) {
    for _ in 0..milliseconds {
        delay.delay_us(1000)
    }
}

// `time + microseconds`, or the largest time if that does not fit.
fn later(time: u64, microseconds: u64) -> u64 {
    if microseconds > 0xFFFF_FFFF_FFFF_FFFFu64 - time {
        return 0xFFFF_FFFF_FFFF_FFFFu64
    }
    return time + microseconds
}

// The microseconds a counter has run since `since_us`, one of its own
// now_us times; 0 for a time still ahead.
pub fn elapsed_us<C: Counter>(counter: &C, since_us: u64) -> u64 {
    now := counter.now_us()
    if now <= since_us {
        return 0
    }
    return now - since_us
}

// Busy-wait until a counter reaches `time_us`.
pub fn wait_until<C: Counter>(counter: &C, time_us: u64) {
    for counter.now_us() < time_us {}
}

// Fire an alarm `microseconds` from now. InvalidInput if that lies beyond
// the alarm's reach.
pub fn schedule_in_us<A: Alarm>(alarm: &mut A, microseconds: u64) -> void!Error {
    time := later(alarm.now_us(), microseconds)
    return alarm.schedule_at_us(time)
}

// Busy-wait until an alarm fires, then clear it.
pub fn wait_for_alarm<A: Alarm>(alarm: &mut A) {
    for !alarm.fired() {}
    alarm.clear()
}

// A time on a counter by which something must have happened, for drivers
// that poll a device and give up on one that is stuck:
//
//     deadline := hal.Deadline.after(timer, 10_000)
//     for !ready(bus)? {
//         if deadline.passed(timer) {
//             return err(hal.Error.Timeout)
//         }
//     }
//
// It holds only the time, so it never borrows the counter, and the same
// counter can delay between checks.
pub struct Deadline {
    time: u64

    // The deadline at `time_us`, a now_us time of the counter it is checked
    // against.
    pub fn at(time_us: u64) -> Deadline {
        return Deadline { time: time_us }
    }

    // The deadline `microseconds` from the counter's present time.
    pub fn after<C: Counter>(counter: &C, microseconds: u64) -> Deadline {
        return Deadline { time: later(counter.now_us(), microseconds) }
    }

    pub fn time_us(&self) -> u64 {
        return self.time
    }

    // True once the counter has reached the deadline.
    pub fn passed<C: Counter>(&self, counter: &C) -> bool {
        return counter.now_us() >= self.time
    }

    // The microseconds left until the deadline; 0 once it has passed.
    pub fn remaining_us<C: Counter>(&self, counter: &C) -> u64 {
        now := counter.now_us()
        if now >= self.time {
            return 0
        }
        return self.time - now
    }

    // Busy-wait until the counter reaches the deadline.
    pub fn wait<C: Counter>(&self, counter: &C) {
        wait_until(counter, self.time)
    }
}

// Ticks at a fixed period on a counter, for work that repeats, such as
// sampling a sensor every 10 ms. Each tick falls a whole number of periods
// after the start, so the ticks do not drift however late they are seen. A
// tick missed entirely, because the program was busy for longer than a
// period, is skipped rather than delivered late.
pub struct Ticker {
    next: u64
    period: u64

    // Ticks every `period_us`, at least 1, the first one period from now.
    pub fn start<C: Counter>(counter: &C, period_us: u64) -> Ticker {
        core.assert(period_us > 0)
        return Ticker { next: later(counter.now_us(), period_us), period: period_us }
    }

    pub fn period_us(&self) -> u64 {
        return self.period
    }

    // The counter time of the next tick.
    pub fn next_us(&self) -> u64 {
        return self.next
    }

    // True once per tick: when the counter has reached the next tick, which
    // then moves on to the first tick still ahead.
    pub fn ready<C: Counter>(&mut self, counter: &C) -> bool {
        now := counter.now_us()
        if now < self.next {
            return false
        }
        missed := (now - self.next) / self.period
        self.next = later(self.next, (missed + 1) * self.period)
        return true
    }

    // Busy-wait for the next tick.
    pub fn wait<C: Counter>(&mut self, counter: &C) {
        for !self.ready(counter) {}
    }
}

// Set a PWM output high for `numerator / denominator` of each period,
// rounded to the nearest step the output has. InvalidInput if the
// denominator is zero or below the numerator.
pub fn set_duty_fraction<P: PwmOutput>(output: &mut P, numerator: u32, denominator: u32) -> void!Error {
    if denominator == 0 || numerator > denominator {
        return err(Error.InvalidInput)
    }
    steps := output.max_duty() as u64
    duty := (numerator as u64 * steps + denominator as u64 / 2) / denominator as u64
    return output.set_duty(duty as u16)
}

// Set a PWM output high for `percent` of each period, 0 to 100.
pub fn set_duty_percent<P: PwmOutput>(output: &mut P, percent: u32) -> void!Error {
    return set_duty_fraction(output, percent, 100)
}

// Make a PWM output's pulses `pulse_us` long, for an output whose period is
// `period_us`: a hobby servo, for example, expects a 50 Hz output (a period
// of 20_000 us) and turns from one end to the other as the pulse goes from
// about 1000 to 2000 us. InvalidInput if the pulse is longer than the
// period.
pub fn set_pulse_us<P: PwmOutput>(output: &mut P, pulse_us: u32, period_us: u32) -> void!Error {
    return set_duty_fraction(output, pulse_us, period_us)
}

// One read of an analog input as a voltage in millivolts, for a converter
// whose reference is `reference_mv`, such as 3300 for a 3.3 V supply.
pub fn read_millivolts<A: AnalogInput>(input: &mut A, reference_mv: u32) -> u32!Error {
    value := input.read()? as u64
    full := input.max_value() as u64
    if full == 0 {
        return err(Error.Unsupported)
    }
    return ok(((value * reference_mv as u64 + full / 2) / full) as u32)
}

// Real-time clock times as calendar values. The calendar is UTC; shift by
// a time zone's offset with `time.DateTime.checked_add` or `checked_sub`.

// `time_ms`, milliseconds since the Unix epoch, as a UTC date and time.
pub fn date_time_of_ms(time_ms: u64) -> time.DateTime!Error {
    seconds := (time_ms / 1000) as i64
    nanoseconds := ((time_ms % 1000) as u32) * 1_000_000
    stamp := match time.Timestamp.new(seconds, nanoseconds) {
        ok(value) => value,
        err(_) => {
            return err(Error.InvalidInput)
        },
    }
    match time.DateTime.from_timestamp(&stamp) {
        ok(value) => {
            return ok(value)
        },
        err(_) => {
            return err(Error.InvalidInput)
        },
    }
}

// `value` as milliseconds since the Unix epoch, rounded down; InvalidInput
// before the epoch.
pub fn ms_of_date_time(value: &time.DateTime) -> u64!Error {
    stamp := value.to_timestamp()
    if stamp.seconds() < 0 {
        return err(Error.InvalidInput)
    }
    return ok(stamp.seconds() as u64 * 1000 + (stamp.subsec_nanos() / 1_000_000) as u64)
}

// The clock's time as a UTC date and time. Busy if it is not set.
pub fn rtc_now<R: Rtc>(clock: &mut R) -> time.DateTime!Error {
    time_ms := clock.now_ms()?
    return date_time_of_ms(time_ms)
}

// Set the clock to `value`, a UTC date and time. InvalidInput before the
// epoch or past what the clock counts to.
pub fn rtc_set<R: Rtc>(clock: &mut R, value: &time.DateTime) -> void!Error {
    time_ms := ms_of_date_time(value)?
    return clock.set_ms(time_ms)
}

// Fire the clock's alarm at `value`, a UTC date and time.
pub fn rtc_alarm_at<R: RtcAlarm>(clock: &mut R, value: &time.DateTime) -> void!Error {
    time_ms := ms_of_date_time(value)?
    return clock.set_alarm_ms(time_ms)
}

// Fire the clock's alarm `milliseconds` after now_ms(); 0 fires at once.
// A clock that counts seconds reports the start of the current second, so
// its alarm fires up to a second early.
pub fn rtc_alarm_in<R: Rtc + RtcAlarm>(clock: &mut R, milliseconds: u64) -> void!Error {
    now := clock.now_ms()?
    return clock.set_alarm_ms(later(now, milliseconds))
}

// Most I2C sensors expose numbered 8-bit registers. These helpers implement
// the common "write register number, then read or write data" transactions.

pub fn read_register<B: I2c>(bus: &mut B, address: u8, register: u8) -> u8!Error {
    command: [1]u8 = [register]
    value: [1]u8 = [0]
    bus.write_read(address, &command, &mut value)?
    return ok(value[0])
}

pub fn read_registers<B: I2c>(bus: &mut B, address: u8, first: u8, buffer: &mut[u8]) -> void!Error {
    command: [1]u8 = [first]
    return bus.write_read(address, &command, buffer)
}

pub fn write_register<B: I2c>(bus: &mut B, address: u8, register: u8, value: u8) -> void!Error {
    command: [2]u8 = [register, value]
    return bus.write(address, &command)
}

// One device on a shared SPI bus, selected by an active-low chip-select pin.
// The device owns its pin; the bus is passed to each transaction, so several
// devices share one bus and the borrow checker keeps transactions apart.
pub struct SpiDevice<P: OutputPin> {
    select: P

    // Takes the chip-select pin and deselects the device.
    pub fn new(select: P) -> SpiDevice<P> {
        device := SpiDevice<P> { select }
        device.select.set_high()
        return device
    }

    // Full-duplex exchange in place with the device selected.
    pub fn transfer<B: Spi>(&mut self, bus: &mut B, bytes: &mut[u8]) -> void!Error {
        self.select.set_low()
        result := bus.transfer(bytes)
        self.select.set_high()
        return result
    }

    pub fn write<B: Spi>(&mut self, bus: &mut B, bytes: &[u8]) -> void!Error {
        self.select.set_low()
        result := bus.write(bytes)
        self.select.set_high()
        return result
    }

    // Write `command`, then read `buffer.len` bytes in the same selection.
    pub fn write_read<B: Spi>(&mut self, bus: &mut B, command: &[u8], buffer: &mut[u8]) -> void!Error {
        self.select.set_low()
        match bus.write(command) {
            ok() => {}
            err(error) => {
                self.select.set_high()
                return err(error)
            }
        }
        for index in 0..buffer.len {
            buffer[index] = 0
        }
        result := bus.transfer(buffer)
        self.select.set_high()
        return result
    }

    // Give back the chip-select pin.
    pub fn release(self) -> P {
        let SpiDevice { select } = self
        return select
    }
}
