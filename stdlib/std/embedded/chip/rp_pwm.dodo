package rp_pwm

import "std/embedded/chip/rp_timer"
import "std/embedded/hal"

// The PWM block the RP2040 and RP2350 share (RP2040 datasheet 4.5, RP2350
// datasheet 12.5). Eight slices serve GPIO 0 to 29, each a 16-bit counter
// with two outputs, A and B: GPIO n is output A of slice (n / 2) % 8 when n
// is even and output B when it is odd, so GPIO 0 and 16, for example, carry
// the same output. The RP2350's slices 8 to 11 serve the RP2350B's GPIO 32
// to 47: GPIO n is an output of slice 8 + ((n - 32) / 2) % 4, so GPIO 32
// and 40 carry the same output (RP2350 datasheet 9.4).
//
// A slice counts at clk_sys / divider from 0 to its TOP and wraps. An
// output is high while the count is below its compare value, so its duty
// cycle is compare / (TOP + 1) and its frequency
// clk_sys / divider / (TOP + 1). The two outputs of a slice share the
// divider and TOP, and so their frequency. Compare values and TOP take
// effect when the counter wraps, so a period is never cut short.
//
// `Channel` is one output over any hal.Registers: a `hal.RegisterBlock` at
// the block's base on the chip, or a simulated block in a desktop test. It
// implements hal.PwmOutput. `Capture` instead measures the signal on a B
// pin with the slice's counter; see "Input capture" below. `SliceTimer`
// uses a slice without pins, as a periodic timer and a counter; see
// "Slices as timers" below. The outputs of a slice write their own bits of
// shared registers through the block's atomic XOR, set, and clear aliases,
// at 0x1000, 0x2000, and 0x3000 above each register, so neither disturbs
// the other, nor an interrupt handler that owns one of them.

// Slice registers, SLICE_STRIDE apart.
const CSR: usize = 0x00
const DIV: usize = 0x04
const CTR: usize = 0x08
const CC: usize = 0x0C
const TOP: usize = 0x10
const SLICE_STRIDE: usize = 0x14

// The wrap interrupt registers, from INTR (interrupt_offset): the raw
// flags, one bit per slice, set when its counter wraps and cleared by
// writing one; and the enables of the interrupt PWM_IRQ_WRAP (RP2040) or
// PWM_IRQ_WRAP_0 (RP2350, IRQ0_INTE). The RP2350's second line,
// PWM_IRQ_WRAP_1, has its own enables at INTR + 0x10, which are not used.
const INTE: usize = 4

// Atomic register aliases (RP2040 datasheet 2.1.2).
const XOR_ALIAS: usize = 0x1000
const SET_ALIAS: usize = 0x2000
const CLEAR_ALIAS: usize = 0x3000

// CSR: the slice counts, and output A or B is inverted.
const ENABLE: u32 = 1 << 0
const INVERT_A: u32 = 1 << 2

// The slices GPIO 0 to 31 reach.
pub const SLICE_COUNT: u32 = 8
// The GPIOs with a PWM output, on the chips that have them: GPIO 0 to 47.
// The chip packages' Pins refuse GPIOs the chip lacks.
pub const PIN_COUNT: u32 = 48

// The divider is a fixed-point number in sixteenths: 16 divides by one,
// 4095 by 255 15/16.
pub const MIN_DIVIDER: u32 = 16
pub const MAX_DIVIDER: u32 = 4095
// The largest TOP: one short of 16 bits, so that the compare value that
// holds an output high, TOP + 1, still fits its 16-bit field.
pub const MAX_TOP: u32 = 0xFFFE

// The slice of GPIO `pin`.
pub fn slice_of(pin: u32) -> u32 {
    if pin >= 32 {
        return SLICE_COUNT + ((pin - 32) / 2) % 4
    }
    return (pin / 2) % SLICE_COUNT
}

// The output of GPIO `pin` within its slice: 0 for A, 1 for B.
pub fn output_of(pin: u32) -> u32 {
    return pin % 2
}

// A slice's divider and TOP, from `timing` or `divided`.
pub struct Timing {
    // The block's input clock, clk_sys, in hertz.
    pub clock_hz: u32
    // The divider in sixteenths, MIN_DIVIDER to MAX_DIVIDER.
    pub divider: u32
    // The count the counter wraps after, 0 to MAX_TOP: a period is TOP + 1
    // counts, and outputs have TOP + 2 duty steps, 0 to TOP + 1.
    pub top: u32

    // The resulting frequency, rounded to whole hertz.
    pub fn frequency_hz(&self) -> u32 {
        counts := self.divider as u64 * (self.top as u64 + 1)
        return ((self.clock_hz as u64 * 16 + counts / 2) / counts) as u32
    }
}

// The divider and TOP closest to `frequency_hz` with the finest duty steps:
// the smallest divider whose period fits in MAX_TOP + 1 counts. At a
// clk_sys of 125 MHz, from 8 Hz to 62.5 MHz; up to 1907 Hz the period
// has the full 65535 counts. InvalidInput outside that range.
pub fn timing(clock_hz: u32, frequency_hz: u32) -> Timing!hal.Error {
    if frequency_hz == 0 {
        return err(hal.Error.InvalidInput)
    }
    scaled := clock_hz as u64 * 16
    period := frequency_hz as u64 * (MAX_TOP as u64 + 1)
    divider := (scaled + period - 1) / period
    if divider < MIN_DIVIDER as u64 {
        divider = MIN_DIVIDER as u64
    }
    if divider > MAX_DIVIDER as u64 {
        return err(hal.Error.InvalidInput)
    }
    counts := (scaled + divider * frequency_hz as u64 / 2) / (divider * frequency_hz as u64)
    if counts > MAX_TOP as u64 + 1 {
        counts = MAX_TOP as u64 + 1
    }
    if counts < 2 {
        return err(hal.Error.InvalidInput)
    }
    return ok(Timing { clock_hz, divider: divider as u32, top: (counts - 1) as u32 })
}

// A timing with a given divider, in sixteenths, and TOP. InvalidInput if
// either is out of range.
pub fn divided(clock_hz: u32, divider: u32, top: u32) -> Timing!hal.Error {
    if divider < MIN_DIVIDER || divider > MAX_DIVIDER || top > MAX_TOP {
        return err(hal.Error.InvalidInput)
    }
    return ok(Timing { clock_hz, divider, top })
}

// The outputs handed out, one bit each, slice * 2 + output. A chip has one
// PWM block, so one set serves the program.
static mut CLAIMED: u32 = 0

// One output of a slice, driving the GPIO it is routed to. Implements
// hal.PwmOutput: max_duty is TOP + 1, so a duty of 0 holds the output low
// and max_duty holds it high.
pub struct Channel<R: hal.Registers>: hal.PwmOutput {
    registers: R
    pin: u32
    // The slice's registers, from the block's base.
    base: usize
    // This output's bit within the slice's compare value and its CSR
    // invert bit, and its bit in CLAIMED and its sibling's.
    shift: u32
    invert: u32
    bit: u32
    sibling: u32
    timing: Timing
    duty: u16
    // INTR's offset in the block.
    interrupts: usize

    // Start output `output_of(pin)` of slice `slice_of(pin)` at `timing`,
    // low. If the slice's other output is already in use, the slice keeps
    // running and `timing` must be what it runs at: Busy otherwise, and Busy
    // if this output is in use too. InvalidInput above GPIO 47 or for a GPIO
    // whose slice the block lacks. The block has the RP2040's 8 slices,
    // which places its wrap flags; new_in names another count.
    // SAFETY: `registers` must be the PWM block's, out of reset and clocked
    // at timing.clock_hz, and only Channels may use it.
    pub unsafe fn new(registers: R, pin: u32, timing: Timing) -> Channel<R>!hal.Error {
        unsafe {
            return Channel.new_in(registers, SLICE_COUNT, pin, timing)
        }
    }

    // `new` in a block of `slices` slices: 8 on the RP2040, 12 on the
    // RP2350.
    // SAFETY: as for `new`.
    pub unsafe fn new_in(registers: R, slices: u32, pin: u32, timing: Timing) -> Channel<R>!hal.Error {
        if pin >= PIN_COUNT || slice_of(pin) >= slices {
            return err(hal.Error.InvalidInput)
        }
        slice := slice_of(pin)
        output := output_of(pin)
        bit := 1u32 << (2 * slice + output)
        sibling := 1u32 << (2 * slice + 1 - output)
        channel := Channel<R> {
            registers,
            pin,
            base: SLICE_STRIDE * slice as usize,
            shift: 16 * output,
            invert: INVERT_A << output,
            bit,
            sibling,
            timing,
            duty: 0,
            interrupts: interrupt_offset(slices),
        }
        section := hal.Critical.enter()
        // SAFETY: interrupts are masked, so CLAIMED is read and changed
        // atomically on this core; only core 0 runs.
        claimed := unsafe {
            CLAIMED
        }
        if (claimed & bit) != 0 {
            core.drop(section)
            return err(hal.Error.Busy)
        }
        if (claimed & sibling) != 0 {
            divider := channel.timing.divider
            top := channel.timing.top
            if !channel.runs_at(divider, top) {
                core.drop(section)
                return err(hal.Error.Busy)
            }
        } else {
            channel.registers.write(channel.base + CSR, 0)
            channel.registers.write(channel.base + DIV, channel.timing.divider)
            channel.registers.write(channel.base + TOP, channel.timing.top)
            channel.registers.write(channel.base + CC, 0)
            channel.registers.write(channel.base + CTR, 0)
            channel.registers.write(channel.base + CSR, ENABLE)
        }
        channel.write_compare(0)
        channel.registers.write(channel.base + CSR + CLEAR_ALIAS, channel.invert)
        unsafe {
            CLAIMED = claimed | bit
        }
        core.drop(section)
        return ok(channel)
    }

    pub fn max_duty(&self) -> u16 {
        return (self.timing.top + 1) as u16
    }

    // The output is high for duty / max_duty of each period, from the next
    // period on. InvalidInput above max_duty.
    pub fn set_duty(&mut self, duty: u16) -> void!hal.Error {
        if duty as u32 > self.timing.top + 1 {
            return err(hal.Error.InvalidInput)
        }
        self.write_compare(duty)
        return ok()
    }

    // The duty last set.
    pub fn duty(&self) -> u16 {
        return self.duty
    }

    // The slice's divider and TOP.
    pub fn timing(&self) -> Timing {
        return Timing { clock_hz: self.timing.clock_hz, divider: self.timing.divider, top: self.timing.top }
    }

    pub fn frequency_hz(&self) -> u32 {
        return self.timing.frequency_hz()
    }

    // The GPIO the output was started for.
    pub fn pin(&self) -> u32 {
        return self.pin
    }

    // The slice, 0 to 7, and the output within it, 0 for A and 1 for B.
    pub fn slice(&self) -> u32 {
        return (self.base / SLICE_STRIDE) as u32
    }

    pub fn output(&self) -> u32 {
        return self.shift / 16
    }

    // Change the frequency to the closest to `frequency_hz`, as `timing`
    // finds it, keeping the duty cycle. Busy if the slice's other output is
    // in use, since it shares the frequency, unless the timing does not
    // change; InvalidInput if the frequency is out of range.
    pub fn set_frequency(&mut self, frequency_hz: u32) -> void!hal.Error {
        changed := timing(self.timing.clock_hz, frequency_hz)?
        return self.set_timing(changed)
    }

    // Change the divider and TOP, as from `divided`, keeping the duty cycle
    // as closely as the new duty steps allow. Busy as for set_frequency.
    pub fn set_timing(&mut self, timing: Timing) -> void!hal.Error {
        section := hal.Critical.enter()
        // SAFETY: as in `new`.
        claimed := unsafe {
            CLAIMED
        }
        if (claimed & self.sibling) != 0 && !self.runs_at(timing.divider, timing.top) {
            core.drop(section)
            return err(hal.Error.Busy)
        }
        old_steps := self.timing.top as u64 + 1
        duty := (self.duty as u64 * (timing.top as u64 + 1) + old_steps / 2) / old_steps
        self.registers.write(self.base + DIV, timing.divider)
        self.registers.write(self.base + TOP, timing.top)
        self.timing = timing
        self.write_compare(duty as u16)
        core.drop(section)
        return ok()
    }

    // Invert the output: high while the count is at or above the compare
    // value instead of below it.
    pub fn set_inverted(&mut self, inverted: bool) {
        if inverted {
            self.registers.write(self.base + CSR + SET_ALIAS, self.invert)
        } else {
            self.registers.write(self.base + CSR + CLEAR_ALIAS, self.invert)
        }
    }

    // The slice's count, 0 to TOP, which advances while the slice runs.
    pub fn count(&mut self) -> u32 {
        return self.registers.read(self.base + CTR) & 0xFFFF
    }

    // Whether the slice's counter wrapped, ending a period, since the flag
    // was last cleared. The flag and the wrap interrupt belong to the
    // slice, so both outputs of a slice see them; with both in use, let
    // one of them handle the interrupt. Compare values set in a period take
    // effect at its wrap, so a handler that sets the next duty has a whole
    // period to do it.
    pub fn wrapped(&mut self) -> bool {
        return (self.registers.read(self.interrupts) & self.slice_bit()) != 0
    }

    // Clear the wrap flag. A wrap interrupt handler has to, or the
    // interrupt stays raised.
    pub fn clear_wrap(&mut self) {
        bit := self.slice_bit()
        self.registers.write(self.interrupts, bit)
    }

    // Raise the wrap interrupt, PWM_IRQ_WRAP on the RP2040 and
    // PWM_IRQ_WRAP_0 on the RP2350, while the wrap flag is set.
    pub fn listen_wrap(&mut self) {
        bit := self.slice_bit()
        self.registers.write(self.interrupts + INTE + SET_ALIAS, bit)
    }

    // Stop raising the wrap interrupt; `wrapped` still reports.
    pub fn ignore_wrap(&mut self) {
        bit := self.slice_bit()
        self.registers.write(self.interrupts + INTE + CLEAR_ALIAS, bit)
    }

    pub fn is_listening_wrap(&mut self) -> bool {
        return (self.registers.read(self.interrupts + INTE) & self.slice_bit()) != 0
    }

    // Hold the output low and give it up, and stop the slice if its other
    // output is not in use either, with its wrap interrupt off and its
    // flag clear. Returns the registers.
    pub fn release(self) -> R {
        self.write_compare(0)
        self.set_inverted(false)
        section := hal.Critical.enter()
        // SAFETY: as in `new`.
        unsafe {
            CLAIMED &= ~self.bit
            if (CLAIMED & self.sibling) == 0 {
                self.registers.write(self.base + CSR + CLEAR_ALIAS, ENABLE)
                self.ignore_wrap()
                self.clear_wrap()
            }
        }
        core.drop(section)
        let Channel { registers, pin, base, shift, invert, bit, sibling, timing, duty, interrupts } = self
        return registers
    }

    // The slice's bit in the wrap interrupt registers.
    fn slice_bit(&self) -> u32 {
        return 1u32 << (self.base / SLICE_STRIDE) as u32
    }

    // Whether the slice runs with `divider` and `top` now.
    fn runs_at(&mut self, divider: u32, top: u32) -> bool {
        return self.registers.read(self.base + DIV) == divider && self.registers.read(self.base + TOP) == top
    }

    // Change this output's half of the shared compare register through the
    // XOR alias: the bits that differ flip and the other half stays.
    fn write_compare(&mut self, duty: u16) {
        current := (self.registers.read(self.base + CC) >> self.shift) & 0xFFFF
        self.registers.write(self.base + CC + XOR_ALIAS, (current ^ duty as u32) << self.shift)
        self.duty = duty
    }
}

// An output on the chip: a Channel over the PWM block's registers, which
// the chip packages hand out. Implements hal.PwmOutput.
pub struct Pwm: hal.PwmOutput {
    channel: Channel<hal.RegisterBlock>
    // The wrap interrupt's number.
    irq: u32

    // Channel.new_in over the block at `base`, of `slices` slices, whose
    // wrap interrupt is `irq`.
    // SAFETY: as for Channel.new, with `base` the PWM block's base address.
    pub unsafe fn at(base: usize, slices: u32, irq: u32, pin: u32, timing: Timing) -> Pwm!hal.Error {
        unsafe {
            channel := Channel.new_in(hal.RegisterBlock.at(base), slices, pin, timing)?
            return ok(Pwm { channel, irq })
        }
    }

    // The wrap interrupt, for cortex_m.enable and `@interrupt`:
    // PWM_IRQ_WRAP on the RP2040, PWM_IRQ_WRAP_0 on the RP2350. Every
    // slice raises it, so its handler checks `wrapped` on each output or
    // timer it listens for.
    pub fn irq(&self) -> u32 {
        return self.irq
    }

    pub fn wrapped(&mut self) -> bool {
        return self.channel.wrapped()
    }

    pub fn clear_wrap(&mut self) {
        self.channel.clear_wrap()
    }

    pub fn listen_wrap(&mut self) {
        self.channel.listen_wrap()
    }

    pub fn ignore_wrap(&mut self) {
        self.channel.ignore_wrap()
    }

    pub fn is_listening_wrap(&mut self) -> bool {
        return self.channel.is_listening_wrap()
    }

    pub fn max_duty(&self) -> u16 {
        return self.channel.max_duty()
    }

    pub fn set_duty(&mut self, duty: u16) -> void!hal.Error {
        return self.channel.set_duty(duty)
    }

    pub fn duty(&self) -> u16 {
        return self.channel.duty()
    }

    pub fn timing(&self) -> Timing {
        return self.channel.timing()
    }

    pub fn frequency_hz(&self) -> u32 {
        return self.channel.frequency_hz()
    }

    pub fn pin(&self) -> u32 {
        return self.channel.pin()
    }

    pub fn slice(&self) -> u32 {
        return self.channel.slice()
    }

    pub fn output(&self) -> u32 {
        return self.channel.output()
    }

    pub fn set_frequency(&mut self, frequency_hz: u32) -> void!hal.Error {
        return self.channel.set_frequency(frequency_hz)
    }

    pub fn set_timing(&mut self, timing: Timing) -> void!hal.Error {
        return self.channel.set_timing(timing)
    }

    pub fn set_inverted(&mut self, inverted: bool) {
        self.channel.set_inverted(inverted)
    }

    pub fn count(&mut self) -> u32 {
        return self.channel.count()
    }

    // Channel.release; returns the block's base address.
    pub fn release(self) -> usize {
        let Pwm { channel, irq } = self
        registers := channel.release()
        return registers.base()
    }
}

// --- Input capture ---------------------------------------------------------
//
// A slice can count from its B pin instead of the clock (RP2040 datasheet
// 4.5.2.6, RP2350 datasheet 12.5.2.6): CSR.DIVMODE 1 runs the fractional
// divider only while the pin is high, and DIVMODE 2 advances it on each
// rising edge. The slice cannot timestamp edges, so `Capture` measures by
// counting over windows of `window_us`, two per measurement, one after the
// other and continuously:
//
// 1. An edge window counts rising edges. The polls watch the count change:
//    the times of the first and last change seen and the edges between
//    them give the period, as a reciprocal counter does, so its error is
//    the timer's microsecond and the gap between polls at each end of
//    that span, at most a period per end. A program that polls only when
//    the window ends gets edges / window time, accurate to a period per
//    window.
// 2. A level window counts clk_sys cycles while the pin is high, and lasts
//    a whole number of the periods just measured, so pulses cut at its
//    start and end add up to whole ones. High time per period is the high
//    time counted divided by the periods the window lasted.
//
// The counter has 16 bits. In the level window the divider is the smallest
// that covers four windows, so a poll that comes up to three windows late
// loses nothing, and a count stands for divider / 16 clk_sys cycles: about
// a 16000th of the window, 0.6 us for 10 ms. From 33 ms (at 125 MHz; 28 ms
// at 150 MHz) the largest divider covers fewer windows, down to one at the
// longest window, and a count is 2 us (1.7 us).
//
// In the edge window the divider is a whole number, 1 to 255, that counts
// every n-th edge: it starts at 1 and is chosen after each window so that
// the next one counts at most half the counter's range. A window whose
// count wraps, which the block's raw interrupt flag for the slice (INTR)
// reports, is counted again with a divider at least four times larger, so
// a jump in frequency costs a window or a few. Edges are sampled at
// clk_sys, so the highs and lows of the signal must each last at least a
// clk_sys cycle or two.
//
// The slowest signal measured has two rising edges in a window, 200 Hz
// for a 10 ms window and 20 Hz for 100 ms. A slower signal, or a line that
// changes only once, reads as a steady line does: cycles 0, period_ns the
// level window's length, and high_ns the time the line was high in it.

// CSR: the divider runs while pin B is high, or on its rising edges.
const DIVMODE_LEVEL: u32 = 1 << 4
const DIVMODE_RISING: u32 = 2 << 4
// The counter's full range, for input capture.
const FULL_TOP: u32 = 0xFFFF
const FULL_RANGE: u64 = 0x1_0000
// The largest whole divider in edge windows.
pub const MAX_EDGE_DIVIDER: u32 = 255
// Level window dividers cover this many windows when they can.
const LEVEL_HEADROOM: u64 = 4
// A level count within this many nanoseconds of the whole window, twice
// the timer's resolution, is a line held high.
const STEADY_SLACK_NS: u64 = 2000

// The offset of INTR, the raw interrupt flags, in a PWM block of `slices`
// slices: 8 on the RP2040 (0xA4), 12 on the RP2350 (0xF4). It follows the
// slices' registers and EN.
pub fn interrupt_offset(slices: u32) -> usize {
    return SLICE_STRIDE * slices as usize + 4
}

// The divider, in sixteenths, that level windows of `window_us` count
// with at `clock_hz`: the smallest that covers four windows in 65535
// counts, or as many windows as MAX_DIVIDER covers. InvalidInput for a
// window of 0 or one longer than MAX_DIVIDER covers: 134 ms at a clk_sys
// of 125 MHz, 111 ms at 150 MHz.
pub fn capture_divider(clock_hz: u32, window_us: u32) -> u32!hal.Error {
    // clk_sys cycles in the window, in millionths. Both factors fit 32
    // bits, so the product fits 64.
    cycles := window_us as u64 * clock_hz as u64
    if window_us == 0 || cycles > max_window_cycles() {
        return err(hal.Error.InvalidInput)
    }
    counts := 0xFFFFu64 * 1_000_000
    divider := (cycles * 16 * LEVEL_HEADROOM + counts - 1) / counts
    if divider < MIN_DIVIDER as u64 {
        divider = MIN_DIVIDER as u64
    }
    if divider > MAX_DIVIDER as u64 {
        divider = MAX_DIVIDER as u64
    }
    return ok(divider as u32)
}

// The longest window, in microseconds, at `clock_hz`: what 65535 counts
// at MAX_DIVIDER cover.
pub fn max_window_us(clock_hz: u32) -> u32 {
    if clock_hz == 0 {
        return 0
    }
    longest := max_window_cycles() / clock_hz as u64
    if longest > 0xFFFF_FFFFu64 {
        return 0xFFFF_FFFF
    }
    return longest as u32
}

// window_us * clock_hz at most: 65535 counts of MAX_DIVIDER / 16 cycles,
// in millionths.
fn max_window_cycles() -> u64 {
    return 0xFFFFu64 * MAX_DIVIDER as u64 * 1_000_000 / 16
}

// Input capture on the B pin of a slice, over any hal.Registers: a
// `hal.RegisterBlock` at the PWM block's base on the chip, or a simulated
// block in a desktop test. The caller passes the time to each poll, in
// microseconds from any fixed start; `PwmCapture` reads the chip's timer
// itself and implements hal.PwmInput. The input claims both outputs of
// its slice, since it uses the slice's counter.
pub struct Capture<R: hal.Registers> {
    registers: R
    pin: u32
    // The slice's registers, from the block's base; INTR's offset and the
    // slice's bit in it; and the slice's two bits in CLAIMED.
    base: usize
    interrupts: usize
    wrap: u32
    claim: u32
    clock_hz: u32
    window_us: u32
    // The level windows' divider in sixteenths, and the edge windows'
    // whole divider.
    level_divider: u32
    edge_divider: u32
    // Whether an edge window runs, else a level window, since start_us;
    // the level window ends at deadline_us.
    counting_edges: bool
    start_us: u64
    deadline_us: u64
    // The count at the last poll, and the first and latest polls that saw
    // it change: their counts and times, and how many such polls there
    // were.
    last_count: u32
    first_count: u32
    first_us: u64
    latest_count: u32
    latest_us: u64
    changes: u32
    // The period the edge window measured, 0 for none, and the edges it
    // spans.
    period_ns: u64
    edges: u32
    // A finished measurement poll has not returned yet.
    ready: bool
    ready_period_ns: u64
    ready_high_ns: u64
    ready_cycles: u32

    // Start measuring the signal on GPIO `pin`, output B of slice
    // `slice_of(pin)`, at `now_us`, in windows of `window_us`; see
    // capture_divider for the range. `slices` is the number of slices of
    // the block, 8 on the RP2040 and 12 on the RP2350, which places INTR.
    // InvalidInput for an even pin (output A cannot count), above GPIO 47
    // or on a slice the block lacks, or for a window out of range; Busy if
    // either output of the slice is
    // in use, by a Channel or another Capture.
    // SAFETY: `registers` must be the PWM block's, out of reset and clocked
    // at `clock_hz`, and only Channels and Captures may use it; nothing
    // else may clear the slice's INTR flag.
    pub unsafe fn new(registers: R, slices: u32, clock_hz: u32, pin: u32, window_us: u32, now_us: u64) -> Capture<R>!hal.Error {
        if pin >= PIN_COUNT || output_of(pin) != 1 || slice_of(pin) >= slices {
            return err(hal.Error.InvalidInput)
        }
        level_divider := capture_divider(clock_hz, window_us)?
        slice := slice_of(pin)
        capture := Capture<R> {
            registers,
            pin,
            base: SLICE_STRIDE * slice as usize,
            interrupts: interrupt_offset(slices),
            wrap: 1u32 << slice,
            claim: 3u32 << (2 * slice),
            clock_hz,
            window_us,
            level_divider,
            edge_divider: 1,
            counting_edges: true,
            start_us: now_us,
            deadline_us: now_us,
            last_count: 0,
            first_count: 0,
            first_us: now_us,
            latest_count: 0,
            latest_us: now_us,
            changes: 0,
            period_ns: 0,
            edges: 0,
            ready: false,
            ready_period_ns: 0,
            ready_high_ns: 0,
            ready_cycles: 0,
        }
        section := hal.Critical.enter()
        // SAFETY: interrupts are masked, so CLAIMED is read and changed
        // atomically on this core; only core 0 runs.
        claimed := unsafe {
            CLAIMED
        }
        if (claimed & capture.claim) != 0 {
            core.drop(section)
            return err(hal.Error.Busy)
        }
        unsafe {
            CLAIMED = claimed | capture.claim
        }
        core.drop(section)
        capture.registers.write(capture.base + CSR, 0)
        capture.registers.write(capture.base + CC, 0)
        capture.registers.write(capture.base + TOP, FULL_TOP)
        capture.start_edges(now_us)
        return ok(capture)
    }

    // Advance the measurement to `now_us`, without waiting, as
    // hal.PwmInput.poll_capture does: true with `capture` set once a
    // measurement has finished since the last call that returned true,
    // false while none has. Overrun if a count wrapped in a way the input
    // cannot recover from: an edge window that wraps even at
    // MAX_EDGE_DIVIDER (a signal near clk_sys / 2, or polls far apart), or
    // a level window that outlasts what its divider covers (a poll more
    // than about three windows late). The measurement then starts over.
    pub fn poll(&mut self, now_us: u64, capture: &mut hal.PulseCapture) -> bool!hal.Error {
        // A time before the window started counts as its start.
        now := now_us
        if now < self.start_us {
            now = self.start_us
        }
        if self.counting_edges {
            self.poll_edges(now)?
        } else {
            self.poll_level(now)?
        }
        if !self.ready {
            return ok(false)
        }
        capture.period_ns = self.ready_period_ns
        capture.high_ns = self.ready_high_ns
        capture.cycles = self.ready_cycles
        self.ready = false
        return ok(true)
    }

    // The GPIO measured.
    pub fn pin(&self) -> u32 {
        return self.pin
    }

    // The slice, 0 to 7, whose counter measures.
    pub fn slice(&self) -> u32 {
        return (self.base / SLICE_STRIDE) as u32
    }

    // The window length, in microseconds; a measurement takes two.
    pub fn window_us(&self) -> u32 {
        return self.window_us
    }

    // The level windows' divider, in sixteenths, from capture_divider.
    pub fn level_divider(&self) -> u32 {
        return self.level_divider
    }

    // The whole divider the next or running edge window counts edges with,
    // 1 to MAX_EDGE_DIVIDER.
    pub fn edge_divider(&self) -> u32 {
        return self.edge_divider
    }

    // The time a level count stands for, in picoseconds: divider / 16
    // clk_sys cycles, the high time's resolution in one window.
    pub fn level_resolution_ps(&self) -> u64 {
        return self.level_divider as u64 * 1_000_000_000_000 / 16 / self.clock_hz as u64
    }

    // Stop the slice and give it up: it is left disabled, free-running
    // (DIVMODE 0), at a divider of 1 and a TOP of 65535, with its wrap flag
    // clear, so both outputs can be opened again. Returns the registers.
    pub fn release(self) -> R {
        self.registers.write(self.base + CSR, 0)
        self.registers.write(self.base + DIV, MIN_DIVIDER)
        self.registers.write(self.base + CTR, 0)
        self.registers.write(self.base + TOP, FULL_TOP)
        self.clear_wrap()
        section := hal.Critical.enter()
        // SAFETY: as in `new`.
        unsafe {
            CLAIMED &= ~self.claim
        }
        core.drop(section)
        let Capture { registers, pin, base, interrupts, wrap, claim, clock_hz, window_us, level_divider, edge_divider, counting_edges, start_us, deadline_us, last_count, first_count, first_us, latest_count, latest_us, changes, period_ns, edges, ready, ready_period_ns, ready_high_ns, ready_cycles } = self
        return registers
    }

    // Count from 0 in `mode` with divider `divider`, in sixteenths, from
    // now on, with the wrap flag clear.
    fn restart(&mut self, mode: u32, divider: u32, now_us: u64) {
        self.registers.write(self.base + CSR, 0)
        self.registers.write(self.base + DIV, divider)
        self.registers.write(self.base + CTR, 0)
        self.clear_wrap()
        self.registers.write(self.base + CSR, mode | ENABLE)
        self.start_us = now_us
    }

    // Clear the slice's wrap flag, if set, by writing its bit alone to
    // INTR, which leaves the other slices' flags. The slice is stopped, so
    // the flag cannot set again in between.
    fn clear_wrap(&mut self) {
        if (self.registers.read(self.interrupts) & self.wrap) != 0 {
            self.registers.write(self.interrupts, self.wrap)
        }
    }

    fn start_edges(&mut self, now_us: u64) {
        divider := self.edge_divider * 16
        self.restart(DIVMODE_RISING, divider, now_us)
        self.counting_edges = true
        self.last_count = 0
        self.first_count = 0
        self.first_us = now_us
        self.latest_count = 0
        self.latest_us = now_us
        self.changes = 0
    }

    // Stop the counter and return its count, or none if it wrapped.
    fn stop(&mut self) -> Option<u32> {
        self.registers.write(self.base + CSR, 0)
        return self.count()
    }

    // The running count, or none if it wrapped since the window started.
    fn count(&mut self) -> Option<u32> {
        count := self.registers.read(self.base + CTR) & FULL_TOP
        if (self.registers.read(self.interrupts) & self.wrap) != 0 {
            return none
        }
        return some(count)
    }

    fn poll_edges(&mut self, now_us: u64) -> void!hal.Error {
        elapsed := now_us - self.start_us
        done := elapsed >= self.window_us as u64
        counted: Option<u32> = none
        if done {
            counted = self.stop()
        } else {
            counted = self.count()
        }
        count := 0u32
        match counted {
            some(value) => {
                count = value
            }
            none => {
                return self.edges_wrapped(now_us)
            }
        }
        if count != self.last_count {
            if self.changes == 0 {
                self.first_count = count
                self.first_us = now_us
            }
            self.latest_count = count
            self.latest_us = now_us
            self.changes += 1
            self.last_count = count
        }
        if !done {
            return ok()
        }
        divider := self.edge_divider as u64
        total := count as u64 * divider
        self.period_ns = 0
        self.edges = 0
        if self.latest_count > self.first_count {
            // The reciprocal estimate, between the first and latest polls
            // that saw the count change.
            edges := (self.latest_count - self.first_count) as u64 * divider
            span_ns := (self.latest_us - self.first_us) * 1000
            if span_ns > 0 {
                self.period_ns = (span_ns + edges / 2) / edges
                self.edges = edges as u32
            }
        }
        if self.period_ns == 0 && total >= 2 && elapsed > 0 {
            // Edges over the whole window.
            self.period_ns = (elapsed * 1000 + total / 2) / total
            self.edges = total as u32
        }
        // Count at most half the range in the next edge window.
        self.edge_divider = clamp_edge_divider((total + FULL_RANGE / 2 - 1) / (FULL_RANGE / 2))
        // A level window of a whole number of periods, or of the window
        // without a period.
        window_ns := self.window_us as u64 * 1000
        length_ns := window_ns
        if self.period_ns > 0 && self.period_ns <= window_ns {
            length_ns = window_ns / self.period_ns * self.period_ns
        }
        level_divider := self.level_divider
        self.restart(DIVMODE_LEVEL, level_divider, now_us)
        self.deadline_us = now_us + (length_ns + 999) / 1000
        self.counting_edges = false
        return ok()
    }

    // An edge window's count wrapped: count again with a larger divider,
    // or report Overrun at the largest.
    fn edges_wrapped(&mut self, now_us: u64) -> void!hal.Error {
        if self.edge_divider >= MAX_EDGE_DIVIDER {
            self.start_edges(now_us)
            return err(hal.Error.Overrun)
        }
        // At least a full range and what the counter shows now, so far.
        count := self.registers.read(self.base + CTR) & FULL_TOP
        edges := (FULL_RANGE + count as u64) * self.edge_divider as u64
        needed := (edges + FULL_RANGE / 2 - 1) / (FULL_RANGE / 2)
        larger := self.edge_divider as u64 * 4
        if needed > larger {
            larger = needed
        }
        self.edge_divider = clamp_edge_divider(larger)
        self.start_edges(now_us)
        return ok()
    }

    fn poll_level(&mut self, now_us: u64) -> void!hal.Error {
        if now_us < self.deadline_us {
            return ok()
        }
        counted := self.stop()
        count := 0u32
        match counted {
            some(value) => {
                count = value
            }
            none => {
                self.start_edges(now_us)
                return err(hal.Error.Overrun)
            }
        }
        scale := 16 * self.clock_hz as u64
        high_ns := (count as u64 * self.level_divider as u64 * 1_000_000_000 + scale / 2) / scale
        length_ns := (now_us - self.start_us) * 1000
        if high_ns > length_ns {
            high_ns = length_ns
        }
        if self.period_ns == 0 {
            // No period: the line's level over the window.
            if high_ns + STEADY_SLACK_NS >= length_ns {
                high_ns = length_ns
            }
            self.ready_period_ns = length_ns
            self.ready_high_ns = high_ns
            self.ready_cycles = 0
        } else {
            // High time per period: the window lasted length / period
            // periods.
            per_period := (high_ns * self.period_ns + length_ns / 2) / length_ns
            if per_period > self.period_ns {
                per_period = self.period_ns
            }
            self.ready_period_ns = self.period_ns
            self.ready_high_ns = per_period
            self.ready_cycles = self.edges
        }
        self.ready = true
        self.start_edges(now_us)
        return ok()
    }
}

// `divider` within 1 to MAX_EDGE_DIVIDER.
fn clamp_edge_divider(divider: u64) -> u32 {
    if divider < 1 {
        return 1
    }
    if divider > MAX_EDGE_DIVIDER as u64 {
        return MAX_EDGE_DIVIDER
    }
    return divider as u32
}

// Input capture on the chip: a Capture over the PWM block's registers,
// timed by the chip's microsecond timer, which the chip packages hand out.
// Implements hal.PwmInput.
pub struct PwmCapture: hal.PwmInput {
    capture: Capture<hal.RegisterBlock>
    // The timer's raw count, TIMERAWH and TIMERAWL, which read without
    // latching.
    high: hal.Reg<u32>
    low: hal.Reg<u32>

    // Capture.new over the block at `base`, timed by the microsecond timer
    // at `timer`, whose TIMERAWH and TIMERAWL registers are at 0x24 and
    // 0x28 on both chips. Errors as for Capture.new.
    // SAFETY: as for Capture.new, with `base` the PWM block's base address
    // and `timer` a running microsecond timer's.
    pub unsafe fn at(base: usize, slices: u32, timer: usize, clock_hz: u32, pin: u32, window_us: u32) -> PwmCapture!hal.Error {
        unsafe {
            high: hal.Reg<u32> = hal.Reg.at(timer + 0x24)
            low: hal.Reg<u32> = hal.Reg.at(timer + 0x28)
            now := read_timer(&high, &low)
            capture := Capture.new(hal.RegisterBlock.at(base), slices, clock_hz, pin, window_us, now)?
            return ok(PwmCapture { capture, high, low })
        }
    }

    // Capture.poll at the timer's time.
    pub fn poll_capture(&mut self, capture: &mut hal.PulseCapture) -> bool!hal.Error {
        now := read_timer(&self.high, &self.low)
        return self.capture.poll(now, capture)
    }

    pub fn pin(&self) -> u32 {
        return self.capture.pin()
    }

    pub fn slice(&self) -> u32 {
        return self.capture.slice()
    }

    pub fn window_us(&self) -> u32 {
        return self.capture.window_us()
    }

    pub fn level_divider(&self) -> u32 {
        return self.capture.level_divider()
    }

    pub fn edge_divider(&self) -> u32 {
        return self.capture.edge_divider()
    }

    pub fn level_resolution_ps(&self) -> u64 {
        return self.capture.level_resolution_ps()
    }

    // Capture.release; returns the block's base address.
    pub fn release(self) -> usize {
        let PwmCapture { capture, high, low } = self
        registers := capture.release()
        return registers.base()
    }
}

// The timer's 64-bit microsecond count, read high, low, high again until
// the high word holds still.
fn read_timer(high: &hal.Reg<u32>, low: &hal.Reg<u32>) -> u64 {
    for {
        upper := high.read()
        lower := low.read()
        if high.read() == upper {
            return ((upper as u64) << 32) | lower as u64
        }
    }
}

// The bits of CLAIMED in use: outputs, inputs, and timers, two bits per
// slice. The chip packages hold the block in reset while none is.
pub fn claimed() -> u32 {
    section := hal.Critical.enter()
    // SAFETY: interrupts are masked, so the read is not torn by a claim on
    // this core; only core 0 claims.
    value := unsafe {
        CLAIMED
    }
    core.drop(section)
    return value
}

// --- Slices as timers --------------------------------------------------------
//
// A slice needs no pins: its counter counts clk_sys / divider from 0 to TOP
// and wraps, setting the slice's flag in INTR and, while its INTE bit is
// set, raising the wrap interrupt (RP2040 datasheet 4.5.2.7, RP2350
// datasheet 12.5.2.7). `SliceTimer` uses that as a hal.PeriodicTimer
// whose period is TOP + 1 ticks of clk_sys / divider: the hardware wraps
// exactly every period, so periods never drift, and they are timed to a
// tick, down to a clk_sys cycle.
//
// The flag only says that a wrap happened, not how many. To count them, and
// to extend the 16-bit counter into the 64-bit hal.TickCounter, the timer
// pairs the counter with the chip's microsecond timer, which runs from the
// same crystal as clk_sys, so the two never drift apart: the microseconds
// since the start give the ticks to within a microsecond or two, and the
// counter gives the ticks within the period exactly, which settles the
// whole periods. That takes a period of at least MIN_PERIOD_US, so the
// microsecond timer's resolution stays well below half a period, and it
// takes clk_sys to stay at the rate the timer was opened with. Nothing
// needs to poll in between: a poll after any delay counts every period.

// The shortest period, in microseconds.
pub const MIN_PERIOD_US: u64 = 8
// The longest period, in ticks: the counter's 16 bits.
pub const MAX_PERIOD_TICKS: u64 = 0x1_0000
// The timer's TIMERAWH and TIMERAWL on both chips.
const TIMER_RAW_HIGH: usize = 0x24
const TIMER_RAW_LOW: usize = 0x28

// The divider, in sixteenths, that makes a slice count at `tick_hz` from
// `clock_hz`: clock_hz / tick_hz, which must be a whole number of
// sixteenths from 1 to 255 15/16. At a clk_sys of 125 MHz, for example, 125
// MHz, 10 MHz, 1 MHz, or 500 kHz; 488.3 kHz is the slowest rate. InvalidInput
// otherwise.
pub fn timer_divider(clock_hz: u32, tick_hz: u32) -> u32!hal.Error {
    scaled := clock_hz as u64 * 16
    if tick_hz == 0 || scaled % tick_hz as u64 != 0 {
        return err(hal.Error.InvalidInput)
    }
    divider := scaled / tick_hz as u64
    if divider < MIN_DIVIDER as u64 || divider > MAX_DIVIDER as u64 {
        return err(hal.Error.InvalidInput)
    }
    return ok(divider as u32)
}

// A slice as a periodic timer and a counter, over a PWM block and the
// chip's microsecond timer, each any rp_timer.Block: rp_timer.Mmio on the
// chip, or a simulated block in a desktop test. It claims both outputs of
// its slice and drives no pins. `PwmTimer` is the chip's, which the chip
// packages hand out. Implements hal.PeriodicTimer and hal.TickCounter.
pub struct SliceTimer<B: rp_timer.Block>: hal.PeriodicTimer + hal.TickCounter {
    pwm: B
    clock: B
    // The slice's registers, from the block's base; INTR's offset and the
    // slice's bit in it; and the slice's two bits in CLAIMED.
    base: usize
    interrupts: usize
    bit: u32
    claim: u32
    hz: u32
    // Ticks per microsecond when that is a whole number, else 0: the
    // counter extends with a multiplication then, rather than divisions,
    // which the Cortex-M0+ does in software.
    per_us: u64
    // The period in ticks, 0 before the first start.
    period: u64
    running: bool
    // While running: the microsecond time the counter started from 0, the
    // ticks counted before that, and the periods polled since.
    start_us: u64
    base_ticks: u64
    polled: u64
    // While stopped: the ticks counted.
    stopped_ticks: u64

    // Slice `slice` of a block of `slices` slices (8 on the RP2040, 12 on
    // the RP2350, whose slices 8 to 11 reach no pins but count as timers),
    // counting at `tick_hz` from `clock_hz`; see timer_divider for the
    // rates. It starts stopped. InvalidInput for another slice or rate;
    // Busy if either output of the slice is in use.
    // SAFETY: `pwm` must be the PWM block's, out of reset and clocked at
    // `clock_hz`, used only by Channels, Captures, and SliceTimers, and
    // `clock` a running microsecond timer from the same crystal; nothing
    // else may clear the slice's INTR flag or change its INTE bit.
    pub unsafe fn new(pwm: B, clock: B, slices: u32, clock_hz: u32, slice: u32, tick_hz: u32) -> SliceTimer<B>!hal.Error {
        if slice >= slices {
            return err(hal.Error.InvalidInput)
        }
        divider := timer_divider(clock_hz, tick_hz)?
        timer := SliceTimer<B> {
            pwm,
            clock,
            base: SLICE_STRIDE * slice as usize,
            interrupts: interrupt_offset(slices),
            bit: 1u32 << slice,
            claim: 3u32 << (2 * slice),
            hz: tick_hz,
            per_us: 0,
            period: 0,
            running: false,
            start_us: 0,
            base_ticks: 0,
            polled: 0,
            stopped_ticks: 0,
        }
        section := hal.Critical.enter()
        // SAFETY: interrupts are masked, so CLAIMED is read and changed
        // atomically on this core; only core 0 runs.
        claimed := unsafe {
            CLAIMED
        }
        if (claimed & timer.claim) != 0 {
            core.drop(section)
            return err(hal.Error.Busy)
        }
        unsafe {
            CLAIMED = claimed | timer.claim
        }
        core.drop(section)
        if tick_hz % 1_000_000 == 0 {
            timer.per_us = (tick_hz / 1_000_000) as u64
        }
        base := timer.base
        timer.pwm.write(base + CSR, 0)
        timer.pwm.write(base + DIV, divider)
        timer.pwm.write(base + TOP, FULL_TOP)
        timer.pwm.write(base + CTR, 0)
        timer.pwm.write(base + CC, 0)
        timer.clear_wrap()
        return ok(timer)
    }

    pub fn tick_hz(&self) -> u32 {
        return self.hz
    }

    // The slice, 0 to 11.
    pub fn slice(&self) -> u32 {
        return (self.base / SLICE_STRIDE) as u32
    }

    // The period `start` set, in ticks; 0 before the first start.
    pub fn period_ticks(&self) -> u64 {
        return self.period
    }

    pub fn is_running(&self) -> bool {
        return self.running
    }

    // Wrap every `period_ticks` ticks, 1 to MAX_PERIOD_TICKS and at least
    // MIN_PERIOD_US long, the first time one period from now. The counter
    // starts the period from 0; now_ticks carries on from where it was.
    // InvalidInput for a period out of range.
    pub fn start(&mut self, period_ticks: u64) -> void!hal.Error {
        if period_ticks == 0 || period_ticks > MAX_PERIOD_TICKS || period_ticks * 1_000_000 < MIN_PERIOD_US * self.hz as u64 {
            return err(hal.Error.InvalidInput)
        }
        ticks := self.now_ticks()
        base := self.base
        self.pwm.write(base + CSR, 0)
        self.pwm.write(base + TOP, (period_ticks - 1) as u32)
        self.pwm.write(base + CTR, 0)
        self.clear_wrap()
        section := hal.Critical.enter()
        self.pwm.write(base + CSR, ENABLE)
        start := rp_timer.read_count(&self.clock)
        core.drop(section)
        self.start_us = start
        self.base_ticks = ticks
        self.period = period_ticks
        self.polled = 0
        self.running = true
        return ok()
    }

    // Stop the counter; now_ticks holds still until the next start.
    pub fn cancel(&mut self) {
        if !self.running {
            return
        }
        ticks := self.now_ticks()
        base := self.base
        self.pwm.write(base + CSR, 0)
        self.clear_wrap()
        self.stopped_ticks = ticks
        self.running = false
    }

    // How many periods ended since `start` or the last call. Clears the
    // wrap flag first, so a wrap interrupt handler calls it; a wrap that
    // lands right after the clear sets the flag again but is counted now,
    // so the next call may return 0.
    pub fn poll_periods(&mut self) -> u32 {
        if !self.running {
            return 0
        }
        self.clear_wrap()
        position := 0u64
        ended := self.split(&mut position)
        if ended <= self.polled {
            return 0
        }
        periods := ended - self.polled
        self.polled = ended
        if periods > 0xFFFF_FFFFu64 {
            return 0xFFFF_FFFF
        }
        return periods as u32
    }

    // Ticks since the timer was opened, counted while it ran: the 16-bit
    // counter extended by the microsecond timer.
    pub fn now_ticks(&self) -> u64 {
        if !self.running {
            return self.stopped_ticks
        }
        position := 0u64
        periods := self.split(&mut position)
        return self.base_ticks + periods * self.period + position
    }

    // The whole periods since the start, and in `position` the ticks
    // since the last of them: the counter and the microsecond timer read
    // together, as extend_count combines them.
    fn split(&self, position: &mut u64) -> u64 {
        section := hal.Critical.enter()
        now := rp_timer.read_count(&self.clock)
        count := self.pwm.read(self.base + CTR) & FULL_TOP
        core.drop(section)
        elapsed := 0u64
        if now > self.start_us {
            elapsed = now - self.start_us
        }
        estimate := elapsed * self.per_us
        if self.per_us == 0 {
            estimate = hal.us_to_ticks(elapsed, self.hz)
        }
        *position = count as u64
        return periods_since(estimate, count as u64, self.period)
    }

    // The counter's position in the period, 0 to period - 1.
    pub fn count(&self) -> u32 {
        return self.pwm.read(self.base + CTR) & FULL_TOP
    }

    // Whether the counter wrapped since the flag was last cleared.
    pub fn wrapped(&self) -> bool {
        return (self.pwm.read(self.interrupts) & self.bit) != 0
    }

    // Raise the wrap interrupt, PWM_IRQ_WRAP on the RP2040 and
    // PWM_IRQ_WRAP_0 on the RP2350, when a period ends.
    pub fn listen(&mut self) {
        offset := self.interrupts + INTE + SET_ALIAS
        bit := self.bit
        self.pwm.write(offset, bit)
    }

    pub fn ignore(&mut self) {
        offset := self.interrupts + INTE + CLEAR_ALIAS
        bit := self.bit
        self.pwm.write(offset, bit)
    }

    pub fn is_listening(&self) -> bool {
        return (self.pwm.read(self.interrupts + INTE) & self.bit) != 0
    }

    // Stop the slice and give it up, with its interrupt off, its flag
    // clear, and its registers as Capture.release leaves them. Returns the
    // PWM block.
    pub fn release(self) -> B {
        self.cancel()
        self.ignore()
        base := self.base
        self.pwm.write(base + DIV, MIN_DIVIDER)
        self.pwm.write(base + TOP, FULL_TOP)
        self.pwm.write(base + CTR, 0)
        section := hal.Critical.enter()
        // SAFETY: as in `new`.
        unsafe {
            CLAIMED &= ~self.claim
        }
        core.drop(section)
        let SliceTimer { pwm, clock, base: _, interrupts, bit, claim, hz, per_us, period, running, start_us, base_ticks, polled, stopped_ticks } = self
        return pwm
    }

    fn clear_wrap(&mut self) {
        offset := self.interrupts
        bit := self.bit
        self.pwm.write(offset, bit)
    }
}

// The ticks a counter of `period` ticks at `tick_hz` has counted since it
// started from 0 `elapsed_us` microseconds ago, now showing `count`: of the
// values that show `count`, a whole number of periods plus `count`, the
// one closest to what the elapsed time says. Exact while the elapsed time
// is right to within half a period, as it is from MIN_PERIOD_US on.
pub fn extend_count(elapsed_us: u64, count: u32, period: u64, tick_hz: u32) -> u64 {
    estimate := hal.us_to_ticks(elapsed_us, tick_hz)
    position := count as u64 % period
    return periods_since(estimate, position, period) * period + position
}

// The whole periods before a count at `position` in its period, closest to
// `estimate` ticks.
fn periods_since(estimate: u64, position: u64, period: u64) -> u64 {
    if estimate + period / 2 < position {
        return 0
    }
    return (estimate + period / 2 - position) / period
}

// A slice as a timer on the chip: a SliceTimer over the PWM block and the
// microsecond timer's registers, which the chip packages hand out.
// Implements hal.PeriodicTimer and hal.TickCounter.
pub struct PwmTimer: hal.PeriodicTimer + hal.TickCounter {
    timer: SliceTimer<rp_timer.Mmio>
    irq: u32

    // SliceTimer.new over the PWM block at `base` and the microsecond timer
    // at `timer`, raising wrap interrupt `irq`. Errors as for
    // SliceTimer.new.
    // SAFETY: as for SliceTimer.new, with `base` the PWM block's base
    // address and `timer` a running microsecond timer's.
    pub unsafe fn at(base: usize, timer: usize, slices: u32, irq: u32, clock_hz: u32, slice: u32, tick_hz: u32) -> PwmTimer!hal.Error {
        unsafe {
            opened := SliceTimer.new(rp_timer.Mmio.at(base), rp_timer.Mmio.at(timer), slices, clock_hz, slice, tick_hz)?
            return ok(PwmTimer { timer: opened, irq })
        }
    }

    // The wrap interrupt, for cortex_m.enable and `@interrupt`:
    // PWM_IRQ_WRAP on the RP2040, PWM_IRQ_WRAP_0 on the RP2350. Every
    // slice raises it, so its handler polls each timer it listens for.
    pub fn irq(&self) -> u32 {
        return self.irq
    }

    pub fn tick_hz(&self) -> u32 {
        return self.timer.tick_hz()
    }

    pub fn slice(&self) -> u32 {
        return self.timer.slice()
    }

    pub fn period_ticks(&self) -> u64 {
        return self.timer.period_ticks()
    }

    pub fn is_running(&self) -> bool {
        return self.timer.is_running()
    }

    pub fn start(&mut self, period_ticks: u64) -> void!hal.Error {
        return self.timer.start(period_ticks)
    }

    pub fn cancel(&mut self) {
        self.timer.cancel()
    }

    pub fn poll_periods(&mut self) -> u32 {
        return self.timer.poll_periods()
    }

    pub fn now_ticks(&self) -> u64 {
        return self.timer.now_ticks()
    }

    pub fn count(&self) -> u32 {
        return self.timer.count()
    }

    pub fn wrapped(&self) -> bool {
        return self.timer.wrapped()
    }

    pub fn listen(&mut self) {
        self.timer.listen()
    }

    pub fn ignore(&mut self) {
        self.timer.ignore()
    }

    pub fn is_listening(&self) -> bool {
        return self.timer.is_listening()
    }

    // SliceTimer.release; returns the PWM block's base address.
    pub fn release(self) -> usize {
        let PwmTimer { timer, irq } = self
        block := timer.release()
        return block.base()
    }
}
