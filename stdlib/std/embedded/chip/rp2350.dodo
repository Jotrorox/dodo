package rp2350

import "core/cpu"
import "core/option"
import "std/embedded/cortex_m"
import "std/embedded/hal"
import "std/embedded/power"
import "std/embedded/chip/rp_adc"
import "std/embedded/chip/rp_capture"
import "std/embedded/chip/rp_dma"
import "std/embedded/chip/rp_flash"
import "std/embedded/chip/rp_multicore"
import "std/embedded/chip/rp_pio"
import "std/embedded/chip/rp_power"
import "std/embedded/chip/rp_pwm"
import "std/embedded/chip/rp_rng"
import "std/embedded/chip/rp_rtc"
import "std/embedded/chip/rp_timer"
import "std/embedded/chip/rp_usb"
import "std/embedded/chip/rp_watchdog"
import "std/embedded/peripheral/designware_i2c"
import "std/embedded/peripheral/pl011"
import "std/embedded/peripheral/pl022"
import "std/embedded/chip/rp_pins"

// Raspberry Pi RP2350 chip support for the Arm cores: clocks, resets, GPIO,
// I2C, SPI, UART, PWM, the ADC, PIO, the microsecond timer, the always-on
// timer as a real-time clock, the watchdog, a USB serial port, the second
// core, the FIFOs and spinlocks the cores share, the TRNG, low power, and
// the boot ROM. `take(config)` brings the chip from its boot state (ring
// oscillator, peripherals held in reset) to a known configuration and hands
// out the peripherals once. Pins implement the std/embedded/hal output and
// input pin protocols, I2C and SPI buses claimed from `Pins` implement the
// bus protocols, serial ports the std/io Reader and Writer protocols, PWM
// outputs and ADC inputs the PWM output and analog input protocols, the
// timer the delay protocol, the real-time clock the clock and alarm
// protocols, the watchdog the watchdog protocol, and the TRNG the Rng
// protocol, so portable drivers use them unchanged.
//
// Applications normally use a board package instead, which supplies the
// board's Config and wiring: `import "std/embedded/board"` with
// `board = "pico2"`, or `import "std/embedded/chip"` for a custom RP2350
// board with `chip = "rp2350"`.
//
// Clocks after take(): clk_ref = the crystal, clk_sys = 150 MHz from PLL_SYS,
// clk_peri = clk_sys, and 1 MHz ticks for TIMER0 and the watchdog. clk_adc
// and clk_usb run at 48 MHz from PLL_USB while an ADC input or the USB
// serial port is claimed. The flash
// keeps the boot ROM's execute-in-place setup. `Power.set_system_hz` runs
// clk_sys slower, and the `Rtc` chooses the always-on timer's tick.
// Section numbers below refer to the RP2350 datasheet.
//
// Both packages are supported: take() reads which one the chip is in from
// SYSINFO, and `Pins` hands out GPIO 0 to 29 on the RP2350A (QFN-60) and
// GPIO 0 to 47 on the RP2350B (QFN-80); see pin_count.

// clk_sys, the processor and peripheral clock, after take().
pub const SYS_HZ: u32 = 150_000_000
// User GPIOs 0 to 29, all the RP2350A (QFN-60) has, and the only ones a
// program for either package can rely on. pin_count() is the chip's own.
pub const PIN_COUNT: u32 = 30
// User GPIOs 0 to 47, all the RP2350B (QFN-80) has.
pub const MAX_PIN_COUNT: u32 = 48
// PIO blocks 0 to 2.
pub const PIO_BLOCKS: u32 = 3

// Each register also has atomic XOR, set, and clear aliases (2.1.3).
const SET_ALIAS: usize = 0x2000
const CLEAR_ALIAS: usize = 0x3000

// Resets (7.5). Writing 1 holds a block in reset.
const RESETS_BASE: usize = 0x4002_0000
const RESET: usize = RESETS_BASE + 0x0
const RESET_DONE: usize = RESETS_BASE + 0x8
const RESET_ADC: u32 = 1 << 0
const RESET_DMA: u32 = 1 << 2
const RESET_HSTX: u32 = 1 << 3
const RESET_I2C0: u32 = 1 << 4
const RESET_I2C1: u32 = 1 << 5
const RESET_IO_BANK0: u32 = 1 << 6
const RESET_PADS_BANK0: u32 = 1 << 9
const RESET_PIO0: u32 = 1 << 11
const RESET_PIO1: u32 = 1 << 12
const RESET_PIO2: u32 = 1 << 13
const RESET_PLL_SYS: u32 = 1 << 14
const RESET_PLL_USB: u32 = 1 << 15
const RESET_PWM: u32 = 1 << 16
const RESET_SHA256: u32 = 1 << 17
const RESET_SPI0: u32 = 1 << 18
const RESET_SPI1: u32 = 1 << 19
const RESET_UART0: u32 = 1 << 26
const RESET_UART1: u32 = 1 << 27
const RESET_USBCTRL: u32 = 1 << 28
const RESET_TIMER0: u32 = 1 << 23
const RESET_TIMER1: u32 = 1 << 24
const RESET_TRNG: u32 = 1 << 25

// Ring oscillator (8.3): the boot clock, unused after take() but running.
const ROSC_BASE: usize = 0x400E_8000
const ROSC_STATUS: usize = 0x1C

// Crystal oscillator (8.2).
const XOSC_BASE: usize = 0x4004_8000
const XOSC_CTRL: usize = XOSC_BASE + 0x00
const XOSC_STATUS: usize = XOSC_BASE + 0x04
const XOSC_STARTUP: usize = XOSC_BASE + 0x0C
const XOSC_RANGE_1_15MHZ: u32 = 0xAA0
const XOSC_ENABLE: u32 = 0xFAB << 12
const XOSC_STABLE: u32 = 1 << 31

// PLL_SYS (8.6): crystal / REFDIV 1 * FBDIV = 1500 MHz VCO,
// / POSTDIV1 5 / POSTDIV2 2 = 150 MHz. PLL_USB: a 1200 MHz VCO,
// / POSTDIV1 5 / POSTDIV2 5 = 48 MHz, for the ADC. Register offsets from
// each PLL's base follow.
const VCO_HZ: u32 = 1_500_000_000
const USB_VCO_HZ: u32 = 1_200_000_000
const PLL_SYS_BASE: usize = 0x4005_0000
const PLL_USB_BASE: usize = 0x4005_8000
const PLL_CS: usize = 0x0
const PLL_PWR: usize = 0x4
const PLL_FBDIV_INT: usize = 0x8
const PLL_PRIM: usize = 0xC
const PLL_LOCK: u32 = 1 << 31
const PLL_POWER_DOWN: u32 = 1 << 0
const PLL_POSTDIV_POWER_DOWN: u32 = 1 << 3
const PLL_VCO_POWER_DOWN: u32 = 1 << 5
const PLL_POSTDIV1: u32 = 0b111 << 16
const PLL_POSTDIV2: u32 = 0b111 << 12

// Clock generators (8.1).
const CLOCKS_BASE: usize = 0x4001_0000
const CLK_REF_CTRL: usize = CLOCKS_BASE + 0x30
const CLK_REF_DIV: usize = CLOCKS_BASE + 0x34
const CLK_REF_SELECTED: usize = CLOCKS_BASE + 0x38
const CLK_SYS_CTRL: usize = CLOCKS_BASE + 0x3C
const CLK_SYS_DIV: usize = CLOCKS_BASE + 0x40
const CLK_SYS_SELECTED: usize = CLOCKS_BASE + 0x44
const CLK_PERI_CTRL: usize = CLOCKS_BASE + 0x48
const CLK_USB_CTRL: usize = CLOCKS_BASE + 0x60
const CLK_USB_DIV: usize = CLOCKS_BASE + 0x64
const CLK_ADC_CTRL: usize = CLOCKS_BASE + 0x6C
const CLK_ADC_DIV: usize = CLOCKS_BASE + 0x70
const CLK_SYS_RESUS_CTRL: usize = CLOCKS_BASE + 0x84
const CLK_REF_SRC: u32 = 0b11
const CLK_REF_SRC_XOSC: u32 = 2
// clk_ref from the low-power oscillator, and clk_sys's auxiliary source the
// crystal, for a dormant state that the always-on timer ends (8.1.6.1).
const CLK_REF_SRC_LPOSC: u32 = 3
const CLK_SYS_AUXSRC_XOSC: u32 = 3 << 5
const CLK_SYS_SRC_AUX: u32 = 1
const CLK_SYS_AUXSRC: u32 = 0b111 << 5
const CLK_ENABLE: u32 = 1 << 11
// Clock gating (8.1.3.5): WAKE_EN0/1 and SLEEP_EN0/1.
const CLOCKS_WAKE_EN: usize = 0xAC
const CLOCKS_SLEEP_EN: usize = 0xB4

// The integer part of both dividers is bits 16 and up; 0x1_0000 divides by
// one.
const DIVIDE_BY_ONE: u32 = 0x1_0000

// Tick generators (8.5) divide clk_ref down to the 1 MHz ticks of the timers
// and the watchdog. Each has CTRL, CYCLES, and COUNT registers.
const TICKS_BASE: usize = 0x4010_8000
const TICK_TIMER0: usize = TICKS_BASE + 0x18
const TICK_TIMER1: usize = TICKS_BASE + 0x24
const TICK_WATCHDOG: usize = TICKS_BASE + 0x30
const TICK_ENABLE: u32 = 1 << 0

// The watchdog (12.9).
const WATCHDOG_BASE: usize = 0x400D_8000

// Microsecond timer TIMER0 (12.8). The raw registers read without latching.
const TIMER0_BASE: usize = 0x400B_0000
const TIMER_RAW_HIGH: usize = TIMER0_BASE + 0x24
const TIMER_RAW_LOW: usize = TIMER0_BASE + 0x28
// Alarms (12.8.4): ALARMn arms when written and fires when the counter's
// low 32 bits reach it; std/embedded/chip/rp_timer drives them.
// TIMER1 (12.8), the second timer, which `Timer.timer1` hands out. Its
// SOURCE register (12.8.6) counts clk_sys cycles instead of ticks while
// CLK_SYS is set; its ticks come from its own tick generator.
const TIMER1_BASE: usize = 0x400B_8000
const TIMER_SOURCE: usize = 0x38
const SOURCE_CLK_SYS: u32 = 1 << 0
// The tick generators' CYCLES field: 1 to 511 clk_ref cycles per tick.
const MAX_TICK_CYCLES: u32 = 511
// The longest an alarm sleeps at once: below 2^31 us, so its 32-bit
// target time is still ahead when the write lands.
const MAX_ALARM_SLEEP_US: u64 = 0x7FFF_FFFF
// The power manager (6.4), whose always-on timer is the real-time clock.
const POWMAN_BASE: usize = 0x4010_0000

// The SRAM domains `Power.power_down` can keep powered, so their contents
// survive: SRAM0 is SRAM0 to SRAM3, the lower 256 KiB from 0x2000_0000,
// which holds the program's statics, `.noinit` ones included, unless they
// pass 256 KiB; SRAM1 is SRAM4 to SRAM9, the rest, with the stack at its
// top (6.2.1).
pub const RETAIN_SRAM0: u32 = rp_power.DOMAIN_SRAM0
pub const RETAIN_SRAM1: u32 = rp_power.DOMAIN_SRAM1
pub const RETAIN_NOTHING: u32 = 0
// The power manager's scratch registers for the program, which keep their
// values through power-down and every reset but a loss of power:
// `Power.scratch(0)` to `scratch(SCRATCH_WORDS - 1)`.
pub const SCRATCH_WORDS: u32 = rp_power.SCRATCH_WORDS
const POWMAN_SCRATCH0: usize = POWMAN_BASE + 0xB0

// OTP row LPOSC_CALIB: the low-power oscillator's frequency in hertz,
// measured in manufacturing, read through the ECC data window (13.10); the
// Pico SDK ignores values outside 26 to 40 kHz.
const OTP_DATA_BASE: usize = 0x4013_0000
const OTP_LPOSC_CALIB_ROW: usize = 0x11
const LPOSC_CALIB_MIN_HZ: u32 = 26_000
const LPOSC_CALIB_MAX_HZ: u32 = 40_000

// The USB controller needs clk_sys above 48 MHz (12.7.3.1, erratum
// RP2350-E12).
const USB_MIN_SYSTEM_HZ: u32 = 48_000_001
// The blocks whose rates follow clk_sys or clk_peri, set when claimed:
// Power.set_system_hz refuses while one is out of reset.
const SYSTEM_CLOCKED: u32 = RESET_HSTX | RESET_I2C0 | RESET_I2C1 | RESET_PIO0 | RESET_PIO1 | RESET_PIO2 | RESET_PWM | RESET_SPI0 | RESET_SPI1 | RESET_UART0 | RESET_UART1

// Alarms 0 to 3, raising TIMER0_IRQ_0 + n.
pub const ALARM_COUNT: u32 = 4

// Interrupt numbers (3.2), for std/embedded/cortex_m's enable, pend, and
// set_priority. Each is also the vector name of its `@interrupt` handler.
pub const TIMER0_IRQ_0: u32 = 0
pub const TIMER0_IRQ_1: u32 = 1
pub const TIMER0_IRQ_2: u32 = 2
pub const TIMER0_IRQ_3: u32 = 3
pub const TIMER1_IRQ_0: u32 = 4
pub const TIMER1_IRQ_1: u32 = 5
pub const TIMER1_IRQ_2: u32 = 6
pub const TIMER1_IRQ_3: u32 = 7
pub const PWM_IRQ_WRAP_0: u32 = 8
pub const PWM_IRQ_WRAP_1: u32 = 9
pub const DMA_IRQ_0: u32 = 10
pub const DMA_IRQ_1: u32 = 11
pub const DMA_IRQ_2: u32 = 12
pub const DMA_IRQ_3: u32 = 13
pub const USBCTRL_IRQ: u32 = 14
pub const PIO0_IRQ_0: u32 = 15
pub const PIO0_IRQ_1: u32 = 16
pub const PIO1_IRQ_0: u32 = 17
pub const PIO1_IRQ_1: u32 = 18
pub const PIO2_IRQ_0: u32 = 19
pub const PIO2_IRQ_1: u32 = 20
pub const IO_IRQ_BANK0: u32 = 21
pub const IO_IRQ_BANK0_NS: u32 = 22
pub const IO_IRQ_QSPI: u32 = 23
pub const IO_IRQ_QSPI_NS: u32 = 24
pub const SIO_IRQ_FIFO: u32 = 25
pub const SIO_IRQ_BELL: u32 = 26
pub const SIO_IRQ_FIFO_NS: u32 = 27
pub const SIO_IRQ_BELL_NS: u32 = 28
pub const SIO_IRQ_MTIMECMP: u32 = 29
pub const CLOCKS_IRQ: u32 = 30
pub const SPI0_IRQ: u32 = 31
pub const SPI1_IRQ: u32 = 32
pub const UART0_IRQ: u32 = 33
pub const UART1_IRQ: u32 = 34
pub const ADC_IRQ_FIFO: u32 = 35
pub const I2C0_IRQ: u32 = 36
pub const I2C1_IRQ: u32 = 37
pub const OTP_IRQ: u32 = 38
pub const TRNG_IRQ: u32 = 39
pub const PROC0_IRQ_CTI: u32 = 40
pub const PROC1_IRQ_CTI: u32 = 41
pub const PLL_SYS_IRQ: u32 = 42
pub const PLL_USB_IRQ: u32 = 43
pub const POWMAN_IRQ_POW: u32 = 44
pub const POWMAN_IRQ_TIMER: u32 = 45

// Clock gates for `Power` (8.1.3.5), as std/embedded/power.Clocks: bit n
// of WAKE_EN0 and SLEEP_EN0 is bit n, bit n of WAKE_EN1 and SLEEP_EN1 bit
// 32 + n. Each peripheral's constant holds every clock it uses, its
// clk_sys register clock and, where it has one, its own clock.
pub const CLOCK_ADC: power.Clocks = (1 << 2) | (1 << 3)
pub const CLOCK_BUSCTRL: power.Clocks = 1 << 5
pub const CLOCK_DMA: power.Clocks = 1 << 7
pub const CLOCK_HSTX: power.Clocks = (1 << 9) | (1 << 10)
pub const CLOCK_I2C0: power.Clocks = 1 << 11
pub const CLOCK_I2C1: power.Clocks = 1 << 12
// GPIO control and pads: their interrupts need these to wake a deep sleep.
pub const CLOCK_GPIO: power.Clocks = (1 << 13) | (1 << 17)
pub const CLOCK_JTAG: power.Clocks = 1 << 14
pub const CLOCK_PIO0: power.Clocks = 1 << 18
pub const CLOCK_PIO1: power.Clocks = 1 << 19
pub const CLOCK_PIO2: power.Clocks = 1 << 20
// PLL_USB's registers; PLL_USB runs while the ADC or USB serial port does.
pub const CLOCK_PLL_USB: power.Clocks = 1 << 22
pub const CLOCK_PWM: power.Clocks = 1 << 25
pub const CLOCK_SHA256: power.Clocks = 1 << 30
pub const CLOCK_SPI0: power.Clocks = (1 << 32) | (1 << 33)
pub const CLOCK_SPI1: power.Clocks = (1 << 34) | (1 << 35)
// The SRAM banks and the bus fabric, for DMA during a deep sleep.
pub const CLOCK_MEMORY: power.Clocks = (1 << 6) | (0x3FF << 36)
pub const CLOCK_SYSCFG: power.Clocks = 1 << 46
pub const CLOCK_SYSINFO: power.Clocks = 1 << 47
pub const CLOCK_TBMAN: power.Clocks = 1 << 48
// TIMER0 and the tick generators that count its microseconds.
pub const CLOCK_TIMER: power.Clocks = (1 << 49) | (1 << 50) | (1 << 51)
pub const CLOCK_TIMER1: power.Clocks = 1 << 52
pub const CLOCK_TRNG: power.Clocks = 1 << 53
pub const CLOCK_UART0: power.Clocks = (1 << 54) | (1 << 55)
pub const CLOCK_UART1: power.Clocks = (1 << 56) | (1 << 57)
pub const CLOCK_USB: power.Clocks = (1 << 58) | (1 << 59)
pub const CLOCK_WATCHDOG: power.Clocks = 1 << 60
// What the timer and its alarms need: keep them in the sleep set to wake
// from a deep sleep on an alarm, as an executor on an alarm does.
pub const ALARM_CLOCKS: power.Clocks = CLOCK_TIMER
// Clocks the program cannot run without, which Power.disable_clocks
// refuses: the clock, reset, power-on, and power manager controls, access
// control, the glitch detector, the bus fabric, the boot ROM and its RAM,
// OTP, SRAM, flash (XIP), the cores' SIO, GPIO, and the oscillators and
// PLL_SYS, which `dormant` restarts.
pub const ESSENTIAL_CLOCKS: power.Clocks = (1 << 0) | (1 << 1) | (1 << 4) | (1 << 6) | (1 << 8) | CLOCK_GPIO | (1 << 15) | (1 << 16) | (1 << 21) | (1 << 23) | (1 << 24) | (1 << 26) | (1 << 27) | (1 << 28) | (1 << 29) | (1 << 31) | (0x3FF << 36) | (1 << 61) | (1 << 62)
// Every gate.
pub const ALL_CLOCKS: power.Clocks = 0x7FFF_FFFF_FFFF_FFFF
// The peripherals the chip claims and releases, or never uses, whose
// clocks Power.disable_unused_clocks stops while they are held in reset.
const MANAGED_CLOCKS: power.Clocks = CLOCK_ADC | CLOCK_HSTX | CLOCK_I2C0 | CLOCK_I2C1 | CLOCK_PIO0 | CLOCK_PIO1 | CLOCK_PIO2 | CLOCK_PLL_USB | CLOCK_PWM | CLOCK_SHA256 | CLOCK_SPI0 | CLOCK_SPI1 | CLOCK_TIMER1 | CLOCK_TRNG | CLOCK_UART0 | CLOCK_UART1 | CLOCK_USB

// SYSINFO, among the system control registers: PACKAGE_SEL's bit 0 is 1
// in the QFN-60 package (the RP2350A) and 0 in the QFN-80 package (the
// RP2350B), as the Pico SDK's sysinfo.h describes it and picotool reads it.
const SYSINFO_PACKAGE_SEL: usize = 0x4000_0004
const PACKAGE_QFN60: u32 = 1 << 0

// User bank GPIO control (9.11.1) and pads (9.11.3), for GPIO 0 to 47.
const IO_BANK0_BASE: usize = 0x4002_8000
const PADS_BANK0_BASE: usize = 0x4003_8000
const FUNCSEL: u32 = 0b11111
// GPIO interrupts (9.11.1): four bits per pin, eight pins per register,
// six registers for GPIO 0 to 47. INTR latches edges (write one to clear)
// and shows levels; PROC0_INTE selects what raises IO_IRQ_BANK0 on core 0,
// and PROC0_INTS shows it. Core 1's PROC1_INTE and PROC1_INTS follow
// CORE_INTERRUPTS later.
const GPIO_INTR: usize = IO_BANK0_BASE + 0x230
const GPIO_PROC0_INTE: usize = IO_BANK0_BASE + 0x248
const GPIO_PROC0_INTS: usize = IO_BANK0_BASE + 0x278
const CORE_INTERRUPTS: usize = 0x290 - 0x248
const INTS_FROM_INTE: usize = 0x278 - 0x248
// GPIO events that end the dormant state (6.5.3), laid out as INTR:
// offsets in IO_BANK0.
const GPIO_DORMANT_WAKE_INTE: usize = 0x2D8
const GPIO_DORMANT_WAKE_INTS: usize = 0x308

// Pin events for `Pin.listen`, `ignore`, `events`, and `clear_events`:
// the pin's level is low or high, or it fell or rose. Levels last as long
// as the level does; edges stay latched until cleared.
pub const LEVEL_LOW: u32 = 1 << 0
pub const LEVEL_HIGH: u32 = 1 << 1
pub const FALLING_EDGE: u32 = 1 << 2
pub const RISING_EDGE: u32 = 1 << 3
const EDGES: u32 = FALLING_EDGE | RISING_EDGE
const ALL_EVENTS: u32 = 0xF
// Pads come out of reset isolated, latching their last state, until
// software clears this bit.
const PAD_ISOLATE: u32 = 1 << 8

// I2C (12.2), SPI (12.3), and UART (12.1) controllers, clocked by clk_sys
// and clk_peri.
const UART0_BASE: usize = 0x4007_0000
const UART1_BASE: usize = 0x4007_8000
const SPI0_BASE: usize = 0x4008_0000
const SPI1_BASE: usize = 0x4008_8000
const I2C0_BASE: usize = 0x4009_0000
const I2C1_BASE: usize = 0x4009_8000

// PWM (12.5), clocked by clk_sys, and the ADC (12.4), by clk_adc.
const PWM_BASE: usize = 0x400A_8000
const ADC_BASE: usize = 0x400A_0000
// The TRNG (12.12).
const TRNG_BASE: usize = 0x400F_0000

// The PIO blocks (11), clocked by clk_sys.
const PIO0_BASE: usize = 0x5020_0000
const PIO1_BASE: usize = 0x5030_0000
const PIO2_BASE: usize = 0x5040_0000

// The USB controller (12.7): its registers and its 4 KiB of dual-port
// RAM, clocked by clk_usb.
const USBCTRL_DPRAM_BASE: usize = 0x5010_0000
const USBCTRL_REGS_BASE: usize = 0x5011_0000

// Single-cycle I/O (3.1). Each GPIO_HI register, whose bits 0 to 15 are
// GPIO 32 to 47, follows its GPIO register for pins 0 to 31 by GPIO_HI.
const SIO_BASE: usize = 0xD000_0000
const GPIO_IN: usize = SIO_BASE + 0x004
const GPIO_OUT_SET: usize = SIO_BASE + 0x018
const GPIO_OUT_CLR: usize = SIO_BASE + 0x020
const GPIO_OUT_XOR: usize = SIO_BASE + 0x028
const GPIO_OE_SET: usize = SIO_BASE + 0x038
const GPIO_OE_CLR: usize = SIO_BASE + 0x040
const GPIO_HI: usize = 0x004

// Boot ROM reboot() (5.4.8.24): its lookup code and arguments.
const ROM_REBOOT: u32 = 0x4252
const REBOOT_TYPE_BOOTSEL: u32 = 0x2
const REBOOT_NO_RETURN_ON_SUCCESS: u32 = 0x100
const BOOTSEL_GPIO_PIN_SPECIFIED: u32 = 0x20
// The ROM version is the top byte of the word at 0x10, after the 'M' 'u'
// magic and the chip marker.
const ROM_VERSION_WORD: usize = 0x10

// Polls before a clock or reset is reported as stuck. The slowest wait,
// crystal start-up, takes about 1 ms at the ring oscillator's boot clock.
const ATTEMPTS: u32 = 1_000_000

// Power-on state machine (7.4): FRCE_OFF holds core 1 in reset while its
// bit is set.
const PSM_BASE: usize = 0x4001_8000
const PSM_PROC1: u32 = 1 << 24
// Erratum RP2350-E2: writes to SIO offsets 0x180 to 0x1FC also unlock the
// spinlock 0x80 below. Locks 0 to 4, 8, 9, and 12 to 17 sit below writable
// registers (doorbells, PERI_NONSEC, RISC-V soft interrupts, MTIME, TMDS),
// so they are not handed out.
const RESERVED_SPINLOCKS: u32 = 0x0003_F31F

static mut TAKEN: bool = false
// Whether `Timer.timer1` handed TIMER1 out, and whether it counts clk_sys,
// which Power.set_system_hz then refuses to change.
static mut TIMER1_TAKEN: bool = false
static mut TIMER1_ON_SYSTEM_CLOCK: bool = false
// What runs PLL_USB: the ADC and the USB controller, one each. It stops when
// neither does.
static mut PLL_USB_USERS: u32 = 0
// The pin the USB bootloader lights while its drive is accessed, after the
// USB serial port restarts the chip into it; MAX_PIN_COUNT for none.
static mut USB_ACTIVITY_LED: u32 = MAX_PIN_COUNT
// How clk_sys runs now; Power.set_system_hz changes it, with interrupts
// masked.
static mut SYSTEM_CLOCK: rp_power.SystemClock = rp_power.SystemClock { hz: SYS_HZ, from_pll: true, vco_hz: VCO_HZ, post1: 5, post2: 2, divider: 1 }

// Provided by the compiler's RP2350 firmware runtime: call the boot ROM
// function with lookup code `code` ('R' | 'B' << 8 for reboot), or return -1
// if there is none.
unsafe extern "C" fn dodo_rp2350_rom_call(code: u32, a0: u32, a1: u32, a2: u32, a3: u32) -> i32

// Restart into the boot ROM's USB bootloader, as if BOOTSEL were held at
// power-up: the board reappears as the RP2350 drive and accepts new
// firmware, for example from `dodo run`. Pin `activity_led`, if below
// pin_count(), lights while the drive is accessed, except on chip revision
// A2, whose boot ROM mishandles it on the Arm cores (erratum in the Pico
// SDK's rom_reset_usb_boot). Does not return.
pub fn reboot_to_bootloader(activity_led: u32) {
    flags := 0u32
    pin := 0u32
    rom_version := 0u32
    // SAFETY: the ROM is always readable, and the word is never written.
    unsafe {
        version: hal.Reg<u32> = hal.Reg.at(ROM_VERSION_WORD)
        rom_version = version.read() >> 24
    }
    if activity_led < pin_count() && rom_version > 2 {
        flags = BOOTSEL_GPIO_PIN_SPECIFIED
        pin = activity_led
    }
    // SAFETY: on success the ROM resets the chip after 10 ms and never
    // returns, so no peripheral owned by this program is used afterwards.
    // Clearing the watchdog's mark makes that reset, and the one after
    // flashing, read as Other rather than as the program's.
    unsafe {
        rp_watchdog.clear_mark(WATCHDOG_BASE)
        dodo_rp2350_rom_call(ROM_REBOOT, REBOOT_TYPE_BOOTSEL | REBOOT_NO_RETURN_ON_SUCCESS, 10, flags, pin)
    }
    for {}
}

// Write a failed check's message to every serial port claimed from
// `pins.uart` and not yet released, as the default panic hook does before it
// halts: `dodo: arithmetic overflow check failed at main.dodo:12:5`. Call it
// from a panic hook of your own that, for example, restarts into the
// bootloader:
//
//     extern "C" fn dodo_board_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
//         unsafe {
//             chip.report_panic(check, file, line, column)
//         }
//         chip.reboot_to_bootloader(25)
//     }
//
// SAFETY: `check` and `file` must be the hook's NUL-terminated strings, and
// the caller must halt or reset afterwards, as this takes over the ports.
pub unsafe fn report_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
    unsafe {
        rp_pins.report_panic(check, file, line, column)
    }
}

// The user GPIOs of this chip's package: PIN_COUNT (30) for the RP2350A
// (QFN-60), MAX_PIN_COUNT (48) for the RP2350B (QFN-80), from SYSINFO's
// PACKAGE_SEL. `Pins` hands out GPIO 0 to pin_count() - 1.
pub fn pin_count() -> u32 {
    // SAFETY: PACKAGE_SEL is read-only and reading it has no side effects;
    // the boot ROM takes SYSINFO out of reset, and nothing resets it.
    selection := unsafe {
        reg(SYSINFO_PACKAGE_SEL)
    }
    if (selection.read() & PACKAGE_QFN60) != 0 {
        return PIN_COUNT
    }
    return MAX_PIN_COUNT
}

// What the circuit board decides. Board packages pass theirs to `take`.
pub struct Config {
    // The crystal on XIN/XOUT, in hertz: 1 to 15 MHz, a whole number of
    // megahertz (for the 1 MHz ticks) that divides 1.5 GHz (for the PLL).
    // 12 MHz, as on the Raspberry Pi Pico 2, is the usual choice.
    pub crystal_hz: u32
}

// The chip's peripherals, handed out once by `take`.
pub struct Peripherals {
    pub pins: Pins
    pub timer: Timer
    // The always-on timer as a real-time clock: the time of day, counted in
    // milliseconds, which survives resets.
    pub rtc: Rtc
    // The watchdog, stopped; rp_watchdog documents it.
    pub watchdog: rp_watchdog.Watchdog
    pub usb: Usb
    // The DMA controller's channels; rp_dma documents them.
    pub dma: rp_dma.Dma
    // The random number generator, the TRNG: about 20 KB a second, fit
    // for cryptographic keys; rp_rng documents it.
    pub rng: rp_rng.Trng
    // Core 1, which runs a task once started, and the FIFOs, spinlocks, and
    // doorbells the two cores share; see std/embedded/chip/rp_multicore.
    pub core1: rp_multicore.Core1
    pub fifos: rp_multicore.Fifos
    pub spinlocks: rp_multicore.Spinlocks
    pub doorbells: rp_multicore.Doorbells
    // The program flash, for storing data above the program; see
    // std/embedded/chip/rp_flash.
    pub flash: rp_flash.Flash
    // Sleep modes, clock gating, the dormant state, power-down, and the
    // system clock's rate; see Power.
    pub power: Power
}

// Configure clocks, take GPIO, the timer, DMA, and the TRNG out of reset, and
// return the peripherals. A second call returns Error.Busy, so no two owners exist; an
// unusable crystal frequency returns Error.InvalidInput, and a crystal, PLL,
// or TRNG that does not start returns Error.Timeout.
pub fn take(config: Config) -> Peripherals!hal.Error {
    crystal := config.crystal_hz
    if crystal < 1_000_000 || crystal > 15_000_000 || crystal % 1_000_000 != 0 || VCO_HZ % crystal != 0 {
        return err(hal.Error.InvalidInput)
    }
    section := hal.Critical.enter()
    // SAFETY: interrupts are masked, so the flag is read and set atomically
    // on this core. Core 1 waits in the boot ROM until the program starts
    // it through the peripherals returned here.
    taken := unsafe {
        TAKEN
    }
    unsafe {
        TAKEN = true
    }
    core.drop(section)
    if taken {
        return err(hal.Error.Busy)
    }
    // SAFETY: TAKEN guarantees this runs once, so this code is the only
    // user of the clock, reset, PLL, and tick registers.
    unsafe {
        start_clocks(crystal)?
        reset_blocks(RESET_IO_BANK0 | RESET_PADS_BANK0 | RESET_TIMER0 | RESET_DMA | RESET_TRNG)?
        // The controllers whose rates follow clk_sys stay in reset until
        // claimed, whatever ran before, so Power.set_system_hz sees only
        // the claimed ones.
        hold := reg(RESET + SET_ALIAS)
        hold.write(SYSTEM_CLOCKED)
    }
    // SAFETY: TAKEN guarantees one Rtc, the only user of the power
    // manager's timer, alarm, and interrupt enable registers apart from
    // Power, which uses them only while interrupts are masked.
    aon := unsafe {
        rp_rtc.AonTimer.new(hal.RegisterBlock.at(POWMAN_BASE), crystal)?
    }
    // SAFETY: TAKEN guarantees one Power, the only user of the power
    // manager's PWRUP, STATE, and SCRATCH7 registers.
    down := unsafe {
        powman := hal.RegisterBlock.at(POWMAN_BASE)
        rp_power.take_power_down_wake(&mut powman)
    }
    if down.crystal_tick {
        // The power sequencer moved the tick to the low-power oscillator.
        aon.use_crystal(crystal)?
    }
    // SAFETY: the timer was just taken out of reset; Timer only reads its
    // free-running counter registers.
    timer := unsafe {
        Timer { high: hal.Reg.at(TIMER_RAW_HIGH), low: hal.Reg.at(TIMER_RAW_LOW), alarms: 0 }
    }
    // SAFETY: TAKEN guarantees one bank, and Chip is what the bank needs:
    // the GPIOs' control and pad registers and the bus controllers are
    // otherwise unused.
    bank := unsafe {
        rp_pins.Bank.new(Chip { crystal_hz: crystal, pin_count: pin_count() })
    }
    // SAFETY: TAKEN guarantees one Watchdog, and the watchdog tick runs.
    // Core 1 uses only the power-on state machine's FRCE_OFF register.
    watchdog := unsafe {
        rp_watchdog.Watchdog.at(rp_watchdog.RP2350, WATCHDOG_BASE, PSM_BASE)
    }
    usb := Usb { crystal_hz: crystal, open: false }
    // SAFETY: TAKEN guarantees one Dma, and the controller was just taken
    // out of reset.
    dma := unsafe {
        rp_dma.Dma.new(rp_dma.RP2350)
    }
    // SAFETY: TAKEN guarantees one generator, and the TRNG was just taken
    // out of reset.
    rng := unsafe {
        rp_rng.Trng.at(TRNG_BASE, TRNG_IRQ)?
    }
    // SAFETY: TAKEN guarantees one set of the cores' parts, and core 1 is
    // not running yet, so no spinlock is held.
    cores := unsafe {
        rp_multicore.reset_spinlocks(RESERVED_SPINLOCKS)
        rp_multicore.take(rp_multicore.Chip {
            psm_base: PSM_BASE,
            core1_bit: PSM_PROC1,
            core0_fifo_irq: SIO_IRQ_FIFO,
            core1_fifo_irq: SIO_IRQ_FIFO,
            reserved_locks: RESERVED_SPINLOCKS,
            doorbell_irq: some(SIO_IRQ_BELL),
            // IO_QSPI at 0x40030000, PROC0_INTF at 0x220, and SCLK's
            // LEVEL_LOW bit (datasheet 9.11.2), as the runtime's
            // dodo_lockout_handler expects. The QSPI pins are secure, so
            // the forced interrupt is IO_IRQ_QSPI, not IO_IRQ_QSPI_NS.
            lockout: rp_multicore.LockoutLine { qspi_base: 0x4003_0000, force: 0x220, bit: 0x100, irq: IO_IRQ_QSPI },
        })
    }
    let rp_multicore.Cores { core1, fifos, spinlocks, doorbells } = cores
    // SAFETY: TAKEN guarantees one Flash.
    flash := unsafe {
        rp_flash.Flash.take()
    }
    power := Power { crystal_hz: crystal, powered_down: down.happened, woken: down.woken, retained: down.retained }
    pins := Pins { bank }
    rtc := Rtc { aon, crystal_hz: crystal, external: false, clock_pin: none }
    // A GPIO time reference kept from before the reset: its pad was reset,
    // so claim the pin again, which lets the clock through, and give it to
    // the Rtc.
    tick := rtc.aon.tick_source()
    if tick == rp_rtc.TICK_CLOCK_INPUT || tick == rp_rtc.TICK_INPUT {
        reference := rtc.aon.reference_pin()
        match pins.input(reference) {
            ok(input) => {
                rtc.external = true
                rtc.clock_pin = some(input)
            }
            err(_) => {}
        }
    }
    return ok(Peripherals { pins, timer, rtc, watchdog, usb, dma, rng, core1, fifos, spinlocks, doorbells, power, flash })
}

// SAFETY: the caller owns `address`, a 32-bit RP2350 register.
unsafe fn reg(address: usize) -> hal.Reg<u32> {
    unsafe {
        return hal.Reg.at(address)
    }
}

// Pulse the reset of `blocks` and wait until they are running again. Their
// clocks start first, in case Power stopped them. The set and clear aliases
// leave every other block alone.
// SAFETY: the caller owns `blocks`.
unsafe fn reset_blocks(blocks: u32) -> void!hal.Error {
    unsafe {
        clocks := hal.RegisterBlock.at(CLOCKS_BASE)
        rp_power.set_clocks(&mut clocks, CLOCKS_WAKE_EN, block_clocks(blocks))
        hold := reg(RESET + SET_ALIAS)
        hold.write(blocks)
        release := reg(RESET + CLEAR_ALIAS)
        release.write(blocks)
        done := reg(RESET_DONE)
        return done.wait_set(blocks, ATTEMPTS)
    }
}

// Start a tick generator: `cycles` of clk_ref per tick.
// SAFETY: the caller owns the tick generator at `base`.
unsafe fn start_tick(base: usize, cycles: u32) {
    unsafe {
        control := reg(base)
        control.write(0)
        count := reg(base + 4)
        count.write(cycles)
        control.write(TICK_ENABLE)
    }
}

// Start the PLL at `base`, held in reset by `reset`: a VCO at `vco_hz`
// from the crystal, divided by `post1` and `post2`.
// SAFETY: the caller owns the PLL, and nothing may use its output yet.
unsafe fn start_pll(base: usize, reset: u32, crystal_hz: u32, vco_hz: u32, post1: u32, post2: u32) -> void!hal.Error {
    unsafe {
        reset_blocks(reset)?
        cs := reg(base + PLL_CS)
        cs.write(1)
        feedback := reg(base + PLL_FBDIV_INT)
        feedback.write(vco_hz / crystal_hz)
        power_on := reg(base + PLL_PWR + CLEAR_ALIAS)
        power_on.write(PLL_POWER_DOWN | PLL_VCO_POWER_DOWN)
        cs.wait_set(PLL_LOCK, ATTEMPTS)?
        prim := reg(base + PLL_PRIM)
        prim.write(hal.encode(PLL_POSTDIV1, post1) | hal.encode(PLL_POSTDIV2, post2))
        power_on.write(PLL_POSTDIV_POWER_DOWN)
        return ok()
    }
}

// Start PLL_USB at 48 MHz for one more user, unless it already runs.
// SAFETY: the caller owns its claim on PLL_USB until release_pll_usb, and
// runs in the program, not in an interrupt handler.
unsafe fn acquire_pll_usb(crystal_hz: u32) -> void!hal.Error {
    unsafe {
        if PLL_USB_USERS == 0 {
            start_pll(PLL_USB_BASE, RESET_PLL_USB, crystal_hz, USB_VCO_HZ, 5, 5)?
        }
        PLL_USB_USERS += 1
    }
    return ok()
}

// Give up a claim on PLL_USB; the last one holds it in reset.
// SAFETY: the caller must hold a claim from acquire_pll_usb and no longer
// use the clocks it drives.
unsafe fn release_pll_usb() {
    unsafe {
        PLL_USB_USERS -= 1
        if PLL_USB_USERS == 0 {
            hold := reg(RESET + SET_ALIAS)
            hold.write(RESET_PLL_USB)
        }
    }
}

// SAFETY: the caller owns the clock, XOSC, PLL_SYS, and tick registers, and
// nothing may depend on the current clock rates.
unsafe fn start_clocks(crystal_hz: u32) -> void!hal.Error {
    unsafe {
        resus := reg(CLK_SYS_RESUS_CTRL)
        resus.write(0)

        // Crystal: ~1 ms start-up delay in units of 256 cycles.
        xosc_ctrl := reg(XOSC_CTRL)
        xosc_ctrl.write(XOSC_RANGE_1_15MHZ)
        startup := reg(XOSC_STARTUP)
        startup.write((crystal_hz / 1000 + 128) / 256)
        xosc_ctrl.write(XOSC_RANGE_1_15MHZ | XOSC_ENABLE)
        xosc_status := reg(XOSC_STATUS)
        xosc_status.wait_set(XOSC_STABLE, ATTEMPTS)?

        // Run clk_sys from clk_ref while the PLL is reconfigured.
        sys_ctrl := reg(CLK_SYS_CTRL)
        sys_ctrl.clear_bits(CLK_SYS_SRC_AUX)
        sys_selected := reg(CLK_SYS_SELECTED)
        sys_selected.wait_set(1, ATTEMPTS)?

        start_pll(PLL_SYS_BASE, RESET_PLL_SYS, crystal_hz, VCO_HZ, 5, 2)?

        // clk_ref from the crystal.
        ref_ctrl := reg(CLK_REF_CTRL)
        ref_ctrl.set(CLK_REF_SRC, CLK_REF_SRC_XOSC)
        ref_selected := reg(CLK_REF_SELECTED)
        ref_selected.wait_set(1 << CLK_REF_SRC_XOSC, ATTEMPTS)?
        ref_div := reg(CLK_REF_DIV)
        ref_div.write(DIVIDE_BY_ONE)

        // clk_sys from PLL_SYS (aux source 0) through the glitchless mux.
        sys_ctrl.clear_bits(CLK_SYS_AUXSRC)
        sys_div := reg(CLK_SYS_DIV)
        sys_div.write(DIVIDE_BY_ONE)
        sys_ctrl.set_bits(CLK_SYS_SRC_AUX)
        sys_selected.wait_set(1 << 1, ATTEMPTS)?

        // clk_peri from clk_sys (aux source 0), for UART and SPI.
        peri := reg(CLK_PERI_CTRL)
        peri.write(0)
        peri.write(CLK_ENABLE)

        // 1 MHz ticks for TIMER0 and the watchdog, derived from clk_ref.
        start_tick(TICK_TIMER0, crystal_hz / 1_000_000)
        start_tick(TICK_WATCHDOG, crystal_hz / 1_000_000)
        return ok()
    }
}

// clk_sys now, as Power.set_system_hz left it.
fn system_hz() -> u32 {
    // SAFETY: a single aligned word, written only with interrupts masked.
    unsafe {
        return SYSTEM_CLOCK.hz
    }
}

// Run clk_sys at `plan`'s rate: from clk_ref first, then from PLL_SYS
// restarted at the new rate, or from clk_ref divided down with PLL_SYS
// stopped. On an error clk_sys stays on the crystal, undivided.
// SAFETY: interrupts must be masked, the caller owns the clock and PLL_SYS
// registers, and nothing may depend on clk_sys's rate meanwhile.
unsafe fn switch_system_clock(crystal_hz: u32, plan: &rp_power.SystemClock) -> void!hal.Error {
    unsafe {
        sys_ctrl := reg(CLK_SYS_CTRL)
        sys_ctrl.clear_bits(CLK_SYS_SRC_AUX)
        sys_selected := reg(CLK_SYS_SELECTED)
        sys_selected.wait_set(1, ATTEMPTS)?
        sys_div := reg(CLK_SYS_DIV)
        sys_div.write(DIVIDE_BY_ONE)
        hold := reg(RESET + SET_ALIAS)
        hold.write(RESET_PLL_SYS)
        SYSTEM_CLOCK = rp_power.SystemClock { hz: crystal_hz, from_pll: false, vco_hz: 0, post1: 1, post2: 1, divider: 1 }
        if plan.from_pll {
            start_pll(PLL_SYS_BASE, RESET_PLL_SYS, crystal_hz, plan.vco_hz, plan.post1, plan.post2)?
            sys_ctrl.clear_bits(CLK_SYS_AUXSRC)
            sys_ctrl.set_bits(CLK_SYS_SRC_AUX)
            sys_selected.wait_set(1 << 1, ATTEMPTS)?
        } else {
            sys_div.write(plan.divider * DIVIDE_BY_ONE)
        }
        SYSTEM_CLOCK = rp_power.SystemClock { hz: plan.hz, from_pll: plan.from_pll, vco_hz: plan.vco_hz, post1: plan.post1, post2: plan.post2, divider: plan.divider }
        return ok()
    }
}

// Restart PLL_SYS as SYSTEM_CLOCK says, if clk_sys runs from it, and run
// clk_sys from it again: after a dormant state, which ran clk_sys from
// clk_ref with PLL_SYS stopped.
// SAFETY: as for switch_system_clock, with clk_sys running from clk_ref.
unsafe fn restore_system_clock(crystal_hz: u32) -> void!hal.Error {
    unsafe {
        if !SYSTEM_CLOCK.from_pll {
            return ok()
        }
        start_pll(PLL_SYS_BASE, RESET_PLL_SYS, crystal_hz, SYSTEM_CLOCK.vco_hz, SYSTEM_CLOCK.post1, SYSTEM_CLOCK.post2)?
        sys_ctrl := reg(CLK_SYS_CTRL)
        sys_ctrl.clear_bits(CLK_SYS_AUXSRC)
        sys_ctrl.set_bits(CLK_SYS_SRC_AUX)
        sys_selected := reg(CLK_SYS_SELECTED)
        return sys_selected.wait_set(1 << 1, ATTEMPTS)
    }
}

// The low-power oscillator's frequency from OTP, or 0 if the row holds
// none in the expected range.
fn lposc_calibration() -> u32 {
    // SAFETY: the OTP's ECC data window is readable by Secure code, and
    // reading a row has no side effects.
    hz := unsafe {
        row: hal.Reg<u16> = hal.Reg.at(OTP_DATA_BASE + 2 * OTP_LPOSC_CALIB_ROW)
        row.read() as u32
    }
    if hz < LPOSC_CALIB_MIN_HZ || hz > LPOSC_CALIB_MAX_HZ {
        return 0
    }
    return hz
}

// The user GPIOs, 0 to pin_count() - 1 (29 on the RP2350A, 47 on the
// RP2350B), and the I2C, SPI, and UART controllers that use them. Each pin
// and each controller can be taken once, and given back. GPIO 30 to 47
// carry the same functions in the same pattern as GPIO 0 to 29 (9.4), so
// the pin rules below continue up to GPIO 47 on the RP2350B.
pub struct Pins {
    bank: rp_pins.Bank<Chip>

    // The GPIOs this chip's package has: PIN_COUNT on the RP2350A,
    // MAX_PIN_COUNT on the RP2350B. Claims of higher pins are InvalidInput.
    pub fn pin_count(&self) -> u32 {
        return self.bank.pin_count()
    }

    // Claim pin `number` as a push-pull output, initially low.
    pub fn output(&mut self, number: u32) -> Pin!hal.Error {
        pin := self.claim(number)?
        pin.set_low()
        pin.set_as_output()
        return ok(pin)
    }

    // Claim pin `number` as an input.
    pub fn input(&mut self, number: u32) -> Pin!hal.Error {
        pin := self.claim(number)?
        pin.set_as_input()
        return ok(pin)
    }

    // Give back a pin from `output` or `input`. It stops driving and is
    // disconnected until claimed again, for example as part of a bus.
    pub fn release(&mut self, pin: Pin) {
        pin.ignore_on(0, ALL_EVENTS)
        pin.ignore_on(1, ALL_EVENTS)
        pin.clear_events(ALL_EVENTS)
        pin.set_as_input()
        self.bank.release_gpio(rp_pins.pin_bit(pin.number))
    }

    // Claim pins `sda` and `scl` as an I2C bus with an SCL frequency of
    // `frequency_hz`, at most hal.I2C_FAST_PLUS_HZ. Even pins carry SDA and
    // odd pins SCL. GPIO 0 and 1, 4 and 5, and so on in steps of four belong
    // to I2C0; GPIO 2 and 3, 6 and 7, and so on to I2C1. InvalidInput if the
    // two pins cannot form a bus or the frequency is out of range, Busy if a
    // pin or the controller is taken. The pads' own pull-ups (about 50 kOhm)
    // keep an idle bus high but are too weak for fast mode: most sensor
    // boards add 4.7 kOhm pull-ups, and a bare bus needs them. The
    // designware_i2c driver documents the bus's errors.
    pub fn i2c(&mut self, sda: u32, scl: u32, frequency_hz: u32) -> designware_i2c.Bus!hal.Error {
        return self.bank.i2c(sda, scl, frequency_hz)
    }

    // Claim pins as an SPI bus in `mode`, clocked at the fastest rate up to
    // `frequency_hz` (at most SYS_HZ / 2, 75 MHz): `clock` (SCK), `tx`
    // (data out to the devices, MOSI), and `rx` (data in from them, MISO),
    // or none when they only listen. GPIO n carries RX when n % 4 is 0, the
    // clock when it is 2, and TX when it is 3. GPIO 0 to 7, 16 to 23, and
    // 32 to 39 belong to SPI0, GPIO 8 to 15, 24 to 31, and 40 to 47 to
    // SPI1. Give each device
    // an output pin as its chip select, through hal.SpiDevice. Errors as for
    // `i2c`.
    pub fn spi(&mut self, clock: u32, tx: u32, rx: Option<u32>, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        return self.bank.spi(clock, tx, rx, mode, frequency_hz)
    }

    // Claim pin `tx` as a serial port's transmit line (to the other end's
    // RX), and `rx` as its receive line, or none to only send. Frames are
    // 8N1 at the rate closest to `baud`, from 144 baud up to SYS_HZ / 16
    // (9.4 Mbaud); 115_200 is the usual choice for a terminal. GPIO n
    // carries TX when n % 4 is 0 or 2 and RX when it is 1 or 3 (the second
    // of each through the RP2350's UART_AUX function, on the pins that
    // otherwise carry CTS and RTS): UART0 has TX on 0, 2, 12, 14, 16, 18,
    // and 28 and RX on 1, 3, 13, 15, 17, 19, and 29, UART1 TX on 4, 6, 8,
    // 10, 20, 22, 24, and 26 and RX on 5, 7, 9, 11, 21, 23, 25, and 27; on
    // the RP2350B also UART0 TX on 30, 32, 34, 44, 46 and RX on 31, 33, 35,
    // 45, 47, UART1 TX on 36, 38, 40, 42 and RX on 37, 39, 41, 43.
    // The port implements the std/io Reader
    // and Writer protocols, so std/fmt prints to it; until it is released,
    // a panic writes its failure message to it before the chip halts.
    // InvalidInput if the pins cannot form a port or the baud rate is out
    // of range, Busy if a pin or the controller is taken. The pl011 driver
    // documents the port.
    pub fn uart(&mut self, tx: u32, rx: Option<u32>, baud: u32) -> pl011.Port!hal.Error {
        return self.bank.uart(tx, rx, baud)
    }

    // `uart` with hardware flow control, turned on: `cts` is an input, low
    // while the other end may receive, and `rts` an output, low while this
    // port may. GPIO n carries CTS when n % 4 is 2 and RTS when it is 3, in
    // the TX and RX pins' group of four: UART0 has CTS on 2, 14, 18 (and
    // 30, 34, 46) and RTS on 3, 15, 19 (31, 35, 47), UART1 CTS on 6, 10,
    // 22, 26 (38, 42) and RTS on 7, 11, 23, 27 (39, 43).
    // Errors as for `uart`.
    pub fn uart_flow(&mut self, tx: u32, rx: u32, cts: u32, rts: u32, baud: u32) -> pl011.Port!hal.Error {
        return self.bank.uart_flow(tx, rx, cts, rts, baud)
    }

    // `spi` with the controller's own chip select on pin `select` as well,
    // for devices in the TI and Microwire frame formats (see
    // pl022.FrameFormat), which need its timing. GPIO n carries it when
    // n % 4 is 1, in the bus's block of eight: SPI0 on 1, 5, 17, 21 (33,
    // 37), SPI1 on 9, 13, 25, 29 (41, 45). Errors as for `spi`.
    pub fn spi_with_select(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        return self.bank.spi_with_select(clock, tx, rx, select, mode, frequency_hz)
    }

    // Claim pins as an SPI target (slave) in `mode`, for another master to
    // clock, at up to SYS_HZ / 12 (12.5 MHz), and select: `rx` receives
    // what it sends, `tx` answers, and the pins are numbered as for `spi`
    // and `spi_with_select`. The pl022 driver documents the target.
    pub fn spi_target(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode) -> pl022.TargetBus!hal.Error {
        return self.bank.spi_target(clock, tx, rx, select, mode)
    }

    // Claim pins `sda` and `scl`, numbered as for `i2c`, as an I2C target
    // (slave) answering another master at `address`, a 10-bit address with
    // `ten_bit`. `frequency_hz` is the master's SCL frequency, which sets
    // the input filter. InvalidInput for an address the I2C specification
    // reserves (7-bit 0x00 to 0x07 and 0x78 to 0x7F), otherwise errors as
    // for `i2c`. The designware_i2c driver documents the target.
    pub fn i2c_target(&mut self, sda: u32, scl: u32, address: u16, ten_bit: bool, frequency_hz: u32) -> designware_i2c.TargetBus!hal.Error {
        return self.bank.i2c_target(sda, scl, address, ten_bit, frequency_hz)
    }

    // Claim pin `pin` as a PWM output at the frequency closest to
    // `frequency_hz`, from 9 Hz up to SYS_HZ / 2, low until a duty is set.
    // GPIO n is output A (n even) or B (n odd) of PWM slice (n / 2) % 8:
    // GPIO n and n + 16 carry the same output, and the two outputs of a
    // slice share its frequency. On the RP2350B GPIO 32 to 47 are outputs
    // of slices 8 to 11, 8 + ((n - 32) / 2) % 4, so GPIO n and n + 8 share
    // one. The output implements hal.PwmOutput, with
    // max_duty() steps up to 65535; rp_pwm documents it. InvalidInput for a
    // GPIO the chip lacks or a frequency out of range, Busy if the pin or its output
    // is taken, or if the slice's other output runs at another frequency.
    pub fn pwm(&mut self, pin: u32, frequency_hz: u32) -> rp_pwm.Pwm!hal.Error {
        return self.bank.pwm(pin, frequency_hz)
    }

    // `pwm` with the slice's divider of clk_sys, in sixteenths from 16 (1)
    // to 4095 (255 15/16), and its TOP, up to 65534, given instead: the
    // output's frequency is SYS_HZ * 16 / divider / (top + 1), and its duty
    // runs from 0 to top + 1. Errors as for `pwm`.
    pub fn pwm_divided(&mut self, pin: u32, divider: u32, top: u32) -> rp_pwm.Pwm!hal.Error {
        return self.bank.pwm_divided(pin, divider, top)
    }

    // Claim pin `pin`, an odd GPIO, as a PWM input that measures the
    // frequency and duty cycle of the signal on it: GPIO n is input B of
    // its PWM slice (as for `pwm`), whose counter counts its rising edges and its
    // high time in windows of `window_us`, up to 111 ms, two per
    // measurement. Its pull-down holds an unconnected pin low. The input
    // implements hal.PwmInput; rp_pwm.Capture documents the measurement and
    // its precision. InvalidInput for an even pin, a GPIO the chip lacks,
    // or a window of 0 or too long, Busy if the pin is taken or either
    // output of its slice is in use.
    pub fn pwm_input(&mut self, pin: u32, window_us: u32) -> rp_pwm.PwmCapture!hal.Error {
        return self.bank.pwm_input(pin, window_us)
    }

    // Claim pin `pin`, GPIO 26 to 29 (ADC inputs 0 to 3), as an analog
    // input, with its digital input and pulls turned off. It implements
    // hal.AnalogInput: 12-bit polled reads, 0 to 4095 for 0 V to the ADC's
    // reference, ADC_AVDD; rp_adc documents it. InvalidInput for another
    // pin, Busy if the pin is taken, Timeout if the ADC does not start.
    pub fn analog(&mut self, pin: u32) -> rp_adc.Analog!hal.Error {
        return self.bank.analog(pin)
    }

    // Claim the on-chip temperature sensor, ADC input 4, an analog input
    // like those of `analog`: rp_adc.millicelsius(value, 3300) converts a
    // reading. Busy if it is claimed already.
    pub fn temperature(&mut self) -> rp_adc.Analog!hal.Error {
        return self.bank.temperature()
    }

    // Claim the ADC as a sampler that converts `inputs`, a set such as
    // rp_adc.GPIO26 | rp_adc.TEMPERATURE, one after the other at `rate_hz`
    // conversions a second in all (733 to 500 000), into its FIFO, for
    // polled, interrupt-driven, or DMA reads; rp_adc.Sampler documents it.
    // Its pins are claimed as analog inputs. InvalidInput for an empty set
    // or a rate out of range, Busy if a pin is taken or an analog input or
    // the temperature sensor is claimed, as they share the converter;
    // Timeout if the ADC does not start.
    pub fn sampler(&mut self, inputs: rp_adc.Inputs, rate_hz: u32) -> rp_adc.AdcSampler!hal.Error {
        return self.bank.sampler(inputs, rate_hz, ADC_IRQ_FIFO)
    }

    // Claim PIO block `number`, 0 to 2, with its four state machines
    // stopped, for programs from rp_pio.assemble; rp_pio documents it. Its
    // state machines run at up to SYS_HZ instructions a second and drive
    // the pins given to it with `pio_pins`. InvalidInput for another
    // number, Busy if the block is claimed.
    pub fn pio(&mut self, number: u32) -> rp_pio.Pio!hal.Error {
        return self.bank.pio(number)
    }

    // Connect the `count` pins from GPIO `first` to PIO block `pio`, for
    // its state machines to drive through their pin mappings and read.
    // They also read pins claimed in other ways: claim a pin they only
    // read as an input, for example, to share it. A block reaches GPIO 0
    // to 31, or 16 to 47 once `pio.set_gpio_base(16)` moves its window,
    // which pins above GPIO 31 on the RP2350B need. InvalidInput for a
    // GPIO the chip lacks, pins outside the block's window, or a count of
    // 0, Busy if a pin is taken.
    pub fn pio_pins(&mut self, pio: &rp_pio.Pio, first: u32, count: u32) -> void!hal.Error {
        return self.bank.pio_pins(pio, first, count)
    }

    // Claim pin `pin` for PIO block `pio` and capture its edges
    // (rp_capture.RISING, FALLING, or BOTH) with one of the block's state
    // machines: a hal.InputCapture whose edge times the state machine
    // latches, in ticks of `tick_hz`, up to SYS_HZ / 4. rp_capture
    // documents it. Errors as for pio_pins, and InvalidInput for a rate
    // rp_capture.divider refuses; Busy without a free state machine or 14
    // free instruction slots.
    pub fn edge_capture(&mut self, pio: &mut rp_pio.Pio, pin: u32, edges: u32, tick_hz: u32) -> rp_capture.EdgeCapture!hal.Error {
        return self.bank.edge_capture(pio, pin, edges, tick_hz)
    }

    // Give back a capture from `edge_capture` to the block it came from.
    pub fn release_edge_capture(&mut self, capture: rp_capture.EdgeCapture, pio: &mut rp_pio.Pio) {
        self.bank.release_edge_capture(capture, pio)
    }

    // Give back a PIO block, once its state machines have been given back
    // to it with `pio.release_state_machine`: its pins are disconnected
    // and the block is held in reset, which forgets its programs.
    pub fn release_pio(&mut self, pio: rp_pio.Pio) {
        self.bank.release_pio(pio)
    }

    // Give back a PWM output. Its pin stops driving and is disconnected.
    pub fn release_pwm(&mut self, output: rp_pwm.Pwm) {
        self.bank.release_pwm(output)
    }

    // Claim PWM slice `slice`, 0 to 11, as a periodic timer and counter
    // counting at `tick_hz`: clk_sys divided by a whole number of
    // sixteenths from 1 to 255 15/16, such as 150 MHz, 10 MHz, 1 MHz, or
    // 600 kHz. It is a hal.PeriodicTimer whose periods, up to 65536 ticks,
    // end when the slice's counter wraps, raising PWM_IRQ_WRAP_0 while it
    // listens, and a hal.TickCounter; rp_pwm.SliceTimer documents it. It
    // drives no pins but takes both outputs of its slice; slices 8 to 11
    // serve no pins here, so they cost none. InvalidInput for another
    // slice or rate, Busy if the slice is in use.
    pub fn pwm_timer(&mut self, slice: u32, tick_hz: u32) -> rp_pwm.PwmTimer!hal.Error {
        return self.bank.pwm_timer(slice, tick_hz)
    }

    // Give back a timer from `pwm_timer`.
    pub fn release_pwm_timer(&mut self, timer: rp_pwm.PwmTimer) {
        self.bank.release_pwm_timer(timer)
    }

    // Give back a PWM input. Its slice stops and its pin is disconnected.
    pub fn release_pwm_input(&mut self, input: rp_pwm.PwmCapture) {
        self.bank.release_pwm_input(input)
    }

    // Give back an analog input or the temperature sensor; the ADC and its
    // clock stop once no input is left.
    pub fn release_analog(&mut self, input: rp_adc.Analog) {
        self.bank.release_analog(input)
    }

    // Give back the ADC's sampler: it stops, its pins are disconnected,
    // and the ADC and its clock stop.
    pub fn release_sampler(&mut self, sampler: rp_adc.AdcSampler) {
        self.bank.release_sampler(sampler)
    }

    // Give back an I2C bus. Its controller is held in reset and its pins are
    // disconnected but still pulled up, so the bus stays idle. A device that
    // holds SDA low after an interrupted transfer, which makes the bus
    // Timeout, can then be freed by claiming SCL as an output and clocking
    // it by hand before claiming the bus again.
    pub fn release_i2c(&mut self, bus: designware_i2c.Bus) {
        self.bank.release_i2c(bus)
    }

    // Give back an SPI bus: its controller is held in reset and its pins
    // are disconnected.
    pub fn release_spi(&mut self, bus: pl022.Bus) {
        self.bank.release_spi(bus)
    }

    // Give back a serial port, once everything written to it is out: its
    // controller is held in reset and its pins are disconnected but still
    // pulled up, so the line stays idle.
    pub fn release_uart(&mut self, port: pl011.Port) {
        self.bank.release_uart(port)
    }

    // Give back an I2C target, as for `release_i2c`.
    pub fn release_i2c_target(&mut self, target: designware_i2c.TargetBus) {
        self.bank.release_i2c_target(target)
    }

    // Give back an SPI target, as for `release_spi`.
    pub fn release_spi_target(&mut self, target: pl022.TargetBus) {
        self.bank.release_spi_target(target)
    }

    fn claim(&mut self, number: u32) -> Pin!hal.Error {
        self.bank.gpio(number)?
        group := 4 * (number / 8) as usize
        // GPIO 32 to 47 are bits 0 to 15 of the GPIO_HI registers.
        high := 0usize
        if number >= 32 {
            high = GPIO_HI
        }
        // SAFETY: the bank makes this pin's control and pad registers
        // exclusive to the returned Pin. The SIO output SET/CLR/XOR and
        // output-enable SET/CLR registers are write-only per-bit aliases and IN
        // is read-only, so pins never conflict there. Likewise the pin writes
        // only its own bits of the shared interrupt registers, through the
        // write-one-to-clear INTR and the INTE set and clear aliases, and
        // INTS is read-only.
        unsafe {
            return ok(Pin {
                number,
                set: reg(GPIO_OUT_SET + high),
                clear: reg(GPIO_OUT_CLR + high),
                toggle: reg(GPIO_OUT_XOR + high),
                input: reg(GPIO_IN + high),
                output_enable: reg(GPIO_OE_SET + high),
                output_disable: reg(GPIO_OE_CLR + high),
                mask: 1u32 << (number % 32),
                raw_events: reg(GPIO_INTR + group),
                interrupts: GPIO_PROC0_INTE + group,
                shift: 4 * (number % 8),
            })
        }
    }
}

// The USB controller, as a USB serial port for the host the board is
// plugged into. rp_usb documents the port.
pub struct Usb {
    crystal_hz: u32
    open: bool

    // Start the controller as a USB serial port (CDC-ACM) named "RP2350",
    // with rp_usb's default identity, and return it. The host enumerates it within about a second; what is
    // written before a terminal opens it is kept, up to rp_usb.TX_CAPACITY
    // bytes. The port is served from the USBCTRL_IRQ interrupt, so it keeps
    // working while the program busy-waits; a program's own USBCTRL_IRQ
    // handler replaces that. Until it is released, a panic is reported on
    // it, and a host that sets 1200 baud, as `dodo run` does, restarts the
    // board into its bootloader. Busy if a port is open or clk_sys runs at
    // 48 MHz or less (Power.set_system_hz), Timeout if PLL_USB or the
    // controller does not start.
    pub fn serial(&mut self) -> rp_usb.Serial!hal.Error {
        return self.serial_with(rp_usb.default_identity("RP2350"), MAX_PIN_COUNT)
    }

    // `serial`, with the `identity` the host sees, and the pin the USB
    // bootloader lights while its drive is accessed after the host
    // restarts the board into it, or a pin the chip lacks, such as
    // MAX_PIN_COUNT, for none. Board packages
    // pass the default identity with the board's name, and the board's
    // LED.
    pub fn serial_with(&mut self, identity: rp_usb.Identity, activity_led: u32) -> rp_usb.Serial!hal.Error {
        if self.open || system_hz() < USB_MIN_SYSTEM_HZ {
            return err(hal.Error.Busy)
        }
        // SAFETY: `open` makes this the only user of the controller, its
        // reset bit, and clk_usb, and acquire_pll_usb shares PLL_USB with
        // the ADC.
        unsafe {
            acquire_pll_usb(self.crystal_hz)?
            // clk_usb from PLL_USB (aux source 0), undivided: 48 MHz.
            control := reg(CLK_USB_CTRL)
            control.write(0)
            divider := reg(CLK_USB_DIV)
            divider.write(DIVIDE_BY_ONE)
            control.write(CLK_ENABLE)
            match reset_blocks(RESET_USBCTRL) {
                ok() => {}
                err(error) => {
                    control.write(0)
                    release_pll_usb()
                    return err(error)
                }
            }
            USB_ACTIVITY_LED = activity_led
            serial := rp_usb.open(USBCTRL_REGS_BASE, USBCTRL_DPRAM_BASE, identity, usb_bootloader)
            cortex_m.enable(USBCTRL_IRQ)
            self.open = true
            return ok(serial)
        }
    }

    // Give back the port: the board disconnects from the host, output not
    // yet sent is dropped, and the controller and its clock stop.
    pub fn release_serial(&mut self, serial: rp_usb.Serial) {
        cortex_m.disable(USBCTRL_IRQ)
        rp_usb.close(serial)
        cortex_m.unpend(USBCTRL_IRQ)
        // SAFETY: the port is closed, so nothing uses the controller or
        // clk_usb, and this releases the port's claim on PLL_USB.
        unsafe {
            hold := reg(RESET + SET_ALIAS)
            hold.write(RESET_USBCTRL)
            control := reg(CLK_USB_CTRL)
            control.write(0)
            release_pll_usb()
        }
        self.open = false
    }
}

// The USB serial port's restart into the bootloader, from its interrupt.
fn usb_bootloader() {
    // SAFETY: written only while the port is closed.
    led := unsafe {
        USB_ACTIVITY_LED
    }
    reboot_to_bootloader(led)
}

// What rp_pins.Bank needs from this chip. Only the Bank in Pins has one.
struct Chip {
    crystal_hz: u32
    // From pin_count(), read once by take().
    pin_count: u32

    pub fn pin_count(&self) -> u32 {
        return self.pin_count
    }

    pub fn route(&mut self, number: u32, function: u32, clear: u32, set: u32) {
        // SAFETY: the bank routes only pins it holds.
        unsafe {
            route(number, function, clear, set)
        }
    }

    pub fn reset(&mut self, controller: u32) -> void!hal.Error {
        // SAFETY: the bank resets only controllers it holds. The reset alias
        // registers change only their bits.
        unsafe {
            return reset_blocks(controller_reset(controller))
        }
    }

    pub fn hold(&mut self, controller: u32) {
        // SAFETY: as for `reset`.
        unsafe {
            hold := reg(RESET + SET_ALIAS)
            hold.write(controller_reset(controller))
        }
    }

    pub fn base(&self, controller: u32) -> usize {
        if controller == rp_pins.I2C0 {
            return I2C0_BASE
        } else if controller == rp_pins.I2C1 {
            return I2C1_BASE
        } else if controller == rp_pins.SPI0 {
            return SPI0_BASE
        } else if controller == rp_pins.SPI1 {
            return SPI1_BASE
        } else if controller == rp_pins.UART0 {
            return UART0_BASE
        } else if controller == rp_pins.UART1 {
            return UART1_BASE
        } else if controller == rp_pins.PWM {
            return PWM_BASE
        } else if controller == rp_pins.PIO0 {
            return PIO0_BASE
        } else if controller == rp_pins.PIO1 {
            return PIO1_BASE
        } else if controller == rp_pins.PIO2 {
            return PIO2_BASE
        }
        return ADC_BASE
    }

    pub fn clock_hz(&self) -> u32 {
        return system_hz()
    }

    pub fn pwm_slices(&self) -> u32 {
        return 12
    }

    pub fn pwm_irq(&self) -> u32 {
        return PWM_IRQ_WRAP_0
    }

    pub fn timer_base(&self) -> usize {
        return TIMER0_BASE
    }

    pub fn start_adc(&mut self) -> void!hal.Error {
        // SAFETY: the bank starts the ADC only while it has no input, so
        // nothing uses clk_adc or the ADC, and acquire_pll_usb leaves a
        // running PLL_USB alone. The reset alias registers change only
        // their bits.
        unsafe {
            acquire_pll_usb(self.crystal_hz)?
            // clk_adc from PLL_USB (aux source 0), undivided.
            control := reg(CLK_ADC_CTRL)
            control.write(0)
            divider := reg(CLK_ADC_DIV)
            divider.write(DIVIDE_BY_ONE)
            control.write(CLK_ENABLE)
            reset_blocks(RESET_ADC)?
            registers := hal.RegisterBlock.at(ADC_BASE)
            return rp_adc.start(&mut registers)
        }
    }

    pub fn stop_adc(&mut self) {
        // SAFETY: the bank stops the ADC once its last input is given back.
        unsafe {
            registers := hal.RegisterBlock.at(ADC_BASE)
            rp_adc.stop(&mut registers)
            hold := reg(RESET + SET_ALIAS)
            hold.write(RESET_ADC)
            control := reg(CLK_ADC_CTRL)
            control.write(0)
            release_pll_usb()
        }
    }

    pub fn uart_aux(&self) -> bool {
        return true
    }
    pub fn pio_blocks(&self) -> u32 {
        return PIO_BLOCKS
    }

    pub fn pio_version(&self) -> u32 {
        return 1
    }

    pub fn pio_irq(&self, block: u32) -> u32 {
        return PIO0_IRQ_0 + 2 * block
    }
}

// The RESET_ bit of rp_pins controller number `controller`.
fn controller_reset(controller: u32) -> u32 {
    if controller == rp_pins.I2C0 {
        return RESET_I2C0
    } else if controller == rp_pins.I2C1 {
        return RESET_I2C1
    } else if controller == rp_pins.SPI0 {
        return RESET_SPI0
    } else if controller == rp_pins.SPI1 {
        return RESET_SPI1
    } else if controller == rp_pins.UART0 {
        return RESET_UART0
    } else if controller == rp_pins.UART1 {
        return RESET_UART1
    } else if controller == rp_pins.PIO0 {
        return RESET_PIO0
    } else if controller == rp_pins.PIO1 {
        return RESET_PIO1
    } else if controller == rp_pins.PIO2 {
        return RESET_PIO2
    }
    return RESET_PWM
}

// Connect GPIO `number` to peripheral `function`, and change its pad
// settings: clear the `clear` bits, then set the `set` bits.
// SAFETY: the caller owns the pin's control and pad registers.
unsafe fn route(number: u32, function: u32, clear: u32, set: u32) {
    index := number as usize
    unsafe {
        pad := reg(PADS_BANK0_BASE + 4 + 4 * index)
        pad.modify(clear, set)
        control := reg(IO_BANK0_BASE + 8 * index + 4)
        control.set(FUNCSEL, function)
        // Release the pad only once the peripheral drives it (9.7).
        pad.clear_bits(PAD_ISOLATE)
    }
}

// One GPIO driven by the single-cycle I/O block. Implements the
// std/embedded/hal output and input pin protocols.
pub struct Pin {
    number: u32
    set: hal.Reg<u32>
    clear: hal.Reg<u32>
    toggle: hal.Reg<u32>
    input: hal.Reg<u32>
    output_enable: hal.Reg<u32>
    output_disable: hal.Reg<u32>
    // The pin's bit in the SIO registers above.
    mask: u32
    // This pin's interrupt bits, at `shift`: raw events, and the address
    // of core 0's PROC0_INTE register for its group of eight pins, which
    // core 1's and the status registers follow.
    raw_events: hal.Reg<u32>
    interrupts: usize
    shift: u32

    // The GPIO number.
    pub fn number(&self) -> u32 {
        return self.number
    }

    pub fn set_high(&mut self) {
        self.set.write(self.mask)
    }

    pub fn set_low(&mut self) {
        self.clear.write(self.mask)
    }

    pub fn toggle(&mut self) {
        self.toggle.write(self.mask)
    }

    pub fn is_high(&self) -> bool {
        return self.input.any(self.mask)
    }

    // Drive the pin at its output level, for a line that changes direction
    // such as a half-duplex data line. Pins claimed as inputs start released.
    pub fn set_as_output(&mut self) {
        self.output_enable.write(self.mask)
    }

    // Release the pin so another device can drive it; is_high reads it.
    pub fn set_as_input(&mut self) {
        self.output_disable.write(self.mask)
    }

    // Raise IO_IRQ_BANK0 on the calling core on `events`, any of
    // LEVEL_LOW, LEVEL_HIGH, FALLING_EDGE, and RISING_EDGE, after
    // forgetting edges seen so far. Enable the interrupt in that core's
    // NVIC too: `cortex_m.enable(pin.irq())`. Every pin shares the one
    // interrupt; its handler tells them apart with `events`. Each core has
    // its own enables, and both cores share the vector table, so the one
    // `@interrupt(IO_IRQ_BANK0)` handler runs on whichever core listens:
    // call `listen` and `cortex_m.enable` from code running on core 1 to
    // handle a pin there.
    pub fn listen(&mut self, events: u32) {
        self.listen_on(cpu.core_id(), events)
    }

    // Stop raising the calling core's interrupt on `events`.
    pub fn ignore(&mut self, events: u32) {
        self.ignore_on(cpu.core_id(), events)
    }

    // The events the calling core listens to that are raising its
    // interrupt now.
    pub fn events(&self) -> u32 {
        return self.events_on(cpu.core_id())
    }

    // `listen` for core `core`, 0 or 1, from either core. Another number
    // traps.
    pub fn listen_on(&mut self, core: u32, events: u32) {
        self.clear_events(events)
        enables := self.core_register(core, SET_ALIAS)
        enables.write((events & ALL_EVENTS) << self.shift)
    }

    // `ignore` for core `core`, 0 or 1.
    pub fn ignore_on(&mut self, core: u32, events: u32) {
        enables := self.core_register(core, CLEAR_ALIAS)
        enables.write((events & ALL_EVENTS) << self.shift)
    }

    // `events` for core `core`, 0 or 1.
    pub fn events_on(&self, core: u32) -> u32 {
        status := self.core_register(core, INTS_FROM_INTE)
        return (status.read() >> self.shift) & ALL_EVENTS
    }

    // Core `processor`'s INTE register of this pin's group, at `offset`
    // (an alias, or INTS_FROM_INTE for its INTS).
    fn core_register(&self, processor: u32, offset: usize) -> hal.Reg<u32> {
        core.assert(processor < 2)
        // SAFETY: the pin writes only its own bits, through the set and
        // clear aliases, and INTS is read-only; see Pins.claim.
        unsafe {
            return reg(self.interrupts + CORE_INTERRUPTS * processor as usize + offset)
        }
    }

    // Forget the edges among `events`, acknowledging them; a handler or
    // task must, or the interrupt stays raised. Levels cannot be cleared.
    pub fn clear_events(&mut self, events: u32) {
        self.raw_events.write((events & EDGES) << self.shift)
    }

    // The interrupt pin events raise, IO_IRQ_BANK0, for cortex_m.enable.
    pub fn irq(&self) -> u32 {
        return IO_IRQ_BANK0
    }
}

// The always-on timer of the power manager as a real-time clock: a
// millisecond counter with an alarm. Implements the std/embedded/hal Rtc
// and RtcAlarm protocols, so `hal.rtc_now(&mut b.rtc)` reads it as a date
// and time. It sits in the always-on power domain: once set, it keeps
// counting through the resets that leave that domain running, such as the
// watchdog's and the restart after `Power.power_down`, so a later take()
// finds it still set; it stops when the chip loses power. It ticks from the
// crystal, the most precise source, until told otherwise; the low-power
// oscillator, an external 32 kHz clock, or an external 1 kHz tick keep it
// counting while the crystal is stopped too, and Power moves a crystal tick
// to the low-power oscillator by itself for a timed dormant state or a
// power-down (12.10.5). The alarm raises POWMAN_IRQ_TIMER while
// `listen`ing, and its handler calls `clear_alarm`.
pub struct Rtc: hal.Rtc + hal.RtcAlarm {
    aon: rp_rtc.AonTimer<hal.RegisterBlock>
    crystal_hz: u32
    // A GPIO time reference from `use_clock_input` or `use_tick_input`.
    external: bool
    clock_pin: Option<Pin>

    // Where the tick comes from: rp_rtc.TICK_CRYSTAL, TICK_LPOSC,
    // TICK_CLOCK_INPUT, or TICK_INPUT.
    pub fn tick_source(&mut self) -> u32 {
        return self.aon.tick_source()
    }

    // Tick from the crystal, as take() sets up. Busy while a GPIO time
    // reference is in use: `release_clock_input` returns to the crystal.
    pub fn use_crystal(&mut self) -> void!hal.Error {
        if self.external {
            return err(hal.Error.Busy)
        }
        return self.aon.use_crystal(self.crystal_hz)
    }

    // Tick from the low-power oscillator, at the frequency this chip's OTP
    // records from manufacturing, or else at its nominal 32.768 kHz. It
    // keeps counting while the chip is dormant or powered down, less
    // precisely than the crystal: the oscillator drifts by several percent
    // with temperature and voltage. Busy while a GPIO time reference is in
    // use.
    pub fn use_low_power_oscillator(&mut self) -> void!hal.Error {
        hz := lposc_calibration()
        if hz == 0 {
            hz = rp_rtc.LPOSC_HZ
        }
        return self.use_low_power_oscillator_at(hz)
    }

    // `use_low_power_oscillator`, with a frequency of `hz` measured by the
    // program. InvalidInput outside rp_rtc.LPOSC_MIN_HZ to LPOSC_MAX_HZ.
    pub fn use_low_power_oscillator_at(&mut self, hz: u32) -> void!hal.Error {
        if self.external {
            return err(hal.Error.Busy)
        }
        return self.aon.use_lposc(hz)
    }

    // Tick from an external clock of `clock_hz` on GPIO `pin`, 12, 14, 20,
    // or 22, typically a 32.768 kHz oscillator: it replaces the low-power
    // oscillator, so it also clocks the power manager while the switched
    // core is off, and keeps the time precise in every power state. The
    // pin is claimed as an input until `release_clock_input`. InvalidInput
    // for another pin or a clock outside rp_rtc.LPOSC_MIN_HZ to
    // LPOSC_MAX_HZ, Busy if the pin is taken or a reference is in use.
    pub fn use_clock_input(&mut self, pins: &mut Pins, pin: u32, clock_hz: u32) -> void!hal.Error {
        if clock_hz < rp_rtc.LPOSC_MIN_HZ || clock_hz > rp_rtc.LPOSC_MAX_HZ {
            return err(hal.Error.InvalidInput)
        }
        return self.use_reference(pins, pin, clock_hz)
    }

    // Tick from an external 1 kHz tick on GPIO `pin`, 12, 14, 20, or 22,
    // counted on its falling edges, which keeps counting in every power
    // state. The pin is claimed as an input until `release_clock_input`;
    // the switch may advance the time by up to a millisecond. InvalidInput
    // for another pin, Busy if the pin is taken or a reference is in use.
    pub fn use_tick_input(&mut self, pins: &mut Pins, pin: u32) -> void!hal.Error {
        return self.use_reference(pins, pin, 0)
    }

    // A GPIO reference: a clock of `clock_hz`, or a 1 kHz tick for 0.
    fn use_reference(&mut self, pins: &mut Pins, pin: u32, clock_hz: u32) -> void!hal.Error {
        if self.external {
            return err(hal.Error.Busy)
        }
        source := rp_rtc.ext_time_source(pin)?
        input := pins.input(pin)?
        result := if clock_hz == 0 {
            self.aon.use_tick_input(source)
        } else {
            self.aon.use_clock_input(source, clock_hz)
        }
        match result {
            ok() => {}
            err(error) => {
                match self.aon.use_crystal(self.crystal_hz) {
                    ok() => {}
                    err(_) => {}
                }
                pins.release(input)
                return err(error)
            }
        }
        self.external = true
        self.clock_pin = some(input)
        return ok()
    }

    // Tick from the crystal again and give back the pin of
    // `use_clock_input` or `use_tick_input`, or of a reference that take()
    // found still in use after a reset and claimed again; nothing happens
    // without one.
    pub fn release_clock_input(&mut self, pins: &mut Pins) -> void!hal.Error {
        if let some(input) = option.take(&mut self.clock_pin) {
            result := self.aon.use_crystal(self.crystal_hz)
            self.external = false
            pins.release(input)
            return result
        }
        return ok()
    }

    pub fn is_set(&mut self) -> bool!hal.Error {
        return self.aon.is_set()
    }

    pub fn now_ms(&mut self) -> u64!hal.Error {
        return self.aon.now_ms()
    }

    pub fn set_ms(&mut self, time_ms: u64) -> void!hal.Error {
        return self.aon.set_ms(time_ms)
    }

    // 1: the timer counts milliseconds.
    pub fn resolution_ms(&self) -> u32 {
        return self.aon.resolution_ms()
    }

    pub fn set_alarm_ms(&mut self, time_ms: u64) -> void!hal.Error {
        return self.aon.set_alarm_ms(time_ms)
    }

    pub fn alarm_fired(&mut self) -> bool!hal.Error {
        return self.aon.alarm_fired()
    }

    pub fn clear_alarm(&mut self) -> void!hal.Error {
        return self.aon.clear_alarm()
    }

    // The alarm's interrupt: its number for cortex_m.enable, and its vector
    // name, POWMAN_IRQ_TIMER, for `@interrupt`.
    pub fn irq(&self) -> u32 {
        return POWMAN_IRQ_TIMER
    }

    // Raise POWMAN_IRQ_TIMER when the alarm fires. Enable it in the NVIC
    // too: `cortex_m.enable(rtc.irq())`.
    pub fn listen(&mut self) {
        self.aon.listen()
    }

    // Stop raising the interrupt; alarm_fired still reports.
    pub fn ignore(&mut self) {
        self.aon.ignore()
    }

    pub fn is_listening(&mut self) -> bool {
        return self.aon.is_listening()
    }
}

// The free-running 64-bit microsecond counter of TIMER0. Implements the
// std/embedded/hal delay and counter protocols.
pub struct Timer {
    high: hal.Reg<u32>
    low: hal.Reg<u32>
    // Claimed alarms, one bit each.
    alarms: u32

    // Claim alarm 0 to 3, to run code at a set time from its interrupt.
    // Busy if it is claimed already; InvalidInput for another number.
    pub fn alarm(&mut self, number: u32) -> Alarm!hal.Error {
        if number >= ALARM_COUNT {
            return err(hal.Error.InvalidInput)
        }
        bit := 1u32 << number
        if (self.alarms & bit) != 0 {
            return err(hal.Error.Busy)
        }
        self.alarms |= bit
        // SAFETY: the claim above makes this the only Alarm for `number`.
        // It writes only its own ALARMn register and, through the
        // write-one-to-clear registers and the atomic set and clear
        // aliases, only its own bit of the shared ones.
        alarm := unsafe {
            rp_timer.Alarm.new(rp_timer.Mmio.at(TIMER0_BASE), rp_timer.RP2350_INTR, number, 1_000_000)
        }
        return ok(Alarm { alarm })
    }

    // Disarm an alarm, stop its interrupt, and take it back.
    pub fn release_alarm(&mut self, alarm: Alarm) {
        number := alarm.number()
        let Alarm { alarm: inner } = alarm
        inner.release()
        self.alarms &= ~(1u32 << number)
    }

    // Start TIMER1, the chip's second timer, counting from 0 at
    // `tick_hz`: clk_sys's rate, `Power.system_hz()` (SYS_HZ, 150 MHz,
    // unless `set_system_hz` changed it), to count clk_sys cycles, or the
    // crystal divided by a whole number from 1 to 511, such as 12 MHz,
    // 1 MHz, or 100 kHz with a 12 MHz crystal, from TIMER1's own tick
    // generator. While it counts clk_sys, `set_system_hz` is Busy.
    // InvalidInput for another rate, Busy while it is out.
    pub fn timer1(&mut self, tick_hz: u32) -> Timer1!hal.Error {
        if tick_hz == 0 {
            return err(hal.Error.InvalidInput)
        }
        // SAFETY: start_clocks set TIMER0's tick generator to a CYCLES of
        // crystal_hz / 1 MHz; reading it has no side effects.
        crystal := unsafe {
            reg(TICK_TIMER0 + 4)
        }
        crystal_hz := (crystal.read() & MAX_TICK_CYCLES) * 1_000_000
        cycles := 0u32
        if tick_hz != system_hz() {
            if crystal_hz % tick_hz != 0 || crystal_hz / tick_hz > MAX_TICK_CYCLES {
                return err(hal.Error.InvalidInput)
            }
            cycles = crystal_hz / tick_hz
        }
        section := hal.Critical.enter()
        // SAFETY: interrupts are masked, so the flag is read and set
        // atomically on this core.
        taken := unsafe {
            TIMER1_TAKEN
        }
        unsafe {
            TIMER1_TAKEN = true
        }
        core.drop(section)
        if taken {
            return err(hal.Error.Busy)
        }
        // SAFETY: TIMER1_TAKEN makes this the only user of TIMER1, its
        // reset, and its tick generator.
        unsafe {
            // Ticks first, or none for clk_sys, so the reset starts the
            // count from 0 at the right rate.
            if cycles == 0 {
                control := reg(TICK_TIMER1)
                control.write(0)
            } else {
                start_tick(TICK_TIMER1, cycles)
            }
            match reset_blocks(RESET_TIMER1) {
                ok() => {}
                err(error) => {
                    TIMER1_TAKEN = false
                    return err(error)
                }
            }
            block := rp_timer.Mmio.at(TIMER1_BASE)
            if cycles == 0 {
                block.write(TIMER_SOURCE, SOURCE_CLK_SYS)
            }
            TIMER1_ON_SYSTEM_CLOCK = cycles == 0
            return ok(Timer1 { block, hz: tick_hz, alarms: 0 })
        }
    }

    // Give TIMER1 back: it stops, held in reset, and its tick generator
    // stops. Every alarm claimed from it must have been given back.
    pub fn release_timer1(&mut self, timer1: Timer1) {
        core.assert(timer1.alarms == 0)
        // SAFETY: the Timer1 was the only user of TIMER1 and its tick
        // generator, and nothing uses them any more.
        unsafe {
            control := reg(TICK_TIMER1)
            control.write(0)
            hold := reg(RESET + SET_ALIAS)
            hold.write(RESET_TIMER1)
            TIMER1_ON_SYSTEM_CLOCK = false
            TIMER1_TAKEN = false
        }
    }

    // Microseconds since take().
    pub fn now_us(&self) -> u64 {
        for {
            high := self.high.read()
            low := self.low.read()
            if self.high.read() == high {
                return ((high as u64) << 32) | low as u64
            }
        }
    }

    // The counter as a hal.TickCounter: ticks of 1 MHz, as now_us.
    pub fn tick_hz(&self) -> u32 {
        return 1_000_000
    }

    pub fn now_ticks(&self) -> u64 {
        return self.now_us()
    }

    pub fn delay_us(&mut self, microseconds: u32) {
        start := self.low.read()
        for core.wrapping_sub(self.low.read(), start) < microseconds {}
    }

    pub fn delay_ms(&mut self, milliseconds: u32) {
        end := self.now_us() + (milliseconds as u64) * 1000
        for self.now_us() < end {}
    }
}

// One of the timer's four alarms, claimed with `Timer.alarm(n)`. An alarm
// fires once when the microsecond counter reaches the time it was given;
// with `listen` it raises interrupt TIMER0_IRQ_0 + n, whose handler calls
// `clear` and may schedule the next time. Move it into a
// `static mut Option<Alarm>` for the handler to use. Implements the
// std/embedded/hal alarm and counter protocols, with times up to
// 2^31 - 1 us (35 minutes) ahead, and, counting microseconds as ticks of
// 1 MHz, the compare channel and periodic timer protocols: `start(period)`
// fires it every period, without drift, and the interrupt handler calls
// `poll_periods` instead of `clear`. rp_timer.Alarm documents the modes.
pub struct Alarm: hal.Alarm + hal.Compare + hal.PeriodicTimer {
    alarm: rp_timer.Alarm<rp_timer.Mmio>

    // 0 to 3.
    pub fn number(&self) -> u32 {
        return self.alarm.number()
    }

    // The interrupt the alarm raises: its number for cortex_m.enable, and
    // its vector name, TIMER0_IRQ_0 + n, for `@interrupt`.
    pub fn irq(&self) -> u32 {
        return TIMER0_IRQ_0 + self.alarm.number()
    }

    // The low 32 bits of the microsecond counter, which alarm times use.
    pub fn now(&self) -> u32 {
        return self.alarm.now()
    }

    // Fire when the counter's low 32 bits equal `time`, replacing any
    // earlier time and periodic mode. A time that has just passed fires
    // only after the counter wraps, 71.6 minutes later.
    pub fn schedule_at(&mut self, time: u32) {
        self.alarm.schedule_at(time)
    }

    // Fire `microseconds` from now; at least 1, and below 2^31 so the time
    // is still ahead when the write lands.
    pub fn schedule_in(&mut self, microseconds: u32) {
        self.alarm.schedule_in(microseconds)
    }

    // Fire when now_us() reaches `time_us`, replacing any earlier time and
    // periodic mode, and clearing an earlier firing; the std/embedded/hal
    // alarm protocol. A time already reached fires at once, raising the
    // interrupt if the alarm listens. InvalidInput for a time more than
    // 2^31 - 1 us ahead.
    pub fn schedule_at_us(&mut self, time_us: u64) -> void!hal.Error {
        return self.alarm.schedule_at_ticks(time_us)
    }

    // Disarm, and end periodic mode: a scheduled time no longer fires.
    pub fn cancel(&mut self) {
        self.alarm.cancel()
    }

    // True from scheduling until it fires or is cancelled.
    pub fn is_armed(&self) -> bool {
        return self.alarm.is_armed()
    }

    // True once it has fired, until `clear`.
    pub fn fired(&self) -> bool {
        return self.alarm.fired()
    }

    // Acknowledge that it fired. An interrupt handler has to, or the
    // interrupt stays raised and the handler runs again at once.
    pub fn clear(&mut self) {
        self.alarm.clear()
    }

    // Raise the interrupt when it fires. Enable the interrupt in the NVIC
    // too: `cortex_m.enable(alarm.irq())`.
    pub fn listen(&mut self) {
        self.alarm.listen()
    }

    // Stop raising the interrupt; `fired` still reports.
    pub fn ignore(&mut self) {
        self.alarm.ignore()
    }

    pub fn is_listening(&self) -> bool {
        return self.alarm.is_listening()
    }

    // Microseconds since take(), from the whole 64-bit counter, as
    // Timer.now_us reads it.
    pub fn now_us(&self) -> u64 {
        return self.alarm.now_ticks()
    }

    // The compare channel and periodic timer protocols count ticks of
    // 1 MHz: microseconds.
    pub fn tick_hz(&self) -> u32 {
        return 1_000_000
    }

    pub fn now_ticks(&self) -> u64 {
        return self.alarm.now_ticks()
    }

    // As schedule_at_us; hal.Compare.
    pub fn schedule_at_ticks(&mut self, ticks: u64) -> void!hal.Error {
        return self.alarm.schedule_at_ticks(ticks)
    }

    // Fire every `period_us` microseconds, the first time one period from
    // now, each a whole number of periods after the start; hal.PeriodicTimer.
    // InvalidInput for 0 or more than 2^31 - 1 us (35 minutes).
    pub fn start(&mut self, period_us: u64) -> void!hal.Error {
        return self.alarm.start(period_us)
    }

    // How many periods ended since `start` or the last call, 0 while none
    // has. Clears the firing and arms the alarm for the next period, so
    // the interrupt handler calls it instead of `clear`.
    pub fn poll_periods(&mut self) -> u32 {
        return self.alarm.poll_periods()
    }

    // Whether `start` runs it, until `cancel` or a schedule.
    pub fn is_periodic(&self) -> bool {
        return self.alarm.is_periodic()
    }

    // The period `start` set, in microseconds.
    pub fn period_us(&self) -> u64 {
        return self.alarm.period_ticks()
    }

    // Sleep (`wfi`) until an interrupt is pending or the counter reaches
    // `deadline`, a now_us time; none waits for an interrupt only. With
    // now_us this is the std/embedded/executor clock, so an alarm runs an
    // executor: `executor.run(&mut tasks, &mut alarm)`. The alarm's
    // interrupt ends the sleep while interrupts are masked and is cleared
    // before they are unmasked, so it needs no `@interrupt` handler; other
    // interrupts' handlers run after the return, or once the caller's own
    // critical section ends. Times more than 35 minutes ahead wake early.
    // Leaves the alarm disarmed and not listening.
    pub fn sleep_until(&mut self, deadline: Option<u64>) {
        section := hal.Critical.enter()
        if let some(time) = deadline {
            now := self.now_us()
            if time > now {
                ahead := time - now
                if ahead > MAX_ALARM_SLEEP_US {
                    ahead = MAX_ALARM_SLEEP_US
                }
                irq := self.irq()
                self.clear()
                cortex_m.unpend(irq)
                self.listen()
                cortex_m.enable(irq)
                self.schedule_at(core.wrapping_add((now & 0xFFFF_FFFF) as u32, ahead as u32))
                // A time that passed before the alarm was armed would only
                // fire once the counter wraps. One that passes after it
                // makes the interrupt pending, which ends the sleep at once.
                if self.now_us() < now + ahead {
                    cpu.wait_for_interrupt()
                }
                self.cancel()
                self.ignore()
                self.clear()
                cortex_m.disable(irq)
                cortex_m.unpend(irq)
            }
        } else {
            cpu.wait_for_interrupt()
        }
        core.drop(section)
    }
}

// TIMER1, the chip's second timer, from `Timer.timer1`: a 64-bit counter
// at the rate it was started at, with four alarms of its own, which `alarm`
// hands out. At 150 MHz it counts for 3900 years before wrapping, so it
// times short events to a clk_sys cycle (6.7 ns); at a divided crystal rate
// it reaches further with each alarm. Implements the std/embedded/hal tick
// counter protocol and, through now_us, the counter protocol.
pub struct Timer1: hal.TickCounter + hal.Counter {
    block: rp_timer.Mmio
    hz: u32
    // Claimed alarms, one bit each.
    alarms: u32

    pub fn tick_hz(&self) -> u32 {
        return self.hz
    }

    // Ticks since `Timer.timer1` started it.
    pub fn now_ticks(&self) -> u64 {
        return rp_timer.read_count(&self.block)
    }

    // Microseconds since `Timer.timer1` started it, rounded down.
    pub fn now_us(&self) -> u64 {
        return hal.ticks_to_us(self.now_ticks(), self.hz)
    }

    // Claim alarm 0 to 3 of TIMER1, raising TIMER1_IRQ_0 + n. Busy if it is
    // claimed already; InvalidInput for another number.
    pub fn alarm(&mut self, number: u32) -> Timer1Alarm!hal.Error {
        if number >= ALARM_COUNT {
            return err(hal.Error.InvalidInput)
        }
        bit := 1u32 << number
        if (self.alarms & bit) != 0 {
            return err(hal.Error.Busy)
        }
        self.alarms |= bit
        // SAFETY: the claim above makes this the only Timer1Alarm for
        // `number`; as for Timer.alarm, it changes only its own bits.
        alarm := unsafe {
            rp_timer.Alarm.new(rp_timer.Mmio.at(TIMER1_BASE), rp_timer.RP2350_INTR, number, self.hz)
        }
        return ok(Timer1Alarm { alarm })
    }

    // Disarm an alarm, stop its interrupt, and take it back.
    pub fn release_alarm(&mut self, alarm: Timer1Alarm) {
        number := alarm.number()
        let Timer1Alarm { alarm: inner } = alarm
        inner.release()
        self.alarms &= ~(1u32 << number)
    }
}

// One of TIMER1's four alarms, claimed with `Timer1.alarm(n)`, counting
// TIMER1's ticks: a compare channel that fires once at a tick count, and a
// periodic timer whose periods are whole ticks and do not drift (see
// rp_timer.Alarm). With `listen` it raises interrupt TIMER1_IRQ_0 + n,
// whose handler calls `clear`, or `poll_periods` in periodic mode. Targets
// reach up to 2^31 - 1 ticks ahead: 14.3 s at 150 MHz, 2147 s at 1 MHz.
// Implements the std/embedded/hal compare channel and periodic timer
// protocols, and through microsecond conversions the alarm and counter
// protocols too.
pub struct Timer1Alarm: hal.Compare + hal.PeriodicTimer + hal.Alarm {
    alarm: rp_timer.Alarm<rp_timer.Mmio>

    // 0 to 3.
    pub fn number(&self) -> u32 {
        return self.alarm.number()
    }

    // The interrupt the alarm raises: its number for cortex_m.enable, and
    // its vector name, TIMER1_IRQ_0 + n, for `@interrupt`.
    pub fn irq(&self) -> u32 {
        return TIMER1_IRQ_0 + self.alarm.number()
    }

    pub fn tick_hz(&self) -> u32 {
        return self.alarm.tick_hz()
    }

    // The low 32 bits of TIMER1's count, which raw targets use.
    pub fn now(&self) -> u32 {
        return self.alarm.now()
    }

    // Fire when TIMER1's low 32 bits equal `time`, as Alarm.schedule_at.
    pub fn schedule_at(&mut self, time: u32) {
        self.alarm.schedule_at(time)
    }

    // Fire `ticks` from now; at least 1 and below 2^31.
    pub fn schedule_in(&mut self, ticks: u32) {
        self.alarm.schedule_in(ticks)
    }

    pub fn now_ticks(&self) -> u64 {
        return self.alarm.now_ticks()
    }

    // Fire when now_ticks() reaches `ticks`, as rp_timer.Alarm does;
    // InvalidInput more than 2^31 - 1 ticks ahead.
    pub fn schedule_at_ticks(&mut self, ticks: u64) -> void!hal.Error {
        return self.alarm.schedule_at_ticks(ticks)
    }

    pub fn cancel(&mut self) {
        self.alarm.cancel()
    }

    pub fn is_armed(&self) -> bool {
        return self.alarm.is_armed()
    }

    pub fn fired(&self) -> bool {
        return self.alarm.fired()
    }

    pub fn clear(&mut self) {
        self.alarm.clear()
    }

    // Raise the interrupt when it fires. Enable the interrupt in the NVIC
    // too: `cortex_m.enable(alarm.irq())`.
    pub fn listen(&mut self) {
        self.alarm.listen()
    }

    pub fn ignore(&mut self) {
        self.alarm.ignore()
    }

    pub fn is_listening(&self) -> bool {
        return self.alarm.is_listening()
    }

    // Fire every `period_ticks` ticks without drift; InvalidInput for 0 or
    // more than 2^31 - 1.
    pub fn start(&mut self, period_ticks: u64) -> void!hal.Error {
        return self.alarm.start(period_ticks)
    }

    pub fn poll_periods(&mut self) -> u32 {
        return self.alarm.poll_periods()
    }

    pub fn is_periodic(&self) -> bool {
        return self.alarm.is_periodic()
    }

    pub fn period_ticks(&self) -> u64 {
        return self.alarm.period_ticks()
    }

    // Microseconds since TIMER1 started, rounded down.
    pub fn now_us(&self) -> u64 {
        return hal.ticks_to_us(self.alarm.now_ticks(), self.alarm.tick_hz())
    }

    // Fire once now_us() reaches `time_us`: at the first tick at or after
    // it. InvalidInput for a time more than 2^31 - 1 ticks ahead.
    pub fn schedule_at_us(&mut self, time_us: u64) -> void!hal.Error {
        ticks := hal.us_to_ticks(time_us, self.alarm.tick_hz())
        return self.alarm.schedule_at_ticks(ticks)
    }
}

// Low power, as `Peripherals.power`; implements std/embedded/power's
// protocol, whose package comment describes the modes.
//
// On the RP2350, a deep sleep stops the clocks outside the sleep set only
// while both cores deep-sleep; a core 1 that was never started does. Every
// clock starts in the sleep set, so a deep sleep stops nothing more than a
// light one until `set_sleep_clocks` says otherwise. The clock constants
// above name the gates. Claiming a peripheral starts its clocks, so
// `disable_unused_clocks` is safe at any time. It also stops HSTX, TIMER1,
// and SHA-256, which this package does not drive, while they are held in
// reset; the timer (CLOCK_TIMER), DMA (CLOCK_DMA), and the TRNG
// (CLOCK_TRNG), which take() starts for `Peripherals.rng`, are not claimed
// through Pins, so it leaves them to the program.
//
// `dormant` runs clk_sys from the crystal, stops PLL_SYS and the ring
// oscillator, and stops the crystal until a pin event, then starts them
// again. Both cores stop. The microsecond timer pauses meanwhile, so
// `now_us` does not count the time spent dormant. It returns Busy while the
// USB serial port or an ADC input runs, since their 48 MHz clock would
// stop. Wait until serial ports have sent their last bytes first, as
// clk_peri slows down to the crystal's rate during the switch.
//
// A timeout in the power.Wake uses the always-on timer's alarm (6.5.3),
// which needs the timer set (Busy otherwise) and a tick that runs while the
// crystal is stopped: a tick from the crystal moves to the low-power
// oscillator meanwhile, and clk_ref runs from that oscillator, so the power
// manager stays clocked. The chip wakes up to a millisecond after the
// timeout, counted at the oscillator's precision. An alarm set through the
// Rtc is put back afterwards.
//
// `power_down` goes further: it switches off the switched-core power
// domain, with the processors and every peripheral, and the SRAM it is not
// told to keep, until a pin event or a timeout powers the chip up again
// (6.2). The chip then restarts through reset; after take(),
// `woke_from_power_down` and `power_down_wake` say why, the SRAM domains
// kept still hold their contents, `.noinit` statics included, and the
// `scratch` registers keep a few words in any case.
//
// `set_system_hz` runs clk_sys, and with it clk_peri, slower to save power:
// from the crystal divided by a whole number, with PLL_SYS stopped, or from
// PLL_SYS at a lower rate. The timers, the watchdog, and the always-on
// timer keep their rates, as they count clk_ref or their own ticks, and the
// ADC and USB keep their 48 MHz clock; flash reads slow down with clk_sys.
pub struct Power: power.Power {
    crystal_hz: u32
    // What take() found: a restart after power_down, what woke the chip,
    // and the SRAM domains kept.
    powered_down: bool
    woken: u64
    retained: u32

    // clk_sys in hertz now: SYS_HZ until `set_system_hz`.
    pub fn system_hz(&self) -> u32 {
        return system_hz()
    }

    // The crystal's frequency, the fastest rate `set_system_hz` reaches
    // with PLL_SYS stopped.
    pub fn crystal_hz(&self) -> u32 {
        return self.crystal_hz
    }

    // Run clk_sys at exactly `hz`: the crystal divided by a whole number up
    // to 256, with PLL_SYS stopped, which saves the most, or else PLL_SYS at
    // a rate it reaches exactly, or SYS_HZ, take()'s rate, again.
    // Peripherals claimed later compute their dividers from the new rate,
    // and a SysTick reload the program set counts it too. InvalidInput for
    // 0, above SYS_HZ, or a rate neither reaches, Busy while a UART, SPI,
    // I2C, PWM, PIO, or HSTX block runs or TIMER1 counts clk_sys (release
    // them and claim them again afterwards) or while the USB serial port runs and `hz` is 48 MHz or
    // less, Timeout if PLL_SYS does not lock, leaving clk_sys at the
    // crystal's rate.
    pub fn set_system_hz(&mut self, hz: u32) -> void!hal.Error {
        plan := rp_power.plan_system_clock(self.crystal_hz, hz, VCO_HZ, 5, 2, SYS_HZ)?
        section := hal.Critical.enter()
        // SAFETY: reading RESET has no side effects.
        held := unsafe {
            reg(RESET)
        }
        running := ~held.read()
        // SAFETY: a flag only changed with Timer1's claim and release.
        timer1_on_system_clock := unsafe {
            TIMER1_ON_SYSTEM_CLOCK
        }
        if (running & SYSTEM_CLOCKED) != 0 || timer1_on_system_clock || ((running & RESET_USBCTRL) != 0 && hz < USB_MIN_SYSTEM_HZ) {
            core.drop(section)
            return err(hal.Error.Busy)
        }
        // SAFETY: interrupts are masked, Power owns clk_sys's generator and
        // PLL_SYS, and nothing claimed depends on clk_sys's rate.
        result := unsafe {
            switch_system_clock(self.crystal_hz, &plan)
        }
        core.drop(section)
        return result
    }

    // Whether this start is the restart after `power_down`.
    pub fn woke_from_power_down(&self) -> bool {
        return self.powered_down
    }

    // What powered the chip up after `power_down`, as a `dormant` result:
    // the pins whose events did, bit n for pin n, and power.BY_TIME for
    // the timeout. 0 after any other reset.
    pub fn power_down_wake(&self) -> u64 {
        return self.woken
    }

    // The SRAM domains that stayed powered during the `power_down` before
    // this start, RETAIN_SRAM0 and RETAIN_SRAM1, whose contents survived;
    // RETAIN_NOTHING after any other reset.
    pub fn retained(&self) -> u32 {
        return self.retained
    }

    // Scratch register `index`, below SCRATCH_WORDS: 0 after power-up, and
    // what `set_scratch` left there through power-down and every reset
    // since. Traps for another index.
    pub fn scratch(&self, index: u32) -> u32 {
        core.assert(index < SCRATCH_WORDS)
        // SAFETY: the program's scratch registers belong to Power; reading
        // one has no side effects.
        word := unsafe {
            reg(POWMAN_SCRATCH0 + 4 * index as usize)
        }
        return word.read()
    }

    pub fn set_scratch(&mut self, index: u32, value: u32) {
        core.assert(index < SCRATCH_WORDS)
        // SAFETY: as in `scratch`; these registers need no password.
        word := unsafe {
            reg(POWMAN_SCRATCH0 + 4 * index as usize)
        }
        word.write(value)
    }

    // Switch off the switched core and the XIP cache, and every SRAM domain
    // not in `retain` (RETAIN_SRAM0, RETAIN_SRAM1, or RETAIN_NOTHING), until
    // one of `wake`'s pin events or its timeout powers the chip up; it then
    // restarts through reset into the program, and `woke_from_power_down`
    // says so. Up to four pin events (one per pin and event kind) can wake
    // it, each a level or an edge; claim their pins as inputs first, with
    // the pulls they need: the pads keep their state while the core is off.
    // A timeout uses the always-on timer's alarm, replacing one set through
    // the Rtc, and moves a crystal tick to the low-power oscillator; take()
    // moves it back. Both cores must wait for this: a core 1 that runs a
    // task must be stopped first. Returns only on failure: InvalidInput for
    // an empty `wake`, a pin from pin_count() up, more than four events, or
    // another `retain`; Busy if the always-on timer has no time for a
    // timeout or a power-up request cancels the power-down, Timeout if the
    // power manager does not take the request.
    pub fn power_down(&mut self, wake: &power.Wake, retain: u32) -> void!hal.Error {
        if (retain & ~(RETAIN_SRAM0 | RETAIN_SRAM1)) != 0 {
            return err(hal.Error.InvalidInput)
        }
        plan := rp_power.plan_power_down(wake, pin_count())?
        section := hal.Critical.enter()
        // SAFETY: interrupts are masked, so the Rtc, the only other user of
        // the power manager's timer, does not run; Power owns the rest.
        powman := unsafe {
            hal.RegisterBlock.at(POWMAN_BASE)
        }
        alarm := 0u64
        if plan.timeout_ms != 0 {
            if !rp_rtc.aon_running(&mut powman) {
                core.drop(section)
                return err(hal.Error.Busy)
            }
            // A millisecond more, so the alarm cannot fire before the power
            // manager watches for it.
            alarm = rp_rtc.aon_now(&mut powman) + plan.timeout_ms + 1
        }
        lposc_hz := lposc_calibration()
        // SAFETY: as above.
        entered := unsafe {
            rp_power.enter_power_down(&mut powman, &plan, retain, alarm, lposc_hz)
        }
        match entered {
            ok() => {}
            err(error) => {
                core.drop(section)
                return err(error)
            }
        }
        // The switched core powers off while this core waits here. A
        // power-up request that cancels the power-down raises
        // POWMAN_IRQ_POW, masked but enabled so it ends the wait.
        cortex_m.unpend(POWMAN_IRQ_POW)
        cortex_m.enable(POWMAN_IRQ_POW)
        for {
            rp_power.sleep()
            if rp_power.power_down_cancelled(&mut powman) {
                cortex_m.disable(POWMAN_IRQ_POW)
                rp_power.cancel_power_down(&mut powman)
                cortex_m.unpend(POWMAN_IRQ_POW)
                core.drop(section)
                return err(hal.Error.Busy)
            }
        }
    }

    pub fn mode(&self) -> power.Mode {
        return rp_power.mode()
    }

    pub fn set_mode(&mut self, mode: power.Mode) {
        rp_power.set_mode(mode)
    }

    pub fn sleep(&mut self) {
        rp_power.sleep()
    }

    pub fn enabled_clocks(&self) -> power.Clocks {
        // SAFETY: reading WAKE_EN has no side effects.
        clocks := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        return rp_power.read_clocks(&mut clocks, CLOCKS_WAKE_EN)
    }

    pub fn enable_clocks(&mut self, clocks: power.Clocks) {
        // SAFETY: Power owns WAKE_EN apart from reset_blocks, and both
        // change it only through its set and clear aliases.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.set_clocks(&mut block, CLOCKS_WAKE_EN, clocks & ALL_CLOCKS)
    }

    pub fn disable_clocks(&mut self, clocks: power.Clocks) -> void!hal.Error {
        if (clocks & ~ALL_CLOCKS) != 0 || (clocks & ESSENTIAL_CLOCKS) != 0 {
            return err(hal.Error.InvalidInput)
        }
        if (clocks & clocks_in_use()) != 0 {
            return err(hal.Error.Busy)
        }
        // SAFETY: as in enable_clocks; no claimed peripheral and nothing
        // the program needs to run uses `clocks`.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.clear_clocks(&mut block, CLOCKS_WAKE_EN, clocks)
        return ok()
    }

    pub fn disable_unused_clocks(&mut self) -> power.Clocks {
        unused := MANAGED_CLOCKS & ~clocks_in_use() & self.enabled_clocks()
        // SAFETY: as in disable_clocks; the peripherals are held in reset.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.clear_clocks(&mut block, CLOCKS_WAKE_EN, unused)
        return unused
    }

    pub fn sleep_clocks(&self) -> power.Clocks {
        // SAFETY: reading SLEEP_EN has no side effects.
        clocks := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        return rp_power.read_clocks(&mut clocks, CLOCKS_SLEEP_EN)
    }

    pub fn set_sleep_clocks(&mut self, clocks: power.Clocks) {
        // SAFETY: Power alone writes SLEEP_EN, which only applies while the
        // cores deep-sleep.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.write_clocks(&mut block, CLOCKS_SLEEP_EN, clocks & ALL_CLOCKS)
    }

    pub fn dormant(&mut self, wake: &power.Wake) -> u64!hal.Error {
        rp_power.check_wake(wake, pin_count())?
        layout := power_layout()
        lposc_hz := 0u32
        if wake.timeout_ms() != 0 {
            lposc_hz = lposc_calibration()
        }
        section := hal.Critical.enter()
        // SAFETY: interrupts are masked, so this core reads the count
        // atomically and no handler sees the clocks change.
        users := unsafe {
            PLL_USB_USERS
        }
        if users != 0 {
            core.drop(section)
            return err(hal.Error.Busy)
        }
        // SAFETY: Power owns the dormant state; nothing runs from PLL_USB,
        // and interrupts stay masked throughout.
        result := unsafe {
            go_dormant(self.crystal_hz, &layout, wake, lposc_hz)
        }
        core.drop(section)
        return result
    }
}

// The register offsets rp_power needs.
fn power_layout() -> rp_power.Layout {
    return rp_power.Layout {
        wake_en: CLOCKS_WAKE_EN,
        sleep_en: CLOCKS_SLEEP_EN,
        rosc_status: ROSC_STATUS,
        dormant_wake_inte: GPIO_DORMANT_WAKE_INTE,
        dormant_wake_ints: GPIO_DORMANT_WAKE_INTS,
        pin_count: pin_count(),
    }
}

// Go dormant until one of `wake`'s events or its timeout, which borrows
// the always-on timer's alarm, moving a crystal tick to the low-power
// oscillator at `lposc_hz` unless 0; return what woke the chip, as
// Power.dormant does.
// SAFETY: as for stop_clocks; with a timeout, the power manager's timer
// registers are borrowed meanwhile, which the Rtc does not use while
// interrupts are masked.
unsafe fn go_dormant(crystal_hz: u32, layout: &rp_power.Layout, wake: &power.Wake, lposc_hz: u32) -> u64!hal.Error {
    timeout := wake.timeout_ms()
    unsafe {
        if timeout == 0 {
            return stop_clocks(crystal_hz, layout, wake, false)
        }
        powman := hal.RegisterBlock.at(POWMAN_BASE)
        // A millisecond more, so the alarm cannot fire before the
        // oscillator stops, which would leave the chip dormant.
        saved := rp_rtc.aon_borrow_alarm(&mut powman, timeout + 1, lposc_hz)?
        result := stop_clocks(crystal_hz, layout, wake, true)
        fired := rp_rtc.aon_alarm_fired(&mut powman)
        returned := rp_rtc.aon_return_alarm(&mut powman, saved)
        match result {
            ok(pins) => {
                returned?
                if fired {
                    return ok(pins | power.BY_TIME)
                }
                return ok(pins)
            }
            err(error) => {
                match returned {
                    ok() => {}
                    err(_) => {}
                }
                return err(error)
            }
        }
    }
}

// Run from the crystal, stop until one of `wake`'s events or, if `timed`,
// the always-on timer's alarm, and restart PLL_SYS and clk_sys as they
// ran; return the pins that woke the chip. A timed dormant state runs
// clk_sys from the crystal through the auxiliary mux and clk_ref from the
// low-power oscillator, which keeps running, so the power manager that
// raises the alarm stays clocked; the timer and watchdog ticks, which count
// clk_ref, stop meanwhile.
// SAFETY: interrupts must be masked and PLL_USB stopped, and the caller
// must own the clock, reset, PLL_SYS, oscillator, tick, and dormant wake
// registers.
unsafe fn stop_clocks(crystal_hz: u32, layout: &rp_power.Layout, wake: &power.Wake, timed: bool) -> u64!hal.Error {
    unsafe {
        io := hal.RegisterBlock.at(IO_BANK0_BASE)
        xosc := hal.RegisterBlock.at(XOSC_BASE)
        rosc := hal.RegisterBlock.at(ROSC_BASE)
        // clk_sys from clk_ref, the crystal, through the glitchless mux,
        // then PLL_SYS can stop.
        sys_ctrl := reg(CLK_SYS_CTRL)
        sys_ctrl.clear_bits(CLK_SYS_SRC_AUX)
        sys_selected := reg(CLK_SYS_SELECTED)
        sys_selected.wait_set(1, ATTEMPTS)?
        hold := reg(RESET + SET_ALIAS)
        hold.write(RESET_PLL_SYS)
        ref_ctrl := reg(CLK_REF_CTRL)
        ref_selected := reg(CLK_REF_SELECTED)
        timer_tick := reg(TICK_TIMER0)
        watchdog_tick := reg(TICK_WATCHDOG)
        if timed {
            sys_ctrl.modify(CLK_SYS_AUXSRC, CLK_SYS_AUXSRC_XOSC)
            sys_ctrl.set_bits(CLK_SYS_SRC_AUX)
            sys_selected.wait_set(1 << 1, ATTEMPTS)?
            timer_tick.clear_bits(TICK_ENABLE)
            watchdog_tick.clear_bits(TICK_ENABLE)
            ref_ctrl.set(CLK_REF_SRC, CLK_REF_SRC_LPOSC)
            ref_selected.wait_set(1 << CLK_REF_SRC_LPOSC, ATTEMPTS)?
        }
        rp_power.arm_wake(&mut io, layout, wake)
        powman := hal.RegisterBlock.at(POWMAN_BASE)
        // An alarm that has fired already would not end the dormant state.
        stop := !timed || !rp_rtc.aon_alarm_fired(&mut powman)
        stopped := if stop {
            rp_power.stop_oscillators(&mut xosc, &mut rosc, layout)
        } else {
            ok()
        }
        woken := rp_power.woken_pins(&mut io, layout, wake)
        rp_power.disarm_wake(&mut io, layout, wake)
        stopped?
        if timed {
            ref_ctrl.set(CLK_REF_SRC, CLK_REF_SRC_XOSC)
            ref_selected.wait_set(1 << CLK_REF_SRC_XOSC, ATTEMPTS)?
            timer_tick.set_bits(TICK_ENABLE)
            watchdog_tick.set_bits(TICK_ENABLE)
            sys_ctrl.clear_bits(CLK_SYS_SRC_AUX)
            sys_selected.wait_set(1, ATTEMPTS)?
            sys_ctrl.clear_bits(CLK_SYS_AUXSRC)
        }
        restore_system_clock(crystal_hz)?
        return ok(woken)
    }
}

// The clocks of the blocks whose reset bits are `blocks`, apart from
// essential ones.
fn block_clocks(blocks: u32) -> power.Clocks {
    clocks := 0u64
    if (blocks & RESET_ADC) != 0 {
        clocks |= CLOCK_ADC
    }
    if (blocks & RESET_DMA) != 0 {
        clocks |= CLOCK_DMA
    }
    if (blocks & RESET_HSTX) != 0 {
        clocks |= CLOCK_HSTX
    }
    if (blocks & RESET_I2C0) != 0 {
        clocks |= CLOCK_I2C0
    }
    if (blocks & RESET_I2C1) != 0 {
        clocks |= CLOCK_I2C1
    }
    if (blocks & RESET_PIO0) != 0 {
        clocks |= CLOCK_PIO0
    }
    if (blocks & RESET_PIO1) != 0 {
        clocks |= CLOCK_PIO1
    }
    if (blocks & RESET_PIO2) != 0 {
        clocks |= CLOCK_PIO2
    }
    if (blocks & RESET_PLL_USB) != 0 {
        clocks |= CLOCK_PLL_USB
    }
    if (blocks & RESET_PWM) != 0 {
        clocks |= CLOCK_PWM
    }
    if (blocks & RESET_SHA256) != 0 {
        clocks |= CLOCK_SHA256
    }
    if (blocks & RESET_SPI0) != 0 {
        clocks |= CLOCK_SPI0
    }
    if (blocks & RESET_SPI1) != 0 {
        clocks |= CLOCK_SPI1
    }
    if (blocks & RESET_TIMER0) != 0 {
        clocks |= CLOCK_TIMER
    }
    if (blocks & RESET_TIMER1) != 0 {
        clocks |= CLOCK_TIMER1
    }
    if (blocks & RESET_TRNG) != 0 {
        clocks |= CLOCK_TRNG
    }
    if (blocks & RESET_UART0) != 0 {
        clocks |= CLOCK_UART0
    }
    if (blocks & RESET_UART1) != 0 {
        clocks |= CLOCK_UART1
    }
    if (blocks & RESET_USBCTRL) != 0 {
        clocks |= CLOCK_USB
    }
    return clocks
}

// The clocks of managed peripherals that are out of reset, so in use.
fn clocks_in_use() -> power.Clocks {
    // SAFETY: reading RESET has no side effects.
    held := unsafe {
        reg(RESET)
    }
    return block_clocks(~held.read()) & MANAGED_CLOCKS
}
