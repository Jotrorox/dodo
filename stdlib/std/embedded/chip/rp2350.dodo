package rp2350

import "core/cpu"
import "std/embedded/cortex_m"
import "std/embedded/hal"
import "std/embedded/power"
import "std/embedded/chip/rp_adc"
import "std/embedded/chip/rp_dma"
import "std/embedded/chip/rp_multicore"
import "std/embedded/chip/rp_pio"
import "std/embedded/chip/rp_power"
import "std/embedded/chip/rp_pwm"
import "std/embedded/chip/rp_usb"
import "std/embedded/peripheral/designware_i2c"
import "std/embedded/peripheral/pl011"
import "std/embedded/peripheral/pl022"
import "std/embedded/chip/rp_pins"

// Raspberry Pi RP2350 chip support for the Arm cores: clocks, resets, GPIO,
// I2C, SPI, UART, PWM, the ADC, PIO, the microsecond timer, a USB serial
// port, the second core, the FIFOs and spinlocks the cores share, low
// power, and the boot ROM. `take(config)` brings the chip from its boot state (ring
// oscillator, peripherals held in reset) to a known configuration and hands
// out the peripherals once. Pins implement the std/embedded/hal output and
// input pin protocols, I2C and SPI buses claimed from `Pins` implement the
// bus protocols, serial ports the std/io Reader and Writer protocols, PWM
// outputs and ADC inputs the PWM output and analog input protocols, and the
// timer implements the delay protocol, so portable drivers use them
// unchanged.
//
// Applications normally use a board package instead, which supplies the
// board's Config and wiring: `import "std/embedded/board"` with
// `board = "pico2"`, or `import "std/embedded/chip"` for a custom RP2350
// board with `chip = "rp2350"`.
//
// Clocks after take(): clk_ref = the crystal, clk_sys = 150 MHz from PLL_SYS,
// clk_peri = clk_sys, and 1 MHz ticks for TIMER0 and the watchdog. clk_adc
// and clk_usb run at 48 MHz from PLL_USB while an ADC input or the USB
// serial port is claimed. The flash
// keeps the boot ROM's execute-in-place setup. Section numbers below refer to
// the RP2350 datasheet.
//
// GPIO 0 to 29 are supported, all the RP2350A (QFN-60) has; the RP2350B's
// GPIO 30 to 47 are not yet.

// clk_sys, the processor and peripheral clock, after take().
pub const SYS_HZ: u32 = 150_000_000
// User GPIOs 0 to 29.
pub const PIN_COUNT: u32 = 30
// PIO blocks 0 to 2.
pub const PIO_BLOCKS: u32 = 3

// Each register also has atomic XOR, set, and clear aliases (2.1.3).
const SET_ALIAS: usize = 0x2000
const CLEAR_ALIAS: usize = 0x3000

// Resets (7.5). Writing 1 holds a block in reset.
const RESETS_BASE: usize = 0x4002_0000
const RESET: usize = RESETS_BASE + 0x0
const RESET_DONE: usize = RESETS_BASE + 0x8
const RESET_ADC: u32 = 1 << 0
const RESET_DMA: u32 = 1 << 2
const RESET_HSTX: u32 = 1 << 3
const RESET_I2C0: u32 = 1 << 4
const RESET_I2C1: u32 = 1 << 5
const RESET_IO_BANK0: u32 = 1 << 6
const RESET_PADS_BANK0: u32 = 1 << 9
const RESET_PIO0: u32 = 1 << 11
const RESET_PIO1: u32 = 1 << 12
const RESET_PIO2: u32 = 1 << 13
const RESET_PLL_SYS: u32 = 1 << 14
const RESET_PLL_USB: u32 = 1 << 15
const RESET_PWM: u32 = 1 << 16
const RESET_SHA256: u32 = 1 << 17
const RESET_SPI0: u32 = 1 << 18
const RESET_SPI1: u32 = 1 << 19
const RESET_UART0: u32 = 1 << 26
const RESET_UART1: u32 = 1 << 27
const RESET_USBCTRL: u32 = 1 << 28
const RESET_TIMER0: u32 = 1 << 23
const RESET_TIMER1: u32 = 1 << 24
const RESET_TRNG: u32 = 1 << 25

// Ring oscillator (8.3): the boot clock, unused after take() but running.
const ROSC_BASE: usize = 0x400E_8000
const ROSC_STATUS: usize = 0x1C

// Crystal oscillator (8.2).
const XOSC_BASE: usize = 0x4004_8000
const XOSC_CTRL: usize = XOSC_BASE + 0x00
const XOSC_STATUS: usize = XOSC_BASE + 0x04
const XOSC_STARTUP: usize = XOSC_BASE + 0x0C
const XOSC_RANGE_1_15MHZ: u32 = 0xAA0
const XOSC_ENABLE: u32 = 0xFAB << 12
const XOSC_STABLE: u32 = 1 << 31

// PLL_SYS (8.6): crystal / REFDIV 1 * FBDIV = 1500 MHz VCO,
// / POSTDIV1 5 / POSTDIV2 2 = 150 MHz. PLL_USB: a 1200 MHz VCO,
// / POSTDIV1 5 / POSTDIV2 5 = 48 MHz, for the ADC. Register offsets from
// each PLL's base follow.
const VCO_HZ: u32 = 1_500_000_000
const USB_VCO_HZ: u32 = 1_200_000_000
const PLL_SYS_BASE: usize = 0x4005_0000
const PLL_USB_BASE: usize = 0x4005_8000
const PLL_CS: usize = 0x0
const PLL_PWR: usize = 0x4
const PLL_FBDIV_INT: usize = 0x8
const PLL_PRIM: usize = 0xC
const PLL_LOCK: u32 = 1 << 31
const PLL_POWER_DOWN: u32 = 1 << 0
const PLL_POSTDIV_POWER_DOWN: u32 = 1 << 3
const PLL_VCO_POWER_DOWN: u32 = 1 << 5
const PLL_POSTDIV1: u32 = 0b111 << 16
const PLL_POSTDIV2: u32 = 0b111 << 12

// Clock generators (8.1).
const CLOCKS_BASE: usize = 0x4001_0000
const CLK_REF_CTRL: usize = CLOCKS_BASE + 0x30
const CLK_REF_DIV: usize = CLOCKS_BASE + 0x34
const CLK_REF_SELECTED: usize = CLOCKS_BASE + 0x38
const CLK_SYS_CTRL: usize = CLOCKS_BASE + 0x3C
const CLK_SYS_DIV: usize = CLOCKS_BASE + 0x40
const CLK_SYS_SELECTED: usize = CLOCKS_BASE + 0x44
const CLK_PERI_CTRL: usize = CLOCKS_BASE + 0x48
const CLK_USB_CTRL: usize = CLOCKS_BASE + 0x60
const CLK_USB_DIV: usize = CLOCKS_BASE + 0x64
const CLK_ADC_CTRL: usize = CLOCKS_BASE + 0x6C
const CLK_ADC_DIV: usize = CLOCKS_BASE + 0x70
const CLK_SYS_RESUS_CTRL: usize = CLOCKS_BASE + 0x84
const CLK_REF_SRC: u32 = 0b11
const CLK_REF_SRC_XOSC: u32 = 2
const CLK_SYS_SRC_AUX: u32 = 1
const CLK_SYS_AUXSRC: u32 = 0b111 << 5
const CLK_ENABLE: u32 = 1 << 11
// Clock gating (8.1.3.5): WAKE_EN0/1 and SLEEP_EN0/1.
const CLOCKS_WAKE_EN: usize = 0xAC
const CLOCKS_SLEEP_EN: usize = 0xB4

// The integer part of both dividers is bits 16 and up; 0x1_0000 divides by
// one.
const DIVIDE_BY_ONE: u32 = 0x1_0000

// Tick generators (8.5) divide clk_ref down to the 1 MHz ticks of the timers
// and the watchdog. Each has CTRL, CYCLES, and COUNT registers.
const TICKS_BASE: usize = 0x4010_8000
const TICK_TIMER0: usize = TICKS_BASE + 0x18
const TICK_WATCHDOG: usize = TICKS_BASE + 0x30
const TICK_ENABLE: u32 = 1 << 0

// Microsecond timer TIMER0 (12.8). The raw registers read without latching.
const TIMER0_BASE: usize = 0x400B_0000
const TIMER_RAW_HIGH: usize = TIMER0_BASE + 0x24
const TIMER_RAW_LOW: usize = TIMER0_BASE + 0x28
// Alarms (12.8.4): ALARMn arms when written and fires when the counter's
// low 32 bits reach it, setting its INTR bit (write one to clear) and, while
// its INTE bit is set, raising its interrupt. ARMED bits disarm when written.
const TIMER_ALARM0: usize = TIMER0_BASE + 0x10
const TIMER_ARMED: usize = TIMER0_BASE + 0x20
const TIMER_INTR: usize = TIMER0_BASE + 0x3C
const TIMER_INTE: usize = TIMER0_BASE + 0x40
// The longest an alarm sleeps at once: below 2^31 us, so its 32-bit
// target time is still ahead when the write lands.
const MAX_ALARM_SLEEP_US: u64 = 0x7FFF_FFFF
// Alarms 0 to 3, raising TIMER0_IRQ_0 + n.
pub const ALARM_COUNT: u32 = 4

// Interrupt numbers (3.2), for std/embedded/cortex_m's enable, pend, and
// set_priority. Each is also the vector name of its `@interrupt` handler.
pub const TIMER0_IRQ_0: u32 = 0
pub const TIMER0_IRQ_1: u32 = 1
pub const TIMER0_IRQ_2: u32 = 2
pub const TIMER0_IRQ_3: u32 = 3
pub const TIMER1_IRQ_0: u32 = 4
pub const TIMER1_IRQ_1: u32 = 5
pub const TIMER1_IRQ_2: u32 = 6
pub const TIMER1_IRQ_3: u32 = 7
pub const PWM_IRQ_WRAP_0: u32 = 8
pub const PWM_IRQ_WRAP_1: u32 = 9
pub const DMA_IRQ_0: u32 = 10
pub const DMA_IRQ_1: u32 = 11
pub const DMA_IRQ_2: u32 = 12
pub const DMA_IRQ_3: u32 = 13
pub const USBCTRL_IRQ: u32 = 14
pub const PIO0_IRQ_0: u32 = 15
pub const PIO0_IRQ_1: u32 = 16
pub const PIO1_IRQ_0: u32 = 17
pub const PIO1_IRQ_1: u32 = 18
pub const PIO2_IRQ_0: u32 = 19
pub const PIO2_IRQ_1: u32 = 20
pub const IO_IRQ_BANK0: u32 = 21
pub const IO_IRQ_BANK0_NS: u32 = 22
pub const IO_IRQ_QSPI: u32 = 23
pub const IO_IRQ_QSPI_NS: u32 = 24
pub const SIO_IRQ_FIFO: u32 = 25
pub const SIO_IRQ_BELL: u32 = 26
pub const SIO_IRQ_FIFO_NS: u32 = 27
pub const SIO_IRQ_BELL_NS: u32 = 28
pub const SIO_IRQ_MTIMECMP: u32 = 29
pub const CLOCKS_IRQ: u32 = 30
pub const SPI0_IRQ: u32 = 31
pub const SPI1_IRQ: u32 = 32
pub const UART0_IRQ: u32 = 33
pub const UART1_IRQ: u32 = 34
pub const ADC_IRQ_FIFO: u32 = 35
pub const I2C0_IRQ: u32 = 36
pub const I2C1_IRQ: u32 = 37
pub const OTP_IRQ: u32 = 38
pub const TRNG_IRQ: u32 = 39
pub const PROC0_IRQ_CTI: u32 = 40
pub const PROC1_IRQ_CTI: u32 = 41
pub const PLL_SYS_IRQ: u32 = 42
pub const PLL_USB_IRQ: u32 = 43
pub const POWMAN_IRQ_POW: u32 = 44
pub const POWMAN_IRQ_TIMER: u32 = 45

// Clock gates for `Power` (8.1.3.5), as std/embedded/power.Clocks: bit n
// of WAKE_EN0 and SLEEP_EN0 is bit n, bit n of WAKE_EN1 and SLEEP_EN1 bit
// 32 + n. Each peripheral's constant holds every clock it uses, its
// clk_sys register clock and, where it has one, its own clock.
pub const CLOCK_ADC: power.Clocks = (1 << 2) | (1 << 3)
pub const CLOCK_BUSCTRL: power.Clocks = 1 << 5
pub const CLOCK_DMA: power.Clocks = 1 << 7
pub const CLOCK_HSTX: power.Clocks = (1 << 9) | (1 << 10)
pub const CLOCK_I2C0: power.Clocks = 1 << 11
pub const CLOCK_I2C1: power.Clocks = 1 << 12
// GPIO control and pads: their interrupts need these to wake a deep sleep.
pub const CLOCK_GPIO: power.Clocks = (1 << 13) | (1 << 17)
pub const CLOCK_JTAG: power.Clocks = 1 << 14
pub const CLOCK_PIO0: power.Clocks = 1 << 18
pub const CLOCK_PIO1: power.Clocks = 1 << 19
pub const CLOCK_PIO2: power.Clocks = 1 << 20
// PLL_USB's registers; PLL_USB runs while the ADC or USB serial port does.
pub const CLOCK_PLL_USB: power.Clocks = 1 << 22
pub const CLOCK_PWM: power.Clocks = 1 << 25
pub const CLOCK_SHA256: power.Clocks = 1 << 30
pub const CLOCK_SPI0: power.Clocks = (1 << 32) | (1 << 33)
pub const CLOCK_SPI1: power.Clocks = (1 << 34) | (1 << 35)
// The SRAM banks and the bus fabric, for DMA during a deep sleep.
pub const CLOCK_MEMORY: power.Clocks = (1 << 6) | (0x3FF << 36)
pub const CLOCK_SYSCFG: power.Clocks = 1 << 46
pub const CLOCK_SYSINFO: power.Clocks = 1 << 47
pub const CLOCK_TBMAN: power.Clocks = 1 << 48
// TIMER0 and the tick generators that count its microseconds.
pub const CLOCK_TIMER: power.Clocks = (1 << 49) | (1 << 50) | (1 << 51)
pub const CLOCK_TIMER1: power.Clocks = 1 << 52
pub const CLOCK_TRNG: power.Clocks = 1 << 53
pub const CLOCK_UART0: power.Clocks = (1 << 54) | (1 << 55)
pub const CLOCK_UART1: power.Clocks = (1 << 56) | (1 << 57)
pub const CLOCK_USB: power.Clocks = (1 << 58) | (1 << 59)
pub const CLOCK_WATCHDOG: power.Clocks = 1 << 60
// What the timer and its alarms need: keep them in the sleep set to wake
// from a deep sleep on an alarm, as an executor on an alarm does.
pub const ALARM_CLOCKS: power.Clocks = CLOCK_TIMER
// Clocks the program cannot run without, which Power.disable_clocks
// refuses: the clock, reset, power-on, and power manager controls, access
// control, the glitch detector, the bus fabric, the boot ROM and its RAM,
// OTP, SRAM, flash (XIP), the cores' SIO, GPIO, and the oscillators and
// PLL_SYS, which `dormant` restarts.
pub const ESSENTIAL_CLOCKS: power.Clocks = (1 << 0) | (1 << 1) | (1 << 4) | (1 << 6) | (1 << 8) | CLOCK_GPIO | (1 << 15) | (1 << 16) | (1 << 21) | (1 << 23) | (1 << 24) | (1 << 26) | (1 << 27) | (1 << 28) | (1 << 29) | (1 << 31) | (0x3FF << 36) | (1 << 61) | (1 << 62)
// Every gate.
pub const ALL_CLOCKS: power.Clocks = 0x7FFF_FFFF_FFFF_FFFF
// The peripherals the chip claims and releases, or never uses, whose
// clocks Power.disable_unused_clocks stops while they are held in reset.
const MANAGED_CLOCKS: power.Clocks = CLOCK_ADC | CLOCK_HSTX | CLOCK_I2C0 | CLOCK_I2C1 | CLOCK_PIO0 | CLOCK_PIO1 | CLOCK_PIO2 | CLOCK_PLL_USB | CLOCK_PWM | CLOCK_SHA256 | CLOCK_SPI0 | CLOCK_SPI1 | CLOCK_TIMER1 | CLOCK_TRNG | CLOCK_UART0 | CLOCK_UART1 | CLOCK_USB

// User bank GPIO control (9.11.1) and pads (9.11.3).
const IO_BANK0_BASE: usize = 0x4002_8000
const PADS_BANK0_BASE: usize = 0x4003_8000
const FUNCSEL: u32 = 0b11111
// GPIO interrupts (9.11.1): four bits per pin, eight pins per register.
// INTR latches edges (write one to clear) and shows levels; PROC0_INTE
// selects what raises IO_IRQ_BANK0 on core 0, and PROC0_INTS shows it.
const GPIO_INTR: usize = IO_BANK0_BASE + 0x230
const GPIO_PROC0_INTE: usize = IO_BANK0_BASE + 0x248
const GPIO_PROC0_INTS: usize = IO_BANK0_BASE + 0x278
// GPIO events that end the dormant state (6.5.3), laid out as INTR:
// offsets in IO_BANK0.
const GPIO_DORMANT_WAKE_INTE: usize = 0x2D8
const GPIO_DORMANT_WAKE_INTS: usize = 0x308

// Pin events for `Pin.listen`, `ignore`, `events`, and `clear_events`:
// the pin's level is low or high, or it fell or rose. Levels last as long
// as the level does; edges stay latched until cleared.
pub const LEVEL_LOW: u32 = 1 << 0
pub const LEVEL_HIGH: u32 = 1 << 1
pub const FALLING_EDGE: u32 = 1 << 2
pub const RISING_EDGE: u32 = 1 << 3
const EDGES: u32 = FALLING_EDGE | RISING_EDGE
const ALL_EVENTS: u32 = 0xF
// Pads come out of reset isolated, latching their last state, until
// software clears this bit.
const PAD_ISOLATE: u32 = 1 << 8

// I2C (12.2), SPI (12.3), and UART (12.1) controllers, clocked by clk_sys
// and clk_peri.
const UART0_BASE: usize = 0x4007_0000
const UART1_BASE: usize = 0x4007_8000
const SPI0_BASE: usize = 0x4008_0000
const SPI1_BASE: usize = 0x4008_8000
const I2C0_BASE: usize = 0x4009_0000
const I2C1_BASE: usize = 0x4009_8000

// PWM (12.5), clocked by clk_sys, and the ADC (12.4), by clk_adc.
const PWM_BASE: usize = 0x400A_8000
const ADC_BASE: usize = 0x400A_0000

// The PIO blocks (11), clocked by clk_sys.
const PIO0_BASE: usize = 0x5020_0000
const PIO1_BASE: usize = 0x5030_0000
const PIO2_BASE: usize = 0x5040_0000

// The USB controller (12.7): its registers and its 4 KiB of dual-port
// RAM, clocked by clk_usb.
const USBCTRL_DPRAM_BASE: usize = 0x5010_0000
const USBCTRL_REGS_BASE: usize = 0x5011_0000

// Single-cycle I/O (3.1). The GPIO_HI registers for pins 32 and up sit
// between these.
const SIO_BASE: usize = 0xD000_0000
const GPIO_IN: usize = SIO_BASE + 0x004
const GPIO_OUT_SET: usize = SIO_BASE + 0x018
const GPIO_OUT_CLR: usize = SIO_BASE + 0x020
const GPIO_OUT_XOR: usize = SIO_BASE + 0x028
const GPIO_OE_SET: usize = SIO_BASE + 0x038
const GPIO_OE_CLR: usize = SIO_BASE + 0x040

// Boot ROM reboot() (5.4.8.24): its lookup code and arguments.
const ROM_REBOOT: u32 = 0x4252
const REBOOT_TYPE_BOOTSEL: u32 = 0x2
const REBOOT_NO_RETURN_ON_SUCCESS: u32 = 0x100
const BOOTSEL_GPIO_PIN_SPECIFIED: u32 = 0x20
// The ROM version is the top byte of the word at 0x10, after the 'M' 'u'
// magic and the chip marker.
const ROM_VERSION_WORD: usize = 0x10

// Polls before a clock or reset is reported as stuck. The slowest wait,
// crystal start-up, takes about 1 ms at the ring oscillator's boot clock.
const ATTEMPTS: u32 = 1_000_000

// Power-on state machine (7.4): FRCE_OFF holds core 1 in reset while its
// bit is set.
const PSM_BASE: usize = 0x4001_8000
const PSM_PROC1: u32 = 1 << 24
// Erratum RP2350-E2: writes to SIO offsets 0x180 to 0x1FC also unlock the
// spinlock 0x80 below. Locks 0 to 4, 8, 9, and 12 to 17 sit below writable
// registers (doorbells, PERI_NONSEC, RISC-V soft interrupts, MTIME, TMDS),
// so they are not handed out.
const RESERVED_SPINLOCKS: u32 = 0x0003_F31F

static mut TAKEN: bool = false
// What runs PLL_USB: the ADC and the USB controller, one each. It stops when
// neither does.
static mut PLL_USB_USERS: u32 = 0
// The pin the USB bootloader lights while its drive is accessed, after the
// USB serial port restarts the chip into it; PIN_COUNT for none.
static mut USB_ACTIVITY_LED: u32 = PIN_COUNT

// Provided by the compiler's RP2350 firmware runtime: call the boot ROM
// function with lookup code `code` ('R' | 'B' << 8 for reboot), or return -1
// if there is none.
unsafe extern "C" fn dodo_rp2350_rom_call(code: u32, a0: u32, a1: u32, a2: u32, a3: u32) -> i32

// Restart into the boot ROM's USB bootloader, as if BOOTSEL were held at
// power-up: the board reappears as the RP2350 drive and accepts new
// firmware, for example from `dodo run`. Pin `activity_led`, if below
// PIN_COUNT, lights while the drive is accessed, except on chip revision
// A2, whose boot ROM mishandles it on the Arm cores (erratum in the Pico
// SDK's rom_reset_usb_boot). Does not return.
pub fn reboot_to_bootloader(activity_led: u32) {
    flags := 0u32
    pin := 0u32
    rom_version := 0u32
    // SAFETY: the ROM is always readable, and the word is never written.
    unsafe {
        version: hal.Reg<u32> = hal.Reg.at(ROM_VERSION_WORD)
        rom_version = version.read() >> 24
    }
    if activity_led < PIN_COUNT && rom_version > 2 {
        flags = BOOTSEL_GPIO_PIN_SPECIFIED
        pin = activity_led
    }
    // SAFETY: on success the ROM resets the chip after 10 ms and never
    // returns, so no peripheral owned by this program is used afterwards.
    unsafe {
        dodo_rp2350_rom_call(ROM_REBOOT, REBOOT_TYPE_BOOTSEL | REBOOT_NO_RETURN_ON_SUCCESS, 10, flags, pin)
    }
    for {}
}

// Write a failed check's message to every serial port claimed from
// `pins.uart` and not yet released, as the default panic hook does before it
// halts: `dodo: arithmetic overflow check failed at main.dodo:12:5`. Call it
// from a panic hook of your own that, for example, restarts into the
// bootloader:
//
//     extern "C" fn dodo_board_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
//         unsafe {
//             chip.report_panic(check, file, line, column)
//         }
//         chip.reboot_to_bootloader(25)
//     }
//
// SAFETY: `check` and `file` must be the hook's NUL-terminated strings, and
// the caller must halt or reset afterwards, as this takes over the ports.
pub unsafe fn report_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
    unsafe {
        rp_pins.report_panic(check, file, line, column)
    }
}

// What the circuit board decides. Board packages pass theirs to `take`.
pub struct Config {
    // The crystal on XIN/XOUT, in hertz: 1 to 15 MHz, a whole number of
    // megahertz (for the 1 MHz ticks) that divides 1.5 GHz (for the PLL).
    // 12 MHz, as on the Raspberry Pi Pico 2, is the usual choice.
    pub crystal_hz: u32
}

// The chip's peripherals, handed out once by `take`.
pub struct Peripherals {
    pub pins: Pins
    pub timer: Timer
    pub usb: Usb
    // The DMA controller's channels; rp_dma documents them.
    pub dma: rp_dma.Dma
    // Core 1, which runs a task once started, and the FIFOs and spinlocks
    // the two cores share; see std/embedded/chip/rp_multicore.
    pub core1: rp_multicore.Core1
    pub fifos: rp_multicore.Fifos
    pub spinlocks: rp_multicore.Spinlocks
    // Sleep modes, clock gating, and the dormant state; see Power.
    pub power: Power
}

// Configure clocks, take GPIO, the timer, and DMA out of reset, and return the
// peripherals. A second call returns Error.Busy, so no two owners exist; an
// unusable crystal frequency returns Error.InvalidInput, and a crystal or PLL
// that does not start returns Error.Timeout.
pub fn take(config: Config) -> Peripherals!hal.Error {
    crystal := config.crystal_hz
    if crystal < 1_000_000 || crystal > 15_000_000 || crystal % 1_000_000 != 0 || VCO_HZ % crystal != 0 {
        return err(hal.Error.InvalidInput)
    }
    section := hal.Critical.enter()
    // SAFETY: interrupts are masked, so the flag is read and set atomically
    // on this core. Core 1 waits in the boot ROM until the program starts
    // it through the peripherals returned here.
    taken := unsafe {
        TAKEN
    }
    unsafe {
        TAKEN = true
    }
    core.drop(section)
    if taken {
        return err(hal.Error.Busy)
    }
    // SAFETY: TAKEN guarantees this runs once, so this code is the only
    // user of the clock, reset, PLL, and tick registers.
    unsafe {
        start_clocks(crystal)?
        reset_blocks(RESET_IO_BANK0 | RESET_PADS_BANK0 | RESET_TIMER0 | RESET_DMA)?
    }
    // SAFETY: the timer was just taken out of reset; Timer only reads its
    // free-running counter registers.
    timer := unsafe {
        Timer { high: hal.Reg.at(TIMER_RAW_HIGH), low: hal.Reg.at(TIMER_RAW_LOW), alarms: 0 }
    }
    // SAFETY: TAKEN guarantees one bank, and Chip is what the bank needs:
    // the GPIOs' control and pad registers and the bus controllers are
    // otherwise unused.
    bank := unsafe {
        rp_pins.Bank.new(Chip { crystal_hz: crystal })
    }
    usb := Usb { crystal_hz: crystal, open: false }
    // SAFETY: TAKEN guarantees one Dma, and the controller was just taken
    // out of reset.
    dma := unsafe {
        rp_dma.Dma.new(rp_dma.RP2350)
    }
    // SAFETY: TAKEN guarantees one set of the cores' parts, and core 1 is
    // not running yet, so no spinlock is held.
    cores := unsafe {
        rp_multicore.reset_spinlocks(RESERVED_SPINLOCKS)
        rp_multicore.take(rp_multicore.Chip {
            psm_base: PSM_BASE,
            core1_bit: PSM_PROC1,
            core0_fifo_irq: SIO_IRQ_FIFO,
            core1_fifo_irq: SIO_IRQ_FIFO,
            reserved_locks: RESERVED_SPINLOCKS,
        })
    }
    let rp_multicore.Cores { core1, fifos, spinlocks } = cores
    power := Power { crystal_hz: crystal }
    return ok(Peripherals { pins: Pins { bank }, timer, usb, dma, core1, fifos, spinlocks, power })
}

// SAFETY: the caller owns `address`, a 32-bit RP2350 register.
unsafe fn reg(address: usize) -> hal.Reg<u32> {
    unsafe {
        return hal.Reg.at(address)
    }
}

// Pulse the reset of `blocks` and wait until they are running again. Their
// clocks start first, in case Power stopped them. The set and clear aliases
// leave every other block alone.
// SAFETY: the caller owns `blocks`.
unsafe fn reset_blocks(blocks: u32) -> void!hal.Error {
    unsafe {
        clocks := hal.RegisterBlock.at(CLOCKS_BASE)
        rp_power.set_clocks(&mut clocks, CLOCKS_WAKE_EN, block_clocks(blocks))
        hold := reg(RESET + SET_ALIAS)
        hold.write(blocks)
        release := reg(RESET + CLEAR_ALIAS)
        release.write(blocks)
        done := reg(RESET_DONE)
        return done.wait_set(blocks, ATTEMPTS)
    }
}

// Start a tick generator: `cycles` of clk_ref per tick.
// SAFETY: the caller owns the tick generator at `base`.
unsafe fn start_tick(base: usize, cycles: u32) {
    unsafe {
        control := reg(base)
        control.write(0)
        count := reg(base + 4)
        count.write(cycles)
        control.write(TICK_ENABLE)
    }
}

// Start the PLL at `base`, held in reset by `reset`: a VCO at `vco_hz`
// from the crystal, divided by `post1` and `post2`.
// SAFETY: the caller owns the PLL, and nothing may use its output yet.
unsafe fn start_pll(base: usize, reset: u32, crystal_hz: u32, vco_hz: u32, post1: u32, post2: u32) -> void!hal.Error {
    unsafe {
        reset_blocks(reset)?
        cs := reg(base + PLL_CS)
        cs.write(1)
        feedback := reg(base + PLL_FBDIV_INT)
        feedback.write(vco_hz / crystal_hz)
        power_on := reg(base + PLL_PWR + CLEAR_ALIAS)
        power_on.write(PLL_POWER_DOWN | PLL_VCO_POWER_DOWN)
        cs.wait_set(PLL_LOCK, ATTEMPTS)?
        prim := reg(base + PLL_PRIM)
        prim.write(hal.encode(PLL_POSTDIV1, post1) | hal.encode(PLL_POSTDIV2, post2))
        power_on.write(PLL_POSTDIV_POWER_DOWN)
        return ok()
    }
}

// Start PLL_USB at 48 MHz for one more user, unless it already runs.
// SAFETY: the caller owns its claim on PLL_USB until release_pll_usb, and
// runs in the program, not in an interrupt handler.
unsafe fn acquire_pll_usb(crystal_hz: u32) -> void!hal.Error {
    unsafe {
        if PLL_USB_USERS == 0 {
            start_pll(PLL_USB_BASE, RESET_PLL_USB, crystal_hz, USB_VCO_HZ, 5, 5)?
        }
        PLL_USB_USERS += 1
    }
    return ok()
}

// Give up a claim on PLL_USB; the last one holds it in reset.
// SAFETY: the caller must hold a claim from acquire_pll_usb and no longer
// use the clocks it drives.
unsafe fn release_pll_usb() {
    unsafe {
        PLL_USB_USERS -= 1
        if PLL_USB_USERS == 0 {
            hold := reg(RESET + SET_ALIAS)
            hold.write(RESET_PLL_USB)
        }
    }
}

// SAFETY: the caller owns the clock, XOSC, PLL_SYS, and tick registers, and
// nothing may depend on the current clock rates.
unsafe fn start_clocks(crystal_hz: u32) -> void!hal.Error {
    unsafe {
        resus := reg(CLK_SYS_RESUS_CTRL)
        resus.write(0)

        // Crystal: ~1 ms start-up delay in units of 256 cycles.
        xosc_ctrl := reg(XOSC_CTRL)
        xosc_ctrl.write(XOSC_RANGE_1_15MHZ)
        startup := reg(XOSC_STARTUP)
        startup.write((crystal_hz / 1000 + 128) / 256)
        xosc_ctrl.write(XOSC_RANGE_1_15MHZ | XOSC_ENABLE)
        xosc_status := reg(XOSC_STATUS)
        xosc_status.wait_set(XOSC_STABLE, ATTEMPTS)?

        // Run clk_sys from clk_ref while the PLL is reconfigured.
        sys_ctrl := reg(CLK_SYS_CTRL)
        sys_ctrl.clear_bits(CLK_SYS_SRC_AUX)
        sys_selected := reg(CLK_SYS_SELECTED)
        sys_selected.wait_set(1, ATTEMPTS)?

        start_pll(PLL_SYS_BASE, RESET_PLL_SYS, crystal_hz, VCO_HZ, 5, 2)?

        // clk_ref from the crystal.
        ref_ctrl := reg(CLK_REF_CTRL)
        ref_ctrl.set(CLK_REF_SRC, CLK_REF_SRC_XOSC)
        ref_selected := reg(CLK_REF_SELECTED)
        ref_selected.wait_set(1 << CLK_REF_SRC_XOSC, ATTEMPTS)?
        ref_div := reg(CLK_REF_DIV)
        ref_div.write(DIVIDE_BY_ONE)

        // clk_sys from PLL_SYS (aux source 0) through the glitchless mux.
        sys_ctrl.clear_bits(CLK_SYS_AUXSRC)
        sys_div := reg(CLK_SYS_DIV)
        sys_div.write(DIVIDE_BY_ONE)
        sys_ctrl.set_bits(CLK_SYS_SRC_AUX)
        sys_selected.wait_set(1 << 1, ATTEMPTS)?

        // clk_peri from clk_sys (aux source 0), for UART and SPI.
        peri := reg(CLK_PERI_CTRL)
        peri.write(0)
        peri.write(CLK_ENABLE)

        // 1 MHz ticks for TIMER0 and the watchdog, derived from clk_ref.
        start_tick(TICK_TIMER0, crystal_hz / 1_000_000)
        start_tick(TICK_WATCHDOG, crystal_hz / 1_000_000)
        return ok()
    }
}

// The 30 user GPIOs, and the I2C, SPI, and UART controllers that use them.
// Each pin and each controller can be taken once, and given back.
pub struct Pins {
    bank: rp_pins.Bank<Chip>

    // Claim pin `number` as a push-pull output, initially low.
    pub fn output(&mut self, number: u32) -> Pin!hal.Error {
        pin := self.claim(number)?
        pin.set_low()
        pin.set_as_output()
        return ok(pin)
    }

    // Claim pin `number` as an input.
    pub fn input(&mut self, number: u32) -> Pin!hal.Error {
        pin := self.claim(number)?
        pin.set_as_input()
        return ok(pin)
    }

    // Give back a pin from `output` or `input`. It stops driving and is
    // disconnected until claimed again, for example as part of a bus.
    pub fn release(&mut self, pin: Pin) {
        pin.ignore(ALL_EVENTS)
        pin.clear_events(ALL_EVENTS)
        pin.set_as_input()
        self.bank.release_gpio(pin.mask)
    }

    // Claim pins `sda` and `scl` as an I2C bus with an SCL frequency of
    // `frequency_hz`, at most hal.I2C_FAST_PLUS_HZ. Even pins carry SDA and
    // odd pins SCL. GPIO 0 and 1, 4 and 5, and so on in steps of four belong
    // to I2C0; GPIO 2 and 3, 6 and 7, and so on to I2C1. InvalidInput if the
    // two pins cannot form a bus or the frequency is out of range, Busy if a
    // pin or the controller is taken. The pads' own pull-ups (about 50 kOhm)
    // keep an idle bus high but are too weak for fast mode: most sensor
    // boards add 4.7 kOhm pull-ups, and a bare bus needs them. The
    // designware_i2c driver documents the bus's errors.
    pub fn i2c(&mut self, sda: u32, scl: u32, frequency_hz: u32) -> designware_i2c.Bus!hal.Error {
        return self.bank.i2c(sda, scl, frequency_hz)
    }

    // Claim pins as an SPI bus in `mode`, clocked at the fastest rate up to
    // `frequency_hz` (at most SYS_HZ / 2, 75 MHz): `clock` (SCK), `tx`
    // (data out to the devices, MOSI), and `rx` (data in from them, MISO),
    // or none when they only listen. GPIO n carries RX when n % 4 is 0, the
    // clock when it is 2, and TX when it is 3. GPIO 0 to 7 and 16 to 23
    // belong to SPI0, GPIO 8 to 15 and 24 to 29 to SPI1. Give each device
    // an output pin as its chip select, through hal.SpiDevice. Errors as for
    // `i2c`.
    pub fn spi(&mut self, clock: u32, tx: u32, rx: Option<u32>, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        return self.bank.spi(clock, tx, rx, mode, frequency_hz)
    }

    // Claim pin `tx` as a serial port's transmit line (to the other end's
    // RX), and `rx` as its receive line, or none to only send. Frames are
    // 8N1 at the rate closest to `baud`, from 144 baud up to SYS_HZ / 16
    // (9.4 Mbaud); 115_200 is the usual choice for a terminal. GPIO n
    // carries TX when n % 4 is 0 or 2 and RX when it is 1 or 3 (the second
    // of each through the RP2350's UART_AUX function, on the pins that
    // otherwise carry CTS and RTS): UART0 has TX on 0, 2, 12, 14, 16, 18,
    // and 28 and RX on 1, 3, 13, 15, 17, 19, and 29, UART1 TX on 4, 6, 8,
    // 10, 20, 22, 24, and 26 and RX on 5, 7, 9, 11, 21, 23, 25, and 27.
    // The port implements the std/io Reader
    // and Writer protocols, so std/fmt prints to it; until it is released,
    // a panic writes its failure message to it before the chip halts.
    // InvalidInput if the pins cannot form a port or the baud rate is out
    // of range, Busy if a pin or the controller is taken. The pl011 driver
    // documents the port.
    pub fn uart(&mut self, tx: u32, rx: Option<u32>, baud: u32) -> pl011.Port!hal.Error {
        return self.bank.uart(tx, rx, baud)
    }

    // `uart` with hardware flow control, turned on: `cts` is an input, low
    // while the other end may receive, and `rts` an output, low while this
    // port may. GPIO n carries CTS when n % 4 is 2 and RTS when it is 3, in
    // the TX and RX pins' group of four: UART0 has CTS on 2, 14, 18 and RTS
    // on 3, 15, 19, UART1 CTS on 6, 10, 22, 26 and RTS on 7, 11, 23, 27.
    // Errors as for `uart`.
    pub fn uart_flow(&mut self, tx: u32, rx: u32, cts: u32, rts: u32, baud: u32) -> pl011.Port!hal.Error {
        return self.bank.uart_flow(tx, rx, cts, rts, baud)
    }

    // `spi` with the controller's own chip select on pin `select` as well,
    // for devices in the TI and Microwire frame formats (see
    // pl022.FrameFormat), which need its timing. GPIO n carries it when
    // n % 4 is 1, in the bus's block of eight: SPI0 on 1, 5, 17, 21, SPI1
    // on 9, 13, 25, 29. Errors as for `spi`.
    pub fn spi_with_select(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        return self.bank.spi_with_select(clock, tx, rx, select, mode, frequency_hz)
    }

    // Claim pins as an SPI target (slave) in `mode`, for another master to
    // clock, at up to SYS_HZ / 12 (12.5 MHz), and select: `rx` receives
    // what it sends, `tx` answers, and the pins are numbered as for `spi`
    // and `spi_with_select`. The pl022 driver documents the target.
    pub fn spi_target(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode) -> pl022.TargetBus!hal.Error {
        return self.bank.spi_target(clock, tx, rx, select, mode)
    }

    // Claim pins `sda` and `scl`, numbered as for `i2c`, as an I2C target
    // (slave) answering another master at `address`, a 10-bit address with
    // `ten_bit`. `frequency_hz` is the master's SCL frequency, which sets
    // the input filter. InvalidInput for an address the I2C specification
    // reserves (7-bit 0x00 to 0x07 and 0x78 to 0x7F), otherwise errors as
    // for `i2c`. The designware_i2c driver documents the target.
    pub fn i2c_target(&mut self, sda: u32, scl: u32, address: u16, ten_bit: bool, frequency_hz: u32) -> designware_i2c.TargetBus!hal.Error {
        return self.bank.i2c_target(sda, scl, address, ten_bit, frequency_hz)
    }

    // Claim pin `pin` as a PWM output at the frequency closest to
    // `frequency_hz`, from 9 Hz up to SYS_HZ / 2, low until a duty is set.
    // GPIO n is output A (n even) or B (n odd) of PWM slice (n / 2) % 8:
    // GPIO n and n + 16 carry the same output, and the two outputs of a
    // slice share its frequency. The output implements hal.PwmOutput, with
    // max_duty() steps up to 65535; rp_pwm documents it. InvalidInput above
    // GPIO 29 or for a frequency out of range, Busy if the pin or its output
    // is taken, or if the slice's other output runs at another frequency.
    pub fn pwm(&mut self, pin: u32, frequency_hz: u32) -> rp_pwm.Pwm!hal.Error {
        return self.bank.pwm(pin, frequency_hz)
    }

    // `pwm` with the slice's divider of clk_sys, in sixteenths from 16 (1)
    // to 4095 (255 15/16), and its TOP, up to 65534, given instead: the
    // output's frequency is SYS_HZ * 16 / divider / (top + 1), and its duty
    // runs from 0 to top + 1. Errors as for `pwm`.
    pub fn pwm_divided(&mut self, pin: u32, divider: u32, top: u32) -> rp_pwm.Pwm!hal.Error {
        return self.bank.pwm_divided(pin, divider, top)
    }

    // Claim pin `pin`, GPIO 26 to 29 (ADC inputs 0 to 3), as an analog
    // input, with its digital input and pulls turned off. It implements
    // hal.AnalogInput: 12-bit polled reads, 0 to 4095 for 0 V to the ADC's
    // reference, ADC_AVDD; rp_adc documents it. InvalidInput for another
    // pin, Busy if the pin is taken, Timeout if the ADC does not start.
    pub fn analog(&mut self, pin: u32) -> rp_adc.Analog!hal.Error {
        return self.bank.analog(pin)
    }

    // Claim the on-chip temperature sensor, ADC input 4, an analog input
    // like those of `analog`: rp_adc.millicelsius(value, 3300) converts a
    // reading. Busy if it is claimed already.
    pub fn temperature(&mut self) -> rp_adc.Analog!hal.Error {
        return self.bank.temperature()
    }

    // Claim PIO block `number`, 0 to 2, with its four state machines
    // stopped, for programs from rp_pio.assemble; rp_pio documents it. Its
    // state machines run at up to SYS_HZ instructions a second and drive
    // the pins given to it with `pio_pins`. InvalidInput for another
    // number, Busy if the block is claimed.
    pub fn pio(&mut self, number: u32) -> rp_pio.Pio!hal.Error {
        return self.bank.pio(number)
    }

    // Connect the `count` pins from GPIO `first` to PIO block `pio`, for
    // its state machines to drive through their pin mappings and read.
    // They also read pins claimed in other ways: claim a pin they only
    // read as an input, for example, to share it. InvalidInput above GPIO
    // 29 or for a count of 0, Busy if a pin is taken.
    pub fn pio_pins(&mut self, pio: &rp_pio.Pio, first: u32, count: u32) -> void!hal.Error {
        return self.bank.pio_pins(pio, first, count)
    }

    // Give back a PIO block, once its state machines have been given back
    // to it with `pio.release_state_machine`: its pins are disconnected
    // and the block is held in reset, which forgets its programs.
    pub fn release_pio(&mut self, pio: rp_pio.Pio) {
        self.bank.release_pio(pio)
    }

    // Give back a PWM output. Its pin stops driving and is disconnected.
    pub fn release_pwm(&mut self, output: rp_pwm.Pwm) {
        self.bank.release_pwm(output)
    }

    // Give back an analog input or the temperature sensor; the ADC and its
    // clock stop once no input is left.
    pub fn release_analog(&mut self, input: rp_adc.Analog) {
        self.bank.release_analog(input)
    }

    // Give back an I2C bus. Its controller is held in reset and its pins are
    // disconnected but still pulled up, so the bus stays idle. A device that
    // holds SDA low after an interrupted transfer, which makes the bus
    // Timeout, can then be freed by claiming SCL as an output and clocking
    // it by hand before claiming the bus again.
    pub fn release_i2c(&mut self, bus: designware_i2c.Bus) {
        self.bank.release_i2c(bus)
    }

    // Give back an SPI bus: its controller is held in reset and its pins
    // are disconnected.
    pub fn release_spi(&mut self, bus: pl022.Bus) {
        self.bank.release_spi(bus)
    }

    // Give back a serial port, once everything written to it is out: its
    // controller is held in reset and its pins are disconnected but still
    // pulled up, so the line stays idle.
    pub fn release_uart(&mut self, port: pl011.Port) {
        self.bank.release_uart(port)
    }

    // Give back an I2C target, as for `release_i2c`.
    pub fn release_i2c_target(&mut self, target: designware_i2c.TargetBus) {
        self.bank.release_i2c_target(target)
    }

    // Give back an SPI target, as for `release_spi`.
    pub fn release_spi_target(&mut self, target: pl022.TargetBus) {
        self.bank.release_spi_target(target)
    }

    fn claim(&mut self, number: u32) -> Pin!hal.Error {
        mask := self.bank.gpio(number)?
        group := 4 * (number / 8) as usize
        // SAFETY: the bank makes this pin's control and pad registers
        // exclusive to the returned Pin. The SIO output SET/CLR/XOR and
        // output-enable SET/CLR registers are write-only per-bit aliases and IN
        // is read-only, so pins never conflict there. Likewise the pin writes
        // only its own bits of the shared interrupt registers, through the
        // write-one-to-clear INTR and the INTE set and clear aliases, and
        // INTS is read-only.
        unsafe {
            return ok(Pin {
                set: reg(GPIO_OUT_SET),
                clear: reg(GPIO_OUT_CLR),
                toggle: reg(GPIO_OUT_XOR),
                input: reg(GPIO_IN),
                output_enable: reg(GPIO_OE_SET),
                output_disable: reg(GPIO_OE_CLR),
                mask,
                raw_events: reg(GPIO_INTR + group),
                listen_set: reg(GPIO_PROC0_INTE + group + SET_ALIAS),
                listen_clear: reg(GPIO_PROC0_INTE + group + CLEAR_ALIAS),
                status: reg(GPIO_PROC0_INTS + group),
                shift: 4 * (number % 8),
            })
        }
    }
}

// The USB controller, as a USB serial port for the host the board is
// plugged into. rp_usb documents the port.
pub struct Usb {
    crystal_hz: u32
    open: bool

    // Start the controller as a USB serial port (CDC-ACM) named "RP2350",
    // with rp_usb's default identity, and return it. The host enumerates it within about a second; what is
    // written before a terminal opens it is kept, up to rp_usb.TX_CAPACITY
    // bytes. The port is served from the USBCTRL_IRQ interrupt, so it keeps
    // working while the program busy-waits; a program's own USBCTRL_IRQ
    // handler replaces that. Until it is released, a panic is reported on
    // it, and a host that sets 1200 baud, as `dodo run` does, restarts the
    // board into its bootloader. Busy if a port is open, Timeout if PLL_USB
    // or the controller does not start.
    pub fn serial(&mut self) -> rp_usb.Serial!hal.Error {
        return self.serial_with(rp_usb.default_identity("RP2350"), PIN_COUNT)
    }

    // `serial`, with the `identity` the host sees, and the pin the USB
    // bootloader lights while its drive is accessed after the host
    // restarts the board into it, or PIN_COUNT for none. Board packages
    // pass the default identity with the board's name, and the board's
    // LED.
    pub fn serial_with(&mut self, identity: rp_usb.Identity, activity_led: u32) -> rp_usb.Serial!hal.Error {
        if self.open {
            return err(hal.Error.Busy)
        }
        // SAFETY: `open` makes this the only user of the controller, its
        // reset bit, and clk_usb, and acquire_pll_usb shares PLL_USB with
        // the ADC.
        unsafe {
            acquire_pll_usb(self.crystal_hz)?
            // clk_usb from PLL_USB (aux source 0), undivided: 48 MHz.
            control := reg(CLK_USB_CTRL)
            control.write(0)
            divider := reg(CLK_USB_DIV)
            divider.write(DIVIDE_BY_ONE)
            control.write(CLK_ENABLE)
            match reset_blocks(RESET_USBCTRL) {
                ok() => {}
                err(error) => {
                    control.write(0)
                    release_pll_usb()
                    return err(error)
                }
            }
            USB_ACTIVITY_LED = activity_led
            serial := rp_usb.open(USBCTRL_REGS_BASE, USBCTRL_DPRAM_BASE, identity, usb_bootloader)
            cortex_m.enable(USBCTRL_IRQ)
            self.open = true
            return ok(serial)
        }
    }

    // Give back the port: the board disconnects from the host, output not
    // yet sent is dropped, and the controller and its clock stop.
    pub fn release_serial(&mut self, serial: rp_usb.Serial) {
        cortex_m.disable(USBCTRL_IRQ)
        rp_usb.close(serial)
        cortex_m.unpend(USBCTRL_IRQ)
        // SAFETY: the port is closed, so nothing uses the controller or
        // clk_usb, and this releases the port's claim on PLL_USB.
        unsafe {
            hold := reg(RESET + SET_ALIAS)
            hold.write(RESET_USBCTRL)
            control := reg(CLK_USB_CTRL)
            control.write(0)
            release_pll_usb()
        }
        self.open = false
    }
}

// The USB serial port's restart into the bootloader, from its interrupt.
fn usb_bootloader() {
    // SAFETY: written only while the port is closed.
    led := unsafe {
        USB_ACTIVITY_LED
    }
    reboot_to_bootloader(led)
}

// What rp_pins.Bank needs from this chip. Only the Bank in Pins has one.
struct Chip {
    crystal_hz: u32

    pub fn route(&mut self, number: u32, function: u32, clear: u32, set: u32) {
        // SAFETY: the bank routes only pins it holds.
        unsafe {
            route(number, function, clear, set)
        }
    }

    pub fn reset(&mut self, controller: u32) -> void!hal.Error {
        // SAFETY: the bank resets only controllers it holds. The reset alias
        // registers change only their bits.
        unsafe {
            return reset_blocks(controller_reset(controller))
        }
    }

    pub fn hold(&mut self, controller: u32) {
        // SAFETY: as for `reset`.
        unsafe {
            hold := reg(RESET + SET_ALIAS)
            hold.write(controller_reset(controller))
        }
    }

    pub fn base(&self, controller: u32) -> usize {
        if controller == rp_pins.I2C0 {
            return I2C0_BASE
        } else if controller == rp_pins.I2C1 {
            return I2C1_BASE
        } else if controller == rp_pins.SPI0 {
            return SPI0_BASE
        } else if controller == rp_pins.SPI1 {
            return SPI1_BASE
        } else if controller == rp_pins.UART0 {
            return UART0_BASE
        } else if controller == rp_pins.UART1 {
            return UART1_BASE
        } else if controller == rp_pins.PWM {
            return PWM_BASE
        } else if controller == rp_pins.PIO0 {
            return PIO0_BASE
        } else if controller == rp_pins.PIO1 {
            return PIO1_BASE
        } else if controller == rp_pins.PIO2 {
            return PIO2_BASE
        }
        return ADC_BASE
    }

    pub fn clock_hz(&self) -> u32 {
        return SYS_HZ
    }

    pub fn start_adc(&mut self) -> void!hal.Error {
        // SAFETY: the bank starts the ADC only while it has no input, so
        // nothing uses clk_adc or the ADC, and acquire_pll_usb leaves a
        // running PLL_USB alone. The reset alias registers change only
        // their bits.
        unsafe {
            acquire_pll_usb(self.crystal_hz)?
            // clk_adc from PLL_USB (aux source 0), undivided.
            control := reg(CLK_ADC_CTRL)
            control.write(0)
            divider := reg(CLK_ADC_DIV)
            divider.write(DIVIDE_BY_ONE)
            control.write(CLK_ENABLE)
            reset_blocks(RESET_ADC)?
            registers := hal.RegisterBlock.at(ADC_BASE)
            return rp_adc.start(&mut registers)
        }
    }

    pub fn stop_adc(&mut self) {
        // SAFETY: the bank stops the ADC once its last input is given back.
        unsafe {
            registers := hal.RegisterBlock.at(ADC_BASE)
            rp_adc.stop(&mut registers)
            hold := reg(RESET + SET_ALIAS)
            hold.write(RESET_ADC)
            control := reg(CLK_ADC_CTRL)
            control.write(0)
            release_pll_usb()
        }
    }

    pub fn uart_aux(&self) -> bool {
        return true
    }
    pub fn pio_blocks(&self) -> u32 {
        return PIO_BLOCKS
    }

    pub fn pio_version(&self) -> u32 {
        return 1
    }

    pub fn pio_irq(&self, block: u32) -> u32 {
        return PIO0_IRQ_0 + 2 * block
    }
}

// The RESET_ bit of rp_pins controller number `controller`.
fn controller_reset(controller: u32) -> u32 {
    if controller == rp_pins.I2C0 {
        return RESET_I2C0
    } else if controller == rp_pins.I2C1 {
        return RESET_I2C1
    } else if controller == rp_pins.SPI0 {
        return RESET_SPI0
    } else if controller == rp_pins.SPI1 {
        return RESET_SPI1
    } else if controller == rp_pins.UART0 {
        return RESET_UART0
    } else if controller == rp_pins.UART1 {
        return RESET_UART1
    } else if controller == rp_pins.PIO0 {
        return RESET_PIO0
    } else if controller == rp_pins.PIO1 {
        return RESET_PIO1
    } else if controller == rp_pins.PIO2 {
        return RESET_PIO2
    }
    return RESET_PWM
}

// Connect GPIO `number` to peripheral `function`, and change its pad
// settings: clear the `clear` bits, then set the `set` bits.
// SAFETY: the caller owns the pin's control and pad registers.
unsafe fn route(number: u32, function: u32, clear: u32, set: u32) {
    index := number as usize
    unsafe {
        pad := reg(PADS_BANK0_BASE + 4 + 4 * index)
        pad.modify(clear, set)
        control := reg(IO_BANK0_BASE + 8 * index + 4)
        control.set(FUNCSEL, function)
        // Release the pad only once the peripheral drives it (9.7).
        pad.clear_bits(PAD_ISOLATE)
    }
}

// One GPIO driven by the single-cycle I/O block. Implements the
// std/embedded/hal output and input pin protocols.
pub struct Pin {
    set: hal.Reg<u32>
    clear: hal.Reg<u32>
    toggle: hal.Reg<u32>
    input: hal.Reg<u32>
    output_enable: hal.Reg<u32>
    output_disable: hal.Reg<u32>
    mask: u32
    // This pin's interrupt bits: raw events, core 0's enables through the
    // set and clear aliases, and core 0's status, at `shift`.
    raw_events: hal.Reg<u32>
    listen_set: hal.Reg<u32>
    listen_clear: hal.Reg<u32>
    status: hal.Reg<u32>
    shift: u32

    pub fn set_high(&mut self) {
        self.set.write(self.mask)
    }

    pub fn set_low(&mut self) {
        self.clear.write(self.mask)
    }

    pub fn toggle(&mut self) {
        self.toggle.write(self.mask)
    }

    pub fn is_high(&self) -> bool {
        return self.input.any(self.mask)
    }

    // Drive the pin at its output level, for a line that changes direction
    // such as a half-duplex data line. Pins claimed as inputs start released.
    pub fn set_as_output(&mut self) {
        self.output_enable.write(self.mask)
    }

    // Release the pin so another device can drive it; is_high reads it.
    pub fn set_as_input(&mut self) {
        self.output_disable.write(self.mask)
    }

    // Raise IO_IRQ_BANK0 on `events`, any of LEVEL_LOW, LEVEL_HIGH,
    // FALLING_EDGE, and RISING_EDGE, after forgetting edges seen so far.
    // Enable the interrupt in the NVIC too: `cortex_m.enable(pin.irq())`.
    // Every pin shares the one interrupt; its handler tells them apart with
    // `events`.
    pub fn listen(&mut self, events: u32) {
        self.clear_events(events)
        self.listen_set.write((events & ALL_EVENTS) << self.shift)
    }

    // Stop raising the interrupt on `events`.
    pub fn ignore(&mut self, events: u32) {
        self.listen_clear.write((events & ALL_EVENTS) << self.shift)
    }

    // The listened-to events that are raising the interrupt now.
    pub fn events(&self) -> u32 {
        return (self.status.read() >> self.shift) & ALL_EVENTS
    }

    // Forget the edges among `events`, acknowledging them; a handler or
    // task must, or the interrupt stays raised. Levels cannot be cleared.
    pub fn clear_events(&mut self, events: u32) {
        self.raw_events.write((events & EDGES) << self.shift)
    }

    // The interrupt pin events raise, IO_IRQ_BANK0, for cortex_m.enable.
    pub fn irq(&self) -> u32 {
        return IO_IRQ_BANK0
    }
}

// The free-running 64-bit microsecond counter of TIMER0. Implements the
// std/embedded/hal delay protocol.
pub struct Timer {
    high: hal.Reg<u32>
    low: hal.Reg<u32>
    // Claimed alarms, one bit each.
    alarms: u32

    // Claim alarm 0 to 3, to run code at a set time from its interrupt.
    // Busy if it is claimed already; InvalidInput for another number.
    pub fn alarm(&mut self, number: u32) -> Alarm!hal.Error {
        if number >= ALARM_COUNT {
            return err(hal.Error.InvalidInput)
        }
        bit := 1u32 << number
        if (self.alarms & bit) != 0 {
            return err(hal.Error.Busy)
        }
        self.alarms |= bit
        // SAFETY: the claim above makes this the only Alarm for `number`.
        // It writes only its own ALARMn register and, through the
        // write-one-to-clear registers and the atomic set and clear
        // aliases, only its own bit of the shared ones.
        alarm := unsafe {
            Alarm {
                number,
                bit,
                target: hal.Reg.at(TIMER_ALARM0 + 4 * number as usize),
                high: hal.Reg.at(TIMER_RAW_HIGH),
                low: hal.Reg.at(TIMER_RAW_LOW),
                armed: hal.Reg.at(TIMER_ARMED),
                raw: hal.Reg.at(TIMER_INTR),
                listening: hal.Reg.at(TIMER_INTE),
                listen_set: hal.Reg.at(TIMER_INTE + SET_ALIAS),
                listen_clear: hal.Reg.at(TIMER_INTE + CLEAR_ALIAS),
            }
        }
        return ok(alarm)
    }

    // Disarm an alarm, stop its interrupt, and take it back.
    pub fn release_alarm(&mut self, alarm: Alarm) {
        alarm.cancel()
        alarm.ignore()
        alarm.clear()
        self.alarms &= ~alarm.bit
    }

    // Microseconds since take().
    pub fn now_us(&self) -> u64 {
        for {
            high := self.high.read()
            low := self.low.read()
            if self.high.read() == high {
                return ((high as u64) << 32) | low as u64
            }
        }
    }

    pub fn delay_us(&mut self, microseconds: u32) {
        start := self.low.read()
        for core.wrapping_sub(self.low.read(), start) < microseconds {}
    }

    pub fn delay_ms(&mut self, milliseconds: u32) {
        end := self.now_us() + (milliseconds as u64) * 1000
        for self.now_us() < end {}
    }
}

// One of the timer's four alarms, claimed with `Timer.alarm(n)`. An alarm
// fires once when the microsecond counter reaches the time it was given;
// with `listen` it raises interrupt TIMER0_IRQ_0 + n, whose handler calls
// `clear` and may schedule the next time. Move it into a
// `static mut Option<Alarm>` for the handler to use.
pub struct Alarm {
    number: u32
    bit: u32
    target: hal.Reg<u32>
    high: hal.Reg<u32>
    low: hal.Reg<u32>
    armed: hal.Reg<u32>
    raw: hal.Reg<u32>
    listening: hal.Reg<u32>
    listen_set: hal.Reg<u32>
    listen_clear: hal.Reg<u32>

    // 0 to 3.
    pub fn number(&self) -> u32 {
        return self.number
    }

    // The interrupt the alarm raises: its number for cortex_m.enable, and
    // its vector name, TIMER0_IRQ_0 + n, for `@interrupt`.
    pub fn irq(&self) -> u32 {
        return TIMER0_IRQ_0 + self.number
    }

    // The low 32 bits of the microsecond counter, which alarm times use.
    pub fn now(&self) -> u32 {
        return self.low.read()
    }

    // Fire when the counter's low 32 bits equal `time`, replacing any
    // earlier time. A time that has just passed fires only after the
    // counter wraps, 71.6 minutes later.
    pub fn schedule_at(&mut self, time: u32) {
        self.target.write(time)
    }

    // Fire `microseconds` from now; at least 1, and below 2^31 so the time
    // is still ahead when the write lands.
    pub fn schedule_in(&mut self, microseconds: u32) {
        self.target.write(core.wrapping_add(self.low.read(), microseconds))
    }

    // Disarm: a scheduled time no longer fires.
    pub fn cancel(&mut self) {
        self.armed.write(self.bit)
    }

    // True from scheduling until it fires or is cancelled.
    pub fn is_armed(&self) -> bool {
        return self.armed.any(self.bit)
    }

    // True once it has fired, until `clear`.
    pub fn fired(&self) -> bool {
        return self.raw.any(self.bit)
    }

    // Acknowledge that it fired. An interrupt handler has to, or the
    // interrupt stays raised and the handler runs again at once.
    pub fn clear(&mut self) {
        self.raw.write(self.bit)
    }

    // Raise the interrupt when it fires. Enable the interrupt in the NVIC
    // too: `cortex_m.enable(alarm.irq())`.
    pub fn listen(&mut self) {
        self.listen_set.write(self.bit)
    }

    // Stop raising the interrupt; `fired` still reports.
    pub fn ignore(&mut self) {
        self.listen_clear.write(self.bit)
    }

    pub fn is_listening(&self) -> bool {
        return self.listening.any(self.bit)
    }

    // Microseconds since take(), from the whole 64-bit counter, as
    // Timer.now_us reads it.
    pub fn now_us(&self) -> u64 {
        for {
            high := self.high.read()
            low := self.low.read()
            if self.high.read() == high {
                return ((high as u64) << 32) | low as u64
            }
        }
    }

    // Sleep (`wfi`) until an interrupt is pending or the counter reaches
    // `deadline`, a now_us time; none waits for an interrupt only. With
    // now_us this is the std/embedded/executor clock, so an alarm runs an
    // executor: `executor.run(&mut tasks, &mut alarm)`. The alarm's
    // interrupt ends the sleep while interrupts are masked and is cleared
    // before they are unmasked, so it needs no `@interrupt` handler; other
    // interrupts' handlers run after the return, or once the caller's own
    // critical section ends. Times more than 35 minutes ahead wake early.
    // Leaves the alarm disarmed and not listening.
    pub fn sleep_until(&mut self, deadline: Option<u64>) {
        section := hal.Critical.enter()
        if let some(time) = deadline {
            now := self.now_us()
            if time > now {
                ahead := time - now
                if ahead > MAX_ALARM_SLEEP_US {
                    ahead = MAX_ALARM_SLEEP_US
                }
                irq := self.irq()
                self.clear()
                cortex_m.unpend(irq)
                self.listen()
                cortex_m.enable(irq)
                self.schedule_at(core.wrapping_add((now & 0xFFFF_FFFF) as u32, ahead as u32))
                // A time that passed before the alarm was armed would only
                // fire once the counter wraps. One that passes after it
                // makes the interrupt pending, which ends the sleep at once.
                if self.now_us() < now + ahead {
                    cpu.wait_for_interrupt()
                }
                self.cancel()
                self.ignore()
                self.clear()
                cortex_m.disable(irq)
                cortex_m.unpend(irq)
            }
        } else {
            cpu.wait_for_interrupt()
        }
        core.drop(section)
    }
}

// Low power, as `Peripherals.power`; implements std/embedded/power's
// protocol, whose package comment describes the modes.
//
// On the RP2350, a deep sleep stops the clocks outside the sleep set only
// while both cores deep-sleep; a core 1 that was never started does. Every
// clock starts in the sleep set, so a deep sleep stops nothing more than a
// light one until `set_sleep_clocks` says otherwise. The clock constants
// above name the gates. Claiming a peripheral starts its clocks, so
// `disable_unused_clocks` is safe at any time. It also stops HSTX, TIMER1,
// SHA-256, and the TRNG, which this package does not drive, while they are
// held in reset; the timer (CLOCK_TIMER) and DMA (CLOCK_DMA) are not
// claimed through Pins, so it leaves them to the program.
//
// `dormant` runs clk_sys from the crystal, stops PLL_SYS and the ring
// oscillator, and stops the crystal until a pin event, then starts them
// again. Both cores stop. The microsecond timer pauses meanwhile, so
// `now_us` does not count the time spent dormant. It returns Busy while the
// USB serial port or an ADC input runs, since their 48 MHz clock would
// stop. Wait until serial ports have sent their last bytes first, as
// clk_peri slows down to the crystal's rate during the switch.
pub struct Power: power.Power {
    crystal_hz: u32

    pub fn mode(&self) -> power.Mode {
        return rp_power.mode()
    }

    pub fn set_mode(&mut self, mode: power.Mode) {
        rp_power.set_mode(mode)
    }

    pub fn sleep(&mut self) {
        rp_power.sleep()
    }

    pub fn enabled_clocks(&self) -> power.Clocks {
        // SAFETY: reading WAKE_EN has no side effects.
        clocks := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        return rp_power.read_clocks(&mut clocks, CLOCKS_WAKE_EN)
    }

    pub fn enable_clocks(&mut self, clocks: power.Clocks) {
        // SAFETY: Power owns WAKE_EN apart from reset_blocks, and both
        // change it only through its set and clear aliases.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.set_clocks(&mut block, CLOCKS_WAKE_EN, clocks & ALL_CLOCKS)
    }

    pub fn disable_clocks(&mut self, clocks: power.Clocks) -> void!hal.Error {
        if (clocks & ~ALL_CLOCKS) != 0 || (clocks & ESSENTIAL_CLOCKS) != 0 {
            return err(hal.Error.InvalidInput)
        }
        if (clocks & clocks_in_use()) != 0 {
            return err(hal.Error.Busy)
        }
        // SAFETY: as in enable_clocks; no claimed peripheral and nothing
        // the program needs to run uses `clocks`.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.clear_clocks(&mut block, CLOCKS_WAKE_EN, clocks)
        return ok()
    }

    pub fn disable_unused_clocks(&mut self) -> power.Clocks {
        unused := MANAGED_CLOCKS & ~clocks_in_use() & self.enabled_clocks()
        // SAFETY: as in disable_clocks; the peripherals are held in reset.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.clear_clocks(&mut block, CLOCKS_WAKE_EN, unused)
        return unused
    }

    pub fn sleep_clocks(&self) -> power.Clocks {
        // SAFETY: reading SLEEP_EN has no side effects.
        clocks := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        return rp_power.read_clocks(&mut clocks, CLOCKS_SLEEP_EN)
    }

    pub fn set_sleep_clocks(&mut self, clocks: power.Clocks) {
        // SAFETY: Power alone writes SLEEP_EN, which only applies while the
        // cores deep-sleep.
        block := unsafe {
            hal.RegisterBlock.at(CLOCKS_BASE)
        }
        rp_power.write_clocks(&mut block, CLOCKS_SLEEP_EN, clocks & ALL_CLOCKS)
    }

    pub fn dormant(&mut self, wake: &power.Wake) -> u64!hal.Error {
        rp_power.check_wake(wake, PIN_COUNT)?
        layout := power_layout()
        section := hal.Critical.enter()
        // SAFETY: interrupts are masked, so this core reads the count
        // atomically and no handler sees the clocks change.
        users := unsafe {
            PLL_USB_USERS
        }
        if users != 0 {
            core.drop(section)
            return err(hal.Error.Busy)
        }
        // SAFETY: Power owns the dormant state; nothing runs from PLL_USB,
        // and interrupts stay masked throughout.
        result := unsafe {
            go_dormant(self.crystal_hz, &layout, wake)
        }
        core.drop(section)
        return result
    }
}

// The register offsets rp_power needs.
fn power_layout() -> rp_power.Layout {
    return rp_power.Layout {
        wake_en: CLOCKS_WAKE_EN,
        sleep_en: CLOCKS_SLEEP_EN,
        rosc_status: ROSC_STATUS,
        dormant_wake_inte: GPIO_DORMANT_WAKE_INTE,
        dormant_wake_ints: GPIO_DORMANT_WAKE_INTS,
        pin_count: PIN_COUNT,
    }
}

// Run from the crystal, stop until one of `wake`'s events, and restart
// PLL_SYS and clk_sys from it; return the pins that woke the chip.
// SAFETY: interrupts must be masked and PLL_USB stopped, and the caller
// must own the clock, reset, PLL_SYS, oscillator, and dormant wake
// registers.
unsafe fn go_dormant(crystal_hz: u32, layout: &rp_power.Layout, wake: &power.Wake) -> u64!hal.Error {
    unsafe {
        io := hal.RegisterBlock.at(IO_BANK0_BASE)
        xosc := hal.RegisterBlock.at(XOSC_BASE)
        rosc := hal.RegisterBlock.at(ROSC_BASE)
        // clk_sys from clk_ref, the crystal, through the glitchless mux,
        // then PLL_SYS can stop.
        sys_ctrl := reg(CLK_SYS_CTRL)
        sys_ctrl.clear_bits(CLK_SYS_SRC_AUX)
        sys_selected := reg(CLK_SYS_SELECTED)
        sys_selected.wait_set(1, ATTEMPTS)?
        hold := reg(RESET + SET_ALIAS)
        hold.write(RESET_PLL_SYS)
        rp_power.arm_wake(&mut io, layout, wake)
        stopped := rp_power.stop_oscillators(&mut xosc, &mut rosc, layout)
        woken := rp_power.woken_pins(&mut io, layout, wake)
        rp_power.disarm_wake(&mut io, layout, wake)
        stopped?
        start_pll(PLL_SYS_BASE, RESET_PLL_SYS, crystal_hz, VCO_HZ, 5, 2)?
        sys_ctrl.set_bits(CLK_SYS_SRC_AUX)
        sys_selected.wait_set(1 << 1, ATTEMPTS)?
        return ok(woken)
    }
}

// The clocks of the blocks whose reset bits are `blocks`, apart from
// essential ones.
fn block_clocks(blocks: u32) -> power.Clocks {
    clocks := 0u64
    if (blocks & RESET_ADC) != 0 {
        clocks |= CLOCK_ADC
    }
    if (blocks & RESET_DMA) != 0 {
        clocks |= CLOCK_DMA
    }
    if (blocks & RESET_HSTX) != 0 {
        clocks |= CLOCK_HSTX
    }
    if (blocks & RESET_I2C0) != 0 {
        clocks |= CLOCK_I2C0
    }
    if (blocks & RESET_I2C1) != 0 {
        clocks |= CLOCK_I2C1
    }
    if (blocks & RESET_PIO0) != 0 {
        clocks |= CLOCK_PIO0
    }
    if (blocks & RESET_PIO1) != 0 {
        clocks |= CLOCK_PIO1
    }
    if (blocks & RESET_PIO2) != 0 {
        clocks |= CLOCK_PIO2
    }
    if (blocks & RESET_PLL_USB) != 0 {
        clocks |= CLOCK_PLL_USB
    }
    if (blocks & RESET_PWM) != 0 {
        clocks |= CLOCK_PWM
    }
    if (blocks & RESET_SHA256) != 0 {
        clocks |= CLOCK_SHA256
    }
    if (blocks & RESET_SPI0) != 0 {
        clocks |= CLOCK_SPI0
    }
    if (blocks & RESET_SPI1) != 0 {
        clocks |= CLOCK_SPI1
    }
    if (blocks & RESET_TIMER0) != 0 {
        clocks |= CLOCK_TIMER
    }
    if (blocks & RESET_TIMER1) != 0 {
        clocks |= CLOCK_TIMER1
    }
    if (blocks & RESET_TRNG) != 0 {
        clocks |= CLOCK_TRNG
    }
    if (blocks & RESET_UART0) != 0 {
        clocks |= CLOCK_UART0
    }
    if (blocks & RESET_UART1) != 0 {
        clocks |= CLOCK_UART1
    }
    if (blocks & RESET_USBCTRL) != 0 {
        clocks |= CLOCK_USB
    }
    return clocks
}

// The clocks of managed peripherals that are out of reset, so in use.
fn clocks_in_use() -> power.Clocks {
    // SAFETY: reading RESET has no side effects.
    held := unsafe {
        reg(RESET)
    }
    return block_clocks(~held.read()) & MANAGED_CLOCKS
}
