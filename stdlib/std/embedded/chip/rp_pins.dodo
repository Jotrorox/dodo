package rp_pins

import "core/ptr"
import "std/embedded/hal"
import "std/embedded/chip/rp_adc"
import "std/embedded/chip/rp_dma"
import "std/embedded/chip/rp_pio"
import "std/embedded/chip/rp_pwm"
import "std/embedded/peripheral/designware_i2c"
import "std/embedded/peripheral/pl011"
import "std/embedded/peripheral/pl022"

// The GPIO, I2C, SPI, UART, PWM, ADC, and PIO ownership the RP2040 and
// RP2350 share. On both chips GPIO 0 to 29 select the same controller signals with
// the same function numbers and pad bits, so the chip packages keep their
// pins in a `Bank`, which checks bus pins, hands out each pin and controller
// once, and takes them back. Serial ports claimed from a bank also report panics; see
// report_panic.

// The GPIOs whose functions both chips share.
pub const PIN_COUNT: u32 = 30

// The bus controllers, as `Bank` numbers them for its chip.
pub const I2C0: u32 = 0
pub const I2C1: u32 = 1
pub const SPI0: u32 = 2
pub const SPI1: u32 = 3
pub const UART0: u32 = 4
pub const UART1: u32 = 5
const CONTROLLERS: usize = 6
// The PWM block and the ADC, which serve several pins each.
pub const PWM: u32 = 6
pub const ADC: u32 = 7
// The PIO blocks: PIO0 + n is block n, up to PIO1 on the RP2040 and PIO2 on
// the RP2350.
pub const PIO0: u32 = 8
pub const PIO1: u32 = 9
pub const PIO2: u32 = 10

// GPIO functions (FUNCSEL). NULL disconnects the pin: it floats, apart from
// its pad's pulls.
const FUNCTION_SPI: u32 = 1
const FUNCTION_UART: u32 = 2
const FUNCTION_I2C: u32 = 3
const FUNCTION_PWM: u32 = 4
const FUNCTION_SIO: u32 = 5
// PIO block n drives the pins connected to function FUNCTION_PIO0 + n.
const FUNCTION_PIO0: u32 = 6
// The RP2350's second UART function, TX and RX on the pins that otherwise
// carry CTS and RTS.
const FUNCTION_UART_AUX: u32 = 11
const FUNCTION_NULL: u32 = 31

// Pad controls.
const PAD_PULL_DOWN: u32 = 1 << 2
const PAD_PULL_UP: u32 = 1 << 3
const PAD_INPUT_ENABLE: u32 = 1 << 6
const PAD_OUTPUT_DISABLE: u32 = 1 << 7

// The I2C controller, 0 or 1, that pins `sda` and `scl` form a bus on. Even
// pins carry SDA and odd pins SCL. GPIO 0 and 1, 4 and 5, and so on in steps
// of four belong to I2C0; GPIO 2 and 3, 6 and 7, and so on to I2C1.
// InvalidInput if the two pins cannot form a bus.
pub fn i2c_controller(sda: u32, scl: u32) -> u32!hal.Error {
    if sda >= PIN_COUNT || scl >= PIN_COUNT || sda % 2 != 0 || scl % 2 != 1 || (sda / 2) % 2 != (scl / 2) % 2 {
        return err(hal.Error.InvalidInput)
    }
    return ok((sda / 2) % 2)
}

// The pins of an SPI bus, from `spi_pins`.
pub struct SpiPins {
    // The controller, 0 or 1.
    pub controller: u32
    // The receive pin, if the bus has one.
    pub rx: Option<u32>
    // Every pin of the bus, one bit each.
    pub mask: u32
}

// The SPI bus that pins `clock`, `tx`, and `rx` (if any) form. GPIO n
// carries RX when n % 4 is 0, the clock when it is 2, and TX when it is 3.
// GPIO 0 to 7 and 16 to 23 belong to SPI0, GPIO 8 to 15 and 24 to 29 to
// SPI1. InvalidInput if the pins cannot form a bus.
pub fn spi_pins(clock: u32, tx: u32, rx: Option<u32>) -> SpiPins!hal.Error {
    if clock >= PIN_COUNT || tx >= PIN_COUNT || clock % 4 != 2 || tx % 4 != 3 || (clock / 8) % 2 != (tx / 8) % 2 {
        return err(hal.Error.InvalidInput)
    }
    controller := (clock / 8) % 2
    mask := (1u32 << clock) | (1u32 << tx)
    if let some(number) = rx {
        if number >= PIN_COUNT || number % 4 != 0 || (number / 8) % 2 != controller {
            return err(hal.Error.InvalidInput)
        }
        return ok(SpiPins { controller, rx: some(number), mask: mask | (1u32 << number) })
    }
    return ok(SpiPins { controller, rx: none, mask })
}

// The chip select pin of SPI controller `controller` at GPIO `select`, as
// a mask: GPIO n carries it when n % 4 is 1, in the same blocks of eight as
// spi_pins. InvalidInput if the pin cannot.
pub fn spi_select_pin(controller: u32, select: u32) -> u32!hal.Error {
    if select >= PIN_COUNT || select % 4 != 1 || (select / 8) % 2 != controller {
        return err(hal.Error.InvalidInput)
    }
    return ok(1u32 << select)
}

// The pins of a serial port, from `uart_pins`.
pub struct UartPins {
    // The controller, 0 or 1.
    pub controller: u32
    // Every pin of the port, one bit each.
    pub mask: u32
    // The pins among them on the RP2350's UART_AUX function.
    pub aux: u32
}

// The serial port that pins `tx` and `rx` (if any) form. GPIO n carries TX
// when n % 4 is 0 and RX when it is 1. GPIO 0 to 3, 12 to 19, 28, and 29
// belong to UART0, GPIO 4 to 11 and 20 to 27 to UART1. InvalidInput if the
// pins cannot form a port.
pub fn uart_pins(tx: u32, rx: Option<u32>) -> UartPins!hal.Error {
    if tx >= PIN_COUNT || tx % 4 != 0 {
        return err(hal.Error.InvalidInput)
    }
    controller := uart_of(tx)
    mask := 1u32 << tx
    if let some(number) = rx {
        if number >= PIN_COUNT || number % 4 != 1 || uart_of(number) != controller {
            return err(hal.Error.InvalidInput)
        }
        mask |= 1u32 << number
    }
    return ok(UartPins { controller, mask, aux: 0 })
}

// The serial port that pins `tx` and `rx` (if any) form on the RP2350,
// which also carries TX on GPIO n with n % 4 = 2 and RX on n % 4 = 3, the
// pins of its UART_AUX function; `aux` marks them. Pins of both kinds may
// be mixed within a UART. InvalidInput if the pins cannot form a port.
pub fn uart_aux_pins(tx: u32, rx: Option<u32>) -> UartPins!hal.Error {
    if tx >= PIN_COUNT || (tx % 4 != 0 && tx % 4 != 2) {
        return err(hal.Error.InvalidInput)
    }
    controller := uart_of(tx)
    mask := 1u32 << tx
    aux := 0u32
    if tx % 4 == 2 {
        aux = mask
    }
    if let some(number) = rx {
        if number >= PIN_COUNT || (number % 4 != 1 && number % 4 != 3) || uart_of(number) != controller {
            return err(hal.Error.InvalidInput)
        }
        mask |= 1u32 << number
        if number % 4 == 3 {
            aux |= 1u32 << number
        }
    }
    return ok(UartPins { controller, mask, aux })
}

// The serial port of `uart_pins` with hardware flow control: GPIO n
// carries CTS when n % 4 is 2 and RTS when it is 3, in the same groups of
// four. InvalidInput if the pins cannot form the port.
pub fn uart_flow_pins(tx: u32, rx: u32, cts: u32, rts: u32) -> UartPins!hal.Error {
    pins := uart_pins(tx, some(rx))?
    if cts >= PIN_COUNT || rts >= PIN_COUNT || cts % 4 != 2 || rts % 4 != 3 || uart_of(cts) != pins.controller || uart_of(rts) != pins.controller {
        return err(hal.Error.InvalidInput)
    }
    return ok(UartPins { controller: pins.controller, mask: pins.mask | (1u32 << cts) | (1u32 << rts), aux: 0 })
}

// The UART of GPIO `number`'s group of four pins: groups 0, 3, 4, and 7 are
// UART0's, groups 1, 2, 5, and 6 UART1's.
fn uart_of(number: u32) -> u32 {
    return ((number / 4 + 1) / 2) % 2
}

// GPIO 0 to 29, the bus controllers, and the PWM outputs and ADC inputs of
// one chip C, each handed out once and taken back by the release methods. C
// does what differs between the chips, with these methods, `controller`
// numbered as I2C0 to PIO2 above:
//
//    route(&mut self, pin: u32, function: u32, clear: u32, set: u32)
//        connect the pin to FUNCSEL `function`, then clear the `clear` and
//        set the `set` bits of its pad
//    reset(&mut self, controller: u32) -> void!hal.Error
//        pulse the controller's reset and wait until it runs (I2C0 to PWM,
//        and the PIO blocks)
//    hold(&mut self, controller: u32)
//        hold the controller in reset (as for `reset`)
//    base(&self, controller: u32) -> usize
//        the controller's register block
//    clock_hz(&self) -> u32
//        the frequency of the clock that feeds the controllers and PWM
//    start_adc(&mut self) -> void!hal.Error
//        start the ADC's 48 MHz clock, pulse its reset, and rp_adc.start it
//    stop_adc(&mut self)
//        rp_adc.stop the ADC, hold it in reset, and stop its clock
//    uart_aux(&self) -> bool
//        whether the chip has the UART_AUX function (the RP2350)
//    pio_blocks(&self) -> u32
//        the number of PIO blocks: 2 on the RP2040, 3 on the RP2350
//    pio_version(&self) -> u32
//        their PIO version: 0 on the RP2040, 1 on the RP2350
//    pio_irq(&self, block: u32) -> u32
//        the interrupt number of PIO block `block`'s interrupt line 0;
//        line 1's follows it
pub struct Bank<C> {
    chip: C
    // Pins in use, one bit each.
    taken: u32
    // The pins of each controller's bus, by controller number; 0 while the
    // controller is free.
    buses: [6]u32
    // Pins driven by PWM outputs, and ADC inputs in use, one bit each.
    pwm_pins: u32
    analog_inputs: u32
    // PIO blocks in use, one bit each, and the pins each one drives.
    pio_blocks: u32
    pio_pins: [3]u32

    // SAFETY: C's methods must do what the protocol above says, `base` must
    // name the controller's DW_apb_i2c, PL022, or PL011, the PWM block, the
    // ADC, or the PIO block, and the bank must be the only bank, and the
    // only user of GPIO 0 to 29's control and pad registers, of the
    // controllers, the PWM block, the ADC, and the PIO blocks, and of their
    // resets and clocks.
    pub unsafe fn new(chip: C) -> Bank<C> {
        return Bank<C> { chip, taken: 0, buses: [0u32; 6], pwm_pins: 0, analog_inputs: 0, pio_blocks: 0, pio_pins: [0u32; 3] }
    }

    // Claim pin `number` for the single-cycle I/O block. Returns its bit, for
    // the chip's GPIO registers. InvalidInput above GPIO 29, Busy if taken.
    pub fn gpio(&mut self, number: u32) -> u32!hal.Error {
        if number >= PIN_COUNT {
            return err(hal.Error.InvalidInput)
        }
        mask := 1u32 << number
        self.reserve(mask)?
        self.chip.route(number, FUNCTION_SIO, PAD_OUTPUT_DISABLE, PAD_INPUT_ENABLE)
        return ok(mask)
    }

    // Give back the GPIO with bit `mask`, from `gpio`, which the caller has
    // stopped driving. The pin is disconnected until it is claimed again.
    pub fn release_gpio(&mut self, mask: u32) {
        self.disconnect(mask)
    }

    // Claim pins `sda` and `scl` as an I2C bus with an SCL frequency of
    // `frequency_hz`; see i2c_controller for the pins. InvalidInput if the
    // two pins cannot form a bus or the frequency is out of range, Busy if a
    // pin or the controller is taken. The pads' pull-ups (about 50 kOhm)
    // keep an idle bus high but are too weak for fast mode.
    pub fn i2c(&mut self, sda: u32, scl: u32, frequency_hz: u32) -> designware_i2c.Bus!hal.Error {
        controller := I2C0 + i2c_controller(sda, scl)?
        timing := designware_i2c.timing(self.chip.clock_hz(), frequency_hz)?
        self.start(controller, (1u32 << sda) | (1u32 << scl))?
        // SAFETY: `start` made the controller and both pins exclusive to
        // this bus, and Bank.new vouches for the base address.
        unsafe {
            bus := designware_i2c.Bus.at(self.chip.base(controller), timing)
            // The controller pulls a line low by enabling the pad's output.
            self.connect(controller, FUNCTION_I2C, PAD_OUTPUT_DISABLE | PAD_PULL_DOWN, PAD_INPUT_ENABLE | PAD_PULL_UP)
            return ok(bus)
        }
    }

    // Claim pins as an SPI bus in `mode`, clocked at the fastest rate up to
    // `frequency_hz`; see spi_pins for the pins. Errors as for `i2c`.
    pub fn spi(&mut self, clock: u32, tx: u32, rx: Option<u32>, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        pins := spi_pins(clock, tx, rx)?
        controller := SPI0 + pins.controller
        divisors := pl022.divisors(self.chip.clock_hz(), frequency_hz)?
        self.start(controller, pins.mask)?
        // SAFETY: as for `i2c`.
        unsafe {
            bus := pl022.Bus.at(self.chip.base(controller), divisors, mode)
            self.connect(controller, FUNCTION_SPI, PAD_OUTPUT_DISABLE, PAD_INPUT_ENABLE)
            return ok(bus)
        }
    }

    // Claim pins `sda` and `scl` as an I2C target answering at `address`, a
    // 10-bit address with `ten_bit`; see designware_i2c.target_address.
    // `frequency_hz` is the master's SCL frequency, for the input filter.
    // Errors as for `i2c`, and InvalidInput for a reserved address.
    pub fn i2c_target(&mut self, sda: u32, scl: u32, address: u16, ten_bit: bool, frequency_hz: u32) -> designware_i2c.TargetBus!hal.Error {
        controller := I2C0 + i2c_controller(sda, scl)?
        designware_i2c.target_address(address, ten_bit)?
        timing := designware_i2c.timing(self.chip.clock_hz(), frequency_hz)?
        self.start(controller, (1u32 << sda) | (1u32 << scl))?
        // SAFETY: as for `i2c`, with the address checked above.
        unsafe {
            target := designware_i2c.TargetBus.at(self.chip.base(controller), timing, address, ten_bit)
            self.connect(controller, FUNCTION_I2C, PAD_OUTPUT_DISABLE | PAD_PULL_DOWN, PAD_INPUT_ENABLE | PAD_PULL_UP)
            return ok(target)
        }
    }

    // `spi`, with the controller's own chip select on pin `select` as
    // well; see spi_select_pin. The TI and Microwire frame formats need
    // it. Errors as for `spi`.
    pub fn spi_with_select(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        pins := spi_pins(clock, tx, rx)?
        select_mask := spi_select_pin(pins.controller, select)?
        controller := SPI0 + pins.controller
        divisors := pl022.divisors(self.chip.clock_hz(), frequency_hz)?
        self.start(controller, pins.mask | select_mask)?
        // SAFETY: as for `i2c`.
        unsafe {
            bus := pl022.Bus.at(self.chip.base(controller), divisors, mode)
            self.connect(controller, FUNCTION_SPI, PAD_OUTPUT_DISABLE, PAD_INPUT_ENABLE)
            return ok(bus)
        }
    }

    // Claim pins as an SPI target in `mode`, clocked and selected by
    // another master: `clock` and `select` are inputs, `rx` receives what
    // the master sends, and `tx` answers it; see spi_pins and
    // spi_select_pin. Pulled up, an unconnected select leaves the target
    // deselected. Errors as for `spi`.
    pub fn spi_target(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode) -> pl022.TargetBus!hal.Error {
        pins := spi_pins(clock, tx, rx)?
        select_mask := spi_select_pin(pins.controller, select)?
        controller := SPI0 + pins.controller
        self.start(controller, pins.mask | select_mask)?
        // SAFETY: as for `i2c`.
        unsafe {
            target := pl022.TargetBus.at(self.chip.base(controller), mode)
            self.connect(controller, FUNCTION_SPI, PAD_OUTPUT_DISABLE, PAD_INPUT_ENABLE)
            self.chip.route(select, FUNCTION_SPI, PAD_PULL_DOWN, PAD_PULL_UP)
            return ok(target)
        }
    }

    // Claim pin `tx`, and `rx` if any, as a serial port with 8N1 frames at
    // the baud rate closest to `baud`; see uart_pins for the pins.
    // InvalidInput if the pins cannot form a port or the baud rate is out of
    // range, Busy if a pin or the controller is taken. Until the port is
    // released, report_panic writes to it.
    pub fn uart(&mut self, tx: u32, rx: Option<u32>, baud: u32) -> pl011.Port!hal.Error {
        if self.chip.uart_aux() {
            return self.open_uart(uart_aux_pins(tx, rx)?, baud)
        }
        return self.open_uart(uart_pins(tx, rx)?, baud)
    }

    fn open_uart(&mut self, pins: UartPins, baud: u32) -> pl011.Port!hal.Error {
        controller := UART0 + pins.controller
        divisors := pl011.divisors(self.chip.clock_hz(), baud)?
        self.start(controller, pins.mask)?
        // Pulled up, so a receiver with nothing connected, and the pins once
        // released, idle high like a line between frames instead of reading
        // as a break. Routed before the controller is enabled, as the Pico
        // SDK's stdio does, so the receiver never starts on a low, unrouted
        // input and reads a byte that was never sent.
        self.connect(controller, FUNCTION_UART, PAD_OUTPUT_DISABLE | PAD_PULL_DOWN, PAD_INPUT_ENABLE | PAD_PULL_UP)
        for number in 0..PIN_COUNT {
            if (pins.aux & (1u32 << number)) != 0 {
                self.chip.route(number, FUNCTION_UART_AUX, 0, 0)
            }
        }
        base := self.chip.base(controller)
        // SAFETY: as for `i2c`. Bank.new vouches that this is the only bank,
        // so only it changes CONSOLES.
        unsafe {
            port := pl011.Port.at(base, divisors)
            CONSOLES[(controller - UART0) as usize] = base
            return ok(port)
        }
    }

    // `uart` with hardware flow control on pins `cts` and `rts` as well,
    // turned on; see uart_flow_pins and pl011's set_flow_control. Errors as
    // for `uart`.
    pub fn uart_flow(&mut self, tx: u32, rx: u32, cts: u32, rts: u32, baud: u32) -> pl011.Port!hal.Error {
        pins := uart_flow_pins(tx, rx, cts, rts)?
        port := self.open_uart(pins, baud)?
        // Nothing is queued yet, so this does not wait.
        match port.set_flow_control(true, true) {
            ok() => {
                return ok(port)
            }
            err(error) => {
                self.release_uart(port)
                return err(error)
            }
        }
    }

    // Claim pin `pin` as a PWM output at the frequency closest to
    // `frequency_hz`, low until a duty is set; see rp_pwm for the slices
    // and the frequency range. InvalidInput above GPIO 29 or for a frequency
    // out of range, Busy if the pin is taken, if its output is in use on
    // another pin (GPIO n and n + 16 carry the same output), or if the
    // other output of its slice runs at another frequency.
    pub fn pwm(&mut self, pin: u32, frequency_hz: u32) -> rp_pwm.Pwm!hal.Error {
        timing := rp_pwm.timing(self.chip.clock_hz(), frequency_hz)?
        return self.open_pwm(pin, timing)
    }

    // `pwm` with the slice's divider, in sixteenths, and TOP given instead
    // of a frequency; see rp_pwm.divided. Errors as for `pwm`.
    pub fn pwm_divided(&mut self, pin: u32, divider: u32, top: u32) -> rp_pwm.Pwm!hal.Error {
        timing := rp_pwm.divided(self.chip.clock_hz(), divider, top)?
        return self.open_pwm(pin, timing)
    }

    fn open_pwm(&mut self, pin: u32, timing: rp_pwm.Timing) -> rp_pwm.Pwm!hal.Error {
        if pin >= PIN_COUNT {
            return err(hal.Error.InvalidInput)
        }
        mask := 1u32 << pin
        self.reserve(mask)?
        if self.pwm_pins == 0 {
            match self.chip.reset(PWM) {
                ok() => {}
                err(error) => {
                    self.taken &= ~mask
                    return err(error)
                }
            }
        }
        // SAFETY: Bank.new vouches for the base address, the reset above
        // started the block, and only Channels use it.
        base := self.chip.base(PWM)
        opened := unsafe {
            rp_pwm.Pwm.at(base, pin, timing)
        }
        match opened {
            ok(output) => {
                self.pwm_pins |= mask
                self.chip.route(pin, FUNCTION_PWM, PAD_OUTPUT_DISABLE, PAD_INPUT_ENABLE)
                return ok(output)
            }
            err(error) => {
                self.taken &= ~mask
                if self.pwm_pins == 0 {
                    self.chip.hold(PWM)
                }
                return err(error)
            }
        }
    }

    // Give back a PWM output from `pwm`: it stops driving its pin, which is
    // disconnected, and the PWM block is held in reset once no output is
    // left.
    pub fn release_pwm(&mut self, output: rp_pwm.Pwm) {
        mask := 1u32 << output.pin()
        output.release()
        self.pwm_pins &= ~mask
        self.disconnect(mask)
        if self.pwm_pins == 0 {
            self.chip.hold(PWM)
        }
    }

    // Claim pin `pin`, GPIO 26 to 29, as an ADC input. Its digital input
    // and pulls are turned off, so they do not disturb the voltage. The ADC
    // starts with its first input. InvalidInput for another pin, Busy if
    // the pin is taken, and Timeout if the ADC or its clock does not start.
    pub fn analog(&mut self, pin: u32) -> rp_adc.Analog!hal.Error {
        input := rp_adc.input_of(pin)?
        mask := 1u32 << pin
        self.reserve(mask)?
        match self.open_analog(input) {
            ok(analog) => {
                self.chip.route(pin, FUNCTION_NULL, PAD_INPUT_ENABLE | PAD_PULL_UP | PAD_PULL_DOWN, PAD_OUTPUT_DISABLE)
                return ok(analog)
            }
            err(error) => {
                self.taken &= ~mask
                return err(error)
            }
        }
    }

    // Claim the temperature sensor, an ADC input; rp_adc.millicelsius
    // converts its readings. Busy if it is claimed already, Timeout as for
    // `analog`.
    pub fn temperature(&mut self) -> rp_adc.Analog!hal.Error {
        if (self.analog_inputs & (1u32 << rp_adc.TEMPERATURE_INPUT)) != 0 {
            return err(hal.Error.Busy)
        }
        return self.open_analog(rp_adc.TEMPERATURE_INPUT)
    }

    fn open_analog(&mut self, input: u32) -> rp_adc.Analog!hal.Error {
        if self.analog_inputs == 0 {
            self.chip.start_adc()?
        }
        self.analog_inputs |= 1u32 << input
        // SAFETY: Bank.new vouches for the base address, start_adc started
        // the ADC, and each input is handed out once.
        base := self.chip.base(ADC)
        unsafe {
            return ok(rp_adc.Analog.at(base, input))
        }
    }

    // Give back an ADC input from `analog` or `temperature`. A pin is
    // disconnected; the ADC stops, with its clock, once no input is left.
    pub fn release_analog(&mut self, analog: rp_adc.Analog) {
        input := analog.input()
        analog.release()
        if input < rp_adc.PIN_COUNT {
            self.disconnect(1u32 << (rp_adc.FIRST_PIN + input))
        }
        self.analog_inputs &= ~(1u32 << input)
        if self.analog_inputs == 0 {
            self.chip.stop_adc()
        }
    }

    // Claim PIO block `number`, 0 to pio_blocks() - 1, out of reset with
    // every state machine stopped. InvalidInput for another number, Busy
    // if it is claimed, Timeout if it does not leave reset.
    pub fn pio(&mut self, number: u32) -> rp_pio.Pio!hal.Error {
        if number >= self.chip.pio_blocks() {
            return err(hal.Error.InvalidInput)
        }
        bit := 1u32 << number
        if (self.pio_blocks & bit) != 0 {
            return err(hal.Error.Busy)
        }
        self.chip.reset(PIO0 + number)?
        self.pio_blocks |= bit
        base := self.chip.base(PIO0 + number)
        version := self.chip.pio_version()
        clock_hz := self.chip.clock_hz()
        irq := self.chip.pio_irq(number)
        // SAFETY: Bank.new vouches for the base address, the reset above
        // left the block in its reset state, and the claim makes the Pio
        // its only user.
        unsafe {
            return ok(rp_pio.Pio.at(base, number, version, clock_hz, irq))
        }
    }

    // Connect the `count` pins from GPIO `first` to PIO block `pio`, so its
    // state machines drive them, through the pin mappings of their
    // configs, and read them. State machines also read pins claimed in
    // other ways, such as inputs. InvalidInput for pins above GPIO 29 or a
    // count of 0, Busy if a pin is taken.
    pub fn pio_pins(&mut self, pio: &rp_pio.Pio, first: u32, count: u32) -> void!hal.Error {
        if count == 0 || first >= PIN_COUNT || count > PIN_COUNT - first {
            return err(hal.Error.InvalidInput)
        }
        block := pio.number()
        core.assert((self.pio_blocks & (1u32 << block)) != 0)
        mask := (0xFFFF_FFFFu32 >> (32 - count)) << first
        self.reserve(mask)?
        for number in first..first + count {
            self.chip.route(number, FUNCTION_PIO0 + block, PAD_OUTPUT_DISABLE, PAD_INPUT_ENABLE)
        }
        self.pio_pins[block as usize] |= mask
        return ok()
    }

    // Give back a PIO block from `pio` once its state machines have been
    // given back to it: its pins are disconnected and the block is held in
    // reset, which forgets its programs.
    pub fn release_pio(&mut self, pio: rp_pio.Pio) {
        block := pio.release()
        pins := self.pio_pins[block as usize]
        self.pio_pins[block as usize] = 0
        self.disconnect(pins)
        self.chip.hold(PIO0 + block)
        self.pio_blocks &= ~(1u32 << block)
    }

    // Give back an I2C bus from `i2c`: its pins are disconnected, still
    // pulled up so the bus stays idle, and its controller held in reset.
    // The pins can then be claimed as GPIOs, for example to clock a stuck
    // device free, and the bus claimed again.
    pub fn release_i2c(&mut self, bus: designware_i2c.Bus) {
        self.stop(bus.release())
    }

    // Give back an I2C target from `i2c_target`, as for `release_i2c`.
    pub fn release_i2c_target(&mut self, target: designware_i2c.TargetBus) {
        self.stop(target.release())
    }

    // Give back an SPI bus from `spi` or `spi_with_select`, as for
    // `release_i2c`.
    pub fn release_spi(&mut self, bus: pl022.Bus) {
        self.stop(bus.release())
    }

    // Give back an SPI target from `spi_target`, as for `release_i2c`.
    pub fn release_spi_target(&mut self, target: pl022.TargetBus) {
        self.stop(target.release())
    }

    // Give back a serial port from `uart` or `uart_flow` once everything
    // written to it is out, as for `release_i2c`: its pins stay pulled up,
    // so the line stays idle.
    pub fn release_uart(&mut self, port: pl011.Port) {
        base := port.release()
        // SAFETY: as for `uart`.
        unsafe {
            for index in 0..2usize {
                if CONSOLES[index] == base {
                    CONSOLES[index] = 0
                }
            }
        }
        self.stop(base)
    }

    // Take `controller` and the pins in `pins`, all or none, then pulse the
    // controller's reset. A reset that does not finish gives both back, so a
    // later attempt can try again.
    fn start(&mut self, controller: u32, pins: u32) -> void!hal.Error {
        if self.buses[controller as usize] != 0 {
            return err(hal.Error.Busy)
        }
        self.reserve(pins)?
        self.buses[controller as usize] = pins
        match self.chip.reset(controller) {
            ok() => {
                return ok()
            }
            err(error) => {
                self.buses[controller as usize] = 0
                self.taken &= ~pins
                return err(error)
            }
        }
    }

    // Disconnect the pins of the controller with registers at `base` and
    // hold it in reset.
    fn stop(&mut self, base: usize) {
        for controller in 0..CONTROLLERS {
            pins := self.buses[controller]
            if pins != 0 && self.chip.base(controller as u32) == base {
                self.disconnect(pins)
                self.chip.hold(controller as u32)
                self.buses[controller] = 0
            }
        }
    }

    fn reserve(&mut self, pins: u32) -> void!hal.Error {
        if (self.taken & pins) != 0 {
            return err(hal.Error.Busy)
        }
        self.taken |= pins
        return ok()
    }

    // Route every pin of `controller`'s bus to `function`.
    fn connect(&mut self, controller: u32, function: u32, clear: u32, set: u32) {
        pins := self.buses[controller as usize]
        for number in 0..PIN_COUNT {
            if (pins & (1u32 << number)) != 0 {
                self.chip.route(number, function, clear, set)
            }
        }
    }

    fn disconnect(&mut self, pins: u32) {
        for number in 0..PIN_COUNT {
            if (pins & (1u32 << number)) != 0 {
                self.chip.route(number, FUNCTION_NULL, 0, 0)
            }
        }
        self.taken &= ~pins
    }
}

// The register blocks of the serial ports a Bank handed out and has not
// taken back, by UART number; 0 for none. Panics are reported on them.
static mut CONSOLES: [2]usize = [0usize; 2]
// Set once a panic report starts, so a failure while reporting halts
// instead of reporting again.
static mut REPORTING: bool = false
// Another console's report, such as rp_usb's, and what the default hook
// does after reporting instead of halting at once.
static mut REPORTER: Option<fn(*const u8, *const u8, u32, u32)> = none
static mut AFTER_REPORT: hal.Handler = hal.NO_HANDLER

// Report panics on another console as well, through `reporter`, called
// as report_panic is, and run `after` once the default panic hook has
// reported, instead of halting at once; `after` should not return. The
// chip packages register the USB serial port here while it is open.
// SAFETY: call with interrupts masked; `reporter` and `after` must be
// safe to call from a panic hook, with interrupts masked for good.
pub unsafe fn set_panic_console(reporter: Option<fn(*const u8, *const u8, u32, u32)>, after: Option<fn()>) {
    unsafe {
        REPORTER = reporter
        match after {
            some(function) => {
                AFTER_REPORT.set(function)
            }
            none => {
                AFTER_REPORT.clear()
            }
        }
    }
}

// The chip runtimes' default panic hook, dodo_board_panic, calls this weak
// symbol, if a program defines it, before it halts. Every program that uses
// std/embedded/chip defines it through this package; it writes nothing
// until a serial port is claimed. With a panic console's `after` (see
// set_panic_console), it does not return.
extern "C" fn dodo_panic_report(check: *const u8, file: *const u8, line: u32, column: u32) {
    // SAFETY: the compiler passes NUL-terminated strings, and the hook
    // halts afterwards.
    unsafe {
        report_panic(check, file, line, column)
        AFTER_REPORT.run()
    }
}

// Write a failed check, as the compiler passes it to a firmware panic hook,
// to every serial port claimed from a Bank and not yet released, and to the
// panic console of set_panic_console, and wait until it is out:
//
//     dodo: arithmetic overflow check failed at /home/me/blink/main.dodo:12:5
//
// the line a desktop program prints, on a line of its own. Only the first
// call reports; a failure while reporting must not report again.
// SAFETY: `check` and `file` must be NUL-terminated, and the caller must
// halt or reset afterwards, as this takes the ports, and the DMA channels,
// from their owners.
pub unsafe fn report_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
    unsafe {
        if REPORTING {
            return
        }
        REPORTING = true
        // A DMA channel may be feeding a port, or writing to memory the
        // report uses.
        rp_dma.stop_all()
        for index in 0..2usize {
            if CONSOLES[index] != 0 {
                registers := hal.RegisterBlock.at(CONSOLES[index])
                write_failure(&mut registers, check, file, line, column)
            }
        }
        match &REPORTER {
            some(reporter) => {
                reporter(check, file, line, column)
            }
            none => {}
        }
    }
}

// Write the report of report_panic to the PL011 with registers R, a value
// with the register block protocol, as its owner configured it.
// SAFETY: `check` and `file` must be NUL-terminated.
pub unsafe fn write_failure<R: hal.Registers>(registers: &mut R, check: *const u8, file: *const u8, line: u32, column: u32) {
    pl011.send(registers, b"\r\ndodo: ")
    unsafe {
        send_text(registers, check)
        pl011.send(registers, b" check failed at ")
        send_text(registers, file)
    }
    pl011.send(registers, b":")
    send_number(registers, line)
    pl011.send(registers, b":")
    send_number(registers, column)
    pl011.send(registers, b"\r\n")
}

// Send a NUL-terminated string, up to its first 1024 bytes.
// SAFETY: `text` must be NUL-terminated.
unsafe fn send_text<R: hal.Registers>(registers: &mut R, text: *const u8) {
    chunk: [32]u8 = [0; 32]
    used := 0usize
    for index in 0..1024isize {
        byte := unsafe {
            ptr.read(ptr.offset(text, index))
        }
        if byte == 0 {
            break
        }
        chunk[used] = byte
        used += 1
        if used == 32 {
            pl011.send(registers, &chunk)
            used = 0
        }
    }
    pl011.send(registers, &chunk[..used])
}

fn send_number<R: hal.Registers>(registers: &mut R, value: u32) {
    digits: [10]u8 = [0; 10]
    position := 10usize
    rest := value
    for {
        position -= 1
        digits[position] = (48 + rest % 10) as u8
        rest = rest / 10
        if rest == 0 {
            break
        }
    }
    pl011.send(registers, &digits[position..])
}
