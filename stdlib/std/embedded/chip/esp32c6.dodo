package esp32c6

import "core/cpu"
import "core/mmio"
import "core/ptr"
import "std/embedded/chip/esp_flash"
import "std/embedded/chip/esp_rng"
import "std/embedded/chip/esp_rtc"
import "std/embedded/chip/esp_watchdog"
import "std/embedded/chip/esp_capture"
import "std/embedded/chip/esp_i2s"
import "std/embedded/executor"
import "std/embedded/hal"
import "std/embedded/hal/serial"
import "std/embedded/peripheral/esp_i2c"
import "std/embedded/peripheral/esp_spi"
import "std/embedded/peripheral/esp_twai"
import "std/embedded/peripheral/esp_uart"
import "std/embedded/peripheral/esp_usb_serial"
import "std/io"

// Espressif ESP32-C6 chip support for its high-performance RISC-V core:
// clocks, GPIO through the IO MUX and GPIO matrix, interrupts, the system
// timer and its alarms, the USB serial port, and the boot ROM; the rest of
// the package adds I2C, SPI, UART, PWM (LEDC), the ADC and temperature
// sensor, DMA, an addressable LED driver (RMT), CAN (TWAI), I2S audio, and
// PWM input capture (MCPWM and PCNT). `take()` brings the chip
// from the state the boot ROM leaves it in to a known configuration and
// hands out the peripherals once. Pins implement the std/embedded/hal output
// and input pin protocols, I2C and SPI buses claimed from `Pins` implement
// the bus protocols, serial ports the std/io Reader and Writer protocols,
// PWM outputs and ADC inputs the PWM output and analog input protocols, CAN
// controllers, I2S streams, and PWM inputs the CAN, I2S, and PWM input
// protocols, and the timer implements the delay protocol, so portable
// drivers use them unchanged.
//
// Applications normally use a board package instead: `import
// "std/embedded/board"` with `board = "esp32c6_devkitc"`, or `import
// "std/embedded/chip"` for a custom ESP32-C6 board with `chip = "esp32c6"`.
//
// Clocks after take(): the CPU at 160 MHz from the 480 MHz PLL, the AHB and
// APB buses at 40 MHz, and the system timer counting at 16 MHz from the
// 40 MHz crystal. Peripherals take their clocks from the crystal or the
// PLL's fixed 80 MHz output, so their rates do not depend on the CPU's. The
// flash keeps the boot ROM's direct boot setup.
//
// The GPIO matrix connects any peripheral signal to any pin, so buses,
// serial ports, and PWM outputs go on any free pins. GPIO 0 to 23 are
// supported. GPIO 24 to 30 connect to the flash on ESP32-C6 modules, and
// GPIO 12 and 13 are the USB serial port's D- and D+, so claiming those is
// refused while the USB serial port works (see USB_PINS). GPIO 8, 9, and 15
// are strapping pins, read at reset: GPIO 9 low starts the boot ROM's
// download mode.
//
// Register names follow the ESP32-C6 technical reference manual.

// The CPU clock after take().
pub const CPU_HZ: u32 = 160_000_000
// The crystal, which the ESP32-C6 requires to be 40 MHz.
pub const XTAL_HZ: u32 = 40_000_000
// The PLL output peripherals use.
pub const PLL_F80M_HZ: u32 = 80_000_000
// GPIO 0 to 23: the pins that are not wired to the flash.
pub const PIN_COUNT: u32 = 24
// GPIO 12 and 13, the USB serial port's D- and D+.
pub const USB_PINS: u32 = (1u32 << 12) | (1u32 << 13)

