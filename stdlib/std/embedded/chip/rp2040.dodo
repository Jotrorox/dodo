package rp2040

import "core/cpu"
import "std/embedded/cortex_m"
import "std/embedded/hal"
import "std/embedded/peripheral/designware_i2c"
import "std/embedded/peripheral/pl011"
import "std/embedded/peripheral/pl022"
import "std/embedded/chip/rp_pins"

// Raspberry Pi RP2040 chip support: clocks, resets, GPIO, I2C, SPI, UART,
// the microsecond timer, and the boot ROM. `take(config)` brings the chip
// from its boot state (ring oscillator, peripherals held in reset) to a known
// configuration and hands out the peripherals once. Pins implement the
// std/embedded/hal output and input pin protocols, I2C and SPI buses claimed
// from `Pins` implement the bus protocols, serial ports the std/io Reader and
// Writer protocols, and the timer implements the delay protocol, so portable
// drivers use them unchanged.
//
// Applications normally use a board package instead, which supplies the
// board's Config and wiring: `import "std/embedded/board"` with
// `board = "pico"`, or `import "std/embedded/chip"` for a custom RP2040 board
// with `chip = "rp2040"`.
//
// Clocks after take(): clk_ref = the crystal, clk_sys = 125 MHz from PLL_SYS,
// clk_peri = clk_sys, and a 1 MHz timer tick. Section numbers below refer to
// the RP2040 datasheet.

// clk_sys, the processor and peripheral clock, after take().
pub const SYS_HZ: u32 = 125_000_000
// User GPIOs 0 to 29.
pub const PIN_COUNT: u32 = 30

// Each register also has atomic XOR, set, and clear aliases (2.1.2).
const SET_ALIAS: usize = 0x2000
const CLEAR_ALIAS: usize = 0x3000

// Resets (2.14). Writing 1 holds a block in reset.
const RESETS_BASE: usize = 0x4000_C000
const RESET: usize = RESETS_BASE + 0x0
const RESET_DONE: usize = RESETS_BASE + 0x8
const RESET_I2C0: u32 = 1 << 3
const RESET_I2C1: u32 = 1 << 4
const RESET_IO_BANK0: u32 = 1 << 5
const RESET_PADS_BANK0: u32 = 1 << 8
const RESET_PLL_SYS: u32 = 1 << 12
const RESET_SPI0: u32 = 1 << 16
const RESET_SPI1: u32 = 1 << 17
const RESET_UART0: u32 = 1 << 22
const RESET_UART1: u32 = 1 << 23
const RESET_TIMER: u32 = 1 << 21

// Crystal oscillator (2.16).
const XOSC_BASE: usize = 0x4002_4000
const XOSC_CTRL: usize = XOSC_BASE + 0x00
const XOSC_STATUS: usize = XOSC_BASE + 0x04
const XOSC_STARTUP: usize = XOSC_BASE + 0x0C
const XOSC_RANGE_1_15MHZ: u32 = 0xAA0
const XOSC_ENABLE: u32 = 0xFAB << 12
const XOSC_STABLE: u32 = 1 << 31

// PLL_SYS (2.18): crystal / REFDIV 1 * FBDIV = 1500 MHz VCO,
// / POSTDIV1 6 / POSTDIV2 2 = 125 MHz.
const VCO_HZ: u32 = 1_500_000_000
const PLL_SYS_BASE: usize = 0x4002_8000
const PLL_CS: usize = PLL_SYS_BASE + 0x0
const PLL_PWR: usize = PLL_SYS_BASE + 0x4
const PLL_FBDIV_INT: usize = PLL_SYS_BASE + 0x8
const PLL_PRIM: usize = PLL_SYS_BASE + 0xC
const PLL_LOCK: u32 = 1 << 31
const PLL_POWER_DOWN: u32 = 1 << 0
const PLL_POSTDIV_POWER_DOWN: u32 = 1 << 3
const PLL_VCO_POWER_DOWN: u32 = 1 << 5
const PLL_POSTDIV1: u32 = 0b111 << 16
const PLL_POSTDIV2: u32 = 0b111 << 12

// Clock generators (2.15).
const CLOCKS_BASE: usize = 0x4000_8000
const CLK_REF_CTRL: usize = CLOCKS_BASE + 0x30
const CLK_REF_DIV: usize = CLOCKS_BASE + 0x34
const CLK_REF_SELECTED: usize = CLOCKS_BASE + 0x38
const CLK_SYS_CTRL: usize = CLOCKS_BASE + 0x3C
const CLK_SYS_DIV: usize = CLOCKS_BASE + 0x40
const CLK_SYS_SELECTED: usize = CLOCKS_BASE + 0x44
const CLK_PERI_CTRL: usize = CLOCKS_BASE + 0x48
const CLK_SYS_RESUS_CTRL: usize = CLOCKS_BASE + 0x78
const CLK_REF_SRC: u32 = 0b11
const CLK_REF_SRC_XOSC: u32 = 2
const CLK_SYS_SRC_AUX: u32 = 1
const CLK_SYS_AUXSRC: u32 = 0b111 << 5
const CLK_ENABLE: u32 = 1 << 11
// Divisors are 24.8 fixed point; 0x100 divides by one.
const DIVIDE_BY_ONE: u32 = 0x100

// The watchdog block generates the timer's 1 MHz tick from clk_ref (4.7).
const WATCHDOG_TICK: usize = 0x4005_8000 + 0x2C
const TICK_ENABLE: u32 = 1 << 9

// Microsecond timer (4.6). The raw registers read without latching.
const TIMER_BASE: usize = 0x4005_4000
const TIMER_RAW_HIGH: usize = TIMER_BASE + 0x24
const TIMER_RAW_LOW: usize = TIMER_BASE + 0x28
// Alarms (4.6.4): ALARMn arms when written and fires when the counter's
// low 32 bits reach it, setting its INTR bit (write one to clear) and, while
// its INTE bit is set, raising its interrupt. ARMED bits disarm when written.
const TIMER_ALARM0: usize = TIMER_BASE + 0x10
const TIMER_ARMED: usize = TIMER_BASE + 0x20
const TIMER_INTR: usize = TIMER_BASE + 0x34
const TIMER_INTE: usize = TIMER_BASE + 0x38
// The longest an alarm sleeps at once: below 2^31 us, so its 32-bit
// target time is still ahead when the write lands.
const MAX_ALARM_SLEEP_US: u64 = 0x7FFF_FFFF
// Alarms 0 to 3, raising TIMER_IRQ_0 + n.
pub const ALARM_COUNT: u32 = 4

// Interrupt numbers (2.3.2), for std/embedded/cortex_m's enable, pend, and
// set_priority. Each is also the vector name of its `@interrupt` handler.
pub const TIMER_IRQ_0: u32 = 0
pub const TIMER_IRQ_1: u32 = 1
pub const TIMER_IRQ_2: u32 = 2
pub const TIMER_IRQ_3: u32 = 3
pub const PWM_IRQ_WRAP: u32 = 4
pub const USBCTRL_IRQ: u32 = 5
pub const XIP_IRQ: u32 = 6
pub const PIO0_IRQ_0: u32 = 7
pub const PIO0_IRQ_1: u32 = 8
pub const PIO1_IRQ_0: u32 = 9
pub const PIO1_IRQ_1: u32 = 10
pub const DMA_IRQ_0: u32 = 11
pub const DMA_IRQ_1: u32 = 12
pub const IO_IRQ_BANK0: u32 = 13
pub const IO_IRQ_QSPI: u32 = 14
pub const SIO_IRQ_PROC0: u32 = 15
pub const SIO_IRQ_PROC1: u32 = 16
pub const CLOCKS_IRQ: u32 = 17
pub const SPI0_IRQ: u32 = 18
pub const SPI1_IRQ: u32 = 19
pub const UART0_IRQ: u32 = 20
pub const UART1_IRQ: u32 = 21
pub const ADC_IRQ_FIFO: u32 = 22
pub const I2C0_IRQ: u32 = 23
pub const I2C1_IRQ: u32 = 24
pub const RTC_IRQ: u32 = 25

// User bank GPIO control (2.19) and pads (2.19.6).
const IO_BANK0_BASE: usize = 0x4001_4000
const PADS_BANK0_BASE: usize = 0x4001_C000
const FUNCSEL: u32 = 0b11111
// GPIO interrupts (2.19.6.2): four bits per pin, eight pins per register.
// INTR latches edges (write one to clear) and shows levels; PROC0_INTE
// selects what raises IO_IRQ_BANK0 on core 0, and PROC0_INTS shows it.
const GPIO_INTR: usize = IO_BANK0_BASE + 0x0F0
const GPIO_PROC0_INTE: usize = IO_BANK0_BASE + 0x100
const GPIO_PROC0_INTS: usize = IO_BANK0_BASE + 0x120

// Pin events for `Pin.listen`, `ignore`, `events`, and `clear_events`:
// the pin's level is low or high, or it fell or rose. Levels last as long
// as the level does; edges stay latched until cleared.
pub const LEVEL_LOW: u32 = 1 << 0
pub const LEVEL_HIGH: u32 = 1 << 1
pub const FALLING_EDGE: u32 = 1 << 2
pub const RISING_EDGE: u32 = 1 << 3
const EDGES: u32 = FALLING_EDGE | RISING_EDGE
const ALL_EVENTS: u32 = 0xF

// I2C (4.3), SPI (4.4), and UART (4.2) controllers, clocked by clk_sys and
// clk_peri.
const I2C0_BASE: usize = 0x4004_4000
const I2C1_BASE: usize = 0x4004_8000
const SPI0_BASE: usize = 0x4003_C000
const SPI1_BASE: usize = 0x4004_0000
const UART0_BASE: usize = 0x4003_4000
const UART1_BASE: usize = 0x4003_8000

// Single-cycle I/O (2.3.1).
const SIO_BASE: usize = 0xD000_0000
const GPIO_IN: usize = SIO_BASE + 0x004
const GPIO_OUT_SET: usize = SIO_BASE + 0x014
const GPIO_OUT_CLR: usize = SIO_BASE + 0x018
const GPIO_OUT_XOR: usize = SIO_BASE + 0x01C
const GPIO_OE_SET: usize = SIO_BASE + 0x024
const GPIO_OE_CLR: usize = SIO_BASE + 0x028

// Polls before a clock or reset is reported as stuck. The slowest wait,
// crystal start-up, takes about 1 ms at the 6 MHz boot clock.
const ATTEMPTS: u32 = 1_000_000

static mut TAKEN: bool = false

// Provided by the compiler's RP2040 firmware runtime.
unsafe extern "C" fn dodo_rp2040_reset_usb_boot(activity_pins: u32, disabled_interfaces: u32)

// Restart into the boot ROM's USB bootloader, as if BOOTSEL were held at
// power-up: the board reappears as the RPI-RP2 drive and accepts new
// firmware, for example from `dodo run`. Pin `activity_led`, if below
// PIN_COUNT, lights while the drive is accessed. Does not return.
pub fn reboot_to_bootloader(activity_led: u32) {
    mask := 0u32
    if activity_led < PIN_COUNT {
        mask = 1u32 << activity_led
    }
    // SAFETY: the ROM routine takes over the chip and never returns, so no
    // peripheral owned by this program is used afterwards.
    unsafe {
        dodo_rp2040_reset_usb_boot(mask, 0)
    }
    for {}
}

// Write a failed check's message to every serial port claimed from
// `pins.uart` and not yet released, as the default panic hook does before it
// halts: `dodo: arithmetic overflow check failed at main.dodo:12:5`. Call it
// from a panic hook of your own that, for example, restarts into the
// bootloader:
//
//     extern "C" fn dodo_board_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
//         unsafe {
//             chip.report_panic(check, file, line, column)
//         }
//         chip.reboot_to_bootloader(25)
//     }
//
// SAFETY: `check` and `file` must be the hook's NUL-terminated strings, and
// the caller must halt or reset afterwards, as this takes over the ports.
pub unsafe fn report_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
    unsafe {
        rp_pins.report_panic(check, file, line, column)
    }
}

// What the circuit board decides. Board packages pass theirs to `take`.
pub struct Config {
    // The crystal on XIN/XOUT, in hertz: 1 to 15 MHz, a whole number of
    // megahertz (for the 1 MHz timer tick) that divides 1.5 GHz (for the
    // PLL). 12 MHz, as on the Raspberry Pi Pico, is the usual choice.
    pub crystal_hz: u32
}

// The chip's peripherals, handed out once by `take`.
pub struct Peripherals {
    pub pins: Pins
    pub timer: Timer
}

// Configure clocks, take GPIO and the timer out of reset, and return the
// peripherals. A second call returns Error.Busy, so no two owners exist; an
// unusable crystal frequency returns Error.InvalidInput, and a crystal or PLL
// that does not start returns Error.Timeout.
pub fn take(config: Config) -> Peripherals!hal.Error {
    crystal := config.crystal_hz
    if crystal < 1_000_000 || crystal > 15_000_000 || crystal % 1_000_000 != 0 || VCO_HZ % crystal != 0 {
        return err(hal.Error.InvalidInput)
    }
    section := hal.Critical.enter()
    // SAFETY: interrupts are masked, so the flag is read and set atomically
    // on this core. Core 1 stays parked in the boot ROM.
    taken := unsafe {
        TAKEN
    }
    unsafe {
        TAKEN = true
    }
    core.drop(section)
    if taken {
        return err(hal.Error.Busy)
    }
    // SAFETY: TAKEN guarantees this runs once, so this code is the only
    // user of the clock, reset, PLL, and watchdog tick registers.
    unsafe {
        start_clocks(crystal)?
        reset_blocks(RESET_IO_BANK0 | RESET_PADS_BANK0 | RESET_TIMER)?
    }
    // SAFETY: the timer was just taken out of reset; Timer only reads its
    // free-running counter registers.
    timer := unsafe {
        Timer { high: hal.Reg.at(TIMER_RAW_HIGH), low: hal.Reg.at(TIMER_RAW_LOW), alarms: 0 }
    }
    // SAFETY: TAKEN guarantees one bank, and Chip is what the bank needs:
    // the GPIOs' control and pad registers and the bus controllers are
    // otherwise unused.
    bank := unsafe {
        rp_pins.Bank.new(Chip {})
    }
    return ok(Peripherals { pins: Pins { bank }, timer })
}

// SAFETY: the caller owns `address`, a 32-bit RP2040 register.
unsafe fn reg(address: usize) -> hal.Reg<u32> {
    unsafe {
        return hal.Reg.at(address)
    }
}

// Pulse the reset of `blocks` and wait until they are running again. The
// set and clear aliases leave every other block alone.
// SAFETY: the caller owns `blocks`.
unsafe fn reset_blocks(blocks: u32) -> void!hal.Error {
    unsafe {
        hold := reg(RESET + SET_ALIAS)
        hold.write(blocks)
        release := reg(RESET + CLEAR_ALIAS)
        release.write(blocks)
        done := reg(RESET_DONE)
        return done.wait_set(blocks, ATTEMPTS)
    }
}

// SAFETY: the caller owns the clock, XOSC, PLL_SYS, and watchdog tick
// registers, and nothing may depend on the current clock rates.
unsafe fn start_clocks(crystal_hz: u32) -> void!hal.Error {
    unsafe {
        resus := reg(CLK_SYS_RESUS_CTRL)
        resus.write(0)

        // Crystal: ~1 ms start-up delay in units of 256 cycles.
        xosc_ctrl := reg(XOSC_CTRL)
        xosc_ctrl.write(XOSC_RANGE_1_15MHZ)
        startup := reg(XOSC_STARTUP)
        startup.write((crystal_hz / 1000 + 128) / 256)
        xosc_ctrl.write(XOSC_RANGE_1_15MHZ | XOSC_ENABLE)
        xosc_status := reg(XOSC_STATUS)
        xosc_status.wait_set(XOSC_STABLE, ATTEMPTS)?

        // Run clk_sys from clk_ref while the PLL is reconfigured.
        sys_ctrl := reg(CLK_SYS_CTRL)
        sys_ctrl.clear_bits(CLK_SYS_SRC_AUX)
        sys_selected := reg(CLK_SYS_SELECTED)
        sys_selected.wait_set(1, ATTEMPTS)?

        reset_blocks(RESET_PLL_SYS)?
        cs := reg(PLL_CS)
        cs.write(1)
        feedback := reg(PLL_FBDIV_INT)
        feedback.write(VCO_HZ / crystal_hz)
        power_on := reg(PLL_PWR + CLEAR_ALIAS)
        power_on.write(PLL_POWER_DOWN | PLL_VCO_POWER_DOWN)
        cs.wait_set(PLL_LOCK, ATTEMPTS)?
        prim := reg(PLL_PRIM)
        prim.write(hal.encode(PLL_POSTDIV1, 6) | hal.encode(PLL_POSTDIV2, 2))
        power_on.write(PLL_POSTDIV_POWER_DOWN)

        // clk_ref from the crystal.
        ref_ctrl := reg(CLK_REF_CTRL)
        ref_ctrl.set(CLK_REF_SRC, CLK_REF_SRC_XOSC)
        ref_selected := reg(CLK_REF_SELECTED)
        ref_selected.wait_set(1 << CLK_REF_SRC_XOSC, ATTEMPTS)?
        ref_div := reg(CLK_REF_DIV)
        ref_div.write(DIVIDE_BY_ONE)

        // clk_sys from PLL_SYS (aux source 0) through the glitchless mux.
        sys_ctrl.clear_bits(CLK_SYS_AUXSRC)
        sys_div := reg(CLK_SYS_DIV)
        sys_div.write(DIVIDE_BY_ONE)
        sys_ctrl.set_bits(CLK_SYS_SRC_AUX)
        sys_selected.wait_set(1 << 1, ATTEMPTS)?

        // clk_peri from clk_sys (aux source 0), for UART and SPI.
        peri := reg(CLK_PERI_CTRL)
        peri.write(0)
        peri.write(CLK_ENABLE)

        // 1 MHz tick for the timer, derived from clk_ref.
        tick := reg(WATCHDOG_TICK)
        tick.write(TICK_ENABLE | crystal_hz / 1_000_000)
        return ok()
    }
}

// The 30 user GPIOs, and the I2C, SPI, and UART controllers that use them.
// Each pin and each controller can be taken once, and given back.
pub struct Pins {
    bank: rp_pins.Bank<Chip>

    // Claim pin `number` as a push-pull output, initially low.
    pub fn output(&mut self, number: u32) -> Pin!hal.Error {
        pin := self.claim(number)?
        pin.set_low()
        pin.set_as_output()
        return ok(pin)
    }

    // Claim pin `number` as an input.
    pub fn input(&mut self, number: u32) -> Pin!hal.Error {
        pin := self.claim(number)?
        pin.set_as_input()
        return ok(pin)
    }

    // Give back a pin from `output` or `input`. It stops driving and is
    // disconnected until claimed again, for example as part of a bus.
    pub fn release(&mut self, pin: Pin) {
        pin.ignore(ALL_EVENTS)
        pin.clear_events(ALL_EVENTS)
        pin.set_as_input()
        self.bank.release_gpio(pin.mask)
    }

    // Claim pins `sda` and `scl` as an I2C bus with an SCL frequency of
    // `frequency_hz`, at most hal.I2C_FAST_PLUS_HZ. Even pins carry SDA and
    // odd pins SCL. GPIO 0 and 1, 4 and 5, and so on in steps of four belong
    // to I2C0; GPIO 2 and 3, 6 and 7, and so on to I2C1. InvalidInput if the
    // two pins cannot form a bus or the frequency is out of range, Busy if a
    // pin or the controller is taken. The pads' own pull-ups (about 50 kOhm)
    // keep an idle bus high but are too weak for fast mode: most sensor
    // boards add 4.7 kOhm pull-ups, and a bare bus needs them. The
    // designware_i2c driver documents the bus's errors.
    pub fn i2c(&mut self, sda: u32, scl: u32, frequency_hz: u32) -> designware_i2c.Bus!hal.Error {
        return self.bank.i2c(sda, scl, frequency_hz)
    }

    // Claim pins as an SPI bus in `mode`, clocked at the fastest rate up to
    // `frequency_hz` (at most SYS_HZ / 2, 62.5 MHz): `clock` (SCK), `tx`
    // (data out to the devices, MOSI), and `rx` (data in from them, MISO),
    // or none when they only listen. GPIO n carries RX when n % 4 is 0, the
    // clock when it is 2, and TX when it is 3. GPIO 0 to 7 and 16 to 23
    // belong to SPI0, GPIO 8 to 15 and 24 to 29 to SPI1. Give each device
    // an output pin as its chip select, through hal.SpiDevice. Errors as for
    // `i2c`.
    pub fn spi(&mut self, clock: u32, tx: u32, rx: Option<u32>, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        return self.bank.spi(clock, tx, rx, mode, frequency_hz)
    }

    // Claim pin `tx` as a serial port's transmit line (to the other end's
    // RX), and `rx` as its receive line, or none to only send. Frames are
    // 8N1 at the rate closest to `baud`, from 120 baud up to SYS_HZ / 16
    // (7.8 Mbaud); 115_200 is the usual choice for a terminal. GPIO n
    // carries TX when n % 4 is 0 and RX when it is 1: UART0 has TX on 0,
    // 12, 16, and 28 and RX on 1, 13, 17, and 29, UART1 TX on 4, 8, 20, and
    // 24 and RX on 5, 9, 21, and 25. The port implements the std/io Reader
    // and Writer protocols, so std/fmt prints to it; until it is released,
    // a panic writes its failure message to it before the chip halts.
    // InvalidInput if the pins cannot form a port or the baud rate is out
    // of range, Busy if a pin or the controller is taken. The pl011 driver
    // documents the port.
    pub fn uart(&mut self, tx: u32, rx: Option<u32>, baud: u32) -> pl011.Port!hal.Error {
        return self.bank.uart(tx, rx, baud)
    }

    // `uart` with hardware flow control, turned on: `cts` is an input, low
    // while the other end may receive, and `rts` an output, low while this
    // port may. GPIO n carries CTS when n % 4 is 2 and RTS when it is 3, in
    // the TX and RX pins' group of four: UART0 has CTS on 2, 14, 18 and RTS
    // on 3, 15, 19, UART1 CTS on 6, 10, 22, 26 and RTS on 7, 11, 23, 27.
    // Errors as for `uart`.
    pub fn uart_flow(&mut self, tx: u32, rx: u32, cts: u32, rts: u32, baud: u32) -> pl011.Port!hal.Error {
        return self.bank.uart_flow(tx, rx, cts, rts, baud)
    }

    // `spi` with the controller's own chip select on pin `select` as well,
    // for devices in the TI and Microwire frame formats (see
    // pl022.FrameFormat), which need its timing. GPIO n carries it when
    // n % 4 is 1, in the bus's block of eight: SPI0 on 1, 5, 17, 21, SPI1
    // on 9, 13, 25, 29. Errors as for `spi`.
    pub fn spi_with_select(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode, frequency_hz: u32) -> pl022.Bus!hal.Error {
        return self.bank.spi_with_select(clock, tx, rx, select, mode, frequency_hz)
    }

    // Claim pins as an SPI target (slave) in `mode`, for another master to
    // clock, at up to SYS_HZ / 12 (10.4 MHz), and select: `rx` receives
    // what it sends, `tx` answers, and the pins are numbered as for `spi`
    // and `spi_with_select`. The pl022 driver documents the target.
    pub fn spi_target(&mut self, clock: u32, tx: u32, rx: Option<u32>, select: u32, mode: hal.SpiMode) -> pl022.TargetBus!hal.Error {
        return self.bank.spi_target(clock, tx, rx, select, mode)
    }

    // Claim pins `sda` and `scl`, numbered as for `i2c`, as an I2C target
    // (slave) answering another master at `address`, a 10-bit address with
    // `ten_bit`. `frequency_hz` is the master's SCL frequency, which sets
    // the input filter. InvalidInput for an address the I2C specification
    // reserves (7-bit 0x00 to 0x07 and 0x78 to 0x7F), otherwise errors as
    // for `i2c`. The designware_i2c driver documents the target.
    pub fn i2c_target(&mut self, sda: u32, scl: u32, address: u16, ten_bit: bool, frequency_hz: u32) -> designware_i2c.TargetBus!hal.Error {
        return self.bank.i2c_target(sda, scl, address, ten_bit, frequency_hz)
    }

    // Give back an I2C bus. Its controller is held in reset and its pins are
    // disconnected but still pulled up, so the bus stays idle. A device that
    // holds SDA low after an interrupted transfer, which makes the bus
    // Timeout, can then be freed by claiming SCL as an output and clocking
    // it by hand before claiming the bus again.
    pub fn release_i2c(&mut self, bus: designware_i2c.Bus) {
        self.bank.release_i2c(bus)
    }

    // Give back an SPI bus: its controller is held in reset and its pins
    // are disconnected.
    pub fn release_spi(&mut self, bus: pl022.Bus) {
        self.bank.release_spi(bus)
    }

    // Give back a serial port, once everything written to it is out: its
    // controller is held in reset and its pins are disconnected but still
    // pulled up, so the line stays idle.
    pub fn release_uart(&mut self, port: pl011.Port) {
        self.bank.release_uart(port)
    }

    // Give back an I2C target, as for `release_i2c`.
    pub fn release_i2c_target(&mut self, target: designware_i2c.TargetBus) {
        self.bank.release_i2c_target(target)
    }

    // Give back an SPI target, as for `release_spi`.
    pub fn release_spi_target(&mut self, target: pl022.TargetBus) {
        self.bank.release_spi_target(target)
    }

    fn claim(&mut self, number: u32) -> Pin!hal.Error {
        mask := self.bank.gpio(number)?
        group := 4 * (number / 8) as usize
        // SAFETY: the bank makes this pin's control and pad registers
        // exclusive to the returned Pin. The SIO output SET/CLR/XOR and
        // output-enable SET/CLR registers are write-only per-bit aliases and IN
        // is read-only, so pins never conflict there. Likewise the pin writes
        // only its own bits of the shared interrupt registers, through the
        // write-one-to-clear INTR and the INTE set and clear aliases, and
        // INTS is read-only.
        unsafe {
            return ok(Pin {
                set: reg(GPIO_OUT_SET),
                clear: reg(GPIO_OUT_CLR),
                toggle: reg(GPIO_OUT_XOR),
                input: reg(GPIO_IN),
                output_enable: reg(GPIO_OE_SET),
                output_disable: reg(GPIO_OE_CLR),
                mask,
                raw_events: reg(GPIO_INTR + group),
                listen_set: reg(GPIO_PROC0_INTE + group + SET_ALIAS),
                listen_clear: reg(GPIO_PROC0_INTE + group + CLEAR_ALIAS),
                status: reg(GPIO_PROC0_INTS + group),
                shift: 4 * (number % 8),
            })
        }
    }
}

// What rp_pins.Bank needs from this chip. Only the Bank in Pins has one.
struct Chip {
    pub fn route(&mut self, number: u32, function: u32, clear: u32, set: u32) {
        // SAFETY: the bank routes only pins it holds.
        unsafe {
            route(number, function, clear, set)
        }
    }

    pub fn reset(&mut self, controller: u32) -> void!hal.Error {
        // SAFETY: the bank resets only controllers it holds. The reset alias
        // registers change only their bits.
        unsafe {
            return reset_blocks(controller_reset(controller))
        }
    }

    pub fn hold(&mut self, controller: u32) {
        // SAFETY: as for `reset`.
        unsafe {
            hold := reg(RESET + SET_ALIAS)
            hold.write(controller_reset(controller))
        }
    }

    pub fn base(&self, controller: u32) -> usize {
        if controller == rp_pins.I2C0 {
            return I2C0_BASE
        } else if controller == rp_pins.I2C1 {
            return I2C1_BASE
        } else if controller == rp_pins.SPI0 {
            return SPI0_BASE
        } else if controller == rp_pins.SPI1 {
            return SPI1_BASE
        } else if controller == rp_pins.UART0 {
            return UART0_BASE
        }
        return UART1_BASE
    }

    pub fn clock_hz(&self) -> u32 {
        return SYS_HZ
    }

    pub fn uart_aux(&self) -> bool {
        return false
    }
}

// The RESET_ bit of rp_pins controller number `controller`.
fn controller_reset(controller: u32) -> u32 {
    if controller == rp_pins.I2C0 {
        return RESET_I2C0
    } else if controller == rp_pins.I2C1 {
        return RESET_I2C1
    } else if controller == rp_pins.SPI0 {
        return RESET_SPI0
    } else if controller == rp_pins.SPI1 {
        return RESET_SPI1
    } else if controller == rp_pins.UART0 {
        return RESET_UART0
    }
    return RESET_UART1
}

// Connect GPIO `number` to peripheral `function`, and change its pad
// settings: clear the `clear` bits, then set the `set` bits.
// SAFETY: the caller owns the pin's control and pad registers.
unsafe fn route(number: u32, function: u32, clear: u32, set: u32) {
    index := number as usize
    unsafe {
        control := reg(IO_BANK0_BASE + 8 * index + 4)
        control.set(FUNCSEL, function)
        pad := reg(PADS_BANK0_BASE + 4 + 4 * index)
        pad.modify(clear, set)
    }
}

// One GPIO driven by the single-cycle I/O block. Implements the
// std/embedded/hal output and input pin protocols.
pub struct Pin {
    set: hal.Reg<u32>
    clear: hal.Reg<u32>
    toggle: hal.Reg<u32>
    input: hal.Reg<u32>
    output_enable: hal.Reg<u32>
    output_disable: hal.Reg<u32>
    mask: u32
    // This pin's interrupt bits: raw events, core 0's enables through the
    // set and clear aliases, and core 0's status, at `shift`.
    raw_events: hal.Reg<u32>
    listen_set: hal.Reg<u32>
    listen_clear: hal.Reg<u32>
    status: hal.Reg<u32>
    shift: u32

    pub fn set_high(&mut self) {
        self.set.write(self.mask)
    }

    pub fn set_low(&mut self) {
        self.clear.write(self.mask)
    }

    pub fn toggle(&mut self) {
        self.toggle.write(self.mask)
    }

    pub fn is_high(&self) -> bool {
        return self.input.any(self.mask)
    }

    // Drive the pin at its output level, for a line that changes direction
    // such as a half-duplex data line. Pins claimed as inputs start released.
    pub fn set_as_output(&mut self) {
        self.output_enable.write(self.mask)
    }

    // Release the pin so another device can drive it; is_high reads it.
    pub fn set_as_input(&mut self) {
        self.output_disable.write(self.mask)
    }

    // Raise IO_IRQ_BANK0 on `events`, any of LEVEL_LOW, LEVEL_HIGH,
    // FALLING_EDGE, and RISING_EDGE, after forgetting edges seen so far.
    // Enable the interrupt in the NVIC too: `cortex_m.enable(pin.irq())`.
    // Every pin shares the one interrupt; its handler tells them apart with
    // `events`.
    pub fn listen(&mut self, events: u32) {
        self.clear_events(events)
        self.listen_set.write((events & ALL_EVENTS) << self.shift)
    }

    // Stop raising the interrupt on `events`.
    pub fn ignore(&mut self, events: u32) {
        self.listen_clear.write((events & ALL_EVENTS) << self.shift)
    }

    // The listened-to events that are raising the interrupt now.
    pub fn events(&self) -> u32 {
        return (self.status.read() >> self.shift) & ALL_EVENTS
    }

    // Forget the edges among `events`, acknowledging them; a handler or
    // task must, or the interrupt stays raised. Levels cannot be cleared.
    pub fn clear_events(&mut self, events: u32) {
        self.raw_events.write((events & EDGES) << self.shift)
    }

    // The interrupt pin events raise, IO_IRQ_BANK0, for cortex_m.enable.
    pub fn irq(&self) -> u32 {
        return IO_IRQ_BANK0
    }
}

// The free-running 64-bit microsecond counter. Implements the std/embedded/hal
// delay protocol.
pub struct Timer {
    high: hal.Reg<u32>
    low: hal.Reg<u32>
    // Claimed alarms, one bit each.
    alarms: u32

    // Claim alarm 0 to 3, to run code at a set time from its interrupt.
    // Busy if it is claimed already; InvalidInput for another number.
    pub fn alarm(&mut self, number: u32) -> Alarm!hal.Error {
        if number >= ALARM_COUNT {
            return err(hal.Error.InvalidInput)
        }
        bit := 1u32 << number
        if (self.alarms & bit) != 0 {
            return err(hal.Error.Busy)
        }
        self.alarms |= bit
        // SAFETY: the claim above makes this the only Alarm for `number`.
        // It writes only its own ALARMn register and, through the
        // write-one-to-clear registers and the atomic set and clear
        // aliases, only its own bit of the shared ones.
        alarm := unsafe {
            Alarm {
                number,
                bit,
                target: hal.Reg.at(TIMER_ALARM0 + 4 * number as usize),
                high: hal.Reg.at(TIMER_RAW_HIGH),
                low: hal.Reg.at(TIMER_RAW_LOW),
                armed: hal.Reg.at(TIMER_ARMED),
                raw: hal.Reg.at(TIMER_INTR),
                listening: hal.Reg.at(TIMER_INTE),
                listen_set: hal.Reg.at(TIMER_INTE + SET_ALIAS),
                listen_clear: hal.Reg.at(TIMER_INTE + CLEAR_ALIAS),
            }
        }
        return ok(alarm)
    }

    // Disarm an alarm, stop its interrupt, and take it back.
    pub fn release_alarm(&mut self, alarm: Alarm) {
        alarm.cancel()
        alarm.ignore()
        alarm.clear()
        self.alarms &= ~alarm.bit
    }

    // Microseconds since take().
    pub fn now_us(&self) -> u64 {
        for {
            high := self.high.read()
            low := self.low.read()
            if self.high.read() == high {
                return ((high as u64) << 32) | low as u64
            }
        }
    }

    pub fn delay_us(&mut self, microseconds: u32) {
        start := self.low.read()
        for core.wrapping_sub(self.low.read(), start) < microseconds {}
    }

    pub fn delay_ms(&mut self, milliseconds: u32) {
        end := self.now_us() + (milliseconds as u64) * 1000
        for self.now_us() < end {}
    }
}

// One of the timer's four alarms, claimed with `Timer.alarm(n)`. An alarm
// fires once when the microsecond counter reaches the time it was given;
// with `listen` it raises interrupt TIMER_IRQ_0 + n, whose handler calls
// `clear` and may schedule the next time. Move it into a
// `static mut Option<Alarm>` for the handler to use.
pub struct Alarm {
    number: u32
    bit: u32
    target: hal.Reg<u32>
    high: hal.Reg<u32>
    low: hal.Reg<u32>
    armed: hal.Reg<u32>
    raw: hal.Reg<u32>
    listening: hal.Reg<u32>
    listen_set: hal.Reg<u32>
    listen_clear: hal.Reg<u32>

    // 0 to 3.
    pub fn number(&self) -> u32 {
        return self.number
    }

    // The interrupt the alarm raises: its number for cortex_m.enable, and
    // its vector name, TIMER_IRQ_0 + n, for `@interrupt`.
    pub fn irq(&self) -> u32 {
        return TIMER_IRQ_0 + self.number
    }

    // The low 32 bits of the microsecond counter, which alarm times use.
    pub fn now(&self) -> u32 {
        return self.low.read()
    }

    // Fire when the counter's low 32 bits equal `time`, replacing any
    // earlier time. A time that has just passed fires only after the
    // counter wraps, 71.6 minutes later.
    pub fn schedule_at(&mut self, time: u32) {
        self.target.write(time)
    }

    // Fire `microseconds` from now; at least 1, and below 2^31 so the time
    // is still ahead when the write lands.
    pub fn schedule_in(&mut self, microseconds: u32) {
        self.target.write(core.wrapping_add(self.low.read(), microseconds))
    }

    // Disarm: a scheduled time no longer fires.
    pub fn cancel(&mut self) {
        self.armed.write(self.bit)
    }

    // True from scheduling until it fires or is cancelled.
    pub fn is_armed(&self) -> bool {
        return self.armed.any(self.bit)
    }

    // True once it has fired, until `clear`.
    pub fn fired(&self) -> bool {
        return self.raw.any(self.bit)
    }

    // Acknowledge that it fired. An interrupt handler has to, or the
    // interrupt stays raised and the handler runs again at once.
    pub fn clear(&mut self) {
        self.raw.write(self.bit)
    }

    // Raise the interrupt when it fires. Enable the interrupt in the NVIC
    // too: `cortex_m.enable(alarm.irq())`.
    pub fn listen(&mut self) {
        self.listen_set.write(self.bit)
    }

    // Stop raising the interrupt; `fired` still reports.
    pub fn ignore(&mut self) {
        self.listen_clear.write(self.bit)
    }

    pub fn is_listening(&self) -> bool {
        return self.listening.any(self.bit)
    }

    // Microseconds since take(), from the whole 64-bit counter, as
    // Timer.now_us reads it.
    pub fn now_us(&self) -> u64 {
        for {
            high := self.high.read()
            low := self.low.read()
            if self.high.read() == high {
                return ((high as u64) << 32) | low as u64
            }
        }
    }

    // Sleep (`wfi`) until an interrupt is pending or the counter reaches
    // `deadline`, a now_us time; none waits for an interrupt only. With
    // now_us this is the std/embedded/executor clock, so an alarm runs an
    // executor: `executor.run(&mut tasks, &mut alarm)`. The alarm's
    // interrupt ends the sleep while interrupts are masked and is cleared
    // before they are unmasked, so it needs no `@interrupt` handler; other
    // interrupts' handlers run after the return, or once the caller's own
    // critical section ends. Times more than 35 minutes ahead wake early.
    // Leaves the alarm disarmed and not listening.
    pub fn sleep_until(&mut self, deadline: Option<u64>) {
        section := hal.Critical.enter()
        if let some(time) = deadline {
            now := self.now_us()
            if time > now {
                ahead := time - now
                if ahead > MAX_ALARM_SLEEP_US {
                    ahead = MAX_ALARM_SLEEP_US
                }
                irq := self.irq()
                self.clear()
                cortex_m.unpend(irq)
                self.listen()
                cortex_m.enable(irq)
                self.schedule_at(core.wrapping_add((now & 0xFFFF_FFFF) as u32, ahead as u32))
                // A time that passed before the alarm was armed would only
                // fire once the counter wraps. One that passes after it
                // makes the interrupt pending, which ends the sleep at once.
                if self.now_us() < now + ahead {
                    cpu.wait_for_interrupt()
                }
                self.cancel()
                self.ignore()
                self.clear()
                cortex_m.disable(irq)
                cortex_m.unpend(irq)
            }
        } else {
            cpu.wait_for_interrupt()
        }
        core.drop(section)
    }
}
