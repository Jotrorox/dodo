package fake

import "core/option"
import "std/embedded/executor"
import "std/embedded/hal"
import "std/embedded/power"
import "std/io"

// In-memory devices implementing the `std/embedded/hal` protocols. They let
// driver code run under `dodo test` on a desktop with no hardware attached, and
// record what the driver did so tests can assert on it.

// An output and input pin. It starts low.
pub struct Pin {
    high: bool
    changes: u32

    pub fn new() -> Pin {
        return Pin { high: false, changes: 0 }
    }

    pub fn set_high(&mut self) {
        if !self.high {
            self.changes += 1
        }
        self.high = true
    }

    pub fn set_low(&mut self) {
        if self.high {
            self.changes += 1
        }
        self.high = false
    }

    pub fn is_high(&self) -> bool {
        return self.high
    }

    // Number of level changes so far, for example 2 per blink.
    pub fn changes(&self) -> u32 {
        return self.changes
    }
}

// A delay that returns immediately and adds up the requested time.
pub struct Delay {
    elapsed: u64

    pub fn new() -> Delay {
        return Delay { elapsed: 0 }
    }

    pub fn delay_us(&mut self, microseconds: u32) {
        self.elapsed += microseconds as u64
    }

    pub fn elapsed_us(&self) -> u64 {
        return self.elapsed
    }
}

// One I2C device with 256 numbered 8-bit registers, the layout used by most
// sensors. A write sets the register pointer from its first byte and stores
// any following bytes at successive registers; a read continues from the
// pointer. Other addresses report NoAcknowledge.
pub struct I2c {
    address: u8
    registers: [256]u8
    pointer: u8
    failure: Option<hal.Error>

    pub fn new(address: u8) -> I2c {
        return I2c { address, registers: [0; 256], pointer: 0, failure: none }
    }

    pub fn register(&self, index: u8) -> u8 {
        return self.registers[index as usize]
    }

    pub fn set_register(&mut self, index: u8, value: u8) {
        self.registers[index as usize] = value
    }

    // Make the next transaction fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    fn begin(&mut self, address: u8) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if address != self.address {
            return err(hal.Error.NoAcknowledge)
        }
        return ok()
    }

    pub fn write(&mut self, address: u8, bytes: &[u8]) -> void!hal.Error {
        self.begin(address)?
        if bytes.len == 0 {
            return ok()
        }
        self.pointer = bytes[0]
        for index in 1..bytes.len {
            self.registers[self.pointer as usize] = bytes[index]
            self.pointer = core.wrapping_add(self.pointer, 1)
        }
        return ok()
    }

    pub fn read(&mut self, address: u8, buffer: &mut[u8]) -> void!hal.Error {
        self.begin(address)?
        for index in 0..buffer.len {
            buffer[index] = self.registers[self.pointer as usize]
            self.pointer = core.wrapping_add(self.pointer, 1)
        }
        return ok()
    }

    pub fn write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        self.write(address, bytes)?
        return self.read(address, buffer)
    }
}

// An SPI bus that records the most recent 64 bytes sent and answers each
// byte from a programmed reply, then with zeros.
pub struct Spi {
    sent: [64]u8
    sent_length: usize
    reply: [64]u8
    reply_length: usize
    reply_position: usize

    pub fn new() -> Spi {
        return Spi { sent: [0; 64], sent_length: 0, reply: [0; 64], reply_length: 0, reply_position: 0 }
    }

    // Bytes the device answers with, in order. At most 64.
    pub fn reply_with(&mut self, bytes: &[u8]) {
        core.assert(bytes.len <= 64)
        for index in 0..bytes.len {
            self.reply[index] = bytes[index]
        }
        self.reply_length = bytes.len
        self.reply_position = 0
    }

    // Bytes sent since the last call to `clear`, up to the first 64.
    pub fn sent(&self) -> &[u8] {
        return self.sent[0..self.sent_length]
    }

    pub fn clear(&mut self) {
        self.sent_length = 0
    }

    fn exchange(&mut self, byte: u8) -> u8 {
        if self.sent_length < 64 {
            self.sent[self.sent_length] = byte
            self.sent_length += 1
        }
        if self.reply_position < self.reply_length {
            answer := self.reply[self.reply_position]
            self.reply_position += 1
            return answer
        }
        return 0
    }

    pub fn transfer(&mut self, bytes: &mut[u8]) -> void!hal.Error {
        for index in 0..bytes.len {
            bytes[index] = self.exchange(bytes[index])
        }
        return ok()
    }

    pub fn write(&mut self, bytes: &[u8]) -> void!hal.Error {
        for index in 0..bytes.len {
            self.exchange(bytes[index])
        }
        return ok()
    }
}

// A PWM output that remembers its duty. It starts at 0, low.
pub struct Pwm {
    max: u16
    duty: u16
    changes: u32
    failure: Option<hal.Error>

    // An output whose duty runs from 0 to `max_duty`, at least 1.
    pub fn new(max_duty: u16) -> Pwm {
        core.assert(max_duty != 0)
        return Pwm { max: max_duty, duty: 0, changes: 0, failure: none }
    }

    pub fn max_duty(&self) -> u16 {
        return self.max
    }

    pub fn set_duty(&mut self, duty: u16) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if duty > self.max {
            return err(hal.Error.InvalidInput)
        }
        self.duty = duty
        self.changes += 1
        return ok()
    }

    // The duty last set.
    pub fn duty(&self) -> u16 {
        return self.duty
    }

    // The number of duties set so far.
    pub fn changes(&self) -> u32 {
        return self.changes
    }

    // Make the next set_duty fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }
}

// An analog input that reads the value given to `set`, at first 0, or the
// values given to `queue`, one per read, before that.
pub struct Analog {
    max: u16
    value: u16
    queued: [32]u16
    queued_length: usize
    queued_position: usize
    reads: u32
    failure: Option<hal.Error>

    // An input whose values run from 0 to `max_value`, such as 4095 for a
    // 12-bit converter.
    pub fn new(max_value: u16) -> Analog {
        return Analog { max: max_value, value: 0, queued: [0u16; 32], queued_length: 0, queued_position: 0, reads: 0, failure: none }
    }

    pub fn max_value(&self) -> u16 {
        return self.max
    }

    // Read `value` from now on, once queued values are used up. Traps if it
    // is above max_value.
    pub fn set(&mut self, value: u16) {
        core.assert(value <= self.max)
        self.value = value
    }

    // Values for the next reads to return in order, after any still
    // unread, before the one given to `set`. At most 32 can wait at once.
    pub fn queue(&mut self, values: &[u16]) {
        unread := self.queued_length - self.queued_position
        core.assert(unread + values.len <= 32)
        for index in 0..unread {
            self.queued[index] = self.queued[self.queued_position + index]
        }
        for index in 0..values.len {
            core.assert(values[index] <= self.max)
            self.queued[unread + index] = values[index]
        }
        self.queued_position = 0
        self.queued_length = unread + values.len
    }

    pub fn read(&mut self) -> u16!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        self.reads += 1
        if self.queued_position < self.queued_length {
            value := self.queued[self.queued_position]
            self.queued_position += 1
            return ok(value)
        }
        return ok(self.value)
    }

    // The number of successful reads so far.
    pub fn reads(&self) -> u32 {
        return self.reads
    }

    // Make the next read fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }
}

// A serial port that records the most recent 256 bytes written and reads
// back bytes given to `feed`, as if they had arrived on its receive line;
// once they are read, reads report end of input. Implements the std/io
// Reader and Writer protocols like the chips' serial ports, so drivers for
// devices on a UART, and std/fmt output, can be tested on a desktop.
pub struct Serial {
    sent: [256]u8
    sent_length: usize
    input: [256]u8
    input_length: usize
    input_position: usize

    pub fn new() -> Serial {
        return Serial { sent: [0; 256], sent_length: 0, input: [0; 256], input_length: 0, input_position: 0 }
    }

    // Bytes for reads to return, after any still unread. At most 256 can
    // wait at once.
    pub fn feed(&mut self, bytes: &[u8]) {
        unread := self.input_length - self.input_position
        core.assert(unread + bytes.len <= 256)
        for index in 0..unread {
            self.input[index] = self.input[self.input_position + index]
        }
        for index in 0..bytes.len {
            self.input[unread + index] = bytes[index]
        }
        self.input_position = 0
        self.input_length = unread + bytes.len
    }

    // Bytes written since the last call to `clear`, up to the first 256.
    pub fn sent(&self) -> &[u8] {
        return self.sent[0..self.sent_length]
    }

    pub fn clear(&mut self) {
        self.sent_length = 0
    }

    pub fn write(&mut self, bytes: &[u8]) -> usize!io.Error {
        for index in 0..bytes.len {
            if self.sent_length < 256 {
                self.sent[self.sent_length] = bytes[index]
                self.sent_length += 1
            }
        }
        return ok(bytes.len)
    }

    pub fn read(&mut self, buffer: &mut[u8]) -> usize!io.Error {
        count := 0usize
        for count < buffer.len && self.input_position < self.input_length {
            buffer[count] = self.input[self.input_position]
            self.input_position += 1
            count += 1
        }
        return ok(count)
    }

    // The polling read of the chips' serial ports: what has been fed and
    // not read yet, up to `buffer.len`, or Pending while nothing is
    // waiting, as on a UART, rather than end of input.
    pub fn poll_read(&mut self, buffer: &mut[u8]) -> io.Poll!io.Error {
        count := self.read(buffer)?
        state := io.PollState.Ready
        if count == 0 && buffer.len != 0 {
            state = io.PollState.Pending
        }
        return ok(io.Poll { transferred: count, state })
    }
}

// A simulated clock for running std/embedded/executor tasks on a desktop.
// Time stands still while tasks run and jumps forward when the executor
// sleeps, to the time it asked for or to the next simulated interrupt,
// whichever comes first. A simulated interrupt raises its signal at its
// time, as a handler would, so tasks waiting for hardware events are tested
// without hardware. A sleep that nothing could end, with no time and no
// interrupt to come, traps instead of hanging the test.
pub struct Clock {
    now: u64
    sleeps: u32
    idle: u64
    // Simulated interrupts: their times and signal ids, unordered.
    times: [16]u64
    signals: [16]u32
    scheduled: usize

    // A clock at time 0 with no interrupts to come.
    pub fn new() -> Clock {
        return Clock { now: 0, sleeps: 0, idle: 0, times: [0u64; 16], signals: [0u32; 16], scheduled: 0 }
    }

    pub fn now_us(&self) -> u64 {
        return self.now
    }

    // Raise `signal` when the time reaches `time_us`, as an interrupt
    // handler would; at most 16 can be waiting. A time already past raises
    // it at the next sleep or advance.
    pub fn interrupt_at(&mut self, time_us: u64, signal: &executor.Signal) {
        core.assert(self.scheduled < 16)
        self.times[self.scheduled] = time_us
        self.signals[self.scheduled] = signal.id
        self.scheduled += 1
    }

    // Let `microseconds` pass, as if a task were busy for that long, and
    // raise the signals of interrupts that fall within it.
    pub fn advance(&mut self, microseconds: u64) {
        self.now += microseconds
        self.fire()
    }

    // The executor's sleep: see the type's comment.
    pub fn sleep_until(&mut self, deadline: Option<u64>) {
        self.sleeps += 1
        start := self.now
        target := 0xFFFF_FFFF_FFFF_FFFFu64
        if let some(time) = deadline {
            target = time
        }
        for index in 0..self.scheduled {
            if self.times[index] < target {
                target = self.times[index]
            }
        }
        // Nothing would ever end this sleep.
        core.assert(target != 0xFFFF_FFFF_FFFF_FFFFu64)
        if target > self.now {
            self.now = target
        }
        self.idle += self.now - start
        self.fire()
    }

    // How many times the executor slept, and for how long in all.
    pub fn sleeps(&self) -> u32 {
        return self.sleeps
    }

    pub fn idle_us(&self) -> u64 {
        return self.idle
    }

    // Raise the signals of interrupts that are due, and forget them.
    fn fire(&mut self) {
        index := 0usize
        for index < self.scheduled {
            if self.times[index] <= self.now {
                signal := executor.Signal { id: self.signals[index] }
                signal.raise()
                self.scheduled -= 1
                self.times[index] = self.times[self.scheduled]
                self.signals[index] = self.signals[self.scheduled]
            } else {
                index += 1
            }
        }
    }
}

// A chip's low-power controls in memory, implementing std/embedded/power's
// protocol. Every clock starts running, awake and in deep sleep. The test
// says which clocks the simulated program cannot run without, which ones
// the simulated chip manages for peripherals, and which of those are
// claimed, and the fake records the sleeps and dormant states the code
// under test asks for. A dormant state ends on the pins given to
// `wake_next_dormant`; one that nothing could end traps instead of
// hanging the test.
pub struct Power {
    deep: bool
    enabled: u64
    sleeping: u64
    essential: u64
    managed: u64
    claimed: u64
    light_sleeps: u32
    deep_sleeps: u32
    dormant_states: u32
    // The pins and events that end the next dormant state.
    wake_pins: u64
    // The events the last dormant state waited for, per pin.
    requested: [64]u8

    // Clocks 0 to 63 all exist. `essential` cannot be disabled, and
    // `managed` belong to peripherals, which disable_unused_clocks stops
    // unless claimed.
    pub fn new(essential: power.Clocks, managed: power.Clocks) -> Power {
        return Power {
            deep: false,
            enabled: 0xFFFF_FFFF_FFFF_FFFFu64,
            sleeping: 0xFFFF_FFFF_FFFF_FFFFu64,
            essential,
            managed,
            claimed: 0,
            light_sleeps: 0,
            deep_sleeps: 0,
            dormant_states: 0,
            wake_pins: 0,
            requested: [0u8; 64],
        }
    }

    // Claim a peripheral's clocks, as a chip does when the program takes
    // the peripheral: they start and can no longer be disabled.
    pub fn claim(&mut self, clocks: power.Clocks) {
        self.claimed |= clocks
        self.enabled |= clocks
    }

    // Give a peripheral's clocks back, as a chip does when the program
    // releases the peripheral.
    pub fn release(&mut self, clocks: power.Clocks) {
        self.claimed &= ~clocks
    }

    pub fn claimed(&self) -> power.Clocks {
        return self.claimed
    }

    // End the next dormant state as if `pins` (bit n for pin n) changed;
    // only those the dormant state waits for wake it.
    pub fn wake_next_dormant(&mut self, pins: u64) {
        self.wake_pins = pins
    }

    // Waits in each mode, and dormant states, so far.
    pub fn light_sleeps(&self) -> u32 {
        return self.light_sleeps
    }

    pub fn deep_sleeps(&self) -> u32 {
        return self.deep_sleeps
    }

    pub fn dormant_states(&self) -> u32 {
        return self.dormant_states
    }

    // The events of `pin` the last dormant state waited for.
    pub fn requested_events(&self, pin: u32) -> u32 {
        if pin >= power.MAX_PINS {
            return 0
        }
        return self.requested[pin as usize] as u32
    }

    pub fn mode(&self) -> power.Mode {
        if self.deep {
            return power.Mode.DeepSleep
        }
        return power.Mode.Sleep
    }

    pub fn set_mode(&mut self, mode: power.Mode) {
        self.deep = mode == power.Mode.DeepSleep
    }

    // Returns at once, as if an interrupt were pending, and counts the wait.
    pub fn sleep(&mut self) {
        if self.deep {
            self.deep_sleeps += 1
        } else {
            self.light_sleeps += 1
        }
    }

    pub fn enabled_clocks(&self) -> power.Clocks {
        return self.enabled
    }

    pub fn enable_clocks(&mut self, clocks: power.Clocks) {
        self.enabled |= clocks
    }

    pub fn disable_clocks(&mut self, clocks: power.Clocks) -> void!hal.Error {
        if (clocks & self.essential) != 0 {
            return err(hal.Error.InvalidInput)
        }
        if (clocks & self.claimed) != 0 {
            return err(hal.Error.Busy)
        }
        self.enabled &= ~clocks
        return ok()
    }

    pub fn disable_unused_clocks(&mut self) -> power.Clocks {
        unused := self.managed & ~self.claimed & self.enabled
        self.enabled &= ~unused
        return unused
    }

    pub fn sleep_clocks(&self) -> power.Clocks {
        return self.sleeping
    }

    pub fn set_sleep_clocks(&mut self, clocks: power.Clocks) {
        self.sleeping = clocks
    }

    pub fn dormant(&mut self, wake: &power.Wake) -> u64!hal.Error {
        waiting := wake.pins()
        if waiting == 0 {
            return err(hal.Error.InvalidInput)
        }
        for index in 0u32..64 {
            self.requested[index as usize] = wake.events(index) as u8
        }
        woken := waiting & self.wake_pins
        // Nothing would ever end this dormant state.
        core.assert(woken != 0)
        self.wake_pins = 0
        self.dormant_states += 1
        return ok(woken)
    }
}
