package fake

import "core/option"
import "core/ptr"
import "std/embedded/executor"
import "std/embedded/hal"
import "std/embedded/hal/serial"
import "std/embedded/power"
import "std/io"

// In-memory devices implementing the `std/embedded/hal` protocols. They let
// driver code run under `dodo test` on a desktop with no hardware attached, and
// record what the driver did so tests can assert on it. There is one for
// every protocol: pins, delays, alarms, tick counters, compare channels,
// periodic timers, capture channels, I2C and SPI buses (blocking and
// polled), serial ports, PWM outputs and inputs, analog inputs, I2C and
// SPI targets, CAN controllers, I2S streams, DMA channels and buffer
// transfers, and a simulated clock for executor tasks.

// An output and input pin. It starts low.
pub struct Pin {
    high: bool
    changes: u32

    pub fn new() -> Pin {
        return Pin { high: false, changes: 0 }
    }

    pub fn set_high(&mut self) {
        if !self.high {
            self.changes += 1
        }
        self.high = true
    }

    pub fn set_low(&mut self) {
        if self.high {
            self.changes += 1
        }
        self.high = false
    }

    pub fn is_high(&self) -> bool {
        return self.high
    }

    // Number of level changes so far, for example 2 per blink.
    pub fn changes(&self) -> u32 {
        return self.changes
    }
}

// A delay that returns immediately and adds up the requested time. It is a
// counter too, whose time is that sum, so a driver that delays between polls
// of a device reaches its deadline without waiting.
pub struct Delay {
    elapsed: u64

    pub fn new() -> Delay {
        return Delay { elapsed: 0 }
    }

    pub fn delay_us(&mut self, microseconds: u32) {
        self.elapsed += microseconds as u64
    }

    pub fn elapsed_us(&self) -> u64 {
        return self.elapsed
    }

    // The counter's time: the delays so far.
    pub fn now_us(&self) -> u64 {
        return self.elapsed
    }
}

// A one-shot alarm on a simulated counter that starts at 0 and moves only
// when the test calls `advance`. It reaches any time ahead.
pub struct Alarm {
    now: u64
    target: u64
    armed: bool
    fired: bool
    schedules: u32
    failure: Option<hal.Error>

    pub fn new() -> Alarm {
        return Alarm { now: 0, target: 0, armed: false, fired: false, schedules: 0, failure: none }
    }

    pub fn now_us(&self) -> u64 {
        return self.now
    }

    // Let `microseconds` pass; the alarm fires if its time falls within them.
    pub fn advance(&mut self, microseconds: u64) {
        self.now += microseconds
        self.check()
    }

    pub fn schedule_at_us(&mut self, time_us: u64) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        self.schedules += 1
        self.target = time_us
        self.armed = true
        self.fired = false
        self.check()
        return ok()
    }

    pub fn cancel(&mut self) {
        self.armed = false
    }

    // True from scheduling until it fires or is cancelled.
    pub fn is_armed(&self) -> bool {
        return self.armed
    }

    pub fn fired(&self) -> bool {
        return self.fired
    }

    pub fn clear(&mut self) {
        self.fired = false
    }

    // The scheduled time, armed or not.
    pub fn target_us(&self) -> u64 {
        return self.target
    }

    // Number of successful schedules so far.
    pub fn schedules(&self) -> u32 {
        return self.schedules
    }

    // Make the next schedule fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    fn check(&mut self) {
        if self.armed && self.now >= self.target {
            self.armed = false
            self.fired = true
        }
    }
}

// A counter at `tick_hz` that starts at 0 and moves only when the test
// calls `advance`. Implements hal.TickCounter.
pub struct TickCounter: hal.TickCounter {
    hz: u32
    now: u64

    pub fn new(tick_hz: u32) -> TickCounter {
        return TickCounter { hz: tick_hz, now: 0 }
    }

    pub fn advance(&mut self, ticks: u64) {
        self.now += ticks
    }

    pub fn tick_hz(&self) -> u32 {
        return self.hz
    }

    pub fn now_ticks(&self) -> u64 {
        return self.now
    }
}

// A compare channel on a simulated counter at `tick_hz` that starts at 0
// and moves only when the test calls `advance`. It reaches any count ahead
// unless `set_reach` limits it, as hardware with a narrower compare
// register does. Implements hal.Compare.
pub struct Compare: hal.Compare {
    hz: u32
    now: u64
    target: u64
    reach: u64
    armed: bool
    fired: bool
    listening: bool
    schedules: u32
    failure: Option<hal.Error>

    pub fn new(tick_hz: u32) -> Compare {
        return Compare { hz: tick_hz, now: 0, target: 0, reach: 0xFFFF_FFFF_FFFF_FFFFu64, armed: false, fired: false, listening: false, schedules: 0, failure: none }
    }

    // Refuse counts more than `ticks` ahead with InvalidInput.
    pub fn set_reach(&mut self, ticks: u64) {
        self.reach = ticks
    }

    // Let `ticks` pass; the channel fires if its count falls within them.
    pub fn advance(&mut self, ticks: u64) {
        self.now += ticks
        self.check()
    }

    pub fn tick_hz(&self) -> u32 {
        return self.hz
    }

    pub fn now_ticks(&self) -> u64 {
        return self.now
    }

    pub fn schedule_at_ticks(&mut self, ticks: u64) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if ticks > self.now && ticks - self.now > self.reach {
            return err(hal.Error.InvalidInput)
        }
        self.schedules += 1
        self.target = ticks
        self.armed = true
        self.fired = false
        self.check()
        return ok()
    }

    pub fn cancel(&mut self) {
        self.armed = false
    }

    pub fn fired(&self) -> bool {
        return self.fired
    }

    pub fn clear(&mut self) {
        self.fired = false
    }

    pub fn listen(&mut self) {
        self.listening = true
    }

    pub fn ignore(&mut self) {
        self.listening = false
    }

    pub fn is_listening(&self) -> bool {
        return self.listening
    }

    // True while its interrupt would be raised: it fired and listens.
    pub fn is_raised(&self) -> bool {
        return self.fired && self.listening
    }

    // True from scheduling until it fires or is cancelled.
    pub fn is_armed(&self) -> bool {
        return self.armed
    }

    // The scheduled count, armed or not.
    pub fn target_ticks(&self) -> u64 {
        return self.target
    }

    // Number of successful schedules so far.
    pub fn schedules(&self) -> u32 {
        return self.schedules
    }

    // Make the next schedule fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    fn check(&mut self) {
        if self.armed && self.now >= self.target {
            self.armed = false
            self.fired = true
        }
    }
}

// A periodic timer on a simulated counter at `tick_hz` that starts at 0 and
// moves only when the test calls `advance`. Periods up to `set_max_period`
// (any at first) are accepted. Implements hal.PeriodicTimer.
pub struct PeriodicTimer: hal.PeriodicTimer {
    hz: u32
    now: u64
    period: u64
    next: u64
    max_period: u64
    running: bool
    ended: u64
    listening: bool
    starts: u32
    failure: Option<hal.Error>

    pub fn new(tick_hz: u32) -> PeriodicTimer {
        return PeriodicTimer { hz: tick_hz, now: 0, period: 0, next: 0, max_period: 0xFFFF_FFFF_FFFF_FFFFu64, running: false, ended: 0, listening: false, starts: 0, failure: none }
    }

    // Refuse periods longer than `ticks` with InvalidInput.
    pub fn set_max_period(&mut self, ticks: u64) {
        self.max_period = ticks
    }

    // Let `ticks` pass; every period that ends within them counts.
    pub fn advance(&mut self, ticks: u64) {
        self.now += ticks
        if self.running && self.now >= self.next {
            periods := (self.now - self.next) / self.period + 1
            self.ended += periods
            self.next += periods * self.period
        }
    }

    pub fn tick_hz(&self) -> u32 {
        return self.hz
    }

    pub fn now_ticks(&self) -> u64 {
        return self.now
    }

    pub fn start(&mut self, period_ticks: u64) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if period_ticks == 0 || period_ticks > self.max_period {
            return err(hal.Error.InvalidInput)
        }
        self.starts += 1
        self.period = period_ticks
        self.next = self.now + period_ticks
        self.ended = 0
        self.running = true
        return ok()
    }

    pub fn cancel(&mut self) {
        self.running = false
        self.ended = 0
    }

    pub fn poll_periods(&mut self) -> u32 {
        periods := self.ended
        self.ended = 0
        if periods > 0xFFFF_FFFFu64 {
            return 0xFFFF_FFFF
        }
        return periods as u32
    }

    pub fn listen(&mut self) {
        self.listening = true
    }

    pub fn ignore(&mut self) {
        self.listening = false
    }

    pub fn is_listening(&self) -> bool {
        return self.listening
    }

    // True while its interrupt would be raised: a period ended that was
    // not polled yet, and it listens.
    pub fn is_raised(&self) -> bool {
        return self.ended > 0 && self.listening
    }

    pub fn is_running(&self) -> bool {
        return self.running
    }

    pub fn period_ticks(&self) -> u64 {
        return self.period
    }

    // The count at which the next period ends.
    pub fn next_ticks(&self) -> u64 {
        return self.next
    }

    // Number of successful starts so far.
    pub fn starts(&self) -> u32 {
        return self.starts
    }

    // Make the next start fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }
}

// A capture channel at `tick_hz` whose events the test makes with `event`.
// It holds up to `set_depth` events (16, and 16 at most), as a FIFO in
// hardware does; one that arrives while it is full is lost and the next
// poll reports Overrun. Implements hal.InputCapture.
pub struct InputCapture: hal.InputCapture {
    hz: u32
    events: [16]u64
    first: usize
    waiting: usize
    depth: usize
    lost: bool
    listening: bool
    failure: Option<hal.Error>

    pub fn new(tick_hz: u32) -> InputCapture {
        return InputCapture { hz: tick_hz, events: [0u64; 16], first: 0, waiting: 0, depth: 16, lost: false, listening: false, failure: none }
    }

    // Hold at most `events` events, 1 to 16; 1 is a single capture
    // register.
    pub fn set_depth(&mut self, events: usize) {
        core.assert(events >= 1 && events <= 16)
        self.depth = events
    }

    // An event at tick count `ticks`, as if the input saw one then.
    pub fn event(&mut self, ticks: u64) {
        if self.waiting == self.depth {
            self.lost = true
            return
        }
        self.events[(self.first + self.waiting) % 16] = ticks
        self.waiting += 1
    }

    // The events waiting to be read.
    pub fn waiting(&self) -> usize {
        return self.waiting
    }

    pub fn tick_hz(&self) -> u32 {
        return self.hz
    }

    pub fn poll_event(&mut self, ticks: &mut u64) -> bool!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if self.lost {
            self.lost = false
            return err(hal.Error.Overrun)
        }
        if self.waiting == 0 {
            return ok(false)
        }
        *ticks = self.events[self.first]
        self.first = (self.first + 1) % 16
        self.waiting -= 1
        return ok(true)
    }

    pub fn listen(&mut self) {
        self.listening = true
    }

    pub fn ignore(&mut self) {
        self.listening = false
    }

    pub fn is_listening(&self) -> bool {
        return self.listening
    }

    // True while its interrupt would be raised: an event waits and it
    // listens.
    pub fn is_raised(&self) -> bool {
        return self.waiting > 0 && self.listening
    }

    // Make the next poll fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }
}

// One I2C device with 256 numbered 8-bit registers, the layout used by most
// sensors. A write sets the register pointer from its first byte and stores
// any following bytes at successive registers; a read continues from the
// pointer. Other addresses report NoAcknowledge.
//
// It also implements hal.I2cPoll: a polled transaction takes the number of
// polls set by `set_poll_steps` (1 at first) and happens, all at once, on
// the last of them.
pub struct I2c: hal.I2c + hal.I2cPoll {
    address: u8
    registers: [256]u8
    pointer: u8
    failure: Option<hal.Error>
    steps: u32
    // A polled transaction: polls so far (0 when none runs), and what the
    // first poll asked for, to check the later ones.
    polls: u32
    polled_address: u8
    polled_write: usize
    polled_read: usize
    cancels: u32

    pub fn new(address: u8) -> I2c {
        return I2c { address, registers: [0; 256], pointer: 0, failure: none, steps: 1, polls: 0, polled_address: 0, polled_write: 0, polled_read: 0, cancels: 0 }
    }

    // Make each polled transaction take `polls` polls, at least 1.
    pub fn set_poll_steps(&mut self, polls: u32) {
        core.assert(polls != 0)
        self.steps = polls
    }

    // How many polled transactions were cancelled.
    pub fn cancels(&self) -> u32 {
        return self.cancels
    }

    // True while a polled transaction runs.
    pub fn is_busy(&self) -> bool {
        return self.polls != 0
    }

    pub fn poll_write(&mut self, address: u8, bytes: &[u8]) -> bool!hal.Error {
        if !self.step(address, bytes.len, 0)? {
            return ok(false)
        }
        self.write(address, bytes)?
        return ok(true)
    }

    pub fn poll_read(&mut self, address: u8, buffer: &mut[u8]) -> bool!hal.Error {
        if !self.step(address, 0, buffer.len)? {
            return ok(false)
        }
        self.read(address, buffer)?
        return ok(true)
    }

    pub fn poll_write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> bool!hal.Error {
        if !self.step(address, bytes.len, buffer.len)? {
            return ok(false)
        }
        self.write_read(address, bytes, buffer)?
        return ok(true)
    }

    pub fn cancel(&mut self) {
        if self.polls != 0 {
            self.polls = 0
            self.cancels += 1
        }
    }

    // Count one poll of a transaction; true on its last.
    fn step(&mut self, address: u8, write: usize, read: usize) -> bool!hal.Error {
        if self.polls == 0 {
            self.polled_address = address
            self.polled_write = write
            self.polled_read = read
        } else if address != self.polled_address || write != self.polled_write || read != self.polled_read {
            return err(hal.Error.InvalidInput)
        }
        self.polls += 1
        if self.polls < self.steps {
            return ok(false)
        }
        self.polls = 0
        return ok(true)
    }

    pub fn register(&self, index: u8) -> u8 {
        return self.registers[index as usize]
    }

    pub fn set_register(&mut self, index: u8, value: u8) {
        self.registers[index as usize] = value
    }

    // Make the next transaction fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    fn begin(&mut self, address: u8) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if address != self.address {
            return err(hal.Error.NoAcknowledge)
        }
        return ok()
    }

    pub fn write(&mut self, address: u8, bytes: &[u8]) -> void!hal.Error {
        self.begin(address)?
        if bytes.len == 0 {
            return ok()
        }
        self.pointer = bytes[0]
        for index in 1..bytes.len {
            self.registers[self.pointer as usize] = bytes[index]
            self.pointer = core.wrapping_add(self.pointer, 1)
        }
        return ok()
    }

    pub fn read(&mut self, address: u8, buffer: &mut[u8]) -> void!hal.Error {
        self.begin(address)?
        for index in 0..buffer.len {
            buffer[index] = self.registers[self.pointer as usize]
            self.pointer = core.wrapping_add(self.pointer, 1)
        }
        return ok()
    }

    pub fn write_read(&mut self, address: u8, bytes: &[u8], buffer: &mut[u8]) -> void!hal.Error {
        self.write(address, bytes)?
        return self.read(address, buffer)
    }
}

// An SPI bus that records the most recent 64 bytes sent and answers each
// byte from a programmed reply, then with zeros.
//
// It also implements hal.SpiPoll: each poll exchanges at most the number
// of bytes set by `set_poll_chunk` (all at first).
pub struct Spi: hal.Spi + hal.SpiPoll {
    sent: [64]u8
    sent_length: usize
    reply: [64]u8
    reply_length: usize
    reply_position: usize
    chunk: usize
    // A polled transfer: bytes done, its length, whether it runs, and
    // whether it writes only.
    done: usize
    length: usize
    polling: bool
    writing: bool
    polls: u32

    pub fn new() -> Spi {
        return Spi { sent: [0; 64], sent_length: 0, reply: [0; 64], reply_length: 0, reply_position: 0, chunk: 0, done: 0, length: 0, polling: false, writing: false, polls: 0 }
    }

    // Exchange at most `bytes` bytes per poll; 0 for all of them.
    pub fn set_poll_chunk(&mut self, bytes: usize) {
        self.chunk = bytes
    }

    // Polls made of polled transfers so far.
    pub fn polls(&self) -> u32 {
        return self.polls
    }

    pub fn poll_transfer(&mut self, bytes: &mut[u8]) -> bool!hal.Error {
        self.begin_poll(bytes.len, false)?
        end := self.chunk_end()
        for index in self.done..end {
            bytes[index] = self.exchange(bytes[index])
        }
        return ok(self.end_poll(end))
    }

    pub fn poll_write(&mut self, bytes: &[u8]) -> bool!hal.Error {
        self.begin_poll(bytes.len, true)?
        end := self.chunk_end()
        for index in self.done..end {
            self.exchange(bytes[index])
        }
        return ok(self.end_poll(end))
    }

    pub fn cancel(&mut self) {
        self.polling = false
    }

    pub fn is_busy(&self) -> bool {
        return self.polling
    }

    fn begin_poll(&mut self, length: usize, writing: bool) -> void!hal.Error {
        self.polls += 1
        if !self.polling {
            self.polling = true
            self.writing = writing
            self.length = length
            self.done = 0
        } else if self.length != length || self.writing != writing {
            return err(hal.Error.InvalidInput)
        }
        return ok()
    }

    fn chunk_end(&self) -> usize {
        if self.chunk == 0 || self.length - self.done <= self.chunk {
            return self.length
        }
        return self.done + self.chunk
    }

    fn end_poll(&mut self, end: usize) -> bool {
        self.done = end
        if end == self.length {
            self.polling = false
            return true
        }
        return false
    }

    // Bytes the device answers with, in order. At most 64.
    pub fn reply_with(&mut self, bytes: &[u8]) {
        core.assert(bytes.len <= 64)
        for index in 0..bytes.len {
            self.reply[index] = bytes[index]
        }
        self.reply_length = bytes.len
        self.reply_position = 0
    }

    // Bytes sent since the last call to `clear`, up to the first 64.
    pub fn sent(&self) -> &[u8] {
        return self.sent[0..self.sent_length]
    }

    pub fn clear(&mut self) {
        self.sent_length = 0
    }

    fn exchange(&mut self, byte: u8) -> u8 {
        if self.sent_length < 64 {
            self.sent[self.sent_length] = byte
            self.sent_length += 1
        }
        if self.reply_position < self.reply_length {
            answer := self.reply[self.reply_position]
            self.reply_position += 1
            return answer
        }
        return 0
    }

    pub fn transfer(&mut self, bytes: &mut[u8]) -> void!hal.Error {
        for index in 0..bytes.len {
            bytes[index] = self.exchange(bytes[index])
        }
        return ok()
    }

    pub fn write(&mut self, bytes: &[u8]) -> void!hal.Error {
        for index in 0..bytes.len {
            self.exchange(bytes[index])
        }
        return ok()
    }
}

// A PWM output that remembers its duty. It starts at 0, low.
pub struct Pwm {
    max: u16
    duty: u16
    changes: u32
    failure: Option<hal.Error>

    // An output whose duty runs from 0 to `max_duty`, at least 1.
    pub fn new(max_duty: u16) -> Pwm {
        core.assert(max_duty != 0)
        return Pwm { max: max_duty, duty: 0, changes: 0, failure: none }
    }

    pub fn max_duty(&self) -> u16 {
        return self.max
    }

    pub fn set_duty(&mut self, duty: u16) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if duty > self.max {
            return err(hal.Error.InvalidInput)
        }
        self.duty = duty
        self.changes += 1
        return ok()
    }

    // The duty last set.
    pub fn duty(&self) -> u16 {
        return self.duty
    }

    // The number of duties set so far.
    pub fn changes(&self) -> u32 {
        return self.changes
    }

    // Make the next set_duty fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }
}

// An analog input that reads the value given to `set`, at first 0, or the
// values given to `queue`, one per read, before that.
pub struct Analog {
    max: u16
    value: u16
    queued: [32]u16
    queued_length: usize
    queued_position: usize
    reads: u32
    failure: Option<hal.Error>

    // An input whose values run from 0 to `max_value`, such as 4095 for a
    // 12-bit converter.
    pub fn new(max_value: u16) -> Analog {
        return Analog { max: max_value, value: 0, queued: [0u16; 32], queued_length: 0, queued_position: 0, reads: 0, failure: none }
    }

    pub fn max_value(&self) -> u16 {
        return self.max
    }

    // Read `value` from now on, once queued values are used up. Traps if it
    // is above max_value.
    pub fn set(&mut self, value: u16) {
        core.assert(value <= self.max)
        self.value = value
    }

    // Values for the next reads to return in order, after any still
    // unread, before the one given to `set`. At most 32 can wait at once.
    pub fn queue(&mut self, values: &[u16]) {
        unread := self.queued_length - self.queued_position
        core.assert(unread + values.len <= 32)
        for index in 0..unread {
            self.queued[index] = self.queued[self.queued_position + index]
        }
        for index in 0..values.len {
            core.assert(values[index] <= self.max)
            self.queued[unread + index] = values[index]
        }
        self.queued_position = 0
        self.queued_length = unread + values.len
    }

    pub fn read(&mut self) -> u16!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        self.reads += 1
        if self.queued_position < self.queued_length {
            value := self.queued[self.queued_position]
            self.queued_position += 1
            return ok(value)
        }
        return ok(self.value)
    }

    // The number of successful reads so far.
    pub fn reads(&self) -> u32 {
        return self.reads
    }

    // Make the next read fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }
}

// A random number generator that fills buffers with the bytes given to
// `queue`, in order, and after those with a counting pattern: 0, 1, 2, ...,
// 255, 0, 1, ... continuing across calls. Tests then see exactly which bytes
// a driver drew, and how many.
pub struct Rng {
    queued: [64]u8
    queued_length: usize
    queued_position: usize
    next: u8
    drawn: u32
    failure: Option<hal.Error>

    pub fn new() -> Rng {
        return Rng { queued: [0u8; 64], queued_length: 0, queued_position: 0, next: 0, drawn: 0, failure: none }
    }

    // Bytes for the next fills to return in order, after any still unread,
    // before the counting pattern resumes. At most 64 can wait at once.
    pub fn queue(&mut self, bytes: &[u8]) {
        unread := self.queued_length - self.queued_position
        core.assert(unread + bytes.len <= 64)
        for index in 0..unread {
            self.queued[index] = self.queued[self.queued_position + index]
        }
        for index in 0..bytes.len {
            self.queued[unread + index] = bytes[index]
        }
        self.queued_position = 0
        self.queued_length = unread + bytes.len
    }

    pub fn fill(&mut self, bytes: &mut[u8]) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        for index in 0..bytes.len {
            if self.queued_position < self.queued_length {
                bytes[index] = self.queued[self.queued_position]
                self.queued_position += 1
            } else {
                bytes[index] = self.next
                self.next = core.wrapping_add(self.next, 1u8)
            }
        }
        self.drawn += bytes.len as u32
        return ok()
    }

    // The number of bytes filled so far.
    pub fn drawn(&self) -> u32 {
        return self.drawn
    }

    // Make the next fill fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }
}

// A serial port that records the most recent 256 bytes written and reads
// back bytes given to `feed`, as if they had arrived on its receive line;
// once they are read, reads report end of input. Implements the std/io
// Reader and Writer protocols like the chips' serial ports, so drivers for
// devices on a UART, and std/fmt output, can be tested on a desktop.
//
// It also implements serial.Port and serial.PollPort. `set_write_room`
// limits how many bytes one poll_write takes, to test a driver against a
// full transmitter, and `set_flush_polls` how many poll_flush calls report
// output still going out after a write.
pub struct Serial: serial.Port + serial.PollPort {
    sent: [256]u8
    sent_length: usize
    input: [256]u8
    input_length: usize
    input_position: usize
    room: usize
    flush_polls: u32
    unflushed: u32
    flushes: u32

    pub fn new() -> Serial {
        return Serial { sent: [0; 256], sent_length: 0, input: [0; 256], input_length: 0, input_position: 0, room: 0, flush_polls: 0, unflushed: 0, flushes: 0 }
    }

    // Take at most `bytes` bytes per poll_write; 0 for no limit.
    pub fn set_write_room(&mut self, bytes: usize) {
        self.room = bytes
    }

    // After each write, report output going out for `polls` poll_flush
    // calls.
    pub fn set_flush_polls(&mut self, polls: u32) {
        self.flush_polls = polls
    }

    // Times flush or a finished poll_flush saw all output gone.
    pub fn flushes(&self) -> u32 {
        return self.flushes
    }

    pub fn poll_write(&mut self, bytes: &[u8]) -> io.Poll!io.Error {
        count := bytes.len
        if self.room != 0 && count > self.room {
            count = self.room
        }
        self.write(bytes[0..count])?
        state := io.PollState.Ready
        if count < bytes.len {
            state = io.PollState.Pending
        }
        return ok(io.Poll { transferred: count, state })
    }

    pub fn flush(&mut self) -> void!io.Error {
        self.unflushed = 0
        self.flushes += 1
        return ok()
    }

    pub fn poll_flush(&mut self) -> bool!io.Error {
        if self.unflushed != 0 {
            self.unflushed -= 1
            return ok(false)
        }
        self.flushes += 1
        return ok(true)
    }

    // Bytes for reads to return, after any still unread. At most 256 can
    // wait at once.
    pub fn feed(&mut self, bytes: &[u8]) {
        unread := self.input_length - self.input_position
        core.assert(unread + bytes.len <= 256)
        for index in 0..unread {
            self.input[index] = self.input[self.input_position + index]
        }
        for index in 0..bytes.len {
            self.input[unread + index] = bytes[index]
        }
        self.input_position = 0
        self.input_length = unread + bytes.len
    }

    // Bytes written since the last call to `clear`, up to the first 256.
    pub fn sent(&self) -> &[u8] {
        return self.sent[0..self.sent_length]
    }

    pub fn clear(&mut self) {
        self.sent_length = 0
    }

    pub fn write(&mut self, bytes: &[u8]) -> usize!io.Error {
        for index in 0..bytes.len {
            if self.sent_length < 256 {
                self.sent[self.sent_length] = bytes[index]
                self.sent_length += 1
            }
        }
        if bytes.len != 0 {
            self.unflushed = self.flush_polls
        }
        return ok(bytes.len)
    }

    pub fn read(&mut self, buffer: &mut[u8]) -> usize!io.Error {
        count := 0usize
        for count < buffer.len && self.input_position < self.input_length {
            buffer[count] = self.input[self.input_position]
            self.input_position += 1
            count += 1
        }
        return ok(count)
    }

    // The polling read of the chips' serial ports: what has been fed and
    // not read yet, up to `buffer.len`, or Pending while nothing is
    // waiting, as on a UART, rather than end of input.
    pub fn poll_read(&mut self, buffer: &mut[u8]) -> io.Poll!io.Error {
        count := self.read(buffer)?
        state := io.PollState.Ready
        if count == 0 && buffer.len != 0 {
            state = io.PollState.Pending
        }
        return ok(io.Poll { transferred: count, state })
    }
}

// A simulated clock for running std/embedded/executor tasks on a desktop.
// Time stands still while tasks run and jumps forward when the executor
// sleeps, to the time it asked for or to the next simulated interrupt,
// whichever comes first. A simulated interrupt raises its signal at its
// time, as a handler would, so tasks waiting for hardware events are tested
// without hardware. A sleep that nothing could end, with no time and no
// interrupt to come, traps instead of hanging the test.
pub struct Clock {
    now: u64
    sleeps: u32
    idle: u64
    // Simulated interrupts: their times and signal ids, unordered.
    times: [16]u64
    signals: [16]u32
    scheduled: usize

    // A clock at time 0 with no interrupts to come.
    pub fn new() -> Clock {
        return Clock { now: 0, sleeps: 0, idle: 0, times: [0u64; 16], signals: [0u32; 16], scheduled: 0 }
    }

    pub fn now_us(&self) -> u64 {
        return self.now
    }

    // Raise `signal` when the time reaches `time_us`, as an interrupt
    // handler would; at most 16 can be waiting. A time already past raises
    // it at the next sleep or advance.
    pub fn interrupt_at(&mut self, time_us: u64, signal: &executor.Signal) {
        core.assert(self.scheduled < 16)
        self.times[self.scheduled] = time_us
        self.signals[self.scheduled] = signal.id
        self.scheduled += 1
    }

    // Let `microseconds` pass, as if a task were busy for that long, and
    // raise the signals of interrupts that fall within it.
    pub fn advance(&mut self, microseconds: u64) {
        self.now += microseconds
        self.fire()
    }

    // The executor's sleep: see the type's comment.
    pub fn sleep_until(&mut self, deadline: Option<u64>) {
        self.sleeps += 1
        start := self.now
        target := 0xFFFF_FFFF_FFFF_FFFFu64
        if let some(time) = deadline {
            target = time
        }
        for index in 0..self.scheduled {
            if self.times[index] < target {
                target = self.times[index]
            }
        }
        // Nothing would ever end this sleep.
        core.assert(target != 0xFFFF_FFFF_FFFF_FFFFu64)
        if target > self.now {
            self.now = target
        }
        self.idle += self.now - start
        self.fire()
    }

    // How many times the executor slept, and for how long in all.
    pub fn sleeps(&self) -> u32 {
        return self.sleeps
    }

    pub fn idle_us(&self) -> u64 {
        return self.idle
    }

    // Raise the signals of interrupts that are due, and forget them.
    fn fire(&mut self) {
        index := 0usize
        for index < self.scheduled {
            if self.times[index] <= self.now {
                signal := executor.Signal { id: self.signals[index] }
                signal.raise()
                self.scheduled -= 1
                self.times[index] = self.times[self.scheduled]
                self.signals[index] = self.signals[self.scheduled]
            } else {
                index += 1
            }
        }
    }
}

// An I2C target and the master that addresses it, played by the test:
// `master_write`, `master_read`, and `master_stop` queue what the master
// does, and the target's poll reports it in order, as hal.I2cTarget
// requires. A master read waits until the driver answers with `respond`;
// the bytes it read are in `master_received`. At most 64 steps wait at
// once, and 256 bytes are recorded.
pub struct I2cTarget: hal.I2cTarget {
    // The master's steps: STEP_WRITE (with the byte, and FIRST when it
    // follows the address), STEP_READ (with the count), or STEP_STOP.
    steps: [64]u32
    step_count: usize
    step_position: usize
    // Bytes of the current master read still to answer.
    reading: usize
    received: [256]u8
    received_length: usize
    failure: Option<hal.Error>

    pub fn new() -> I2cTarget {
        return I2cTarget { steps: [0u32; 64], step_count: 0, step_position: 0, reading: 0, received: [0; 256], received_length: 0, failure: none }
    }

    // The master addresses the target and writes `bytes`.
    pub fn master_write(&mut self, bytes: &[u8]) {
        for index in 0..bytes.len {
            step := STEP_WRITE | bytes[index] as u32
            if index == 0 {
                step |= STEP_FIRST
            }
            self.push(step)
        }
    }

    // The master addresses the target, or repeats a START, and reads
    // `count` bytes.
    pub fn master_read(&mut self, count: usize) {
        core.assert(count != 0 && count <= 0xFFFF)
        self.push(STEP_READ | count as u32)
    }

    // The master ends the transaction with a STOP.
    pub fn master_stop(&mut self) {
        self.push(STEP_STOP)
    }

    // The bytes the master has read so far, up to the first 256.
    pub fn master_received(&self) -> &[u8] {
        return self.received[0..self.received_length]
    }

    // True once every queued step has been reported and answered.
    pub fn is_idle(&self) -> bool {
        return self.step_position == self.step_count && self.reading == 0
    }

    // Make the next poll fail with `error`, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    pub fn poll(&mut self, buffer: &mut[u8]) -> hal.I2cTargetEvent!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if self.reading != 0 {
            return ok(hal.I2cTargetEvent.Read)
        }
        count := 0usize
        start := false
        for count < buffer.len && self.step_position < self.step_count {
            step := self.steps[self.step_position]
            if (step & STEP_KIND) != STEP_WRITE {
                break
            }
            first := (step & STEP_FIRST) != 0
            if first && count > 0 {
                break
            }
            if count == 0 {
                start = first
            }
            buffer[count] = (step & 0xFF) as u8
            count += 1
            self.step_position += 1
        }
        if count > 0 {
            return ok(hal.I2cTargetEvent.Write(count, start))
        }
        if self.step_position == self.step_count {
            return ok(hal.I2cTargetEvent.Idle)
        }
        step := self.steps[self.step_position]
        if (step & STEP_KIND) == STEP_STOP {
            self.step_position += 1
            return ok(hal.I2cTargetEvent.Stop)
        }
        if (step & STEP_KIND) == STEP_READ {
            self.step_position += 1
            self.reading = (step & 0xFFFF) as usize
            return ok(hal.I2cTargetEvent.Read)
        }
        // A write longer than an empty buffer can take.
        return ok(hal.I2cTargetEvent.Idle)
    }

    pub fn respond(&mut self, bytes: &[u8]) -> usize!hal.Error {
        if self.reading == 0 {
            // No read waits: a real controller would hold the bytes for
            // the next one, which this fake does not model.
            return ok(0)
        }
        if bytes.len == 0 {
            self.record(0xFF)
            self.reading -= 1
            return ok(0)
        }
        count := 0usize
        for count < bytes.len && self.reading > 0 {
            self.record(bytes[count])
            self.reading -= 1
            count += 1
        }
        return ok(count)
    }

    fn push(&mut self, step: u32) {
        if self.step_position == self.step_count {
            self.step_position = 0
            self.step_count = 0
        }
        core.assert(self.step_count < 64)
        self.steps[self.step_count] = step
        self.step_count += 1
    }

    fn record(&mut self, byte: u8) {
        if self.received_length < 256 {
            self.received[self.received_length] = byte
            self.received_length += 1
        }
    }
}

const STEP_KIND: u32 = 0b11 << 24
const STEP_WRITE: u32 = 1 << 24
const STEP_READ: u32 = 2 << 24
const STEP_STOP: u32 = 3 << 24
const STEP_FIRST: u32 = 1 << 16

// An SPI target and the master that clocks it, played by the test:
// `master_exchange` clocks bytes in from the master and out of the queue
// the driver filled, as many as the master sends; with the queue empty the
// target answers 0. 64 bytes wait in each direction at most; bytes the
// master sends beyond what waits unread are lost, and the next read reports
// Overrun.
pub struct SpiTarget: hal.SpiTarget {
    outgoing: [64]u8
    outgoing_length: usize
    incoming: [64]u8
    incoming_length: usize
    lost: bool

    pub fn new() -> SpiTarget {
        return SpiTarget { outgoing: [0; 64], outgoing_length: 0, incoming: [0; 64], incoming_length: 0, lost: false }
    }

    // The master sends `bytes`, each replaced by the byte the target sent
    // in its place.
    pub fn master_exchange(&mut self, bytes: &mut[u8]) {
        for index in 0..bytes.len {
            reply := 0u8
            if self.outgoing_length > 0 {
                reply = self.outgoing[0]
                for move in 1..self.outgoing_length {
                    self.outgoing[move - 1] = self.outgoing[move]
                }
                self.outgoing_length -= 1
            }
            if self.incoming_length < 64 {
                self.incoming[self.incoming_length] = bytes[index]
                self.incoming_length += 1
            } else {
                self.lost = true
            }
            bytes[index] = reply
        }
    }

    // Bytes queued and not yet clocked out.
    pub fn queued(&self) -> usize {
        return self.outgoing_length
    }

    pub fn queue(&mut self, bytes: &[u8]) -> usize!hal.Error {
        count := 0usize
        for count < bytes.len && self.outgoing_length < 64 {
            self.outgoing[self.outgoing_length] = bytes[count]
            self.outgoing_length += 1
            count += 1
        }
        return ok(count)
    }

    pub fn read(&mut self, buffer: &mut[u8]) -> usize!hal.Error {
        count := buffer.len
        if count > self.incoming_length {
            count = self.incoming_length
        }
        for index in 0..count {
            buffer[index] = self.incoming[index]
        }
        for index in count..self.incoming_length {
            self.incoming[index - count] = self.incoming[index]
        }
        self.incoming_length -= count
        if count == 0 && self.lost {
            self.lost = false
            return err(hal.Error.Overrun)
        }
        return ok(count)
    }
}

// A PWM input that reports the measurements given to `queue`, one per
// poll_capture, in order; with none waiting, poll_capture is false. At
// most 16 wait at once.
pub struct PwmInput: hal.PwmInput {
    periods: [16]u64
    highs: [16]u64
    cycles: [16]u32
    length: usize
    position: usize
    failure: Option<hal.Error>

    pub fn new() -> PwmInput {
        return PwmInput { periods: [0u64; 16], highs: [0u64; 16], cycles: [0u32; 16], length: 0, position: 0, failure: none }
    }

    // A measurement for a later poll_capture to report.
    pub fn queue(&mut self, period_ns: u64, high_ns: u64, cycles: u32) {
        if self.position == self.length {
            self.position = 0
            self.length = 0
        }
        core.assert(self.length < 16)
        self.periods[self.length] = period_ns
        self.highs[self.length] = high_ns
        self.cycles[self.length] = cycles
        self.length += 1
    }

    // A signal of `frequency_hz` that is high `percent` of each period,
    // as a single-period measurement.
    pub fn queue_signal(&mut self, frequency_hz: u32, percent: u32) {
        core.assert(frequency_hz != 0 && percent <= 100)
        period := 1_000_000_000u64 / frequency_hz as u64
        self.queue(period, period * percent as u64 / 100, 1)
    }

    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    pub fn poll_capture(&mut self, capture: &mut hal.PulseCapture) -> bool!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if self.position == self.length {
            return ok(false)
        }
        capture.period_ns = self.periods[self.position]
        capture.high_ns = self.highs[self.position]
        capture.cycles = self.cycles[self.position]
        self.position += 1
        return ok(true)
    }
}

// A CAN controller on a simulated bus. Frames sent are recorded, up to
// 16, for `sent` to return, and with `set_loopback` also received, as a
// controller in loopback mode does; frames given to `inject` arrive as if
// another node had sent them. `set_transmit_room` limits how many frames
// may wait to leave, until `drain_transmit` sends them; up to 16 received
// frames wait. Classic CAN unless created with `new_fd`.
pub struct Can: hal.Can {
    fd: bool
    loopback: bool
    room: usize
    pending: usize
    // Sent frames, in order.
    sent_frames: [16]hal.CanFrame
    sent_count: usize
    // Received frames waiting: a ring.
    queue: [16]hal.CanFrame
    queue_start: usize
    queue_length: usize
    lost: bool
    state: hal.CanErrorState
    failure: Option<hal.Error>

    pub fn new() -> Can {
        return Can.make(false)
    }

    // A CAN FD controller, which also sends and receives FD frames.
    pub fn new_fd() -> Can {
        return Can.make(true)
    }

    fn make(fd: bool) -> Can {
        return Can {
            fd,
            loopback: false,
            room: 16,
            pending: 0,
            sent_frames: [hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new()],
            sent_count: 0,
            queue: [hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new(), hal.CanFrame.new()],
            queue_start: 0,
            queue_length: 0,
            lost: false,
            state: hal.CanErrorState.Active,
            failure: none,
        }
    }

    // Receive every frame sent, too.
    pub fn set_loopback(&mut self, on: bool) {
        self.loopback = on
    }

    // Let at most `frames` frames wait to leave, as a controller with that
    // many transmit buffers on a bus where frames leave only when
    // `drain_transmit` says so; 0 sends every frame at once (the default).
    pub fn set_transmit_room(&mut self, frames: usize) {
        if frames == 0 {
            self.room = 16
        } else {
            self.room = frames
        }
    }

    // Let the frames waiting to leave go.
    pub fn drain_transmit(&mut self) {
        self.pending = 0
    }

    // Change the fault confinement state; while BusOff, poll_send fails
    // with Bus.
    pub fn set_error_state(&mut self, state: hal.CanErrorState) {
        self.state = state
    }

    // A frame arrives from another node. When 16 already wait, it is lost
    // and the next poll_receive reports Overrun.
    pub fn inject(&mut self, frame: &hal.CanFrame) {
        if self.queue_length == 16 {
            self.lost = true
            return
        }
        slot := (self.queue_start + self.queue_length) % 16
        self.queue[slot].copy_from(frame)
        self.queue_length += 1
    }

    // The frames sent so far, up to the first 16.
    pub fn sent_count(&self) -> usize {
        return self.sent_count
    }

    pub fn sent(&self, index: usize) -> &hal.CanFrame {
        core.assert(index < self.sent_count)
        return &self.sent_frames[index]
    }

    // Received frames still waiting.
    pub fn waiting(&self) -> usize {
        return self.queue_length
    }

    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    pub fn poll_send(&mut self, frame: &hal.CanFrame) -> bool!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if frame.is_fd() && !self.fd {
            return err(hal.Error.Unsupported)
        }
        match &self.state {
            hal.CanErrorState.BusOff => {
                return err(hal.Error.Bus)
            }
            _ => {}
        }
        if self.room != 16 && self.pending >= self.room {
            return ok(false)
        }
        if self.room != 16 {
            self.pending += 1
        }
        if self.sent_count < 16 {
            self.sent_frames[self.sent_count].copy_from(frame)
            self.sent_count += 1
        }
        if self.loopback {
            self.inject(frame)
        }
        return ok(true)
    }

    pub fn poll_receive(&mut self, frame: &mut hal.CanFrame) -> bool!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if self.lost {
            self.lost = false
            return err(hal.Error.Overrun)
        }
        if self.queue_length == 0 {
            return ok(false)
        }
        frame.copy_from(&self.queue[self.queue_start])
        self.queue_start = (self.queue_start + 1) % 16
        self.queue_length -= 1
        return ok(true)
    }

    pub fn error_state(&mut self) -> hal.CanErrorState!hal.Error {
        match &self.state {
            hal.CanErrorState.Active => {
                return ok(hal.CanErrorState.Active)
            }
            hal.CanErrorState.Passive => {
                return ok(hal.CanErrorState.Passive)
            }
            hal.CanErrorState.BusOff => {
                return ok(hal.CanErrorState.BusOff)
            }
        }
    }
}

// An I2S output that records the samples it plays, up to the first 1024,
// and takes at most `room` samples per poll_write, as a stream whose queue
// is full.
pub struct I2sOutput: hal.I2sOutput {
    rate: u32
    channel_count: u32
    room: usize
    played: [1024]i32
    played_length: usize
    total: usize

    // A stream of `sample_rate` frames per second with `channels` (1 or 2)
    // samples each.
    pub fn new(sample_rate: u32, channels: u32) -> I2sOutput {
        core.assert(channels == 1 || channels == 2)
        return I2sOutput { rate: sample_rate, channel_count: channels, room: 0, played: [0i32; 1024], played_length: 0, total: 0 }
    }

    // Take at most `samples` samples per poll_write, rounded down to whole
    // frames; 0 for no limit.
    pub fn set_room(&mut self, samples: usize) {
        self.room = samples
    }

    // The samples queued so far, up to the first 1024.
    pub fn played(&self) -> &[i32] {
        return self.played[0..self.played_length]
    }

    // How many samples were queued in all.
    pub fn total(&self) -> usize {
        return self.total
    }

    pub fn sample_rate(&self) -> u32 {
        return self.rate
    }

    pub fn channels(&self) -> u32 {
        return self.channel_count
    }

    pub fn poll_write(&mut self, samples: &[i32]) -> usize!hal.Error {
        frame := self.channel_count as usize
        if samples.len % frame != 0 {
            return err(hal.Error.InvalidInput)
        }
        count := samples.len
        if self.room != 0 && count > self.room {
            count = self.room - self.room % frame
        }
        for index in 0..count {
            if self.played_length < 1024 {
                self.played[self.played_length] = samples[index]
                self.played_length += 1
            }
        }
        self.total += count
        return ok(count)
    }
}

// An I2S input that delivers the samples given to `feed`, at most `room`
// per poll_read. `drop_samples` makes the next read report Overrun.
pub struct I2sInput: hal.I2sInput {
    rate: u32
    channel_count: u32
    room: usize
    waiting: [1024]i32
    waiting_length: usize
    position: usize
    lost: bool

    pub fn new(sample_rate: u32, channels: u32) -> I2sInput {
        core.assert(channels == 1 || channels == 2)
        return I2sInput { rate: sample_rate, channel_count: channels, room: 0, waiting: [0i32; 1024], waiting_length: 0, position: 0, lost: false }
    }

    // Samples for later reads, after any unread; whole frames, at most
    // 1024 waiting at once.
    pub fn feed(&mut self, samples: &[i32]) {
        core.assert(samples.len % self.channel_count as usize == 0)
        unread := self.waiting_length - self.position
        core.assert(unread + samples.len <= 1024)
        for index in 0..unread {
            self.waiting[index] = self.waiting[self.position + index]
        }
        for index in 0..samples.len {
            self.waiting[unread + index] = samples[index]
        }
        self.position = 0
        self.waiting_length = unread + samples.len
    }

    // Deliver at most `samples` samples per read, rounded down to whole
    // frames; 0 for no limit.
    pub fn set_room(&mut self, samples: usize) {
        self.room = samples
    }

    // Report Overrun on the next read, as if samples had been lost.
    pub fn drop_samples(&mut self) {
        self.lost = true
    }

    pub fn sample_rate(&self) -> u32 {
        return self.rate
    }

    pub fn channels(&self) -> u32 {
        return self.channel_count
    }

    pub fn poll_read(&mut self, samples: &mut[i32]) -> usize!hal.Error {
        if self.lost {
            self.lost = false
            return err(hal.Error.Overrun)
        }
        frame := self.channel_count as usize
        count := self.waiting_length - self.position
        limit := samples.len
        if self.room != 0 && limit > self.room {
            limit = self.room
        }
        limit -= limit % frame
        if count > limit {
            count = limit
        }
        for index in 0..count {
            samples[index] = self.waiting[self.position + index]
        }
        self.position += count
        return ok(count)
    }
}

// A DMA buffer transfer without DMA: it holds up to 256 bytes of its own,
// and a transfer finishes after the number of polls set by
// `set_poll_steps` (1 at first). A transmitting buffer records what each
// transfer sent, for `sent`; a receiving one fills the buffer from the
// bytes given to `feed`, then zeros.
pub struct DmaBuffer: hal.DmaBuffer {
    storage: [256]u8
    size: usize
    receive: bool
    running: bool
    count: usize
    polls: u32
    steps: u32
    sent: [256]u8
    sent_length: usize
    input: [256]u8
    input_length: usize
    failure: Option<hal.Error>

    // A session that sends `capacity` bytes at most, up to 256.
    pub fn transmit(capacity: usize) -> DmaBuffer {
        return DmaBuffer.make(capacity, false)
    }

    // A session that receives `capacity` bytes at most, up to 256.
    pub fn receive(capacity: usize) -> DmaBuffer {
        return DmaBuffer.make(capacity, true)
    }

    fn make(capacity: usize, receive: bool) -> DmaBuffer {
        core.assert(capacity != 0 && capacity <= 256)
        return DmaBuffer { storage: [0; 256], size: capacity, receive, running: false, count: 0, polls: 0, steps: 1, sent: [0; 256], sent_length: 0, input: [0; 256], input_length: 0, failure: none }
    }

    pub fn set_poll_steps(&mut self, polls: u32) {
        core.assert(polls != 0)
        self.steps = polls
    }

    // Bytes the next receive transfers deliver, in order, up to 256.
    pub fn feed(&mut self, bytes: &[u8]) {
        core.assert(bytes.len <= 256)
        for index in 0..bytes.len {
            self.input[index] = bytes[index]
        }
        self.input_length = bytes.len
    }

    // What the last finished transmit transfer sent.
    pub fn sent(&self) -> &[u8] {
        return self.sent[0..self.sent_length]
    }

    // Make the running or next transfer end with `error`.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    pub fn is_busy(&self) -> bool {
        return self.running
    }

    pub fn buffer(&mut self) -> &mut[u8]!hal.Error {
        if self.running {
            return err(hal.Error.Busy)
        }
        return ok(&mut self.storage[0..self.size])
    }

    pub fn capacity(&self) -> usize {
        return self.size
    }

    pub fn start(&mut self, count: usize) -> void!hal.Error {
        if self.running {
            return err(hal.Error.Busy)
        }
        if count == 0 || count > self.size {
            return err(hal.Error.InvalidInput)
        }
        self.running = true
        self.count = count
        self.polls = 0
        return ok()
    }

    pub fn poll_finish(&mut self) -> bool!hal.Error {
        if !self.running {
            return ok(true)
        }
        self.polls += 1
        if self.polls < self.steps {
            return ok(false)
        }
        self.running = false
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if self.receive {
            for index in 0..self.count {
                value := 0u8
                if index < self.input_length {
                    value = self.input[index]
                }
                self.storage[index] = value
            }
        } else {
            for index in 0..self.count {
                self.sent[index] = self.storage[index]
            }
            self.sent_length = self.count
        }
        return ok(true)
    }

    pub fn abort(&mut self) {
        self.running = false
    }
}

// A DMA channel that runs transfers in host memory: `start` moves every
// element at once, through real addresses, and the channel then reports
// itself busy for the number of is_busy calls set by `set_busy_polls` (0
// at first). Addresses that do not increment are read or written element
// by element, as a peripheral register would be, so a test passes the
// address of a variable standing in for the register. Pacing is ignored;
// rings are Unsupported. For testing code written against hal.DmaChannel,
// such as hal.DmaStream, on a desktop.
pub struct DmaChannel: hal.DmaChannel {
    busy_polls: u32
    busy: u32
    remaining: u32
    largest: u32
    starts: u32
    aborts: u32
    failure: bool

    pub fn new() -> DmaChannel {
        return DmaChannel { busy_polls: 0, busy: 0, remaining: 0, largest: 0xFFFF_FFFF, starts: 0, aborts: 0, failure: false }
    }

    pub fn set_busy_polls(&mut self, polls: u32) {
        self.busy_polls = polls
    }

    // The largest count a transfer may have, for max_count.
    pub fn set_max_count(&mut self, count: u32) {
        self.largest = count
    }

    // Make the next transfer report a bus error to take_error.
    pub fn fail_next(&mut self) {
        self.failure = true
    }

    // Transfers started and aborted so far.
    pub fn starts(&self) -> u32 {
        return self.starts
    }

    pub fn aborts(&self) -> u32 {
        return self.aborts
    }

    pub unsafe fn start(&mut self, transfer: hal.DmaTransfer) -> void!hal.Error {
        if self.busy != 0 {
            return err(hal.Error.Busy)
        }
        if transfer.count > self.largest {
            return err(hal.Error.InvalidInput)
        }
        match &transfer.ring {
            hal.DmaRing.None => {}
            _ => {
                return err(hal.Error.Unsupported)
            }
        }
        size := hal.dma_width_bytes(&transfer.width)
        source := transfer.source
        destination := transfer.destination
        for _ in 0..transfer.count {
            // SAFETY: the caller of start vouches for both addresses over
            // the whole transfer.
            unsafe {
                if size == 1 {
                    ptr.write_volatile(destination as *mut u8, ptr.read_volatile(source as *const u8))
                } else if size == 2 {
                    ptr.write_volatile(destination as *mut u16, ptr.read_volatile(source as *const u16))
                } else {
                    ptr.write_volatile(destination as *mut u32, ptr.read_volatile(source as *const u32))
                }
            }
            if transfer.increment_source {
                source += size
            }
            if transfer.increment_destination {
                destination += size
            }
        }
        self.starts += 1
        self.busy = self.busy_polls
        self.remaining = 0
        if self.busy != 0 {
            self.remaining = transfer.count
        }
        return ok()
    }

    pub fn is_busy(&mut self) -> bool {
        if self.busy == 0 {
            return false
        }
        self.busy -= 1
        if self.busy == 0 {
            self.remaining = 0
        }
        return true
    }

    pub fn remaining(&mut self) -> u32 {
        return self.remaining
    }

    pub fn max_count(&mut self) -> u32 {
        return self.largest
    }

    pub fn abort(&mut self) {
        if self.busy != 0 {
            self.aborts += 1
        }
        self.busy = 0
        self.remaining = 0
    }

    pub fn take_error(&mut self) -> void!hal.Error {
        if self.failure {
            self.failure = false
            return err(hal.Error.Bus)
        }
        return ok()
    }
}

// NOR flash in caller-provided memory, with the hal Flash protocol, that
// checks the protocol strictly: it refuses misaligned and out-of-range
// requests and writes over bytes that are not erased with InvalidInput, so
// code that passes its tests here also works on flash that cannot rewrite a
// byte. It counts erases and written bytes, can fail its next operation,
// and can cut the power partway through an operation or just after one, to
// test recovery:
//
//     memory := [0u8; 16384]
//     flash := fake.Flash.new(&mut memory, 4096, 4)
//     flash.erase(0, 16384)!
//
// Fresh memory holds whatever the caller filled it with; erase it first to
// start from blank flash.
pub struct Flash {
    memory: &mut[u8]
    erase_size: u32
    write_size: u32
    erases: u32
    written: u32
    operations: u32
    failure: Option<hal.Error>
    // Bytes the device may still change before the power is cut, if a cut
    // is pending, and whether the power is off.
    budget: Option<u32>
    // Erases and writes to complete before the power is cut, if a cut is
    // pending.
    countdown: Option<u32>
    off: bool

    // Flash over `memory`, whose length must be a nonzero multiple of
    // `erase_size`; both sizes must be powers of two, `write_size` at most
    // 256 and at most `erase_size`. Traps otherwise.
    pub fn new(memory: &mut[u8], erase_size: u32, write_size: u32) -> Flash from(memory) {
        core.assert(power_of_two(erase_size) && power_of_two(write_size))
        core.assert(write_size <= 256 && write_size <= erase_size)
        core.assert(memory.len > 0 && memory.len % erase_size as usize == 0)
        return Flash {
            memory,
            erase_size,
            write_size,
            erases: 0,
            written: 0,
            operations: 0,
            failure: none,
            budget: none,
            countdown: none,
            off: false,
        }
    }

    pub fn capacity(&self) -> u32 {
        return self.memory.len as u32
    }

    pub fn erase_size(&self) -> u32 {
        return self.erase_size
    }

    pub fn write_size(&self) -> u32 {
        return self.write_size
    }

    pub fn read(&mut self, offset: u32, buffer: &mut[u8]) -> void!hal.Error {
        self.begin()?
        start := self.range(offset, buffer.len as u32, 1)?
        for index in 0..buffer.len {
            buffer[index] = self.memory[start + index]
        }
        return ok()
    }

    pub fn erase(&mut self, offset: u32, length: u32) -> void!hal.Error {
        self.begin()?
        start := self.range(offset, length, self.erase_size)?
        self.erases += length / self.erase_size
        for index in 0..length as usize {
            if !self.spend() {
                return err(hal.Error.Bus)
            }
            self.memory[start + index] = hal.FLASH_ERASED
        }
        self.complete()
        return ok()
    }

    pub fn write(&mut self, offset: u32, bytes: &[u8]) -> void!hal.Error {
        self.begin()?
        start := self.range(offset, bytes.len as u32, self.write_size)?
        for index in 0..bytes.len {
            if self.memory[start + index] != hal.FLASH_ERASED {
                return err(hal.Error.InvalidInput)
            }
        }
        for index in 0..bytes.len {
            if !self.spend() {
                return err(hal.Error.Bus)
            }
            self.memory[start + index] = bytes[index]
            self.written += 1
        }
        self.complete()
        return ok()
    }

    // Blocks erased so far.
    pub fn erases(&self) -> u32 {
        return self.erases
    }

    // Bytes written so far.
    pub fn written(&self) -> u32 {
        return self.written
    }

    // Erases and writes completed so far.
    pub fn operations(&self) -> u32 {
        return self.operations
    }

    // Make the next operation fail with `error`, changing nothing.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    // Cut the power once erases and writes have changed `bytes` more bytes:
    // the operation in progress stops there, leaving the bytes it reached
    // changed and the rest as they were, and fails with Bus, as does every
    // operation after it until restore_power.
    pub fn cut_power_after(&mut self, bytes: u32) {
        self.budget = some(bytes)
    }

    // Cut the power just after `count` more erases and writes complete:
    // they succeed, and every operation after them fails with Bus until
    // restore_power. 0 cuts it now.
    pub fn cut_power_after_operations(&mut self, count: u32) {
        if count == 0 {
            self.off = true
            return
        }
        self.countdown = some(count)
    }

    // True once a cut has happened.
    pub fn is_off(&self) -> bool {
        return self.off
    }

    // Turn the power back on and cancel a pending cut.
    pub fn restore_power(&mut self) {
        self.off = false
        self.budget = none
        self.countdown = none
    }

    // The memory, for inspecting or corrupting it.
    pub fn memory(&mut self) -> &mut[u8] from(self) {
        return &mut self.memory[..]
    }

    fn begin(&mut self) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        if self.off {
            return err(hal.Error.Bus)
        }
        return ok()
    }

    // The index of `offset` after checking that `length` bytes from it are
    // inside the memory and both are multiples of `align`.
    fn range(&self, offset: u32, length: u32, align: u32) -> usize!hal.Error {
        end := offset as u64 + length as u64
        if end > self.memory.len as u64 || offset % align != 0 || length % align != 0 {
            return err(hal.Error.InvalidInput)
        }
        return ok(offset as usize)
    }

    // Count a completed erase or write, cutting the power if it was the
    // last before a pending cut.
    fn complete(&mut self) {
        self.operations += 1
        left := 0u32
        match &self.countdown {
            some(count) => {
                left = *count
            }
            none => {
                return
            }
        }
        if left <= 1 {
            self.off = true
            self.countdown = none
        } else {
            self.countdown = some(left - 1)
        }
    }

    // Use up one byte of a pending power cut's budget; false, cutting the
    // power, when none is left.
    fn spend(&mut self) -> bool {
        left := 0u32
        match &self.budget {
            some(bytes) => {
                left = *bytes
            }
            none => {
                return true
            }
        }
        if left == 0 {
            self.off = true
            self.budget = none
            return false
        }
        self.budget = some(left - 1)
        return true
    }
}

fn power_of_two(value: u32) -> bool {
    return value != 0 && (value & (value - 1)) == 0
}

// A chip's low-power controls in memory, implementing std/embedded/power's
// protocol. Every clock starts running, awake and in deep sleep. The test
// says which clocks the simulated program cannot run without, which ones
// the simulated chip manages for peripherals, and which of those are
// claimed, and the fake records the sleeps and dormant states the code
// under test asks for. A dormant state ends on the pins given to
// `wake_next_dormant`; one that nothing could end traps instead of
// hanging the test.
pub struct Power {
    deep: bool
    enabled: u64
    sleeping: u64
    essential: u64
    managed: u64
    claimed: u64
    light_sleeps: u32
    deep_sleeps: u32
    dormant_states: u32
    // The pins and events that end the next dormant state.
    wake_pins: u64
    // The events the last dormant state waited for, per pin.
    requested: [64]u8

    // Clocks 0 to 63 all exist. `essential` cannot be disabled, and
    // `managed` belong to peripherals, which disable_unused_clocks stops
    // unless claimed.
    pub fn new(essential: power.Clocks, managed: power.Clocks) -> Power {
        return Power {
            deep: false,
            enabled: 0xFFFF_FFFF_FFFF_FFFFu64,
            sleeping: 0xFFFF_FFFF_FFFF_FFFFu64,
            essential,
            managed,
            claimed: 0,
            light_sleeps: 0,
            deep_sleeps: 0,
            dormant_states: 0,
            wake_pins: 0,
            requested: [0u8; 64],
        }
    }

    // Claim a peripheral's clocks, as a chip does when the program takes
    // the peripheral: they start and can no longer be disabled.
    pub fn claim(&mut self, clocks: power.Clocks) {
        self.claimed |= clocks
        self.enabled |= clocks
    }

    // Give a peripheral's clocks back, as a chip does when the program
    // releases the peripheral.
    pub fn release(&mut self, clocks: power.Clocks) {
        self.claimed &= ~clocks
    }

    pub fn claimed(&self) -> power.Clocks {
        return self.claimed
    }

    // End the next dormant state as if `pins` (bit n for pin n) changed;
    // only those the dormant state waits for wake it.
    pub fn wake_next_dormant(&mut self, pins: u64) {
        self.wake_pins = pins
    }

    // Waits in each mode, and dormant states, so far.
    pub fn light_sleeps(&self) -> u32 {
        return self.light_sleeps
    }

    pub fn deep_sleeps(&self) -> u32 {
        return self.deep_sleeps
    }

    pub fn dormant_states(&self) -> u32 {
        return self.dormant_states
    }

    // The events of `pin` the last dormant state waited for.
    pub fn requested_events(&self, pin: u32) -> u32 {
        if pin >= power.MAX_PINS {
            return 0
        }
        return self.requested[pin as usize] as u32
    }

    pub fn mode(&self) -> power.Mode {
        if self.deep {
            return power.Mode.DeepSleep
        }
        return power.Mode.Sleep
    }

    pub fn set_mode(&mut self, mode: power.Mode) {
        self.deep = mode == power.Mode.DeepSleep
    }

    // Returns at once, as if an interrupt were pending, and counts the wait.
    pub fn sleep(&mut self) {
        if self.deep {
            self.deep_sleeps += 1
        } else {
            self.light_sleeps += 1
        }
    }

    pub fn enabled_clocks(&self) -> power.Clocks {
        return self.enabled
    }

    pub fn enable_clocks(&mut self, clocks: power.Clocks) {
        self.enabled |= clocks
    }

    pub fn disable_clocks(&mut self, clocks: power.Clocks) -> void!hal.Error {
        if (clocks & self.essential) != 0 {
            return err(hal.Error.InvalidInput)
        }
        if (clocks & self.claimed) != 0 {
            return err(hal.Error.Busy)
        }
        self.enabled &= ~clocks
        return ok()
    }

    pub fn disable_unused_clocks(&mut self) -> power.Clocks {
        unused := self.managed & ~self.claimed & self.enabled
        self.enabled &= ~unused
        return unused
    }

    pub fn sleep_clocks(&self) -> power.Clocks {
        return self.sleeping
    }

    pub fn set_sleep_clocks(&mut self, clocks: power.Clocks) {
        self.sleeping = clocks
    }

    pub fn dormant(&mut self, wake: &power.Wake) -> u64!hal.Error {
        waiting := wake.pins()
        if waiting == 0 {
            return err(hal.Error.InvalidInput)
        }
        for index in 0u32..64 {
            self.requested[index as usize] = wake.events(index) as u8
        }
        woken := waiting & self.wake_pins
        // Nothing would ever end this dormant state.
        core.assert(woken != 0)
        self.wake_pins = 0
        self.dormant_states += 1
        return ok(woken)
    }
}

// A real-time clock with an alarm, implementing hal.Rtc and hal.RtcAlarm.
// It starts unset, as a clock that has just been powered, and keeps time
// only as `advance` says. Its resolution is 1 ms unless made coarser, so
// drivers are tested against clocks that count whole seconds too.
pub struct Rtc: hal.Rtc + hal.RtcAlarm {
    // Milliseconds since the epoch, exactly, while `set`.
    time: u64
    set: bool
    resolution: u32
    alarm: u64
    armed: bool
    failure: Option<hal.Error>

    // An unset clock that counts milliseconds.
    pub fn new() -> Rtc {
        return Rtc.with_resolution(1)
    }

    // An unset clock whose steps are `resolution_ms` long, such as 1000
    // for one that counts seconds; at least 1.
    pub fn with_resolution(resolution_ms: u32) -> Rtc {
        core.assert(resolution_ms > 0)
        return Rtc { time: 0, set: false, resolution: resolution_ms, alarm: 0, armed: false, failure: none }
    }

    // Let `milliseconds` pass. An unset clock stays unset.
    pub fn advance(&mut self, milliseconds: u64) {
        if self.set {
            self.time += milliseconds
        }
    }

    // Lose power: the time is gone and the alarm disarmed, as when a
    // backup battery runs out.
    pub fn lose_power(&mut self) {
        self.set = false
        self.time = 0
        self.armed = false
    }

    // True from set_alarm_ms until clear_alarm or a loss of power.
    pub fn is_armed(&self) -> bool {
        return self.armed
    }

    // The time the alarm was last set for.
    pub fn alarm_ms(&self) -> u64 {
        return self.alarm
    }

    // Make the next operation fail with `error`, as a clock chip on a bus
    // may, for testing error paths.
    pub fn fail_next(&mut self, error: hal.Error) {
        self.failure = some(error)
    }

    fn begin(&mut self) -> void!hal.Error {
        if let some(error) = option.take(&mut self.failure) {
            return err(error)
        }
        return ok()
    }

    fn shown(&self) -> u64 {
        return self.time - self.time % self.resolution as u64
    }

    pub fn is_set(&mut self) -> bool!hal.Error {
        self.begin()?
        return ok(self.set)
    }

    pub fn now_ms(&mut self) -> u64!hal.Error {
        self.begin()?
        if !self.set {
            return err(hal.Error.Busy)
        }
        return ok(self.shown())
    }

    pub fn set_ms(&mut self, time_ms: u64) -> void!hal.Error {
        self.begin()?
        self.time = time_ms
        self.set = true
        return ok()
    }

    pub fn resolution_ms(&self) -> u32 {
        return self.resolution
    }

    pub fn set_alarm_ms(&mut self, time_ms: u64) -> void!hal.Error {
        self.begin()?
        if !self.set {
            return err(hal.Error.Busy)
        }
        self.alarm = time_ms
        self.armed = true
        return ok()
    }

    pub fn alarm_fired(&mut self) -> bool!hal.Error {
        self.begin()?
        return ok(self.armed && self.set && self.shown() >= self.alarm)
    }

    pub fn clear_alarm(&mut self) -> void!hal.Error {
        self.begin()?
        self.armed = false
        return ok()
    }
}
