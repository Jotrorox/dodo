package ssd1306

import "std/embedded/display"
import "std/embedded/hal"
import "std/graphics"

// Solomon Systech SSD1306 monochrome OLED controllers, as on the common
// 0.91" 128x32 and 0.96" 128x64 modules, through any display.Interface:
// display.I2cInterface at ADDRESS for I2C modules, or display.SpiInterface
// for SPI ones. Implements graphics.Display with Mono1 pixels; other canvas
// formats are converted, lighting pixels whose luma is 128 or more, as a
// Mono1 canvas stores them.
//
//     bus := b.pins.i2c(board.I2C_SDA_PIN, board.I2C_SCL_PIN, hal.I2C_FAST_HZ)!
//     oled := ssd1306.Display.new(display.I2cInterface.new(bus, ssd1306.ADDRESS), ssd1306.panel_128x64())!
//     pixels := [0u8; 128 * 64 / 8]
//     canvas := graphics.canvas(&mut pixels, 128, 64, graphics.PixelFormat.Mono1)!
//     canvas.text(&small, 0, 0, "Hello", graphics.WHITE)
//     graphics.present(&mut oled, &mut canvas)!
//
// The controller stores pixels in pages: bytes holding a column of eight
// rows. The driver keeps a copy of the panel's memory, 1 KiB at most, so a
// present changes only the pixels it covers and sends only the pages and
// columns of its dirty rectangle.

// The usual I2C addresses, chosen by a jumper or pad on the module.
pub const ADDRESS: u8 = 0x3C
pub const ALTERNATE_ADDRESS: u8 = 0x3D

// Commands, from the SSD1306 datasheet.
const SET_MEMORY_MODE: u8 = 0x20
const SET_COLUMN_RANGE: u8 = 0x21
const SET_PAGE_RANGE: u8 = 0x22
const DEACTIVATE_SCROLL: u8 = 0x2E
const SET_START_LINE: u8 = 0x40
const SET_CONTRAST: u8 = 0x81
const SET_CHARGE_PUMP: u8 = 0x8D
const SEGMENT_NORMAL: u8 = 0xA0
const SEGMENT_REMAPPED: u8 = 0xA1
const RESUME_FROM_MEMORY: u8 = 0xA4
const NORMAL: u8 = 0xA6
const INVERTED: u8 = 0xA7
const SET_MULTIPLEX: u8 = 0xA8
const DISPLAY_OFF: u8 = 0xAE
const DISPLAY_ON: u8 = 0xAF
const SCAN_UP: u8 = 0xC0
const SCAN_DOWN: u8 = 0xC8
const SET_DISPLAY_OFFSET: u8 = 0xD3
const SET_CLOCK: u8 = 0xD5
const SET_PRECHARGE: u8 = 0xD9
const SET_COM_PINS: u8 = 0xDA
const SET_VCOM_DETECT: u8 = 0xDB

// The controller's memory: 128 columns of 8 pages.
pub const MEMORY_WIDTH: u32 = 128
pub const MEMORY_HEIGHT: u32 = 64
const MEMORY_BYTES: usize = 1024

// How a panel is wired to the controller: its size, the memory column of its
// left edge, and whether its rows alternate between the controller's two COM
// pin banks, as on 64- and 48-row panels.
pub struct Panel {
    pub width: u32
    pub height: u32
    pub column_offset: u32
    pub alternative_com_pins: bool
}

// 0.96" and 1.3" modules.
pub fn panel_128x64() -> Panel {
    return Panel { width: 128, height: 64, column_offset: 0, alternative_com_pins: true }
}

// 0.91" modules.
pub fn panel_128x32() -> Panel {
    return Panel { width: 128, height: 32, column_offset: 0, alternative_com_pins: false }
}

// 0.69" modules.
pub fn panel_96x16() -> Panel {
    return Panel { width: 96, height: 16, column_offset: 0, alternative_com_pins: false }
}

// 0.66" modules, such as the Wemos D1 mini OLED shield.
pub fn panel_64x48() -> Panel {
    return Panel { width: 64, height: 48, column_offset: 32, alternative_com_pins: true }
}

// 0.42" modules.
pub fn panel_72x40() -> Panel {
    return Panel { width: 72, height: 40, column_offset: 28, alternative_com_pins: true }
}

pub struct Display<I: display.Interface> {
    wiring: I
    width: u32
    height: u32
    column_offset: u32
    // Page p, column c (from the panel's left edge) at p * width + c; bit
    // n is row 8p + n.
    memory: [1024]u8

    // Set the controller up for `panel`, with its charge pump on (the
    // modules above have no separate panel supply), clear the panel, and
    // switch it on. InvalidInput if the panel does not fit the controller
    // or its height is not a multiple of 8.
    pub fn new(wiring: I, panel: Panel) -> Display<I>!hal.Error from(wiring) {
        if panel.width == 0 || panel.height == 0 || panel.height % 8 != 0 || panel.height > MEMORY_HEIGHT || panel.column_offset as u64 + panel.width as u64 > MEMORY_WIDTH as u64 {
            return err(hal.Error.InvalidInput)
        }
        oled := Display<I> { wiring, width: panel.width, height: panel.height, column_offset: panel.column_offset, memory: [0u8; 1024] }
        com_pins := 0x02u8
        contrast := 0x8Fu8
        if panel.alternative_com_pins {
            com_pins = 0x12
            contrast = 0xCF
        }
        oled.command1(DISPLAY_OFF)?
        oled.command2(SET_CLOCK, 0x80)?
        oled.command2(SET_MULTIPLEX, (panel.height - 1) as u8)?
        oled.command2(SET_DISPLAY_OFFSET, 0)?
        oled.command1(SET_START_LINE)?
        oled.command2(SET_CHARGE_PUMP, 0x14)?
        // Horizontal addressing: data fills a window's columns, then moves
        // to the next page.
        oled.command2(SET_MEMORY_MODE, 0x00)?
        oled.command1(SEGMENT_REMAPPED)?
        oled.command1(SCAN_DOWN)?
        oled.command2(SET_COM_PINS, com_pins)?
        oled.command2(SET_CONTRAST, contrast)?
        oled.command2(SET_PRECHARGE, 0xF1)?
        oled.command2(SET_VCOM_DETECT, 0x40)?
        oled.command1(RESUME_FROM_MEMORY)?
        oled.command1(NORMAL)?
        oled.command1(DEACTIVATE_SCROLL)?
        width := oled.width
        height := oled.height
        oled.send_pages(0, height / 8, 0, width)?
        oled.command1(DISPLAY_ON)?
        return ok(oled)
    }

    pub fn size(&self) -> graphics.Size {
        return graphics.Size.new(self.width, self.height)
    }

    pub fn format(&self) -> graphics.PixelFormat {
        return graphics.PixelFormat.Mono1
    }

    // Copy the part of `dirty` inside both the canvas and the display into
    // the driver's copy of the panel memory and send the pages it touches.
    // On failure the copy is already updated, so presenting the same
    // rectangle again (as graphics.present does after a failure) resends it.
    pub fn present(&mut self, canvas: &graphics.Canvas, dirty: graphics.Rect) -> void!graphics.Error {
        area := display.visible(canvas, dirty, self.width, self.height)
        if area.is_empty() {
            return ok()
        }
        self.copy(canvas, &area)
        left := area.x as u32
        top := area.y as u32
        bottom := top + area.height
        match self.send_pages(top / 8, (bottom + 7) / 8, left, left + area.width) {
            ok() => {
                return ok()
            }
            err(_) => {
                return err(graphics.Error.Device)
            }
        }
    }

    // Whether the pixel at (x, y) is lit in the panel memory as last sent,
    // or false outside the display.
    pub fn is_lit(&self, x: u32, y: u32) -> bool {
        if x >= self.width || y >= self.height {
            return false
        }
        byte := self.memory[(y / 8 * self.width + x) as usize]
        return (byte & (1u8 << ((y % 8) as u8))) != 0
    }

    // Brightness from 0 to 255.
    pub fn set_contrast(&mut self, contrast: u8) -> void!hal.Error {
        return self.command2(SET_CONTRAST, contrast)
    }

    // Light the unlit pixels and darken the lit ones.
    pub fn set_inverted(&mut self, inverted: bool) -> void!hal.Error {
        if inverted {
            return self.command1(INVERTED)
        }
        return self.command1(NORMAL)
    }

    // Switch the panel off, which also stops its charge pump, or on again.
    // The memory is kept, and presents still update it while it is off.
    pub fn set_display_on(&mut self, on: bool) -> void!hal.Error {
        if on {
            return self.command1(DISPLAY_ON)
        }
        return self.command1(DISPLAY_OFF)
    }

    // Turn the picture upside down, for a module mounted the other way up,
    // and resend it.
    pub fn set_flipped(&mut self, flipped: bool) -> void!hal.Error {
        if flipped {
            self.command1(SEGMENT_NORMAL)?
            self.command1(SCAN_UP)?
        } else {
            self.command1(SEGMENT_REMAPPED)?
            self.command1(SCAN_DOWN)?
        }
        width := self.width
        height := self.height
        return self.send_pages(0, height / 8, 0, width)
    }

    // The interface, for example to reach its bus between frames.
    pub fn wiring(&mut self) -> &mut I from(self) {
        return &mut self.wiring
    }

    // Give back the interface.
    pub fn release(self) -> I from(self) {
        let Display { wiring, width, height, column_offset, memory } = self
        return wiring
    }

    fn command1(&mut self, code: u8) -> void!hal.Error {
        bytes: [1]u8 = [code]
        return self.wiring.write_command(&bytes)
    }

    fn command2(&mut self, code: u8, value: u8) -> void!hal.Error {
        bytes: [2]u8 = [code, value]
        return self.wiring.write_command(&bytes)
    }

    // Update the memory copy inside `area`, which is inside both the
    // canvas and the display.
    fn copy(&mut self, canvas: &graphics.Canvas, area: &graphics.Rect) {
        bounds := canvas.bounds()
        mono := canvas.format() == graphics.PixelFormat.Mono1
        width := self.width as usize
        for y in area.y..area.y + area.height as i32 {
            page := y as usize / 8 * width
            bit := 1u8 << ((y % 8) as u8)
            line := canvas.row((y - bounds.y) as u32)
            for x in area.x..area.x + area.width as i32 {
                lit := false
                if mono {
                    column := (x - bounds.x) as usize
                    lit = (line[column / 8] & (0x80u8 >> ((column % 8) as u8))) != 0
                } else {
                    match canvas.color_at(x, y) {
                        some(color) => {
                            lit = graphics.luma(color) >= 128
                        }
                        none => {}
                    }
                }
                index := page + x as usize
                if lit {
                    self.memory[index] = self.memory[index] | bit
                } else {
                    self.memory[index] = self.memory[index] & ~bit
                }
            }
        }
    }

    // Send pages first..end, columns left..right, from the memory copy.
    fn send_pages(&mut self, first: u32, end: u32, left: u32, right: u32) -> void!hal.Error {
        columns: [3]u8 = [SET_COLUMN_RANGE, (left + self.column_offset) as u8, (right - 1 + self.column_offset) as u8]
        self.wiring.write_command(&columns)?
        pages: [3]u8 = [SET_PAGE_RANGE, first as u8, (end - 1) as u8]
        self.wiring.write_command(&pages)?
        width := self.width as usize
        for page in first as usize..end as usize {
            start := page * width
            self.wiring.write_data(&self.memory[start + left as usize..start + right as usize])?
        }
        return ok()
    }
}
