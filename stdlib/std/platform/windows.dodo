package windows

import "core/ptr"
import "core/mem"
import "std/text"
import "std/io"
import "std/platform/error"

// Native code units including exactly one final NUL. Interior NUL is rejected.
// Unix bytes are never implicitly decoded; Windows u16 may contain unpaired
// surrogates. The borrow keeps caller-owned storage alive across foreign calls.
pub struct NativeString {
    data: &[u16]
    pub fn new(units: &[u16]) -> NativeString!error.Error from(units) {
        if units.len == 0 || units[units.len - 1] != 0 {
            return err(error.failure(error.Kind.InvalidInput))
        }
        for i in 0usize..units.len - 1 {
            if units[i] == 0 {
                return err(error.failure(error.Kind.InvalidInput))
            }
        }
        return ok(NativeString { data: units })
    }
    pub fn as_ptr(&self) -> *const u16 {
        return ptr.as_ptr(self.data)
    }
    pub fn units(&self) -> &[u16] {
        return &self.data[..self.data.len - 1]
    }
    pub fn terminated(&self) -> &[u16] {
        return self.data
    }
}

// Consecutive NUL-terminated native strings. Empty lists are valid. A final
// empty element is represented by an additional NUL; no implicit sentinel.
pub struct NativeList {
    data: &[u16]
    pub fn new(units: &[u16]) -> NativeList!error.Error from(units) {
        if units.len != 0 && units[units.len - 1] != 0 {
            return err(error.failure(error.Kind.InvalidInput))
        }
        return ok(NativeList { data: units })
    }
    pub fn as_ptr(&self) -> *const u16 {
        return ptr.as_ptr(self.data)
    }
    pub fn units(&self) -> &[u16] {
        return self.data
    }
}

fn io_error(reason: error.Error) -> io.Error {
    kind := io.ErrorKind.Other
    if reason.kind == error.Kind.Interrupted {
        kind = io.ErrorKind.Interrupted
    }
    if reason.kind == error.Kind.InvalidInput {
        kind = io.ErrorKind.InvalidInput
    }
    if reason.kind == error.Kind.WouldBlock {
        kind = io.ErrorKind.WouldBlock
    }
    if reason.kind == error.Kind.TimedOut {
        kind = io.ErrorKind.TimedOut
    }
    if reason.kind == error.Kind.Cancelled {
        kind = io.ErrorKind.Cancelled
    }
    if reason.kind == error.Kind.Closed {
        kind = io.ErrorKind.Closed
    }
    if reason.kind == error.Kind.PermissionDenied {
        kind = io.ErrorKind.PermissionDenied
    }
    if reason.kind == error.Kind.BrokenPipe {
        kind = io.ErrorKind.BrokenPipe
    }
    return io.Error { kind: kind, transferred: 0, code: reason.code }
}

unsafe extern "C" fn GetStdHandle(kind: u32) -> isize
unsafe extern "C" fn GetLastError() -> u32
unsafe extern "C" fn CloseHandle(handle: *mut u8) -> i32
unsafe extern "C" fn ReadFile(handle: *mut u8, data: *mut u8, size: u32, count: *mut u32, overlapped: *mut u8) -> i32
unsafe extern "C" fn WriteFile(handle: *mut u8, data: *const u8, size: u32, count: *mut u32, overlapped: *mut u8) -> i32
unsafe extern "C" fn SetFilePointerEx(handle: *mut u8, offset: i64, position: *mut i64, origin: u32) -> i32
unsafe extern "C" fn FlushFileBuffers(handle: *mut u8) -> i32
unsafe extern "C" fn SetFileInformationByHandle(handle: *mut u8, kind: i32, information: *mut u8, size: u32) -> i32

pub fn from_code(code: i32) -> error.Error {
    kind := error.Kind.Other
    if code == 2 || code == 3 {
        kind = error.Kind.NotFound
    }
    if code == 80 || code == 183 {
        kind = error.Kind.AlreadyExists
    }
    if code == 5 {
        kind = error.Kind.PermissionDenied
    }
    if code == 17 {
        kind = error.Kind.CrossDevice
    }
    if code == 87 || code == 123 {
        kind = error.Kind.InvalidInput
    }
    if code == 1 || code == 50 || code == 120 {
        kind = error.Kind.Unsupported
    }
    if code == 145 {
        kind = error.Kind.DirectoryNotEmpty
    }
    if code == 267 {
        kind = error.Kind.NotDirectory
    }
    if code == 122 || code == 206 {
        kind = error.Kind.BufferTooSmall
    }
    if code == 109 {
        kind = error.Kind.BrokenPipe
    }
    if code == 6 {
        kind = error.Kind.Closed
    }
    if code == 995 {
        kind = error.Kind.Cancelled
    }
    if code == 1460 || code == 258 {
        kind = error.Kind.TimedOut
    }
    // ERROR_NO_DATA is also used by a nonblocking pipe read with no data.
    if code == 997 || code == 232 {
        kind = error.Kind.WouldBlock
    }
    return error.Error { kind: kind, code: code }
}
pub fn last_error() -> error.Error {
    unsafe {
        // Preserve every native code bit, including codes with the high bit set.
        code := GetLastError()
        return from_code(ptr.read_unaligned(ptr.from_ref(&code) as *const i32))
    }
}

pub fn from_utf8(value: &str, bytes: &mut[u8], wide: &mut[u16]) -> NativeString!error.Error from(bytes, wide) {
    source := mem.str_bytes(value)
    offset := 0usize
    used := 0usize
    for offset < source.len {
        scalar := 0u32
        match text.decode(source, offset) {
            ok(decoded) => {
                scalar = decoded.scalar;
                offset = decoded.next
            }
            err(_) => {
                return err(error.failure(error.Kind.InvalidInput))
            }
        }
        if scalar <= 65535 {
            if used >= wide.len {
                return err(error.failure(error.Kind.BufferTooSmall))
            }
            wide[used] = scalar as u16
            used += 1
        } else {
            if wide.len - used < 2 {
                return err(error.failure(error.Kind.BufferTooSmall))
            }
            scalar -= 65536
            wide[used] = (55296 + (scalar >> 10)) as u16
            wide[used + 1] = (56320 + (scalar & 1023)) as u16
            used += 2
        }
    }
    if used >= wide.len {
        return err(error.failure(error.Kind.BufferTooSmall))
    }
    wide[used] = 0
    return NativeString.new(&wide[..used + 1])
}
pub fn to_utf8(value: &NativeString, output: &mut[u8], lossy: bool) -> usize!error.Error {
    source := value.units()
    offset := 0usize
    used := 0usize
    for offset < source.len {
        scalar := source[offset] as u32
        offset += 1
        if scalar >= 55296 && scalar <= 57343 {
            if scalar <= 56319 && offset < source.len && source[offset] >= 56320 && source[offset] <= 57343 {
                scalar = 65536 + ((scalar - 55296) << 10) + ((source[offset] as u32) - 56320)
                offset += 1
            } else {
                if!lossy {
                    return err(error.failure(error.Kind.InvalidInput))
                }
                scalar = 65533
            }
        }
        match text.encode(scalar, &mut output[used..]) {
            ok(count) => {
                used += count
            }
            err(_) => {
                return err(error.failure(error.Kind.BufferTooSmall))
            }
        }
    }
    return ok(used)
}

// Unique synchronous, non-inheritable Win32 HANDLE, INVALID_HANDLE_VALUE=-1.
pub struct Handle {
    value: isize
    pub unsafe fn from_raw(raw: isize) -> Handle {
        return Handle { value: raw }
    }
    pub fn raw(&self) -> isize {
        return self.value
    }
    pub fn close(&mut self) -> void!error.Error {
        if self.value == -1 {
            return ok()
        }
        previous := self.value
        self.value = -1
        unsafe {
            if CloseHandle(previous as *mut u8) == 0 {
                return err(last_error())
            }
        }
        return ok()
    }
    fn drop(&mut self) {
        match self.close() {
            ok() => {}
            err(_) => {}
        }
    }
    pub fn read(&mut self, output: &mut[u8]) -> usize!io.Error {
        return read_handle(self.value, output)
    }
    pub fn write(&mut self, input: &[u8]) -> usize!io.Error {
        return write_handle(self.value, input)
    }
    pub fn seek(&mut self, position: usize) -> usize!io.Error {
        if position > 9223372036854775807usize {
            return err(io.failure(io.ErrorKind.OutOfBounds, 0))
        }
        next := 0i64
        unsafe {
            if SetFilePointerEx(self.value as *mut u8, position as i64, ptr.from_mut(&mut next), 0) == 0 {
                return err(io_error(last_error()))
            }
        }
        return ok(next as usize)
    }
    pub fn sync(&mut self) -> void!error.Error {
        unsafe {
            if FlushFileBuffers(self.value as *mut u8) == 0 {
                return err(last_error())
            }
        }
        return ok()
    }
    pub fn truncate(&mut self, length: u64) -> void!error.Error {
        if length > 9223372036854775807u64 {
            return err(error.failure(error.Kind.InvalidInput))
        }
        // FILE_END_OF_FILE_INFO: a single LARGE_INTEGER, x64 alignment eight.
        information := length as i64
        unsafe {
            if SetFileInformationByHandle(self.value as *mut u8, 6, ptr.from_mut(&mut information) as *mut u8, 8) == 0 {
                return err(last_error())
            }
        }
        return ok()
    }
}

// Bounded inline native text storage. Units include the terminating NUL.
// Only the selected platform representation is stored; no allocation occurs.
pub const TEXT_CAPACITY: usize = 4096
pub const LIST_CAPACITY: usize = 32768
fn utf8_units(value: &str) -> usize!error.Error {
    source := mem.str_bytes(value)
    count := 1usize
    offset := 0usize
    for offset < source.len {
        decoded := match text.decode(source, offset) {
            ok(value) => {
                value
            }, err(_) => {
                return err(error.failure(error.Kind.InvalidInput))
            }
        }
        if decoded.scalar == 0 {
            return err(error.failure(error.Kind.InvalidInput))
        }
        count += 1
        if decoded.scalar > 65535 {
            count += 1
        }
        offset = decoded.next
    }
    return ok(count)
}
pub struct Workspace {
    data: [1024]u64
    used: usize
    pub fn new() -> Workspace {
        return Workspace { data: [0u64; 1024], used: 1 }
    }
    // Failure preserves the previous string. All capacity checks precede writes.
    pub fn set(&mut self, value: &str) -> void!error.Error {
        required := utf8_units(value)?
        if required > TEXT_CAPACITY {
            return err(error.failure(error.Kind.BufferTooSmall))
        }
        unused := [0u8; 0]
        {
            encoded := from_utf8(value, &mut unused, self.buffer())?
        }
        self.used = required
        return ok()
    }
    pub fn get(&self) -> NativeString!error.Error {
        return NativeString.new(&self.units()[..self.used])
    }
    // Native observations use separate caller-owned storage. commit validates
    // the returned length and terminator before publishing a view.
    pub fn buffer(&mut self) -> &mut[u16] {
        unsafe {
            address := ptr.from_mut(&mut self.data) as *mut u16
            capacity := self.data.len * 8 / mem.size_of::<u16>()
            return ptr.borrow_slice_mut(address, capacity, self)
        }
    }
    fn units(&self) -> &[u16] {
        unsafe {
            return ptr.borrow_slice(ptr.from_ref(&self.data) as *const u16, self.data.len * 8 / mem.size_of::<u16>(), self)
        }
    }
    pub fn commit(&mut self, used: usize) -> void!error.Error {
        if used > TEXT_CAPACITY {
            return err(error.failure(error.Kind.BufferTooSmall))
        }
        {
            value := NativeString.new(&self.units()[..used])?
        }
        self.used = used
        return ok()
    }
}
pub struct ListWorkspace {
    data: [8192]u64
    used: usize
    pub fn new() -> ListWorkspace {
        return ListWorkspace { data: [0u64; 8192], used: 0 }
    }
    pub fn empty(&self) -> NativeList {
        return NativeList { data: &self.units()[..0] }
    }
    pub fn len_units(&self) -> usize {
        return self.used
    }
    pub fn clear(&mut self) {
        self.used = 0
    }
    // Each call appends exactly one argument, including an empty argument.
    // Failed append preserves all previous arguments and the logical length.
    pub fn push(&mut self, value: &str) -> void!error.Error {
        required := utf8_units(value)?
        if required > LIST_CAPACITY - self.used {
            return err(error.failure(error.Kind.BufferTooSmall))
        }
        offset := self.used
        unused := [0u8; 0]
        {
            encoded := from_utf8(value, &mut unused, &mut self.buffer()[offset..])?
        }
        self.used += required
        return ok()
    }
    pub fn get(&self) -> NativeList!error.Error {
        return NativeList.new(&self.units()[..self.used])
    }
    pub fn buffer(&mut self) -> &mut[u16] {
        unsafe {
            address := ptr.from_mut(&mut self.data) as *mut u16
            capacity := self.data.len * 8 / mem.size_of::<u16>()
            return ptr.borrow_slice_mut(address, capacity, self)
        }
    }
    fn units(&self) -> &[u16] {
        unsafe {
            return ptr.borrow_slice(ptr.from_ref(&self.data) as *const u16, self.data.len * 8 / mem.size_of::<u16>(), self)
        }
    }
    pub fn commit(&mut self, used: usize) -> void!error.Error {
        if used > LIST_CAPACITY {
            return err(error.failure(error.Kind.BufferTooSmall))
        }
        {
            value := NativeList.new(&self.units()[..used])?
        }
        self.used = used
        return ok()
    }
}

fn read_handle(handle: isize, output: &mut[u8]) -> usize!io.Error {
    if output.len == 0 {
        return ok(0)
    }
    request := output.len
    if request > 4294967295usize {
        request = 4294967295usize
    }
    count := 0u32
    unsafe {
        if ReadFile(handle as *mut u8, ptr.as_mut_ptr(output), request as u32, ptr.from_mut(&mut count), 0usize as *mut u8) == 0 {
            reason := last_error()
            if reason.code == 109 || reason.code == 38 {
                return ok(count as usize)
            }
            reason_io := io_error(reason)
            reason_io.transferred = count as usize
            return err(reason_io)
        }
    }
    return ok(count as usize)
}

fn write_handle(handle: isize, input: &[u8]) -> usize!io.Error {
    if input.len == 0 {
        return ok(0)
    }
    request := input.len
    if request > 4294967295usize {
        request = 4294967295usize
    }
    count := 0u32
    unsafe {
        if WriteFile(handle as *mut u8, ptr.as_ptr(input), request as u32, ptr.from_mut(&mut count), 0usize as *mut u8) == 0 {
            reason := io_error(last_error())
            reason.transferred = count as usize
            return err(reason)
        }
    }
    return ok(count as usize)
}

// Borrowed process standard stream: deliberately has no close or destructor.
// Native replacement/closure by foreign code is observed as ordinary I/O.
pub struct BorrowedHandle {
    value: isize
    pub fn read(&mut self, output: &mut[u8]) -> usize!io.Error {
        return read_handle(self.value, output)
    }
    pub fn write(&mut self, input: &[u8]) -> usize!io.Error {
        return write_handle(self.value, input)
    }
}
// DWORD spellings of STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
// (-10, -11, -12); signed-to-unsigned numeric casts would be checked.
pub fn stdin() -> BorrowedHandle {
    value := unsafe {
        GetStdHandle(4294967286)
    }
    return BorrowedHandle { value: value }
}
pub fn stdout() -> BorrowedHandle {
    value := unsafe {
        GetStdHandle(4294967285)
    }
    return BorrowedHandle { value: value }
}
pub fn stderr() -> BorrowedHandle {
    value := unsafe {
        GetStdHandle(4294967284)
    }
    return BorrowedHandle { value: value }
}
