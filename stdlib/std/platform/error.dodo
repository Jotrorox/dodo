package error

import "std/io"

// The domain is the selected hosted adapter: errno on Linux, GetLastError on
// Windows. Library-generated errors use code zero; native codes are retained.
pub enum Kind {
    InvalidInput, Unsupported, NotFound, AlreadyExists, PermissionDenied,
    Interrupted, WouldBlock, TimedOut, Cancelled, BufferTooSmall, CrossDevice,
    NotDirectory, IsDirectory, DirectoryNotEmpty, Closed, Other, BrokenPipe
}
pub struct Error {
    pub kind: Kind
    pub code: i32
    // Only fixed kind names and numeric metadata; never input or native messages.
    pub fn format<F>(&self, output: &mut F) -> void!io.Error {
        output.string("platform/error: ")?
        match &self.kind {
            Kind.InvalidInput => {
                output.string("InvalidInput")?
            }
            Kind.Unsupported => {
                output.string("Unsupported")?
            }
            Kind.NotFound => {
                output.string("NotFound")?
            }
            Kind.AlreadyExists => {
                output.string("AlreadyExists")?
            }
            Kind.PermissionDenied => {
                output.string("PermissionDenied")?
            }
            Kind.Interrupted => {
                output.string("Interrupted")?
            }
            Kind.WouldBlock => {
                output.string("WouldBlock")?
            }
            Kind.TimedOut => {
                output.string("TimedOut")?
            }
            Kind.Cancelled => {
                output.string("Cancelled")?
            }
            Kind.BufferTooSmall => {
                output.string("BufferTooSmall")?
            }
            Kind.CrossDevice => {
                output.string("CrossDevice")?
            }
            Kind.NotDirectory => {
                output.string("NotDirectory")?
            }
            Kind.IsDirectory => {
                output.string("IsDirectory")?
            }
            Kind.DirectoryNotEmpty => {
                output.string("DirectoryNotEmpty")?
            }
            Kind.Closed => {
                output.string("Closed")?
            }
            Kind.Other => {
                output.string("Other")?
            }
            Kind.BrokenPipe => {
                output.string("BrokenPipe")?
            }
        }
        output.string(" code=")?
        output.decimal(self.code as i64)?
        return ok()
    }
}
pub fn failure(kind: Kind) -> Error {
    return Error { kind: kind, code: 0 }
}
