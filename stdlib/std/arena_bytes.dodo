package arena_bytes

import "alloc/arena"
import "alloc/error"
import "std/bytes_alloc"

pub fn new(allocator: &mut arena.Arena, capacity: usize, limit: usize) -> bytes_alloc.Buffer<arena.Arena>!error.AllocError from(allocator) {
    unsafe {
        return bytes_alloc.new(allocator, capacity, limit)
    }
}
