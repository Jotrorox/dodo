package lua

import "core/ptr"

// TEMPORARY stand-in for number.dodo's numeral converter, used by the
// compiler until the real one lands. Delete this file at merge.

@link_name("strtod")
unsafe extern "C" fn tsi_strtod(text: *const u8, end: *mut *mut u8) -> f64

fn tsi_space(c: u8) -> bool {
    return c == 32 || (c >= 9 && c <= 13)
}

fn tsi_hex(c: u8) -> i32 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i32
    }
    if c >= 97 && c <= 102 {
        return (c - 87) as i32
    }
    if c >= 65 && c <= 70 {
        return (c - 55) as i32
    }
    return -1
}

// Convert a numeral: 0 = malformed, 1 = integer (ival), 2 = float (fval).
fn num_string_to_number(text: &[u8], ival: &mut i64, fval: &mut f64) -> u32 {
    let n = text.len
    i := 0usize
    for i < n && tsi_space(text[i]) {
        i = i + 1
    }
    neg := false
    if i < n && (text[i] == 45 || text[i] == 43) {
        neg = text[i] == 45
        i = i + 1
    }
    // Integer forms: hexadecimal wraps around, decimal must not overflow.
    j := i
    a := 0u64
    empty := true
    overflow := false
    if j + 1 < n && text[j] == 48 && (text[j + 1] == 120 || text[j + 1] == 88) {
        j = j + 2
        for j < n && tsi_hex(text[j]) >= 0 {
            a = core.wrapping_add(core.wrapping_mul(a, 16u64), tsi_hex(text[j]) as u64)
            empty = false
            j = j + 1
        }
    } else {
        for j < n && text[j] >= 48 && text[j] <= 57 {
            let d = (text[j] - 48) as u64
            let limit = if neg { 9223372036854775808u64 } else { 9223372036854775807u64 }
            if a > (limit - d) / 10 {
                overflow = true
            }
            a = core.wrapping_add(core.wrapping_mul(a, 10u64), d)
            empty = false
            j = j + 1
        }
    }
    for j < n && tsi_space(text[j]) {
        j = j + 1
    }
    if !empty && !overflow && j == n {
        if neg {
            a = core.wrapping_sub(0u64, a)
        }
        unsafe { *ival = *(ptr.from_ref(&a) as *mut i64) }
        return 1
    }
    // Float forms (no 'inf'/'nan').
    for k in 0usize..n {
        if text[k] == 110 || text[k] == 78 {
            return 0
        }
    }
    unsafe {
        let start = malloc(n + 1)
        if ptr.is_null(start) {
            return 0
        }
        for k in 0usize..n {
            *ptr.offset(start, k as isize) = text[k]
        }
        *ptr.offset(start, n as isize) = 0
        endp := 0 as *mut u8
        let v = tsi_strtod(start as *const u8, ptr.from_mut(&mut endp))
        e := (endp as usize) - (start as usize)
        let consumed = e != 0
        for e < n && tsi_space(text[e]) {
            e = e + 1
        }
        free(start)
        if !consumed || e != n {
            return 0
        }
        *fval = v
    }
    return 2
}
