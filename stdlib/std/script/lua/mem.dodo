package lua

import "core/mem"
import "core/ptr"

// Memory management. Every allocation of the runtime goes through these
// functions so the collector can account for it: `total_bytes` is the exact
// number of bytes in use and `gc_debt` grows with every allocation (the
// collector runs a step at the next check point once the debt is positive).
//
// When the system allocator fails, an emergency full collection is tried
// once (unless collection is blocked) before raising "not enough memory".
//
// Blocks of 1 to SMALL_MAX bytes (tables, short strings, closures, upvalues,
// small array and node parts) come from a free list per 16-byte size class,
// refilled from CHUNK_SIZE chunks that are returned to the system only when
// the state closes. Freed small blocks are reused immediately, which avoids
// the cost of the system allocator for the many short-lived objects of
// typical programs. Like the system allocator interface it replaces, this
// relies on every free and resize passing the block's current size.

unsafe extern "C" fn malloc(size: usize) -> *mut u8
unsafe extern "C" fn realloc(block: *mut u8, size: usize) -> *mut u8
unsafe extern "C" fn free(block: *mut u8)
unsafe extern "C" fn abort()

const SMALL_MAX: usize = 256
const CHUNK_SIZE: usize = 65536

// Debugging aid: store each block's size in a header and abort when a free
// or resize passes a different size (bypasses the small-block allocator).
const MEM_CHECK: bool = false
const MEM_CHECK_HEADER: usize = 16

fn mem_account(L: *mut State, delta: isize) {
    unsafe {
        let g = G(L)
        (*g).total_bytes = (*g).total_bytes + delta
        (*g).gc_debt = (*g).gc_debt + delta
    }
}

// Raise the memory error: the error object is the preallocated message.
fn mem_error(L: *mut State) -> Throw {
    unsafe {
        unsafe {
            let g = G(L)
            if !ptr.is_null((*g).memerrmsg) {
                set_str(L_errobj(L), (*g).memerrmsg)
            } else {
                (*L_errobj(L)).tag = TAG_NIL
            }
        }
        return Throw.Memory
    }
}

// Whether a block of `size` bytes comes from the small-block allocator.
@inline
fn mem_is_small(size: usize) -> bool {
    return core.wrapping_sub(size, 1) < SMALL_MAX
}

@inline
fn mem_small_list(g: *mut Global, size: usize) -> *mut *mut u8 {
    unsafe {
        let lists = ptr.offset(g as *mut u8, mem.offset_of::<Global>("small_free") as isize) as *mut *mut u8
        return ptr.offset(lists, ((size + 15) >> 4) as isize)
    }
}

// A small block of `size` bytes, or null if a new chunk cannot be allocated.
@inline
fn mem_small_alloc(g: *mut Global, size: usize) -> *mut u8 {
    unsafe {
        let list = mem_small_list(g, size)
        let block = *list
        if !ptr.is_null(block) {
            *list = *(block as *mut *mut u8)
            return block
        }
        let bytes = (size + 15) & ~15usize
        if ((*g).small_end as usize) - ((*g).small_cursor as usize) < bytes {
            if !mem_small_refill(g) {
                return 0 as *mut u8
            }
        }
        let p = (*g).small_cursor
        (*g).small_cursor = ptr.offset(p, bytes as isize)
        return p
    }
}

@inline
fn mem_small_free(g: *mut Global, block: *mut u8, size: usize) {
    unsafe {
        let list = mem_small_list(g, size)
        *(block as *mut *mut u8) = *list
        *list = block
    }
}

// Start a new chunk (the rest of the current one is left unused).
@inline(never)
fn mem_small_refill(g: *mut Global) -> bool {
    unsafe {
        let chunk = malloc(CHUNK_SIZE)
        if ptr.is_null(chunk) {
            return false
        }
        *(chunk as *mut *mut u8) = (*g).small_chunks
        (*g).small_chunks = chunk
        // The first 16 bytes link the chunks; blocks stay 16-byte aligned.
        (*g).small_cursor = ptr.offset(chunk, 16)
        (*g).small_end = ptr.offset(chunk, CHUNK_SIZE as isize)
        return true
    }
}

// Return every chunk to the system (closing the state).
fn mem_release_chunks(g: *mut Global) {
    unsafe {
        chunk := (*g).small_chunks
        for !ptr.is_null(chunk) {
            let next = *(chunk as *mut *mut u8)
            free(chunk)
            chunk = next
        }
        (*g).small_chunks = 0 as *mut u8
        (*g).small_cursor = 0 as *mut u8
        (*g).small_end = 0 as *mut u8
    }
}

// A new block of `size` bytes without accounting; null on failure.
@inline
fn mem_raw_alloc(g: *mut Global, size: usize) -> *mut u8 {
    unsafe {
        if MEM_CHECK {
            let p = malloc(size + MEM_CHECK_HEADER)
            if ptr.is_null(p) {
                return p
            }
            *(p as *mut usize) = size
            return ptr.offset(p, MEM_CHECK_HEADER as isize)
        }
        if mem_is_small(size) {
            return mem_small_alloc(g, size)
        }
        return malloc(if size == 0 {
            1usize
        } else {
            size
        })
    }
}

// Release a block of `size` bytes without accounting.
@inline
fn mem_raw_free(g: *mut Global, block: *mut u8, size: usize) {
    unsafe {
        if MEM_CHECK {
            free(mem_check_header(block, size))
            return
        }
        if mem_is_small(size) {
            mem_small_free(g, block, size)
        } else {
            free(block)
        }
    }
}

fn mem_check_header(block: *mut u8, size: usize) -> *mut u8 {
    unsafe {
        let p = ptr.offset(block, -(MEM_CHECK_HEADER as isize))
        if *(p as *mut usize) != size {
            abort()
        }
        return p
    }
}

// Resize a block without accounting: null on failure (the old block stays).
fn mem_raw_resize(g: *mut Global, block: *mut u8, old_size: usize, new_size: usize) -> *mut u8 {
    unsafe {
        if ptr.is_null(block) {
            return mem_raw_alloc(g, new_size)
        }
        if MEM_CHECK {
            let p = realloc(mem_check_header(block, old_size), new_size + MEM_CHECK_HEADER)
            if ptr.is_null(p) {
                return p
            }
            *(p as *mut usize) = new_size
            return ptr.offset(p, MEM_CHECK_HEADER as isize)
        }
        let small_old = mem_is_small(old_size)
        let small_new = mem_is_small(new_size)
        if !small_old && !small_new {
            return realloc(block, if new_size == 0 {
                1usize
            } else {
                new_size
            })
        }
        if small_old && small_new && ((old_size + 15) >> 4) == ((new_size + 15) >> 4) {
            return block
        }
        let fresh = mem_raw_alloc(g, new_size)
        if ptr.is_null(fresh) {
            return fresh
        }
        ptr.copy_nonoverlapping(block, fresh, if old_size < new_size {
            old_size
        } else {
            new_size
        })
        mem_raw_free(g, block, old_size)
        return fresh
    }
}

// Allocate `size` bytes (size may be 0, which returns a non-null dummy or null
// that mem_free accepts). Raises Throw.Memory on failure.
fn mem_alloc(L: *mut State, size: usize) -> (*mut u8)!Throw {
    unsafe {
        if !mem_over_limit(L, size as isize) {
            let block = mem_raw_alloc(G(L), size)
            if !ptr.is_null(block) {
                mem_account(L, size as isize)
                return ok(block)
            }
        }
        return mem_alloc_retry(L, size)
    }
}

// mem_alloc after a failed attempt: collect, then try once more.
@cold
fn mem_alloc_retry(L: *mut State, size: usize) -> (*mut u8)!Throw {
    unsafe {
        if gc_emergency(L) && !mem_over_limit(L, size as isize) {
            let block = mem_raw_alloc(G(L), size)
            if !ptr.is_null(block) {
                mem_account(L, size as isize)
                return ok(block)
            }
        }
        return err(mem_error(L))
    }
}

// Whether growing by `delta` bytes would exceed the configured limit.
fn mem_over_limit(L: *mut State, delta: isize) -> bool {
    unsafe {
        let g = G(L)
        return (*g).mem_limit > 0 && delta > 0 && (*g).total_bytes + delta > (*g).mem_limit
    }
}

// Resize a block previously returned by mem_alloc/mem_realloc (or null with
// old_size 0). Raises Throw.Memory on failure, leaving the old block intact.
fn mem_realloc(L: *mut State, block: *mut u8, old_size: usize, new_size: usize) -> (*mut u8)!Throw {
    unsafe {
        let delta = (new_size as isize) - (old_size as isize)
        grown := 0 as *mut u8
        if !mem_over_limit(L, delta) {
            grown = mem_raw_resize(G(L), block, old_size, new_size)
        }
        if ptr.is_null(grown) {
            if gc_emergency(L) && !mem_over_limit(L, delta) {
                grown = mem_raw_resize(G(L), block, old_size, new_size)
            }
            if ptr.is_null(grown) {
                return err(mem_error(L))
            }
        }
        mem_account(L, delta)
        return ok(grown)
    }
}

// Release a block of `size` bytes (size must be the size it was allocated with).
fn mem_free(L: *mut State, block: *mut u8, size: usize) {
    unsafe {
        if !ptr.is_null(block) {
            mem_raw_free(G(L), block, size)
            mem_account(L, -(size as isize))
        }
    }
}
