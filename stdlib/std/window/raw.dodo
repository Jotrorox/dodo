package raw

// The boundary between std/window and its per-OS adapters. Adapters report
// events as plain codes in an Event record that names its window; std/window
// turns them into its public types. The Cocoa and Win32 C runtimes fill the
// same record, so its layout is part of their ABI.
//
// Every adapter has a Backend type whose associated functions act on the
// process's one connection to the window system and on its windows by id:
// connect and disconnect; open, close, size, attach (the pixel buffer to
// repaint from), present, set_title, set_cursor_visible, set_cursor and
// scale_percent; set_size, set_size_limits, set_fullscreen and fullscreen;
// the clipboard's set_clipboard and clipboard; next_event; the frame pacing
// primitives clock, frame_period, next_vblank, request_frame and
// set_animating; and for GPU programs native_handle and metal_layer. open
// takes whether the window gets a pixel buffer; one without refuses
// present. set_cursor takes a CURSOR_ shape, set_size and set_size_limits
// sizes in the units of window.Options with 0 for no limit, and clipboard
// returns the text as UTF-8 bytes that std/window repairs if malformed.

// Why a window could not be opened or used.
pub enum Error {
    // No window system is reachable: no WAYLAND or X11 display on Linux, no
    // GUI session on macOS, no interactive desktop on Windows.
    NoDisplay,
    // An App already exists; a process has at most one at a time.
    AlreadyOpen,
    // The window or App was closed, or the connection to the window system
    // ended.
    Closed,
    // A zero or too large size, or a title that is too long.
    InvalidInput,
    // Memory for the pixel buffer could not be allocated.
    OutOfMemory,
    // The window system sent something unexpected or rejected a request,
    // for example an X server refusing the connection's authorization.
    Protocol,
    // The window system works in a way this library does not support, such
    // as an X server without a 24-bit true-color visual, or starting a Cocoa
    // App off the main thread.
    Unsupported,
    // Another operating-system call failed.
    System
}

// Error codes returned by the C runtimes; 0 means success.
pub fn from_code(code: i32) -> Error {
    if code == 1 {
        return Error.NoDisplay
    }
    if code == 2 {
        return Error.AlreadyOpen
    }
    if code == 3 {
        return Error.Closed
    }
    if code == 4 {
        return Error.InvalidInput
    }
    if code == 5 {
        return Error.OutOfMemory
    }
    if code == 6 {
        return Error.Protocol
    }
    if code == 7 {
        return Error.Unsupported
    }
    return Error.System
}

// Event kinds.
pub const NONE: u32 = 0
pub const CLOSE: u32 = 1
// x and y hold the new width and height.
pub const RESIZE: u32 = 2
// flags bit 0: focused.
pub const FOCUS: u32 = 3
// code: Key ordinal; flags bit 0: pressed, bit 1: repeat.
pub const KEY: u32 = 4
// code: a Unicode scalar value.
pub const TEXT: u32 = 5
pub const MOUSE_MOVE: u32 = 6
// code: 0 left, 1 middle, 2 right, 3 back, 4 forward; flags bit 0: pressed.
pub const MOUSE_BUTTON: u32 = 7
pub const MOUSE_LEAVE: u32 = 8
// x and y hold the horizontal and vertical amounts, 120 per wheel notch.
pub const SCROLL: u32 = 9
// The display refreshed after a request_frame(); std/window turns it into a
// Frame event when the window asked for one.
pub const FRAME: u32 = 10
// The user asked the application to quit, such as with Command-Q on macOS;
// window is 0.
pub const QUIT: u32 = 11

// Pointer shapes, in the order of window.Cursor.
pub const CURSOR_ARROW: u32 = 0
pub const CURSOR_TEXT: u32 = 1
pub const CURSOR_HAND: u32 = 2
pub const CURSOR_CROSSHAIR: u32 = 3
pub const CURSOR_MOVE: u32 = 4
pub const CURSOR_RESIZE_EW: u32 = 5
pub const CURSOR_RESIZE_NS: u32 = 6
pub const CURSOR_RESIZE_NWSE: u32 = 7
pub const CURSOR_RESIZE_NESW: u32 = 8
pub const CURSOR_NOT_ALLOWED: u32 = 9
pub const CURSOR_WAIT: u32 = 10
pub const CURSORS: u32 = 11

pub const PRESSED: u32 = 1
pub const REPEAT: u32 = 2

// Modifier bits.
pub const SHIFT: u32 = 1
pub const CONTROL: u32 = 2
pub const ALT: u32 = 4
pub const META: u32 = 8
pub const CAPS_LOCK: u32 = 16

// Waiting without a time limit.
pub const FOREVER: u32 = 0xffffffff

// One event of the window `window`. Window ids start at 1 and are never
// reused within a process; 0 stands for no window.
@repr(C)
pub struct Event {
    pub kind: u32
    pub code: u32
    pub modifiers: u32
    pub flags: u32
    pub x: i32
    pub y: i32
    pub window: u32

    pub fn empty() -> Event {
        return Event { kind: NONE, code: 0, modifiers: 0, flags: 0, x: 0, y: 0, window: 0 }
    }
}
