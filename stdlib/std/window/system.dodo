package system

import "core/ptr"
import "core/mem"
import "std/window/handle"
import "std/window/raw"

// The window adapter shared by macOS and Windows, whose window systems are
// reached through the C runtime in runtime.c. The runtime keeps the
// process's connection and a record per window, found by its id; Backend
// only forwards to it.

unsafe extern "C" fn dodo_window_connect() -> i32
unsafe extern "C" fn dodo_window_disconnect()
unsafe extern "C" fn dodo_window_open(title: *const u8, title_length: usize, width: u32, height: u32, flags: u32, id: *mut u32) -> i32
unsafe extern "C" fn dodo_window_close(id: u32)
unsafe extern "C" fn dodo_window_size(id: u32, width: *mut u32, height: *mut u32) -> i32
unsafe extern "C" fn dodo_window_attach(id: u32, pixels: *mut u8, width: u32, height: u32)
unsafe extern "C" fn dodo_window_next_event(milliseconds: u32, event: *mut raw.Event) -> i32
unsafe extern "C" fn dodo_window_present(id: u32, x: i32, y: i32, width: u32, height: u32) -> i32
unsafe extern "C" fn dodo_window_set_title(id: u32, title: *const u8, title_length: usize) -> i32
unsafe extern "C" fn dodo_window_set_cursor_visible(id: u32, visible: u32) -> i32
unsafe extern "C" fn dodo_window_scale_percent(id: u32) -> u32
unsafe extern "C" fn dodo_window_clock() -> u64
unsafe extern "C" fn dodo_window_frame_period(id: u32) -> u64
unsafe extern "C" fn dodo_window_next_vblank(id: u32, now: u64) -> u64
unsafe extern "C" fn dodo_window_request_frame(id: u32) -> i32
unsafe extern "C" fn dodo_window_set_animating(animating: u32)
unsafe extern "C" fn dodo_window_native(id: u32, first: *mut usize, second: *mut usize) -> i32
unsafe extern "C" fn dodo_window_metal_layer(id: u32, layer: *mut usize) -> i32

// dodo_window_open flags.
const RESIZABLE: u32 = 1
const PIXEL_BUFFER: u32 = 2
// What dodo_window_native reports.
const NATIVE_APPKIT: i32 = 1
const NATIVE_WIN32: i32 = 2

fn flag(value: bool) -> u32 {
    if value {
        return 1
    }
    return 0
}

fn status(code: i32) -> void!raw.Error {
    if code != 0 {
        return err(raw.from_code(code))
    }
    return ok()
}

pub struct Backend {
    pub fn connect() -> void!raw.Error {
        return status(unsafe {
            dodo_window_connect()
        })
    }
    // Close every window and the connection.
    pub fn disconnect() {
        unsafe {
            dodo_window_disconnect()
        }
    }
    // Open a window and return its id. Without a pixel buffer the window
    // system never repaints it; a GPU program draws into it instead.
    pub fn open(title: &str, width: u32, height: u32, resizable: bool, pixel_buffer: bool) -> u32!raw.Error {
        id := 0u32
        text := mem.str_bytes(title)
        flags := 0u32
        if resizable {
            flags = flags | RESIZABLE
        }
        if pixel_buffer {
            flags = flags | PIXEL_BUFFER
        }
        status(unsafe {
            dodo_window_open(ptr.as_ptr(text), text.len, width, height, flags, ptr.from_mut(&mut id))
        })?
        return ok(id)
    }
    // Closing an unknown or closed window does nothing.
    pub fn close(id: u32) {
        unsafe {
            dodo_window_close(id)
        }
    }
    // The drawing area's size in pixels as of the last event; false once
    // the window is closed.
    pub fn size(id: u32, width: &mut u32, height: &mut u32) -> bool {
        code := unsafe {
            dodo_window_size(id, ptr.from_mut(width), ptr.from_mut(height))
        }
        return code == 0
    }
    // The pixel buffer to repaint from, `width` * `height` BGRA pixels that
    // stay valid until the next attach or close.
    pub fn attach(id: u32, pixels: *mut u8, width: u32, height: u32) {
        unsafe {
            dodo_window_attach(id, pixels, width, height)
        }
    }
    pub fn scale_percent(id: u32) -> u32 {
        return unsafe {
            dodo_window_scale_percent(id)
        }
    }
    // The next event of any window, waiting up to `milliseconds`.
    pub fn next_event(milliseconds: u32, event: &mut raw.Event) -> bool!raw.Error {
        result := unsafe {
            dodo_window_next_event(milliseconds, ptr.from_mut(event))
        }
        if result < 0 {
            return err(raw.from_code(-result))
        }
        return ok(result != 0)
    }
    pub fn present(id: u32, x: i32, y: i32, width: u32, height: u32) -> void!raw.Error {
        return status(unsafe {
            dodo_window_present(id, x, y, width, height)
        })
    }
    // Monotonic nanoseconds, the clock of next_vblank and frame pacing.
    pub fn clock() -> u64 {
        return unsafe {
            dodo_window_clock()
        }
    }
    // Nanoseconds per display refresh, or 0 when unknown.
    pub fn frame_period(id: u32) -> u64 {
        return unsafe {
            dodo_window_frame_period(id)
        }
    }
    // The clock() time of the first display refresh after `now`, or 0 when
    // unknown. Windows reads it from the compositor.
    pub fn next_vblank(id: u32, now: u64) -> u64 {
        return unsafe {
            dodo_window_next_vblank(id, now)
        }
    }
    // Ask for a FRAME event at the window's next refresh: macOS 14 and later
    // have a display link for it. False when there is no such source.
    pub fn request_frame(id: u32) -> bool!raw.Error {
        result := unsafe {
            dodo_window_request_frame(id)
        }
        if result < 0 {
            return err(raw.from_code(-result))
        }
        return ok(result != 0)
    }
    // While animating, macOS must not throttle the program with App Nap.
    pub fn set_animating(animating: bool) {
        unsafe {
            dodo_window_set_animating(flag(animating))
        }
    }
    pub fn set_title(id: u32, title: &str) -> void!raw.Error {
        text := mem.str_bytes(title)
        return status(unsafe {
            dodo_window_set_title(id, ptr.as_ptr(text), text.len)
        })
    }
    pub fn set_cursor_visible(id: u32, visible: bool) -> void!raw.Error {
        return status(unsafe {
            dodo_window_set_cursor_visible(id, flag(visible))
        })
    }
    // The window system's objects behind the window: its NSWindow and
    // content view on macOS, its HWND and HINSTANCE on Windows.
    pub fn native_handle(id: u32) -> handle.NativeHandle!raw.Error {
        first := 0usize
        second := 0usize
        kind := unsafe {
            dodo_window_native(id, ptr.from_mut(&mut first), ptr.from_mut(&mut second))
        }
        if kind == NATIVE_APPKIT {
            return ok(handle.NativeHandle.AppKit(first, second))
        }
        if kind == NATIVE_WIN32 {
            return ok(handle.NativeHandle.Win32(first, second))
        }
        if kind < 0 {
            return err(raw.from_code(-kind))
        }
        return err(raw.Error.Unsupported)
    }
    // The CAMetalLayer backing a window without a pixel buffer, made on the
    // first call; macOS only.
    pub fn metal_layer(id: u32) -> usize!raw.Error {
        layer := 0usize
        status(unsafe {
            dodo_window_metal_layer(id, ptr.from_mut(&mut layer))
        })?
        return ok(layer)
    }
}
