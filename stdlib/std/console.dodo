package console

import "std/platform/native"
import "std/io"
import "std/fmt"

// Unbuffered borrowed process streams. No allocation, implicit flush, ownership
// transfer, or close-on-drop. Calls may block; separate wrappers may interleave.
// Bytes are passed through unchanged, including LF on both hosted targets.
pub struct Input {
    handle: native.BorrowedHandle
    pub fn read(&mut self, destination: &mut[u8]) -> usize!io.Error {
        return self.handle.read(destination)
    }
    pub fn read_line(&mut self, destination: &mut[u8]) -> io.Line!io.Error {
        return io.read_line(self, destination)
    }
}
pub struct Output {
    handle: native.BorrowedHandle
    pub fn write(&mut self, source: &[u8]) -> usize!io.Error {
        return self.handle.write(source)
    }
    // Compiler-expanded calls retain ordinary typed parameters and borrowing.
    @compiler(print)
    pub fn print<T>(&mut self, value: T) -> usize!io.Error
    @compiler(println)
    pub fn println<T>(&mut self, value: T) -> usize!io.Error
    @compiler(printf)
    pub fn printf(&mut self, format: &str) -> usize!io.Error
}
pub fn stdin() -> Input {
    return Input { handle: native.stdin() }
}
pub fn stdout() -> Output {
    return Output { handle: native.stdout() }
}
pub fn stderr() -> Output {
    return Output { handle: native.stderr() }
}

// printf accepts a literal followed by heterogeneous arguments. See std/fmt.
@compiler(print)
pub fn print<T>(value: T) -> usize!io.Error
@compiler(println)
pub fn println<T>(value: T) -> usize!io.Error
@compiler(printf)
pub fn printf(format: &str) -> usize!io.Error
