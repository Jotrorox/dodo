package linux

import "core/ptr"
import "std/platform/native"
import "std/platform/error"

unsafe extern "C" fn dodo_env_init_args(argc: i32, argv: *mut *mut u8)
unsafe extern "C" fn dodo_env_capture(storage: *mut u8, capacity: usize, used: *mut usize) -> i32
unsafe extern "C" fn dodo_env_arguments(storage: *mut u8, capacity: usize, used: *mut usize) -> i32
unsafe extern "C" fn dodo_env_current_dir(storage: *mut u8, capacity: usize, used: *mut usize) -> i32
unsafe extern "C" fn dodo_env_name_equal(left: *const u8, left_len: usize, right: *const u8, right_len: usize) -> i32

fn from_code(code: i32) -> error.Error {
    if code == -1 {
        return error.failure(error.Kind.InvalidInput)
    }
    if code == -3 {
        return error.failure(error.Kind.BufferTooSmall)
    }
    return native.from_code(code)
}
fn names_equal(left: &[u8], right: &[u8]) -> bool {
    return unsafe {
        dodo_env_name_equal(ptr.as_ptr(left) as *const u8, left.len,
        ptr.as_ptr(right) as *const u8, right.len) != 0
    }
}
// Immutable, caller-backed copy: mutation of the process environment cannot
// invalidate or change this snapshot. No allocation or global pointer escapes.
pub struct Snapshot {
    values: native.NativeList
    pub fn entries(&self) -> &native.NativeList {
        return &self.values
    }
    pub fn len(&self) -> usize {
        units := self.values.units()
        count := 0usize
        for i in 0usize..units.len {
            if units[i] == 0 {
                count += 1
            }
        }
        return count
    }
    pub fn at(&self, index: usize) -> Option<native.NativeString> {
        units := self.values.units()
        start := 0usize
        current := 0usize
        for start < units.len {
            end := start
            for units[end] != 0 {
                end += 1
            }
            if current == index {
                match native.NativeString.new(&units[start..end + 1]) {
                    ok(value) => {
                        return some(value)
                    }
                    err(_) => {
                        return none
                    }
                }
            }
            current += 1
            start = end + 1
        }
        return none
    }
    pub fn get(&self, name: &native.NativeString) -> Option<native.NativeString> from(self) {
        units := self.values.units()
        wanted := name.units()
        start := 0usize
        for start < units.len {
            end := start
            split := units.len
            for units[end] != 0 {
                if units[end] == 61 && end > start && split == units.len {
                    split = end
                }
                end += 1
            }
            if split < end && names_equal(&units[start..split], wanted) {
                match native.NativeString.new(&units[split + 1..end + 1]) {
                    ok(value) => {
                        return some(value)
                    }
                    err(_) => {
                        return none
                    }
                }
            }
            start = end + 1
        }
        return none
    }
}
pub fn capture(bytes: &mut[u8], wide: &mut[u16]) -> Snapshot!error.Error from(bytes, wide) {
    used := 0usize
    code := unsafe {
        dodo_env_capture(ptr.as_mut_ptr(bytes) as *mut u8, bytes.len, ptr.from_mut(&mut used))
    }
    if code != 0 {
        return err(from_code(code))
    }
    values := native.NativeList.new(&bytes[..used])?
    return ok(Snapshot { values: values })
}
pub fn arguments(bytes: &mut[u8], wide: &mut[u16]) -> Snapshot!error.Error from(bytes, wide) {
    used := 0usize
    code := unsafe {
        dodo_env_arguments(ptr.as_mut_ptr(bytes) as *mut u8, bytes.len, ptr.from_mut(&mut used))
    }
    if code != 0 {
        return err(from_code(code))
    }
    values := native.NativeList.new(&bytes[..used])?
    return ok(Snapshot { values: values })
}
pub fn current_dir(bytes: &mut[u8], wide: &mut[u16]) -> native.NativeString!error.Error from(bytes, wide) {
    used := 0usize
    code := unsafe {
        dodo_env_current_dir(ptr.as_mut_ptr(bytes) as *mut u8, bytes.len, ptr.from_mut(&mut used))
    }
    if code != 0 {
        return err(from_code(code))
    }
    return native.NativeString.new(&bytes[..used])
}

// Explicit child environment; never changes the parent. set replaces a key
// atomically with respect to capacity failure. Windows compares names with the
// OS's ordinal case-insensitive comparison; Unix compares native bytes.
pub struct Builder {
    storage: &mut[u8]
    used: usize
    pub fn new(bytes: &mut[u8], wide: &mut[u16]) -> Builder from(bytes, wide) {
        return Builder { storage: bytes, used: 0 }
    }
    pub fn clear(&mut self) {
        self.used = 0
    }
    pub fn copy_from(&mut self, source: &Snapshot) -> void!error.Error {
        units := source.values.units()
        if units.len > self.storage.len {
            return err(error.failure(error.Kind.BufferTooSmall))
        }
        for i in 0usize..units.len {
            self.storage[i] = units[i]
        }
        self.used = units.len
        return ok()
    }
    pub fn set(&mut self, name: &native.NativeString, value: &native.NativeString) -> void!error.Error {
        key := name.units()
        val := value.units()
        if key.len == 0 {
            return err(error.failure(error.Kind.InvalidInput))
        }
        for i in 0usize..key.len {
            if key[i] == 61 {
                return err(error.failure(error.Kind.InvalidInput))
            }
        }
        found_start := self.used
        found_end := self.used
        start := 0usize
        for start < self.used {
            end := start
            split := self.used
            for self.storage[end] != 0 {
                if self.storage[end] == 61 && end > start && split == self.used {
                    split = end
                }
                end += 1
            }
            if split < end && names_equal(&self.storage[start..split], key) {
                found_start = start
                found_end = end + 1
                break
            }
            start = end + 1
        }
        removed := found_end - found_start
        retained := self.used - removed
        available := self.storage.len - retained
        if key.len > available || available - key.len < 2 || val.len > available - key.len - 2 {
            return err(error.failure(error.Kind.BufferTooSmall))
        }
        for i in found_end..self.used {
            self.storage[i - removed] = self.storage[i]
        }
        self.used = retained
        for i in 0usize..key.len {
            self.storage[self.used + i] = key[i]
        }
        self.used += key.len
        self.storage[self.used] = 61
        self.used += 1
        for i in 0usize..val.len {
            self.storage[self.used + i] = val[i]
        }
        self.used += val.len
        self.storage[self.used] = 0
        self.used += 1
        return ok()
    }
    pub fn remove(&mut self, name: &native.NativeString) -> bool {
        start := 0usize
        for start < self.used {
            end := start
            split := self.used
            for self.storage[end] != 0 {
                if self.storage[end] == 61 && end > start && split == self.used {
                    split = end
                }
                end += 1
            }
            if split < end && names_equal(&self.storage[start..split], name.units()) {
                removed := end + 1 - start
                for i in end + 1..self.used {
                    self.storage[i - removed] = self.storage[i]
                }
                self.used -= removed
                return true
            }
            start = end + 1
        }
        return false
    }
    pub fn snapshot(&self) -> Snapshot!error.Error {
        values := native.NativeList.new(&self.storage[..self.used])?
        return ok(Snapshot { values: values })
    }
}

unsafe extern "C" fn dodo_env_lookup(name: *const u8, storage: *mut u8, capacity: usize, used: *mut usize, found: *mut i32) -> i32
pub fn lookup(name: &native.NativeString, storage: &mut native.Workspace) -> bool!error.Error {
    used := 0usize
    found := 0i32
    code := unsafe {
        dodo_env_lookup(name.as_ptr() as *const u8, ptr.as_mut_ptr(storage.buffer()) as *mut u8,
        native.TEXT_CAPACITY, ptr.from_mut(&mut used), ptr.from_mut(&mut found))
    }
    if code != 0 {
        return err(from_code(code))
    }
    if found == 0 {
        return ok(false)
    }
    storage.commit(used)?
    return ok(true)
}
pub fn arguments_into(storage: &mut native.ListWorkspace) -> void!error.Error {
    used := 0usize
    storage.clear()
    code := unsafe {
        dodo_env_arguments(ptr.as_mut_ptr(storage.buffer()) as *mut u8, native.LIST_CAPACITY, ptr.from_mut(&mut used))
    }
    if code != 0 {
        return err(from_code(code))
    }
    return storage.commit(used)
}
pub fn view(values: native.NativeList) -> Snapshot {
    return Snapshot { values: values }
}
