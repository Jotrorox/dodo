package text_unicode

import "std/text"
import "core/mem"

// Unicode 16.0.0 White_Space property, derived from PropList-16.0.0.txt:
// https://www.unicode.org/Public/16.0.0/ucd/PropList.txt
// Copyright © 2024 Unicode, Inc. Distributed under the Unicode License V3;
// see the accompanying LICENSE.unicode copyright and permission notice.
// This optional package is not imported by std/text.
pub const UNICODE_VERSION: &str = "16.0.0"

// All 25 White_Space scalars. Invalid scalar values return false. This is the
// Unicode property, not a locale rule or a test for grapheme/line boundaries.
pub fn is_whitespace(scalar: u32) -> bool {
    return (scalar >= 0x0009 && scalar <= 0x000d) || scalar == 0x0020 || scalar == 0x0085 || scalar == 0x00a0 || scalar == 0x1680 || (scalar >= 0x2000 && scalar <= 0x200a) || scalar == 0x2028 || scalar == 0x2029 || scalar == 0x202f || scalar == 0x205f || scalar == 0x3000
}

// Remove Unicode White_Space scalars from both ends, preserving interior
// bytes exactly. Linear in the input byte length, fixed stack space, no
// allocation or failure. The result retains the input's checked borrow.
pub fn trim(input: &text.Text) -> text.Text from(input) {
    scalars := input.scalars()
    start := 0usize
    end := 0usize
    leading := true
    for {
        match scalars.next() {
            some(scalar) => {
                if is_whitespace(scalar.value) {
                    if leading {
                        start = scalar.end
                        end = start
                    }
                } else {
                    leading = false
                    end = scalar.end
                }
            },
            none => {
                break
            },
        }
    }
    bytes := input.as_bytes()
    // Scalar iteration guarantees both boundaries are valid UTF-8 boundaries.
    unsafe {
        return text.Text.from_str(mem.str_from_utf8(&bytes[start..end]))
    }
}
