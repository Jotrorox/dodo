package font

import "std/graphics"

// Built-in bitmap fonts covering U+0020 through U+00FF: ASCII and Latin-1,
// accented letters included. Glyphs are original public-domain drawings kept
// as ASCII art in scripts/generate_graphics_fonts.py; the tables live in
// read-only static storage, so firmware keeps them in flash.
//
// Bind a font once and pass a reference to every text call:
//
//     small := font.small()
//     canvas.text(&small, 4, 4, "Hello", graphics.WHITE)
//
// font.medium().scaled(2) draws 16x32 characters.

// Fixed 6x8 cells: 5-pixel glyphs with one column of spacing, 7-pixel
// capitals and a one-row descender. Suits 128x64 OLEDs and status lines.
pub fn small() -> graphics.Font from(static) {
    return graphics.Font.new(6, 8, 0x20, 224, &SMALL_GLYPHS)!
}

// Fixed 8x16 cells: 7-pixel glyphs with one column of spacing, 10-pixel
// capitals and three-row descenders. The usual terminal size on desktops
// and 240x240 panels.
pub fn medium() -> graphics.Font from(static) {
    return graphics.Font.new(8, 16, 0x20, 224, &MEDIUM_GLYPHS)!
}

