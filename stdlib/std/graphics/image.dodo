package image

import "std/graphics"
import "std/image/bmp"
import "std/image/pixels"
import "std/image/png"
import "std/image/ppm"
import "std/image/qoi"
import "std/image/sink"

// Image file decoding and encoding onto graphics canvases, with
// caller-supplied storage only: no allocation, no files. Read a file with
// std/fs (or embed its bytes), ask info() for its size, provide
// graphics.bytes_needed(...) bytes, and decode.
//
// This is the original Canvas-based API, kept for compatibility; it forwards
// to the codec packages of std/image (std/image/ppm, qoi, bmp and png) and,
// like them, needs no floating point. std/image offers the full API: every
// layout including 16-bit and float, color and metadata, animation, and
// encoder options.
//
// Decoders: binary PPM/PGM (P5/P6, any maxval), PAM (P7) and PFM, QOI, BMP
// (1, 4 and 8-bit palettes, RLE8 and RLE4; 16, 24 and 32-bit, with or
// without bit-field masks; bottom-up or top-down), and PNG (every color type
// and bit depth, palettes, transparency, interlacing; the default image of
// an APNG). Encoders: PPM (P6), QOI, 24-bit BMP, and 8-bit RGBA PNG,
// uncompressed or compressed. Untrusted input is safe: every length is
// checked before it is used.

// The errors of std/image: Truncated, Malformed, Unsupported (a valid file
// using something not implemented, such as ASCII PPM), TooLarge (a dimension
// exceeds graphics.MAX_DIMENSION or a size overflows) and BufferTooSmall.
pub type Error = pixels.Error

pub fn error_name(error: Error) -> &str from(static) {
    return pixels.error_name(error)
}

pub enum Format {
    // Netpbm binary PPM (P6), PGM (P5), PAM (P7) or PFM.
    Ppm,
    Qoi,
    Bmp,
    Png
}

pub struct Info {
    pub format: Format
    pub width: u32
    pub height: u32
    // True when the file stores an alpha channel (QOI RGBA, BMP alpha mask,
    // PNG gray or RGB with alpha, PAM with alpha) or a PNG transparency
    // (tRNS) chunk.
    pub has_alpha: bool
}

// Identify `data` by its signature and read its dimensions without decoding.
pub fn info(data: &[u8]) -> Info!Error {
    if png.matches(data) {
        header := png.info(data)?
        return ok(Info { format: Format.Png, width: header.width, height: header.height, has_alpha: header.has_alpha() })
    }
    if qoi.matches(data) {
        header := qoi.info(data)?
        return ok(Info { format: Format.Qoi, width: header.width, height: header.height, has_alpha: header.has_alpha() })
    }
    if data.len >= 2 && data[0] == b'B' && data[1] == b'M' {
        header := bmp.info(data)?
        return ok(Info { format: Format.Bmp, width: header.width, height: header.height, has_alpha: header.has_alpha() })
    }
    if data.len >= 2 && data[0] == b'P' {
        header := ppm.info(data)?
        return ok(Info { format: Format.Ppm, width: header.width, height: header.height, has_alpha: header.has_alpha() })
    }
    return err(Error.Unsupported)
}

// Decode `data` into a new canvas over `pixels`, sized like the image and
// stored in `format`. `pixels` needs graphics.bytes_needed(width, height,
// format) bytes. The returned canvas's dirty rectangle covers the image.
// PNG rows are unfiltered in PNG_SCRATCH_LEN bytes of stack; an image whose
// rows need more fails with BufferTooSmall, so use decode_png for it.
pub fn decode(data: &[u8], pixels: &mut[u8], format: graphics.PixelFormat) -> graphics.Canvas!Error from(pixels) {
    header := info(data)?
    canvas := match graphics.Canvas.new(pixels, header.width, header.height, format) {
        ok(value) => value,
        err(error) => {
            return err(canvas_error(error))
        }
    }
    draw(data, &mut canvas, 0, 0)?
    return ok(canvas)
}

// Decode `data` onto an existing canvas with the image's top-left corner at
// (x, y). Pixels outside the canvas or its clip are skipped; colors are
// stored, not blended. A decoding error can leave a partly drawn image.
pub fn draw(data: &[u8], canvas: &mut graphics.Canvas, x: i32, y: i32) -> void!Error {
    header := info(data)?
    output := sink.CanvasSink.new(canvas, x, y)
    nothing := [0u8; 1]
    match &header.format {
        Format.Ppm => {
            return ppm.decode(data, &mut output, &mut nothing[..0])
        }
        Format.Qoi => {
            return qoi.decode(data, &mut output, &mut nothing[..0])
        }
        Format.Bmp => {
            return bmp.decode(data, &mut output, &mut nothing[..0])
        }
        Format.Png => {
            scratch := [0u8; PNG_SCRATCH_LEN]
            return png.decode(data, &mut output, &mut scratch)
        }
    }
}

fn canvas_error(error: graphics.Error) -> Error {
    match error {
        graphics.Error.BufferTooSmall => {
            return Error.BufferTooSmall
        }
        graphics.Error.InvalidInput => {
            return Error.TooLarge
        }
        graphics.Error.Unsupported => {
            return Error.Unsupported
        }
        graphics.Error.Device => {
            return Error.Unsupported
        }
    }
}

// ---------------------------------------------------------------------------
// PNG with caller scratch

// Bytes of stack the generic decode() and draw() use for PNG rows; see
// png_scratch_size.
pub const PNG_SCRATCH_LEN: usize = 16384

// Bytes of scratch storage draw_png and decode_png need for `data`: two rows
// of raw image data, each with its filter byte.
pub fn png_scratch_size(data: &[u8]) -> usize!Error {
    return png.scratch_size(data)
}

// Decode PNG `data` into a new canvas over `pixels`, like decode, using
// `scratch` of at least png_scratch_size(data) bytes for its rows.
pub fn decode_png(data: &[u8], pixels: &mut[u8], format: graphics.PixelFormat, scratch: &mut[u8]) -> graphics.Canvas!Error from(pixels) {
    header := png.info(data)?
    canvas := match graphics.Canvas.new(pixels, header.width, header.height, format) {
        ok(value) => value,
        err(error) => {
            return err(canvas_error(error))
        }
    }
    draw_png(data, &mut canvas, 0, 0, scratch)?
    return ok(canvas)
}

// Draw PNG `data` onto `canvas` like draw, using `scratch` of at least
// png_scratch_size(data) bytes for its rows.
pub fn draw_png(data: &[u8], canvas: &mut graphics.Canvas, x: i32, y: i32, scratch: &mut[u8]) -> void!Error {
    output := sink.CanvasSink.new(canvas, x, y)
    return png.decode(data, &mut output, scratch)
}

// ---------------------------------------------------------------------------
// Encoders. Each reads the canvas from its top-left pixel, wherever its
// origin is, as 8-bit RGBA.

fn ppm_options() -> ppm.EncodeOptions {
    options := ppm.EncodeOptions.new()
    options.kind = ppm.KIND_PPM
    return options
}

// Bytes encode_ppm writes for a width x height canvas.
pub fn ppm_size(width: u32, height: u32) -> usize!Error {
    layout := pixels.Layout.rgba8()
    options := ppm_options()
    return ppm.max_encoded_size(width, height, &layout, &options)
}

// Write `canvas` as binary PPM (P6, maxval 255; alpha is dropped) and return
// the byte count, ppm_size(width, height).
pub fn encode_ppm(canvas: &graphics.Canvas, output: &mut[u8]) -> usize!Error {
    source := sink.CanvasSource.new(canvas)
    options := ppm_options()
    nothing := [0u8; 1]
    return ppm.encode_from(&source, &options, output, &mut nothing[..0])
}

// The largest size encode_qoi can produce for a width x height canvas.
pub fn qoi_max_size(width: u32, height: u32) -> usize!Error {
    layout := pixels.Layout.rgba8()
    options := qoi.EncodeOptions.new()
    return qoi.max_encoded_size(width, height, &layout, &options)
}

// Write `canvas` as a 4-channel sRGB QOI file and return its length. The
// output needs at most qoi_max_size(width, height) bytes; a smaller buffer
// works when the image compresses well, else fails with BufferTooSmall.
pub fn encode_qoi(canvas: &graphics.Canvas, output: &mut[u8]) -> usize!Error {
    source := sink.CanvasSource.new(canvas)
    options := qoi.EncodeOptions.new()
    nothing := [0u8; 1]
    return qoi.encode_from(&source, &options, output, &mut nothing[..0])
}

fn bmp_options() -> bmp.EncodeOptions {
    options := bmp.EncodeOptions.new()
    options.alpha = false
    return options
}

// Bytes encode_bmp writes for a width x height canvas.
pub fn bmp_size(width: u32, height: u32) -> usize!Error {
    layout := pixels.Layout.rgba8()
    options := bmp_options()
    return bmp.max_encoded_size(width, height, &layout, &options)
}

// Write `canvas` as an uncompressed, bottom-up 24-bit BMP (alpha is dropped)
// and return the byte count, bmp_size(width, height).
pub fn encode_bmp(canvas: &graphics.Canvas, output: &mut[u8]) -> usize!Error {
    source := sink.CanvasSource.new(canvas)
    options := bmp_options()
    nothing := [0u8; 1]
    return bmp.encode_from(&source, &options, output, &mut nothing[..0])
}

fn stored_options() -> png.EncodeOptions {
    options := png.EncodeOptions.new()
    options.level = 0
    options.filter = png.FILTER_NONE
    return options
}

// Bytes encode_png writes for a width x height canvas. Fails with Unsupported
// for an empty canvas, which PNG cannot store.
pub fn png_size(width: u32, height: u32) -> usize!Error {
    layout := pixels.Layout.rgba8()
    options := stored_options()
    return png.max_encoded_size(width, height, &layout, &options)
}

// Write `canvas` as an 8-bit RGBA PNG without compression (stored deflate
// blocks, no row filters) and return the byte count, png_size(width, height).
pub fn encode_png(canvas: &graphics.Canvas, output: &mut[u8]) -> usize!Error {
    source := sink.CanvasSource.new(canvas)
    options := stored_options()
    nothing := [0u8; 1]
    return png.encode_from(&source, &options, output, &mut nothing[..0])
}

// An upper bound on what encode_png_compressed writes for a width x height
// canvas at any level.
pub fn png_compressed_max_size(width: u32, height: u32) -> usize!Error {
    layout := pixels.Layout.rgba8()
    options := png.EncodeOptions.new()
    options.level = 9
    return png.max_encoded_size(width, height, &layout, &options)
}

// Write `canvas` as a compressed 8-bit RGBA PNG and return its length. Each
// row gets the adaptive filter that suits it; `level` is the deflate level, 0
// through 9. The compressor borrows `buffer` of deflate.ENCODER_BUFFER_LEN
// bytes and `words` of deflate.WORKSPACE_LEN words (about 350 KiB together;
// static storage suits small stacks). The output needs at most
// png_compressed_max_size(width, height) bytes; a smaller buffer works when
// the image compresses well, else fails with BufferTooSmall.
pub fn encode_png_compressed(canvas: &graphics.Canvas, output: &mut[u8], level: usize, buffer: &mut[u8], words: &mut[u32]) -> usize!Error {
    if canvas.width() == 0 || canvas.height() == 0 || level > 9 {
        return err(Error.Unsupported)
    }
    source := sink.CanvasSource.new(canvas)
    options := png.EncodeOptions.new()
    options.level = level as u32
    nothing := [0u8; 1]
    return png.encode_with_buffers(&source, &options, &nothing[..0], &nothing[..0], output, buffer, words)
}
