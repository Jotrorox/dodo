// Commands

// glCullFace, OpenGL 1.0.
pub unsafe fn cull_face(mode: u32) {
    unsafe {
        address := ADDRESSES[0]
        core.assert(address != 0) // glCullFace is not loaded
        call := address as extern "C" fn(u32)
        call(mode)
    }
}
