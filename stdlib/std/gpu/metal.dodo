static mut S_SET_NORMALIZED_COORDINATES: usize = 0
static mut S_SET_SUPPORT_ARGUMENT_BUFFERS: usize = 0

// MTLSamplerDescriptor: how shaders filter and address a texture. A new
// descriptor samples the nearest texel and clamps to the edge.
pub struct SamplerDescriptor {
    object: objc.Object

    pub fn new() -> SamplerDescriptor!Error {
        object := instantiate(unsafe {
            ptr.from_mut(&mut C_SAMPLER_DESCRIPTOR)
        }, b"MTLSamplerDescriptor\0")?
        return ok(SamplerDescriptor { object: object })
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn set_min_filter(&self, filter: SamplerMinMagFilter) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_MIN_FILTER)
        }, b"setMinFilter:\0"), filter)
    }

    pub fn set_mag_filter(&self, filter: SamplerMinMagFilter) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_MAG_FILTER)
        }, b"setMagFilter:\0"), filter)
    }

    pub fn set_mip_filter(&self, filter: SamplerMipFilter) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_MIP_FILTER)
        }, b"setMipFilter:\0"), filter)
    }

    pub fn set_s_address_mode(&self, mode: SamplerAddressMode) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_S_ADDRESS_MODE)
        }, b"setSAddressMode:\0"), mode)
    }

    pub fn set_t_address_mode(&self, mode: SamplerAddressMode) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_T_ADDRESS_MODE)
        }, b"setTAddressMode:\0"), mode)
    }

    pub fn set_r_address_mode(&self, mode: SamplerAddressMode) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_R_ADDRESS_MODE)
        }, b"setRAddressMode:\0"), mode)
    }

    // 1 through 16.
    pub fn set_max_anisotropy(&self, value: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_MAX_ANISOTROPY)
        }, b"setMaxAnisotropy:\0"), value)
    }

    // Make this a comparison sampler for depth textures.
    pub fn set_compare_function(&self, function: CompareFunction) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_COMPARE_FUNCTION)
        }, b"setCompareFunction:\0"), function)
    }

    pub fn set_border_color(&self, color: SamplerBorderColor) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_BORDER_COLOR)
        }, b"setBorderColor:\0"), color)
    }

    pub fn set_lod_min_clamp(&self, value: f32) {
        unsafe {
            m_v_f(self.id(), sel(ptr.from_mut(&mut S_SET_LOD_MIN_CLAMP), b"setLodMinClamp:\0"), value)
        }
    }

    pub fn set_lod_max_clamp(&self, value: f32) {
        unsafe {
            m_v_f(self.id(), sel(ptr.from_mut(&mut S_SET_LOD_MAX_CLAMP), b"setLodMaxClamp:\0"), value)
        }
    }

    // False addresses texels in pixels instead of 0 through 1.
    pub fn set_normalized_coordinates(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_NORMALIZED_COORDINATES)
        }, b"setNormalizedCoordinates:\0"), value)
    }

    pub fn set_support_argument_buffers(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_SUPPORT_ARGUMENT_BUFFERS)
        }, b"setSupportArgumentBuffers:\0"), value)
    }
}

// MTLSamplerState: an immutable sampler made from a SamplerDescriptor.
@unsafe_send
@unsafe_sync
pub unsafe struct SamplerState {
    object: objc.Object

    // Safety: `object` is an MTLSamplerState.
    pub unsafe fn from_object(object: objc.Object) -> SamplerState {
        return SamplerState { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn clone(&self) -> SamplerState {
        return SamplerState { object: self.object.clone() }
    }
}

static mut C_COMPILE_OPTIONS: usize = 0
static mut S_SET_FAST_MATH_ENABLED: usize = 0
static mut S_SET_MATH_MODE: usize = 0
static mut S_SET_LANGUAGE_VERSION: usize = 0
static mut S_SET_PRESERVE_INVARIANCE: usize = 0
static mut S_RESPONDS_TO_SELECTOR: usize = 0

// MTLCompileOptions: how new_library_with_source compiles. A new value
// uses the newest language version and fast math.
pub struct CompileOptions {
    object: objc.Object

    pub fn new() -> CompileOptions!Error {
        object := instantiate(unsafe {
            ptr.from_mut(&mut C_COMPILE_OPTIONS)
        }, b"MTLCompileOptions\0")?
        return ok(CompileOptions { object: object })
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    // MATH_MODE_SAFE follows IEEE 754; fast math may reorder and drop
    // special cases. Before macOS 15 only safe versus fast is available.
    pub fn set_math_mode(&self, mode: MathMode) {
        selector := sel(unsafe {
            ptr.from_mut(&mut S_SET_MATH_MODE)
        }, b"setMathMode:\0")
        responds := unsafe {
            m_b_p(self.id(), sel(ptr.from_mut(&mut S_RESPONDS_TO_SELECTOR), b"respondsToSelector:\0"), selector)
        }
        if responds {
            set_usize(self.id(), selector, mode)
        } else {
            set_bool(self.id(), sel(unsafe {
                ptr.from_mut(&mut S_SET_FAST_MATH_ENABLED)
            }, b"setFastMathEnabled:\0"), mode != MATH_MODE_SAFE)
        }
    }

    pub fn set_language_version(&self, version: LanguageVersion) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_LANGUAGE_VERSION)
        }, b"setLanguageVersion:\0"), version)
    }

    // Compute positions identically in every pipeline using them, as
    // multi-pass depth techniques need.
    pub fn set_preserve_invariance(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_PRESERVE_INVARIANCE)
        }, b"setPreserveInvariance:\0"), value)
    }
}

static mut S_NEW_FUNCTION_WITH_NAME: usize = 0
static mut S_FUNCTION_NAMES: usize = 0
static mut S_FUNCTION_TYPE: usize = 0

// MTLLibrary: compiled shader functions.
@unsafe_send
@unsafe_sync
pub unsafe struct Library {
    object: objc.Object

    // Safety: `object` is an MTLLibrary.
    pub unsafe fn from_object(object: objc.Object) -> Library {
        return Library { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn clone(&self) -> Library {
        return Library { object: self.object.clone() }
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.object.as_ptr(), text)
    }

    // The function with this name. Err(NotFound) if there is none.
    pub fn new_function(&self, name: &str) -> Function!Error {
        let some(text) = objc.NSString.new(name) else {
            return err(Error.OutOfMemory)
        }
        pool := objc.AutoreleasePool.new()
        id := unsafe {
            m_p_p(self.object.as_ptr(), sel(ptr.from_mut(&mut S_NEW_FUNCTION_WITH_NAME), b"newFunctionWithName:\0"), text.as_object().as_ptr())
        }
        owned := unsafe {
            objc.Object.from_retained(id)
        }
        match owned {
            some(object) => {
                return ok(Function { object: object })
            }
            none => {
                return err(Error.NotFound)
            }
        }
    }

    // The names of every function, as an array of NSString.
    pub fn function_names(&self) -> Option<objc.NSArray> {
        match get(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_FUNCTION_NAMES)
        }, b"functionNames\0")) {
            some(object) => {
                return some(unsafe {
                    objc.NSArray.from_object(object)
                })
            }
            none => {
                return none
            }
        }
    }
}

// MTLFunctionType.
pub type FunctionType = usize
pub const FUNCTION_TYPE_VERTEX: FunctionType = 1
pub const FUNCTION_TYPE_FRAGMENT: FunctionType = 2
pub const FUNCTION_TYPE_KERNEL: FunctionType = 3

// MTLFunction: one shader entry point.
@unsafe_send
@unsafe_sync
pub unsafe struct Function {
    object: objc.Object

    // Safety: `object` is an MTLFunction.
    pub unsafe fn from_object(object: objc.Object) -> Function {
        return Function { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn clone(&self) -> Function {
        return Function { object: self.object.clone() }
    }

    pub fn name(&self) -> Option<objc.NSString> {
        return string_of(get(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_NAME)
        }, b"name\0")))
    }

    pub fn function_type(&self) -> FunctionType {
        return get_usize(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_FUNCTION_TYPE)
        }, b"functionType\0"))
    }
}

