static mut S_NEW_LIBRARY_WITH_SOURCE: usize = 0
static mut S_NEW_LIBRARY_WITH_DATA: usize = 0
static mut S_NEW_COMPUTE_PIPELINE_STATE: usize = 0
static mut S_NEW_RENDER_PIPELINE_STATE: usize = 0
static mut S_NEW_FENCE: usize = 0
static mut S_NEW_EVENT: usize = 0
static mut S_NEW_SHARED_EVENT: usize = 0

// MTLDevice: one GPU. It creates every other object.
@unsafe_send
@unsafe_sync
pub unsafe struct Device {
    object: objc.Object

    // The GPU macOS prefers for this process. Err(NoDevice) when there is
    // none, as in a virtual machine without GPU support.
    pub fn system_default() -> Device!Error {
        pool := objc.AutoreleasePool.new()
        owned := unsafe {
            objc.Object.from_retained(MTLCreateSystemDefaultDevice())
        }
        match owned {
            some(object) => {
                return ok(Device { object: object })
            }
            none => {
                return err(Error.NoDevice)
            }
        }
    }

    // Every GPU in the system, including external and headless ones.
    pub fn all() -> DeviceList {
        pool := objc.AutoreleasePool.new()
        owned := unsafe {
            objc.Object.from_retained(MTLCopyAllDevices())
        }
        match owned {
            some(object) => {
                return DeviceList { array: some(unsafe {
                    objc.NSArray.from_object(object)
                }) }
            }
            none => {
                return DeviceList { array: none }
            }
        }
    }

    // Safety: `object` is an MTLDevice.
    pub unsafe fn from_object(object: objc.Object) -> Device {
        return Device { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn clone(&self) -> Device {
        return Device { object: self.object.clone() }
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    // The GPU's name, such as "Apple M4".
    pub fn name(&self) -> Option<objc.NSString> {
        return string_of(get(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_NAME)
        }, b"name\0")))
    }

    // An identifier that stays the same for this GPU across processes.
    pub fn registry_id(&self) -> u64 {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_REGISTRY_ID)
        }, b"registryID\0")) as u64
    }

    // The largest buffer new_buffer can create, in bytes.
    pub fn max_buffer_length(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_MAX_BUFFER_LENGTH)
        }, b"maxBufferLength\0"))
    }

    // The threadgroup memory one compute threadgroup may use, in bytes.
    pub fn max_threadgroup_memory_length(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_MAX_THREADGROUP_MEMORY_LENGTH)
        }, b"maxThreadgroupMemoryLength\0"))
    }

    // The most threads in each dimension of one threadgroup.
    pub fn max_threads_per_threadgroup(&self) -> Size {
        return send_size(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_MAX_THREADS_PER_THREADGROUP)
        }, b"maxThreadsPerThreadgroup\0"))
    }

    // How much memory the GPU can use without hurting performance, in bytes.
    pub fn recommended_max_working_set_size(&self) -> u64 {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_RECOMMENDED_MAX_WORKING_SET_SIZE)
        }, b"recommendedMaxWorkingSetSize\0")) as u64
    }

    // The memory this process's Metal objects currently use, in bytes.
    pub fn current_allocated_size(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_CURRENT_ALLOCATED_SIZE)
        }, b"currentAllocatedSize\0"))
    }

    // Whether the CPU and GPU share memory, as on Apple silicon.
    pub fn has_unified_memory(&self) -> bool {
        return get_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_HAS_UNIFIED_MEMORY)
        }, b"hasUnifiedMemory\0"))
    }

    pub fn is_low_power(&self) -> bool {
        return get_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_IS_LOW_POWER)
        }, b"isLowPower\0"))
    }

    pub fn is_headless(&self) -> bool {
        return get_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_IS_HEADLESS)
        }, b"isHeadless\0"))
    }

    pub fn is_removable(&self) -> bool {
        return get_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_IS_REMOVABLE)
        }, b"isRemovable\0"))
    }

    // Whether the GPU implements a feature family such as GPU_FAMILY_APPLE7.
    pub fn supports_family(&self, family: GpuFamily) -> bool {
        return unsafe {
            m_b_i(self.id(), sel(ptr.from_mut(&mut S_SUPPORTS_FAMILY), b"supportsFamily:\0"), family as isize)
        }
    }

    // Whether render targets may have this many samples per pixel.
    pub fn supports_texture_sample_count(&self, count: usize) -> bool {
        return unsafe {
            m_b_u(self.id(), sel(ptr.from_mut(&mut S_SUPPORTS_TEXTURE_SAMPLE_COUNT), b"supportsTextureSampleCount:\0"), count)
        }
    }

    // The alignment, in bytes, of a texture's rows stored in a buffer.
    pub fn minimum_linear_texture_alignment(&self, format: PixelFormat) -> usize {
        return unsafe {
            m_u_u(self.id(), sel(ptr.from_mut(&mut S_MINIMUM_LINEAR_TEXTURE_ALIGNMENT), b"minimumLinearTextureAlignmentForPixelFormat:\0"), format)
        }
    }

    pub fn new_command_queue(&self) -> CommandQueue!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p(self.id(), sel(ptr.from_mut(&mut S_NEW_COMMAND_QUEUE), b"newCommandQueue\0"))
        })?
        return ok(CommandQueue { object: object })
    }

    // A queue that allows at most `count` uncompleted command buffers;
    // command_buffer() waits while that many are in flight.
    pub fn new_command_queue_with_max_command_buffer_count(&self, count: usize) -> CommandQueue!Error {
        if count == 0 {
            return err(Error.InvalidInput)
        }
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_u(self.id(), sel(ptr.from_mut(&mut S_NEW_COMMAND_QUEUE_WITH_MAX), b"newCommandQueueWithMaxCommandBufferCount:\0"), count)
        })?
        return ok(CommandQueue { object: object })
    }

    // A zero-filled buffer of `length` bytes. RESOURCE_STORAGE_MODE_SHARED
    // makes it CPU-visible; RESOURCE_STORAGE_MODE_PRIVATE keeps it on the GPU.
    pub fn new_buffer(&self, length: usize, options: ResourceOptions) -> Buffer!Error {
        if length == 0 {
            return err(Error.InvalidInput)
        }
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_uu(self.id(), sel(ptr.from_mut(&mut S_NEW_BUFFER_WITH_LENGTH), b"newBufferWithLength:options:\0"), length, options)
        })?
        return ok(Buffer { object: object })
    }

    // A buffer holding a copy of `bytes`.
    pub fn new_buffer_with_bytes(&self, bytes: &[u8], options: ResourceOptions) -> Buffer!Error {
        if bytes.len == 0 {
            return err(Error.InvalidInput)
        }
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_quu(self.id(), sel(ptr.from_mut(&mut S_NEW_BUFFER_WITH_BYTES), b"newBufferWithBytes:length:options:\0"), ptr.as_ptr(bytes), bytes.len, options)
        })?
        return ok(Buffer { object: object })
    }

    pub fn new_texture(&self, descriptor: &TextureDescriptor) -> Texture!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_p(self.id(), sel(ptr.from_mut(&mut S_NEW_TEXTURE_WITH_DESCRIPTOR), b"newTextureWithDescriptor:\0"), descriptor.object.as_ptr())
        })?
        return ok(Texture { object: object })
    }

    pub fn new_sampler_state(&self, descriptor: &SamplerDescriptor) -> SamplerState!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_p(self.id(), sel(ptr.from_mut(&mut S_NEW_SAMPLER_STATE), b"newSamplerStateWithDescriptor:\0"), descriptor.object.as_ptr())
        })?
        return ok(SamplerState { object: object })
    }

    pub fn new_depth_stencil_state(&self, descriptor: &DepthStencilDescriptor) -> DepthStencilState!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_p(self.id(), sel(ptr.from_mut(&mut S_NEW_DEPTH_STENCIL_STATE), b"newDepthStencilStateWithDescriptor:\0"), descriptor.object.as_ptr())
        })?
        return ok(DepthStencilState { object: object })
    }

    // Compile Metal Shading Language source. A compile error is
    // Err(Failed(error)) with the compiler's log as error.message().
    pub fn new_library_with_source(&self, source: &str, options: &CompileOptions) -> Library!Error {
        let some(text) = objc.NSString.new(source) else {
            return err(Error.OutOfMemory)
        }
        pool := objc.AutoreleasePool.new()
        error := null()
        id := unsafe {
            m_p_ppp(self.id(), sel(ptr.from_mut(&mut S_NEW_LIBRARY_WITH_SOURCE), b"newLibraryWithSource:options:error:\0"), text.as_object().as_ptr(), options.object.as_ptr(), ptr.from_mut(&mut error))
        }
        result := adopt_or_error(id, error)
        core.drop(pool)
        object := result?
        return ok(Library { object: object })
    }

    // Load a compiled .metallib, such as the output of `xcrun metal`.
    pub fn new_library_with_data(&self, bytes: &[u8]) -> Library!Error {
        if bytes.len == 0 {
            return err(Error.InvalidInput)
        }
        // A null destructor makes dispatch copy the bytes.
        data := unsafe {
            dispatch_data_create(ptr.as_ptr(bytes), bytes.len, null(), null())
        }
        if ptr.is_null(data) {
            return err(Error.OutOfMemory)
        }
        pool := objc.AutoreleasePool.new()
        error := null()
        id := unsafe {
            m_p_pp(self.id(), sel(ptr.from_mut(&mut S_NEW_LIBRARY_WITH_DATA), b"newLibraryWithData:error:\0"), data, ptr.from_mut(&mut error))
        }
        result := adopt_or_error(id, error)
        core.drop(pool)
        unsafe {
            dispatch_release(data)
        }
        object := result?
        return ok(Library { object: object })
    }

    pub fn new_compute_pipeline_state(&self, function: &Function) -> ComputePipelineState!Error {
        pool := objc.AutoreleasePool.new()
        error := null()
        id := unsafe {
            m_p_pp(self.id(), sel(ptr.from_mut(&mut S_NEW_COMPUTE_PIPELINE_STATE), b"newComputePipelineStateWithFunction:error:\0"), function.object.as_ptr(), ptr.from_mut(&mut error))
        }
        result := adopt_or_error(id, error)
        core.drop(pool)
        object := result?
        return ok(ComputePipelineState { object: object })
    }

    pub fn new_render_pipeline_state(&self, descriptor: &RenderPipelineDescriptor) -> RenderPipelineState!Error {
        pool := objc.AutoreleasePool.new()
        error := null()
        id := unsafe {
            m_p_pp(self.id(), sel(ptr.from_mut(&mut S_NEW_RENDER_PIPELINE_STATE), b"newRenderPipelineStateWithDescriptor:error:\0"), descriptor.object.as_ptr(), ptr.from_mut(&mut error))
        }
        result := adopt_or_error(id, error)
        core.drop(pool)
        object := result?
        return ok(RenderPipelineState { object: object })
    }

    pub fn new_fence(&self) -> Fence!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p(self.id(), sel(ptr.from_mut(&mut S_NEW_FENCE), b"newFence\0"))
        })?
        return ok(Fence { object: object })
    }

    // An event for ordering command buffers on this device.
    pub fn new_event(&self) -> Event!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p(self.id(), sel(ptr.from_mut(&mut S_NEW_EVENT), b"newEvent\0"))
        })?
        return ok(Event { object: object })
    }

    // An event the CPU can also read and signal.
    pub fn new_shared_event(&self) -> SharedEvent!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p(self.id(), sel(ptr.from_mut(&mut S_NEW_SHARED_EVENT), b"newSharedEvent\0"))
        })?
        return ok(SharedEvent { object: object })
    }
}

// The GPUs Device.all() found.
pub struct DeviceList {
    array: Option<objc.NSArray>

    pub fn len(&self) -> usize {
        match &self.array {
            some(array) => {
                return array.len()
            }
            none => {
                return 0
            }
        }
    }

    pub fn get(&self, index: usize) -> Option<Device> {
        match &self.array {
            some(array) => {
                match array.get(index) {
                    some(object) => {
                        return some(Device { object: object })
                    }
                    none => {
                        return none
                    }
                }
            }
            none => {
                return none
            }
        }
    }
}

static mut S_COMMAND_BUFFER: usize = 0
static mut S_COMMAND_BUFFER_UNRETAINED: usize = 0

// MTLCommandQueue: submits command buffers to the GPU in order.
@unsafe_send
@unsafe_sync
pub unsafe struct CommandQueue {
    object: objc.Object

    // Safety: `object` is an MTLCommandQueue.
    pub unsafe fn from_object(object: objc.Object) -> CommandQueue {
        return CommandQueue { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn clone(&self) -> CommandQueue {
        return CommandQueue { object: self.object.clone() }
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.object.as_ptr(), text)
    }

    pub fn label(&self) -> Option<objc.NSString> {
        return label(self.object.as_ptr())
    }

    // A new command buffer that retains every resource it uses until the
    // GPU has finished with it.
    pub fn command_buffer(&self) -> CommandBuffer!Error {
        match get(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_COMMAND_BUFFER)
        }, b"commandBuffer\0")) {
            some(object) => {
                return ok(CommandBuffer { object: object })
            }
            none => {
                return err(Error.OutOfMemory)
            }
        }
    }

    // A command buffer that does not retain the resources it uses: the
    // program must keep them alive until the buffer completes.
    pub fn command_buffer_with_unretained_references(&self) -> CommandBuffer!Error {
        match get(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_COMMAND_BUFFER_UNRETAINED)
        }, b"commandBufferWithUnretainedReferences\0")) {
            some(object) => {
                return ok(CommandBuffer { object: object })
            }
            none => {
                return err(Error.OutOfMemory)
            }
        }
    }
}

static mut S_COMPUTE_COMMAND_ENCODER: usize = 0
static mut S_RENDER_COMMAND_ENCODER: usize = 0
static mut S_BLIT_COMMAND_ENCODER: usize = 0
static mut S_COMMIT: usize = 0
static mut S_ENQUEUE: usize = 0
static mut S_WAIT_UNTIL_SCHEDULED: usize = 0
static mut S_WAIT_UNTIL_COMPLETED: usize = 0
static mut S_STATUS: usize = 0
static mut S_ERROR: usize = 0
static mut S_PRESENT_DRAWABLE: usize = 0
static mut S_ENCODE_SIGNAL_EVENT: usize = 0
static mut S_ENCODE_WAIT_FOR_EVENT: usize = 0
static mut S_GPU_START_TIME: usize = 0
static mut S_GPU_END_TIME: usize = 0

// MTLCommandBuffer: commands recorded by encoders, then committed to the
// queue. One encoder at a time may record into it.
@unsafe_send
pub unsafe struct CommandBuffer {
    object: objc.Object

    // Safety: `object` is an MTLCommandBuffer.
    pub unsafe fn from_object(object: objc.Object) -> CommandBuffer {
        return CommandBuffer { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn label(&self) -> Option<objc.NSString> {
        return label(self.id())
    }

    pub fn push_debug_group(&self, text: &str) {
        push_debug_group(self.id(), text)
    }

    pub fn pop_debug_group(&self) {
        pop_debug_group(self.id())
    }

    pub fn compute_command_encoder(&self) -> ComputeCommandEncoder!Error {
        match get(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_COMPUTE_COMMAND_ENCODER)
        }, b"computeCommandEncoder\0")) {
            some(object) => {
                return ok(ComputeCommandEncoder { object: object })
            }
            none => {
                return err(Error.OutOfMemory)
            }
        }
    }

    pub fn render_command_encoder(&self, descriptor: &RenderPassDescriptor) -> RenderCommandEncoder!Error {
        unsafe {
            pool := objc.AutoreleasePool.new()
            id := m_p_p(self.id(), sel(ptr.from_mut(&mut S_RENDER_COMMAND_ENCODER), b"renderCommandEncoderWithDescriptor:\0"), descriptor.object.as_ptr())
            object := objc.Object.retain(id)
            core.drop(pool)
            match object {
                some(value) => {
                    return ok(RenderCommandEncoder { object: value })
                }
                none => {
                    return err(Error.OutOfMemory)
                }
            }
        }
    }

    pub fn blit_command_encoder(&self) -> BlitCommandEncoder!Error {
        match get(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_BLIT_COMMAND_ENCODER)
        }, b"blitCommandEncoder\0")) {
            some(object) => {
                return ok(BlitCommandEncoder { object: object })
            }
            none => {
                return err(Error.OutOfMemory)
            }
        }
    }

    // Reserve this buffer's place in the queue before committing it.
    pub fn enqueue(&self) {
        unsafe {
            m_v(self.id(), sel(ptr.from_mut(&mut S_ENQUEUE), b"enqueue\0"))
        }
    }

    // Submit the recorded commands. Nothing more can be encoded afterwards.
    pub fn commit(&self) {
        unsafe {
            m_v(self.id(), sel(ptr.from_mut(&mut S_COMMIT), b"commit\0"))
        }
    }

    pub fn wait_until_scheduled(&self) {
        unsafe {
            m_v(self.id(), sel(ptr.from_mut(&mut S_WAIT_UNTIL_SCHEDULED), b"waitUntilScheduled\0"))
        }
    }

    // Block until the GPU has finished, then report how it went: Err(Failed)
    // carries Metal's description of a failed command buffer.
    pub fn wait_until_completed(&self) -> void!Error {
        unsafe {
            m_v(self.id(), sel(ptr.from_mut(&mut S_WAIT_UNTIL_COMPLETED), b"waitUntilCompleted\0"))
        }
        if self.status() == COMMAND_BUFFER_STATUS_ERROR {
            match self.error() {
                some(error) => {
                    return err(Error.Failed(error))
                }
                none => {
                    return err(Error.OutOfMemory)
                }
            }
        }
        return ok()
    }

    pub fn status(&self) -> CommandBufferStatus {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_STATUS)
        }, b"status\0"))
    }

    // Why the command buffer failed, once its status is
    // COMMAND_BUFFER_STATUS_ERROR.
    pub fn error(&self) -> Option<objc.NSError> {
        match get(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_ERROR)
        }, b"error\0")) {
            some(object) => {
                return some(unsafe {
                    objc.NSError.from_object(object)
                })
            }
            none => {
                return none
            }
        }
    }

    // Show the drawable as soon as this command buffer has been scheduled.
    pub fn present_drawable(&self, drawable: &Drawable) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_PRESENT_DRAWABLE)
        }, b"presentDrawable:\0"), drawable.object.as_ptr())
    }

    // Set the event to `value` once the commands before this point finish.
    pub fn encode_signal_event(&self, event: &Event, value: u64) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_ENCODE_SIGNAL_EVENT), b"encodeSignalEvent:value:\0"), event.object.as_ptr(), value as usize)
        }
    }

    // Hold later commands until the event reaches `value`.
    pub fn encode_wait_for_event(&self, event: &Event, value: u64) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_ENCODE_WAIT_FOR_EVENT), b"encodeWaitForEvent:value:\0"), event.object.as_ptr(), value as usize)
        }
    }

    pub fn encode_signal_shared_event(&self, event: &SharedEvent, value: u64) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_ENCODE_SIGNAL_EVENT), b"encodeSignalEvent:value:\0"), event.object.as_ptr(), value as usize)
        }
    }

    pub fn encode_wait_for_shared_event(&self, event: &SharedEvent, value: u64) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_ENCODE_WAIT_FOR_EVENT), b"encodeWaitForEvent:value:\0"), event.object.as_ptr(), value as usize)
        }
    }

    // When the GPU started and finished this buffer, in seconds on the
    // host's mach_absolute_time clock; 0 until it completes.
    pub fn gpu_start_time(&self) -> f64 {
        return unsafe {
            m_d(self.id(), sel(ptr.from_mut(&mut S_GPU_START_TIME), b"GPUStartTime\0"))
        }
    }

    pub fn gpu_end_time(&self) -> f64 {
        return unsafe {
            m_d(self.id(), sel(ptr.from_mut(&mut S_GPU_END_TIME), b"GPUEndTime\0"))
        }
    }
}

static mut S_SET_COMPUTE_PIPELINE_STATE: usize = 0
static mut S_SET_BUFFER: usize = 0
static mut S_SET_BUFFER_OFFSET: usize = 0
static mut S_SET_BYTES: usize = 0
static mut S_SET_TEXTURE: usize = 0
static mut S_SET_SAMPLER_STATE: usize = 0
static mut S_SET_THREADGROUP_MEMORY_LENGTH: usize = 0
static mut S_DISPATCH_THREADGROUPS: usize = 0
static mut S_DISPATCH_THREADS: usize = 0
static mut S_DISPATCH_THREADGROUPS_INDIRECT: usize = 0
static mut S_USE_RESOURCE: usize = 0
static mut S_USE_RESOURCE_STAGES: usize = 0
static mut S_MEMORY_BARRIER: usize = 0
static mut S_MEMORY_BARRIER_STAGES: usize = 0
static mut S_UPDATE_FENCE: usize = 0
static mut S_WAIT_FOR_FENCE: usize = 0
static mut S_UPDATE_FENCE_STAGES: usize = 0
static mut S_WAIT_FOR_FENCE_STAGES: usize = 0

// MTLComputeCommandEncoder: records compute dispatches. Binding indices
// above the MAX_*_BINDINGS limits panic.
pub struct ComputeCommandEncoder {
    object: objc.Object

    // Safety: `object` is an MTLComputeCommandEncoder.
    pub unsafe fn from_object(object: objc.Object) -> ComputeCommandEncoder {
        return ComputeCommandEncoder { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn push_debug_group(&self, text: &str) {
        push_debug_group(self.id(), text)
    }

    pub fn pop_debug_group(&self) {
        pop_debug_group(self.id())
    }

    pub fn insert_debug_signpost(&self, text: &str) {
        insert_debug_signpost(self.id(), text)
    }

    pub fn set_compute_pipeline_state(&self, state: &ComputePipelineState) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_COMPUTE_PIPELINE_STATE)
        }, b"setComputePipelineState:\0"), state.object.as_ptr())
    }

    // Bind `buffer`, starting `offset` bytes in, to [[buffer(index)]].
    pub fn set_buffer(&self, buffer: &Buffer, offset: usize, index: usize) {
        check_buffer_index(index)
        unsafe {
            m_v_puu(self.id(), sel(ptr.from_mut(&mut S_SET_BUFFER), b"setBuffer:offset:atIndex:\0"), buffer.object.as_ptr(), offset, index)
        }
    }

    // Move the offset of the buffer already bound at `index`.
    pub fn set_buffer_offset(&self, offset: usize, index: usize) {
        check_buffer_index(index)
        unsafe {
            m_v_uu(self.id(), sel(ptr.from_mut(&mut S_SET_BUFFER_OFFSET), b"setBufferOffset:atIndex:\0"), offset, index)
        }
    }

    // Copy a few bytes of constants (Metal suggests under 4 KiB) into
    // [[buffer(index)]] without creating a buffer.
    pub fn set_bytes(&self, bytes: &[u8], index: usize) {
        check_buffer_index(index)
        unsafe {
            m_v_quu(self.id(), sel(ptr.from_mut(&mut S_SET_BYTES), b"setBytes:length:atIndex:\0"), ptr.as_ptr(bytes), bytes.len, index)
        }
    }

    pub fn set_texture(&self, texture: &Texture, index: usize) {
        check_texture_index(index)
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_SET_TEXTURE), b"setTexture:atIndex:\0"), texture.object.as_ptr(), index)
        }
    }

    pub fn set_sampler_state(&self, sampler: &SamplerState, index: usize) {
        check_sampler_index(index)
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_SET_SAMPLER_STATE), b"setSamplerState:atIndex:\0"), sampler.object.as_ptr(), index)
        }
    }

    // Reserve `length` bytes (a multiple of 16) for [[threadgroup(index)]].
    pub fn set_threadgroup_memory_length(&self, length: usize, index: usize) {
        check_buffer_index(index)
        unsafe {
            m_v_uu(self.id(), sel(ptr.from_mut(&mut S_SET_THREADGROUP_MEMORY_LENGTH), b"setThreadgroupMemoryLength:atIndex:\0"), length, index)
        }
    }

    // Run `threadgroups` groups of `threads_per_threadgroup` threads each.
    pub fn dispatch_threadgroups(&self, threadgroups: Size, threads_per_threadgroup: Size) {
        unsafe {
            m_v_SS(self.id(), sel(ptr.from_mut(&mut S_DISPATCH_THREADGROUPS), b"dispatchThreadgroups:threadsPerThreadgroup:\0"), threadgroups, threads_per_threadgroup)
        }
    }

    // Run exactly `threads` threads, which need not be a multiple of the
    // threadgroup size (GPU_FAMILY_APPLE4 or GPU_FAMILY_MAC2 and later).
    pub fn dispatch_threads(&self, threads: Size, threads_per_threadgroup: Size) {
        unsafe {
            m_v_SS(self.id(), sel(ptr.from_mut(&mut S_DISPATCH_THREADS), b"dispatchThreads:threadsPerThreadgroup:\0"), threads, threads_per_threadgroup)
        }
    }

    // Read the threadgroup counts as three u32 values from the buffer.
    pub fn dispatch_threadgroups_indirect(&self, buffer: &Buffer, offset: usize, threads_per_threadgroup: Size) {
        unsafe {
            m_v_puS(self.id(), sel(ptr.from_mut(&mut S_DISPATCH_THREADGROUPS_INDIRECT), b"dispatchThreadgroupsWithIndirectBuffer:indirectBufferOffset:threadsPerThreadgroup:\0"), buffer.object.as_ptr(), offset, threads_per_threadgroup)
        }
    }

    // Make a buffer reached only through an argument buffer resident.
    pub fn use_buffer(&self, buffer: &Buffer, usage: ResourceUsage) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_USE_RESOURCE), b"useResource:usage:\0"), buffer.object.as_ptr(), usage)
        }
    }

    pub fn use_texture(&self, texture: &Texture, usage: ResourceUsage) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_USE_RESOURCE), b"useResource:usage:\0"), texture.object.as_ptr(), usage)
        }
    }

    // Order earlier dispatches' writes before later dispatches' accesses.
    pub fn memory_barrier(&self, scope: BarrierScope) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_MEMORY_BARRIER)
        }, b"memoryBarrierWithScope:\0"), scope)
    }

    pub fn update_fence(&self, fence: &Fence) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_UPDATE_FENCE)
        }, b"updateFence:\0"), fence.object.as_ptr())
    }

    pub fn wait_for_fence(&self, fence: &Fence) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_WAIT_FOR_FENCE)
        }, b"waitForFence:\0"), fence.object.as_ptr())
    }

    // Finish recording. The encoder cannot be used again.
    pub fn end_encoding(self) {
        end_encoding(self.id())
    }
}

