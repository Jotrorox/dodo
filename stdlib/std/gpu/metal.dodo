        unsafe {
            m_v_uu(self.id(), sel(ptr.from_mut(&mut S_SET_VERTEX_BUFFER_OFFSET), b"setVertexBufferOffset:atIndex:\0"), offset, index)
        }
    }

    pub fn set_vertex_bytes(&self, bytes: &[u8], index: usize) {
        check_buffer_index(index)
        unsafe {
            m_v_quu(self.id(), sel(ptr.from_mut(&mut S_SET_VERTEX_BYTES), b"setVertexBytes:length:atIndex:\0"), ptr.as_ptr(bytes), bytes.len, index)
        }
    }

    pub fn set_vertex_texture(&self, texture: &Texture, index: usize) {
