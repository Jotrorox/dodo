// MTLRenderPipelineDescriptor: shaders and fixed-function state for
// Device.new_render_pipeline_state.
pub struct RenderPipelineDescriptor {
    object: objc.Object

    pub fn new() -> RenderPipelineDescriptor!Error {
        object := instantiate(unsafe {
            ptr.from_mut(&mut C_RENDER_PIPELINE_DESCRIPTOR)
        }, b"MTLRenderPipelineDescriptor\0")?
        return ok(RenderPipelineDescriptor { object: object })
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn set_vertex_function(&self, function: &Function) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_VERTEX_FUNCTION)
        }, b"setVertexFunction:\0"), function.object.as_ptr())
    }

    pub fn set_fragment_function(&self, function: &Function) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_FRAGMENT_FUNCTION)
        }, b"setFragmentFunction:\0"), function.object.as_ptr())
    }

    // How [[stage_in]] vertex attributes are fetched from buffers.
    pub fn set_vertex_descriptor(&self, descriptor: &VertexDescriptor) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_VERTEX_DESCRIPTOR)
        }, b"setVertexDescriptor:\0"), descriptor.object.as_ptr())
    }

    // Color attachment `index` (below MAX_COLOR_ATTACHMENTS); changes to
    // it change this descriptor.
    pub fn color_attachment(&self, index: usize) -> RenderPipelineColorAttachment!Error {
        if index >= MAX_COLOR_ATTACHMENTS {
            return err(Error.InvalidInput)
        }
        object := element(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_COLOR_ATTACHMENTS)
        }, b"colorAttachments\0"), index)?
        return ok(RenderPipelineColorAttachment { object: object })
    }

    pub fn set_depth_attachment_pixel_format(&self, format: PixelFormat) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_DEPTH_ATTACHMENT_PIXEL_FORMAT)
