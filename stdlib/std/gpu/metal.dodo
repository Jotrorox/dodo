        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_INPUT_PRIMITIVE_TOPOLOGY)
        }, b"setInputPrimitiveTopology:\0"), topology)
    }

    pub fn set_alpha_to_coverage_enabled(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_ALPHA_TO_COVERAGE_ENABLED)
        }, b"setAlphaToCoverageEnabled:\0"), value)
    }

    // False runs only the vertex stage, for vertex shaders that write
    // buffers.
    pub fn set_rasterization_enabled(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_RASTERIZATION_ENABLED)
        }, b"setRasterizationEnabled:\0"), value)
    }
}

