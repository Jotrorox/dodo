// MTLRenderPassDescriptor: the attachments one render pass draws into and
// what happens to them at its start and end.
pub struct RenderPassDescriptor {
    object: objc.Object

    pub fn new() -> RenderPassDescriptor!Error {
        object := instantiate(unsafe {
            ptr.from_mut(&mut C_RENDER_PASS_DESCRIPTOR)
        }, b"MTLRenderPassDescriptor\0")?
        return ok(RenderPassDescriptor { object: object })
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    // Color attachment `index` (below MAX_COLOR_ATTACHMENTS); changes to
    // it change this descriptor.
    pub fn color_attachment(&self, index: usize) -> RenderPassColorAttachment!Error {
        if index >= MAX_COLOR_ATTACHMENTS {
