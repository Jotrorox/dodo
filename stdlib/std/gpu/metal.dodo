static mut S_SET_LOAD_ACTION: usize = 0
static mut S_SET_STORE_ACTION: usize = 0
static mut S_SET_RESOLVE_LEVEL: usize = 0
static mut S_SET_RESOLVE_SLICE: usize = 0
static mut S_SET_CLEAR_COLOR: usize = 0
static mut S_SET_CLEAR_DEPTH: usize = 0
static mut S_SET_CLEAR_STENCIL: usize = 0

// The settings every kind of render pass attachment shares.
fn attachment_set_texture(receiver: objc.Id, texture: &Texture) {
    set_object(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_ATTACHMENT_TEXTURE)
    }, b"setTexture:\0"), texture.object.as_ptr())
}

fn attachment_set_resolve_texture(receiver: objc.Id, texture: &Texture) {
    set_object(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_RESOLVE_TEXTURE)
    }, b"setResolveTexture:\0"), texture.object.as_ptr())
}

fn attachment_set_place(receiver: objc.Id, level: usize, slice: usize, depth_plane: usize) {
    set_usize(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_LEVEL)
    }, b"setLevel:\0"), level)
    set_usize(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_SLICE)
    }, b"setSlice:\0"), slice)
    set_usize(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_DEPTH_PLANE)
    }, b"setDepthPlane:\0"), depth_plane)
}

fn attachment_set_resolve_place(receiver: objc.Id, level: usize, slice: usize) {
    set_usize(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_RESOLVE_LEVEL)
    }, b"setResolveLevel:\0"), level)
    set_usize(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_RESOLVE_SLICE)
    }, b"setResolveSlice:\0"), slice)
}

fn attachment_set_load_action(receiver: objc.Id, action: LoadAction) {
    set_usize(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_LOAD_ACTION)
    }, b"setLoadAction:\0"), action)
}

fn attachment_set_store_action(receiver: objc.Id, action: StoreAction) {
    set_usize(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_STORE_ACTION)
    }, b"setStoreAction:\0"), action)
}

// MTLRenderPassColorAttachmentDescriptor.
pub struct RenderPassColorAttachment {
    object: objc.Object

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn set_texture(&self, texture: &Texture) {
        attachment_set_texture(self.object.as_ptr(), texture)
    }

    // Where a multisample attachment resolves to, with
    // STORE_ACTION_MULTISAMPLE_RESOLVE.
    pub fn set_resolve_texture(&self, texture: &Texture) {
        attachment_set_resolve_texture(self.object.as_ptr(), texture)
    }

    // Which mipmap level, array slice and 3D depth plane to draw into.
    pub fn set_place(&self, level: usize, slice: usize, depth_plane: usize) {
        attachment_set_place(self.object.as_ptr(), level, slice, depth_plane)
    }

    pub fn set_resolve_place(&self, level: usize, slice: usize) {
        attachment_set_resolve_place(self.object.as_ptr(), level, slice)
    }

    pub fn set_load_action(&self, action: LoadAction) {
        attachment_set_load_action(self.object.as_ptr(), action)
    }

    pub fn set_store_action(&self, action: StoreAction) {
        attachment_set_store_action(self.object.as_ptr(), action)
    }

    pub fn set_clear_color(&self, color: ClearColor) {
        unsafe {
            m_v_C(self.object.as_ptr(), sel(ptr.from_mut(&mut S_SET_CLEAR_COLOR), b"setClearColor:\0"), color)
        }
    }
}

// MTLRenderPassDepthAttachmentDescriptor.
pub struct RenderPassDepthAttachment {
    object: objc.Object

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn set_texture(&self, texture: &Texture) {
        attachment_set_texture(self.object.as_ptr(), texture)
    }

    pub fn set_resolve_texture(&self, texture: &Texture) {
        attachment_set_resolve_texture(self.object.as_ptr(), texture)
    }

    pub fn set_place(&self, level: usize, slice: usize, depth_plane: usize) {
        attachment_set_place(self.object.as_ptr(), level, slice, depth_plane)
    }

    pub fn set_load_action(&self, action: LoadAction) {
        attachment_set_load_action(self.object.as_ptr(), action)
    }

    pub fn set_store_action(&self, action: StoreAction) {
        attachment_set_store_action(self.object.as_ptr(), action)
    }

    // The depth a clear load action writes, 0 through 1.
    pub fn set_clear_depth(&self, depth: f64) {
        unsafe {
            m_v_d(self.object.as_ptr(), sel(ptr.from_mut(&mut S_SET_CLEAR_DEPTH), b"setClearDepth:\0"), depth)
        }
    }
}

// MTLRenderPassStencilAttachmentDescriptor.
pub struct RenderPassStencilAttachment {
    object: objc.Object

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn set_texture(&self, texture: &Texture) {
        attachment_set_texture(self.object.as_ptr(), texture)
    }

    pub fn set_place(&self, level: usize, slice: usize, depth_plane: usize) {
        attachment_set_place(self.object.as_ptr(), level, slice, depth_plane)
    }

    pub fn set_load_action(&self, action: LoadAction) {
        attachment_set_load_action(self.object.as_ptr(), action)
    }

    pub fn set_store_action(&self, action: StoreAction) {
        attachment_set_store_action(self.object.as_ptr(), action)
    }

    pub fn set_clear_stencil(&self, value: u32) {
        unsafe {
            m_v_w(self.object.as_ptr(), sel(ptr.from_mut(&mut S_SET_CLEAR_STENCIL), b"setClearStencil:\0"), value)
        }
    }
}

// MTLFence: orders resource accesses between encoders of one queue.
@unsafe_send
@unsafe_sync
pub unsafe struct Fence {
    object: objc.Object

    // Safety: `object` is an MTLFence.
    pub unsafe fn from_object(object: objc.Object) -> Fence {
        return Fence { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.object.as_ptr(), text)
    }
}

// MTLEvent: orders command buffers on one device.
@unsafe_send
@unsafe_sync
pub unsafe struct Event {
    object: objc.Object

    // Safety: `object` is an MTLEvent.
    pub unsafe fn from_object(object: objc.Object) -> Event {
        return Event { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.object.as_ptr(), text)
    }
}

static mut S_SIGNALED_VALUE: usize = 0
static mut S_SET_SIGNALED_VALUE: usize = 0

// MTLSharedEvent: an event whose value the CPU can read and set, for
// waiting on the GPU without blocking in wait_until_completed.
@unsafe_send
@unsafe_sync
pub unsafe struct SharedEvent {
    object: objc.Object

    // Safety: `object` is an MTLSharedEvent.
    pub unsafe fn from_object(object: objc.Object) -> SharedEvent {
        return SharedEvent { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.object.as_ptr(), text)
    }

    pub fn signaled_value(&self) -> u64 {
        return get_usize(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SIGNALED_VALUE)
        }, b"signaledValue\0")) as u64
    }

    pub fn set_signaled_value(&self, value: u64) {
        set_usize(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SET_SIGNALED_VALUE)
        }, b"setSignaledValue:\0"), value as usize)
    }
}

static mut C_METAL_LAYER: usize = 0
static mut S_SET_DEVICE: usize = 0
static mut S_SET_FRAMEBUFFER_ONLY: usize = 0
static mut S_SET_DRAWABLE_SIZE: usize = 0
static mut S_DRAWABLE_SIZE: usize = 0
static mut S_SET_MAXIMUM_DRAWABLE_COUNT: usize = 0
static mut S_SET_DISPLAY_SYNC_ENABLED: usize = 0
static mut S_SET_CONTENTS_SCALE: usize = 0
static mut S_SET_OPAQUE: usize = 0
static mut S_NEXT_DRAWABLE: usize = 0
static mut S_SET_LAYER: usize = 0
static mut S_SET_WANTS_LAYER: usize = 0
static mut S_TEXTURE: usize = 0
static mut S_PRESENT: usize = 0

// CAMetalLayer: a Core Animation layer whose contents are Metal textures,
// handed out one frame at a time by next_drawable.
pub struct MetalLayer {
    object: objc.Object

    pub fn new() -> MetalLayer!Error {
        object := instantiate(unsafe {
            ptr.from_mut(&mut C_METAL_LAYER)
        }, b"CAMetalLayer\0")?
        return ok(MetalLayer { object: object })
    }

    // Safety: `object` is a CAMetalLayer.
    pub unsafe fn from_object(object: objc.Object) -> MetalLayer {
        return MetalLayer { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_device(&self, device: &Device) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_DEVICE)
        }, b"setDevice:\0"), device.object.as_ptr())
    }

    // PIXEL_FORMAT_BGRA8_UNORM (the default), its sRGB form,
    // PIXEL_FORMAT_RGBA16_FLOAT, PIXEL_FORMAT_BGR10A2_UNORM or an XR format.
    pub fn set_pixel_format(&self, format: PixelFormat) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_PIXEL_FORMAT)
        }, b"setPixelFormat:\0"), format)
    }

    // True (the default) allows drawables only as render targets, which is
    // faster; false also allows sampling and blits.
    pub fn set_framebuffer_only(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_FRAMEBUFFER_ONLY)
        }, b"setFramebufferOnly:\0"), value)
    }

    // The drawables' size in pixels.
    pub fn set_drawable_size(&self, width: f64, height: f64) {
        unsafe {
            m_v_G(self.id(), sel(ptr.from_mut(&mut S_SET_DRAWABLE_SIZE), b"setDrawableSize:\0"), CGSize.new(width, height))
        }
    }

    pub fn drawable_size(&self) -> CGSize {
        return unsafe {
            m_G(self.id(), sel(ptr.from_mut(&mut S_DRAWABLE_SIZE), b"drawableSize\0"))
        }
    }

    // 2 or 3 (the default) drawables in flight.
    pub fn set_maximum_drawable_count(&self, count: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_MAXIMUM_DRAWABLE_COUNT)
        }, b"setMaximumDrawableCount:\0"), count)
    }

    // False presents immediately instead of at the display's refresh.
    pub fn set_display_sync_enabled(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_DISPLAY_SYNC_ENABLED)
        }, b"setDisplaySyncEnabled:\0"), value)
    }

    // Pixels per point, such as 2 on a Retina display.
    pub fn set_contents_scale(&self, scale: f64) {
        unsafe {
            m_v_d(self.id(), sel(ptr.from_mut(&mut S_SET_CONTENTS_SCALE), b"setContentsScale:\0"), scale)
        }
    }

    pub fn set_opaque(&self, value: bool) {
        set_bool(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_OPAQUE)
        }, b"setOpaque:\0"), value)
    }

    // The next texture to draw a frame into. Waits up to a second for one
    // to become free; none if none did or the layer has no device or size.
    pub fn next_drawable(&self) -> Option<Drawable> {
        match get(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_NEXT_DRAWABLE)
        }, b"nextDrawable\0")) {
            some(object) => {
                return some(Drawable { object: object })
            }
            none => {
                return none
            }
        }
    }

    // Make this layer the backing layer of an AppKit view, which then shows
    // whatever is presented to it.
    //
    // Safety: `view` is a live NSView, and the call is on the main thread.
    pub unsafe fn attach_to_view(&self, view: objc.Id) {
        set_object(view, sel(unsafe {
            ptr.from_mut(&mut S_SET_LAYER)
        }, b"setLayer:\0"), self.id())
        set_bool(view, sel(unsafe {
            ptr.from_mut(&mut S_SET_WANTS_LAYER)
        }, b"setWantsLayer:\0"), true)
    }
}

// CAMetalDrawable: one frame of a MetalLayer.
pub struct Drawable {
    object: objc.Object

    // Safety: `object` is a CAMetalDrawable.
    pub unsafe fn from_object(object: objc.Object) -> Drawable {
        return Drawable { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    // The texture to render the frame into.
    pub fn texture(&self) -> Texture!Error {
        match get(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_TEXTURE)
        }, b"texture\0")) {
            some(object) => {
                return ok(Texture { object: object })
            }
            none => {
                return err(Error.OutOfMemory)
            }
        }
    }

    // Show the frame now. Prefer CommandBuffer.present_drawable, which
    // waits for the rendering commands to be scheduled.
    pub fn present(&self) {
        unsafe {
            m_v(self.object.as_ptr(), sel(ptr.from_mut(&mut S_PRESENT), b"present\0"))
        }
    }
}

