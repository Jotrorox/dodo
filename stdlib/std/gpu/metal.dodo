        }
    }

    pub fn set_fragment_texture(&self, texture: &Texture, index: usize) {
        check_texture_index(index)
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_SET_FRAGMENT_TEXTURE), b"setFragmentTexture:atIndex:\0"), texture.object.as_ptr(), index)
        }
    }

    pub fn set_fragment_sampler_state(&self, sampler: &SamplerState, index: usize) {
