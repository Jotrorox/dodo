        unsafe {
            m_v_uu(self.id(), sel(ptr.from_mut(&mut S_SET_FRAGMENT_BUFFER_OFFSET), b"setFragmentBufferOffset:atIndex:\0"), offset, index)
        }
    }

    pub fn set_fragment_bytes(&self, bytes: &[u8], index: usize) {
        check_buffer_index(index)
        unsafe {
