            m_v_ww(self.id(), sel(ptr.from_mut(&mut S_SET_STENCIL_FRONT_BACK_REFERENCE), b"setStencilFrontReferenceValue:backReferenceValue:\0"), front, back)
        }
    }

    // The constant color BLEND_FACTOR_BLEND_COLOR and friends use.
    pub fn set_blend_color(&self, red: f32, green: f32, blue: f32, alpha: f32) {
        unsafe {
            m_v_ffff(self.id(), sel(ptr.from_mut(&mut S_SET_BLEND_COLOR), b"setBlendColorRed:green:blue:alpha:\0"), red, green, blue, alpha)
        }
    }

    pub fn set_depth_bias(&self, bias: f32, slope_scale: f32, clamp: f32) {
        unsafe {
            m_v_fff(self.id(), sel(ptr.from_mut(&mut S_SET_DEPTH_BIAS), b"setDepthBias:slopeScale:clamp:\0"), bias, slope_scale, clamp)
        }
    }

    pub fn draw_primitives(&self, primitive: PrimitiveType, vertex_start: usize, vertex_count: usize) {
        unsafe {
            m_v_uuu(self.id(), sel(ptr.from_mut(&mut S_DRAW_PRIMITIVES), b"drawPrimitives:vertexStart:vertexCount:\0"), primitive, vertex_start, vertex_count)
        }
    }

    pub fn draw_primitives_instanced(&self, primitive: PrimitiveType, vertex_start: usize, vertex_count: usize, instance_count: usize, base_instance: usize) {
        unsafe {
            m_v_uuuuu(self.id(), sel(ptr.from_mut(&mut S_DRAW_PRIMITIVES_INSTANCED), b"drawPrimitives:vertexStart:vertexCount:instanceCount:baseInstance:\0"), primitive, vertex_start, vertex_count, instance_count, base_instance)
        }
    }

    // Draw `index_count` vertices whose indices start `index_offset` bytes
    // into `index_buffer`; base_vertex is added to every index.
    pub fn draw_indexed_primitives(&self, primitive: PrimitiveType, index_count: usize, index_type: IndexType, index_buffer: &Buffer, index_offset: usize, instance_count: usize, base_vertex: isize, base_instance: usize) {
        unsafe {
            m_v_uuupuuiu(self.id(), sel(ptr.from_mut(&mut S_DRAW_INDEXED_PRIMITIVES), b"drawIndexedPrimitives:indexCount:indexType:indexBuffer:indexBufferOffset:instanceCount:baseVertex:baseInstance:\0"), primitive, index_count, index_type, index_buffer.object.as_ptr(), index_offset, instance_count, base_vertex, base_instance)
        }
    }

    // Read the draw's arguments (MTLDrawPrimitivesIndirectArguments) from
    // the buffer.
    pub fn draw_primitives_indirect(&self, primitive: PrimitiveType, indirect_buffer: &Buffer, indirect_offset: usize) {
        unsafe {
            m_v_upu(self.id(), sel(ptr.from_mut(&mut S_DRAW_PRIMITIVES_INDIRECT), b"drawPrimitives:indirectBuffer:indirectBufferOffset:\0"), primitive, indirect_buffer.object.as_ptr(), indirect_offset)
        }
    }

    pub fn draw_indexed_primitives_indirect(&self, primitive: PrimitiveType, index_type: IndexType, index_buffer: &Buffer, index_offset: usize, indirect_buffer: &Buffer, indirect_offset: usize) {
        unsafe {
            m_v_uupupu(self.id(), sel(ptr.from_mut(&mut S_DRAW_INDEXED_PRIMITIVES_INDIRECT), b"drawIndexedPrimitives:indexType:indexBuffer:indexBufferOffset:indirectBuffer:indirectBufferOffset:\0"), primitive, index_type, index_buffer.object.as_ptr(), index_offset, indirect_buffer.object.as_ptr(), indirect_offset)
        }
    }

    pub fn use_buffer(&self, buffer: &Buffer, usage: ResourceUsage, stages: RenderStages) {
        unsafe {
            m_v_puu(self.id(), sel(ptr.from_mut(&mut S_USE_RESOURCE_STAGES), b"useResource:usage:stages:\0"), buffer.object.as_ptr(), usage, stages)
        }
    }

    pub fn use_texture(&self, texture: &Texture, usage: ResourceUsage, stages: RenderStages) {
        unsafe {
            m_v_puu(self.id(), sel(ptr.from_mut(&mut S_USE_RESOURCE_STAGES), b"useResource:usage:stages:\0"), texture.object.as_ptr(), usage, stages)
        }
    }

    pub fn memory_barrier(&self, scope: BarrierScope, after: RenderStages, before: RenderStages) {
        unsafe {
            m_v_uuu(self.id(), sel(ptr.from_mut(&mut S_MEMORY_BARRIER_STAGES), b"memoryBarrierWithScope:afterStages:beforeStages:\0"), scope, after, before)
        }
    }

    pub fn update_fence(&self, fence: &Fence, after: RenderStages) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_UPDATE_FENCE_STAGES), b"updateFence:afterStages:\0"), fence.object.as_ptr(), after)
        }
    }

    pub fn wait_for_fence(&self, fence: &Fence, before: RenderStages) {
        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_WAIT_FOR_FENCE_STAGES), b"waitForFence:beforeStages:\0"), fence.object.as_ptr(), before)
        }
    }

    pub fn end_encoding(self) {
        end_encoding(self.id())
    }
}

static mut S_COPY_BUFFER: usize = 0
static mut S_COPY_BUFFER_TO_TEXTURE: usize = 0
static mut S_COPY_TEXTURE_TO_BUFFER: usize = 0
static mut S_COPY_TEXTURE: usize = 0
static mut S_FILL_BUFFER: usize = 0
static mut S_GENERATE_MIPMAPS: usize = 0
static mut S_SYNCHRONIZE_RESOURCE: usize = 0

// MTLBlitCommandEncoder: records copies, fills and mipmap generation.
pub struct BlitCommandEncoder {
    object: objc.Object

    // Safety: `object` is an MTLBlitCommandEncoder.
    pub unsafe fn from_object(object: objc.Object) -> BlitCommandEncoder {
        return BlitCommandEncoder { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn push_debug_group(&self, text: &str) {
        push_debug_group(self.id(), text)
    }

    pub fn pop_debug_group(&self) {
        pop_debug_group(self.id())
    }

    pub fn copy_buffer(&self, source: &Buffer, source_offset: usize, destination: &Buffer, destination_offset: usize, size: usize) {
        unsafe {
            m_v_pupuu(self.id(), sel(ptr.from_mut(&mut S_COPY_BUFFER), b"copyFromBuffer:sourceOffset:toBuffer:destinationOffset:size:\0"), source.object.as_ptr(), source_offset, destination.object.as_ptr(), destination_offset, size)
        }
    }

    pub fn copy_buffer_to_texture(&self, source: &Buffer, source_offset: usize, source_bytes_per_row: usize, source_bytes_per_image: usize, source_size: Size, destination: &Texture, destination_slice: usize, destination_level: usize, destination_origin: Origin) {
        unsafe {
            m_v_puuuSpuuO(self.id(), sel(ptr.from_mut(&mut S_COPY_BUFFER_TO_TEXTURE), b"copyFromBuffer:sourceOffset:sourceBytesPerRow:sourceBytesPerImage:sourceSize:toTexture:destinationSlice:destinationLevel:destinationOrigin:\0"), source.object.as_ptr(), source_offset, source_bytes_per_row, source_bytes_per_image, source_size, destination.object.as_ptr(), destination_slice, destination_level, destination_origin)
        }
    }

    pub fn copy_texture_to_buffer(&self, source: &Texture, source_slice: usize, source_level: usize, source_origin: Origin, source_size: Size, destination: &Buffer, destination_offset: usize, destination_bytes_per_row: usize, destination_bytes_per_image: usize) {
        unsafe {
            m_v_puuOSpuuu(self.id(), sel(ptr.from_mut(&mut S_COPY_TEXTURE_TO_BUFFER), b"copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toBuffer:destinationOffset:destinationBytesPerRow:destinationBytesPerImage:\0"), source.object.as_ptr(), source_slice, source_level, source_origin, source_size, destination.object.as_ptr(), destination_offset, destination_bytes_per_row, destination_bytes_per_image)
        }
    }

    pub fn copy_texture(&self, source: &Texture, source_slice: usize, source_level: usize, source_origin: Origin, source_size: Size, destination: &Texture, destination_slice: usize, destination_level: usize, destination_origin: Origin) {
        unsafe {
            m_v_puuOSpuuO(self.id(), sel(ptr.from_mut(&mut S_COPY_TEXTURE), b"copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toTexture:destinationSlice:destinationLevel:destinationOrigin:\0"), source.object.as_ptr(), source_slice, source_level, source_origin, source_size, destination.object.as_ptr(), destination_slice, destination_level, destination_origin)
        }
    }

    // Set `length` bytes starting at `offset` to `value`.
    pub fn fill_buffer(&self, buffer: &Buffer, offset: usize, length: usize, value: u8) {
        unsafe {
            m_v_pNc(self.id(), sel(ptr.from_mut(&mut S_FILL_BUFFER), b"fillBuffer:range:value:\0"), buffer.object.as_ptr(), Range.new(offset, length), value)
        }
    }

    // Fill every mipmap level below the first from the one above it.
    pub fn generate_mipmaps(&self, texture: &Texture) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_GENERATE_MIPMAPS)
        }, b"generateMipmapsForTexture:\0"), texture.object.as_ptr())
    }

    // Copy a managed buffer's GPU changes back to its CPU copy.
    pub fn synchronize_buffer(&self, buffer: &Buffer) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SYNCHRONIZE_RESOURCE)
        }, b"synchronizeResource:\0"), buffer.object.as_ptr())
    }

    pub fn synchronize_texture(&self, texture: &Texture) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SYNCHRONIZE_RESOURCE)
        }, b"synchronizeResource:\0"), texture.object.as_ptr())
    }

    pub fn update_fence(&self, fence: &Fence) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_UPDATE_FENCE)
        }, b"updateFence:\0"), fence.object.as_ptr())
    }

    pub fn wait_for_fence(&self, fence: &Fence) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_WAIT_FOR_FENCE)
        }, b"waitForFence:\0"), fence.object.as_ptr())
    }

    pub fn end_encoding(self) {
        end_encoding(self.id())
    }
}

static mut S_CONTENTS: usize = 0
static mut S_LENGTH: usize = 0
static mut S_DID_MODIFY_RANGE: usize = 0
static mut S_RESOURCE_OPTIONS: usize = 0
static mut S_STORAGE_MODE: usize = 0
static mut S_GPU_ADDRESS: usize = 0

// MTLBuffer: untyped GPU memory. Shared and managed buffers are also
// visible to the CPU through read, write and contents.
@unsafe_send
@unsafe_sync
pub unsafe struct Buffer {
    object: objc.Object

    // Safety: `object` is an MTLBuffer.
    pub unsafe fn from_object(object: objc.Object) -> Buffer {
        return Buffer { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn clone(&self) -> Buffer {
        return Buffer { object: self.object.clone() }
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn label(&self) -> Option<objc.NSString> {
        return label(self.id())
    }

    // The size in bytes.
    pub fn len(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_LENGTH)
        }, b"length\0"))
    }

    pub fn resource_options(&self) -> ResourceOptions {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_RESOURCE_OPTIONS)
        }, b"resourceOptions\0"))
    }

    pub fn storage_mode(&self) -> StorageMode {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_STORAGE_MODE)
        }, b"storageMode\0"))
    }

    // The buffer's address for argument buffers and pointers in shaders.
    pub fn gpu_address(&self) -> u64 {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_GPU_ADDRESS)
        }, b"gpuAddress\0")) as u64
    }

    // The CPU address of the first byte, or null for a private buffer. The
    // memory stays valid while the buffer is alive; the GPU may access it
    // concurrently, so synchronize through command buffer completion.
    pub fn contents(&self) -> *mut u8 {
        // Some systems return an address the CPU must not use for private
        // buffers, so the storage mode decides.
        mode := self.storage_mode()
        if mode == STORAGE_MODE_PRIVATE || mode == STORAGE_MODE_MEMORYLESS {
            return null()
        }
        return unsafe {
            m_p(self.id(), sel(ptr.from_mut(&mut S_CONTENTS), b"contents\0"))
        }
    }

    // Copy `bytes` into the buffer at `offset`. Err(InvalidInput) if the
    // range does not fit or the buffer is private.
    pub fn write(&self, offset: usize, bytes: &[u8]) -> void!Error {
        start := self.contents()
        if ptr.is_null(start) || !fits(offset, bytes.len, self.len()) {
            return err(Error.InvalidInput)
        }
        unsafe {
            ptr.copy_nonoverlapping(ptr.as_ptr(bytes), ptr.offset(start, offset as isize), bytes.len)
        }
        return ok()
    }

    // Copy bytes starting at `offset` out of the buffer to fill `out`.
    pub fn read(&self, offset: usize, out: &mut[u8]) -> void!Error {
        start := self.contents()
        if ptr.is_null(start) || !fits(offset, out.len, self.len()) {
            return err(Error.InvalidInput)
        }
        unsafe {
            ptr.copy_nonoverlapping(ptr.offset(start, offset as isize) as *const u8, ptr.as_mut_ptr(out), out.len)
        }
        return ok()
    }

    // Native-endian f32 and u32 forms of write and read, for shader data.
    pub fn write_f32(&self, offset: usize, values: &[f32]) -> void!Error {
        start := self.contents()
        if values.len > self.len() / 4 || ptr.is_null(start) || !fits(offset, values.len * 4, self.len()) {
            return err(Error.InvalidInput)
        }
        unsafe {
            ptr.copy_nonoverlapping(ptr.as_ptr(values) as *const u8, ptr.offset(start, offset as isize), values.len * 4)
        }
        return ok()
    }

    pub fn read_f32(&self, offset: usize, out: &mut[f32]) -> void!Error {
        start := self.contents()
        if out.len > self.len() / 4 || ptr.is_null(start) || !fits(offset, out.len * 4, self.len()) {
            return err(Error.InvalidInput)
        }
        unsafe {
            ptr.copy_nonoverlapping(ptr.offset(start, offset as isize) as *const u8, ptr.as_mut_ptr(out) as *mut u8, out.len * 4)
        }
        return ok()
    }

    pub fn write_u32(&self, offset: usize, values: &[u32]) -> void!Error {
        start := self.contents()
        if values.len > self.len() / 4 || ptr.is_null(start) || !fits(offset, values.len * 4, self.len()) {
            return err(Error.InvalidInput)
        }
        unsafe {
            ptr.copy_nonoverlapping(ptr.as_ptr(values) as *const u8, ptr.offset(start, offset as isize), values.len * 4)
        }
        return ok()
    }

    pub fn read_u32(&self, offset: usize, out: &mut[u32]) -> void!Error {
        start := self.contents()
        if out.len > self.len() / 4 || ptr.is_null(start) || !fits(offset, out.len * 4, self.len()) {
            return err(Error.InvalidInput)
        }
        unsafe {
            ptr.copy_nonoverlapping(ptr.offset(start, offset as isize) as *const u8, ptr.as_mut_ptr(out) as *mut u8, out.len * 4)
        }
        return ok()
    }

    // Tell Metal the CPU changed these bytes of a managed buffer.
    pub fn did_modify_range(&self, offset: usize, length: usize) {
        unsafe {
            m_v_N(self.id(), sel(ptr.from_mut(&mut S_DID_MODIFY_RANGE), b"didModifyRange:\0"), Range.new(offset, length))
        }
    }
}

static mut S_WIDTH: usize = 0
static mut S_HEIGHT: usize = 0
static mut S_DEPTH: usize = 0
static mut S_MIPMAP_LEVEL_COUNT: usize = 0
static mut S_ARRAY_LENGTH: usize = 0
static mut S_SAMPLE_COUNT: usize = 0
static mut S_PIXEL_FORMAT: usize = 0
static mut S_TEXTURE_TYPE: usize = 0
static mut S_USAGE: usize = 0
static mut S_REPLACE_REGION: usize = 0
static mut S_GET_BYTES: usize = 0
static mut S_NEW_TEXTURE_VIEW: usize = 0
static mut S_NEW_TEXTURE_VIEW_RANGES: usize = 0

// MTLTexture: formatted image memory.
@unsafe_send
@unsafe_sync
pub unsafe struct Texture {
    object: objc.Object

    // Safety: `object` is an MTLTexture.
    pub unsafe fn from_object(object: objc.Object) -> Texture {
        return Texture { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    pub fn clone(&self) -> Texture {
        return Texture { object: self.object.clone() }
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn label(&self) -> Option<objc.NSString> {
        return label(self.id())
    }

    pub fn width(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_WIDTH)
        }, b"width\0"))
    }

    pub fn height(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_HEIGHT)
        }, b"height\0"))
    }

    pub fn depth(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_DEPTH)
        }, b"depth\0"))
    }

    pub fn mipmap_level_count(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_MIPMAP_LEVEL_COUNT)
        }, b"mipmapLevelCount\0"))
    }

    pub fn array_length(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_ARRAY_LENGTH)
        }, b"arrayLength\0"))
    }

    pub fn sample_count(&self) -> usize {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SAMPLE_COUNT)
        }, b"sampleCount\0"))
    }

    pub fn pixel_format(&self) -> PixelFormat {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_PIXEL_FORMAT)
        }, b"pixelFormat\0"))
    }

    pub fn texture_type(&self) -> TextureType {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_TEXTURE_TYPE)
        }, b"textureType\0"))
    }

    pub fn usage(&self) -> TextureUsage {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_USAGE)
        }, b"usage\0"))
    }

    pub fn storage_mode(&self) -> StorageMode {
        return get_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_STORAGE_MODE)
        }, b"storageMode\0"))
    }

    // The number of 2D images: array_length, times 6 for cube textures.
    fn slices(&self) -> usize {
        kind := self.texture_type()
        if kind == TEXTURE_TYPE_CUBE || kind == TEXTURE_TYPE_CUBE_ARRAY {
            return self.array_length() * 6
        }
        return self.array_length()
    }

    // Check a CPU copy of `region` at `level` and `slice` against the
    // texture and a caller buffer of `available` bytes; returns the
    // bytes per image the copy uses.
    fn check_copy(&self, region: &Region, level: usize, slice: usize, bytes_per_row: usize, available: usize) -> usize!Error {
        size := pixel_size(self.pixel_format())
        if size == 0 || self.sample_count() != 1 {
            return err(Error.Unsupported)
        }
        if self.storage_mode() == STORAGE_MODE_PRIVATE || self.storage_mode() == STORAGE_MODE_MEMORYLESS {
            return err(Error.InvalidInput)
        }
        if level >= self.mipmap_level_count() || slice >= self.slices() {
            return err(Error.InvalidInput)
        }
        if !fits(region.origin.x, region.size.width, mip(self.width(), level)) ||
            !fits(region.origin.y, region.size.height, mip(self.height(), level)) ||
            !fits(region.origin.z, region.size.depth, mip(self.depth(), level)) {
            return err(Error.InvalidInput)
        }
        if region.size.width == 0 || region.size.height == 0 || region.size.depth == 0 {
            return err(Error.InvalidInput)
        }
        // Every quantity below is bounded by the texture's own dimensions,
        // except bytes_per_row; reject a row length that would overflow.
        if bytes_per_row / size < region.size.width {
            return err(Error.InvalidInput)
        }
        if bytes_per_row > available / region.size.height {
            return err(Error.InvalidInput)
        }
        image := bytes_per_row * region.size.height
        if image > available / region.size.depth {
            return err(Error.InvalidInput)
        }
        return ok(image)
    }

    // Copy pixels from `bytes` into `region` of a CPU-accessible texture.
    // Rows are `bytes_per_row` apart and images bytes_per_row * height apart.
    // Compressed, depth-stencil and multisample formats are Unsupported.
    pub fn write_pixels(&self, region: Region, level: usize, slice: usize, bytes: &[u8], bytes_per_row: usize) -> void!Error {
        image := self.check_copy(&region, level, slice, bytes_per_row, bytes.len)?
        unsafe {
            m_v_Ruuquu(self.id(), sel(ptr.from_mut(&mut S_REPLACE_REGION), b"replaceRegion:mipmapLevel:slice:withBytes:bytesPerRow:bytesPerImage:\0"), region, level, slice, ptr.as_ptr(bytes), bytes_per_row, image)
        }
        return ok()
    }

    // Copy pixels from `region` into `out`, laid out as for write_pixels.
    // The GPU must have finished writing the texture.
    pub fn read_pixels(&self, region: Region, level: usize, slice: usize, out: &mut[u8], bytes_per_row: usize) -> void!Error {
        image := self.check_copy(&region, level, slice, bytes_per_row, out.len)?
        unsafe {
            m_v_puuRuu(self.id(), sel(ptr.from_mut(&mut S_GET_BYTES), b"getBytes:bytesPerRow:bytesPerImage:fromRegion:mipmapLevel:slice:\0"), ptr.as_mut_ptr(out), bytes_per_row, image, region, level, slice)
        }
        return ok()
    }

    // Copy any texture's pixels without checks, for formats write_pixels
    // does not size, such as compressed blocks.
    //
    // Safety: the region, level and slice lie within the texture, and
    // `bytes` holds every row and image the copy reads at these strides.
    pub unsafe fn replace_region(&self, region: Region, level: usize, slice: usize, bytes: *const u8, bytes_per_row: usize, bytes_per_image: usize) {
        unsafe {
            m_v_Ruuquu(self.id(), sel(ptr.from_mut(&mut S_REPLACE_REGION), b"replaceRegion:mipmapLevel:slice:withBytes:bytesPerRow:bytesPerImage:\0"), region, level, slice, bytes, bytes_per_row, bytes_per_image)
        }
    }

    // Safety: as for replace_region, with `bytes` writable.
    pub unsafe fn get_bytes(&self, bytes: *mut u8, bytes_per_row: usize, bytes_per_image: usize, region: Region, level: usize, slice: usize) {
        unsafe {
            m_v_puuRuu(self.id(), sel(ptr.from_mut(&mut S_GET_BYTES), b"getBytes:bytesPerRow:bytesPerImage:fromRegion:mipmapLevel:slice:\0"), bytes, bytes_per_row, bytes_per_image, region, level, slice)
        }
    }

    // The same pixels read as another compatible format; the texture needs
    // TEXTURE_USAGE_PIXEL_FORMAT_VIEW unless only sRGB-ness changes.
    pub fn new_view(&self, format: PixelFormat) -> Texture!Error {
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_u(self.id(), sel(ptr.from_mut(&mut S_NEW_TEXTURE_VIEW), b"newTextureViewWithPixelFormat:\0"), format)
        })?
        return ok(Texture { object: object })
    }

    // A view of some mipmap levels and slices, possibly as another type.
    pub fn new_view_of(&self, format: PixelFormat, texture_type: TextureType, first_level: usize, level_count: usize, first_slice: usize, slice_count: usize) -> Texture!Error {
        if level_count == 0 || slice_count == 0 || !fits(first_level, level_count, self.mipmap_level_count()) || !fits(first_slice, slice_count, self.slices()) {
            return err(Error.InvalidInput)
        }
        pool := objc.AutoreleasePool.new()
        object := adopt(unsafe {
            m_p_uuNN(self.id(), sel(ptr.from_mut(&mut S_NEW_TEXTURE_VIEW_RANGES), b"newTextureViewWithPixelFormat:textureType:levels:slices:\0"), format, texture_type, Range.new(first_level, level_count), Range.new(first_slice, slice_count))
        })?
        return ok(Texture { object: object })
    }
}

// The size of a dimension at a mipmap level: halved per level, at least 1.
fn mip(size: usize, level: usize) -> usize {
    value := size
    for _ in 0usize..level {
        if value <= 1 {
            return 1
        }
        value = value / 2
    }
    return value
}

// Bytes per pixel of an uncompressed color, depth or stencil format that
// CPU copies support; 0 for compressed, packed-YUV, combined depth-stencil,
// and unknown formats.
pub fn pixel_size(format: PixelFormat) -> usize {
    if format == PIXEL_FORMAT_A8_UNORM || (format >= PIXEL_FORMAT_R8_UNORM && format <= PIXEL_FORMAT_R8_SINT) || format == PIXEL_FORMAT_STENCIL8 {
        return 1
    }
    if (format >= PIXEL_FORMAT_R16_UNORM && format <= PIXEL_FORMAT_R16_FLOAT) ||
        (format >= PIXEL_FORMAT_RG8_UNORM && format <= PIXEL_FORMAT_RG8_SINT) ||
        (format >= PIXEL_FORMAT_B5G6R5_UNORM && format <= PIXEL_FORMAT_BGR5A1_UNORM) ||
        format == PIXEL_FORMAT_DEPTH16_UNORM {
        return 2
    }
    if (format >= PIXEL_FORMAT_R32_UINT && format <= PIXEL_FORMAT_R32_FLOAT) ||
        (format >= PIXEL_FORMAT_RG16_UNORM && format <= PIXEL_FORMAT_RG16_FLOAT) ||
        (format >= PIXEL_FORMAT_RGBA8_UNORM && format <= PIXEL_FORMAT_RGBA8_SINT) ||
        format == PIXEL_FORMAT_BGRA8_UNORM || format == PIXEL_FORMAT_BGRA8_UNORM_SRGB ||
        (format >= PIXEL_FORMAT_RGB10A2_UNORM && format <= PIXEL_FORMAT_BGR10A2_UNORM) ||
        format == PIXEL_FORMAT_BGR10_XR || format == PIXEL_FORMAT_BGR10_XR_SRGB ||
        format == PIXEL_FORMAT_DEPTH32_FLOAT {
        return 4
    }
    if (format >= PIXEL_FORMAT_RG32_UINT && format <= PIXEL_FORMAT_RG32_FLOAT) ||
        (format >= PIXEL_FORMAT_RGBA16_UNORM && format <= PIXEL_FORMAT_RGBA16_FLOAT) ||
        format == PIXEL_FORMAT_BGRA10_XR || format == PIXEL_FORMAT_BGRA10_XR_SRGB {
        return 8
    }
    if format >= PIXEL_FORMAT_RGBA32_UINT && format <= PIXEL_FORMAT_RGBA32_FLOAT {
        return 16
    }
    return 0
}

static mut C_TEXTURE_DESCRIPTOR: usize = 0
static mut S_SET_TEXTURE_TYPE: usize = 0
static mut S_SET_PIXEL_FORMAT: usize = 0
static mut S_SET_WIDTH: usize = 0
static mut S_SET_HEIGHT: usize = 0
static mut S_SET_DEPTH: usize = 0
static mut S_SET_MIPMAP_LEVEL_COUNT: usize = 0
static mut S_SET_SAMPLE_COUNT: usize = 0
static mut S_SET_ARRAY_LENGTH: usize = 0
static mut S_SET_USAGE: usize = 0
static mut S_SET_STORAGE_MODE: usize = 0
static mut S_SET_RESOURCE_OPTIONS: usize = 0

// MTLTextureDescriptor: what Device.new_texture creates. A new descriptor
// describes a 1x1 2D RGBA8 texture with one level, read by shaders.
pub struct TextureDescriptor {
    object: objc.Object

    pub fn new() -> TextureDescriptor!Error {
        object := instantiate(unsafe {
            ptr.from_mut(&mut C_TEXTURE_DESCRIPTOR)
        }, b"MTLTextureDescriptor\0")?
        return ok(TextureDescriptor { object: object })
    }

    // A 2D texture of `width` x `height` pixels.
    pub fn new_2d(format: PixelFormat, width: usize, height: usize, usage: TextureUsage) -> TextureDescriptor!Error {
        descriptor := TextureDescriptor.new()?
        descriptor.set_pixel_format(format)
        descriptor.set_width(width)
        descriptor.set_height(height)
        descriptor.set_usage(usage)
        return ok(descriptor)
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_texture_type(&self, texture_type: TextureType) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_TEXTURE_TYPE)
        }, b"setTextureType:\0"), texture_type)
    }

    pub fn set_pixel_format(&self, format: PixelFormat) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_PIXEL_FORMAT)
        }, b"setPixelFormat:\0"), format)
    }

    pub fn set_width(&self, width: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_WIDTH)
        }, b"setWidth:\0"), width)
    }

    pub fn set_height(&self, height: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_HEIGHT)
        }, b"setHeight:\0"), height)
    }

    pub fn set_depth(&self, depth: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_DEPTH)
        }, b"setDepth:\0"), depth)
    }

    pub fn set_mipmap_level_count(&self, count: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_MIPMAP_LEVEL_COUNT)
        }, b"setMipmapLevelCount:\0"), count)
    }

    pub fn set_sample_count(&self, count: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_SAMPLE_COUNT)
        }, b"setSampleCount:\0"), count)
    }

    pub fn set_array_length(&self, length: usize) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_ARRAY_LENGTH)
        }, b"setArrayLength:\0"), length)
    }

    pub fn set_usage(&self, usage: TextureUsage) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_USAGE)
        }, b"setUsage:\0"), usage)
    }

    pub fn set_storage_mode(&self, mode: StorageMode) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_STORAGE_MODE)
        }, b"setStorageMode:\0"), mode)
    }

    // Storage, CPU cache and hazard tracking modes as RESOURCE_* options.
    pub fn set_resource_options(&self, options: ResourceOptions) {
        set_usize(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_RESOURCE_OPTIONS)
        }, b"setResourceOptions:\0"), options)
    }
}

static mut C_SAMPLER_DESCRIPTOR: usize = 0
static mut S_SET_MIN_FILTER: usize = 0
static mut S_SET_MAG_FILTER: usize = 0
static mut S_SET_MIP_FILTER: usize = 0
static mut S_SET_S_ADDRESS_MODE: usize = 0
static mut S_SET_T_ADDRESS_MODE: usize = 0
static mut S_SET_R_ADDRESS_MODE: usize = 0
static mut S_SET_MAX_ANISOTROPY: usize = 0
static mut S_SET_COMPARE_FUNCTION: usize = 0
static mut S_SET_BORDER_COLOR: usize = 0
static mut S_SET_LOD_MIN_CLAMP: usize = 0
