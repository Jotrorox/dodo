static mut S_IS_LOW_POWER: usize = 0
static mut S_IS_HEADLESS: usize = 0
static mut S_IS_REMOVABLE: usize = 0
static mut S_SUPPORTS_FAMILY: usize = 0
static mut S_SUPPORTS_TEXTURE_SAMPLE_COUNT: usize = 0
