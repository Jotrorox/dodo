static mut C_VERTEX_DESCRIPTOR: usize = 0
static mut S_ATTRIBUTES: usize = 0
static mut S_LAYOUTS: usize = 0
static mut S_SET_FORMAT: usize = 0
static mut S_SET_OFFSET: usize = 0
static mut S_SET_BUFFER_INDEX: usize = 0
static mut S_SET_STRIDE: usize = 0
static mut S_SET_STEP_FUNCTION: usize = 0
static mut S_SET_STEP_RATE: usize = 0

// MTLVertexDescriptor: the format and source buffer of each [[attribute(n)]].
pub struct VertexDescriptor {
    object: objc.Object

    pub fn new() -> VertexDescriptor!Error {
        object := instantiate(unsafe {
            ptr.from_mut(&mut C_VERTEX_DESCRIPTOR)
        }, b"MTLVertexDescriptor\0")?
        return ok(VertexDescriptor { object: object })
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    // Describe [[attribute(index)]]: a `format` value `offset` bytes into
    // each element of [[buffer(buffer_index)]].
    pub fn set_attribute(&self, index: usize, format: VertexFormat, offset: usize, buffer_index: usize) -> void!Error {
        if index >= MAX_VERTEX_ATTRIBUTES || buffer_index >= MAX_BUFFER_BINDINGS {
            return err(Error.InvalidInput)
        }
        attribute := element(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_ATTRIBUTES)
        }, b"attributes\0"), index)?
        set_usize(attribute.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SET_FORMAT)
        }, b"setFormat:\0"), format)
        set_usize(attribute.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SET_OFFSET)
        }, b"setOffset:\0"), offset)
        set_usize(attribute.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SET_BUFFER_INDEX)
        }, b"setBufferIndex:\0"), buffer_index)
        return ok()
    }

    // Describe [[buffer(index)]]: elements `stride` bytes apart, advancing
    // per vertex or every `step_rate` instances.
    pub fn set_layout(&self, index: usize, stride: usize, step_function: VertexStepFunction, step_rate: usize) -> void!Error {
        if index >= MAX_BUFFER_BINDINGS {
            return err(Error.InvalidInput)
        }
        layout := element(self.object.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_LAYOUTS)
        }, b"layouts\0"), index)?
        set_usize(layout.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SET_STRIDE)
        }, b"setStride:\0"), stride)
        set_usize(layout.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SET_STEP_FUNCTION)
        }, b"setStepFunction:\0"), step_function)
        set_usize(layout.as_ptr(), sel(unsafe {
            ptr.from_mut(&mut S_SET_STEP_RATE)
        }, b"setStepRate:\0"), step_rate)
        return ok()
    }
}

