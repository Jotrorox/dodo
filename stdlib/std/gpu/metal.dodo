// MTLRenderCommandEncoder: records draws into one render pass. Binding
// indices above the MAX_*_BINDINGS limits panic.
pub struct RenderCommandEncoder {
    object: objc.Object

    // Safety: `object` is an MTLRenderCommandEncoder.
    pub unsafe fn from_object(object: objc.Object) -> RenderCommandEncoder {
        return RenderCommandEncoder { object: object }
    }

    pub fn as_object(&self) -> &objc.Object {
        return &self.object
    }

    fn id(&self) -> objc.Id {
        return self.object.as_ptr()
    }

    pub fn set_label(&self, text: &str) {
        set_label(self.id(), text)
    }

    pub fn push_debug_group(&self, text: &str) {
        push_debug_group(self.id(), text)
    }

    pub fn pop_debug_group(&self) {
        pop_debug_group(self.id())
