// NSRange: a span of elements, such as bytes, mipmap levels or slices.
pub type Range = objc.Range

// MTLSize: a count of threads, threadgroups or texels in each dimension.
@repr(C)
pub struct Size {
    pub width: usize
    pub height: usize
    pub depth: usize

    pub fn new(width: usize, height: usize, depth: usize) -> Size {
        return Size { width: width, height: height, depth: depth }
    }
}

// MTLOrigin: the first texel of a region.
@repr(C)
pub struct Origin {
    pub x: usize
    pub y: usize
    pub z: usize

    pub fn new(x: usize, y: usize, z: usize) -> Origin {
        return Origin { x: x, y: y, z: z }
    }
}

// MTLRegion: a box of texels.
@repr(C)
pub struct Region {
    pub origin: Origin
    pub size: Size

    // A rectangle in a 2D texture or one slice of an array.
    pub fn new_2d(x: usize, y: usize, width: usize, height: usize) -> Region {
        return Region { origin: Origin.new(x, y, 0), size: Size.new(width, height, 1) }
    }

    pub fn new_3d(x: usize, y: usize, z: usize, width: usize, height: usize, depth: usize) -> Region {
        return Region { origin: Origin.new(x, y, z), size: Size.new(width, height, depth) }
    }
}

// MTLClearColor: what a clear load action fills a color attachment with.
@repr(C)
pub struct ClearColor {
    pub red: f64
    pub green: f64
    pub blue: f64
    pub alpha: f64

    pub fn new(red: f64, green: f64, blue: f64, alpha: f64) -> ClearColor {
        return ClearColor { red: red, green: green, blue: blue, alpha: alpha }
    }
}

// MTLViewport: the transform from normalized device coordinates to pixels.
@repr(C)
pub struct Viewport {
    pub origin_x: f64
    pub origin_y: f64
    pub width: f64
    pub height: f64
    pub znear: f64
    pub zfar: f64

    pub fn new(origin_x: f64, origin_y: f64, width: f64, height: f64, znear: f64, zfar: f64) -> Viewport {
        return Viewport { origin_x: origin_x, origin_y: origin_y, width: width, height: height, znear: znear, zfar: zfar }
    }
}

// MTLScissorRect: the pixels a draw may change.
@repr(C)
pub struct ScissorRect {
    pub x: usize
    pub y: usize
    pub width: usize
    pub height: usize

    pub fn new(x: usize, y: usize, width: usize, height: usize) -> ScissorRect {
        return ScissorRect { x: x, y: y, width: width, height: height }
    }
}

// CGSize: a size in pixels or points, as Core Animation measures it.
@repr(C)
pub struct CGSize {
    pub width: f64
    pub height: f64

    pub fn new(width: f64, height: f64) -> CGSize {
        return CGSize { width: width, height: height }
    }
}

// Binding limits enforced before a call reaches Metal, whose argument tables
// have these many slots per shader stage.
pub const MAX_BUFFER_BINDINGS: usize = 31
pub const MAX_TEXTURE_BINDINGS: usize = 128
pub const MAX_SAMPLER_BINDINGS: usize = 16
pub const MAX_COLOR_ATTACHMENTS: usize = 8
pub const MAX_VERTEX_ATTRIBUTES: usize = 31

// Why a Metal call failed.
pub enum Error {
    // The system has no Metal device, as in many virtual machines.
    NoDevice,
    // Metal could not create the object; usually memory is exhausted.
    OutOfMemory,
    // An argument is outside what the call accepts, such as a byte range
    // past the end of a buffer or a region outside a texture.
    InvalidInput,
    // The library has no function with the requested name.
    NotFound,
    // The operation needs something this system or object lacks, such as a
    // pixel format whose size is unknown or a class that is not loaded.
    Unsupported,
    // Metal reported an error: shader compilation, pipeline creation or a
    // failed command buffer. The NSError carries Metal's own message.
    Failed(objc.NSError)
}

pub fn error_name(error: &Error) -> &str from(static) {
    match error {
        Error.NoDevice => {
            return "NoDevice"
        }
        Error.OutOfMemory => {
            return "OutOfMemory"
        }
        Error.InvalidInput => {
            return "InvalidInput"
        }
        Error.NotFound => {
            return "NotFound"
        }
        Error.Unsupported => {
            return "Unsupported"
        }
        Error.Failed(_) => {
            return "Failed"
        }
    }
}

fn null() -> objc.Id {
    return unsafe {
        0usize as objc.Id
    }
}

// Callers pass a static slot used only for `name`, which ends in its NUL.
fn sel(slot: *mut usize, name: &[u8]) -> objc.Id {
    return unsafe {
        objc.cached_selector(slot, name)
    }
}

static mut S_NEW: usize = 0
static mut S_SET_LABEL: usize = 0
static mut S_LABEL: usize = 0
static mut S_OBJECT_AT_INDEXED_SUBSCRIPT: usize = 0
static mut S_PUSH_DEBUG_GROUP: usize = 0
static mut S_POP_DEBUG_GROUP: usize = 0
static mut S_INSERT_DEBUG_SIGNPOST: usize = 0
static mut S_END_ENCODING: usize = 0

// Adopt a +1 result: nil means Metal could not create the object.
fn adopt(id: objc.Id) -> objc.Object!Error {
    owned := unsafe {
        objc.Object.from_retained(id)
    }
    match owned {
        some(object) => {
            return ok(object)
        }
        none => {
            return err(Error.OutOfMemory)
        }
    }
}

// Adopt a +1 result of a call with an NSError out-parameter. The error is
// autoreleased, so the caller's pool must still be alive.
fn adopt_or_error(id: objc.Id, error: objc.Id) -> objc.Object!Error {
    owned := unsafe {
        objc.Object.from_retained(id)
    }
    match owned {
        some(object) => {
            return ok(object)
        }
        none => {
            return err(failure(error))
        }
    }
}

fn failure(error: objc.Id) -> Error {
    owned := unsafe {
        objc.Object.retain(error)
    }
    match owned {
        some(object) => {
            return Error.Failed(unsafe {
                objc.NSError.from_object(object)
            })
        }
        none => {
            return Error.OutOfMemory
        }
    }
}

// Calls that create or destroy objects run inside a temporary pool, as
// do getters: Metal autoreleases internally even when it returns an owned
// object, and a command-line program has no pool that would ever drain.

// A new instance of the named class, from +new.
fn instantiate(slot: *mut usize, name: &[u8]) -> objc.Object!Error {
    class := unsafe {
        objc.cached_class(slot, name)
    }
    if ptr.is_null(class) {
        return err(Error.Unsupported)
    }
    pool := objc.AutoreleasePool.new()
    return adopt(unsafe {
        m_p(class, sel(ptr.from_mut(&mut S_NEW), b"new\0"))
    })
}

// Retain a getter's unowned, possibly autoreleased result.
fn get(receiver: objc.Id, selector: objc.Id) -> Option<objc.Object> {
    return unsafe {
        objc.get_object(receiver, selector)
    }
}

// Retain an element of a Metal descriptor array such as colorAttachments.
fn element(receiver: objc.Id, array_selector: objc.Id, index: usize) -> objc.Object!Error {
    unsafe {
        pool := objc.AutoreleasePool.new()
        array := m_p(receiver, array_selector)
        if ptr.is_null(array) {
            return err(Error.Unsupported)
        }
        item := objc.Object.retain(m_p_u(array, sel(ptr.from_mut(&mut S_OBJECT_AT_INDEXED_SUBSCRIPT), b"objectAtIndexedSubscript:\0"), index))
        core.drop(pool)
        match item {
            some(object) => {
                return ok(object)
            }
            none => {
                return err(Error.InvalidInput)
            }
        }
    }
}

fn string_of(object: Option<objc.Object>) -> Option<objc.NSString> {
    match object {
        some(value) => {
            return some(unsafe {
                objc.NSString.from_object(value)
            })
        }
        none => {
            return none
        }
    }
}

fn set_string(receiver: objc.Id, selector: objc.Id, text: &str) {
    if let some(string) = objc.NSString.new(text) {
        unsafe {
            m_v_p(receiver, selector, string.as_object().as_ptr())
        }
    }
}

fn set_label(receiver: objc.Id, text: &str) {
    set_string(receiver, sel(unsafe {
        ptr.from_mut(&mut S_SET_LABEL)
    }, b"setLabel:\0"), text)
}

fn label(receiver: objc.Id) -> Option<objc.NSString> {
    return string_of(get(receiver, sel(unsafe {
        ptr.from_mut(&mut S_LABEL)
    }, b"label\0")))
}

fn push_debug_group(receiver: objc.Id, text: &str) {
    set_string(receiver, sel(unsafe {
        ptr.from_mut(&mut S_PUSH_DEBUG_GROUP)
    }, b"pushDebugGroup:\0"), text)
}

fn pop_debug_group(receiver: objc.Id) {
    unsafe {
        m_v(receiver, sel(ptr.from_mut(&mut S_POP_DEBUG_GROUP), b"popDebugGroup\0"))
    }
}

fn insert_debug_signpost(receiver: objc.Id, text: &str) {
    set_string(receiver, sel(unsafe {
        ptr.from_mut(&mut S_INSERT_DEBUG_SIGNPOST)
    }, b"insertDebugSignpost:\0"), text)
}

fn end_encoding(receiver: objc.Id) {
    pool := objc.AutoreleasePool.new()
    unsafe {
        m_v(receiver, sel(ptr.from_mut(&mut S_END_ENCODING), b"endEncoding\0"))
    }
    core.drop(pool)
}

fn get_usize(receiver: objc.Id, selector: objc.Id) -> usize {
    return unsafe {
        m_u(receiver, selector)
    }
}

fn get_bool(receiver: objc.Id, selector: objc.Id) -> bool {
    return unsafe {
        m_b(receiver, selector)
    }
}

fn set_usize(receiver: objc.Id, selector: objc.Id, value: usize) {
    unsafe {
        m_v_u(receiver, selector, value)
    }
}

fn set_bool(receiver: objc.Id, selector: objc.Id, value: bool) {
    unsafe {
        m_v_b(receiver, selector, value)
    }
}

fn set_object(receiver: objc.Id, selector: objc.Id, value: objc.Id) {
    unsafe {
        m_v_p(receiver, selector, value)
    }
}

fn check_buffer_index(index: usize) {
    core.assert(index < MAX_BUFFER_BINDINGS)
}

fn check_texture_index(index: usize) {
    core.assert(index < MAX_TEXTURE_BINDINGS)
}

fn check_sampler_index(index: usize) {
    core.assert(index < MAX_SAMPLER_BINDINGS)
}

// Whether [offset, offset + length) lies within `size` bytes.
fn fits(offset: usize, length: usize, size: usize) -> bool {
    return length <= size && offset <= size - length
}

// RTLD_DEFAULT on Apple systems.
const DEFAULT_HANDLE: usize = 0xfffffffffffffffe

static mut STRET_STATE: usize = 0

// Send a message returning a Size. On x86-64 a 24-byte result needs
// objc_msgSend_stret; arm64 has only objc_msgSend, which handles it.
fn send_size(receiver: objc.Id, selector: objc.Id) -> Size {
    unsafe {
        state := mem.atomic_load(ptr.from_mut(&mut STRET_STATE), 0)
        if state == 0 {
            found := dlsym(DEFAULT_HANDLE as *mut u8, ptr.as_ptr(b"objc_msgSend_stret\0")) as usize
            // 1 records that the symbol does not exist.
            state = 1
            if found != 0 {
                state = found
            }
            mem.atomic_store(ptr.from_mut(&mut STRET_STATE), state, 0)
        }
        if state != 1 {
            stret := state as extern "C" fn(*mut u8, *mut u8) -> Size
            return stret(receiver, selector)
        }
        return m_S(receiver, selector)
    }
}

