package metal

import "core/mem"
import "core/ptr"
import "std/gpu/metal/objc"

// Apple's Metal GPU API, bound in Dodo through the Objective-C runtime. There
// is no C runtime file: every call is an objc_msgSend declared with that
// method's own signature, so the bindings can grow one method at a time.
//
// The API follows Metal closely, renamed to Dodo conventions:
// newBufferWithLength:options: is Device.new_buffer, MTLPixelFormatBGRA8Unorm
// is PIXEL_FORMAT_BGRA8_UNORM, and so on. Each object is an owned strong
// reference that releases on drop; clone() retains another. Objects Metal
// documents as thread-safe (devices, queues, resources, pipelines and other
// states) can be sent and shared between threads.
//
// What is checked: arguments that would let Metal touch CPU memory outside a
// Dodo slice or a resource, such as buffer and texture reads and writes and
// binding indices. What is not: the GPU itself. Shaders, draws, dispatches
// and blits run exactly as encoded; Metal's validation layer
// (MTL_DEBUG_LAYER=1) reports misuse there. Only the macOS targets link
// these bindings: Metal, QuartzCore and Foundation are added automatically.

unsafe extern "C" fn MTLCreateSystemDefaultDevice() -> *mut u8
unsafe extern "C" fn MTLCopyAllDevices() -> *mut u8
unsafe extern "C" fn dlsym(handle: *mut u8, name: *const u8) -> *const u8
unsafe extern "C" fn dispatch_data_create(buffer: *const u8, size: usize, queue: *mut u8, destructor: *mut u8) -> *mut u8
unsafe extern "C" fn dispatch_release(object: *mut u8)

// Message signatures, named m_RESULT_ARGUMENTS. Codes: v void, p object or
// pointer, q const pointer, u usize (NSUInteger), i isize (NSInteger), w u32,
// c u8, b bool, f f32, d f64, S Size, O Origin, R Region, C ClearColor,
// W Viewport, X ScissorRect, N Range, G CGSize.
@link_name("objc_msgSend")
unsafe extern "C" fn m_v(receiver: *mut u8, selector: *mut u8)
@link_name("objc_msgSend")
unsafe extern "C" fn m_p(receiver: *mut u8, selector: *mut u8) -> *mut u8
@link_name("objc_msgSend")
unsafe extern "C" fn m_u(receiver: *mut u8, selector: *mut u8) -> usize
@link_name("objc_msgSend")
unsafe extern "C" fn m_b(receiver: *mut u8, selector: *mut u8) -> bool
@link_name("objc_msgSend")
