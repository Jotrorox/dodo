    pub fn insert_debug_signpost(&self, text: &str) {
        insert_debug_signpost(self.id(), text)
    }

    pub fn set_render_pipeline_state(&self, state: &RenderPipelineState) {
        set_object(self.id(), sel(unsafe {
            ptr.from_mut(&mut S_SET_RENDER_PIPELINE_STATE)
        }, b"setRenderPipelineState:\0"), state.object.as_ptr())
    }

    pub fn set_vertex_buffer(&self, buffer: &Buffer, offset: usize, index: usize) {
