        unsafe {
            m_v_pu(self.id(), sel(ptr.from_mut(&mut S_SET_FRAGMENT_SAMPLER_STATE), b"setFragmentSamplerState:atIndex:\0"), sampler.object.as_ptr(), index)
        }
    }

    pub fn set_viewport(&self, viewport: Viewport) {
        unsafe {
            m_v_W(self.id(), sel(ptr.from_mut(&mut S_SET_VIEWPORT), b"setViewport:\0"), viewport)
        }
    }

    // The rectangle must lie within the render targets.
    pub fn set_scissor_rect(&self, rect: ScissorRect) {
