// The name of a Result code, such as "ERROR_DEVICE_LOST", or "UNKNOWN".
pub fn result_name(code: Result) -> &str from(static) {
    if code == SUCCESS {
        return "SUCCESS"
    }
    if code == NOT_READY {
        return "NOT_READY"
    }
    if code == TIMEOUT {
        return "TIMEOUT"
    }
    if code == EVENT_SET {
        return "EVENT_SET"
    }
    if code == EVENT_RESET {
        return "EVENT_RESET"
    }
    if code == INCOMPLETE {
        return "INCOMPLETE"
    }
    if code == ERROR_OUT_OF_HOST_MEMORY {
        return "ERROR_OUT_OF_HOST_MEMORY"
    }
    if code == ERROR_OUT_OF_DEVICE_MEMORY {
        return "ERROR_OUT_OF_DEVICE_MEMORY"
    }
    if code == ERROR_INITIALIZATION_FAILED {
        return "ERROR_INITIALIZATION_FAILED"
    }
    if code == ERROR_DEVICE_LOST {
        return "ERROR_DEVICE_LOST"
    }
    if code == ERROR_MEMORY_MAP_FAILED {
        return "ERROR_MEMORY_MAP_FAILED"
    }
    if code == ERROR_LAYER_NOT_PRESENT {
        return "ERROR_LAYER_NOT_PRESENT"
    }
    if code == ERROR_EXTENSION_NOT_PRESENT {
        return "ERROR_EXTENSION_NOT_PRESENT"
    }
    if code == ERROR_FEATURE_NOT_PRESENT {
        return "ERROR_FEATURE_NOT_PRESENT"
    }
    if code == ERROR_INCOMPATIBLE_DRIVER {
        return "ERROR_INCOMPATIBLE_DRIVER"
    }
    if code == ERROR_TOO_MANY_OBJECTS {
        return "ERROR_TOO_MANY_OBJECTS"
    }
    if code == ERROR_FORMAT_NOT_SUPPORTED {
        return "ERROR_FORMAT_NOT_SUPPORTED"
    }
    if code == ERROR_FRAGMENTED_POOL {
        return "ERROR_FRAGMENTED_POOL"
    }
    if code == ERROR_UNKNOWN {
        return "ERROR_UNKNOWN"
    }
    if code == ERROR_VALIDATION_FAILED {
        return "ERROR_VALIDATION_FAILED"
    }
    if code == ERROR_OUT_OF_POOL_MEMORY {
        return "ERROR_OUT_OF_POOL_MEMORY"
    }
    if code == ERROR_INVALID_EXTERNAL_HANDLE {
        return "ERROR_INVALID_EXTERNAL_HANDLE"
    }
    if code == ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS {
        return "ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS"
    }
    if code == ERROR_FRAGMENTATION {
        return "ERROR_FRAGMENTATION"
    }
    if code == PIPELINE_COMPILE_REQUIRED {
        return "PIPELINE_COMPILE_REQUIRED"
    }
    if code == ERROR_NOT_PERMITTED {
        return "ERROR_NOT_PERMITTED"
    }
    if code == ERROR_SURFACE_LOST_KHR {
        return "ERROR_SURFACE_LOST_KHR"
    }
    if code == ERROR_NATIVE_WINDOW_IN_USE_KHR {
        return "ERROR_NATIVE_WINDOW_IN_USE_KHR"
    }
    if code == SUBOPTIMAL_KHR {
        return "SUBOPTIMAL_KHR"
    }
    if code == ERROR_OUT_OF_DATE_KHR {
        return "ERROR_OUT_OF_DATE_KHR"
    }
    return "UNKNOWN"
}
