// Resolve every DeviceFns command. Unsafe: the getter must be the
// loader's, and the handle live for as long as the table is used.
pub unsafe fn load_device(get_device_proc_addr: PfnGetDeviceProcAddr, device: Device) -> DeviceFns {
    unsafe {
        fns := zeroed::<DeviceFns>()
        fns.destroy_device = get_device_proc_addr(device, ptr.as_ptr(b"vkDestroyDevice\0")) as PfnDestroyDevice
        fns.get_device_queue = get_device_proc_addr(device, ptr.as_ptr(b"vkGetDeviceQueue\0")) as PfnGetDeviceQueue
        fns.queue_submit = get_device_proc_addr(device, ptr.as_ptr(b"vkQueueSubmit\0")) as PfnQueueSubmit
        fns.queue_wait_idle = get_device_proc_addr(device, ptr.as_ptr(b"vkQueueWaitIdle\0")) as PfnQueueWaitIdle
        fns.device_wait_idle = get_device_proc_addr(device, ptr.as_ptr(b"vkDeviceWaitIdle\0")) as PfnDeviceWaitIdle
        fns.allocate_memory = get_device_proc_addr(device, ptr.as_ptr(b"vkAllocateMemory\0")) as PfnAllocateMemory
        fns.free_memory = get_device_proc_addr(device, ptr.as_ptr(b"vkFreeMemory\0")) as PfnFreeMemory
        fns.map_memory = get_device_proc_addr(device, ptr.as_ptr(b"vkMapMemory\0")) as PfnMapMemory
        fns.unmap_memory = get_device_proc_addr(device, ptr.as_ptr(b"vkUnmapMemory\0")) as PfnUnmapMemory
        fns.flush_mapped_memory_ranges = get_device_proc_addr(device, ptr.as_ptr(b"vkFlushMappedMemoryRanges\0")) as PfnFlushMappedMemoryRanges
        fns.invalidate_mapped_memory_ranges = get_device_proc_addr(device, ptr.as_ptr(b"vkInvalidateMappedMemoryRanges\0")) as PfnInvalidateMappedMemoryRanges
        fns.get_device_memory_commitment = get_device_proc_addr(device, ptr.as_ptr(b"vkGetDeviceMemoryCommitment\0")) as PfnGetDeviceMemoryCommitment
