// Commands available before an instance exists, resolved with
// vkGetInstanceProcAddr(NULL, name). A command the driver does not
// provide, or whose extension or version was not enabled, holds address
// zero: check `unsafe { fns.name as usize } != 0` before calling it.
pub struct EntryFns {
    pub create_instance: PfnCreateInstance
    pub get_instance_proc_addr: PfnGetInstanceProcAddr
    pub enumerate_instance_extension_properties: PfnEnumerateInstanceExtensionProperties
    pub enumerate_instance_layer_properties: PfnEnumerateInstanceLayerProperties
    pub enumerate_instance_version: PfnEnumerateInstanceVersion
}

// Resolve every EntryFns command. Unsafe: the getter must be the
// loader's, and the handle live for as long as the table is used.
pub unsafe fn load_entry(get_instance_proc_addr: PfnGetInstanceProcAddr) -> EntryFns {
    unsafe {
        fns := zeroed::<EntryFns>()
        fns.create_instance = get_instance_proc_addr(null_handle::<InstanceT>(), ptr.as_ptr(b"vkCreateInstance\0")) as PfnCreateInstance
        fns.get_instance_proc_addr = get_instance_proc_addr
        fns.enumerate_instance_extension_properties = get_instance_proc_addr(null_handle::<InstanceT>(), ptr.as_ptr(b"vkEnumerateInstanceExtensionProperties\0")) as PfnEnumerateInstanceExtensionProperties
        fns.enumerate_instance_layer_properties = get_instance_proc_addr(null_handle::<InstanceT>(), ptr.as_ptr(b"vkEnumerateInstanceLayerProperties\0")) as PfnEnumerateInstanceLayerProperties
        fns.enumerate_instance_version = get_instance_proc_addr(null_handle::<InstanceT>(), ptr.as_ptr(b"vkEnumerateInstanceVersion\0")) as PfnEnumerateInstanceVersion
        return fns
    }
}

