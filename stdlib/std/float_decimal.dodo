package float_decimal

import "core/ptr"

// Exact binary64 conversion using the identity m / 2^k = (m * 5^k) / 10^k.
// Decode the significand and exponent, construct an integer decimal coefficient,
// then round that coefficient to the requested decimal place. All arithmetic
// after reading the bits is integer arithmetic, independent of the FP mode.
// fmt handles signs and special spellings; this helper accepts finite values
// >= 0 (including either zero encoding) and checks capacity before writing.
pub enum DecimalError {
    InvalidPrecision, InvalidValue, BufferFull
}
pub const MAX_PRECISION: usize = 324

struct Decimal {
    // Least significant digit first: value = coefficient * 10^(-scale).
    // m < 2^53 and k <= 1074, so m * 5^k < 10^767. Positive binary
    // exponents need at most 309 digits. One extra slot allows a rounding carry.
    digits: [768]u8
    length: usize
    scale: i32

    fn exact(bits: u64) -> Decimal {
        result := Decimal { digits: [0u8; 768], length: 1, scale: 0 }
        significand := bits & 0x000fffffffffffffu64
        encoded_exponent := ((bits >> 52) & 0x7ff) as i32
        binary_exponent := -1074i32
        if encoded_exponent != 0 {
            significand = significand | 0x0010000000000000u64
            binary_exponent = encoded_exponent - 1023 - 52
        }
        if significand == 0 {
            return result
        }
        // Cancel factors of two before constructing the decimal coefficient.
        for (significand & 1) == 0 {
            significand = significand >> 1
            binary_exponent = binary_exponent + 1
        }
        result.length = 0
        for significand != 0 {
            result.digits[result.length] = (significand % 10) as u8
            result.length = result.length + 1
            significand = significand / 10
        }
        if binary_exponent < 0 {
            result.scale = 0 - binary_exponent
            result.multiply_power(5, 0 - binary_exponent)
        } else {
            result.multiply_power(2, binary_exponent)
        }
        return result
    }

    fn multiply_power(&mut self, base: u32, power: i32) {
        remaining := power
        for remaining > 0 {
            // Up to twelve factors at once. Each product plus carry is less
            // than 10 * 5^12 = 2441406250, which fits in u32.
            factor := 1u32
            count := 0i32
            for count < 12 && remaining > 0 {
                factor = factor * base
                count = count + 1
                remaining = remaining - 1
            }
            carry := 0u32
            for index in 0usize..self.length {
                product := self.digits[index] as u32 * factor + carry
                self.digits[index] = (product % 10) as u8
                carry = product / 10
            }
            for carry != 0 {
                self.digits[self.length] = (carry % 10) as u8
                self.length = self.length + 1
                carry = carry / 10
            }
        }
    }

    fn round(&mut self, places: i32) {
        discard := self.scale - places
        if discard <= 0 {
            return
        }
        if discard > self.length as i32 {
            self.digits[0] = 0
            self.length = 1
            self.scale = 0
            return
        }
        removed := discard as usize
        halfway_digit := self.digits[removed - 1]
        remainder := false
        for index in 0usize..removed - 1 {
            remainder = remainder || self.digits[index] != 0
        }
        retained_odd := false
        if removed < self.length {
            retained_odd = (self.digits[removed] & 1) != 0
        }
        increment := halfway_digit > 5 || (halfway_digit == 5 && (remainder || retained_odd))
        for index in removed..self.length {
            self.digits[index - removed] = self.digits[index]
        }
        self.length = self.length - removed
        self.scale = places
        if self.length == 0 {
            self.digits[0] = 0
            self.length = 1
        }
        if increment {
            index := 0usize
            for index < self.length && self.digits[index] == 9 {
                self.digits[index] = 0
                index = index + 1
            }
            if index == self.length {
                self.digits[index] = 1
                self.length = self.length + 1
            } else {
                self.digits[index] = self.digits[index] + 1
            }
        }
        if self.length == 1 && self.digits[0] == 0 {
            self.scale = 0
        }
    }

    fn exponent(&self) -> i32 {
        return self.length as i32 - 1 - self.scale
    }

    fn ascii_at(&self, power: i32) -> u8 {
        index := power + self.scale
        if index < 0 || index >= self.length as i32 {
            return 48
        }
        return 48 + self.digits[index as usize]
    }
}

pub fn convert(output: &mut[u8], value: f64, precision: usize, scientific: bool) -> usize!DecimalError {
    if precision > MAX_PRECISION {
        return err(DecimalError.InvalidPrecision)
    }
    // Unaligned access accommodates targets where f64 and u64 alignment differ.
    bits := unsafe {
        ptr.read_unaligned(ptr.from_ref(&value) as *const u64)
    }
    magnitude := bits & 0x7fffffffffffffffu64
    if magnitude >= 0x7ff0000000000000u64 || ((bits >> 63) != 0 && magnitude != 0) {
        return err(DecimalError.InvalidValue)
    }
    decimal := Decimal.exact(magnitude)
    places := precision as i32
    if scientific {
        places = places - decimal.exponent()
    }
    decimal.round(places)
    exponent := decimal.exponent()
    leading := 1usize
    first_power := exponent
    if!scientific {
        if exponent > 0 {
            leading = leading + exponent as usize
        }
        first_power = leading as i32 - 1
    }
    body_size := leading + precision
    if precision > 0 {
        body_size = body_size + 1
    }
    absolute_exponent := exponent
    if exponent < 0 {
        absolute_exponent = 0 - exponent
    }
    exponent_width := 2usize
    if absolute_exponent >= 100 {
        exponent_width = 3
    }
    size := body_size
    if scientific {
        size = size + 2 + exponent_width
    }
    if output.len < size {
        return err(DecimalError.BufferFull)
    }
    for index in 0usize..leading {
        output[index] = decimal.ascii_at(first_power - index as i32)
    }
    if precision > 0 {
        output[leading] = 46
        for index in 0usize..precision {
            output[leading + 1 + index] = decimal.ascii_at(first_power - leading as i32 - index as i32)
        }
    }
    if scientific {
        output[body_size] = 101
        output[body_size + 1] = 43
        if exponent < 0 {
            output[body_size + 1] = 45
        }
        // Fill the exponent from the units place, including its leading zero.
        for index in 0usize..exponent_width {
            output[size - 1 - index] = 48 + (absolute_exponent % 10) as u8
            absolute_exponent = absolute_exponent / 10
        }
    }
    return ok(size)
}
