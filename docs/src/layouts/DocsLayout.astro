---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import HomeHero from '../components/HomeHero.astro';
import { docSections, getDocs, learningPath, pageUrl } from '../lib/docs';
import '../styles/global.css';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const pages = await getDocs();
const path = learningPath(pages);
const step = (page: CollectionEntry<'docs'>) => path.indexOf(page) + 1;
const sections = docSections.map((title) => ({
  title,
  pages: pages.filter((page) => page.data.section === title),
})).filter((section) => section.pages.length > 0);
const apiGroups = [...new Set(pages.map((page) => page.data.navigationGroup).filter(Boolean))];
const current = pages.findIndex((page) => page.id === entry.id);
const previous = pages[current - 1];
const next = pages[current + 1];
const currentStep = step(pages[current]);
const isHome = entry.id === 'index';
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const base = import.meta.env.BASE_URL;
const repository = 'https://github.com/jotrorox/dodo';
const canonical = new URL(pageUrl(entry.id), Astro.site);
const editUrl = `${repository}/edit/main/${entry.data.source ?? `docs/src/content/docs/${entry.id}.md`}`;
---

<!doctype html>
<html lang="en" style={`--mark-url: url("${base}favicon.svg")`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={entry.data.description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161618" media="(prefers-color-scheme: dark)" />
    <title>{isHome ? 'Dodo documentation' : `${entry.data.title} · Dodo`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('dodo-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch { /* Without storage the page follows the system appearance. */ }
    </script>
  </head>
  <body class:list={{ home: isHome }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <button class="icon-button menu-button" type="button" aria-label="Show navigation" aria-controls="sidebar" aria-expanded="false" data-menu-toggle>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <a class="brand" href={base} aria-label="Dodo documentation home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">Dodo</span>
        <span class="brand-docs">Documentation</span>
      </a>
      <div class="header-actions">
        <button class="search-trigger" type="button" data-search-open aria-label="Search documentation" aria-haspopup="dialog" aria-controls="search-dialog">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
          <span class="search-placeholder">Search</span><kbd data-search-key>Ctrl K</kbd>
        </button>
        <a class="icon-button" href={repository} aria-label="Dodo on GitHub" title="Dodo on GitHub">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.8a10.2 10.2 0 0 0-3.2 19.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.3-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .9-.3 2.8 1a9.6 9.6 0 0 1 5.1 0c1.9-1.3 2.8-1 2.8-1 .6 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.2 10.2 0 0 0 12 1.8Z"/></svg>
        </a>
        <button class="icon-button theme-toggle" type="button" aria-label="Appearance: match system" title="Appearance: match system" data-theme-toggle>
          <svg class="theme-icon theme-icon-system" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z" fill="currentColor"/></svg>
          <svg class="theme-icon theme-icon-light" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2m0 15v2M2.5 12h2m15 0h2M5.3 5.3l1.4 1.4m10.6 10.6 1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
          <svg class="theme-icon theme-icon-dark" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/></svg>
        </button>
      </div>
    </header>

    <div class="shell">
      <div class="sidebar-scrim" data-menu-close hidden></div>
      <aside id="sidebar" class="sidebar" aria-label="Documentation">
        <nav aria-label="Documentation">
          {sections.map((section, index) => {
            const containsCurrent = section.pages.some((page) => page.id === entry.id);
            return (
              <details class="nav-section" open={section.title !== 'API reference' || containsCurrent}>
                <summary class="nav-heading" id={`nav-section-${index}`}>
                  <span>{section.title}</span>
                  <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>
                </summary>
                <ul aria-labelledby={`nav-section-${index}`}>
                  {section.pages.filter((page) => !page.data.navigationGroup).map((page) => (
                    <li>
                      <a href={pageUrl(page.id)} aria-current={entry.id === page.id ? 'page' : undefined}>
                        {step(page) > 0 && <span class="step"><span class="sr-only">Step </span>{step(page)}</span>}
                        <span>{page.id === 'index' ? 'Overview' : page.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                {section.title === 'API reference' && apiGroups.map((group) => (
                  <details class="api-group" open={entry.data.navigationGroup === group}>
                    <summary>
                      <svg class="chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 3 3 3-3 3"/></svg>
                      <code>{group}</code>
                    </summary>
                    <ul>{section.pages.filter((page) => page.data.navigationGroup === group).map((page) => (
                      <li><a href={pageUrl(page.id)} aria-current={entry.id === page.id ? 'page' : undefined}>{page.data.title}</a></li>
                    ))}</ul>
                  </details>
                ))}
              </details>
            );
          })}
        </nav>
        <button type="button" class="shortcut-trigger" data-shortcuts-open aria-haspopup="dialog" aria-controls="shortcuts-dialog">
          <kbd>?</kbd> Keyboard shortcuts
        </button>
      </aside>

      <main id="main-content" tabindex="-1">
        {isHome ? <HomeHero pages={pages} /> : (
          <header class="page-heading">
            <p class="eyebrow">
              <span class="eyebrow-section">{entry.data.section}</span>
              {currentStep > 0 && <span class="eyebrow-step">Step {currentStep} of {path.length}</span>}
              {entry.data.navigationGroup && <span class="eyebrow-step"><code>{entry.data.navigationGroup}</code></span>}
            </p>
            <h1>{entry.data.title}</h1>
            <p class="page-description">{entry.data.description}</p>
          </header>
        )}
        {toc.length > 0 && !isHome && (
          <details class="mobile-toc">
            <summary>
              <span>On this page</span>
              <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>
            </summary>
            <ul>{toc.filter(({ depth }) => depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
          </details>
        )}
        <article class="prose"><slot /></article>

        <footer class="page-footer">
          <nav class="page-navigation" aria-label="Previous and next pages">
            {previous ? <a href={pageUrl(previous.id)} rel="prev"><span>Previous</span><strong>{previous.id === 'index' ? 'Overview' : previous.data.title}</strong></a> : <span />}
            {next ? <a href={pageUrl(next.id)} rel="next"><span>Next</span><strong>{next.data.title}</strong></a> : <span />}
          </nav>
          <div class="footer-meta">
            <p>© 2026 Johannes Müller and Dodo contributors · <a href={`${repository}/blob/main/LICENSE`}>BSD-2-Clause</a></p>
            <a class="edit-link" href={editUrl}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg>
              {entry.data.source ? 'Edit API source on GitHub' : 'Edit this page on GitHub'}
            </a>
          </div>
        </footer>
      </main>

      <aside class="toc" aria-label="On this page">
        {toc.length > 0 && (
          <nav aria-labelledby="toc-title">
            <p class="toc-title" id="toc-title">On this page</p>
            <ul>{toc.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
            <a class="back-to-top" href="#main-content">Back to top</a>
          </nav>
        )}
      </aside>
    </div>

    <dialog id="search-dialog" class="search-dialog" aria-label="Search documentation" data-search-index={`${base}search.json`}>
      <div class="search-box">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
        <label class="sr-only" for="search-input">Search documentation</label>
        <input id="search-input" type="search" placeholder="Search guides and API" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results" aria-describedby="search-status" />
        <button class="dialog-close" type="button" data-close-dialog>Cancel</button>
      </div>
      <p id="search-status" class="search-status" role="status" aria-live="polite">Search every guide, reference page, and API declaration.</p>
      <ul id="search-results" class="search-results" role="listbox" aria-label="Search results"></ul>
      <div class="search-footer"><span><kbd>↑</kbd><kbd>↓</kbd> Move</span><span><kbd>↵</kbd> Open</span><span><kbd>Esc</kbd> Close</span></div>
    </dialog>

    <dialog id="shortcuts-dialog" class="shortcuts-dialog" aria-labelledby="shortcuts-title">
      <div class="dialog-heading"><h2 id="shortcuts-title">Keyboard shortcuts</h2><button class="dialog-close" type="button" data-close-dialog>Done</button></div>
      <dl class="shortcut-list">
        <div><dt>Search documentation</dt><dd><kbd data-search-key>Ctrl K</kbd> <span>or</span> <kbd>/</kbd></dd></div>
        <div><dt>Move through results</dt><dd><kbd>↑</kbd> <kbd>↓</kbd></dd></div>
        <div><dt>Open selected result</dt><dd><kbd>↵</kbd></dd></div>
        <div><dt>Close a dialog</dt><dd><kbd>Esc</kbd></dd></div>
        <div><dt>Show these shortcuts</dt><dd><kbd>?</kbd></dd></div>
      </dl>
    </dialog>
    <script>
      import '../scripts/docs';
    </script>
  </body>
</html>
