module asm "    lsls r3, r1, #1"
module asm "    lsrs r3, r3, #24"
module asm "    subs r4, r2, #1"
module asm "    cmp r4, #254"
module asm "    bhs .Lfmul_edge"
module asm "    subs r4, r3, #1"
module asm "    cmp r4, #254"
module asm "    bhs .Lfmul_edge"
module asm "    mov r7, r0"
module asm "    eors r7, r1"
module asm "    lsrs r7, r7, #31"
module asm "    lsls r7, r7, #31"
