module asm "    lsls r7, r3, #1"
module asm "    cmp r0, r2"
module asm "    sbcs r6, r7"
module asm "    bhs 1f"
module asm "    mov r6, r0"
module asm "    mov r0, r2"
module asm "    mov r2, r6"
module asm "    mov r6, r1"
module asm "    mov r1, r3"
module asm "    mov r3, r6"
module asm "    mov r6, r4"
module asm "    mov r4, r5"
module asm "    mov r5, r6"
module asm "1:  subs r6, r4, r5"
module asm "    subs r4, r4, #1"
module asm "    mov r7, r1"
module asm "    eors r7, r3"
module asm "    mov r12, r7"
module asm "    lsrs r5, r1, #31"
module asm "    lsls r5, r5, #31"
module asm "    mov lr, r5"
