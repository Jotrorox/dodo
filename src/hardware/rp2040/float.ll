module asm "    bhs .Lfmul_soft"
module asm "    b 2f"
module asm "1:  lsls r4, r1, #1"
module asm "    beq 2f"
module asm "    subs r4, r3, #1"
module asm "    cmp r4, #254"
module asm "    bhs .Lfmul_soft"
module asm "2:  eors r0, r1"
module asm "    lsrs r0, r0, #31"
module asm "    lsls r0, r0, #31"
