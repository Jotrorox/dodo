; folded into bit 0.
module asm "    lsls r3, r5, #22"
module asm "    orrs r4, r3"
module asm "    lsrs r5, r5, #10"
module asm "    lsls r3, r2, #22"
module asm "    orrs r5, r3"
module asm "    lsrs r2, r2, #10"
module asm "    lsls r1, r1, #22"
module asm "    orrs r1, r2"
module asm "    mov r0, r5"
module asm "    cmp r4, #0"
module asm "    beq 1f"
module asm "    movs r3, #1"
module asm "    orrs r0, r3"
