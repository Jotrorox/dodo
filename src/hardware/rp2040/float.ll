module asm "    push {r0-r3}"
module asm "    lsls r4, r1, #1"
module asm "    lsrs r4, r4, #21"
module asm "    lsls r5, r3, #1"
module asm "    lsrs r5, r5, #21"
module asm "    ldr r7, =2046"
module asm "    subs r6, r4, #1"
module asm "    cmp r6, r7"
module asm "    bhs 0f"
module asm "    subs r6, r5, #1"
module asm "    cmp r6, r7"
module asm "    blo 5f"
module asm "0:  b .Ldmul_edge"
module asm "5:"
; One less than the exponent of a product of significands below 2.
module asm "    adds r4, r4, r5"
module asm "    ldr r5, =1024"
module asm "    subs r4, r4, r5"
module asm "    push {r4}"
; The significands' high words with the leading 1 at bit 20.
module asm "    lsls r1, r1, #12"
module asm "    lsrs r1, r1, #12"
module asm "    lsls r3, r3, #12"
module asm "    lsrs r3, r3, #12"
module asm "    movs r5, #1"
module asm "    lsls r5, r5, #20"
module asm "    orrs r1, r5"
module asm "    orrs r3, r5"
