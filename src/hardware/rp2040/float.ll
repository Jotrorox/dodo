module asm "    mov r2, r12"
module asm "    cmp r1, #0"
module asm "    bmi 1f"
module asm "    lsls r1, r1, #1"
module asm "    lsrs r3, r0, #31"
module asm "    orrs r1, r3"
module asm "    lsls r0, r0, #1"
module asm "    b 2f"
module asm "1:  adds r2, #1"
module asm "2:  cmp r0, #0"
module asm "    beq 3f"
module asm "    movs r3, #1"
module asm "    orrs r1, r3"
module asm "3:  mov r0, r1"
