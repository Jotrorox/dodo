module asm "    lsls r1, r1, #11"
module asm "    lsrs r7, r0, #21"
module asm "    orrs r1, r7"
module asm "    lsls r0, r0, #11"
module asm "    lsls r3, r3, #11"
module asm "    lsrs r7, r2, #21"
module asm "    orrs r3, r7"
module asm "    lsls r2, r2, #11"
module asm "    movs r7, #1"
module asm "    lsls r7, r7, #31"
module asm "    orrs r1, r7"
module asm "    orrs r3, r7"
; Shift b's right by the exponent difference d, at most 63, with the
; bits shifted out folded into bit 0. Register shifts by 32 to 255 give 0.
module asm "    cmp r6, #63"
module asm "    bls 1f"
module asm "    movs r6, #63"
module asm "1:  cmp r6, #32"
module asm "    bhs 3f"
module asm "    movs r7, #32"
module asm "    subs r7, r7, r6"
module asm "    mov r5, r2"
module asm "    lsls r5, r7"
module asm "    lsrs r2, r6"
module asm "    cmp r5, #0"
module asm "    beq 2f"
module asm "    movs r5, #1"
module asm "    orrs r2, r5"
module asm "2:  mov r5, r3"
module asm "    lsls r5, r7"
module asm "    orrs r2, r5"
module asm "    lsrs r3, r6"
module asm "    b 4f"
module asm "3:  subs r6, #32"
module asm "    movs r7, #32"
module asm "    subs r7, r7, r6"
module asm "    mov r5, r3"
module asm "    lsls r5, r7"
module asm "    orrs r5, r2"
module asm "    lsrs r3, r6"
module asm "    mov r2, r3"
module asm "    movs r3, #0"
module asm "    cmp r5, #0"
module asm "    beq 4f"
module asm "    movs r5, #1"
module asm "    orrs r2, r5"
module asm "4:  mov r5, r12"
module asm "    cmp r5, #0"
module asm "    bmi .Ldadd_sub"
module asm "    adds r0, r0, r2"
module asm "    adcs r1, r3"
module asm "    bcc .Ldadd_round"
; A carry out: shift right by one, keeping the lost bit.
module asm "    movs r5, #1"
module asm "    ands r5, r0"
module asm "    lsrs r0, r0, #1"
module asm "    lsls r6, r1, #31"
module asm "    orrs r0, r6"
module asm "    orrs r0, r5"
module asm "    lsrs r1, r1, #1"
module asm "    movs r6, #1"
module asm "    lsls r6, r6, #31"
module asm "    orrs r1, r6"
module asm "    adds r4, #1"
module asm "    b .Ldadd_round"
module asm ".Ldadd_sub:"
module asm "    subs r0, r0, r2"
module asm "    sbcs r1, r3"
module asm "    bmi .Ldadd_round"
module asm "    lsls r5, r1, #1"
module asm "    bpl .Ldadd_norm"
module asm "    adds r0, r0, r0"
module asm "    adcs r1, r1"
module asm "    subs r4, #1"
module asm ".Ldadd_round:"
module asm "    round_pack dodo_soft_dadd"
; Several leading zeros, which only an exponent difference of 0 or 1
