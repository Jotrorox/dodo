; 32x32-bit products; w0 only matters for being nonzero.
module asm "    mov r12, r1"
module asm "    mov lr, r3"
module asm "    mov r4, r0"
module asm "    mov r5, r2"
module asm "    mul32 r4, r5, r1, r3, r6"
module asm "    mov r1, r12"
module asm "    mul32 r1, r2, r3, r6, r7"
module asm "    movs r3, #0"
module asm "    adds r5, r5, r1"
module asm "    adcs r2, r3"
module asm "    mov r1, lr"
module asm "    mul32 r0, r1, r3, r6, r7"
module asm "    adds r5, r5, r0"
module asm "    adcs r2, r1"
module asm "    mov r0, r12"
module asm "    mov r1, lr"
module asm "    mul32 r0, r1, r3, r6, r7"
module asm "    movs r3, #0"
module asm "    adds r2, r2, r0"
module asm "    adcs r1, r3"
