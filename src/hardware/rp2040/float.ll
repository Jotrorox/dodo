module asm "    cmp r6, r7"
module asm "    bhs .Ldmul_soft"
module asm "2:  eors r1, r3"
module asm "    lsrs r1, r1, #31"
module asm "    lsls r1, r1, #31"
module asm "    movs r0, #0"
module asm "    add sp, #16"
module asm "    pop {r4-r7, pc}"
module asm ".Ldmul_soft:"
module asm "    pop {r0-r3}"
