module asm "    pop {r4-r7, pc}"
module asm "    .ltorg"

; binary32: the same, in single words, with the leading 1 at bit 31 and the
; result's last bit at bit 8. In: r0 the significand, r2 one less than the
; biased exponent (1 to 253 return; others go to \soft), r7 the sign.
module asm ".macro round_pack32 soft"
module asm "    cmp r2, #252"
module asm "    bhi 8f"
module asm "    lsls r3, r0, #24"
module asm "    lsrs r0, r0, #8"
module asm "    lsls r3, r3, #1"
module asm "    bcc 7f"
module asm "    bne 6f"
module asm "    lsrs r3, r0, #1"
module asm "    bcc 7f"
module asm "6:  adds r0, #1"
module asm "7:  lsls r2, r2, #23"
module asm "    adds r0, r0, r2"
module asm "    orrs r0, r7"
module asm "    add sp, #8"
module asm "    pop {r4-r7, pc}"
module asm "8:  pop {r0, r1}"
module asm "    bl \5Csoft"
module asm "    pop {r4-r7, pc}"
module asm ".endm"

