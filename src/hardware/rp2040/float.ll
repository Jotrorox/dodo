module asm "    cmp r1, #0"
module asm "    bne 1f"
module asm "    cmp r0, #0"
module asm "    beq .Ldadd_zero"
module asm "    mov r1, r0"
module asm "    movs r0, #0"
module asm "    subs r4, #32"
module asm "1:  movs r6, #0"
module asm "    mov r7, r1"
module asm "    lsrs r5, r7, #16"
module asm "    bne 2f"
module asm "    adds r6, #16"
module asm "    lsls r7, r7, #16"
module asm "2:  lsrs r5, r7, #24"
module asm "    bne 2f"
module asm "    adds r6, #8"
module asm "    lsls r7, r7, #8"
module asm "2:  lsrs r5, r7, #28"
module asm "    bne 2f"
module asm "    adds r6, #4"
module asm "    lsls r7, r7, #4"
module asm "2:  lsrs r5, r7, #30"
module asm "    bne 2f"
module asm "    adds r6, #2"
module asm "    lsls r7, r7, #2"
