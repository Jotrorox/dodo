module asm "    ldr r5, [sp, #4]"
module asm "    ldr r6, [sp, #12]"
module asm "    eors r5, r6"
module asm "    lsrs r5, r5, #31"
module asm "    lsls r5, r5, #31"
module asm "    mov lr, r5"
module asm "    cmp r1, #0"
module asm "    bmi 2f"
module asm "    adds r0, r0, r0"
module asm "    adcs r1, r1"
module asm "    b 3f"
module asm "2:  adds r4, #1"
module asm "3:  round_pack dodo_soft_dmul"
; An operand is not normal. A zero times a zero or a normal number gives
; a zero; everything else goes to software.
module asm ".Ldmul_edge:"
module asm "    lsls r6, r1, #1"
module asm "    orrs r6, r0"
module asm "    beq 1f"
module asm "    lsls r6, r3, #1"
module asm "    orrs r6, r2"
module asm "    bne .Ldmul_soft"
module asm "    subs r6, r4, #1"
module asm "    cmp r6, r7"
module asm "    bhs .Ldmul_soft"
module asm "    b 2f"
module asm "1:  lsls r6, r3, #1"
module asm "    orrs r6, r2"
module asm "    beq 2f"
