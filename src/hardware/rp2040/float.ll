; RP2040 binary64 and binary32 addition, subtraction and multiplication in
; Thumb-1 assembly. The compiler appends this file after arm_float.ll for the
; RP2040 (see `src/hardware/CHIP.rs`), in place of arm_float_soft.ll, and it
; gives the other helpers their names as that file does.
;
; LLVM's Thumb-1 code for the software helpers in arm_float.ll spills much of
; its working state, since only r0 to r7 are general purpose. These helpers
; handle the common case, two normal operands and a normal result, in
; registers, and call the software helper for everything else: a zero,
; subnormal, infinite or NaN operand (except a zero with a normal number,
; which they also handle), and a result whose exponent is near either end of
; the range, where it could be subnormal or overflow. So the results are the
; software helpers' bit for bit, which the emulator self-test checks on
; random operands (tests/emulator/selftest.dodo). Cycles per call on
; everyday operands, as the emulator counts them, against the software
; helpers: fadd 85 (170), fmul 90 (145), dadd 130 (305), dmul 195 (335).
;
; Each helper pushes its operands, so that the software helper can be called
; with them, and works on significands with the leading 1 at the top bit and
; the bits below the result's last bit exact or folded into bit 0. Register
; shifts by 32 to 255 give 0, which the shifts by 32 - n rely on.


; Round and pack a result, or compute it again in software. In: r1:r0 the
; significand with its leading 1 at bit 63 and everything below the result's
; last bit (bit 11) exact or folded into bit 0, r4 one less than the biased
; exponent, lr the sign (bit 31), and the operands on the stack above the
; caller's r4 to r7 and lr. An exponent outside 1 to 2045, where the result
; could be subnormal or overflow, goes to \soft with the operands.
module asm ".macro round_pack soft"
module asm "    ldr r5, =2044"
module asm "    cmp r4, r5"
module asm "    bhi 8f"
module asm "    lsls r2, r0, #21"
module asm "    lsls r3, r1, #21"
module asm "    lsrs r0, r0, #11"
module asm "    orrs r0, r3"
module asm "    lsrs r1, r1, #11"
module asm "    lsls r2, r2, #1"
module asm "    bcc 7f"
module asm "    bne 6f"
module asm "    lsrs r3, r0, #1"
module asm "    bcc 7f"
module asm "6:  adds r0, #1"
module asm "    bcc 7f"
module asm "    adds r1, #1"
module asm "7:  lsls r4, r4, #20"
module asm "    adds r1, r1, r4"
module asm "    mov r5, lr"
module asm "    orrs r1, r5"
module asm "    add sp, #16"
module asm "    pop {r4-r7, pc}"
module asm "8:  pop {r0-r3}"
module asm "    bl \5Csoft"
module asm "    pop {r4-r7, pc}"
module asm ".endm"

; (\x, \y) = \x * \y: \x gets the low word, \y the high word, from four
; 16x16-bit products. Clobbers \t1 to \t3.
module asm ".macro mul32 x, y, t1, t2, t3"
module asm "    uxth \5Ct1, \5Cx"
module asm "    lsrs \5Cx, \5Cx, #16"
module asm "    uxth \5Ct2, \5Cy"
module asm "    lsrs \5Cy, \5Cy, #16"
module asm "    mov \5Ct3, \5Ct1"
module asm "    muls \5Ct3, \5Ct2"
module asm "    muls \5Ct1, \5Cy"
module asm "    muls \5Ct2, \5Cx"
module asm "    muls \5Cy, \5Cx"
module asm "    adds \5Ct1, \5Ct2"
module asm "    bcc 1f"
module asm "    movs \5Cx, #1"
module asm "    lsls \5Cx, \5Cx, #16"
module asm "    adds \5Cy, \5Cy, \5Cx"
module asm "1:  lsls \5Cx, \5Ct1, #16"
module asm "    lsrs \5Ct1, \5Ct1, #16"
module asm "    adds \5Cx, \5Cx, \5Ct3"
module asm "    adcs \5Cy, \5Ct1"
module asm ".endm"

module asm "    .section .text.dodo_rp2040_dadd, \22ax\22, %progbits"
