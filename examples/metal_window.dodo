package main

import "core/ptr"
import "std/console"
import "std/gpu/metal"
import "std/gpu/metal/objc"
import "std/window"

// Draw a spinning triangle with Metal straight into a std/window window
// (macOS only). The window has no pixel buffer; win.metal_layer() gives its
// view a CAMetalLayer, whose drawables Metal renders into and presents.
// std/window keeps the layer's drawable size at the window's size in
// pixels. Press Escape or close the window to quit.

const SHADERS: &str = "#include <metal_stdlib>\nusing namespace metal;\nstruct Spin { float angle; float2 aspect; };\nstruct Out { float4 position [[position]]; float3 color; };\nconstant float2 corners[3] = { float2(-0.6, -0.5), float2(0.6, -0.5), float2(0.0, 0.7) };\nconstant float3 colors[3] = { float3(1.0, 0.3, 0.2), float3(0.2, 0.9, 0.4), float3(0.3, 0.4, 1.0) };\nvertex Out spin_vertex(uint id [[vertex_id]], constant Spin &spin [[buffer(0)]]) {\n    float c = cos(spin.angle);\n    float s = sin(spin.angle);\n    float2 p = float2x2(c, s, -s, c) * corners[id] * spin.aspect;\n    Out out;\n    out.position = float4(p, 0.0, 1.0);\n    out.color = colors[id];\n    return out;\n}\nfragment float4 spin_fragment(Out in [[stage_in]]) {\n    return float4(in.color, 1.0);\n}\n"

fn f32_bytes(values: &[f32], out: &mut[u8]) {
    for i in 0usize..values.len {
        value := values[i]
        bits := unsafe {
            ptr.read(ptr.from_ref(&value) as *const u32)
        }
        out[i * 4] = (bits & 0xff) as u8
        out[i * 4 + 1] = ((bits >> 8) & 0xff) as u8
        out[i * 4 + 2] = ((bits >> 16) & 0xff) as u8
        out[i * 4 + 3] = (bits >> 24) as u8
    }
}

fn pipeline(device: &metal.Device) -> metal.RenderPipelineState!metal.Error {
    options := metal.CompileOptions.new()?
    library := device.new_library_with_source(SHADERS, &options)?
    vertex := library.new_function("spin_vertex")?
    fragment := library.new_function("spin_fragment")?
    descriptor := metal.RenderPipelineDescriptor.new()?
    descriptor.set_vertex_function(&vertex)
    descriptor.set_fragment_function(&fragment)
    target := descriptor.color_attachment(0)?
    target.set_pixel_format(metal.PIXEL_FORMAT_BGRA8_UNORM)
    return device.new_render_pipeline_state(&descriptor)
}

// One frame: clear the next drawable, draw the triangle turned by `angle`
// radians and present it when the GPU has rendered it.
fn draw(layer: &metal.MetalLayer, queue: &metal.CommandQueue, state: &metal.RenderPipelineState, width: u32, height: u32, angle: f32) -> void!metal.Error {
    // None while the window is minimized or every drawable is in use.
    drawable := match layer.next_drawable() {
        some(drawable) => drawable,
        none => {
            return ok()
        }
    }
    texture := drawable.texture()?
    pass := metal.RenderPassDescriptor.new()?
    attachment := pass.color_attachment(0)?
    attachment.set_texture(&texture)
    attachment.set_load_action(metal.LOAD_ACTION_CLEAR)
    attachment.set_store_action(metal.STORE_ACTION_STORE)
    attachment.set_clear_color(metal.ClearColor.new(0.11, 0.13, 0.19, 1.0))
    // Keep the triangle's shape whatever the window's proportions. The
    // struct is a float and a float2, 16 bytes with padding.
    sx := 1.0f32
    sy := 1.0f32
    if width > height {
        sx = height as f32 / width as f32
    } else if height > 0 {
        sy = width as f32 / height as f32
    }
    values := [angle, 0.0, sx, sy]
    spin := [0u8; 16]
    f32_bytes(&values, &mut spin)
    commands := queue.command_buffer()?
    encoder := commands.render_command_encoder(&pass)?
    encoder.set_render_pipeline_state(state)
    encoder.set_vertex_bytes(&spin, 0)
    encoder.draw_primitives(metal.PRIMITIVE_TYPE_TRIANGLE, 0, 3)
    encoder.end_encoding()
    commands.present_drawable(&drawable)
    commands.commit()
    return ok()
}

// Ask for the next Frame event; false once the window is gone.
fn asked(win: &mut window.Window) -> bool {
    match win.request_frame() {
        ok() => {
            return true
        }
        err(_) => {
            return false
        }
    }
}

fn run(device: &metal.Device, app: &mut window.App, win: &mut window.Window) -> void!metal.Error {
    address := match win.metal_layer() {
        ok(address) => address,
        err(_) => {
            return err(metal.Error.Unsupported)
        }
    }
    // The view keeps its layer; this reference is a second one.
    object := match unsafe {
        objc.Object.retain(address as objc.Id)
    }
    {
        some(object) => object,
        none => {
            return err(metal.Error.Unsupported)
        }
    }
    layer := unsafe {
        metal.MetalLayer.from_object(object)
    }
    layer.set_device(device)
    layer.set_pixel_format(metal.PIXEL_FORMAT_BGRA8_UNORM)
    queue := device.new_command_queue()?
    state := pipeline(device)?
    period := win.frame_interval()
    step := 1.2f32 * (period.seconds() as f32 + period.subsec_nanos() as f32 / 1000000000.0)
    angle := 0.0f32
    if !asked(win) {
        return ok()
    }
    for {
        event := match app.wait_event() {
            ok(event) => event,
            err(_) => {
                return ok()
            }
        }
        match event {
            window.Event.Close(_) | window.Event.Quit => {
                return ok()
            }
            window.Event.Key(_, key) => {
                if key.key == window.Key.Escape {
                    return ok()
                }
            }
            window.Event.Frame(_) => {
                draw(&layer, &queue, &state, win.width(), win.height(), angle)?
                angle += step
                if !asked(win) {
                    return ok()
                }
            }
            _ => {}
        }
    }
}

fn main() -> i32 {
    device := match metal.Device.system_default() {
        ok(device) => device,
        err(_) => {
            console.println("no Metal device")!
            return 2
        }
    }
    app := match window.App.new() {
        ok(app) => app,
        err(error) => {
            console.println(window.error_name(error))!
            return 1
        }
    }
    win := match app.open(window.Options.gpu("Metal", 480, 320)) {
        ok(win) => win,
        err(error) => {
            console.println(window.error_name(error))!
            return 1
        }
    }
    match run(&device, &mut app, &mut win) {
        ok() => {
            return 0
        }
        err(error) => {
            console.println(metal.error_name(&error))!
            return 1
        }
    }
}
