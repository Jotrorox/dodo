package web_routes
import "std/web"
import "std/web/app"

pub struct Greeting {
    pub fn handle(&mut self, request: &mut web.Request, response: &mut web.Response) -> void!web.Failure {
        return response.text(request.param(b"name")?)
    }
}
pub struct Echo {
    pub fn handle(&mut self, request: &mut web.Request, response: &mut web.Response) -> void!web.Failure {
        return response.bytes(request.body())
    }
}
fn main() -> i32 {
    return app.new()
        .get(b"/", web.html(b"<!doctype html><h1>Dodo</h1><a href=\"/hello/Dodo\">Say hello</a>"))
        .get(b"/hello/:name", Greeting {})
        .post(b"/echo", Echo {})
        .run(b"127.0.0.1:8080")
}
