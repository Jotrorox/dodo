package main

import "std/embedded/board"

// Blink the board's LED once a second. `std/embedded/board` is the board
// selected in dodo.toml, so this program builds unchanged for every supported
// board.
fn main() {
    b := board.take()!
    for {
        b.led.toggle()
        b.timer.delay_ms(500)
    }
}
