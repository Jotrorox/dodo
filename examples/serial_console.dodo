package main

import "core/bytes"
import "std/embedded/board"
import "std/fmt"
import "std/io"

// A command line on the board's serial port. Connect a USB-to-serial
// adapter, or a Raspberry Pi Debug Probe, to GP0 (the board's TX, to the
// adapter's RX), GP1 (its RX, to the adapter's TX), and ground. Flash the
// board from BOOTSEL mode and open a terminal at 115200 baud:
//
//     dodo run examples/serial_console.dodo --board pico
//     picocom -b 115200 /dev/ttyACM0
//
// (or --board pico2 or pico2_w; `screen /dev/tty.usbmodem* 115200` on
// macOS). Type `help` and press Enter. `panic` makes a check fail on
// purpose: because the program claimed a serial port, the default panic
// hook prints which check failed and where before the board halts.
fn main() {
    b := board.take()!
    serial := b.pins.uart(board.UART_TX_PIN, some(board.UART_RX_PIN), 115_200)!
    // Terminals expect CR LF line ends and send CR for Enter.
    serial.set_crlf(true)
    fmt.printf(&mut serial, "\n{} ready; type help.\n", board.NAME)!
    line: [64]u8 = [0; 64]
    for {
        fmt.printf(&mut serial, "> ")!
        count := read_line(&mut serial, &mut line)!
        command := &line[..count]
        if bytes.equal(command, b"help") {
            fmt.printf(&mut serial, "led     toggle the LED\nuptime  time since start\npanic   fail a check\n")!
        } else if bytes.equal(command, b"led") {
            b.led.toggle()
            fmt.printf(&mut serial, "LED {}\n", b.led.is_high())!
        } else if bytes.equal(command, b"uptime") {
            milliseconds := b.timer.now_us() / 1000
            fmt.printf(&mut serial, "{}.{:03} s\n", milliseconds / 1000, milliseconds % 1000)!
        } else if bytes.equal(command, b"panic") {
            // Past the end of the 64-byte line: an index bounds check fails.
            fmt.printf(&mut serial, "{}\n", line[count + 60])!
        } else if count != 0 {
            fmt.printf(&mut serial, "unknown command; type help\n")!
        }
    }
}

// Read one line into `line`, without its newline, echoing it as it is
// typed, since terminals do not show what they send. Backspace removes the
// last character; bytes past the end of `line`, and bytes the line garbled,
// are dropped. Returns the line's length.
fn read_line<S>(serial: &mut S, line: &mut[u8]) -> usize!io.Error {
    count := 0usize
    byte: [1]u8 = [0]
    for {
        match serial.read(&mut byte) {
            ok(_) => {}
            err(_) => {
                // A framing error or overrun: noise on the line, or input
                // faster than it was read. Keep the line so far.
                continue
            }
        }
        if byte[0] == 10 {
            fmt.printf(serial, "\n")?
            return ok(count)
        } else if byte[0] == 8 || byte[0] == 127 {
            if count > 0 {
                count -= 1
                // Back, blank out the character, and back again.
                io.write_all(serial, b"\x08 \x08")?
            }
        } else if byte[0] >= 32 && byte[0] < 127 && count < line.len {
            line[count] = byte[0]
            count += 1
            io.write_all(serial, &byte)?
        }
    }
}
