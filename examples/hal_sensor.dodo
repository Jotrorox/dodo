package hal_sensor

import "std/hal"
import "std/hal/fake"

// A driver for an I2C temperature sensor, written once against the
// `std/hal` protocols. On a board, pass the chip's I2C bus and delay; on a
// desktop, `dodo test examples/hal_sensor.dodo` runs it against fakes.

const ADDRESS: u8 = 0x48
const CONTROL: u8 = 0x01
const START: u8 = 0x80
const STATUS: u8 = 0x02
const READY: u8 = 0x01
const RESULT: u8 = 0x10

pub struct Sensor<B> {
    bus: B

    pub fn new(bus: B) -> Sensor<B> {
        return Sensor<B> { bus }
    }

    // Start one conversion, wait for it with a timeout, and return the
    // temperature in tenths of a degree Celsius.
    pub fn measure<D>(&mut self, delay: &mut D) -> i32!hal.Error {
        hal.write_register(&mut self.bus, ADDRESS, CONTROL, START)?
        for _ in 0..10 {
            hal.delay_ms(delay, 1)
            status := hal.read_register(&mut self.bus, ADDRESS, STATUS)?
            if (status & READY) != 0 {
                raw: [2]u8 = [0, 0]
                hal.read_registers(&mut self.bus, ADDRESS, RESULT, &mut raw)?
                return ok(((raw[0] as i32) << 8) | raw[1] as i32)
            }
        }
        return err(hal.Error.Timeout)
    }

    // Give the bus back, for example to share it with another driver.
    pub fn release(self) -> B {
        let Sensor { bus } = self
        return bus
    }
}

@test
fn measures_temperature() {
    bus := fake.I2c.new(ADDRESS)
    bus.set_register(STATUS, READY)
    bus.set_register(RESULT, 0x00)
    bus.set_register(RESULT + 1, 215)
    sensor := Sensor.new(bus)
    delay := fake.Delay.new()

    assert_eq(sensor.measure(&mut delay)!, 215)
    assert_eq(delay.elapsed_us(), 1000u64)
    bus = sensor.release()
    assert_eq(bus.register(CONTROL), START)
}

@test
fn reports_a_stuck_sensor() {
    sensor := Sensor.new(fake.I2c.new(ADDRESS))
    delay := fake.Delay.new()
    match sensor.measure(&mut delay) {
        ok(value) => {
            assert(false)
        }
        err(error) => {
            assert(error == hal.Error.Timeout)
        }
    }
    assert_eq(delay.elapsed_us(), 10_000u64)
}

@test
fn reports_a_missing_sensor() {
    sensor := Sensor.new(fake.I2c.new(0x10))
    delay := fake.Delay.new()
    match sensor.measure(&mut delay) {
        ok(value) => {
            assert(false)
        }
        err(error) => {
            assert(error == hal.Error.NoAcknowledge)
        }
    }
}
