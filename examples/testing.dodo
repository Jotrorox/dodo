package testing

fn add(a: i32, b: i32) -> i32 {
    a + b
}

@test
fn adds_numbers() {
    assert_eq(add(20, 22), 42)
}

fn test_strings() {
    assert_eq("Dodo", "Dodo")
    assert_ne("ready", "waiting")
}

@test
@ignore("example of an optional test; run with --include-ignored")
fn optional_check() {
    assert(true)
}
