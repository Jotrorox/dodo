package main

import "core/ptr"
import "std/gpu/opengl"
import "std/gpu/opengl/gl"
import "std/window"

// Draw a spinning triangle with OpenGL straight into a std/window window.
// The window has no pixel buffer: the context draws into the window's own
// framebuffer and swap_buffers() shows each frame, with no copy through the
// CPU. Press Escape or close the window to quit.

const WIDTH: u32 = 480
const HEIGHT: u32 = 320

const VERTEX_SHADER: &[u8] = b"#version 330 core\nlayout(location = 0) in vec2 position;\nlayout(location = 1) in vec3 color;\nuniform float angle;\nuniform vec2 aspect;\nout vec3 shade;\nvoid main() {\n    shade = color;\n    float c = cos(angle);\n    float s = sin(angle);\n    gl_Position = vec4(mat2(c, s, -s, c) * position * aspect, 0.0, 1.0);\n}\n\0"
const FRAGMENT_SHADER: &[u8] = b"#version 330 core\nin vec3 shade;\nout vec4 result;\nvoid main() {\n    result = vec4(shade, 1.0);\n}\n\0"

fn compile(kind: u32, source: &[u8]) -> u32 {
    unsafe {
        shader := gl.create_shader(kind)
        text := ptr.as_ptr(source)
        gl.shader_source(shader, 1, ptr.from_ref(&text), 0usize as *const i32)
        gl.compile_shader(shader)
        return shader
    }
}

fn setup() -> u32 {
    vertices := [
        -0.6f32, -0.5, 1.0, 0.3, 0.2,
        0.6, -0.5, 0.2, 0.9, 0.4,
        0.0, 0.7, 0.3, 0.4, 1.0
    ]
    vertex := compile(gl.VERTEX_SHADER, VERTEX_SHADER)
    fragment := compile(gl.FRAGMENT_SHADER, FRAGMENT_SHADER)
    unsafe {
        program := gl.create_program()
        gl.attach_shader(program, vertex)
        gl.attach_shader(program, fragment)
        gl.link_program(program)
        array := 0u32
        gl.gen_vertex_arrays(1, ptr.from_mut(&mut array))
        gl.bind_vertex_array(array)
        buffer := 0u32
        gl.gen_buffers(1, ptr.from_mut(&mut buffer))
        gl.bind_buffer(gl.ARRAY_BUFFER, buffer)
        gl.buffer_data(gl.ARRAY_BUFFER, 60, ptr.as_ptr(&vertices) as *const u8, gl.STATIC_DRAW)
        gl.vertex_attrib_pointer(0, 2, gl.FLOAT, 0, 20, 0usize as *const u8)
        gl.enable_vertex_attrib_array(0)
        gl.vertex_attrib_pointer(1, 3, gl.FLOAT, 0, 20, 8usize as *const u8)
        gl.enable_vertex_attrib_array(1)
        return program
    }
}

// Clear the window's framebuffer and draw the triangle turned by `angle`
// radians, keeping its shape whatever the window's proportions.
fn draw(program: u32, width: u32, height: u32, angle: f32) {
    sx := 1.0f32
    sy := 1.0f32
    if width > height {
        sx = height as f32 / width as f32
    } else {
        sy = width as f32 / height as f32
    }
    unsafe {
        gl.bind_framebuffer(gl.FRAMEBUFFER, 0)
        gl.viewport(0, 0, width as i32, height as i32)
        gl.clear_color(0.11, 0.13, 0.19, 1.0)
        gl.clear(gl.COLOR_BUFFER_BIT)
        gl.use_program(program)
        gl.uniform_1f(gl.get_uniform_location(program, ptr.as_ptr(b"angle\0")), angle)
        gl.uniform_2f(gl.get_uniform_location(program, ptr.as_ptr(b"aspect\0")), sx, sy)
        gl.draw_arrays(gl.TRIANGLES, 0, 3)
    }
}

fn run() -> void!opengl.Error {
    app := match window.App.new() {
        ok(app) => app,
        err(_) => {
            return err(opengl.Error.NoDisplay)
        }
    }
    win := match app.open(window.Options.gpu("OpenGL", WIDTH, HEIGHT)) {
        ok(win) => win,
        err(_) => {
            return err(opengl.Error.NoDisplay)
        }
    }
    native := match win.native_handle() {
        ok(native) => native,
        err(_) => {
            return err(opengl.Error.NoDisplay)
        }
    }
    // Declared after the window, so it is dropped before it.
    context := opengl.Context.create_for_window(&native, opengl.Options.default())?
    match win.set_title(context.renderer()) {
        ok() => {}
        err(_) => {}
    }
    // Swaps wait for the display; Frame events pace the drawing too.
    match context.set_swap_interval(1) {
        ok() => {}
        err(_) => {}
    }
    program := setup()
    // Radians per second, advanced by the display's refresh period.
    period := win.frame_interval()
    step := 1.2f32 * (period.seconds() as f32 + period.subsec_nanos() as f32 / 1000000000.0)
    angle := 0.0f32
    win.request_frame()!
    for {
        event := match app.wait_event() {
            ok(event) => event,
            err(_) => {
                return ok()
            }
        }
        match event {
            window.Event.Close(_) | window.Event.Quit => {
                return ok()
            }
            window.Event.Key(_, key) => {
                if key.key == window.Key.Escape {
                    return ok()
                }
            }
            window.Event.Resize(_, _, _) => {
                context.update_surface()
            }
            window.Event.Frame(_) => {
                draw(program, win.width(), win.height(), angle)
                context.swap_buffers()?
                angle += step
                win.request_frame()!
            }
            _ => {}
        }
    }
}

fn main() {
    match run() {
        ok() => {}
        err(error) => {
            core.assert(false, opengl.error_name(error))
        }
    }
}
