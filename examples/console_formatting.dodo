package console_formatting

import "std/console"
import "std/fmt"
import "std/io"

fn run() -> void!io.Error {
    console.print("The answer is ")?
    answer := fmt.signed(42)
    console.println_value(&answer)?
    enabled := fmt.boolean(true)
    console.println_value(&enabled)?
    fraction := fmt.floating(1.25)
    console.println_value(&fraction)?
    return ok()
}
fn main() -> i32 {
    match run() {
        ok() => {
            return 0
        }
        err(_) => {
            return 1
        }
    }
}
