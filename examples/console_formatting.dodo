package console_formatting

import "std/console"
import "std/io"

fn run() -> void!io.Error {
    console.printf("Answer: {}, enabled: {}\n", 42, true)?
    console.println(1.25)?
    return ok()
}
fn main() -> i32 {
    match run() {
        ok() => {
            return 0
        }
        err(_) => {
            return 1
        }
    }
}
