    0x0004003d, 0x00000011, 0x00000026, 0x00000025, 0x0004003d, 0x00000006,
    0x0000002b, 0x00000008, 0x00060041, 0x0000002c, 0x0000002d, 0x0000002a,
    0x00000022, 0x0000002b, 0x0004003d, 0x00000011, 0x0000002e, 0x0000002d,
    0x00050085, 0x00000011, 0x0000002f, 0x00000026, 0x0000002e, 0x0004003d,
    0x00000006, 0x00000030, 0x00000008, 0x00060041, 0x0000002c, 0x00000031,
    0x00000021, 0x00000022, 0x00000030, 0x0004003d, 0x00000011, 0x00000032,
    0x00000031, 0x00050081, 0x00000011, 0x00000033, 0x0000002f, 0x00000032,
    0x00060041, 0x0000002c, 0x00000034, 0x00000021, 0x00000022, 0x00000023,
    0x0003003e, 0x00000034, 0x00000033, 0x000200f9, 0x0000001d, 0x000200f8,
    0x0000001d, 0x000100fd, 0x00010038,
]

fn main() -> i32 {
    device := match gpu.Device.open(gpu.Options.default()) {
        ok(device) => device,
        err(error) => {
            console.println(gpu.error_name(error))!
            return 2
        }
    }
    api := device.api()
    console.printf("{}: {}\n", gpu.api_name(&api), device.name())!
    match run(&device) {
        ok(correct) => {
            console.printf("{} of {} values correct\n", correct, COUNT)!
            if correct != COUNT {
                return 1
            }
            console.println("compute ok")!
            return 0
        }
        err(error) => {
            console.println(gpu.error_name(error))!
            return 1
        }
    }
}

fn run(device: &gpu.Device) -> u32!gpu.Error {
    xs := [0.0f32; 1000]
    ys := [0.0f32; 1000]
    for i in 0usize..1000 {
        xs[i] = i as f32
        ys[i] = 1.0
    }
    a := [A]
    count := [COUNT]
    params := device.create_buffer(16, gpu.BUFFER_UNIFORM | gpu.BUFFER_COPY_DST)?
    device.write_buffer(&params, 0, gpu.f32_bytes(&a))?
    device.write_buffer(&params, 4, gpu.u32_bytes(&count))?
    x := device.create_buffer_with_data(gpu.f32_bytes(&xs), gpu.BUFFER_STORAGE)?
    y := device.create_buffer_with_data(gpu.f32_bytes(&ys), gpu.BUFFER_STORAGE | gpu.BUFFER_COPY_SRC)?

    source := gpu.ShaderSource { spirv: &SPIRV, msl: MSL, glsl: GLSL }
    bindings := [
        gpu.BindingLayout.uniform_buffer(0, gpu.STAGE_COMPUTE),
        gpu.BindingLayout.read_only_storage_buffer(1, gpu.STAGE_COMPUTE),
        gpu.BindingLayout.storage_buffer(2, gpu.STAGE_COMPUTE),
    ]
    descriptor := gpu.ComputePipelineDescriptor.new(&source, "saxpy", 64, 1, 1)
    descriptor.bindings = &bindings
    pipeline := device.create_compute_pipeline(descriptor)?

    encoder := device.encoder()?
    {
        pass := encoder.compute_pass()
        pass.set_pipeline(&pipeline)
        pass.set_buffer(0, &params)
        pass.set_buffer(1, &x)
        pass.set_buffer(2, &y)
        pass.dispatch((COUNT + 63) / 64, 1, 1)
    }
    encoder.submit()?

    result := [0.0f32; 1000]
    device.read_buffer(&y, 0, gpu.f32_bytes_mut(&mut result))?
    correct := 0u32
    for i in 0usize..1000 {
        if result[i] == A * i as f32 + 1.0 {
            correct += 1
        }
    }
    return ok(correct)
}
