package main

import "std/console"
import "std/gpu"

// y = a * x + y on the GPU with std/gpu, on whichever API the machine has:
// Metal on macOS, Vulkan on Linux and Windows, OpenGL 4.5 without Vulkan.
//
// The kernel exists in each backend's language. GLSL, used as is by OpenGL
// and compiled to the SPIR-V below for Vulkan with
// `glslangValidator -V -S comp -e saxpy --source-entrypoint main`:
//
//     #version 450
//     layout(local_size_x = 64) in;
//     layout(std140, binding = 0) uniform Params { float a; uint count; };
//     layout(std430, binding = 1) readonly buffer X { float x[]; };
//     layout(std430, binding = 2) buffer Y { float y[]; };
//     void main() {
//         uint i = gl_GlobalInvocationID.x;
//         if (i < count) {
//             y[i] = a * x[i] + y[i];
//         }
//     }
//
// Metal Shading Language, compiled by Metal when the pipeline is created:
//
//     #include <metal_stdlib>
//     using namespace metal;
//     struct Params { float a; uint count; };
//     kernel void saxpy(constant Params &params [[buffer(0)]], device const float *x [[buffer(1)]], device float *y [[buffer(2)]], uint i [[thread_position_in_grid]]) {
//         if (i < params.count) {
//             y[i] = params.a * x[i] + y[i];
//         }
//     }
//
// Exits 0 when every value is right, 2 when the machine has no usable GPU.

const COUNT: u32 = 1000
const A: f32 = 2.5

const GLSL: &str = "#version 450\nlayout(local_size_x = 64) in;\nlayout(std140, binding = 0) uniform Params { float a; uint count; };\nlayout(std430, binding = 1) readonly buffer X { float x[]; };\nlayout(std430, binding = 2) buffer Y { float y[]; };\nvoid main() {\n    uint i = gl_GlobalInvocationID.x;\n    if (i < count) {\n        y[i] = a * x[i] + y[i];\n    }\n}\n"
const MSL: &str = "#include <metal_stdlib>\nusing namespace metal;\nstruct Params { float a; uint count; };\nkernel void saxpy(constant Params &params [[buffer(0)]], device const float *x [[buffer(1)]], device float *y [[buffer(2)]], uint i [[thread_position_in_grid]]) {\n    if (i < params.count) {\n        y[i] = params.a * x[i] + y[i];\n    }\n}\n"
const SPIRV: [393]u32 = [
    0x07230203, 0x00010500, 0x0008000b, 0x00000038, 0x00000000, 0x00020011,
    0x00000001, 0x0006000b, 0x00000001, 0x4c534c47, 0x6474732e, 0x3035342e,
    0x00000000, 0x0003000e, 0x00000000, 0x00000001, 0x0009000f, 0x00000005,
    0x00000004, 0x70786173, 0x00000079, 0x0000000b, 0x00000014, 0x00000021,
    0x0000002a, 0x00060010, 0x00000004, 0x00000011, 0x00000040, 0x00000001,
    0x00000001, 0x00030003, 0x00000002, 0x000001c2, 0x00040005, 0x00000004,
    0x70786173, 0x00000079, 0x00030005, 0x00000008, 0x00000069, 0x00080005,
    0x0000000b, 0x475f6c67, 0x61626f6c, 0x766e496c, 0x7461636f, 0x496e6f69,
    0x00000044, 0x00040005, 0x00000012, 0x61726150, 0x0000736d, 0x00040006,
    0x00000012, 0x00000000, 0x00000061, 0x00050006, 0x00000012, 0x00000001,
    0x6e756f63, 0x00000074, 0x00030005, 0x00000014, 0x00000000, 0x00030005,
    0x0000001f, 0x00000059, 0x00040006, 0x0000001f, 0x00000000, 0x00000079,
    0x00030005, 0x00000021, 0x00000000, 0x00030005, 0x00000028, 0x00000058,
    0x00040006, 0x00000028, 0x00000000, 0x00000078, 0x00030005, 0x0000002a,
    0x00000000, 0x00040047, 0x0000000b, 0x0000000b, 0x0000001c, 0x00030047,
    0x00000012, 0x00000002, 0x00050048, 0x00000012, 0x00000000, 0x00000023,
    0x00000000, 0x00050048, 0x00000012, 0x00000001, 0x00000023, 0x00000004,
    0x00040047, 0x00000014, 0x00000021, 0x00000000, 0x00040047, 0x00000014,
    0x00000022, 0x00000000, 0x00040047, 0x0000001e, 0x00000006, 0x00000004,
    0x00030047, 0x0000001f, 0x00000002, 0x00050048, 0x0000001f, 0x00000000,
    0x00000023, 0x00000000, 0x00040047, 0x00000021, 0x00000021, 0x00000002,
    0x00040047, 0x00000021, 0x00000022, 0x00000000, 0x00040047, 0x00000027,
    0x00000006, 0x00000004, 0x00030047, 0x00000028, 0x00000002, 0x00040048,
    0x00000028, 0x00000000, 0x00000018, 0x00050048, 0x00000028, 0x00000000,
    0x00000023, 0x00000000, 0x00030047, 0x0000002a, 0x00000018, 0x00040047,
    0x0000002a, 0x00000021, 0x00000001, 0x00040047, 0x0000002a, 0x00000022,
    0x00000000, 0x00040047, 0x00000037, 0x0000000b, 0x00000019, 0x00020013,
    0x00000002, 0x00030021, 0x00000003, 0x00000002, 0x00040015, 0x00000006,
    0x00000020, 0x00000000, 0x00040020, 0x00000007, 0x00000007, 0x00000006,
    0x00040017, 0x00000009, 0x00000006, 0x00000003, 0x00040020, 0x0000000a,
    0x00000001, 0x00000009, 0x0004003b, 0x0000000a, 0x0000000b, 0x00000001,
    0x0004002b, 0x00000006, 0x0000000c, 0x00000000, 0x00040020, 0x0000000d,
    0x00000001, 0x00000006, 0x00030016, 0x00000011, 0x00000020, 0x0004001e,
    0x00000012, 0x00000011, 0x00000006, 0x00040020, 0x00000013, 0x00000002,
    0x00000012, 0x0004003b, 0x00000013, 0x00000014, 0x00000002, 0x00040015,
    0x00000015, 0x00000020, 0x00000001, 0x0004002b, 0x00000015, 0x00000016,
    0x00000001, 0x00040020, 0x00000017, 0x00000002, 0x00000006, 0x00020014,
    0x0000001a, 0x0003001d, 0x0000001e, 0x00000011, 0x0003001e, 0x0000001f,
    0x0000001e, 0x00040020, 0x00000020, 0x0000000c, 0x0000001f, 0x0004003b,
    0x00000020, 0x00000021, 0x0000000c, 0x0004002b, 0x00000015, 0x00000022,
