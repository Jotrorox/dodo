package main

import "core/ptr"
import "std/console"
import "std/text"
import "std/gpu/vulkan" as vk

// Run a compute shader on the first Vulkan device with std/gpu/vulkan.
//
// The shader (GLSL below, compiled to SPIR-V with glslangValidator) updates
// a storage buffer in place: values[i] = values[i] * factor + i.
//
//     #version 450
//     layout(local_size_x = 64) in;
//     layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
//     layout(push_constant) uniform Push { uint count; uint factor; };
//     void main() {
//         uint i = gl_GlobalInvocationID.x;
//         if (i < count) {
//             values[i] = values[i] * factor + i;
//         }
//     }
//
// Every Vulkan call is unsafe, as in C: the program upholds the
// specification's valid-usage rules itself. Without a Vulkan driver the
// program reports that and exits with status 2.

const COUNT: u32 = 1000
const FACTOR: u32 = 3

const SHADER: [281]u32 = [
    0x07230203, 0x00010000, 0x0008000b, 0x00000030, 0x00000000, 0x00020011,
    0x00000001, 0x0006000b, 0x00000001, 0x4c534c47, 0x6474732e, 0x3035342e,
    0x00000000, 0x0003000e, 0x00000000, 0x00000001, 0x0006000f, 0x00000005,
    0x00000004, 0x6e69616d, 0x00000000, 0x0000000b, 0x00060010, 0x00000004,
    0x00000011, 0x00000040, 0x00000001, 0x00000001, 0x00030003, 0x00000002,
    0x000001c2, 0x00040005, 0x00000004, 0x6e69616d, 0x00000000, 0x00080005,
    0x0000000b, 0x475f6c67, 0x61626f6c, 0x766e496c, 0x7461636f, 0x496e6f69,
    0x00000044, 0x00040005, 0x00000011, 0x68737550, 0x00000000, 0x00050006,
    0x00000011, 0x00000000, 0x6e756f63, 0x00000074, 0x00050006, 0x00000011,
    0x00000001, 0x74636166, 0x0000726f, 0x00030005, 0x00000013, 0x00000000,
    0x00040005, 0x0000001e, 0x61746144, 0x00000000, 0x00050006, 0x0000001e,
    0x00000000, 0x756c6176, 0x00007365, 0x00030005, 0x00000020, 0x00000000,
    0x00040047, 0x0000000b, 0x0000000b, 0x0000001c, 0x00030047, 0x00000011,
    0x00000002, 0x00050048, 0x00000011, 0x00000000, 0x00000023, 0x00000000,
    0x00050048, 0x00000011, 0x00000001, 0x00000023, 0x00000004, 0x00040047,
    0x0000001d, 0x00000006, 0x00000004, 0x00030047, 0x0000001e, 0x00000003,
    0x00050048, 0x0000001e, 0x00000000, 0x00000023, 0x00000000, 0x00040047,
    0x00000020, 0x00000021, 0x00000000, 0x00040047, 0x00000020, 0x00000022,
    0x00000000, 0x00040047, 0x0000002f, 0x0000000b, 0x00000019, 0x00020013,
    0x00000002, 0x00030021, 0x00000003, 0x00000002, 0x00040015, 0x00000006,
    0x00000020, 0x00000000, 0x00040017, 0x00000009, 0x00000006, 0x00000003,
    0x00040020, 0x0000000a, 0x00000001, 0x00000009, 0x0004003b, 0x0000000a,
    0x0000000b, 0x00000001, 0x0004002b, 0x00000006, 0x0000000c, 0x00000000,
    0x00040020, 0x0000000d, 0x00000001, 0x00000006, 0x0004001e, 0x00000011,
    0x00000006, 0x00000006, 0x00040020, 0x00000012, 0x00000009, 0x00000011,
    0x0004003b, 0x00000012, 0x00000013, 0x00000009, 0x00040015, 0x00000014,
    0x00000020, 0x00000001, 0x0004002b, 0x00000014, 0x00000015, 0x00000000,
    0x00040020, 0x00000016, 0x00000009, 0x00000006, 0x00020014, 0x00000019,
    0x0003001d, 0x0000001d, 0x00000006, 0x0003001e, 0x0000001e, 0x0000001d,
    0x00040020, 0x0000001f, 0x00000002, 0x0000001e, 0x0004003b, 0x0000001f,
    0x00000020, 0x00000002, 0x00040020, 0x00000023, 0x00000002, 0x00000006,
    0x0004002b, 0x00000014, 0x00000026, 0x00000001, 0x0004002b, 0x00000006,
    0x0000002d, 0x00000040, 0x0004002b, 0x00000006, 0x0000002e, 0x00000001,
    0x0006002c, 0x00000009, 0x0000002f, 0x0000002d, 0x0000002e, 0x0000002e,
    0x00050036, 0x00000002, 0x00000004, 0x00000000, 0x00000003, 0x000200f8,
    0x00000005, 0x00050041, 0x0000000d, 0x0000000e, 0x0000000b, 0x0000000c,
    0x0004003d, 0x00000006, 0x0000000f, 0x0000000e, 0x00050041, 0x00000016,
    0x00000017, 0x00000013, 0x00000015, 0x0004003d, 0x00000006, 0x00000018,
    0x00000017, 0x000500b0, 0x00000019, 0x0000001a, 0x0000000f, 0x00000018,
    0x000300f7, 0x0000001c, 0x00000000, 0x000400fa, 0x0000001a, 0x0000001b,
    0x0000001c, 0x000200f8, 0x0000001b, 0x00060041, 0x00000023, 0x00000024,
    0x00000020, 0x00000015, 0x0000000f, 0x0004003d, 0x00000006, 0x00000025,
    0x00000024, 0x00050041, 0x00000016, 0x00000027, 0x00000013, 0x00000026,
    0x0004003d, 0x00000006, 0x00000028, 0x00000027, 0x00050084, 0x00000006,
    0x00000029, 0x00000025, 0x00000028, 0x00050080, 0x00000006, 0x0000002b,
    0x00000029, 0x0000000f, 0x0003003e, 0x00000024, 0x0000002b, 0x000200f9,
    0x0000001c, 0x000200f8, 0x0000001c, 0x000100fd, 0x00010038,
]

fn main() -> i32 {
    library := match vk.open() {
        ok(library) => library,
        err(error) => {
            console.println(vk.load_error_name(error))!
            return 2
        }
    }
    match run(&library) {
        ok() => {
            console.println("compute ok")!
            return 0
        }
        err(error) => {
            console.println(error.name())!
            return 1
        }
    }
}

fn run(library: &vk.Library) -> void!vk.Error {
    entry := library.entry()
    alloc := vk.no_allocator()

    // MoltenVK is a portability driver: the loader lists it only for
    // instances that enable VK_KHR_portability_enumeration.
    extensions := unsafe {
        vk.zeroed::<[64]vk.ExtensionProperties>()
    }
    extension_count := 64u32
    unsafe {
        vk.check(entry.enumerate_instance_extension_properties(0usize as *const u8, ptr.from_mut(&mut extension_count), ptr.as_mut_ptr(&mut extensions)))?
    }
    portability := false
    for i in 0usize..extension_count as usize {
        if vk.name_eq(&extensions[i].extension_name, vk.KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME) {
            portability = true
        }
    }
    enabled := [ptr.as_ptr(vk.KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME)]

    app := vk.ApplicationInfo.default()
    app.p_application_name = ptr.as_ptr(b"dodo vulkan compute\0")
    app.api_version = vk.API_VERSION_1_1
    instance_info := vk.InstanceCreateInfo.default()
    instance_info.p_application_info = ptr.from_ref(&app)
    if portability {
        instance_info.flags = vk.INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR
        instance_info.enabled_extension_count = 1
        instance_info.pp_enabled_extension_names = ptr.as_ptr(&enabled)
    }
    instance := vk.null_handle::<vk.InstanceT>()
    unsafe {
        vk.check(entry.create_instance(ptr.from_ref(&instance_info), alloc, ptr.from_mut(&mut instance)))?
    }
    fns := unsafe {
        library.instance(instance)
    }

    devices := [vk.null_handle::<vk.PhysicalDeviceT>(); 8]
    device_count := 8u32
    unsafe {
        vk.check(fns.enumerate_physical_devices(instance, ptr.from_mut(&mut device_count), ptr.as_mut_ptr(&mut devices)))?
    }
    if device_count == 0 {
        return err(vk.Error { code: vk.ERROR_INITIALIZATION_FAILED })
    }
    physical := devices[0]
    properties := vk.PhysicalDeviceProperties.default()
    unsafe {
        fns.get_physical_device_properties(physical, ptr.from_mut(&mut properties))
    }
    match text.Text.new(vk.c_name(&properties.device_name)) {
        ok(name) => {
            console.printf("device: {}\n", name.as_str())!
        }
        err(_) => {}
    }

    families := unsafe {
        vk.zeroed::<[16]vk.QueueFamilyProperties>()
    }
    family_count := 16u32
    unsafe {
        fns.get_physical_device_queue_family_properties(physical, ptr.from_mut(&mut family_count), ptr.as_mut_ptr(&mut families))
    }
    family := family_count
    for i in 0u32..family_count {
        if family == family_count && (families[i as usize].queue_flags & vk.QUEUE_COMPUTE_BIT) != 0 {
            family = i
        }
    }
    if family == family_count {
        return err(vk.Error { code: vk.ERROR_FEATURE_NOT_PRESENT })
    }

    priority := [1.0f32]
    queue_info := vk.DeviceQueueCreateInfo.default()
    queue_info.queue_family_index = family
    queue_info.queue_count = 1
    queue_info.p_queue_priorities = ptr.as_ptr(&priority)
    device_info := vk.DeviceCreateInfo.default()
    device_info.queue_create_info_count = 1
    device_info.p_queue_create_infos = ptr.from_ref(&queue_info)
    device := vk.null_handle::<vk.DeviceT>()
    unsafe {
        vk.check(fns.create_device(physical, ptr.from_ref(&device_info), alloc, ptr.from_mut(&mut device)))?
    }
    d := unsafe {
        vk.device_fns(&fns, device)
    }
    queue := vk.null_handle::<vk.QueueT>()
    unsafe {
        d.get_device_queue(device, family, 0, ptr.from_mut(&mut queue))
    }

    // A host-visible storage buffer holding COUNT u32 values.
    size := (COUNT * 4) as u64
    buffer_info := vk.BufferCreateInfo.default()
    buffer_info.size = size
    buffer_info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT
    buffer_info.sharing_mode = vk.SHARING_MODE_EXCLUSIVE
    buffer := vk.NULL_HANDLE
    unsafe {
        vk.check(d.create_buffer(device, ptr.from_ref(&buffer_info), alloc, ptr.from_mut(&mut buffer)))?
    }
    requirements := vk.MemoryRequirements.default()
    unsafe {
        d.get_buffer_memory_requirements(device, buffer, ptr.from_mut(&mut requirements))
    }
    memory_properties := vk.PhysicalDeviceMemoryProperties.default()
    unsafe {
        fns.get_physical_device_memory_properties(physical, ptr.from_mut(&mut memory_properties))
    }
    wanted := vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT
    memory_type := memory_properties.memory_type_count
    for i in 0u32..memory_properties.memory_type_count {
        flags := memory_properties.memory_types[i as usize].property_flags
        if memory_type == memory_properties.memory_type_count && (requirements.memory_type_bits >> i & 1) != 0 && (flags & wanted) == wanted {
            memory_type = i
        }
    }
    if memory_type == memory_properties.memory_type_count {
        return err(vk.Error { code: vk.ERROR_OUT_OF_DEVICE_MEMORY })
    }
    allocate_info := vk.MemoryAllocateInfo.default()
    allocate_info.allocation_size = requirements.size
    allocate_info.memory_type_index = memory_type
    memory := vk.NULL_HANDLE
    mapped := vk.null_handle::<u8>()
    unsafe {
        vk.check(d.allocate_memory(device, ptr.from_ref(&allocate_info), alloc, ptr.from_mut(&mut memory)))?
        vk.check(d.bind_buffer_memory(device, buffer, memory, 0))?
        vk.check(d.map_memory(device, memory, 0, size, 0, ptr.from_mut(&mut mapped)))?
    }
    values := unsafe {
        mapped as *mut u32
    }
    for i in 0u32..COUNT {
        unsafe {
            ptr.write(ptr.offset(values, i as isize), i + 1)
        }
    }

    // The pipeline: one storage buffer binding and two push-constant words.
    shader_info := vk.ShaderModuleCreateInfo.default()
    shader_info.code_size = SHADER.len * 4
    shader_info.p_code = ptr.as_ptr(&SHADER)
    shader := vk.NULL_HANDLE
    unsafe {
        vk.check(d.create_shader_module(device, ptr.from_ref(&shader_info), alloc, ptr.from_mut(&mut shader)))?
    }
    binding := vk.DescriptorSetLayoutBinding.default()
    binding.binding = 0
    binding.descriptor_type = vk.DESCRIPTOR_TYPE_STORAGE_BUFFER
    binding.descriptor_count = 1
    binding.stage_flags = vk.SHADER_STAGE_COMPUTE_BIT
    set_layout_info := vk.DescriptorSetLayoutCreateInfo.default()
    set_layout_info.binding_count = 1
    set_layout_info.p_bindings = ptr.from_ref(&binding)
    set_layout := vk.NULL_HANDLE
    unsafe {
        vk.check(d.create_descriptor_set_layout(device, ptr.from_ref(&set_layout_info), alloc, ptr.from_mut(&mut set_layout)))?
    }
    push_range := vk.PushConstantRange.default()
    push_range.stage_flags = vk.SHADER_STAGE_COMPUTE_BIT
    push_range.size = 8
    layout_info := vk.PipelineLayoutCreateInfo.default()
    layout_info.set_layout_count = 1
    layout_info.p_set_layouts = ptr.from_ref(&set_layout)
    layout_info.push_constant_range_count = 1
    layout_info.p_push_constant_ranges = ptr.from_ref(&push_range)
    layout := vk.NULL_HANDLE
    unsafe {
        vk.check(d.create_pipeline_layout(device, ptr.from_ref(&layout_info), alloc, ptr.from_mut(&mut layout)))?
    }
    stage := vk.PipelineShaderStageCreateInfo.default()
    stage.stage = vk.SHADER_STAGE_COMPUTE_BIT
    stage.module = shader
    stage.p_name = ptr.as_ptr(b"main\0")
    pipeline_info := vk.ComputePipelineCreateInfo.default()
    pipeline_info.stage = stage
    pipeline_info.layout = layout
    pipeline := vk.NULL_HANDLE
    unsafe {
        vk.check(d.create_compute_pipelines(device, vk.NULL_HANDLE, 1, ptr.from_ref(&pipeline_info), alloc, ptr.from_mut(&mut pipeline)))?
    }

    pool_size := vk.DescriptorPoolSize.default()
    pool_size.type_ = vk.DESCRIPTOR_TYPE_STORAGE_BUFFER
    pool_size.descriptor_count = 1
    pool_info := vk.DescriptorPoolCreateInfo.default()
    pool_info.max_sets = 1
    pool_info.pool_size_count = 1
    pool_info.p_pool_sizes = ptr.from_ref(&pool_size)
    descriptor_pool := vk.NULL_HANDLE
    unsafe {
        vk.check(d.create_descriptor_pool(device, ptr.from_ref(&pool_info), alloc, ptr.from_mut(&mut descriptor_pool)))?
    }
    set_info := vk.DescriptorSetAllocateInfo.default()
    set_info.descriptor_pool = descriptor_pool
    set_info.descriptor_set_count = 1
    set_info.p_set_layouts = ptr.from_ref(&set_layout)
    set := vk.NULL_HANDLE
    unsafe {
        vk.check(d.allocate_descriptor_sets(device, ptr.from_ref(&set_info), ptr.from_mut(&mut set)))?
    }
    buffer_binding := vk.DescriptorBufferInfo.default()
    buffer_binding.buffer = buffer
    buffer_binding.range = vk.WHOLE_SIZE
    write := vk.WriteDescriptorSet.default()
    write.dst_set = set
    write.descriptor_count = 1
    write.descriptor_type = vk.DESCRIPTOR_TYPE_STORAGE_BUFFER
    write.p_buffer_info = ptr.from_ref(&buffer_binding)
    unsafe {
        d.update_descriptor_sets(device, 1, ptr.from_ref(&write), 0, 0usize as *const vk.CopyDescriptorSet)
    }

    // Record, submit and wait.
    command_pool_info := vk.CommandPoolCreateInfo.default()
    command_pool_info.queue_family_index = family
    command_pool := vk.NULL_HANDLE
    unsafe {
        vk.check(d.create_command_pool(device, ptr.from_ref(&command_pool_info), alloc, ptr.from_mut(&mut command_pool)))?
    }
    command_info := vk.CommandBufferAllocateInfo.default()
    command_info.command_pool = command_pool
    command_info.level = vk.COMMAND_BUFFER_LEVEL_PRIMARY
    command_info.command_buffer_count = 1
    commands := vk.null_handle::<vk.CommandBufferT>()
    begin := vk.CommandBufferBeginInfo.default()
    begin.flags = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
    push := [COUNT, FACTOR]
    unsafe {
        vk.check(d.allocate_command_buffers(device, ptr.from_ref(&command_info), ptr.from_mut(&mut commands)))?
        vk.check(d.begin_command_buffer(commands, ptr.from_ref(&begin)))?
        d.cmd_bind_pipeline(commands, vk.PIPELINE_BIND_POINT_COMPUTE, pipeline)
        d.cmd_bind_descriptor_sets(commands, vk.PIPELINE_BIND_POINT_COMPUTE, layout, 0, 1, ptr.from_ref(&set), 0, 0usize as *const u32)
        d.cmd_push_constants(commands, layout, vk.SHADER_STAGE_COMPUTE_BIT, 0, 8, ptr.as_ptr(&push) as *const u8)
        d.cmd_dispatch(commands, (COUNT + 63) / 64, 1, 1)
        vk.check(d.end_command_buffer(commands))?
    }
    fence_info := vk.FenceCreateInfo.default()
    fence := vk.NULL_HANDLE
    submit := vk.SubmitInfo.default()
    submit.command_buffer_count = 1
    submit.p_command_buffers = ptr.from_ref(&commands)
    unsafe {
        vk.check(d.create_fence(device, ptr.from_ref(&fence_info), alloc, ptr.from_mut(&mut fence)))?
        vk.check(d.queue_submit(queue, 1, ptr.from_ref(&submit), fence))?
        vk.check(d.wait_for_fences(device, 1, ptr.from_ref(&fence), vk.TRUE, 0xffffffffffffffff))?
    }

    mismatches := 0u32
    for i in 0u32..COUNT {
        value := unsafe {
            ptr.read(ptr.offset(values, i as isize))
        }
        if value != (i + 1) * FACTOR + i {
            mismatches += 1
        }
    }
    console.printf("{} of {} values correct\n", COUNT - mismatches, COUNT)!

    unsafe {
        d.destroy_fence(device, fence, alloc)
        d.destroy_command_pool(device, command_pool, alloc)
        d.destroy_descriptor_pool(device, descriptor_pool, alloc)
        d.destroy_pipeline(device, pipeline, alloc)
        d.destroy_pipeline_layout(device, layout, alloc)
        d.destroy_descriptor_set_layout(device, set_layout, alloc)
        d.destroy_shader_module(device, shader, alloc)
        d.unmap_memory(device, memory)
        d.free_memory(device, memory, alloc)
        d.destroy_buffer(device, buffer, alloc)
        d.destroy_device(device, alloc)
        fns.destroy_instance(instance, alloc)
    }
    if mismatches != 0 {
        return err(vk.Error { code: vk.ERROR_UNKNOWN })
    }
    return ok()
}
