    0x00000002, 0x00000004, 0x00000000, 0x00000003, 0x000200f8, 0x00000005,
    0x0004003d, 0x00000007, 0x0000000c, 0x0000000b, 0x0003003e, 0x00000009,
    0x0000000c, 0x000100fd, 0x00010038,
]

// Room for the window at up to twice the size on high-density displays.
static mut FRAME: [2457600]u8 = [0; 2457600]

fn run() -> void!gpu.Error {
    device := gpu.Device.open(gpu.Options.default())?
    api := device.api()
    console.printf("{}: {}\n", gpu.api_name(&api), device.name())!
    win := match window.open(window.Options { title: "std/gpu", width: WIDTH, height: HEIGHT, resizable: false }) {
        ok(win) => win,
        err(error) => {
            console.println(window.error_name(error))!
            return ok()
        }
    }
    // The canvas has scale() times more pixels per side than the window.
    scale := win.scale()
    if scale > 2 {
        scale = 2
    }
    width := WIDTH * scale
    height := HEIGHT * scale

    // BGRA is the layout of a window canvas, so frames copy straight in.
    target := device.create_texture(gpu.TextureDescriptor.new(width, height, gpu.FORMAT_BGRA8_UNORM, gpu.TEXTURE_RENDER | gpu.TEXTURE_COPY_SRC))?
    positions := [-0.6f32, -0.5, 0.6, -0.5, 0.0, 0.6]
    colors := [0xff3366ffu32, 0xff66e633, 0xffff6633]
    position_buffer := device.create_buffer_with_data(gpu.f32_bytes(&positions), gpu.BUFFER_VERTEX)?
    color_buffer := device.create_buffer_with_data(gpu.u32_bytes(&colors), gpu.BUFFER_VERTEX)?
    frame_data := device.create_buffer(16, gpu.BUFFER_UNIFORM | gpu.BUFFER_COPY_DST)?

    vertex := gpu.ShaderSource { spirv: &VERTEX_SPIRV, msl: MSL, glsl: GLSL }
    fragment := gpu.ShaderSource { spirv: &FRAGMENT_SPIRV, msl: MSL, glsl: GLSL }
    position_attributes := [gpu.VertexAttribute.new(0, gpu.VERTEX_FLOAT32X2, 0)]
    color_attributes := [gpu.VertexAttribute.new(1, gpu.VERTEX_UNORM8X4, 0)]
    layouts := [gpu.VertexBufferLayout.new(8, &position_attributes), gpu.VertexBufferLayout.new(4, &color_attributes)]
    bindings := [gpu.BindingLayout.uniform_buffer(0, gpu.STAGE_VERTEX)]
    descriptor := gpu.RenderPipelineDescriptor.new(&vertex, "turn", &fragment, "paint", gpu.FORMAT_BGRA8_UNORM)
    descriptor.vertex_buffers = &layouts
    descriptor.bindings = &bindings
    pipeline := device.create_render_pipeline(descriptor)?

    frame := unsafe {
        &mut FRAME[..(width * height * 4) as usize]
    }
    angle := 0.0f32
    for {
        match win.wait_event_until_frame() {
            ok(some(window.Event.Close)) => {
                return ok()
            }
            ok(some(window.Event.Key(key))) => {
                if key.key == window.Key.Escape {
                    return ok()
                }
            }
            ok(some(_)) => {}
            ok(none) => {
                values := [angle, WIDTH as f32 / HEIGHT as f32]
                device.write_buffer(&frame_data, 0, gpu.f32_bytes(&values))?
                encoder := device.encoder()?
                {
                    pass := encoder.render_pass(gpu.ColorAttachment.clear(&target, 0.11, 0.13, 0.19, 1.0))
                    pass.set_pipeline(&pipeline)
                    pass.set_buffer(0, &frame_data)
                    pass.set_vertex_buffer(0, &position_buffer, 0)
                    pass.set_vertex_buffer(1, &color_buffer, 0)
                    pass.draw(3, 1, 0, 0)
                }
                encoder.submit()?
                device.read_texture(&target, target.region(), frame, target.bytes_per_row())?
                image := graphics.Canvas.new(frame, width, height, graphics.PixelFormat.Bgra8888)!
                canvas := win.canvas()
                canvas.blit(&image, 0, 0)
                dirty := canvas.take_dirty()
                win.update(dirty)!
                angle += 0.02
            }
            err(_) => {
                return ok()
            }
        }
    }
}

fn main() -> i32 {
    match run() {
        ok() => {
            return 0
        }
        err(error) => {
            console.println(gpu.error_name(error))!
            return 1
        }
    }
}
