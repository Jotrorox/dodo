package main

import "std/console"
import "std/graphics"
import "std/gpu"
import "std/window"

// A spinning triangle drawn with std/gpu and shown in a std/window window.
// The GPU renders each frame into a texture; the frame is read back and
// copied into the window's canvas. Press Escape or close the window to quit.
//
// The shaders, in GLSL for OpenGL and (compiled with glslangValidator -V,
// entry points named turn and paint) SPIR-V for Vulkan:
//
//     #version 450
//     #ifdef VERTEX
//     layout(location = 0) in vec2 position;
//     layout(location = 1) in vec4 color;
//     layout(std140, binding = 0) uniform Frame { float angle; float aspect; };
//     layout(location = 0) out vec4 shade;
//     void main() {
//         float c = cos(angle);
//         float s = sin(angle);
//         vec2 turned = vec2(c * position.x - s * position.y, s * position.x + c * position.y);
//         gl_Position = vec4(turned.x / aspect, turned.y, 0.0, 1.0);
//         shade = color;
//     }
//     #endif
//     #ifdef FRAGMENT
//     layout(location = 0) in vec4 shade;
//     layout(location = 0) out vec4 result;
//     void main() {
//         result = shade;
//     }
//     #endif
//
// and in Metal Shading Language:
//
//     #include <metal_stdlib>
//     using namespace metal;
//     struct Frame { float angle; float aspect; };
//     struct VertexIn { float2 position [[attribute(0)]]; float4 color [[attribute(1)]]; };
//     struct VertexOut { float4 position [[position]]; float4 shade; };
//     vertex VertexOut turn(VertexIn in [[stage_in]], constant Frame &frame [[buffer(0)]]) {
//         float c = cos(frame.angle);
//         float s = sin(frame.angle);
//         float2 turned = float2(c * in.position.x - s * in.position.y, s * in.position.x + c * in.position.y);
//         VertexOut out;
//         out.position = float4(turned.x / frame.aspect, turned.y, 0.0, 1.0);
//         out.shade = in.color;
//         return out;
//     }
//     fragment float4 paint(VertexOut in [[stage_in]]) {
//         return in.shade;
//     }

const WIDTH: u32 = 480
const HEIGHT: u32 = 320

const GLSL: &str = "#version 450\n#ifdef VERTEX\nlayout(location = 0) in vec2 position;\nlayout(location = 1) in vec4 color;\nlayout(std140, binding = 0) uniform Frame { float angle; float aspect; };\nlayout(location = 0) out vec4 shade;\nvoid main() {\n    float c = cos(angle);\n    float s = sin(angle);\n    vec2 turned = vec2(c * position.x - s * position.y, s * position.x + c * position.y);\n    gl_Position = vec4(turned.x / aspect, turned.y, 0.0, 1.0);\n    shade = color;\n}\n#endif\n#ifdef FRAGMENT\nlayout(location = 0) in vec4 shade;\nlayout(location = 0) out vec4 result;\nvoid main() {\n    result = shade;\n}\n#endif\n"
const MSL: &str = "#include <metal_stdlib>\nusing namespace metal;\nstruct Frame { float angle; float aspect; };\nstruct VertexIn { float2 position [[attribute(0)]]; float4 color [[attribute(1)]]; };\nstruct VertexOut { float4 position [[position]]; float4 shade; };\nvertex VertexOut turn(VertexIn in [[stage_in]], constant Frame &frame [[buffer(0)]]) {\n    float c = cos(frame.angle);\n    float s = sin(frame.angle);\n    float2 turned = float2(c * in.position.x - s * in.position.y, s * in.position.x + c * in.position.y);\n    VertexOut out;\n    out.position = float4(turned.x / frame.aspect, turned.y, 0.0, 1.0);\n    out.shade = in.color;\n    return out;\n}\nfragment float4 paint(VertexOut in [[stage_in]]) {\n    return in.shade;\n}\n"
const VERTEX_SPIRV: [484]u32 = [
