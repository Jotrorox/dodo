package web_server
import "std/console"
import "std/web"
import "std/web/hosted"

fn main() -> i32 {
    routes := [web.Route { method: b"GET", pattern: b"/", id: 0 }]
    handler := hosted.Text.new(b"Hello, Dodo!\n")
    workspace := [0u8; hosted.WORKSPACE_BYTES]
    request := [0u8; 4096]
    response := [0u8; 4096]
    config := hosted.Config.defaults()
    config.max_connections = 0 // Serve until externally stopped; tests set a finite count.
    match hosted.serve(b"127.0.0.1:8080", &routes, &mut handler, &mut workspace, &mut request, &mut response, config) {
        ok(report) => {
            if report.failed != 0 {
                return 2
            };
            return 0
        }
        err(reason) => {
            errors := console.stderr()
            match errors.println_value(&reason) {
                ok(_) => {}
                err(_) => {}
            }
            return 1
        }
    }
}
