package ergonomics

struct Source {
    value: i32

    fn decode(&self) -> Source {
        return Source { value: self.value }
    }

    fn validate(self) -> i32 {
        return self.value
    }
}

fn identity<T>(value: T) -> T {
    return value
}

fn main() -> i32 {
    values := [10i32, 14, 18]
    total := 0i32
    // Copy each scalar explicitly; the array remains borrowed during the loop.
    for &value in values {
        total += value
    }

    source := Source { value: total }
    value := source
        .decode()
        .validate()
    return identity::<i32>(value)
}

@test
fn generic_identity_and_method_chains_preserve_values() {
    assert_eq(identity::<u8>(255), 255)
    assert_eq(identity::<bool>(false), false)
    source := Source { value: 42 }
    assert_eq(source.decode().validate(), 42)
    assert_eq(main(), 42)
}
