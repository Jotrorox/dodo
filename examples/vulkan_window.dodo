package main

import "core/mem"
import "core/ptr"
import "std/console"
import "std/env"
import "std/gpu/vulkan" as vk
import "std/platform"
import "std/text"
import "std/window"
import "std/window/handle"

// Draw a spinning triangle with Vulkan straight into a std/window window.
//
// The window has no pixel buffer. Its native handle becomes a Vulkan
// surface: VK_KHR_xcb_surface on Linux, VK_KHR_win32_surface on Windows and
// VK_EXT_metal_surface on macOS (MoltenVK), where win.metal_layer() gives the
// window's view the CAMetalLayer to present to. Frames go through a FIFO
// swapchain that is rebuilt when the window is resized. Press Escape or close
// the window to quit; a number argument stops after that many frames:
//
//     dodo run examples/vulkan_window.dodo
//     dodo run examples/vulkan_window.dodo -- 120
//
// The shaders (GLSL below, compiled to SPIR-V with glslangValidator -V) place
// the corners themselves, so there is no vertex buffer:
//
//     #version 450
//     layout(push_constant) uniform Spin { float angle; vec2 aspect; } spin;
//     layout(location = 0) out vec3 shade;
//     const vec2 corners[3] = vec2[](vec2(-0.6, 0.5), vec2(0.6, 0.5), vec2(0.0, -0.7));
//     const vec3 colors[3] = vec3[](vec3(1.0, 0.3, 0.2), vec3(0.2, 0.9, 0.4), vec3(0.3, 0.4, 1.0));
//     void main() {
//         float c = cos(spin.angle);
//         float s = sin(spin.angle);
//         gl_Position = vec4(mat2(c, s, -s, c) * corners[gl_VertexIndex] * spin.aspect, 0.0, 1.0);
//         shade = colors[gl_VertexIndex];
//     }
//
//     #version 450
//     layout(location = 0) in vec3 shade;
//     layout(location = 0) out vec4 result;
//     void main() {
//         result = vec4(shade, 1.0);
//     }
//
// Every Vulkan call is unsafe, as in C. Without a Vulkan driver the program
// says so and exits with status 2.

// The most swapchain images this program handles.
const IMAGES: usize = 8

