package web_response
import "core/bytes"
import "std/web"
import "std/web/app"

pub struct Greeting {
    pub fn handle(&mut self, request: &mut web.Request, response: &mut web.Response) -> void!web.Failure {
        response.header(b"X-Method", request.method())?
        response.header(b"X-Name", request.param(b"name")?)?
        if bytes.equal(request.query_or(b"format", b"html"), b"json") {
            return response.json(b"{\"hello\":\"Dodo\"}")
        }
        return response.html(b"<!doctype html><h1>Hello, Dodo!</h1>")
    }
}
fn main() -> i32 {
    return app.new()
        .get(b"/hello/:name", Greeting {})
        .get(b"/", web.redirect(b"/hello/Dodo"))
        .run(b"127.0.0.1:8080")
}
