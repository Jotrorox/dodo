package libfuzzer

import "core/ptr"
import "targets"

// The C entry point of the std/image fuzz targets for libFuzzer (see
// fuzz/fuzz_targets/image_*.rs). fuzz/build.rs compiles this file with
// `dodo build --emit obj` and links the object into each fuzz target.
// Traps abort the process, which libFuzzer reports as a crash.

const INPUT_CAP: usize = 16777216

static mut INPUT: [INPUT_CAP]u8 = [0u8; INPUT_CAP]

// Run target number `target` (fuzz/image/targets/common.dodo) on
// data[..length]. Returns 0, or -1 for an unknown target or an input above
// INPUT_CAP (libFuzzer then leaves the input out of the corpus).
extern "C" fn dodo_image_fuzz(target: u32, data: *const u8, length: usize) -> i32 {
    if length > INPUT_CAP {
        return -1
    }
    unsafe {
        if length > 0 {
            ptr.copy_nonoverlapping(data, ptr.as_mut_ptr(&mut INPUT), length)
        }
        if !targets.run(target, &INPUT[..length]) {
            return -1
        }
    }
    return 0
}

// The number of targets, to check the Rust side's numbering.
extern "C" fn dodo_image_target_count() -> u32 {
    return targets.TARGET_COUNT
}
