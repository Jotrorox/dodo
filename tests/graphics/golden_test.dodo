package golden

import "core/bytes"
import "core/mem"
import "std/env"
import "std/fs"
import "std/graphics"
import "std/graphics/font"
import "std/graphics/image"
import "std/graphics/truetype"
import "std/platform"
import "std/platform/error"
import "std/text"

// Golden-image tests for std/graphics. Each scene is rendered and compared
// pixel for pixel with tests/graphics/golden/NAME.qoi. Rendering uses only
// integer arithmetic, so the images are identical on every target and at
// every optimization level.
//
// Run from the repository root:
//
//     dodo test tests/graphics
//
// After an intended rendering change, regenerate the images, view them (QOI
// opens in GIMP, ImageMagick and ffmpeg), and commit them:
//
//     DODO_UPDATE_GOLDEN=1 dodo test tests/graphics
//
// DODO_GOLDEN_DIR selects another directory.

// Largest encoded golden file, and largest golden image in pixels.
const FILE_LIMIT: usize = 65536
const PIXEL_LIMIT: usize = 65536

fn variable(name: &str, output: &mut[u8]) -> Option<&str> from(output) {
    workspace := env.Workspace.new()
    match env.get(name, output, &mut workspace, platform.TextPolicy.Strict) {
        ok(value) => {
            return value
        }
        err(_) => {
            return none
        }
    }
}

fn check(name: &str, canvas: &graphics.Canvas) {
    directory_storage := [0u8; 1024]
    directory := "tests/graphics/golden"
    match variable("DODO_GOLDEN_DIR", &mut directory_storage) {
        some(value) => {
            directory = value
        }
        none => {}
    }
    path_storage := [0u8; 1200]
    builder := text.Builder.new(&mut path_storage)
    first := text.Text.from_str(directory)
    builder.append(&first)!
    second := text.Text.from_str("/")
    builder.append(&second)!
    third := text.Text.from_str(name)
    builder.append(&third)!
    fourth := text.Text.from_str(".qoi")
    builder.append(&fourth)!
    built := builder.as_text()
    path := built.as_str()

    update_storage := [0u8; 16]
    updating := false
    match variable("DODO_UPDATE_GOLDEN", &mut update_storage) {
        some(value) => {
            updating = !bytes.equal(mem.str_bytes(value), b"") && !bytes.equal(mem.str_bytes(value), b"0")
        }
        none => {}
    }
    workspace := platform.workspace()
    if updating {
        encoded := [0u8; FILE_LIMIT]
        length := image.encode_qoi(canvas, &mut encoded)!
        fs.write_file(path, &encoded[..length], &mut workspace)!
        return
    }
    stored := [0u8; FILE_LIMIT]
    match fs.read_file(path, &mut stored, &mut workspace) {
        ok(report) => {
            assert(report.eof, "golden image larger than the test's buffer")
            pixels := [0u8; PIXEL_LIMIT * 4]
            expected := image.decode(&stored[..report.read], &mut pixels, graphics.PixelFormat.Rgba8888)!
            difference := expected.diff_bounds(canvas)
            assert(difference.is_empty(), "rendering differs from the golden image; inspect and regenerate with DODO_UPDATE_GOLDEN=1")
        }
        err(reason) => {
            assert(reason.cause.kind != error.Kind.NotFound, "golden image missing: run from the repository root, or create it with DODO_UPDATE_GOLDEN=1")
            assert(false, "golden image unreadable")
        }
    }
}

@test
fn shapes() {
    pixels := [0u8; 64 * 48 * 4]
    canvas := graphics.canvas(&mut pixels, 64, 48, graphics.PixelFormat.Rgba8888)!
    canvas.clear(graphics.hex(0x1d2330))
    canvas.fill_rect(2, 2, 12, 8, graphics.hex(0xe06c75))
    canvas.rect(16, 2, 12, 8, graphics.hex(0xe5c07b))
    canvas.fill_round_rect(30, 2, 14, 10, 4, graphics.hex(0x98c379))
    canvas.round_rect(46, 2, 16, 10, 3, graphics.hex(0x56b6c2))
    canvas.fill_circle(8, 20, 6, graphics.hex(0x61afef))
    canvas.circle(24, 20, 6, graphics.hex(0xc678dd))
    canvas.fill_ellipse(42, 20, 9, 5, graphics.hex(0xd19a66))
    canvas.ellipse(42, 20, 11, 7, graphics.WHITE)
    star := [12i32, 28, 16, 44, 2, 34, 22, 34, 8, 44]
    canvas.fill_polygon(&star, graphics.hex(0xe5c07b))
    canvas.polygon(&star, graphics.hex(0xe06c75))
    for i in 0i32..8 {
        canvas.line(40, 46, 26 + i * 5, 30, graphics.rgb(255 - (i * 24) as u8, 160, (i * 30) as u8))
    }
    canvas.blend_rect(30, 26, 32, 10, graphics.rgba(255, 255, 255, 96))
    check("shapes", &canvas)
}

@test
fn text_rendering() {
    pixels := [0u8; 160 * 56 * 4]
    canvas := graphics.canvas(&mut pixels, 160, 56, graphics.PixelFormat.Rgba8888)!
    canvas.clear(graphics.BLACK)
    small := font.small()
    medium := font.medium()
    canvas.text(&small, 1, 1, "Dodo graphics 0123456789", graphics.WHITE)
    canvas.text(&small, 1, 10, "Grüße, señor! Ça va? 50€", graphics.hex(0xe5c07b))
    canvas.text(&medium, 1, 19, "Hello, (ÿ) {g}", graphics.hex(0x61afef))
    big := font.small().scaled(2)
    bounds := canvas.text(&big, 1, 36, "x2", graphics.hex(0x98c379))
    canvas.rect(bounds.x, bounds.y, bounds.width, bounds.height, graphics.DARK_GRAY)
    canvas.text(&small, 40, 38, "two\nlines", graphics.hex(0xc678dd))
    check("text", &canvas)
}

fn glyph_sheet(canvas: &mut graphics.Canvas, sheet: &graphics.Font) {
    canvas.clear(graphics.hex(0x202020))
    storage := [0u8; 4]
    for code in 0x20u32..0x100 {
        index := code - 0x20
        x := ((index % 16) * sheet.advance()) as i32
        y := ((index / 16) * sheet.line_height()) as i32
        if (index + index / 16) % 2 == 0 {
            canvas.fill_rect(x, y, sheet.advance(), sheet.line_height(), graphics.hex(0x303030))
        }
        builder := text.Builder.new(&mut storage)
        builder.push(code)!
        glyph := builder.as_text()
        canvas.text(sheet, x, y, glyph.as_str(), graphics.WHITE)
    }
}

@test
fn small_font_sheet() {
    pixels := [0u8; 96 * 112 * 4]
    canvas := graphics.canvas(&mut pixels, 96, 112, graphics.PixelFormat.Rgba8888)!
    small := font.small()
    glyph_sheet(&mut canvas, &small)
    check("font_small", &canvas)
}

@test
fn medium_font_sheet() {
    pixels := [0u8; 128 * 224 * 4]
    canvas := graphics.canvas(&mut pixels, 128, 224, graphics.PixelFormat.Rgba8888)!
    medium := font.medium()
    glyph_sheet(&mut canvas, &medium)
    check("font_medium", &canvas)
}

fn badge(canvas: &mut graphics.Canvas) {
    canvas.clear(graphics.hex(0x284b63))
    canvas.fill_circle(10, 10, 8, graphics.hex(0xf4a259))
    canvas.fill_rect(4, 14, 24, 4, graphics.hex(0xbc4b51))
    canvas.line(0, 19, 31, 0, graphics.WHITE)
}

// The same drawing in every pixel format, converted back side by side, and
// alpha compositing of one canvas over another.
@test
fn formats() {
    pixels := [0u8; 128 * 44 * 4]
    canvas := graphics.canvas(&mut pixels, 128, 44, graphics.PixelFormat.Rgba8888)!
    canvas.clear(graphics.BLACK)
    rgba_pixels := [0u8; 32 * 20 * 4]
    rgba := graphics.canvas(&mut rgba_pixels, 32, 20, graphics.PixelFormat.Rgba8888)!
    badge(&mut rgba)
    canvas.blit(&rgba, 0, 0)
    rgb565_pixels := [0u8; 32 * 20 * 2]
    rgb565 := graphics.canvas(&mut rgb565_pixels, 32, 20, graphics.PixelFormat.Rgb565)!
    badge(&mut rgb565)
    canvas.blit(&rgb565, 32, 0)
    gray_pixels := [0u8; 32 * 20]
    gray := graphics.canvas(&mut gray_pixels, 32, 20, graphics.PixelFormat.Gray8)!
    badge(&mut gray)
    canvas.blit(&gray, 64, 0)
    mono_pixels := [0u8; 4 * 20]
    mono := graphics.canvas(&mut mono_pixels, 32, 20, graphics.PixelFormat.Mono1)!
    badge(&mut mono)
    canvas.blit(&mono, 96, 0)

    overlay_pixels := [0u8; 40 * 20 * 4]
    overlay := graphics.canvas(&mut overlay_pixels, 40, 20, graphics.PixelFormat.Bgra8888)!
    overlay.clear(graphics.TRANSPARENT)
    overlay.fill_round_rect(0, 0, 40, 20, 6, graphics.rgba(255, 255, 255, 140))
    overlay.fill_circle(20, 10, 6, graphics.rgba(224, 108, 117, 220))
    canvas.fill_rect(0, 22, 128, 22, graphics.hex(0x3a3f4b))
    canvas.blend(&overlay, 4, 23)
    canvas.blit(&overlay, 84, 23)
    check("formats", &canvas)
}

// Antialiased shapes, paths and strokes. Coverage is computed exactly in
// integers, so these images are as reproducible as the integer primitives.
@test
fn antialiased() {
    pixels := [0u8; 96 * 64 * 4]
    canvas := graphics.canvas(&mut pixels, 96, 64, graphics.PixelFormat.Rgba8888)!
    canvas.clear(graphics.hex(0x1d2330))
    canvas.aa_fill_circle(10, 10, 8, graphics.hex(0x61afef))
    canvas.aa_circle(30, 10, 8, graphics.WHITE)
    canvas.aa_fill_ellipse(54, 10, 13, 6, graphics.hex(0xd19a66))
    canvas.aa_ellipse(54, 10, 15, 8, graphics.hex(0xc678dd))
    canvas.aa_fill_round_rect(72, 2, 22, 16, 5, graphics.hex(0x98c379))
    canvas.aa_round_rect(73, 3, 20, 14, 4, graphics.WHITE)
    for i in 0i32..8 {
        canvas.aa_line(2 + i * 3, 24, 2 + i * 7, 60, graphics.rgb(255 - (i * 24) as u8, 180, (i * 30) as u8))
    }
    canvas.aa_thick_line(62, 26, 92, 44, 5, graphics.rgba(224, 108, 117, 200))
    canvas.aa_thick_line(62, 58, 92, 28, 2, graphics.hex(0x56b6c2))
    star := [44i32, 22, 52, 46, 32, 31, 56, 31, 36, 46]
    canvas.aa_fill_polygon(&star, graphics.hex(0xe5c07b))
    storage := [0i32; 256]
    path := graphics.Path.new(&mut storage)
    path.circle(76 * 256, 54 * 256 + 128, 9 * 256)
    path.circle(76 * 256, 54 * 256 + 128, 4 * 256)
    canvas.fill_path(&path, graphics.FillRule.EvenOdd, graphics.rgba(255, 255, 255, 180))
    path.clear()
    path.move_to(30 * 256, 62 * 256)
    path.cubic_to(40 * 256, 40 * 256, 50 * 256, 70 * 256, 58 * 256, 50 * 256)
    path.line_to(59 * 256, 51 * 256)
    path.quad_to(50 * 256, 75 * 256, 30 * 256, 63 * 256)
    canvas.fill_path(&path, graphics.FillRule.NonZero, graphics.WHITE)
    check("antialiased", &canvas)
}

// Linear and radial gradients with stops, spreads and dithering, on their
// own and filling paths.
@test
fn gradients() {
    pixels := [0u8; 96 * 64 * 4]
    canvas := graphics.canvas(&mut pixels, 96, 64, graphics.PixelFormat.Rgba8888)!
    sky := graphics.Gradient.linear(0, 0, 0, 63, graphics.hex(0x203a5c), graphics.hex(0xf4a259))
    sky.add_stop(170, graphics.hex(0xbc4b51))
    canvas.gradient_rect(0, 0, 96, 64, &sky)
    sun := graphics.Gradient.radial(70, 20, 14, graphics.rgba(255, 244, 214, 255), graphics.rgba(255, 200, 120, 0))
    canvas.gradient_rect(50, 0, 40, 40, &sun)
    stripes := graphics.Gradient.linear(4, 44, 12, 52, graphics.WHITE, graphics.hex(0x284b63))
    stripes.set_spread(graphics.Spread.Reflect)
    storage := [0i32; 128]
    path := graphics.Path.new(&mut storage)
    path.round_rect(4 * 256, 42 * 256, 40 * 256, 18 * 256, 6 * 256)
    canvas.gradient_path(&path, graphics.FillRule.NonZero, &stripes)
    rings := graphics.Gradient.radial(24, 18, 6, graphics.hex(0xe06c75), graphics.hex(0x56b6c2))
    rings.set_spread(graphics.Spread.Repeat)
    path.clear()
    path.circle(24 * 256 + 128, 18 * 256 + 128, 16 * 256)
    canvas.gradient_path(&path, graphics.FillRule.NonZero, &rings)
    // A dithered ramp on an RGB565 canvas, converted back for the image.
    ramp_pixels := [0u8; 44 * 18 * 2]
    ramp := graphics.canvas(&mut ramp_pixels, 44, 18, graphics.PixelFormat.Rgb565)!
    dark := graphics.Gradient.linear(0, 0, 43, 0, graphics.hex(0x102030), graphics.hex(0x304860))
    dark.set_dither(true)
    ramp.gradient_rect(0, 0, 44, 9, &dark)
    dark.set_dither(false)
    ramp.gradient_rect(0, 9, 44, 9, &dark)
    canvas.blit(&ramp, 50, 44)
    check("gradients", &canvas)
}

// Read a font file into `storage` and return its length.
fn load_font(path: &str, storage: &mut[u8]) -> usize {
    workspace := platform.workspace()
    report := fs.read_file(path, storage, &mut workspace)!
    assert(report.eof, "font larger than the test's buffer")
    return report.read
}

// TrueType text from the test fonts in tests/graphics/fonts at several
// sizes, in a solid color and a gradient, with kerning.
@test
fn truetype_text() {
    storage := [0u8; 4096]
    length := load_font("tests/graphics/fonts/dodo-test.ttf", &mut storage)
    sans := truetype.Font.new(&storage[..length])!
    pixels := [0u8; 160 * 96 * 4]
    canvas := graphics.canvas(&mut pixels, 160, 96, graphics.PixelFormat.Rgba8888)!
    canvas.clear(graphics.hex(0x1d2330))
    sans.draw(&mut canvas, 2, 2, "AODÄoNZ. AD DA", 10, graphics.WHITE)
    sans.draw(&mut canvas, 2, 14, "AODÄoNZ.", 18, graphics.hex(0xe5c07b))
    warm := graphics.Gradient.linear(0, 36, 0, 70, graphics.hex(0xf4a259), graphics.hex(0xbc4b51))
    sans.draw_gradient(&mut canvas, 2, 34, "NOD", 40, &warm)
    bounds := sans.draw(&mut canvas, 100, 40, "AD\nDA", 16, graphics.hex(0x61afef))
    canvas.aa_round_rect(bounds.x - 1, bounds.y - 1, bounds.width + 2, bounds.height + 2, 2, graphics.DARK_GRAY)
    check("truetype", &canvas)
}

// The same glyphs through the long-offset font, the format 12 character
// map and both members of the collection render identically.
@test
fn truetype_variants() {
    short_storage := [0u8; 4096]
    short_length := load_font("tests/graphics/fonts/dodo-test.ttf", &mut short_storage)
    short := truetype.Font.new(&short_storage[..short_length])!
    long_storage := [0u8; 4096]
    long_length := load_font("tests/graphics/fonts/dodo-test-long.ttf", &mut long_storage)
    long := truetype.Font.new(&long_storage[..long_length])!
    collection_storage := [0u8; 4096]
    collection_length := load_font("tests/graphics/fonts/dodo-test.ttc", &mut collection_storage)
    collection := &collection_storage[..collection_length]
    assert_eq(truetype.font_count(collection)!, 2u32)
    first := truetype.Font.from_collection(collection, 0)!
    second := truetype.Font.from_collection(collection, 1)!
    assert_eq(long.glyph_index(0x1f600), 3u32)
    assert_eq(short.glyph_index(0x1f600), 0u32)
    assert_eq(second.glyph_index(0x1f600), 3u32)
    assert_eq(long.kerning(2, 4), 0i32)
    assert_eq(first.kerning(2, 4), -80i32)

    // No kerned pairs, so all four fonts lay the text out alike.
    text := "NOZ.o ÄN"
    expected_pixels := [0u8; 96 * 24 * 4]
    expected := graphics.canvas(&mut expected_pixels, 96, 24, graphics.PixelFormat.Rgba8888)!
    expected.clear(graphics.BLACK)
    short.draw(&mut expected, 1, 1, text, 16, graphics.WHITE)
    actual_pixels := [0u8; 96 * 24 * 4]
    actual := graphics.canvas(&mut actual_pixels, 96, 24, graphics.PixelFormat.Rgba8888)!
    actual.clear(graphics.BLACK)
    long.draw(&mut actual, 1, 1, text, 16, graphics.WHITE)
    assert(expected.equals(&actual))
    actual.clear(graphics.BLACK)
    first.draw(&mut actual, 1, 1, text, 16, graphics.WHITE)
    assert(expected.equals(&actual))
    actual.clear(graphics.BLACK)
    second.draw(&mut actual, 1, 1, text, 16, graphics.WHITE)
    assert(expected.equals(&actual))
}
