package https_app_checks
import "std/web"
import "std/web/app"
import "std/web/https"
import "std/web/reactor"
import "std/http/hosting"
import "std/net"
import "std/net/native"

fn main() -> i32 {
    identity := https.files("cert.pem", "key.pem")
    cancel := net.Cancellation.new()
    cancel.cancel()
    server := app.new().get(b"/", web.text(b"hello")).build()!
    server.request(b"GET", b"/").expect_status(200).expect_body(b"hello")
    report := identity.serve_until(server, b"127.0.0.1:0", &cancel)!
    assert(report.cancelled && report.accepted == 0)

    concurrent := app.new().get(b"/", web.text(b"hello")).concurrent().build()!
    concurrent_report := identity.serve_until(concurrent, b"127.0.0.1:0", &cancel)!
    assert(concurrent_report.cancelled && concurrent_report.accepted == 0)

    workspace := [0u8; app.WORKSPACE_BYTES]
    request := [0u8; 8192]
    response := [0u8; 8192]
    clock := native.MonotonicClock {}
    for case in 0usize..3 {
        builder := app.new().get(b"/", web.text(b"hello"))
        builder.config.limits.body_bytes = 8192
        builder.config.limits.response_bytes = 8192
        if case == 2 {
            builder.config.timeouts.header_ms = 0
        }
        server := builder.build()!
        size := workspace.len
        if case == 1 {
            size -= 1
        }
        storage := app.Storage.new(&mut workspace[..size], &mut request, &mut response)
        match identity.serve_with(server, b"127.0.0.1:0", &mut storage, &mut clock, &cancel) {
            ok(report) => {
                assert(case == 0 && report.cancelled && report.accepted == 0)
            }
            err(reason) => {
                assert(reason.kind == https.ErrorKind.Serving)
                match &reason.serving {
                    some(cause) => {
                        if case == 1 {
                            assert(cause.kind == hosting.ErrorKind.Workspace)
                        } else {
                            assert(case == 2 && cause.kind == hosting.ErrorKind.InvalidInput)
                        }
                    }
                    none => {
                        assert(false)
                    }
                }
            }
        }
        core.drop(storage)
        workspace[0] = 0
        request[0] = 0
        response[0] = 0
    }
    tls_workspace := [0u8; https.WORKSPACE_BYTES *2]
    slots := [reactor.Slot.new(), reactor.Slot.new()]
    for case in 0usize..6 {
        builder := app.new().get(b"/", web.text(b"hello")).concurrent()
        if case == 2 {
            builder.config.timeouts.idle_ms = 0
        }
        if case == 3 {
            builder.config.requests_per_connection = 0
        }
        if case == 4 {
            builder.config.events_per_turn = 0
        }
        server := builder.build()!
        size := tls_workspace.len
        if case == 1 {
            size -= 1
        }
        storage := app.Storage.concurrent(&mut tls_workspace[..size], &mut request, &mut response, &mut slots)
        match identity.serve_with(server, b"127.0.0.1:0", &mut storage, &mut clock, &cancel) {
            ok(report) => {
                assert((case == 0 || case == 5) && report.cancelled && report.accepted == 0)
            }
            err(reason) => {
                match &reason.serving {
                    some(cause) => {
                        assert(case >= 1 && case <= 4 && cause.kind == hosting.ErrorKind.InvalidInput)
                    }
                    none => {
                        assert(false)
                    }
                }
            }
        }
        core.drop(storage)
        tls_workspace[0] = 0
        request[0] = 0
        response[0] = 0
    }
    missing_slots := app.new().get(b"/", web.text(b"hello")).concurrent().build()!
    serial_storage := app.Storage.new(&mut workspace, &mut request, &mut response)
    match identity.serve_with(missing_slots, b"127.0.0.1:0", &mut serial_storage, &mut clock, &cancel) {
        ok(_) => {
            assert(false)
        }
        err(reason) => {
            match &reason.serving {
                some(cause) => {
                    assert(cause.kind == hosting.ErrorKind.Workspace)
                }
                none => {
                    assert(false)
                }
            }
        }
    }
    return 0
}
