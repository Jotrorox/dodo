package ops_test

import "std/image/ops"
import "std/image/pixels"

// Palettes, remapping and depth reduction: exact palettes for images with
// few colors, the color limit, dithered output staying inside the palette,
// dither proportions, and posterized levels.

static mut WORK: [65536]u8 = [0u8; 65536]

fn errname(result: usize!pixels.Error) -> &str from(static) {
    match result {
        ok(_) => {
            return "ok"
        }
        err(e) => {
            return pixels.error_name(e)
        }
    }
}

// A 6x4 image of five colors, one half transparent.
fn five_colors(data: &mut[u8]) {
    colors := [255u8, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 20, 30, 40, 128, 250, 250, 250, 255]
    for p in 0usize..24 {
        k := (p * 7 + p / 6) % 5
        for c in 0usize..4 {
            data[p * 4 + c] = colors[k * 4 + c]
        }
    }
}

@test
fn few_colors_give_an_exact_palette_and_remap() {
    data := [0u8; 96]
    five_colors(&mut data)
    source := pixels.View.new(&data, 6, 4, pixels.Layout.rgba8())!
    entries := [0u8; 1024]
    count := 0usize
    unsafe {
        count = ops.palette(&source, 8, &mut entries, &mut WORK)!
    }
    assert_eq(count, 5)
    for d in 0usize..3 {
        dither := ops.Dither.None
        if d == 1 {
            dither = ops.Dither.FloydSteinberg
        }
        indices := [0u8; 24]
        if d < 2 {
            unsafe {
                ops.remap(&source, &entries[..count * 4], &mut indices, dither, &mut WORK)!
            }
            for p in 0usize..24 {
                i := indices[p] as usize
                assert(i < count, "index outside the palette")
                for c in 0usize..4 {
                    assert_eq(entries[i * 4 + c], data[p * 4 + c])
                }
            }
        }
    }
    // Exactly five colors also fit a five-entry palette.
    unsafe {
        count = ops.palette(&source, 5, &mut entries, &mut WORK)!
    }
    assert_eq(count, 5)
    // An RGB source reads as opaque.
    rgb := [10u8, 20, 30, 10, 20, 30, 40, 50, 60, 10, 20, 30]
    opaque := pixels.View.new(&rgb, 2, 2, pixels.Layout.rgb8())!
    unsafe {
        count = ops.palette(&opaque, 256, &mut entries, &mut WORK)!
    }
    assert_eq(count, 2)
    assert_eq(entries[0], 10)
    assert_eq(entries[3], 255)
    assert_eq(entries[4], 40)
}

fn gradient(data: &mut[u8]) {
    for y in 0usize..16 {
        for x in 0usize..16 {
            p := (y * 16 + x) * 3
            data[p] = (x * 17) as u8
            data[p + 1] = (y * 17) as u8
            data[p + 2] = ((x + y) * 8) as u8
        }
    }
}

@test
fn many_colors_respect_the_limit_and_dithering_stays_in_the_palette() {
    data := [0u8; 16 * 16 * 3]
    gradient(&mut data)
    source := pixels.View.new(&data, 16, 16, pixels.Layout.rgb8())!
    for limit in 1usize..20 {
        entries := [0u8; 1024]
        count := 0usize
        unsafe {
            count = ops.palette(&source, limit, &mut entries, &mut WORK)!
        }
        assert(count >= 1 && count <= limit, "palette size outside 1..limit")
        // Distinct entries.
        for i in 0usize..count {
            for j in 0usize..i {
                same := true
                for c in 0usize..4 {
                    if entries[i * 4 + c] != entries[j * 4 + c] {
                        same = false
                    }
                }
                assert(!same, "duplicate palette entry")
            }
        }
        for d in 0usize..3 {
            dither := ops.Dither.None
            if d == 1 {
                dither = ops.Dither.FloydSteinberg
            } else if d == 2 {
                dither = ops.Dither.Ordered
            }
            indices := [255u8; 256]
            unsafe {
                ops.remap(&source, &entries[..count * 4], &mut indices, dither, &mut WORK)!
            }
            for p in 0usize..256 {
                assert((indices[p] as usize) < count, "index outside the palette")
            }
        }
    }
    // 16 colors from a 256-color gradient get used.
    entries := [0u8; 64]
    count := 0usize
    unsafe {
        count = ops.palette(&source, 16, &mut entries, &mut WORK)!
    }
    assert_eq(count, 16)
}

@test
fn dithering_mid_gray_between_black_and_white() {
    gray := [128u8; 256]
    source := pixels.View.new(&gray, 16, 16, pixels.Layout.gray8())!
    entries := [0u8, 0, 0, 255, 255, 255, 255, 255]
    indices := [0u8; 256]
    unsafe {
        ops.remap(&source, &entries, &mut indices, ops.Dither.None, &mut WORK)!
    }
    white := 0usize
    for p in 0usize..256 {
        white += indices[p] as usize
    }
    assert_eq(white, 256)
    unsafe {
        ops.remap(&source, &entries, &mut indices, ops.Dither.Ordered, &mut WORK)!
    }
    white = 0
    for p in 0usize..256 {
        white += indices[p] as usize
    }
    // Bayer thresholds split 128 exactly in half.
    assert_eq(white, 128)
    unsafe {
        ops.remap(&source, &entries, &mut indices, ops.Dither.FloydSteinberg, &mut WORK)!
    }
    white = 0
    for p in 0usize..256 {
        white += indices[p] as usize
    }
    assert(white >= 120 && white <= 136, "error diffusion should give about half white")
}

@test
fn nearest_color_prefers_exact_entries() {
    entries := [0u8, 0, 0, 0, 255, 0, 0, 0, 255, 0, 0, 255, 0, 0, 255, 255]
    // Both transparent entries look the same; the exact one wins.
    assert_eq(ops.nearest_color(&entries, 255, 0, 0, 0), 1)
    assert_eq(ops.nearest_color(&entries, 0, 0, 0, 0), 0)
    assert_eq(ops.nearest_color(&entries, 200, 10, 10, 250), 2)
    assert_eq(ops.nearest_color(&entries, 10, 10, 200, 250), 3)
    // A nearly transparent pixel matches a transparent entry.
    assert_eq(ops.nearest_color(&entries, 0, 0, 255, 3), 0)
}

@test
fn palette_misuse_is_reported() {
    data := [0u8; 96]
    five_colors(&mut data)
    source := pixels.View.new(&data, 6, 4, pixels.Layout.rgba8())!
    entries := [0u8; 1024]
    small := [0u8; 512]
    need := ops.palette_scratch_size(6, 4)!
    assert_eq(errname(ops.palette(&source, 4, &mut entries, &mut small[..need - 1])), "BufferTooSmall")
    assert_eq(errname(ops.palette(&source, 0, &mut entries, &mut small)), "Malformed")
    assert_eq(errname(ops.palette(&source, 257, &mut entries, &mut small)), "Malformed")
    assert_eq(errname(ops.palette(&source, 4, &mut entries[..15], &mut small)), "BufferTooSmall")
    assert_eq(errname(ops.palette(&source, 4, &mut entries, &mut small[..need])), "ok")
}

@test
fn reduce_depth_posterizes_and_dithers_to_levels() {
    data := [0u8; 16 * 16 * 3]
    gradient(&mut data)
    source := pixels.View.new(&data, 16, 16, pixels.Layout.rgb8())!
    // 8 bits keep 8-bit data unchanged.
    out := [0u8; 16 * 16 * 3]
    reduce_into(&source, &mut out, 8, 8, 8, ops.Dither.None)
    for i in 0usize..768 {
        assert_eq(out[i], data[i])
    }
    // RGB565 levels.
    reduce_into(&source, &mut out, 5, 6, 5, ops.Dither.None)
    for i in 0usize..768 {
        bits := 5u32
        if i % 3 == 1 {
            bits = 6
        }
        levels := (1u32 << bits) - 1
        v := out[i] as u32
        q := (v * levels + 127) / 255
        assert_eq((q * 255 + levels / 2) / levels, v)
        // The nearest level.
        exact := data[i] as u32 * levels
        assert(q * 255 + 128 + 1 >= exact && exact + 128 >= q * 255, "not the nearest level")
    }
    for d in 1usize..3 {
        dither := ops.Dither.FloydSteinberg
        if d == 2 {
            dither = ops.Dither.Ordered
        }
        reduce_into(&source, &mut out, 2, 2, 2, dither)
        for i in 0usize..768 {
            v := out[i]
            assert(v == 0 || v == 85 || v == 170 || v == 255, "value between 2-bit levels")
        }
    }
    // Mid gray at one bit dithers to about half white.
    gray := [128u8; 256]
    flat := pixels.View.new(&gray, 16, 16, pixels.Layout.gray8())!
    bw := [0u8; 256]
    mono := pixels.ViewMut.new(&mut bw, 16, 16, pixels.Layout.gray8())!
    unsafe {
        ops.reduce_depth(&flat, &mut mono, 1, 1, 1, 1, ops.Dither.Ordered, &mut WORK)!
    }
    white := 0usize
    for i in 0usize..256 {
        assert(bw[i] == 0 || bw[i] == 255, "not one bit")
        if bw[i] == 255 {
            white += 1
        }
    }
    assert_eq(white, 128)
}

fn reduce_into(source: &pixels.View, out: &mut[u8], red: u32, green: u32, blue: u32, dither: ops.Dither) {
    target := pixels.ViewMut.new(out, source.width(), source.height(), pixels.Layout.rgb8())!
    unsafe {
        ops.reduce_depth(source, &mut target, red, green, blue, 8, dither, &mut WORK)!
    }
}
