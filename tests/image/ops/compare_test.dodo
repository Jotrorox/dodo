package ops_test

import "std/image/ops"
import "std/image/pixels"
import "std/math"

// Comparison metrics: identical images, known MSE and PSNR values, layout
// independence, SSIM bounds, and size mismatches.

static mut QUANT_WORK: [65536]u8 = [0u8; 65536]

fn close(value: f64, expected: f64) -> bool {
    return math.abs(value - expected) < 0.000001
}

@test
fn identical_images_are_perfect() {
    data := [0u8; 9 * 7 * 4]
    for i in 0usize..data.len {
        data[i] = (i * 13 % 256) as u8
    }
    a := pixels.View.new(&data, 9, 7, pixels.Layout.rgba8())!
    b := pixels.View.new(&data, 9, 7, pixels.Layout.rgba8())!
    assert(ops.equal(&a, &b))
    assert(math.is_infinite(ops.psnr(&a, &b)!))
    assert_eq(ops.mse(&a, &b)!, 0.0)
    assert_eq(ops.ssim(&a, &b)!, 1.0)
    assert_eq(ops.difference_count(&a, &b)!, 0u64)
    assert_eq(ops.max_difference(&a, &b)!, 0u32)
    // A gray image equals its RGB expansion.
    gray := [0u8, 50, 100, 255]
    rgb := [0u8, 0, 0, 50, 50, 50, 100, 100, 100, 255, 255, 255]
    g := pixels.View.new(&gray, 2, 2, pixels.Layout.gray8())!
    c := pixels.View.new(&rgb, 2, 2, pixels.Layout.rgb8())!
    assert(ops.equal(&g, &c))
    // And its 16-bit version.
    wide := [0u8; 8]
    for i in 0usize..4 {
        pixels.put16(&mut wide, i * 2, gray[i] as u16 * 257)
    }
    w := pixels.View.new(&wide, 2, 2, pixels.Layout.gray16())!
    assert(ops.equal(&g, &w))
    assert_eq(ops.ssim(&g, &w)!, 1.0)
}

@test
fn known_errors() {
    first := [0u8, 0, 0, 10, 20, 30]
    second := [0u8, 0, 0, 10, 20, 40]
    a := pixels.View.new(&first, 2, 1, pixels.Layout.rgb8())!
    b := pixels.View.new(&second, 2, 1, pixels.Layout.rgb8())!
    metrics := ops.measure(&a, &b)!
    assert_eq(metrics.channels, 3)
    assert(close(metrics.mse(), 100.0 / 6.0), "mse")
    assert(close(metrics.mse_channel(2), 50.0), "channel mse")
    assert_eq(metrics.mse_channel(0), 0.0)
    assert(close(metrics.psnr(), 35.91231611251554), "psnr")
    assert(close(metrics.psnr_channel(2), 31.141103565318918), "channel psnr")
    assert(math.is_infinite(metrics.psnr_channel(1)))
    assert_eq(metrics.max_difference, 2570u32)
    assert_eq(metrics.max_channel[2], 2570u32)
    assert_eq(metrics.different_pixels, 1u64)
    assert(!ops.equal(&a, &b))
    // Alpha counts when present.
    rgba := [0u8, 0, 0, 255, 10, 20, 30, 155]
    c := pixels.View.new(&rgba, 2, 1, pixels.Layout.rgba8())!
    with_alpha := ops.measure(&a, &c)!
    assert_eq(with_alpha.channels, 4)
    assert(close(with_alpha.mse(), 10000.0 / 8.0), "alpha mse")
    s := ops.ssim(&a, &b)!
    assert(s < 1.0 && s > 0.5, "ssim of a small change")
}

@test
fn ssim_falls_with_distortion() {
    data := [0u8; 16 * 16]
    noisy := [0u8; 16 * 16]
    flat := [128u8; 16 * 16]
    for i in 0usize..256 {
        data[i] = ((i % 16) * 12 + (i / 16) * 3) as u8
        bump := 0u32
        if (i * 7) % 5 == 0 {
            bump = 12
        }
        v := data[i] as u32 + bump
        if v > 255 {
            v = 255
        }
        noisy[i] = v as u8
    }
    a := pixels.View.new(&data, 16, 16, pixels.Layout.gray8())!
    b := pixels.View.new(&noisy, 16, 16, pixels.Layout.gray8())!
    c := pixels.View.new(&flat, 16, 16, pixels.Layout.gray8())!
    slight := ops.ssim(&a, &b)!
    strong := ops.ssim(&a, &c)!
    assert(slight < 1.0 && slight > 0.8, "slight noise")
    assert(strong < slight, "a flat image is less similar")
    assert(close(ops.ssim(&b, &a)!, slight), "symmetric")
    psnr_slight := ops.psnr(&a, &b)!
    psnr_strong := ops.psnr(&a, &c)!
    assert(psnr_slight > psnr_strong)
}

@test
fn quantized_gradients_stay_close() {
    data := [0u8; 16 * 16 * 3]
    gradient(&mut data)
    source := pixels.View.new(&data, 16, 16, pixels.Layout.rgb8())!
    entries := [0u8; 1024]
    count := 0usize
    indices := [0u8; 256]
    unsafe {
        count = ops.palette(&source, 64, &mut entries, &mut QUANT_WORK)!
        ops.remap(&source, &entries[..count * 4], &mut indices, ops.Dither.None, &mut QUANT_WORK)!
    }
    rebuilt := [0u8; 16 * 16 * 3]
    for p in 0usize..256 {
        for c in 0usize..3 {
            rebuilt[p * 3 + c] = entries[indices[p] as usize * 4 + c]
        }
    }
    result := pixels.View.new(&rebuilt, 16, 16, pixels.Layout.rgb8())!
    quality := ops.psnr(&source, &result)!
    assert(quality > 30.0, "64 colors should reproduce a smooth gradient well")
}

@test
fn mismatched_sizes_are_malformed() {
    data := [0u8; 16]
    a := pixels.View.new(&data, 2, 2, pixels.Layout.rgba8())!
    b := pixels.View.new(&data, 4, 1, pixels.Layout.rgba8())!
    assert(!ops.equal(&a, &b))
    match ops.measure(&a, &b) {
        ok(_) => {
            assert(false, "sizes differ")
        }
        err(e) => {
            assert_eq(pixels.error_name(e), "Malformed")
        }
    }
    match ops.ssim(&a, &b) {
        ok(_) => {
            assert(false, "sizes differ")
        }
        err(e) => {
            assert_eq(pixels.error_name(e), "Malformed")
        }
    }
}
