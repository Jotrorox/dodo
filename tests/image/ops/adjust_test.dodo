package ops_test

import "std/image/ops"
import "std/image/pixels"

// Fill, compositing, grayscale and invert.

@test
fn fill_writes_every_layout() {
    out := [0u8; 12]
    target := pixels.ViewMut.new(&mut out, 2, 2, pixels.Layout.rgb8())!
    ops.fill8(&mut target, 10, 20, 30, 128)
    for p in 0usize..4 {
        assert_eq(out[p * 3], 10)
        assert_eq(out[p * 3 + 1], 20)
        assert_eq(out[p * 3 + 2], 30)
    }
    layout := pixels.Layout.rgba16()
    layout.premultiplied = true
    wide := [0u8; 16]
    premultiplied := pixels.ViewMut.new(&mut wide, 2, 1, layout)!
    ops.fill(&mut premultiplied, 65535, 0, 0, 32768)
    assert_eq(pixels.get16(&wide, 0), 32768)
    assert_eq(pixels.get16(&wide, 6), 32768)
    assert_eq(pixels.get16(&wide, 8), 32768)
}

@test
fn composite_over_blends_and_clips() {
    // A 2x2 opaque blue background.
    background := [0u8; 16]
    target := pixels.ViewMut.new(&mut background, 2, 2, pixels.Layout.rgba8())!
    ops.fill8(&mut target, 0, 0, 255, 255)
    // Half-transparent red, 2x2, placed at (1, -1): only its bottom-left
    // pixel lands on the target's top-right pixel.
    red := [255u8, 0, 0, 128, 255, 0, 0, 128, 255, 0, 0, 128, 255, 0, 0, 128]
    source := pixels.View.new(&red, 2, 2, pixels.Layout.rgba8())!
    ops.composite_over(&source, &mut target, 1, -1)
    assert_eq(background[4], 128)
    assert_eq(background[5], 0)
    assert_eq(background[6], 127)
    assert_eq(background[7], 255)
    // Untouched pixels.
    assert_eq(background[0], 0)
    assert_eq(background[2], 255)
    assert_eq(background[12], 0)
    // Over a transparent target the source is copied.
    clear := [0u8; 16]
    empty := pixels.ViewMut.new(&mut clear, 2, 2, pixels.Layout.rgba8())!
    ops.composite_over(&source, &mut empty, 0, 0)
    for i in 0usize..16 {
        assert_eq(clear[i], red[i])
    }
    // Half over half: alpha 0.75, color weighted 2:1.
    green := [0u8, 255, 0, 128]
    under := pixels.ViewMut.new(&mut green, 1, 1, pixels.Layout.rgba8())!
    single := source.sub(0, 0, 1, 1)!
    ops.composite_over(&single, &mut under, 0, 0)
    assert_eq(green[3], 192)
    assert_eq(green[0], 170)
    assert_eq(green[1], 85)
    // Fully outside.
    again := pixels.ViewMut.new(&mut green, 1, 1, pixels.Layout.rgba8())!
    ops.composite_over(&source, &mut again, 5, 5)
    assert_eq(green[0], 170)
    // A float target.
    floats := [0u8; 16]
    float_target := pixels.ViewMut.new(&mut floats, 1, 1, pixels.Layout.rgba_f32())!
    ops.fill(&mut float_target, 0, 0, 65535, 65535)
    ops.composite_over(&single, &mut float_target, 0, 0)
    red_float := pixels.get32(&floats, 0)
    // 128 / 255 = 0.50196...
    assert(red_float > 0x3f008000 && red_float < 0x3f008200, "float blend")
}

@test
fn grayscale_and_invert() {
    data := [255u8, 0, 0, 200, 0, 255, 0, 100]
    source := pixels.View.new(&data, 2, 1, pixels.Layout.rgba8())!
    out := [0u8; 8]
    target := pixels.ViewMut.new(&mut out, 2, 1, pixels.Layout.rgba8())!
    ops.grayscale(&source, &mut target)!
    // BT.709: red 0.2126, green 0.7152.
    assert_eq(out[0], 54)
    assert_eq(out[1], 54)
    assert_eq(out[3], 200)
    assert_eq(out[4], 182)
    assert_eq(out[7], 100)
    inverted := pixels.ViewMut.new(&mut out, 2, 1, pixels.Layout.rgba8())!
    ops.invert(&source, &mut inverted)!
    assert_eq(out[0], 0)
    assert_eq(out[1], 255)
    assert_eq(out[2], 255)
    assert_eq(out[3], 200)
    gray := [0u8; 4]
    gray_target := pixels.ViewMut.new(&mut gray, 2, 1, pixels.Layout.gray_alpha8())!
    ops.grayscale(&source, &mut gray_target)!
    assert_eq(gray[0], 54)
    assert_eq(gray[1], 200)
    floats := [0u8; 24]
    float_target := pixels.ViewMut.new(&mut floats, 2, 1, pixels.Layout.rgb_f32())!
    ops.invert(&source, &mut float_target)!
    assert_eq(pixels.get32(&floats, 0), 0u32)
    assert_eq(pixels.get32(&floats, 4), 0x3f800000u32)
    small := pixels.ViewMut.new(&mut gray, 1, 1, pixels.Layout.gray8())!
    match ops.invert(&source, &mut small) {
        ok() => {
            assert(false, "size mismatch")
        }
        err(e) => {
            assert_eq(pixels.error_name(e), "Malformed")
        }
    }
}
