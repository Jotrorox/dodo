package env_checks
import "std/env"
import "std/platform/native"
import "std/platform/error"

fn require(value: bool, code: i32) -> void!i32 {
    if!value {
        return err(code)
    }
    return ok()
}
fn run() -> void!i32 {
    storage := [0u8; 65536]
    wide := [0u16; 65536]
    snapshot := match env.snapshot(&mut storage, &mut wide) {
        ok(value) => {
            value
        }, err(_) => {
            return err(1)
        }
    }
    name_bytes := [0u8; 64]
    name_wide := [0u16; 64]
    name := match native.from_utf8("DODO_ENV_TEST", &mut name_bytes, &mut name_wide) {
        ok(value) => {
            value
        }, err(_) => {
            return err(2)
        }
    }
    match snapshot.get(&name) {
        some(value) => {
            utf8 := [0u8; 64]
            count := match native.to_utf8(&value, &mut utf8, false) {
                ok(length) => {
                    length
                }, err(_) => {
                    return err(3)
                }
            }
            require(count == 10 && utf8[0] == 112 && utf8[9] == 169, 4)?
        }
        none => {
            return err(5)
        }
    }
    require(snapshot.len() > 0, 6)?
    cwd_bytes := [0u8; 1024]
    cwd_wide := [0u16; 1024]
    cwd := match env.current_dir(&mut cwd_bytes, &mut cwd_wide) {
        ok(value) => {
            value
        }, err(_) => {
            return err(7)
        }
    }
    require(cwd.units().len > 1, 8)?
    args_bytes := [0u8; 4096]
    args_wide := [0u16; 4096]
    args := match env.arguments(&mut args_bytes, &mut args_wide) {
        ok(value) => {
            value
        }, err(_) => {
            return err(9)
        }
    }
    require(args.len() == 4, 10)?
    match args.at(1) {
        some(value) => {
            utf8 := [0u8; 64]
            count := match native.to_utf8(&value, &mut utf8, false) {
                ok(length) => {
                    length
                }, err(_) => {
                    return err(11)
                }
            }
            require(count == 9 && utf8[5] == 32, 12)?
        }
        none => {
            return err(13)
        }
    }
    match args.at(3) {
        some(value) => {
            require(value.units().len == 0, 14)?
        }
        none => {
            return err(15)
        }
    }
    child_bytes := [0u8; 256]
    child_wide := [0u16; 256]
    builder := env.child_environment(&mut child_bytes, &mut child_wide)
    val_bytes := [0u8; 64]
    val_wide := [0u16; 64]
    value := match native.from_utf8("child", &mut val_bytes, &mut val_wide) {
        ok(value) => {
            value
        }, err(_) => {
            return err(16)
        }
    }
    match builder.set(&name, &value) {
        ok() => {}, err(_) => {
            return err(17)
        }
    }
    {
        child := match builder.snapshot() {
            ok(value) => {
                value
            }, err(_) => {
                return err(18)
            }
        }
        require(child.len() == 1, 19)?
        match child.get(&name) {
            some(value) => {
                require(value.units().len == 5, 20)?
            }, none => {
                return err(21)
            }
        }
    }
    match builder.set(&name, &value) {
        ok() => {}, err(_) => {
            return err(22)
        }
    }
    // A failed replacement copy preserves the previous child entries.
    match builder.copy_from(&snapshot) {
        ok() => {
            return err(31)
        }
        err(reason) => {
            require(reason.kind == error.Kind.BufferTooSmall, 32)?
        }
    }
    {
        preserved := match builder.snapshot() {
            ok(value) => {
                value
            }, err(_) => {
                return err(33)
            }
        }
        require(preserved.len() == 1, 34)?
    }
    require(builder.remove(&name), 23)?
    require(!builder.remove(&name), 24)?
    {
        child := match builder.snapshot() {
            ok(value) => {
                value
            }, err(_) => {
                return err(25)
            }
        }
        require(child.len() == 0, 26)?
    }
    // Process environment remains unchanged by child construction.
    match snapshot.get(&name) {
        some(value) => {
            require(value.units().len > 5, 27)?
        }, none => {
            return err(28)
        }
    }
    tiny_bytes := [0u8; 1]
    tiny_wide := [0u16; 1]
    match env.snapshot(&mut tiny_bytes, &mut tiny_wide) {
        ok(_) => {
            return err(29)
        }
        err(reason) => {
            require(reason.kind == error.Kind.BufferTooSmall, 30)?
        }
    }
    return ok()
}
fn main() -> i32 {
    match run() {
        ok() => {
            return 0
        }, err(code) => {
            return code
        }
    }
}
