package fs_windows_checks

import "std/fs"
import "std/fs/windows_ext"
import "std/platform/native"
import "std/platform/error"
import "std/io"
import "core/bytes"
import "core/ptr"

unsafe extern "C" fn GetHandleInformation(handle: isize, flags: *mut u32) -> i32

fn verify() -> i32!error.Error {
    source := [110u16, 55296, 0]
    native_path := native.NativeString.new(&source)?
    output := [0u8; 32]
    match native.to_utf8(&native_path, &mut output, false) {
        ok(_) => {
            return ok(1)
        }
        err(reason) => {
            if reason.kind != error.Kind.InvalidInput {
                return ok(2)
            }
        }
    }
    count := native.to_utf8(&native_path, &mut output, true)?
    if!bytes.equal(&output[..count], b"n\xEF\xBF\xBD") {
        return ok(3)
    }
    b := [0u8; 256]
    w := [0u16; 256]
    path := native.from_utf8("windows sharing.txt", &mut b, &mut w)?
    create := fs.OpenOptions.create_new()
    owner := windows_ext.open(&path, &create, 0)?
    flags := 0u32
    unsafe {
        assert(GetHandleInformation(owner.raw_handle(), ptr.from_mut(&mut flags)) != 0)
    }
    assert((flags & 1) == 0, "file handles must not be inheritable")
    read := fs.OpenOptions.read_only()
    match fs.File.open(&path, &read) {
        ok(_) => {
            return ok(4)
        }
        err(reason) => {
            if reason.code != 32 {
                return ok(5)
            }
        }
    }
    match fs.remove_file(&path) {
        ok() => {
            return ok(6)
        }
        err(reason) => {
            if reason.code != 32 {
                return ok(7)
            }
        }
    }
    renamed_bytes := [0u8; 256]
    renamed_wide := [0u16; 256]
    renamed := native.from_utf8("renamed Ω.txt", &mut renamed_bytes, &mut renamed_wide)?
    match fs.rename(&path, &renamed, false) {
        ok() => {
            assert(false, "rename must respect sharing restrictions")
        }, err(reason) => {
            assert(reason.code == 32)
        }
    }
    owner.close()?
    // Closing an already closed owner must not close a newly allocated handle,
    // even when Windows reuses the same numeric handle value.
    replacement := fs.File.open(&path, &read)?
    owner.close()?
    core.drop(owner)
    before := replacement.metadata()?
    // The default sharing flags allow renaming and deletion while still open.
    fs.rename(&path, &renamed, false)?
    after := fs.metadata(&renamed)?
    assert(before.device == after.device && before.inode == after.inode)
    fs.remove_file(&renamed)?
    still_open := replacement.metadata()?
    assert(still_open.inode == before.inode)
    replacement.close()?
    // A pending deletion completes when the last owning handle is released.
    recreated := fs.File.open(&renamed, &create)?
    recreated.close()?
    fs.remove_file(&renamed)?
    return ok(0)
}
fn main() -> i32 {
    match verify() {
        ok(code) => {
            return code
        }
        err(reason) => {
            return 100 + reason.code % 100
        }
    }
}
