package process_checks
import "std/process"
import "std/platform/native"
import "std/platform/error"
import "std/io"
import "std/process/alloc" as output_alloc
import "alloc/arena"

fn require(value: bool, code: i32) -> void!i32 {
    if!value {
        return err(code)
    }
    return ok()
}
fn run() -> void!i32 {
    path_bytes := [0u8; 256]
    path_wide := [0u16; 256]
    executable := match native.from_utf8("./os child", &mut path_bytes, &mut path_wide) {
        ok(value) => {
            value
        }, err(_) => {
            return err(1)
        }
    }
    empty := match native.NativeList.new(b"") {
        ok(value) => {
            value
        }, err(_) => {
            return err(2)
        }
    }
    flood := match native.NativeList.new(b"flood\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(3)
        }
    }
    capture := process.Options.capture()
    child := match process.spawn(&executable, &flood, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(4)
        }
    }
    output := [0u8; 262144]
    errors := [0u8; 262144]
    match child.collect(&mut output, &mut errors, 5000) {
        ok(value) => {
            require(value.stdout_len == 262144 && value.stderr_len == 262144, 5)?
            require(value.status.kind == process.ExitKind.Exited && value.status.code == 7, 6)?
            require(output[262143] == 111 && errors[262143] == 101, 7)?
        }
        err(_) => {
            return err(8)
        }
    }
    // A size limit retains counts and reaps the producer without pipe deadlock.
    limited := match process.spawn(&executable, &flood, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(9)
        }
    }
    small := [0u8; 8]
    small_error := [0u8; 8]
    match limited.collect(&mut small, &mut small_error, 5000) {
        ok(_) => {
            return err(10)
        }
        err(reason) => {
            require(reason.cause.kind == error.Kind.BufferTooSmall, 11)?
            require(reason.stdout_len <= 8 && reason.stderr_len <= 8, 12)?
        }
    }
    sleeper := match native.NativeList.new(b"sleep\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(13)
        }
    }
    sleeping := match process.spawn(&executable, &sleeper, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(14)
        }
    }
    match sleeping.wait_timeout(5) {
        ok(_) => {
            return err(15)
        }
        err(reason) => {
            require(reason.kind == error.Kind.TimedOut, 16)?
        }
    }
    match sleeping.cancel() {
        ok() => {}, err(_) => {
            return err(17)
        }
    }
    match sleeping.wait() {
        ok(value) => {
            require(value.kind == process.ExitKind.Cancelled, 18)?
        }
        err(_) => {
            return err(19)
        }
    }
    kill_options := process.Options.capture()
    kill_options.stdin = process.Stdio.Piped
    terminated := match process.spawn(&executable, &sleeper, &empty, none, &kill_options) {
        ok(value) => {
            value
        }, err(_) => {
            return err(20)
        }
    }
    match terminated.terminate() {
        ok() => {}, err(_) => {
            return err(21)
        }
    }
    match terminated.wait_timeout(5000) {
        ok(value) => {
            require(value.kind == process.ExitKind.Signalled && value.code == 15, 22)?
        }
        err(_) => {
            return err(23)
        }
    }
    // Writing a closed child pipe must return an error, without SIGPIPE abort.
    match terminated.take_stdin() {
        some(pipe) => {
            match pipe.write(b"closed") {
                ok(_) => {
                    return err(52)
                }, err(reason) => {
                    require(reason.transferred == 0, 53)?
                }
            }
        }
        none => {
            return err(54)
        }
    }
    // Missing executable is spawn failure, not an exit status.
    missing := match native.NativeString.new(b"./no-such-dodo-program\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(24)
        }
    }
    match process.spawn(&missing, &empty, &empty, none, &capture) {
        ok(_) => {
            return err(25)
        }
        err(reason) => {
            require(reason.kind == error.Kind.NotFound, 26)?
        }
    }
    // Explicit child environment and quoted native arguments.
    args := match native.NativeList.new(b"check\0space arg\0quote\"arg\0tail\\\0\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(27)
        }
    }
    variables := match native.NativeList.new(b"DODO_CHILD=native value\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(28)
        }
    }
    options := process.Options.capture()
    options.inherit_environment = false
    cwd_bytes := [0u8; 64]
    cwd_wide := [0u16; 64]
    cwd := match native.from_utf8("child cwd é", &mut cwd_bytes, &mut cwd_wide) {
        ok(value) => {
            value
        }, err(_) => {
            return err(40)
        }
    }
    quoted := match process.spawn(&executable, &args, &variables, some(&cwd), &options) {
        ok(value) => {
            value
        }, err(_) => {
            return err(29)
        }
    }
    out := [0u8; 64]
    errout := [0u8; 64]
    match quoted.collect(&mut out, &mut errout, 5000) {
        ok(value) => {
            require(value.status.success() && value.stdout_len == 6 && value.stderr_len == 11, 30)?
        }
        err(_) => {
            return err(31)
        }
    }
    // Ownership transfer for stdin: close explicitly to deliver EOF.
    echo_args := match native.NativeList.new(b"echo\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(32)
        }
    }
    echo_options := process.Options.capture()
    echo_options.stdin = process.Stdio.Piped
    echo := match process.spawn(&executable, &echo_args, &empty, none, &echo_options) {
        ok(value) => {
            value
        }, err(_) => {
            return err(33)
        }
    }
    match echo.take_stdin() {
        some(pipe) => {
            match io.write_all(&mut pipe, b"native pipes") {
                ok(_) => {}, err(_) => {
                    return err(34)
                }
            }
            match pipe.close() {
                ok() => {}, err(_) => {
                    return err(35)
                }
            }
        }
        none => {
            return err(36)
        }
    }
    match echo.collect(&mut out, &mut errout, 5000) {
        ok(value) => {
            require(value.status.success() && value.stdout_len == 12, 37)?
        }
        err(_) => {
            return err(38)
        }
    }
    inherited_args := match native.NativeList.new(b"inherit\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(41)
        }
    }
    inherit_options := process.Options.new()
    inherited := match process.spawn(&executable, &inherited_args, &empty, none, &inherit_options) {
        ok(value) => {
            value
        }, err(_) => {
            return err(42)
        }
    }
    match inherited.collect(&mut out, &mut errout, 5000) {
        ok(value) => {
            require(value.status.success(), 43)?
        }, err(_) => {
            return err(44)
        }
    }
    // Native Unix argument bytes are independent of Unicode decoding.
    native_args := match native.NativeList.new(b"native\0\xff\0") {
        ok(value) => {
            value
        }, err(_) => {
            return err(45)
        }
    }
    native_child := match process.spawn(&executable, &native_args, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(46)
        }
    }
    match native_child.collect(&mut out, &mut errout, 5000) {
        ok(value) => {
            require(value.status.success(), 47)?
        }, err(_) => {
            return err(48)
        }
    }
    // A collection deadline terminates/reaps the process and retains prefixes.
    timed := match process.spawn(&executable, &sleeper, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(49)
        }
    }
    match timed.collect(&mut out, &mut errout, 5) {
        ok(_) => {
            return err(50)
        }
        err(reason) => {
            require(reason.cause.kind == error.Kind.TimedOut, 51)?
        }
    }
    // Explicit arena allocation owns initialized output and preserves bounds.
    allocated_child := match process.spawn(&executable, &flood, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(55)
        }
    }
    out_backing := [0u8; 262144]
    err_backing := [0u8; 262144]
    out_arena := arena.Arena.new(&mut out_backing)
    err_arena := arena.Arena.new(&mut err_backing)
    match output_alloc.collect_arena(&mut allocated_child, &mut out_arena, &mut err_arena, 262144, 262144, 5000) {
        ok(value) => {
            require(value.stdout().len == 262144 && value.stderr().len == 262144, 56)?
            require(value.status().code == 7 && value.stdout()[262143] == 111, 57)?
        }
        err(_) => {
            return err(58)
        }
    }
    // Allocation failure occurs before touching the child and remains recoverable.
    no_room_child := match process.spawn(&executable, &sleeper, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(59)
        }
    }
    tiny_out := [0u8; 1]
    tiny_err := [0u8; 1]
    tiny_out_arena := arena.Arena.new(&mut tiny_out)
    tiny_err_arena := arena.Arena.new(&mut tiny_err)
    match output_alloc.collect_arena(&mut no_room_child, &mut tiny_out_arena, &mut tiny_err_arena, 16, 16, 5000) {
        ok(_) => {
            return err(60)
        }
        err(reason) => {
            match reason {
                output_alloc.Error.Allocation(_) => {}, output_alloc.Error.Collection(_) => {
                    return err(61)
                }
            }
        }
    }
    match no_room_child.cancel() {
        ok() => {}, err(_) => {
            return err(62)
        }
    }
    // Destructor cleanup also kills a producer on early return/drop.
    abandoned := match process.spawn(&executable, &sleeper, &empty, none, &capture) {
        ok(value) => {
            value
        }, err(_) => {
            return err(39)
        }
    }
    core.drop(abandoned)
    return ok()
}
fn main() -> i32 {
    match run() {
        ok() => {
            return 0
        }, err(code) => {
            return code
        }
    }
}
