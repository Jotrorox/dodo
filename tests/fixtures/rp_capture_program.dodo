package main

import "std/embedded/chip/rp_pio"

// The PIO program of std/embedded/chip/rp_capture in pioasm, as its package
// comment shows it, assembled by the compiler for a board. rp_capture
// builds the same words in code so that it also runs in desktop tests,
// where the assembler is not available; tests/hal_library.rs compares the
// words assembled here with those tests/stdlib/timer_checks.dodo expects
// from rp_capture. EXECS are the instructions it executes on the stopped
// state machine, the jump to `high` without its target.

const EDGES: rp_pio.Program = rp_pio.assemble(
    ".in 32 left",
    ".fifo rx",
    ".wrap_target",
    "low:",
    "    jmp x-- low_1",
    "low_1:",
    "    jmp pin rose",
    "    jmp low [1]",
    "rose:",
    "    in y, 1",
    "    in x, 31",
    "    jmp x-- rose_1",
    "rose_1:",
    "    push noblock",
    "stay:",
    "    jmp high [1]",
    "high:",
    "    jmp x-- high_1",
    "high_1:",
    "    jmp pin stay",
    "    in null, 1",
    "    in x, 31",
    "    jmp x-- fell_1",
    "fell_1:",
    "    push noblock [2]",
    ".wrap",
)

const EXECS: rp_pio.Program = rp_pio.assemble("set y, 1", "mov x, ~null", "jmp pin 0")

// Keeps every program in the build.
pub fn lengths() -> u32 {
    return EDGES.length + EXECS.length
}

fn main() {
    core.assert(lengths() > 0)
}
