package main

import "selftest"

// The emulator self-test for the `pico` board (RP2040); see selftest.dodo.
// Alarm 0's interrupt has a different vector name on each chip.
@interrupt(TIMER_IRQ_0)
fn alarm_fired() {
    selftest.alarm_fired()
}

// So has the PWM wrap interrupt.
@interrupt(PWM_IRQ_WRAP)
fn pwm_wrapped() {
    selftest.pwm_wrapped()
}

fn main() {
    selftest.run(true)
}
