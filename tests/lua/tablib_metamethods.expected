@@exit 0
@@stdout
concat	a,b,c
  log	len get1 get2 get3
unpack	a	b
  log	get1 get2
unpack len	a	b	c
  log	len get1 get2 get3
insert end	len set3=c
  backing	a	b	c
insert front	len get2 set3=b get1 set2=a set1=z
  backing	z	a	b
remove	a
  log	len get1 get2 set1=b get3 set2=c set3=nil
  backing	b	c	nil
move	get1 set2=1 get2 set3=2 get3 set4=3
  dest	nil	1	2	3
sort	1 2 3 4 5
float len	v1,v2
bad len	false	object length is not an integer
bad len str	false	object length is not an integer
string len	true	1,2,3
index table	x+y+z	x	y	z
no __len	0	
ipairs over proxy	3	3
unpack with __index	1	dflt	3
