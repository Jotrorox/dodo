@@exit 0
@@stdout
pcall	yields=[in pcall]	final:	true	true	r1!
pcall-error-after-yield	yields=[before error]	final:	true	false	after
xpcall	yields=[in xpcall]	final:	true	false	handled x
__index	yields=[index foo]	final:	true	r1	nil
__newindex	yields=[newindex bar]	final:	true	r1=v	nil
__add	yields=[add]	final:	true	r1	nil
__lt true	yields=[lt]	final:	true	true	nil
__lt false	yields=[pre,lt]	final:	true	false	nil
__le	yields=[le,le]	final:	true	true	true
__eq	yields=[eq,eq]	final:	true	true	false
__concat	yields=[concat]	final:	true	xr1	nil
__len	yields=[len]	final:	true	r1	nil
__call	yields=[call arg]	final:	true	r1	nil
__unm	yields=[unm]	final:	true	r1	nil
for-iter	yields=[iter 0,iter 1,iter 2]	final:	true	6	nil
sort	yields=[]	final:	false	attempt to yield across a C-call boundary	nil
pcall(sort)	yields=[]	final:	true	false	attempt to yield across a C-call boundary
gsub	yields=[]	final:	true	false	attempt to yield across a C-call boundary
tostring	yields=[]	final:	true	false	attempt to yield across a C-call boundary
load reader	yields=[]	final:	true	nil	attempt to yield across a C-call boundary
