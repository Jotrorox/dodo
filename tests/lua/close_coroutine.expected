@@exit 0
@@stdout
resume	true	y1
before close	
close	true
after close	b(nil) a(nil)
status	dead
close again	true
resume closed	false	cannot resume dead coroutine
finish	true	done
normal	c(nil)
error resume	false	co error
error (nothing closed)	
close dead with error	false	co error
closed after error	d(co error)
close again after error	true
close with failing handler	false	close failed
failing handler	f(nil) e(nil)
status after	dead
close unstarted	true
unstarted	
yield in close 1	true	from close
yield in close 2	true	body done
yield in close	closing closed
wrap 1	1
wrap 2	false	wrap error
wrap	h(wrap error)
close running	false	cannot close a running coroutine
close normal	true	true	false	cannot close a normal coroutine
close bad arg	false	bad argument #1 to 'coroutine.close' (thread expected, got number)
multi	1	2	3
multi	multi(nil)
