@@exit 0
@@stdout
close fresh:	true
status:	dead
resume closed:	false	cannot resume dead coroutine
resume:	true	in block
  closing c	err=nil
  closing b	err=nil
  closing a	err=nil
close suspended:	true
status:	dead
close again:	true
close dead ok:	true
resume:	false	coro_close.lua:40: failure here
close dead err:	false	coro_close.lua:40: failure here
close again:	true
close dead table err:	false	true
  closing z	err=nil
  closing y	err=nil
  closing x	err=y failed
close with failing handler:	false	y failed
status:	dead
  closing q	err=nil
  closing p	err=q failed
close with two failures:	false	p failed
close running:	true	false	cannot close a running coroutine
close normal:	true	true	false	cannot close a normal coroutine
close main:	false	cannot close a running coroutine
close non-thread:	false	bad argument #1 to 'coroutine.close' (thread expected, got number)
resume erroring:	false	raised
status:	dead
  closing v	err=raised
close erroring:	false	raised
