package lua

import "core/mem"
import "core/ptr"
import "std/float_decimal"

// Test driver for the Lua compiler (not part of the stdlib package: the
// build script copies it next to the package sources). It compiles a file
// and prints a listing in the format of `luac -l -l`, and/or writes a
// binary chunk in the Lua 5.4 format so the output can be run by the
// reference interpreter.
//
//   luatool [-l] [-o out.luac] [-t N] file.lua

@link_name("open")
unsafe extern "C" fn lt_open(path: *const u8, flags: i32) -> i32
@link_name("creat")
unsafe extern "C" fn lt_creat(path: *const u8, mode: u32) -> i32
@link_name("read")
unsafe extern "C" fn lt_read(fd: i32, buf: *mut u8, n: usize) -> isize
@link_name("write")
unsafe extern "C" fn lt_write(fd: i32, buf: *const u8, n: usize) -> isize
@link_name("close")
unsafe extern "C" fn lt_close(fd: i32) -> i32
@link_name("clock")
unsafe extern "C" fn lt_clock() -> u64
@link_name("dodo_env_arguments")
unsafe extern "C" fn lt_arguments(storage: *mut u8, capacity: usize, used: *mut usize) -> i32

const LT_OPNAMES: [83]&str = [
    "MOVE", "LOADI", "LOADF", "LOADK", "LOADKX", "LOADFALSE", "LFALSESKIP", "LOADTRUE",
    "LOADNIL", "GETUPVAL", "SETUPVAL", "GETTABUP", "GETTABLE", "GETI", "GETFIELD",
    "SETTABUP", "SETTABLE", "SETI", "SETFIELD", "NEWTABLE", "SELF", "ADDI", "ADDK",
    "SUBK", "MULK", "MODK", "POWK", "DIVK", "IDIVK", "BANDK", "BORK", "BXORK", "SHRI",
    "SHLI", "ADD", "SUB", "MUL", "MOD", "POW", "DIV", "IDIV", "BAND", "BOR", "BXOR",
    "SHL", "SHR", "MMBIN", "MMBINI", "MMBINK", "UNM", "BNOT", "NOT", "LEN", "CONCAT",
    "CLOSE", "TBC", "JMP", "EQ", "LT", "LE", "EQK", "EQI", "LTI", "LEI", "GTI", "GEI",
    "TEST", "TESTSET", "CALL", "TAILCALL", "RETURN", "RETURN0", "RETURN1", "FORLOOP",
    "FORPREP", "TFORPREP", "TFORCALL", "TFORLOOP", "SETLIST", "CLOSURE", "VARARG",
    "VARARGPREP", "EXTRAARG",
]

const LT_EVENTS: [25]&str = [
    "__index", "__newindex", "__gc", "__mode", "__len", "__eq", "__add", "__sub", "__mul", "__mod", "__pow",
    "__div", "__idiv", "__band", "__bor", "__bxor", "__shl", "__shr", "__unm", "__bnot", "__lt", "__le",
    "__concat", "__call", "__close",
]

fn lt_flush(m: *mut MsgBuf, fd: i32) {
    unsafe {
        off := 0usize
        for off < (*m).n {
            let w = lt_write(fd, ptr.offset((*m).p, off as isize) as *const u8, (*m).n - off)
            if w <= 0 {
                break
            }
            off = off + w as usize
        }
        (*m).n = 0
    }
}

fn lt_hex(m: *mut MsgBuf, v: u64) {
    digits: [20]u8 = [0u8; 20]
    n := 0usize
    x := v
    for {
        let d = (x & 15) as u8
        digits[n] = if d < 10 { 48 + d } else { 87 + d }
        n = n + 1
        x = x >> 4
        if x == 0 {
            break
        }
    }
    msg_str(m, "0x")
    for i in 0usize..n {
        msg_char(m, digits[n - 1 - i])
    }
}

fn lt_ptr<T>(m: *mut MsgBuf, p: *mut T) {
    unsafe { lt_hex(m, p as usize as u64) }
}

// printf("%.14g")
fn lt_g14(m: *mut MsgBuf, v: f64) {
    unsafe {
        if v != v {
            msg_str(m, "nan")
            return
        }
        x := v
        if f64_bits(v) >> 63 != 0 {
            msg_char(m, 45)
            x = -v
        }
        if x == 1.0 / 0.0 {
            msg_str(m, "inf")
            return
        }
        if x == 0.0 {
            msg_char(m, 48)
            return
        }
        out: [400]u8 = [0u8; 400]
        let n = float_decimal.convert(&mut out, x, 13, true)!
        // Exponent after rounding to 14 significant digits.
        epos := 0usize
        for i in 0usize..n {
            if out[i] == 101 {
                epos = i
            }
        }
        eneg := out[epos + 1] == 45
        ex := 0i32
        for i in (epos + 2)..n {
            ex = ex * 10 + (out[i] - 48) as i32
        }
        if eneg {
            ex = -ex
        }
        if ex < -4 || ex >= 14 {
            // Mantissa without trailing zeros, then the exponent as printed.
            last := epos
            for last > 0 && out[last - 1] == 48 {
                last = last - 1
            }
            if last > 0 && out[last - 1] == 46 {
                last = last - 1
            }
            msg_bytes(m, ptr.as_ptr(&out), last)
            msg_bytes(m, ptr.offset(ptr.as_ptr(&out), epos as isize), n - epos)
            return
        }
        let prec = (13 - ex) as usize
        let k = float_decimal.convert(&mut out, x, prec, false)!
        last := k
        if prec > 0 {
            for last > 0 && out[last - 1] == 48 {
                last = last - 1
            }
            if last > 0 && out[last - 1] == 46 {
                last = last - 1
            }
        }
        msg_bytes(m, ptr.as_ptr(&out), last)
    }
}

fn lt_pstring(m: *mut MsgBuf, s: *mut LString) {
    unsafe {
        msg_char(m, 34)
        let d = str_data(s)
        for i in 0usize..str_len(s) {
            let c = *ptr.offset(d, i as isize)
            if c == 34 {
                msg_str(m, "\\\"")
            } else if c == 92 {
                msg_str(m, "\\\\")
            } else if c == 7 {
                msg_str(m, "\\a")
            } else if c == 8 {
                msg_str(m, "\\b")
            } else if c == 12 {
                msg_str(m, "\\f")
            } else if c == 10 {
                msg_str(m, "\\n")
            } else if c == 13 {
                msg_str(m, "\\r")
            } else if c == 9 {
                msg_str(m, "\\t")
            } else if c == 11 {
                msg_str(m, "\\v")
            } else if c >= 32 && c <= 126 {
                msg_char(m, c)
            } else {
                msg_char(m, 92)
                msg_char(m, 48 + c / 100)
                msg_char(m, 48 + (c / 10) % 10)
                msg_char(m, 48 + c % 10)
            }
        }
        msg_char(m, 34)
    }
}

fn lt_const(m: *mut MsgBuf, f: *mut Proto, i: i32) {
    unsafe {
        let o = ptr.offset((*f).k, i as isize)
        let t = (*o).tag
        if t == TAG_NIL {
            msg_str(m, "nil")
        } else if t == TAG_FALSE {
            msg_str(m, "false")
        } else if t == TAG_TRUE {
            msg_str(m, "true")
        } else if t == TAG_FLOAT {
            let start = (*m).n
            lt_g14(m, val_float(o))
            plain := true
            for j in start..(*m).n {
                let c = *ptr.offset((*m).p, j as isize)
                if !(c == 45 || (c >= 48 && c <= 57)) {
                    plain = false
                }
            }
            if plain {
                msg_str(m, ".0")
            }
        } else if t == TAG_INT {
            msg_int(m, val_int(o))
        } else if t == TAG_SHORTSTR || t == TAG_LONGSTR {
            lt_pstring(m, val_str(o))
        } else {
            msg_str(m, "?")
        }
    }
}

fn lt_ktype(m: *mut MsgBuf, f: *mut Proto, i: i32) {
    unsafe {
        let t = (*ptr.offset((*f).k, i as isize)).tag
        if t == TAG_NIL {
            msg_str(m, "N")
        } else if t == TAG_FALSE || t == TAG_TRUE {
            msg_str(m, "B")
        } else if t == TAG_FLOAT {
            msg_str(m, "F")
        } else if t == TAG_INT {
            msg_str(m, "I")
        } else {
            msg_str(m, "S")
        }
        msg_str(m, "\t")
    }
}

fn lt_upname(m: *mut MsgBuf, f: *mut Proto, i: i32) {
    unsafe {
        let s = (*ptr.offset((*f).upvalues, i as isize)).name
        if ptr.is_null(s) {
            msg_str(m, "-")
        } else {
            msg_lstr(m, s)
        }
    }
}

fn lt_line(f: *mut Proto, pc: i32) -> i32 {
    unsafe {
        if ptr.is_null((*f).lineinfo) {
            return -1
        }
        basepc := -1i32
        line := (*f).linedefined
        if (*f).sizeabslineinfo > 0 && pc >= (*(*f).abslineinfo).pc {
            i := 0i32
            for i + 1 < (*f).sizeabslineinfo && pc >= (*ptr.offset((*f).abslineinfo, (i + 1) as isize)).pc {
                i = i + 1
            }
            basepc = (*ptr.offset((*f).abslineinfo, i as isize)).pc
            line = (*ptr.offset((*f).abslineinfo, i as isize)).line
        }
        for basepc < pc {
            basepc = basepc + 1
            line = line + *ptr.offset((*f).lineinfo, basepc as isize) as i32
        }
        return line
    }
}

fn lt_ints(m: *mut MsgBuf, a: i32, b: i32) {
    msg_int(m, a as i64)
    msg_char(m, 32)
    msg_int(m, b as i64)
}

fn lt_ints3(m: *mut MsgBuf, a: i32, b: i32, c: i32) {
    lt_ints(m, a, b)
    msg_char(m, 32)
    msg_int(m, c as i64)
}

fn lt_kflag(m: *mut MsgBuf, k: bool) {
    if k {
        msg_str(m, "k")
    }
}

fn lt_code(m: *mut MsgBuf, f: *mut Proto) {
    unsafe {
        let code = (*f).code
        for pc in 0..(*f).sizecode {
            let i = *ptr.offset(code, pc as isize)
            let o = op_code(i)
            let a = arg_a(i)
            let b = arg_b(i)
            let c = arg_c(i)
            let ax = arg_ax(i)
            let bx = arg_bx(i)
            let sb = arg_sb(i)
            let sc = arg_sc(i)
            let sbx = arg_sbx(i)
            let isk = arg_k(i)
            let kn = if isk { 1i32 } else { 0i32 }
            let line = lt_line(f, pc)
            msg_str(m, "\t")
            msg_int(m, (pc + 1) as i64)
            msg_str(m, "\t")
            if line > 0 {
                msg_str(m, "[")
                msg_int(m, line as i64)
                msg_str(m, "]\t")
            } else {
                msg_str(m, "[-]\t")
            }
            let name = LT_OPNAMES[o as usize]
            msg_str(m, name)
            let nl = mem.str_bytes(name).len
            for p in nl..9 {
                msg_char(m, 32)
            }
            msg_str(m, "\t")
            extra := 0i32
            if pc + 1 < (*f).sizecode {
                extra = arg_ax(*ptr.offset(code, (pc + 1) as isize))
            }
            if o == OP_MOVE || o == OP_UNM || o == OP_BNOT || o == OP_NOT || o == OP_LEN || o == OP_CONCAT {
                lt_ints(m, a, b)
            } else if o == OP_LOADI || o == OP_LOADF {
                lt_ints(m, a, sbx)
            } else if o == OP_LOADK {
                lt_ints(m, a, bx)
                msg_str(m, "\t; ")
                lt_const(m, f, bx)
            } else if o == OP_LOADKX {
                msg_int(m, a as i64)
                msg_str(m, "\t; ")
                lt_const(m, f, extra)
            } else if o == OP_LOADFALSE || o == OP_LFALSESKIP || o == OP_LOADTRUE || o == OP_CLOSE || o == OP_TBC || o == OP_RETURN1 || o == OP_VARARGPREP {
                msg_int(m, a as i64)
            } else if o == OP_LOADNIL {
                lt_ints(m, a, b)
                msg_str(m, "\t; ")
                msg_int(m, (b + 1) as i64)
                msg_str(m, " out")
            } else if o == OP_GETUPVAL || o == OP_SETUPVAL {
                lt_ints(m, a, b)
                msg_str(m, "\t; ")
                lt_upname(m, f, b)
            } else if o == OP_GETTABUP {
                lt_ints3(m, a, b, c)
                msg_str(m, "\t; ")
                lt_upname(m, f, b)
                msg_str(m, " ")
                lt_const(m, f, c)
            } else if o == OP_GETTABLE || o == OP_GETI || (o >= OP_ADD && o <= OP_SHR) {
                lt_ints3(m, a, b, c)
            } else if o == OP_GETFIELD || (o >= OP_ADDK && o <= OP_BXORK) {
                lt_ints3(m, a, b, c)
                msg_str(m, "\t; ")
                lt_const(m, f, c)
            } else if o == OP_SETTABUP {
                lt_ints3(m, a, b, c)
                lt_kflag(m, isk)
                msg_str(m, "\t; ")
                lt_upname(m, f, a)
                msg_str(m, " ")
                lt_const(m, f, b)
                if isk {
                    msg_str(m, " ")
                    lt_const(m, f, c)
                }
            } else if o == OP_SETTABLE || o == OP_SETI || o == OP_SELF {
                lt_ints3(m, a, b, c)
                lt_kflag(m, isk)
                if isk {
                    msg_str(m, "\t; ")
                    lt_const(m, f, c)
                }
            } else if o == OP_SETFIELD {
                lt_ints3(m, a, b, c)
                lt_kflag(m, isk)
                msg_str(m, "\t; ")
                lt_const(m, f, b)
                if isk {
                    msg_str(m, " ")
                    lt_const(m, f, c)
                }
            } else if o == OP_NEWTABLE {
                lt_ints3(m, a, b, c)
                msg_str(m, "\t; ")
                msg_int(m, (c + extra * (MAXARG_C + 1)) as i64)
            } else if o == OP_ADDI || o == OP_SHRI || o == OP_SHLI {
                lt_ints3(m, a, b, sc)
            } else if o == OP_MMBIN {
                lt_ints3(m, a, b, c)
                msg_str(m, "\t; ")
                msg_str(m, LT_EVENTS[c as usize])
            } else if o == OP_MMBINI {
                lt_ints3(m, a, sb, c)
                msg_char(m, 32)
                msg_int(m, kn as i64)
                msg_str(m, "\t; ")
                msg_str(m, LT_EVENTS[c as usize])
                if isk {
                    msg_str(m, " flip")
                }
            } else if o == OP_MMBINK {
                lt_ints3(m, a, b, c)
                msg_char(m, 32)
                msg_int(m, kn as i64)
                msg_str(m, "\t; ")
                msg_str(m, LT_EVENTS[c as usize])
                msg_str(m, " ")
                lt_const(m, f, b)
                if isk {
                    msg_str(m, " flip")
                }
            } else if o == OP_JMP {
                msg_int(m, arg_sj(i) as i64)
                msg_str(m, "\t; to ")
                msg_int(m, (arg_sj(i) + pc + 2) as i64)
            } else if o == OP_EQ || o == OP_LT || o == OP_LE || o == OP_TESTSET {
                lt_ints3(m, a, b, kn)
            } else if o == OP_EQK {
                lt_ints3(m, a, b, kn)
                msg_str(m, "\t; ")
                lt_const(m, f, b)
            } else if o >= OP_EQI && o <= OP_GEI {
                lt_ints3(m, a, sb, kn)
            } else if o == OP_TEST {
                lt_ints(m, a, kn)
            } else if o == OP_CALL {
                lt_ints3(m, a, b, c)
                msg_str(m, "\t; ")
                if b == 0 {
                    msg_str(m, "all in ")
                } else {
                    msg_int(m, (b - 1) as i64)
                    msg_str(m, " in ")
                }
                if c == 0 {
                    msg_str(m, "all out")
                } else {
                    msg_int(m, (c - 1) as i64)
                    msg_str(m, " out")
                }
            } else if o == OP_TAILCALL {
                lt_ints3(m, a, b, c)
                lt_kflag(m, isk)
                msg_str(m, "\t; ")
                msg_int(m, (b - 1) as i64)
                msg_str(m, " in")
            } else if o == OP_RETURN {
                lt_ints3(m, a, b, c)
                lt_kflag(m, isk)
                msg_str(m, "\t; ")
                if b == 0 {
                    msg_str(m, "all out")
                } else {
                    msg_int(m, (b - 1) as i64)
                    msg_str(m, " out")
                }
            } else if o == OP_RETURN0 {
            } else if o == OP_FORLOOP || o == OP_TFORLOOP {
                lt_ints(m, a, bx)
                msg_str(m, "\t; to ")
                msg_int(m, (pc - bx + 2) as i64)
            } else if o == OP_FORPREP {
                lt_ints(m, a, bx)
                msg_str(m, "\t; exit to ")
                msg_int(m, (pc + bx + 3) as i64)
            } else if o == OP_TFORPREP {
                lt_ints(m, a, bx)
                msg_str(m, "\t; to ")
                msg_int(m, (pc + bx + 2) as i64)
            } else if o == OP_TFORCALL {
                lt_ints(m, a, c)
            } else if o == OP_SETLIST {
                lt_ints3(m, a, b, c)
                if isk {
                    msg_str(m, "\t; ")
                    msg_int(m, (c + extra * (MAXARG_C + 1)) as i64)
                }
            } else if o == OP_CLOSURE {
                lt_ints(m, a, bx)
                msg_str(m, "\t; ")
                lt_ptr(m, *ptr.offset((*f).p, bx as isize))
            } else if o == OP_VARARG {
                lt_ints(m, a, c)
                msg_str(m, "\t; ")
                if c == 0 {
                    msg_str(m, "all out")
                } else {
                    msg_int(m, (c - 1) as i64)
                    msg_str(m, " out")
                }
            } else if o == OP_EXTRAARG {
                msg_int(m, ax as i64)
            }
            msg_str(m, "\n")
        }
    }
}

fn lt_plural(m: *mut MsgBuf, n: i32, word: &str) {
    msg_int(m, n as i64)
    msg_str(m, " ")
    msg_str(m, word)
    if n != 1 {
        msg_str(m, "s")
    }
}

fn lt_header(m: *mut MsgBuf, f: *mut Proto) {
    unsafe {
        let src = (*f).source
        let d = str_data(src)
        msg_str(m, "\n")
        msg_str(m, if (*f).linedefined == 0 { "main" } else { "function" })
        msg_str(m, " <")
        if str_len(src) > 0 && (*d == 64 || *d == 61) {
            msg_bytes(m, ptr.offset(d, 1) as *const u8, str_len(src) - 1)
        } else if str_len(src) > 0 && *d == 27 {
            msg_str(m, "(bstring)")
        } else {
            msg_str(m, "(string)")
        }
        msg_str(m, ":")
        msg_int(m, (*f).linedefined as i64)
        msg_str(m, ",")
        msg_int(m, (*f).lastlinedefined as i64)
        msg_str(m, "> (")
        lt_plural(m, (*f).sizecode, "instruction")
        msg_str(m, " at ")
        lt_ptr(m, f)
        msg_str(m, ")\n")
        msg_int(m, (*f).numparams as i64)
        if (*f).is_vararg != 0 {
            msg_str(m, "+")
        }
        msg_str(m, " param")
        if (*f).numparams != 1 {
            msg_str(m, "s")
        }
        msg_str(m, ", ")
        lt_plural(m, (*f).maxstacksize as i32, "slot")
        msg_str(m, ", ")
        lt_plural(m, (*f).sizeupvalues, "upvalue")
        msg_str(m, ", ")
        lt_plural(m, (*f).sizelocvars, "local")
        msg_str(m, ", ")
        lt_plural(m, (*f).sizek, "constant")
        msg_str(m, ", ")
        lt_plural(m, (*f).sizep, "function")
        msg_str(m, "\n")
    }
}

fn lt_debug(m: *mut MsgBuf, f: *mut Proto) {
    unsafe {
        msg_str(m, "constants (")
        msg_int(m, (*f).sizek as i64)
        msg_str(m, ") for ")
        lt_ptr(m, f)
        msg_str(m, ":\n")
        for i in 0..(*f).sizek {
            msg_str(m, "\t")
            msg_int(m, i as i64)
            msg_str(m, "\t")
            lt_ktype(m, f, i)
            lt_const(m, f, i)
            msg_str(m, "\n")
        }
        msg_str(m, "locals (")
        msg_int(m, (*f).sizelocvars as i64)
        msg_str(m, ") for ")
        lt_ptr(m, f)
        msg_str(m, ":\n")
        for i in 0..(*f).sizelocvars {
            let lv = ptr.offset((*f).locvars, i as isize)
            msg_str(m, "\t")
            msg_int(m, i as i64)
            msg_str(m, "\t")
            msg_lstr(m, (*lv).name)
            msg_str(m, "\t")
            msg_int(m, ((*lv).startpc + 1) as i64)
            msg_str(m, "\t")
            msg_int(m, ((*lv).endpc + 1) as i64)
            msg_str(m, "\n")
        }
        msg_str(m, "upvalues (")
        msg_int(m, (*f).sizeupvalues as i64)
        msg_str(m, ") for ")
        lt_ptr(m, f)
        msg_str(m, ":\n")
        for i in 0..(*f).sizeupvalues {
            let u = ptr.offset((*f).upvalues, i as isize)
            msg_str(m, "\t")
            msg_int(m, i as i64)
            msg_str(m, "\t")
            lt_upname(m, f, i)
            msg_str(m, "\t")
            msg_int(m, (*u).instack as i64)
            msg_str(m, "\t")
            msg_int(m, (*u).index as i64)
            msg_str(m, "\n")
        }
    }
}

fn lt_function(m: *mut MsgBuf, f: *mut Proto) {
    unsafe {
        lt_header(m, f)
        lt_code(m, f)
        lt_debug(m, f)
        for i in 0..(*f).sizep {
            lt_function(m, *ptr.offset((*f).p, i as isize))
        }
    }
}

// --- Binary chunks ------------------------------------------------------------------

fn dw_size(m: *mut MsgBuf, v: usize) {
    tmp: [12]u8 = [0u8; 12]
    n := 0usize
    x := v
    for {
        tmp[n] = (x & 127) as u8
        n = n + 1
        x = x >> 7
        if x == 0 {
            break
        }
    }
    for i in 0usize..n {
        let byte = tmp[n - 1 - i]
        msg_char(m, if i == n - 1 { byte | 128 } else { byte })
    }
}

fn dw_raw8(m: *mut MsgBuf, v: u64) {
    for i in 0u64..8 {
        msg_char(m, ((v >> (i * 8)) & 255) as u8)
    }
}

fn dw_string(m: *mut MsgBuf, s: *mut LString) {
    unsafe {
        if ptr.is_null(s) {
            dw_size(m, 0)
            return
        }
        dw_size(m, str_len(s) + 1)
        msg_lstr(m, s)
    }
}

fn dw_function(m: *mut MsgBuf, f: *mut Proto, psource: *mut LString) {
    unsafe {
        if (*f).source == psource {
            dw_string(m, 0 as *mut LString)
        } else {
            dw_string(m, (*f).source)
        }
        dw_size(m, (*f).linedefined as usize)
        dw_size(m, (*f).lastlinedefined as usize)
        msg_char(m, (*f).numparams)
        msg_char(m, (*f).is_vararg)
        msg_char(m, (*f).maxstacksize)
        dw_size(m, (*f).sizecode as usize)
        for i in 0..(*f).sizecode {
            let ins = *ptr.offset((*f).code, i as isize)
            for b in 0u32..4 {
                msg_char(m, ((ins >> (b * 8)) & 255) as u8)
            }
        }
        dw_size(m, (*f).sizek as usize)
        for i in 0..(*f).sizek {
            let o = ptr.offset((*f).k, i as isize)
            let t = (*o).tag
            msg_char(m, t & 0x3f)
            if t == TAG_FLOAT || t == TAG_INT {
                dw_raw8(m, (*o).bits)
            } else if t == TAG_SHORTSTR || t == TAG_LONGSTR {
                dw_string(m, val_str(o))
            }
        }
        dw_size(m, (*f).sizeupvalues as usize)
        for i in 0..(*f).sizeupvalues {
            let u = ptr.offset((*f).upvalues, i as isize)
            msg_char(m, (*u).instack)
            msg_char(m, (*u).index)
            msg_char(m, (*u).kind)
        }
        dw_size(m, (*f).sizep as usize)
        for i in 0..(*f).sizep {
            dw_function(m, *ptr.offset((*f).p, i as isize), (*f).source)
        }
        dw_size(m, (*f).sizelineinfo as usize)
        for i in 0..(*f).sizelineinfo {
            let li = *ptr.offset((*f).lineinfo, i as isize)
            msg_char(m, (li as i32 & 255) as u8)
        }
        dw_size(m, (*f).sizeabslineinfo as usize)
        for i in 0..(*f).sizeabslineinfo {
            let a = ptr.offset((*f).abslineinfo, i as isize)
            dw_size(m, (*a).pc as usize)
            dw_size(m, (*a).line as usize)
        }
        dw_size(m, (*f).sizelocvars as usize)
        for i in 0..(*f).sizelocvars {
            let lv = ptr.offset((*f).locvars, i as isize)
            dw_string(m, (*lv).name)
            dw_size(m, (*lv).startpc as usize)
            dw_size(m, (*lv).endpc as usize)
        }
        dw_size(m, (*f).sizeupvalues as usize)
        for i in 0..(*f).sizeupvalues {
            dw_string(m, (*ptr.offset((*f).upvalues, i as isize)).name)
        }
    }
}

fn dw_chunk(m: *mut MsgBuf, f: *mut Proto) {
    unsafe {
        msg_str(m, "\x1bLua")
        msg_char(m, 0x54)
        msg_char(m, 0)
        let data = b"\x19\x93\r\n\x1a\n"
        msg_bytes(m, ptr.as_ptr(data), data.len)
        msg_char(m, 4)
        msg_char(m, 8)
        msg_char(m, 8)
        dw_raw8(m, 0x5678)
        dw_raw8(m, f64_bits(370.5))
        msg_char(m, (*f).sizeupvalues as u8)
        dw_function(m, f, 0 as *mut LString)
    }
}

// --- Driver -------------------------------------------------------------------------

// Read a whole file into a fresh buffer; returns null on failure.
fn lt_readfile(L: *mut State, path: *mut u8, size: *mut usize) -> *mut u8 {
    unsafe {
        let fd = lt_open(path as *const u8, 0)
        if fd < 0 {
            return 0 as *mut u8
        }
        cap := 65536usize
        n := 0usize
        buf := malloc(cap)
        for {
            if n == cap {
                buf = realloc(buf, cap * 2)
                cap = cap * 2
            }
            let r = lt_read(fd, ptr.offset(buf, n as isize), cap - n)
            if r <= 0 {
                break
            }
            n = n + r as usize
        }
        lt_close(fd)
        *size = n
        return buf
    }
}

fn lt_cstrlen(p: *mut u8) -> usize {
    unsafe {
        n := 0usize
        for *ptr.offset(p, n as isize) != 0 {
            n = n + 1
        }
        return n
    }
}

fn lt_streq(p: *mut u8, text: &str) -> bool {
    unsafe {
        let b = mem.str_bytes(text)
        for i in 0usize..b.len {
            if *ptr.offset(p, i as isize) != b[i] {
                return false
            }
        }
        return *ptr.offset(p, b.len as isize) == 0
    }
}

fn lt_atoi(p: *mut u8) -> i32 {
    unsafe {
        v := 0i32
        i := 0isize
        for *ptr.offset(p, i) >= 48 && *ptr.offset(p, i) <= 57 {
            v = v * 10 + (*ptr.offset(p, i) - 48) as i32
            i = i + 1
        }
        return v
    }
}

fn lt_err(text: &str) -> i32 {
    unsafe {
        m := msg_new(0 as *mut State)
        let pm = ptr.from_mut(&mut m)
        msg_str(pm, text)
        msg_str(pm, "\n")
        lt_flush(pm, 2)
        return 1
    }
}

pub fn tool_main() -> i32 {
    unsafe {
        let L = malloc(mem.size_of::<State>()) as *mut State
        ptr.write_bytes(L as *mut u8, 0u8, mem.size_of::<State>())
        let argcap = 1usize << 20
        let args = malloc(argcap)
        used := 0usize
        lt_arguments(args, argcap, ptr.from_mut(&mut used))
        argv: [64]*mut u8 = [0 as *mut u8; 64]
        argc := 0usize
        at := 0usize
        for at < used && argc < 64 {
            argv[argc] = ptr.offset(args, at as isize)
            argc = argc + 1
            at = at + lt_cstrlen(ptr.offset(args, at as isize)) + 1
        }
        listing := false
        outpath := 0 as *mut u8
        times := 1i32
        input := 0 as *mut u8
        i := 1usize
        for i < argc {
            let a = argv[i]
            if lt_streq(a, "-l") {
                listing = true
            } else if lt_streq(a, "-o") && i + 1 < argc {
                i = i + 1
                outpath = argv[i]
            } else if lt_streq(a, "-t") && i + 1 < argc {
                i = i + 1
                times = lt_atoi(argv[i])
            } else {
                input = a
            }
            i = i + 1
        }
        if ptr.is_null(input) {
            return lt_err("usage: luatool [-l] [-o out] [-t N] file.lua")
        }
        size := 0usize
        let text = lt_readfile(L, input, ptr.from_mut(&mut size))
        if ptr.is_null(text) {
            return lt_err("luatool: cannot read input")
        }
        // Like luaL_loadfile: skip a UTF-8 BOM and a first line starting
        // with '#' (keeping its newline so line numbers stay right).
        start := 0usize
        if size >= 3 && *text == 0xEF && *ptr.offset(text, 1) == 0xBB && *ptr.offset(text, 2) == 0xBF {
            start = 3
        }
        if start < size && *ptr.offset(text, start as isize) == 35 {
            for start < size && *ptr.offset(text, start as isize) != 10 {
                start = start + 1
            }
        }
        let inlen = lt_cstrlen(input)
        let name = malloc(inlen + 1)
        *name = 64
        ptr.copy_nonoverlapping(input as *const u8, ptr.offset(name, 1), inlen)
        let chunkname = str_new(L, name as *const u8, inlen + 1)!
        let t0 = lt_clock()
        fp := 0 as *mut Proto
        for rep in 0..times {
            match compile(L, ptr.offset(text, start as isize), size - start, chunkname) {
                ok(p) => {
                    fp = p
                },
                err(_) => {
                    m := msg_new(L)
                    let pm = ptr.from_mut(&mut m)
                    msg_str(pm, "luatool: ")
                    let ev = ptr.offset(L as *mut u8, mem.offset_of::<State>("errobj") as isize) as *mut Value
                    if ((*ev).tag & 15) == TYPE_STRING {
                        msg_lstr(pm, val_str(ev))
                    } else {
                        msg_str(pm, "not enough memory")
                    }
                    msg_str(pm, "\n")
                    lt_flush(pm, 2)
                    return 1
                },
            }
        }
        let t1 = lt_clock()
        m := msg_new(L)
        let pm = ptr.from_mut(&mut m)
        if times > 1 {
            msg_str(pm, "compile time per run (us): ")
            msg_int(pm, ((t1 - t0) / (times as u64)) as i64)
            msg_str(pm, "\n")
            lt_flush(pm, 2)
        }
        if listing {
            lt_function(pm, fp)
            lt_flush(pm, 1)
        }
        if !ptr.is_null(outpath) {
            dw_chunk(pm, fp)
            let fd = lt_creat(outpath as *const u8, 420)
            if fd < 0 {
                return lt_err("luatool: cannot open output")
            }
            lt_flush(pm, fd)
            lt_close(fd)
        }
        return 0
    }
}
