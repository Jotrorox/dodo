package main

import "core/ptr"
import "std/embedded/board"
import "core/mem"
import "std/embedded/chip"
import "std/embedded/chip/rp_adc"
import "std/embedded/chip/rp_dma"
import "std/embedded/chip/rp_multicore"
import "std/embedded/chip/rp_pio"
import "std/embedded/cortex_m"
import "std/embedded/executor"
import "std/embedded/hal"
import "std/embedded/peripheral/designware_i2c"
import "std/embedded/peripheral/pl011"
import "std/embedded/peripheral/pl022"
import "std/embedded/power"
import "std/io"
import "std/sync/atomic"

// Hardware self-test for the `pico2_w` board: the RP2350 startup runtime,
// std/embedded/chip/rp2350 (clocks, timer, I2C, SPI, UART, PWM, the ADC,
// PIO, the USB serial port, core 1 with the FIFOs and spinlocks, single
// ownership, configuration checks), std/embedded/board/pico2_w with the CYW43439 driver in
// std/embedded/wireless/cyw43 (gSPI bus bring-up, the LED and USB-power GPIOs
// of the wireless chip), and the runtime's integer and floating-point helpers.
// Every outcome ends in the USB bootloader with a record that
// `scripts/test_pico.py --board pico2_w` reads over USB with picotool. The
// RP2350 boot ROM clears SRAM when it starts, so the record is staged at
// RECORD in SRAM and written to the last flash sector before rebooting. Words
// of the record:
//
//   [0] 0x600D_00nn  finished after nn checks; [1] = failed-check bits
//       0xDEAD_llll  panicked at line llll;    [1] = column
//       0x5747_00nn  hung or faulted after check nn (watchdog reset)
//   [2] clk_sys in kHz  [3] a 10 ms delay in timer us  [4] its SysTick cycles
//   [5] failed-check bits for checks 32 to 63
//   [6] microseconds for 100 LED toggles over gSPI
//   [7] failed-check bits for checks 64 to 95
//   [8] to [23] after a panic: the end of the file's path, NUL-terminated
//   [24] failed-check bits for checks 96 to 127
//
// A copy of [0] and [1] in watchdog SCRATCH0/1 survives the watchdog reset
// that reports a hang. (The boot ROM's reboot uses SCRATCH2 to 7.)

const RECORD: usize = 0x2007_0000
// The last 4 KiB sector of the Pico 2 W's flash, by its execute-in-place
// address. (Without a partition table, flash_op refuses storage offsets.)
const FLASH_RECORD: u32 = 0x103F_F000
// Boot ROM flash_op ('F' | 'O' << 8): erase or program, secure, at a
// runtime (execute-in-place) address.
const ROM_FLASH_OP: u32 = 0x4F46
const FLASH_ERASE: u32 = 0x0_0101
const FLASH_PROGRAM: u32 = 0x1_0101
const WATCHDOG: usize = 0x400D_8000
const SCRATCH: usize = WATCHDOG + 0x0C
const RUNNING: u32 = 0x5747_0000
const FILE_OFFSET: usize = 32
const FILE_BYTES: usize = 64
static mut CHECKS: u32 = 0
// Failed-check bits: checks 0 to 31, 32 to 63, 64 to 95, and 96 to 127.
static mut FAILURES: u32 = 0
static mut MORE_FAILURES: u32 = 0
static mut LAST_FAILURES: u32 = 0
static mut EXTRA_FAILURES: u32 = 0
// Initialized data: checks that the reset handler copies .data from flash.
static mut DATA: [3]u32 = [0xDEAD_BEEFu32, 7, 0x1234_5678]

fn store(address: usize, value: u32) {
    // SAFETY: RECORD is SRAM this program never otherwise uses, and the
    // watchdog scratch registers are free for software.
    unsafe {
        word: hal.Reg<u32> = hal.Reg.at(address)
        word.write(value)
    }
}

fn record(state: u32, detail: u32) {
    store(RECORD, state)
    store(RECORD + 4, detail)
    store(SCRATCH, state)
    store(SCRATCH + 4, detail)
}

// Provided by the compiler's RP2350 firmware runtime.
unsafe extern "C" fn dodo_rp2350_rom_call(code: u32, a0: u32, a1: u32, a2: u32, a3: u32) -> i32

// Write the 256-byte record page to flash and restart into the bootloader.
// flash_op leaves flash in execute-in-place mode, so this code keeps
// running from flash.
fn report() {
    unsafe {
        dodo_rp2350_rom_call(ROM_FLASH_OP, FLASH_ERASE, FLASH_RECORD, 4096, 0)
        dodo_rp2350_rom_call(ROM_FLASH_OP, FLASH_PROGRAM, FLASH_RECORD, 256, RECORD as u32)
    }
    board.reboot_to_bootloader()
}

fn check(ok: bool) {
    unsafe {
        if !ok && CHECKS < 32 {
            FAILURES |= 1u32 << CHECKS
        } else if !ok && CHECKS < 64 {
            MORE_FAILURES |= 1u32 << (CHECKS - 32)
        } else if !ok && CHECKS < 96 {
            LAST_FAILURES |= 1u32 << (CHECKS - 64)
        } else if !ok && CHECKS < 128 {
            EXTRA_FAILURES |= 1u32 << (CHECKS - 96)
        }
        CHECKS += 1
        record(RUNNING | CHECKS, FAILURES)
    }
}

// Replaces the board runtime's default panic hook. Panics in the standard
// library report their own file, so the end of its path goes in the record
// too.
extern "C" fn dodo_board_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
    record(0xDEAD_0000 | (line & 0xFFFF), column)
    unsafe {
        length := 0usize
        for ptr.read(ptr.offset(file, length as isize)) != 0 && length < 1024 {
            length += 1
        }
        start := 0usize
        if length > FILE_BYTES - 1 {
            start = length - (FILE_BYTES - 1)
        }
        for index in 0..FILE_BYTES {
            byte: hal.Reg<u8> = hal.Reg.at(RECORD + FILE_OFFSET + index)
            if start + index < length {
                byte.write(ptr.read(ptr.offset(file, (start + index) as isize)))
            } else {
                byte.write(0)
            }
        }
    }
    report()
}

// clk_sys in kHz from the CLOCKS frequency counter, against clk_ref.
fn clk_sys_khz() -> u32 {
    unsafe {
        reference: hal.Reg<u32> = hal.Reg.at(0x4001_008C)
        minimum: hal.Reg<u32> = hal.Reg.at(0x4001_0090)
        maximum: hal.Reg<u32> = hal.Reg.at(0x4001_0094)
        interval: hal.Reg<u32> = hal.Reg.at(0x4001_009C)
        source: hal.Reg<u32> = hal.Reg.at(0x4001_00A0)
        status: hal.Reg<u32> = hal.Reg.at(0x4001_00A4)
        result: hal.Reg<u32> = hal.Reg.at(0x4001_00A8)
        reference.write(12_000)
        interval.write(10)
        minimum.write(0)
        maximum.write(0xFFFF_FFFF)
        source.write(0x09)
        match status.wait_set(1 << 4, 10_000_000) {
            ok() => {}
            err(_) => {
                return 0
            }
        }
        return result.read() >> 5
    }
}

// A claim was refused with `expected`.
fn refused<T>(result: T!hal.Error, expected: hal.Error) -> bool {
    match result {
        ok(_) => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

// A bus operation failed with `expected`.
fn failed_with(result: void!hal.Error, expected: hal.Error) -> bool {
    match result {
        ok() => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

// I2C and SPI on the board's usual pins with nothing connected (13 checks):
// pin and frequency validation, single ownership, an I2C address that no
// device acknowledges, SPI through the controller's internal loopback, and
// giving the buses back and claiming them again.
fn bus_checks<P, T>(pins: &mut P, timer: &mut T) {
    sda := board.I2C_SDA_PIN
    scl := board.I2C_SCL_PIN
    standard := hal.I2C_STANDARD_HZ
    check(refused(pins.i2c(scl, sda, standard), hal.Error.InvalidInput) && refused(pins.i2c(sda, sda + 3, standard), hal.Error.InvalidInput) && refused(pins.i2c(sda, scl, 2_000_000), hal.Error.InvalidInput))
    i2c := pins.i2c(sda, scl, standard)!
    check(i2c.frequency_hz() == standard)
    // GP8 and GP9 are I2C0 too.
    check(refused(pins.i2c(8, 9, standard), hal.Error.Busy) && refused(pins.output(sda), hal.Error.Busy))
    // No device answers the reserved address 0x7C. The pads' pull-ups keep
    // the idle bus high, so the controller sees a missing acknowledge, not
    // a fault, and it ends the transaction itself.
    byte: [1]u8 = [0]
    start := timer.now_us()
    check(failed_with(i2c.read(0x7C, &mut byte), hal.Error.NoAcknowledge))
    elapsed := timer.now_us() - start
    // START, the address byte and its acknowledge bit at 100 kHz, STOP.
    check(elapsed >= 90 && elapsed < 500)
    register: [1]u8 = [0]
    check(failed_with(i2c.write(0x7C, &register), hal.Error.NoAcknowledge) && failed_with(i2c.write_read(0x7C, &register, &mut byte), hal.Error.NoAcknowledge))

    clock := board.SPI_CLOCK_PIN
    tx := board.SPI_TX_PIN
    rx := board.SPI_RX_PIN
    check(refused(pins.spi(tx, clock, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput) && refused(pins.spi(clock, tx, some(board.SPI_SELECT_PIN), hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput))
    spi := pins.spi(clock, tx, some(rx), hal.SpiMode.Mode0, 1_000_000)!
    spi.set_loopback(true)
    data: [16]u8 = [0; 16]
    sent: [16]u8 = [0; 16]
    for index in 0..16usize {
        data[index] = (0xA5 ^ (17 * index)) as u8
        sent[index] = data[index]
    }
    start = timer.now_us()
    spi.transfer(&mut data)!
    elapsed = timer.now_us() - start
    same := true
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    check(same && refused(pins.spi(2, 3, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.Busy))
    // 128 bits at just under 1 MHz, back to back.
    check(spi.frequency_hz() <= 1_000_000 && spi.frequency_hz() > 990_000 && elapsed >= 128 && elapsed < 200)
    spi.set_mode(hal.SpiMode.Mode3)
    spi.write(&sent)!
    spi.transfer(&mut data)!
    // A single byte, as when reading one register, starts on an idle
    // controller.
    one: [1]u8 = [0x3C]
    spi.transfer(&mut one)!
    same = one[0] == 0x3C
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    check(same)

    // Released buses give back their pins and controllers. SCL can then be
    // clocked by hand, as to free a device stuck holding SDA low, while the
    // pads keep both lines pulled up; then the buses work again.
    pins.release_i2c(i2c)
    pins.release_spi(spi)
    clock_line := pins.output(scl)!
    data_line := pins.input(sda)!
    for _ in 0..9 {
        clock_line.set_low()
        timer.delay_us(5)
        clock_line.set_high()
        timer.delay_us(5)
    }
    check(clock_line.is_high() && data_line.is_high())
    pins.release(clock_line)
    pins.release(data_line)
    i2c_again := pins.i2c(sda, scl, standard)!
    check(failed_with(i2c_again.read(0x7C, &mut byte), hal.Error.NoAcknowledge))
    spi_again := pins.spi(clock, tx, some(rx), hal.SpiMode.Mode0, 1_000_000)!
    spi_again.set_loopback(true)
    one[0] = 0x5A
    spi_again.transfer(&mut one)!
    check(one[0] == 0x5A)
    pins.release_i2c(i2c_again)
    pins.release_spi(spi_again)
}

// A serial port on the board's usual pins with nothing connected (6
// checks): pin and baud rate validation, single ownership, the controller's
// internal loopback timed at 115200 baud, newline translation, 8E2 frames
// at 1 Mbaud through a full receive FIFO and the overrun after it, and
// giving the port back and claiming it again.
fn uart_checks<P, T>(pins: &mut P, timer: &mut T) {
    tx := board.UART_TX_PIN
    rx := board.UART_RX_PIN
    check(refused(pins.uart(rx, some(tx), 115_200), hal.Error.InvalidInput) && refused(pins.uart(tx, some(5u32), 115_200), hal.Error.InvalidInput) && refused(pins.uart(tx, some(rx), 10_000_000), hal.Error.InvalidInput))
    serial := pins.uart(tx, some(rx), 115_200)!
    // GP12 is UART0's too.
    check(serial.baud() == 115_207 && refused(pins.uart(12, none, 9600), hal.Error.Busy) && refused(pins.output(tx), hal.Error.Busy))

    serial.set_loopback(true)!
    sent: [16]u8 = [0; 16]
    for index in 0..16usize {
        sent[index] = (0x3C + 13 * index) as u8
    }
    start := timer.now_us()
    serial.write(&sent)!
    serial.flush()!
    elapsed := timer.now_us() - start
    data: [16]u8 = [0; 16]
    io.read_exact(&mut serial, &mut data)!
    same := true
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    // 16 frames of 10 bits at 115207 baud: 1389 us.
    check(same && elapsed >= 1385 && elapsed < 1450)

    // "\n" goes out as "\r\n", which reads back as one "\n".
    serial.set_crlf(true)
    serial.write(b"a\nb")!
    serial.flush()!
    three: [3]u8 = [0; 3]
    io.read_exact(&mut serial, &mut three)!
    empty := serial.poll_read(&mut data)!
    check(three[0] == 97 && three[1] == 10 && three[2] == 98 && empty.transferred == 0 && empty.state == io.PollState.Pending)
    serial.set_crlf(false)

    // 40 frames of 12 bits (start, 8 data, parity, 2 stop) at exactly
    // 1 Mbaud take 480 us; the receive FIFO keeps the first 32, and the
    // rest are an overrun, reported once.
    serial.set_format(8, pl011.Parity.Even, 2)!
    serial.set_baud(1_000_000)!
    burst: [40]u8 = [0; 40]
    for index in 0..40usize {
        burst[index] = (6 * index) as u8
    }
    start = timer.now_us()
    serial.write(&burst)!
    serial.flush()!
    elapsed = timer.now_us() - start
    back: [40]u8 = [0; 40]
    received := 0usize
    overruns := 0u32
    for {
        match serial.poll_read(&mut back[received..]) {
            ok(progress) => {
                received += progress.transferred
                if progress.transferred == 0 {
                    break
                }
            }
            err(error) => {
                received += error.transferred
                if error.code == pl011.OVERRUN {
                    overruns += 1
                } else {
                    overruns += 100
                }
            }
        }
    }
    same = received == 32 && overruns == 1
    for index in 0..32usize {
        same = same && back[index] == burst[index]
    }
    check(same && serial.baud() == 1_000_000 && elapsed >= 478 && elapsed < 520)

    // Released, the pins stay pulled up, so the line idles high; then the
    // port is claimed again, to send only.
    serial.set_loopback(false)!
    pins.release_uart(serial)
    line := pins.input(tx)!
    high := line.is_high()
    pins.release(line)
    again := pins.uart(tx, none, 115_200)!
    again.write(b"dodo\r\n")!
    again.flush()!
    check(high && again.baud() == 115_207)
    pins.release_uart(again)
}

// The protocol options with nothing connected (7 checks): 10-bit I2C
// addresses and probes, an I2C target, SPI with the controller's own chip
// select in 12-bit Motorola and 16-bit TI frames through the internal
// loopback, an SPI target without a master, a break through the UART's
// loopback, and the flow control pins of a serial port.
fn protocol_checks<P, T>(pins: &mut P, timer: &mut T) {
    sda := board.I2C_SDA_PIN
    scl := board.I2C_SCL_PIN
    i2c := pins.i2c(sda, scl, hal.I2C_STANDARD_HZ)!
    // Nobody answers a 10-bit address or 0x7C, and probing says so.
    data: [1]u8 = [0]
    absent := !i2c.probe(0x7C)!
    check(absent && failed_with(i2c.write_ten_bit(0x2A5, &data), hal.Error.NoAcknowledge) && failed_with(i2c.read_ten_bit(0x2A5, &mut data), hal.Error.NoAcknowledge))
    pins.release_i2c(i2c)

    // A target takes the pins, refuses reserved addresses, and has nothing
    // to report while no master talks to it.
    reserved := refused(pins.i2c_target(sda, scl, 0x7A, false, hal.I2C_FAST_HZ), hal.Error.InvalidInput)
    target := pins.i2c_target(sda, scl, 0x42, false, hal.I2C_FAST_HZ)!
    buffer: [4]u8 = [0; 4]
    idle := true
    for _ in 0..100 {
        match target.poll(&mut buffer) {
            designware_i2c.TargetEvent.Idle => {}
            _ => {
                idle = false
            }
        }
    }
    check(reserved && idle && refused(pins.i2c(sda, scl, hal.I2C_STANDARD_HZ), hal.Error.Busy))
    pins.release_i2c_target(target)

    // SPI1 on GPIO 10 to 13, with GPIO 13 as its hardware chip select.
    select_refused := refused(pins.spi_with_select(10, 11, some(12u32), 17, hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput)
    spi := pins.spi_with_select(10, 11, some(12u32), 13, hal.SpiMode.Mode1, 1_000_000)!
    spi.set_loopback(true)
    spi.set_frame_bits(12)!
    words: [8]u16 = [0; 8]
    for index in 0..8usize {
        words[index] = (0x0A5 * (index + 1)) as u16
    }
    spi.transfer_words(&mut words)!
    same := true
    for index in 0..8usize {
        same = same && words[index] == ((0x0A5 * (index + 1)) & 0xFFF) as u16
    }
    bytes: [2]u8 = [1, 2]
    check(select_refused && same && failed_with(spi.transfer(&mut bytes), hal.Error.Unsupported))
    spi.set_frame_format(pl022.FrameFormat.TexasInstruments)
    spi.set_frame_bits(16)!
    wide: [4]u16 = [0xFFFF, 0x8001, 0x1234, 0xFEDC]
    start := timer.now_us()
    spi.transfer_words(&mut wide)!
    elapsed := timer.now_us() - start
    // 64 bits at just under 1 MHz, plus the frame pulses.
    check(wide[0] == 0xFFFF && wide[1] == 0x8001 && wide[2] == 0x1234 && wide[3] == 0xFEDC && elapsed >= 64 && elapsed < 120)
    pins.release_spi(spi)

    // A target queues what its transmit FIFO holds and, with no master
    // clocking, receives nothing.
    spi_target := pins.spi_target(10, 11, some(12u32), 13, hal.SpiMode.Mode3)!
    replies: [10]u8 = [0x55; 10]
    queued := spi_target.queue(&replies)!
    received := spi_target.read(&mut buffer)!
    check(queued == 8 && received == 0 && refused(pins.spi(10, 11, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.Busy))
    pins.release_spi_target(spi_target)

    // A break through the loopback reads as BREAK, and the port goes on.
    tx := board.UART_TX_PIN
    rx := board.UART_RX_PIN
    serial := pins.uart(tx, some(rx), 115_200)!
    serial.set_loopback(true)!
    serial.set_break(true)!
    timer.delay_us(200)
    serial.set_break(false)!
    timer.delay_us(100)
    broke := false
    match serial.poll_read(&mut buffer) {
        ok(_) => {}
        err(error) => {
            broke = (error.code & pl011.BREAK) != 0
        }
    }
    serial.write(b"ok")!
    serial.flush()!
    two: [2]u8 = [0; 2]
    io.read_exact(&mut serial, &mut two)!
    check(broke && two[0] == 111 && two[1] == 107)
    serial.set_loopback(false)!
    pins.release_uart(serial)

    // Flow control owns CTS and RTS too. With nothing on CTS the
    // transmitter would wait forever, so it is turned off before anything
    // is sent.
    flow_refused := refused(pins.uart_flow(tx, rx, rx + 2, rx + 1, 115_200), hal.Error.InvalidInput)
    flow := pins.uart_flow(tx, rx, rx + 1, rx + 2, 115_200)!
    taken := refused(pins.output(rx + 2), hal.Error.Busy)
    flow.set_flow_control(false, false)!
    flow.write(b"\r\n")!
    flow.flush()!
    pins.release_uart(flow)
    free := pins.output(rx + 2)!
    pins.release(free)
    check(flow_refused && taken)
}

// Interrupts: `@interrupt` handlers, std/embedded/cortex_m, a timer alarm,
// and a function placed in SRAM.
static mut ALARM: Option<chip.Alarm> = none
static mut ALARM_HITS: u32 = 0
// Counted with an atomic, which the handler and main share without a
// critical section or `unsafe`.
static PENDED_HITS: atomic.Atomic<u32> = atomic.Atomic.new(0u32)

@interrupt(TIMER0_IRQ_0)
fn alarm_fired() {
    unsafe {
        ALARM_HITS += 1
        match &mut ALARM {
            some(alarm) => {
                alarm.clear()
            }
            none => {}
        }
    }
}

// Nothing else raises TRNG_IRQ; the checks pend it from software.
@interrupt(TRNG_IRQ)
fn pended() {
    PENDED_HITS.fetch_add(1, atomic.Ordering.AcqRel)!
}

fn alarm_hits() -> u32 {
    return unsafe {
        ALARM_HITS
    }
}

fn pended_hits() -> u32 {
    return PENDED_HITS.load(atomic.Ordering.Acquire)!
}

@section(".ramfunc")
fn from_sram(value: u32) -> u32 {
    return core.wrapping_mul(value, 3) + 1
}

fn interrupt_checks(timer: &mut chip.Timer) {
    // A pended interrupt waits until it is enabled, then runs once; masked,
    // it waits for the critical section to end.
    cortex_m.pend(chip.TRNG_IRQ)
    waiting := cortex_m.is_pending(chip.TRNG_IRQ) && pended_hits() == 0
    cortex_m.enable(chip.TRNG_IRQ)
    cortex_m.instruction_barrier()
    check(waiting && pended_hits() == 1 && !cortex_m.is_pending(chip.TRNG_IRQ) && cortex_m.is_enabled(chip.TRNG_IRQ))
    section := hal.Critical.enter()
    cortex_m.pend(chip.TRNG_IRQ)
    cortex_m.instruction_barrier()
    held := cortex_m.interrupts_masked() && pended_hits() == 1
    core.drop(section)
    cortex_m.instruction_barrier()
    check(held && pended_hits() == 2 && !cortex_m.interrupts_masked())
    cortex_m.disable(chip.TRNG_IRQ)
    cortex_m.set_priority(chip.TRNG_IRQ, 0x80)
    check(!cortex_m.is_enabled(chip.TRNG_IRQ) && cortex_m.priority(chip.TRNG_IRQ) == 0x80 && cortex_m.active_exception() == 0)
    cortex_m.set_priority(chip.TRNG_IRQ, 0)

    // Alarm 0, 2 ms ahead, raises its interrupt once.
    alarm := timer.alarm(0)!
    check(refused(timer.alarm(0), hal.Error.Busy) && refused(timer.alarm(chip.ALARM_COUNT), hal.Error.InvalidInput))
    irq := alarm.irq()
    alarm.listen()
    start := timer.now_us()
    alarm.schedule_in(2000)
    armed := alarm.is_armed() && alarm.is_listening()
    unsafe {
        ALARM = some(alarm)
    }
    cortex_m.enable(irq)
    for alarm_hits() == 0 && timer.now_us() - start < 10_000 {}
    elapsed := timer.now_us() - start
    timer.delay_us(3000)
    cortex_m.disable(irq)
    back := unsafe {
        mem.replace(&mut ALARM, none)
    }
    match back {
        some(alarm) => {
            check(armed && alarm_hits() == 1 && !alarm.fired() && !alarm.is_armed() && elapsed >= 1900 && elapsed < 2600)
            timer.release_alarm(alarm)
        }
        none => {
            check(false)
        }
    }
    check(from_sram(5) == 16)
}

// The executor: a timer alarm as its clock, GPIO events, and tasks woken by
// time and by an interrupt. GP22 is free on every board.
const EVENT_PIN: u32 = 22
const EDGE: executor.Signal = executor.Signal { id: 0 }

@interrupt(IO_IRQ_BANK0)
fn gpio_event() {
    cortex_m.disable(chip.IO_IRQ_BANK0)
    EDGE.raise()
}

// Finishes after five 1 ms ticks.
struct Ticks {
    ticker: executor.Ticker
    count: u32

    pub fn poll(&mut self, cx: &mut executor.Context) -> executor.Poll {
        if self.ticker.ready(cx) {
            self.count += 1
            if self.count == 5 {
                return executor.Poll.Ready
            }
        }
        return executor.Poll.Pending
    }
}

// Raises its pin 2 ms after its first poll.
struct Driver {
    pin: chip.Pin
    timer: executor.Timer
    started: bool
    raised_at: u64

    pub fn poll(&mut self, cx: &mut executor.Context) -> executor.Poll {
        if !self.started {
            self.started = true
            self.timer.start(cx, 2000)
        }
        if self.timer.expired(cx) {
            self.pin.set_high()
            self.raised_at = cx.now_us()
            return executor.Poll.Ready
        }
        return executor.Poll.Pending
    }

    fn release(self) -> chip.Pin {
        let Driver { pin, timer, started, raised_at } = self
        return pin
    }
}

// Finishes once the pin's edge has raised EDGE through its interrupt.
struct Listener {
    polls: u32
    woke_at: u64

    pub fn poll(&mut self, cx: &mut executor.Context) -> executor.Poll {
        self.polls += 1
        if EDGE.take(cx) {
            self.woke_at = cx.now_us()
            return executor.Poll.Ready
        }
        return executor.Poll.Pending
    }
}

fn executor_checks(pins: &mut chip.Pins, timer: &mut chip.Timer) {
    // An alarm sleeps until its deadline; its interrupt, whose handler is
    // the runtime's endless loop, is never taken.
    alarm := timer.alarm(1)!
    irq := alarm.irq()
    start := alarm.now_us()
    alarm.sleep_until(some(start + 2000))
    slept := alarm.now_us() - start
    check(slept >= 2000 && slept < 2100 && !alarm.fired() && !alarm.is_armed() && !alarm.is_listening() && !cortex_m.is_pending(irq) && !cortex_m.is_enabled(irq))

    // A time already past returns at once, and so does a pending interrupt,
    // whose handler runs when the critical section ends.
    start = alarm.now_us()
    alarm.sleep_until(some(start))
    past := alarm.now_us() - start
    cortex_m.enable(chip.TRNG_IRQ)
    hits := pended_hits()
    section := hal.Critical.enter()
    cortex_m.pend(chip.TRNG_IRQ)
    start = alarm.now_us()
    alarm.sleep_until(some(start + 5000))
    woke := alarm.now_us() - start
    held := pended_hits() == hits
    core.drop(section)
    cortex_m.instruction_barrier()
    cortex_m.disable(chip.TRNG_IRQ)
    check(past < 50 && woke < 1000 && held && pended_hits() == hits + 1)

    // GPIO events: an output pin sees its own edges and levels.
    pin := pins.output(EVENT_PIN)!
    pin.listen(chip.RISING_EDGE | chip.LEVEL_HIGH)
    cortex_m.unpend(chip.IO_IRQ_BANK0)
    quiet := pin.events() == 0 && !cortex_m.is_pending(chip.IO_IRQ_BANK0)
    pin.set_high()
    timer.delay_us(10)
    raised := pin.events() == (chip.RISING_EDGE | chip.LEVEL_HIGH) && cortex_m.is_pending(chip.IO_IRQ_BANK0)
    pin.clear_events(chip.RISING_EDGE)
    level := pin.events() == chip.LEVEL_HIGH
    pin.set_low()
    timer.delay_us(10)
    pin.ignore(chip.LEVEL_HIGH)
    cortex_m.unpend(chip.IO_IRQ_BANK0)
    check(quiet && raised && level && pin.events() == 0 && !cortex_m.is_pending(chip.IO_IRQ_BANK0))

    // Three tasks: one on a 1 ms ticker, one that raises the pin after
    // 2 ms, and one woken only by the pin's interrupt.
    EDGE.reset()
    cortex_m.enable(chip.IO_IRQ_BANK0)
    ticks := Ticks { ticker: executor.Ticker.every(1000), count: 0 }
    driver := Driver { pin, timer: executor.Timer.new(), started: false, raised_at: 0 }
    listener := Listener { polls: 0, woke_at: 0 }
    runner := executor.Executor.new()
    start = alarm.now_us()
    end := start + 20_000
    finished := false
    {
        tasks: [3] &mut dyn executor.Task = [&mut listener, &mut ticks, &mut driver]
        finished = runner.run_until(&mut tasks, &mut alarm, end)
    }
    elapsed := alarm.now_us() - start
    raised_at := driver.raised_at
    pin = driver.release()
    latched := (pin.events() & chip.RISING_EDGE) != 0
    check(finished && ticks.count == 5 && elapsed >= 5000 && elapsed < 5500 && listener.polls == 2 && listener.woke_at >= raised_at && listener.woke_at - raised_at < 500 && runner.sleeps() >= 5 && latched && !cortex_m.is_enabled(chip.IO_IRQ_BANK0))
    pins.release(pin)
    cortex_m.unpend(chip.IO_IRQ_BANK0)
    timer.release_alarm(alarm)
}

// The level of GPIO `pin`, from the single-cycle I/O block's input register,
// which reads the pad whatever drives it.
fn pin_level(pin: u32) -> bool {
    // SAFETY: GPIO_IN is read-only.
    unsafe {
        input: hal.Reg<u32> = hal.Reg.at(0xD000_0004)
        return input.any(1u32 << pin)
    }
}

// The share of 1000 samples, 10 us apart, at which GPIO `pin` is high.
fn high_samples(pin: u32, timer: &mut chip.Timer) -> u32 {
    high := 0u32
    for _ in 0..1000 {
        if pin_level(pin) {
            high += 1
        }
        timer.delay_us(10)
    }
    return high
}

// PWM and the ADC with nothing connected (3 checks): pin, frequency, and
// output validation and ownership; an output's level read back from its pad
// at duties 0, 50%, and full, and inverted; ADC inputs and the temperature
// sensor.
fn pwm_adc_checks(pins: &mut chip.Pins, timer: &mut chip.Timer) {
    // GP14 and GP15 are outputs A and B of slice 7; GP31 does not exist.
    led := pins.pwm(15, 1000)!
    validated := refused(pins.pwm(30, 1000), hal.Error.InvalidInput) && refused(pins.pwm(14, 7), hal.Error.InvalidInput) && refused(pins.pwm(14, 100_000_000), hal.Error.InvalidInput)
    owned := refused(pins.pwm(15, 1000), hal.Error.Busy) && refused(pins.output(15), hal.Error.Busy) && refused(pins.pwm(14, 2000), hal.Error.Busy)
    other := pins.pwm(14, 1000)!
    check(validated && owned && led.frequency_hz() == 1000 && led.max_duty() == other.max_duty() && led.slice() == 7 && led.output() == 1)
    pins.release_pwm(other)

    // Compare values take effect at the next wrap, 1 ms away at most.
    timer.delay_ms(2)
    low := !pin_level(15)
    full := led.max_duty()
    led.set_duty(full)!
    timer.delay_ms(2)
    high := pin_level(15)
    hal.set_duty_percent(&mut led, 50)!
    timer.delay_ms(2)
    half := high_samples(15, timer)
    led.set_duty(0)!
    led.set_inverted(true)
    timer.delay_ms(2)
    inverted := pin_level(15)
    led.set_inverted(false)
    pins.release_pwm(led)
    again := pins.pwm(15, 50)!
    pins.release_pwm(again)
    check(low && high && half > 420 && half < 580 && inverted)

    // Inputs on GP26 and GP27 float, so any value will do; the sensor reads
    // room temperature, give or take, and conversions take 2 us at 48 MHz.
    knob := pins.analog(26)!
    inputs_owned := refused(pins.analog(25), hal.Error.InvalidInput) && refused(pins.analog(26), hal.Error.Busy) && refused(pins.output(26), hal.Error.Busy)
    second := pins.analog(27)!
    sensor := pins.temperature()!
    sensor_owned := refused(pins.temperature(), hal.Error.Busy)
    start := timer.now_us()
    in_range := true
    for _ in 0..100 {
        in_range = in_range && knob.read()! <= 4095 && second.read()! <= 4095
    }
    elapsed := timer.now_us() - start
    celsius := rp_adc.millicelsius(sensor.read()!, 3300)
    pins.release_analog(knob)
    pins.release_analog(second)
    pins.release_analog(sensor)
    pin := pins.output(26)!
    pins.release(pin)
    knob = pins.analog(26)!
    restarted := knob.read()! <= 4095
    pins.release_analog(knob)
    check(inputs_owned && sensor_owned && in_range && restarted && elapsed >= 400 && elapsed < 1500 && celsius > 0 && celsius < 70_000)
}

// PIO programs for pio_checks: one that echoes each word inverted, and a
// square wave on its side-set pin, half high and half low, that sets IRQ
// flag 0 each period.
const ECHO: rp_pio.Program = rp_pio.assemble(
    "    pull block",
    "    mov isr, ~osr",
    "    push block",
)
const SQUARE: rp_pio.Program = rp_pio.assemble(
    ".side_set 1",
    "    irq 0   side 1 [15]",
    "    nop     side 0 [15]",
)
const FILLER: rp_pio.Program = rp_pio.assemble(".origin 0", "nop [1]", "nop [2]", "nop [3]", "nop [4]", "nop [5]", "nop [6]", "nop [7]", "nop [8]", "nop [9]", "nop [10]", "nop [11]", "nop [12]", "nop [13]", "nop [14]", "nop [15]", "nop [16]", "nop [17]", "nop [18]", "nop [19]", "nop [20]", "nop [21]", "nop [22]", "nop [23]", "nop [24]", "nop [25]", "nop [26]", "nop [27]")
// The RP2350's RX FIFO registers: register 1 keeps the inverse of
// register 0.
const REGISTERS: rp_pio.Program = rp_pio.assemble(
    ".fifo putget",
    "    mov osr, rxfifo[0]",
    "    mov isr, ~osr",
    "    mov rxfifo[1], isr",
)
// PIO with nothing connected (3 checks): block, program memory, state
// machine, and pin ownership and validation; a program echoing words
// through the FIFOs and the RX FIFO registers; a side-set square wave read
// back from its pad, with its IRQ flag.
fn pio_checks(pins: &mut chip.Pins, timer: &mut chip.Timer) {
    validated := refused(pins.pio(chip.PIO_BLOCKS), hal.Error.InvalidInput)
    pio := pins.pio(0)!
    pins.pio_pins(&pio, 15, 1)!
    owned := refused(pins.pio(0), hal.Error.Busy) && refused(pins.output(15), hal.Error.Busy) && failed_with(pins.pio_pins(&pio, 15, 1), hal.Error.Busy) && failed_with(pins.pio_pins(&pio, 29, 2), hal.Error.InvalidInput)
    filler := pio.load(&FILLER)!
    echo := pio.load(&ECHO)!
    full := refused(pio.load(&SQUARE), hal.Error.Busy) && refused(pio.load(&FILLER), hal.Error.Busy) && echo.offset() == 29 && filler.offset() == 0
    pio.unload(filler)
    machine := pio.state_machine(0)!
    claimed := refused(pio.state_machine(0), hal.Error.Busy) && refused(pio.state_machine(4), hal.Error.InvalidInput)
    check(validated && owned && full && claimed)

    // Echo: nothing before the first word, then each word inverted, up to
    // a full RX FIFO.
    config := echo.config()
    machine.init(&config)
    machine.set_enabled(true)
    quiet := machine.try_get()
    echoed := false
    if let none = quiet {
        echoed = true
    }
    for word in 0..8u32 {
        machine.put(0x1234_5670 + word)
    }
    timer.delay_us(10)
    // Four words wait in the RX FIFO, one in the ISR, and three in the TX
    // FIFO.
    echoed = echoed && machine.rx_level() == 4 && machine.tx_level() == 3 && machine.is_rx_full()
    for word in 0..8u32 {
        start := timer.now_us()
        received := false
        for !received && timer.now_us() - start < 1000 {
            if let some(value) = machine.try_get() {
                received = true
                echoed = echoed && value == ~(0x1234_5670 + word)
            }
        }
        echoed = echoed && received
    }
    echoed = echoed && machine.is_rx_empty() && machine.is_tx_empty()
    // The RX FIFO registers, from a second state machine.
    registers := pio.load(&REGISTERS)!
    setup := registers.config()
    second := pio.state_machine(1)!
    second.init(&setup)
    second.set_rx_register(0, 0xA5A5_0F0F)!
    second.set_enabled(true)
    timer.delay_us(10)
    inverse := second.rx_register(1)!
    pio.release_state_machine(second)
    pio.unload(registers)
    echoed = echoed && inverse == 0x5A5A_F0F0
    check(echoed)

    // The square wave: 32 cycles a period at 32 kHz is 1 kHz.
    pio.unload(echo)
    square := pio.load(&SQUARE)!
    wave := square.config()
    wave.set_sideset_pins(15)!
    wave.set_frequency(32_000)!
    machine.init(&wave)
    machine.set_pins(15, 1, 1)
    machine.set_pindirs(15, 1, 1)
    set_high := pin_level(15)
    machine.set_pins(15, 1, 0)
    set_low := !pin_level(15)
    pio.clear_flags(0xFF)
    unflagged := pio.flags() == 0
    machine.set_enabled(true)
    half := high_samples(15, timer)
    flagged := (pio.flags() & 1) != 0
    pio.clear_flags(1)
    timer.delay_ms(2)
    again := (pio.flags() & 1) != 0
    running := machine.address() >= square.offset() && machine.address() < square.offset() + 2
    pio.release_state_machine(machine)
    pio.unload(square)
    pins.release_pio(pio)
    pin := pins.output(15)!
    pins.release(pin)
    check(set_high && set_low && unflagged && half > 420 && half < 580 && flagged && again && running)
}

// Restart the watchdog's 3 s countdown, for checks that wait on the host.
fn feed_watchdog() {
    unsafe {
        load: hal.Reg<u32> = hal.Reg.at(WATCHDOG + 0x04)
        load.write(3_000_000)
    }
}

// The USB serial port: the host this test runs from enumerates it, writes
// without a terminal never wait, and the ADC shares PLL_USB with it.
fn usb_checks(usb: &mut board.Usb, pins: &mut chip.Pins, timer: &mut chip.Timer) {
    feed_watchdog()
    serial := usb.serial()!
    owned := refused(usb.serial(), hal.Error.Busy)
    start := timer.now_us()
    for !serial.is_configured() && timer.now_us() - start < 2_000_000 {}
    configured := serial.is_configured()
    feed_watchdog()
    // More than the 1024 bytes the port keeps, in small pieces: a large
    // array would reach the result record below the top of the stack.
    filler := [0x41u8; 100]
    written := timer.now_us()
    for _ in 0..15u32 {
        io.write_all(&mut serial, &filler)!
    }
    quick := timer.now_us() - written < 100_000
    knob := pins.analog(26)!
    sampled := knob.read()! <= 4095
    pins.release_analog(knob)
    shared := sampled && serial.is_configured()
    usb.release_serial(serial)
    again := usb.serial()!
    usb.release_serial(again)
    check(owned && configured && quick && shared)
}

const DMA_DONE: executor.Signal = executor.Signal { id: 30 }

// DMA: the claim API, copies, and SPI, UART, and I2C transfers that run
// while the program does other work.
fn dma_checks(dma: &mut rp_dma.Dma, pins: &mut chip.Pins, timer: &mut chip.Timer) {
    // Channels are claimed once each, lowest free first.
    last := dma.channels() - 1
    first := dma.channel()!
    second := dma.claim(last)!
    check(first.number() == 0 && second.number() == last && dma.is_claimed(0) && refused(dma.claim(0), hal.Error.Busy) && refused(dma.claim(last + 1), hal.Error.InvalidInput))

    // 1 KiB by words at bus speed, about a cycle a word, and bytes at odd
    // addresses.
    source: [1024]u8 = [0; 1024]
    target: [1024]u8 = [0; 1024]
    for index in 0..1024usize {
        source[index] = (index * 7 % 251) as u8
    }
    start := timer.now_us()
    first.copy(&mut target, &source)!
    elapsed := timer.now_us() - start
    same := true
    for index in 0..1024usize {
        same = same && target[index] == source[index]
    }
    first.copy(&mut target[1..100], &source[3..102])!
    odd := target[1] == source[3] && target[99] == source[101] && target[0] == source[0] && target[100] == source[100]
    check(same && odd && elapsed < 20 && refused_void(first.copy(&mut target[..2], &source[..3]), hal.Error.InvalidInput))

    // SPI loopback by DMA: 64 bytes at 1 MHz take 512 us, while the
    // program spins, and the receive channel's signal comes from the
    // runtime's DMA_IRQ_0 handler.
    DMA_DONE.reset()
    spi := pins.spi(board.SPI_CLOCK_PIN, board.SPI_TX_PIN, some(board.SPI_RX_PIN), hal.SpiMode.Mode0, 1_000_000)!
    spi.set_loopback(true)
    second.set_signal(&DMA_DONE)
    buffer: [64]u8 = [0; 64]
    {
        transfers := spi.dma(&mut first, &mut second, &mut buffer)!
        bytes := transfers.buffer()!
        for index in 0..64usize {
            bytes[index] = (index * 5 + 1) as u8
        }
        transfers.start_transfer(64)!
        lent := refused(transfers.buffer(), hal.Error.Busy)
        spins := 0u32
        for transfers.is_busy() {
            spins += 1
        }
        raised := DMA_DONE.is_raised()
        transfers.finish()!
        echoed := transfers.buffer()!
        looped := true
        for index in 0..64usize {
            looped = looped && echoed[index] == (index * 5 + 1) as u8
        }
        check(lent && spins > 1000 && raised && looped)
    }
    second.clear_signal()
    pins.release_spi(spi)

    // UART loopback by DMA: 100 bytes, three FIFOs' worth, go out in the
    // background and wait in the ring until the program reads them.
    port := pins.uart(board.UART_TX_PIN, some(board.UART_RX_PIN), 115_200)!
    port.set_loopback(true)!
    ring: [256]u8 = [0; 256]
    output: [32]u8 = [0; 32]
    {
        serial := port.dma(&mut second, &mut ring, &mut first, &mut output)!
        message: [100]u8 = [0; 100]
        for index in 0..100usize {
            message[index] = (index + 20) as u8
        }
        serial.write(&message)!
        serial.flush()!
        timer.delay_ms(2)
        waiting := serial.available()
        received: [128]u8 = [0; 128]
        count := serial.read(&mut received)!
        kept := true
        for index in 0..100usize {
            kept = kept && received[index] == (index + 20) as u8
        }
        check(serial.ring_size() == 256 || serial.ring_size() == 128)
        check(waiting == 100 && count == 100 && kept)
    }
    pins.release_uart(port)

    // A queued I2C read of an absent device: the program polls while the
    // controller addresses it, about 100 us at 100 kHz.
    i2c := pins.i2c(board.I2C_SDA_PIN, board.I2C_SCL_PIN, hal.I2C_STANDARD_HZ)!
    i2c.start_read(0x7C, 1)!
    byte: [1]u8 = [0]
    polls := 0u32
    absent := false
    for {
        match i2c.poll_finish(&mut byte) {
            ok(done) => {
                if done {
                    break
                }
                polls += 1
            }
            err(error) => {
                absent = error == hal.Error.NoAcknowledge
                break
            }
        }
    }
    check(absent && polls > 10 && !i2c.is_busy())
    pins.release_i2c(i2c)

    dma.release(first)
    dma.release(second)
    again := dma.channel()!
    check(again.number() == 0 && !dma.is_claimed(last))
    dma.release(again)
}

fn refused_void(result: void!hal.Error, expected: hal.Error) -> bool {
    match result {
        ok() => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

// Core 1: started with a task of its own, sharing the FIFOs and a spinlock
// with core 0, and running an executor of its own. Its stack is a static,
// so that it stays clear of the result record below core 0's stack.
// Spinlock 0 is usable on the RP2040, reserved on the RP2350.
const LOCK_ZERO_USABLE: bool = false
static mut CORE1_STACK: [1024]u64 = [0u64; 1024]
static mut SHARED_COUNT: u32 = 0
static CORE1_FLAG: atomic.Atomic<u32> = atomic.Atomic.new(0u32)
// Core 1's executor numbers its signals on its own: the same id as EDGE.
const WORDS: executor.Signal = executor.Signal { id: 0 }
const STOP_WORD: u32 = 0xFFFF_FFFF
const ADDS: u32 = 10_000

// On core 1, in three phases that core 0 drives: report the core number and
// answer words until STOP_WORD; count to ADDS under the lock while core 0
// does too; then double three words in a task of core 1's executor, woken
// by the FIFO interrupt, and report how often that executor slept.
struct Core1Test {
    fifo: rp_multicore.Fifo
    lock: rp_multicore.Spinlock
    alarm: chip.Alarm

    pub fn run(self) {
        let Core1Test { fifo, lock, alarm } = self
        link := fifo
        clock := alarm
        link.write(rp_multicore.core_id())
        for {
            word := link.read()
            if word == STOP_WORD {
                break
            }
            link.write(word * 3 + 1)
        }
        for _ in 0..ADDS {
            guard := lock.lock()
            unsafe {
                SHARED_COUNT += 1
            }
            core.drop(guard)
        }
        link.write(ADDS)
        link.set_signal(&WORDS)
        doubler := Doubler { fifo: link, left: 3 }
        runner := executor.Executor.new()
        {
            tasks: [1]&mut dyn executor.Task = [&mut doubler]
            runner.run(&mut tasks, &mut clock)
        }
        doubler.fifo.clear_signal()
        doubler.fifo.write(runner.sleeps() as u32)
    }
}

// Doubles the words core 0 writes, polled when they arrive.
struct Doubler {
    fifo: rp_multicore.Fifo
    left: u32

    pub fn poll(&mut self, cx: &mut executor.Context) -> executor.Poll {
        WORDS.take(cx)
        for {
            match self.fifo.try_read() {
                some(word) => {
                    self.fifo.write(word * 2)
                    self.left -= 1
                    if self.left == 0 {
                        return executor.Poll.Ready
                    }
                }
                none => {
                    break
                }
            }
        }
        return executor.Poll.Pending
    }
}

// On core 1, after a restart: show that it ran, and where.
struct Flag {
    pub fn run(self) {
        match CORE1_FLAG.store(rp_multicore.core_id() + 1, atomic.Ordering.Release) {
            ok() => {}
            err(_) => {}
        }
    }
}

fn flag() -> u32 {
    match CORE1_FLAG.load(atomic.Ordering.Acquire) {
        ok(value) => {
            return value
        }
        err(_) => {
            return 0
        }
    }
}

// The next word from core 1, or STOP_WORD if none comes within 10 ms.
fn receive(fifo: &mut rp_multicore.Fifo, timer: &mut chip.Timer) -> u32 {
    start := timer.now_us()
    for timer.now_us() - start < 10_000 {
        if let some(word) = fifo.try_read() {
            return word
        }
    }
    return STOP_WORD
}

// The clocks that run now, from the clocks block's ENABLED registers.
fn running_clocks() -> power.Clocks {
    unsafe {
        low: hal.Reg<u32> = hal.Reg.at(0x4001_00BC)
        high: hal.Reg<u32> = hal.Reg.at(0x4001_00BC + 4)
        return (low.read() as u64) | ((high.read() as u64) << 32)
    }
}

fn dormant_refused(chip_power: &mut chip.Power, wake: &power.Wake, expected: hal.Error) -> bool {
    match chip_power.dormant(wake) {
        ok(_) => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

fn power_checks(chip_power: &mut chip.Power, usb: &mut board.Usb, pins: &mut chip.Pins, timer: &mut chip.Timer) {
    // Clock gating: the clocks of released peripherals stop, claiming one
    // starts its clocks, and claimed and essential clocks are refused.
    stopped := chip_power.disable_unused_clocks()
    gated := (stopped & chip.CLOCK_UART1) == chip.CLOCK_UART1 && (stopped & chip.ESSENTIAL_CLOCKS) == 0 && (running_clocks() & stopped) == 0
    match pins.uart(4, none, 115_200) {
        ok(port) => {
            restarted := (running_clocks() & chip.CLOCK_UART1) == chip.CLOCK_UART1
            busy := failed_with(chip_power.disable_clocks(chip.CLOCK_UART1), hal.Error.Busy)
            essential := failed_with(chip_power.disable_clocks(chip.CLOCK_GPIO), hal.Error.InvalidInput)
            pins.release_uart(port)
            check(gated && restarted && busy && essential)
        }
        err(_) => {
            check(false)
        }
    }
    chip_power.enable_clocks(stopped)

    // A deep sleep with only the timer's clocks wakes on its alarm.
    match timer.alarm(1) {
        ok(alarm) => {
            chip_power.set_sleep_clocks(chip.ALARM_CLOCKS)
            chip_power.set_mode(power.Mode.DeepSleep)
            start := timer.now_us()
            alarm.sleep_until(some(start + 2000))
            elapsed := timer.now_us() - start
            deep := chip_power.mode() == power.Mode.DeepSleep && cortex_m.deep_sleep() && chip_power.sleep_clocks() == chip.ALARM_CLOCKS
            chip_power.set_mode(power.Mode.Sleep)
            chip_power.set_sleep_clocks(chip.ALL_CLOCKS)
            timer.release_alarm(alarm)
            check(deep && !cortex_m.deep_sleep() && elapsed >= 2000 && elapsed < 2300)
        }
        err(_) => {
            check(false)
        }
    }

    // Dormant: refused without pins, for a pin the chip lacks, and while
    // the USB serial port runs; a level already present ends it at once,
    // and clk_sys is back at full speed.
    empty := power.Wake.new()
    outside := power.Wake.new()
    outside.on(chip.PIN_COUNT, power.LEVEL_HIGH)
    refused := dormant_refused(chip_power, &empty, hal.Error.InvalidInput) && dormant_refused(chip_power, &outside, hal.Error.InvalidInput)
    wake := power.Wake.new()
    wake.on(14, power.LEVEL_HIGH)
    match usb.serial() {
        ok(serial) => {
            refused = refused && dormant_refused(chip_power, &wake, hal.Error.Busy)
            usb.release_serial(serial)
        }
        err(_) => {
            refused = false
        }
    }
    match pins.output(14) {
        ok(pin) => {
            pin.set_high()
            before := timer.now_us()
            woke := false
            match chip_power.dormant(&wake) {
                ok(pins_woken) => {
                    woke = pins_woken == 1u64 << 14
                }
                err(_) => {}
            }
            elapsed := timer.now_us() - before
            khz := clk_sys_khz()
            pins.release(pin)
            check(refused && woke && elapsed < 10_000 && khz == clk_sys_khz() && khz > chip.SYS_HZ / 1000 - 1000 && khz < chip.SYS_HZ / 1000 + 1000)
        }
        err(_) => {
            check(false)
        }
    }
}

fn core1_checks(core1: &mut rp_multicore.Core1, fifos: &mut rp_multicore.Fifos, spinlocks: &mut rp_multicore.Spinlocks, timer: &mut chip.Timer) {
    feed_watchdog()
    fifo := fifos.claim()!
    lock := spinlocks.claim(20)!
    claims := refused(spinlocks.claim(20), hal.Error.Busy) && refused(spinlocks.claim(32), hal.Error.InvalidInput) && spinlocks.is_usable(0) == LOCK_ZERO_USABLE
    guard := lock.lock()
    held := lock.is_locked() && cortex_m.interrupts_masked()
    excluded := false
    match lock.try_lock() {
        some(_) => {}
        none => {
            excluded = true
        }
    }
    core.drop(guard)
    released := !lock.is_locked() && !cortex_m.interrupts_masked()
    small := [0u64; 16]
    tiny := refused(core1.start(&mut small, Flag {}), hal.Error.InvalidInput)

    unsafe {
        SHARED_COUNT = 0
    }
    task := Core1Test { fifo: fifos.claim()!, lock: lock.clone(), alarm: timer.alarm(3)! }
    third := refused(fifos.claim(), hal.Error.Busy)
    running := unsafe {
        core1.start(&mut CORE1_STACK, task)!
    }
    id := receive(&mut fifo, timer)
    echoes := true
    for word in 0..5u32 {
        fifo.write(word * 1000)
        echoes = echoes && receive(&mut fifo, timer) == word * 3000 + 1
    }
    check(tiny && third && id == 1 && echoes)

    fifo.write(STOP_WORD)
    for _ in 0..ADDS {
        guard = lock.lock()
        unsafe {
            SHARED_COUNT += 1
        }
        core.drop(guard)
    }
    counted := receive(&mut fifo, timer) == ADDS
    total := unsafe {
        SHARED_COUNT
    }
    check(claims && held && excluded && released && counted && total == 2 * ADDS)

    doubled := true
    for word in 10..13u32 {
        timer.delay_ms(2)
        fifo.write(word)
        doubled = doubled && receive(&mut fifo, timer) == 2 * word
    }
    sleeps := receive(&mut fifo, timer)
    start := timer.now_us()
    for !running.is_finished() && timer.now_us() - start < 10_000 {}
    finished := running.is_finished()
    running.stop()
    match CORE1_FLAG.store(0, atomic.Ordering.Release) {
        ok() => {}
        err(_) => {}
    }
    second := unsafe {
        core1.start(&mut CORE1_STACK, Flag {})!
    }
    start = timer.now_us()
    for flag() == 0 && timer.now_us() - start < 10_000 {}
    flagged := flag() == 2
    for !second.is_finished() && timer.now_us() - start < 10_000 {}
    restarted := flagged && second.is_finished()
    second.stop()
    check(doubled && sleeps >= 3 && sleeps < 100 && finished && restarted)
    fifos.release(fifo)
    spinlocks.release(lock)
}

fn main() {
    // A previous run hung and the watchdog reset the chip: report it.
    unsafe {
        reason: hal.Reg<u32> = hal.Reg.at(WATCHDOG + 0x08)
        state: hal.Reg<u32> = hal.Reg.at(SCRATCH)
        if (reason.read() & 1) != 0 && (state.read() & 0xFFFF_0000) == RUNNING {
            detail: hal.Reg<u32> = hal.Reg.at(SCRATCH + 4)
            record(state.read(), detail.read())
            // The reset reason and scratch words outlive reflashing: forget
            // this hang so the next run does not report it again.
            state.write(0)
            report()
        }
    }
    record(RUNNING, 0)
    b := board.take()!
    // Watchdog: reset everything but the oscillators after 3 s. It counts
    // down once per microsecond tick, which board.take() started.
    unsafe {
        select: hal.Reg<u32> = hal.Reg.at(0x4001_8008)
        select.write(0x1FF_FFF3)
        load: hal.Reg<u32> = hal.Reg.at(WATCHDOG + 0x04)
        load.write(3_000_000)
        control: hal.Reg<u32> = hal.Reg.at(WATCHDOG)
        control.write(1 << 30)
    }

    // A second take must be refused.
    match board.take() {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.Busy)
        }
    }
    unsafe {
        check(DATA[0] == 0xDEAD_BEEF && DATA[1] == 7 && DATA[2] == 0x1234_5678)
    }

    // Clocks: 150 MHz system clock.
    khz := clk_sys_khz()
    check(khz > 149_000 && khz < 151_000)

    // Timer: a 10 ms delay is 1.5 M SysTick cycles at 150 MHz.
    unsafe {
        reload: hal.Reg<u32> = hal.Reg.at(0xE000_E014)
        current: hal.Reg<u32> = hal.Reg.at(0xE000_E018)
        control: hal.Reg<u32> = hal.Reg.at(0xE000_E010)
        reload.write(0x00FF_FFFF)
        current.write(0)
        control.write(0b101)
        // The counter reads 0 until SysTick loads RELOAD on its first tick.
        for current.read() == 0 {}
        start := current.read()
        before := b.timer.now_us()
        b.timer.delay_us(10_000)
        after := b.timer.now_us()
        cycles := start - current.read()
        delta := (after - before) as u32
        // SysTick counts clk_sys: 150 cycles per timer microsecond.
        check(cycles > 149 * delta && cycles < 152 * delta)
        store(RECORD + 8, khz)
        store(RECORD + 12, delta)
        store(RECORD + 16, cycles)
        check(delta >= 10_000 && delta < 10_200)
    }

    // The LED is the wireless chip's GPIO 0: the level it drives reads back
    // through the chip's GPIO input register, so each check is a full gSPI
    // round trip. take() turned it off.
    check(!b.led.is_high() && !b.led.read_back())
    b.led.set_high()
    check(b.led.is_high() && b.led.read_back())
    b.led.toggle()
    check(!b.led.is_high() && !b.led.read_back())
    // The wireless chip senses USB power on its GPIO 2.
    check(b.led.usb_powered())
    before := b.timer.now_us()
    for _ in 0..100 {
        b.led.toggle()
    }
    store(RECORD + 24, (b.timer.now_us() - before) as u32)
    check(!b.led.is_high() && !b.led.read_back())
    // The wireless chip's pins belong to the LED.
    match b.pins.output(board.WL_SELECT_PIN) {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.Busy)
        }
    }
    b.led.set_high()

    // Runtime helpers: zero at run time, unknown to the optimizer.
    z := b.timer.now_us() >> 63
    z32 := z as u32
    check((1_000_000_007u32 ^ z32) / 13 == 76_923_077)
    check((1_000_000_007u32 ^ z32) % 13 == 6)
    check((0xFFFF_FFFFu32 ^ z32) / 0x8000_0001 == 1)
    check((0xFFFF_FFFFu32 ^ z32) % 0x8000_0001 == 0x7FFF_FFFE)
    check((0xFFFF_FFFEu32 ^ z32) / 0xFFFF_FFFF == 0)
    i := z32 as i32
    check((-1_000_000_007 + i) / 13 == -76_923_077)
    check((-1_000_000_007 + i) % 13 == -6)
    check((7 + i) / -2 == -3)
    check((7 + i) % -2 == 1)
    check((-2_147_483_647 + i) / -3 == 715_827_882)
    check((0xFEDC_BA98_7654_3210u64 ^ z) / 0x12345 == 0xE000_4FA0_1C4D)
    check((0xFEDC_BA98_7654_3210u64 ^ z) % 0x12345 == 0x10A4F)
    check((0xFFFF_FFFF_FFFF_FFFFu64 ^ z) / 0x8000_0000_0000_0001 == 1)
    check((0xFFFF_FFFF_FFFF_FFFFu64 ^ z) % 0x8000_0000_0000_0001 == 0x7FFF_FFFF_FFFF_FFFE)
    check((0x0123_4567_89AB_CDEFu64 ^ z) / 0xFFFF_FFFF == 0x123_4567)
    check((0x0123_4567_89AB_CDEFu64 ^ z) % 0xFFFF_FFFF == 0x8ACF_1356)
    j := z as i64
    check((-81_985_529_216_486_895 + j) / 4660 == -17_593_461_205_254)
    check((-81_985_529_216_486_895 + j) % 4660 == -3255)
    check((9_223_372_036_854_775_807 - j) / -7 == -1_317_624_576_693_539_401)
    check(core.wrapping_mul(0x1_2345_6789u64 ^ z, 0xA_BCDE_F012) == 0x379A_AAB7_F0BF_B7A2)
    check(core.wrapping_mul(0xFFFF_FFFF_FFFF_FFFFu64 ^ z, 0xFFFF_FFFF) == 0xFFFF_FFFF_0000_0001)
    x := 0x8000_0000_0000_0001u64 ^ z
    s := -9_223_372_036_854_775_807 + j
    check((3u64 ^ z) << (1 + z) == 6)
    check((3u64 ^ z) << (31 + z) == 0x1_8000_0000)
    check(x >> (31 + z) == 0x1_0000_0000)
    check(x >> (32 + z) == 0x8000_0000)
    check((1u64 ^ z) << (33 + z) == 0x2_0000_0000)
    check((1u64 ^ z) << (63 + z) == 0x8000_0000_0000_0000)
    check(x >> (63 + z) == 1)
    check(s >> (32 + j) == -2_147_483_648)
    check(s >> (63 + j) == -1)

    // Floating-point helpers: all of them on the RP2040, binary64 and the
    // conversions on the RP2350's single-precision FPU.
    d := z as f64
    check((0.1 + d) + 0.2 == 0.30000000000000004 && (1.0 + d) / 3.0 * 3.0 == 1.0)
    check((2.2250738585072014e-308 + d) / 4.0 == 5.562684646268003e-309 && (1e308 + d) * 10.0 > 1.7976931348623157e308)
    check((10.5 + d) % 3.0 == 1.5 && (-7.25 + d) % 2.0 == -1.25)
    nan := d / d
    check(nan != nan && !(nan < 1.0) && !(nan >= 1.0) && -0.0 + d == 0.0)
    check((-3.75 + d) as i32 == -3 && (1e19 + d) as u64 == 10_000_000_000_000_000_000 && (-1e18 + d) as i64 == -1_000_000_000_000_000_000)
    check((0x1F_FFFF_FFFF_FFFFu64 ^ z) as f64 == 9007199254740991.0 && (0xFFFF_FFFF_FFFF_FFFFu64 ^ z) as f64 == 18446744073709551616.0 && (-5 + j) as f64 == -5.0)
    e := z as f32
    check((0.1f32 + e) + 0.2f32 == 0.3f32 && (1.1754944e-38f32 + e) / 8.0f32 == 1.469368e-39f32 && (10.5f32 + e) % 3.0f32 == 1.5f32)
    check(((1.0f32 + e) / 3.0f32) as f64 == 0.3333333432674408 && (0.1 + d) as f32 == 0.1f32 && (16_777_217u64 ^ z) as f32 == 16_777_216.0f32 && (16_777_219u32 ^ z32) as f32 == 16_777_220.0f32)

    // memcpy/memset through large copies.
    big: [64]u32 = [0; 64]
    for k in 0..64 {
        big[k] = k as u32 + z32
    }
    copy := big
    check(copy[63] == 63 && copy[0] == 0)

    bus_checks(&mut b.pins, &mut b.timer)
    uart_checks(&mut b.pins, &mut b.timer)
    protocol_checks(&mut b.pins, &mut b.timer)
    interrupt_checks(&mut b.timer)
    executor_checks(&mut b.pins, &mut b.timer)
    pwm_adc_checks(&mut b.pins, &mut b.timer)
    pio_checks(&mut b.pins, &mut b.timer)
    usb_checks(&mut b.usb, &mut b.pins, &mut b.timer)
    dma_checks(&mut b.dma, &mut b.pins, &mut b.timer)
    core1_checks(&mut b.core1, &mut b.fifos, &mut b.spinlocks, &mut b.timer)
    power_checks(&mut b.power, &mut b.usb, &mut b.pins, &mut b.timer)

    // Configuration is validated before ownership: an unusable crystal is
    // InvalidInput, a valid one is Busy because the board already took it.
    match chip.take(chip.Config { crystal_hz: 7_000_000 }) {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.InvalidInput)
        }
    }
    match chip.take(chip.Config { crystal_hz: 12_000_000 }) {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.Busy)
        }
    }
    start := b.timer.now_us()
    b.timer.delay_ms(10)
    elapsed := b.timer.now_us() - start
    check(elapsed >= 10_000 && elapsed < 10_100)
    check(board.NAME.len == 21)

    unsafe {
        control: hal.Reg<u32> = hal.Reg.at(WATCHDOG)
        control.write(0)
        store(RECORD + 20, MORE_FAILURES)
        store(RECORD + 28, LAST_FAILURES)
        store(RECORD + 96, EXTRA_FAILURES)
        record(0x600D_0000 | CHECKS, FAILURES)
    }
    report()
}
