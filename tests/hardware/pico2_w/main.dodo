package main

import "core/ptr"
import "std/embedded/board"
import "std/embedded/chip"
import "std/embedded/hal"
import "std/embedded/peripheral/designware_i2c"
import "std/embedded/peripheral/pl011"
import "std/embedded/peripheral/pl022"
import "std/io"

// Hardware self-test for the `pico2_w` board: the RP2350 startup runtime,
// std/embedded/chip/rp2350 (clocks, timer, I2C, SPI, UART, single ownership,
// configuration checks), std/embedded/board/pico2_w with the CYW43439 driver in
// std/embedded/wireless/cyw43 (gSPI bus bring-up, the LED and USB-power GPIOs
// of the wireless chip), and the runtime's integer and floating-point helpers.
// Every outcome ends in the USB bootloader with a record that
// `scripts/test_pico.py --board pico2_w` reads over USB with picotool. The
// RP2350 boot ROM clears SRAM when it starts, so the record is staged at
// RECORD in SRAM and written to the last flash sector before rebooting. Words
// of the record:
//
//   [0] 0x600D_00nn  finished after nn checks; [1] = failed-check bits
//       0xDEAD_llll  panicked at line llll;    [1] = column
//       0x5747_00nn  hung or faulted after check nn (watchdog reset)
//   [2] clk_sys in kHz  [3] a 10 ms delay in timer us  [4] its SysTick cycles
//   [5] failed-check bits for checks 32 to 63
//   [6] microseconds for 100 LED toggles over gSPI
//   [7] failed-check bits for checks 64 to 95
//   [8] to [23] after a panic: the end of the file's path, NUL-terminated
//
// A copy of [0] and [1] in watchdog SCRATCH0/1 survives the watchdog reset
// that reports a hang. (The boot ROM's reboot uses SCRATCH2 to 7.)

const RECORD: usize = 0x2007_F000
// The last 4 KiB sector of the Pico 2 W's flash, by its execute-in-place
// address. (Without a partition table, flash_op refuses storage offsets.)
const FLASH_RECORD: u32 = 0x103F_F000
// Boot ROM flash_op ('F' | 'O' << 8): erase or program, secure, at a
// runtime (execute-in-place) address.
const ROM_FLASH_OP: u32 = 0x4F46
const FLASH_ERASE: u32 = 0x0_0101
const FLASH_PROGRAM: u32 = 0x1_0101
const WATCHDOG: usize = 0x400D_8000
const SCRATCH: usize = WATCHDOG + 0x0C
const RUNNING: u32 = 0x5747_0000
const FILE_OFFSET: usize = 32
const FILE_BYTES: usize = 64
static mut CHECKS: u32 = 0
// Failed-check bits: checks 0 to 31, 32 to 63, and 64 to 95.
static mut FAILURES: u32 = 0
static mut MORE_FAILURES: u32 = 0
static mut LAST_FAILURES: u32 = 0
// Initialized data: checks that the reset handler copies .data from flash.
static mut DATA: [3]u32 = [0xDEAD_BEEFu32, 7, 0x1234_5678]

fn store(address: usize, value: u32) {
    // SAFETY: RECORD is SRAM this program never otherwise uses, and the
    // watchdog scratch registers are free for software.
    unsafe {
        word: hal.Reg<u32> = hal.Reg.at(address)
        word.write(value)
    }
}

fn record(state: u32, detail: u32) {
    store(RECORD, state)
    store(RECORD + 4, detail)
    store(SCRATCH, state)
    store(SCRATCH + 4, detail)
}

// Provided by the compiler's RP2350 firmware runtime.
unsafe extern "C" fn dodo_rp2350_rom_call(code: u32, a0: u32, a1: u32, a2: u32, a3: u32) -> i32

// Write the 256-byte record page to flash and restart into the bootloader.
// flash_op leaves flash in execute-in-place mode, so this code keeps
// running from flash.
fn report() {
    unsafe {
        dodo_rp2350_rom_call(ROM_FLASH_OP, FLASH_ERASE, FLASH_RECORD, 4096, 0)
        dodo_rp2350_rom_call(ROM_FLASH_OP, FLASH_PROGRAM, FLASH_RECORD, 256, RECORD as u32)
    }
    board.reboot_to_bootloader()
}

fn check(ok: bool) {
    unsafe {
        if !ok && CHECKS < 32 {
            FAILURES |= 1u32 << CHECKS
        } else if !ok && CHECKS < 64 {
            MORE_FAILURES |= 1u32 << (CHECKS - 32)
        } else if !ok && CHECKS < 96 {
            LAST_FAILURES |= 1u32 << (CHECKS - 64)
        }
        CHECKS += 1
        record(RUNNING | CHECKS, FAILURES)
    }
}

// Replaces the board runtime's default panic hook. Panics in the standard
// library report their own file, so the end of its path goes in the record
// too.
extern "C" fn dodo_board_panic(check: *const u8, file: *const u8, line: u32, column: u32) {
    record(0xDEAD_0000 | (line & 0xFFFF), column)
    unsafe {
        length := 0usize
        for ptr.read(ptr.offset(file, length as isize)) != 0 && length < 1024 {
            length += 1
        }
        start := 0usize
        if length > FILE_BYTES - 1 {
            start = length - (FILE_BYTES - 1)
        }
        for index in 0..FILE_BYTES {
            byte: hal.Reg<u8> = hal.Reg.at(RECORD + FILE_OFFSET + index)
            if start + index < length {
                byte.write(ptr.read(ptr.offset(file, (start + index) as isize)))
            } else {
                byte.write(0)
            }
        }
    }
    report()
}

// clk_sys in kHz from the CLOCKS frequency counter, against clk_ref.
fn clk_sys_khz() -> u32 {
    unsafe {
        reference: hal.Reg<u32> = hal.Reg.at(0x4001_008C)
        minimum: hal.Reg<u32> = hal.Reg.at(0x4001_0090)
        maximum: hal.Reg<u32> = hal.Reg.at(0x4001_0094)
        interval: hal.Reg<u32> = hal.Reg.at(0x4001_009C)
        source: hal.Reg<u32> = hal.Reg.at(0x4001_00A0)
        status: hal.Reg<u32> = hal.Reg.at(0x4001_00A4)
        result: hal.Reg<u32> = hal.Reg.at(0x4001_00A8)
        reference.write(12_000)
        interval.write(10)
        minimum.write(0)
        maximum.write(0xFFFF_FFFF)
        source.write(0x09)
        match status.wait_set(1 << 4, 10_000_000) {
            ok() => {}
            err(_) => {
                return 0
            }
        }
        return result.read() >> 5
    }
}

// A claim was refused with `expected`.
fn refused<T>(result: T!hal.Error, expected: hal.Error) -> bool {
    match result {
        ok(_) => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

// A bus operation failed with `expected`.
fn failed_with(result: void!hal.Error, expected: hal.Error) -> bool {
    match result {
        ok() => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

// I2C and SPI on the board's usual pins with nothing connected (13 checks):
// pin and frequency validation, single ownership, an I2C address that no
// device acknowledges, SPI through the controller's internal loopback, and
// giving the buses back and claiming them again.
fn bus_checks<P, T>(pins: &mut P, timer: &mut T) {
    sda := board.I2C_SDA_PIN
    scl := board.I2C_SCL_PIN
    standard := hal.I2C_STANDARD_HZ
    check(refused(pins.i2c(scl, sda, standard), hal.Error.InvalidInput) && refused(pins.i2c(sda, sda + 3, standard), hal.Error.InvalidInput) && refused(pins.i2c(sda, scl, 2_000_000), hal.Error.InvalidInput))
    i2c := pins.i2c(sda, scl, standard)!
    check(i2c.frequency_hz() == standard)
    // GP8 and GP9 are I2C0 too.
    check(refused(pins.i2c(8, 9, standard), hal.Error.Busy) && refused(pins.output(sda), hal.Error.Busy))
    // No device answers the reserved address 0x7C. The pads' pull-ups keep
    // the idle bus high, so the controller sees a missing acknowledge, not
    // a fault, and it ends the transaction itself.
    byte: [1]u8 = [0]
    start := timer.now_us()
    check(failed_with(i2c.read(0x7C, &mut byte), hal.Error.NoAcknowledge))
    elapsed := timer.now_us() - start
    // START, the address byte and its acknowledge bit at 100 kHz, STOP.
    check(elapsed >= 90 && elapsed < 500)
    register: [1]u8 = [0]
    check(failed_with(i2c.write(0x7C, &register), hal.Error.NoAcknowledge) && failed_with(i2c.write_read(0x7C, &register, &mut byte), hal.Error.NoAcknowledge))

    clock := board.SPI_CLOCK_PIN
    tx := board.SPI_TX_PIN
    rx := board.SPI_RX_PIN
    check(refused(pins.spi(tx, clock, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput) && refused(pins.spi(clock, tx, some(board.SPI_SELECT_PIN), hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput))
    spi := pins.spi(clock, tx, some(rx), hal.SpiMode.Mode0, 1_000_000)!
    spi.set_loopback(true)
    data: [16]u8 = [0; 16]
    sent: [16]u8 = [0; 16]
    for index in 0..16usize {
        data[index] = (0xA5 ^ (17 * index)) as u8
        sent[index] = data[index]
    }
    start = timer.now_us()
    spi.transfer(&mut data)!
    elapsed = timer.now_us() - start
    same := true
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    check(same && refused(pins.spi(2, 3, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.Busy))
    // 128 bits at just under 1 MHz, back to back.
    check(spi.frequency_hz() <= 1_000_000 && spi.frequency_hz() > 990_000 && elapsed >= 128 && elapsed < 200)
    spi.set_mode(hal.SpiMode.Mode3)
    spi.write(&sent)!
    spi.transfer(&mut data)!
    // A single byte, as when reading one register, starts on an idle
    // controller.
    one: [1]u8 = [0x3C]
    spi.transfer(&mut one)!
    same = one[0] == 0x3C
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    check(same)

    // Released buses give back their pins and controllers. SCL can then be
    // clocked by hand, as to free a device stuck holding SDA low, while the
    // pads keep both lines pulled up; then the buses work again.
    pins.release_i2c(i2c)
    pins.release_spi(spi)
    clock_line := pins.output(scl)!
    data_line := pins.input(sda)!
    for _ in 0..9 {
        clock_line.set_low()
        timer.delay_us(5)
        clock_line.set_high()
        timer.delay_us(5)
    }
    check(clock_line.is_high() && data_line.is_high())
    pins.release(clock_line)
    pins.release(data_line)
    i2c_again := pins.i2c(sda, scl, standard)!
    check(failed_with(i2c_again.read(0x7C, &mut byte), hal.Error.NoAcknowledge))
    spi_again := pins.spi(clock, tx, some(rx), hal.SpiMode.Mode0, 1_000_000)!
    spi_again.set_loopback(true)
    one[0] = 0x5A
    spi_again.transfer(&mut one)!
    check(one[0] == 0x5A)
}

// A serial port on the board's usual pins with nothing connected (6
// checks): pin and baud rate validation, single ownership, the controller's
// internal loopback timed at 115200 baud, newline translation, 8E2 frames
// at 1 Mbaud through a full receive FIFO and the overrun after it, and
// giving the port back and claiming it again.
fn uart_checks<P, T>(pins: &mut P, timer: &mut T) {
    tx := board.UART_TX_PIN
    rx := board.UART_RX_PIN
    check(refused(pins.uart(rx, some(tx), 115_200), hal.Error.InvalidInput) && refused(pins.uart(tx, some(5u32), 115_200), hal.Error.InvalidInput) && refused(pins.uart(tx, some(rx), 10_000_000), hal.Error.InvalidInput))
    serial := pins.uart(tx, some(rx), 115_200)!
    // GP12 is UART0's too.
    check(serial.baud() == 115_207 && refused(pins.uart(12, none, 9600), hal.Error.Busy) && refused(pins.output(tx), hal.Error.Busy))

    serial.set_loopback(true)
    sent: [16]u8 = [0; 16]
    for index in 0..16usize {
        sent[index] = (0x3C + 13 * index) as u8
    }
    start := timer.now_us()
    serial.write(&sent)!
    serial.flush()
    elapsed := timer.now_us() - start
    data: [16]u8 = [0; 16]
    io.read_exact(&mut serial, &mut data)!
    same := true
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    // 16 frames of 10 bits at 115207 baud: 1389 us.
    check(same && elapsed >= 1385 && elapsed < 1450)

    // "\n" goes out as "\r\n", which reads back as one "\n".
    serial.set_crlf(true)
    serial.write(b"a\nb")!
    serial.flush()
    three: [3]u8 = [0; 3]
    io.read_exact(&mut serial, &mut three)!
    empty := serial.poll_read(&mut data)!
    check(three[0] == 97 && three[1] == 10 && three[2] == 98 && empty.transferred == 0 && empty.state == io.PollState.Pending)
    serial.set_crlf(false)

    // 40 frames of 12 bits (start, 8 data, parity, 2 stop) at exactly
    // 1 Mbaud take 480 us; the receive FIFO keeps the first 32, and the
    // rest are an overrun, reported once.
    serial.set_format(8, pl011.Parity.Even, 2)!
    serial.set_baud(1_000_000)!
    burst: [40]u8 = [0; 40]
    for index in 0..40usize {
        burst[index] = (6 * index) as u8
    }
    start = timer.now_us()
    serial.write(&burst)!
    serial.flush()
    elapsed = timer.now_us() - start
    back: [40]u8 = [0; 40]
    received := 0usize
    overruns := 0u32
    for {
        match serial.poll_read(&mut back[received..]) {
            ok(progress) => {
                received += progress.transferred
                if progress.transferred == 0 {
                    break
                }
            }
            err(error) => {
                received += error.transferred
                if error.code == pl011.OVERRUN {
                    overruns += 1
                } else {
                    overruns += 100
                }
            }
        }
    }
    same = received == 32 && overruns == 1
    for index in 0..32usize {
        same = same && back[index] == burst[index]
    }
    check(same && serial.baud() == 1_000_000 && elapsed >= 478 && elapsed < 520)

    // Released, the pins stay pulled up, so the line idles high; then the
    // port is claimed again, to send only.
    serial.set_loopback(false)
    pins.release_uart(serial)
    line := pins.input(tx)!
    high := line.is_high()
    pins.release(line)
    again := pins.uart(tx, none, 115_200)!
    again.write(b"dodo\r\n")!
    again.flush()
    check(high && again.baud() == 115_207)
    pins.release_uart(again)
}

// The protocol options with nothing connected (7 checks): 10-bit I2C
// addresses and probes, an I2C target, SPI with the controller's own chip
// select in 12-bit Motorola and 16-bit TI frames through the internal
// loopback, an SPI target without a master, a break through the UART's
// loopback, and the flow control pins of a serial port.
fn protocol_checks<P, T>(pins: &mut P, timer: &mut T) {
    sda := board.I2C_SDA_PIN
    scl := board.I2C_SCL_PIN
    i2c := pins.i2c(sda, scl, hal.I2C_STANDARD_HZ)!
    // Nobody answers a 10-bit address or 0x7C, and probing says so.
    data: [1]u8 = [0]
    absent := !i2c.probe(0x7C)!
    check(absent && failed_with(i2c.write_ten_bit(0x2A5, &data), hal.Error.NoAcknowledge) && failed_with(i2c.read_ten_bit(0x2A5, &mut data), hal.Error.NoAcknowledge))
    pins.release_i2c(i2c)

    // A target takes the pins, refuses reserved addresses, and has nothing
    // to report while no master talks to it.
    reserved := refused(pins.i2c_target(sda, scl, 0x7A, false, hal.I2C_FAST_HZ), hal.Error.InvalidInput)
    target := pins.i2c_target(sda, scl, 0x42, false, hal.I2C_FAST_HZ)!
    buffer: [4]u8 = [0; 4]
    idle := true
    for _ in 0..100 {
        match target.poll(&mut buffer) {
            designware_i2c.TargetEvent.Idle => {}
            _ => {
                idle = false
            }
        }
    }
    check(reserved && idle && refused(pins.i2c(sda, scl, hal.I2C_STANDARD_HZ), hal.Error.Busy))
    pins.release_i2c_target(target)

    // SPI1 on GPIO 10 to 13, with GPIO 13 as its hardware chip select.
    select_refused := refused(pins.spi_with_select(10, 11, some(12u32), 17, hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput)
    spi := pins.spi_with_select(10, 11, some(12u32), 13, hal.SpiMode.Mode1, 1_000_000)!
    spi.set_loopback(true)
    spi.set_frame_bits(12)!
    words: [8]u16 = [0; 8]
    for index in 0..8usize {
        words[index] = (0x0A5 * (index + 1)) as u16
    }
    spi.transfer_words(&mut words)!
    same := true
    for index in 0..8usize {
        same = same && words[index] == ((0x0A5 * (index + 1)) & 0xFFF) as u16
    }
    bytes: [2]u8 = [1, 2]
    check(select_refused && same && failed_with(spi.transfer(&mut bytes), hal.Error.Unsupported))
    spi.set_frame_format(pl022.FrameFormat.TexasInstruments)
    spi.set_frame_bits(16)!
    wide: [4]u16 = [0xFFFF, 0x8001, 0x1234, 0xFEDC]
    start := timer.now_us()
    spi.transfer_words(&mut wide)!
    elapsed := timer.now_us() - start
    // 64 bits at just under 1 MHz, plus the frame pulses.
    check(wide[0] == 0xFFFF && wide[1] == 0x8001 && wide[2] == 0x1234 && wide[3] == 0xFEDC && elapsed >= 64 && elapsed < 120)
    pins.release_spi(spi)

    // A target queues what its transmit FIFO holds and, with no master
    // clocking, receives nothing.
    spi_target := pins.spi_target(10, 11, some(12u32), 13, hal.SpiMode.Mode3)!
    replies: [10]u8 = [0x55; 10]
    queued := spi_target.queue(&replies)!
    received := spi_target.read(&mut buffer)!
    check(queued == 8 && received == 0 && refused(pins.spi(10, 11, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.Busy))
    pins.release_spi_target(spi_target)

    // A break through the loopback reads as BREAK, and the port goes on.
    tx := board.UART_TX_PIN
    rx := board.UART_RX_PIN
    serial := pins.uart(tx, some(rx), 115_200)!
    serial.set_loopback(true)
    serial.set_break(true)
    timer.delay_us(200)
    serial.set_break(false)
    timer.delay_us(100)
    broke := false
    match serial.poll_read(&mut buffer) {
        ok(_) => {}
        err(error) => {
            broke = (error.code & pl011.BREAK) != 0
        }
    }
    serial.write(b"ok")!
    serial.flush()
    two: [2]u8 = [0; 2]
    io.read_exact(&mut serial, &mut two)!
    check(broke && two[0] == 111 && two[1] == 107)
    serial.set_loopback(false)
    pins.release_uart(serial)

    // Flow control owns CTS and RTS too. With nothing on CTS the
    // transmitter would wait forever, so it is turned off before anything
    // is sent.
    flow_refused := refused(pins.uart_flow(tx, rx, rx + 2, rx + 1, 115_200), hal.Error.InvalidInput)
    flow := pins.uart_flow(tx, rx, rx + 1, rx + 2, 115_200)!
    taken := refused(pins.output(rx + 2), hal.Error.Busy)
    flow.set_flow_control(false, false)
    flow.write(b"\r\n")!
    flow.flush()
    pins.release_uart(flow)
    free := pins.output(rx + 2)!
    pins.release(free)
    check(flow_refused && taken)
}

fn main() {
    // A previous run hung and the watchdog reset the chip: report it.
    unsafe {
        reason: hal.Reg<u32> = hal.Reg.at(WATCHDOG + 0x08)
        state: hal.Reg<u32> = hal.Reg.at(SCRATCH)
        if (reason.read() & 1) != 0 && (state.read() & 0xFFFF_0000) == RUNNING {
            detail: hal.Reg<u32> = hal.Reg.at(SCRATCH + 4)
            record(state.read(), detail.read())
            report()
        }
    }
    record(RUNNING, 0)
    b := board.take()!
    // Watchdog: reset everything but the oscillators after 3 s. It counts
    // down once per microsecond tick, which board.take() started.
    unsafe {
        select: hal.Reg<u32> = hal.Reg.at(0x4001_8008)
        select.write(0x1FF_FFF3)
        load: hal.Reg<u32> = hal.Reg.at(WATCHDOG + 0x04)
        load.write(3_000_000)
        control: hal.Reg<u32> = hal.Reg.at(WATCHDOG)
        control.write(1 << 30)
    }

    // A second take must be refused.
    match board.take() {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.Busy)
        }
    }
    unsafe {
        check(DATA[0] == 0xDEAD_BEEF && DATA[1] == 7 && DATA[2] == 0x1234_5678)
    }

    // Clocks: 150 MHz system clock.
    khz := clk_sys_khz()
    check(khz > 149_000 && khz < 151_000)

    // Timer: a 10 ms delay is 1.5 M SysTick cycles at 150 MHz.
    unsafe {
        reload: hal.Reg<u32> = hal.Reg.at(0xE000_E014)
        current: hal.Reg<u32> = hal.Reg.at(0xE000_E018)
        control: hal.Reg<u32> = hal.Reg.at(0xE000_E010)
        reload.write(0x00FF_FFFF)
        current.write(0)
        control.write(0b101)
        // The counter reads 0 until SysTick loads RELOAD on its first tick.
        for current.read() == 0 {}
        start := current.read()
        before := b.timer.now_us()
        b.timer.delay_us(10_000)
        after := b.timer.now_us()
        cycles := start - current.read()
        delta := (after - before) as u32
        // SysTick counts clk_sys: 150 cycles per timer microsecond.
        check(cycles > 149 * delta && cycles < 152 * delta)
        store(RECORD + 8, khz)
        store(RECORD + 12, delta)
        store(RECORD + 16, cycles)
        check(delta >= 10_000 && delta < 10_200)
    }

    // The LED is the wireless chip's GPIO 0: the level it drives reads back
    // through the chip's GPIO input register, so each check is a full gSPI
    // round trip. take() turned it off.
    check(!b.led.is_high() && !b.led.read_back())
    b.led.set_high()
    check(b.led.is_high() && b.led.read_back())
    b.led.toggle()
    check(!b.led.is_high() && !b.led.read_back())
    // The wireless chip senses USB power on its GPIO 2.
    check(b.led.usb_powered())
    before := b.timer.now_us()
    for _ in 0..100 {
        b.led.toggle()
    }
    store(RECORD + 24, (b.timer.now_us() - before) as u32)
    check(!b.led.is_high() && !b.led.read_back())
    // The wireless chip's pins belong to the LED.
    match b.pins.output(board.WL_SELECT_PIN) {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.Busy)
        }
    }
    b.led.set_high()

    // Runtime helpers: zero at run time, unknown to the optimizer.
    z := b.timer.now_us() >> 63
    z32 := z as u32
    check((1_000_000_007u32 ^ z32) / 13 == 76_923_077)
    check((1_000_000_007u32 ^ z32) % 13 == 6)
    check((0xFFFF_FFFFu32 ^ z32) / 0x8000_0001 == 1)
    check((0xFFFF_FFFFu32 ^ z32) % 0x8000_0001 == 0x7FFF_FFFE)
    check((0xFFFF_FFFEu32 ^ z32) / 0xFFFF_FFFF == 0)
    i := z32 as i32
    check((-1_000_000_007 + i) / 13 == -76_923_077)
    check((-1_000_000_007 + i) % 13 == -6)
    check((7 + i) / -2 == -3)
    check((7 + i) % -2 == 1)
    check((-2_147_483_647 + i) / -3 == 715_827_882)
    check((0xFEDC_BA98_7654_3210u64 ^ z) / 0x12345 == 0xE000_4FA0_1C4D)
    check((0xFEDC_BA98_7654_3210u64 ^ z) % 0x12345 == 0x10A4F)
    check((0xFFFF_FFFF_FFFF_FFFFu64 ^ z) / 0x8000_0000_0000_0001 == 1)
    check((0xFFFF_FFFF_FFFF_FFFFu64 ^ z) % 0x8000_0000_0000_0001 == 0x7FFF_FFFF_FFFF_FFFE)
    check((0x0123_4567_89AB_CDEFu64 ^ z) / 0xFFFF_FFFF == 0x123_4567)
    check((0x0123_4567_89AB_CDEFu64 ^ z) % 0xFFFF_FFFF == 0x8ACF_1356)
    j := z as i64
    check((-81_985_529_216_486_895 + j) / 4660 == -17_593_461_205_254)
    check((-81_985_529_216_486_895 + j) % 4660 == -3255)
    check((9_223_372_036_854_775_807 - j) / -7 == -1_317_624_576_693_539_401)
    check(core.wrapping_mul(0x1_2345_6789u64 ^ z, 0xA_BCDE_F012) == 0x379A_AAB7_F0BF_B7A2)
    check(core.wrapping_mul(0xFFFF_FFFF_FFFF_FFFFu64 ^ z, 0xFFFF_FFFF) == 0xFFFF_FFFF_0000_0001)
    x := 0x8000_0000_0000_0001u64 ^ z
    s := -9_223_372_036_854_775_807 + j
    check((3u64 ^ z) << (1 + z) == 6)
    check((3u64 ^ z) << (31 + z) == 0x1_8000_0000)
    check(x >> (31 + z) == 0x1_0000_0000)
    check(x >> (32 + z) == 0x8000_0000)
    check((1u64 ^ z) << (33 + z) == 0x2_0000_0000)
    check((1u64 ^ z) << (63 + z) == 0x8000_0000_0000_0000)
    check(x >> (63 + z) == 1)
    check(s >> (32 + j) == -2_147_483_648)
    check(s >> (63 + j) == -1)

    // Floating-point helpers: all of them on the RP2040, binary64 and the
    // conversions on the RP2350's single-precision FPU.
    d := z as f64
    check((0.1 + d) + 0.2 == 0.30000000000000004 && (1.0 + d) / 3.0 * 3.0 == 1.0)
    check((2.2250738585072014e-308 + d) / 4.0 == 5.562684646268003e-309 && (1e308 + d) * 10.0 > 1.7976931348623157e308)
    check((10.5 + d) % 3.0 == 1.5 && (-7.25 + d) % 2.0 == -1.25)
    nan := d / d
    check(nan != nan && !(nan < 1.0) && !(nan >= 1.0) && -0.0 + d == 0.0)
    check((-3.75 + d) as i32 == -3 && (1e19 + d) as u64 == 10_000_000_000_000_000_000 && (-1e18 + d) as i64 == -1_000_000_000_000_000_000)
    check((0x1F_FFFF_FFFF_FFFFu64 ^ z) as f64 == 9007199254740991.0 && (0xFFFF_FFFF_FFFF_FFFFu64 ^ z) as f64 == 18446744073709551616.0 && (-5 + j) as f64 == -5.0)
    e := z as f32
    check((0.1f32 + e) + 0.2f32 == 0.3f32 && (1.1754944e-38f32 + e) / 8.0f32 == 1.469368e-39f32 && (10.5f32 + e) % 3.0f32 == 1.5f32)
    check(((1.0f32 + e) / 3.0f32) as f64 == 0.3333333432674408 && (0.1 + d) as f32 == 0.1f32 && (16_777_217u64 ^ z) as f32 == 16_777_216.0f32 && (16_777_219u32 ^ z32) as f32 == 16_777_220.0f32)

    // memcpy/memset through large copies.
    big: [64]u32 = [0; 64]
    for k in 0..64 {
        big[k] = k as u32 + z32
    }
    copy := big
    check(copy[63] == 63 && copy[0] == 0)

    bus_checks(&mut b.pins, &mut b.timer)
    uart_checks(&mut b.pins, &mut b.timer)
    protocol_checks(&mut b.pins, &mut b.timer)

    // Configuration is validated before ownership: an unusable crystal is
    // InvalidInput, a valid one is Busy because the board already took it.
    match chip.take(chip.Config { crystal_hz: 7_000_000 }) {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.InvalidInput)
        }
    }
    match chip.take(chip.Config { crystal_hz: 12_000_000 }) {
        ok(_) => {
            check(false)
        }
        err(error) => {
            check(error == hal.Error.Busy)
        }
    }
    start := b.timer.now_us()
    b.timer.delay_ms(10)
    elapsed := b.timer.now_us() - start
    check(elapsed >= 10_000 && elapsed < 10_100)
    check(board.NAME.len == 21)

    unsafe {
        control: hal.Reg<u32> = hal.Reg.at(WATCHDOG)
        control.write(0)
        store(RECORD + 20, MORE_FAILURES)
        store(RECORD + 28, LAST_FAILURES)
        record(0x600D_0000 | CHECKS, FAILURES)
    }
    report()
}
