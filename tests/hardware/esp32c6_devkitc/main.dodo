package main

import "core/mem"
import "std/embedded/board"
import "std/embedded/chip"
import "std/embedded/executor"
import "std/embedded/hal"
import "std/embedded/peripheral/esp_uart"
import "std/fmt"
import "std/io"
import "std/sync/atomic"

// Hardware self-test for the `esp32c6_devkitc` board: the ESP32-C6 startup
// runtime and its interrupt dispatch, std/embedded/chip/esp32c6 (clocks,
// GPIO and the GPIO matrix, I2C, SPI, UART, PWM, the ADC and temperature
// sensor, the system timer and alarms, interrupts, DMA, the RGB LED, the
// USB serial port, single ownership, validation), the board package, the
// executor, and the runtime's integer and floating-point helpers. Nothing
// needs to be wired to the board: buses run against their own pins and the
// pads' pulls.
//
// Results go to the chip's USB serial port, which
// `scripts/test_esp32c6.py` reads: after the host sends a byte,
// `selftest ready`, then `check N ok` or `check N FAILED` per check, and
// `selftest done N`. A panic prints the default report instead.

// Initialized data: checks that the reset handler copies .data from flash.
static mut DATA: [3]u32 = [0xDEAD_BEEFu32, 7, 0x1234_5678]
static mut CHECKS: u32 = 0
static mut SERIAL: Option<chip.UsbSerial> = none

fn say(text: &str) {
    unsafe {
        match &mut SERIAL {
            some(serial) => {
                fmt.printf(serial, "{}", text)!
                serial.flush()!
            }
            none => {}
        }
    }
}

fn check(ok: bool) {
    unsafe {
        match &mut SERIAL {
            some(serial) => {
                if ok {
                    fmt.printf(serial, "check {} ok\n", CHECKS)!
                } else {
                    fmt.printf(serial, "check {} FAILED\n", CHECKS)!
                }
                serial.flush()!
            }
            none => {}
        }
        CHECKS += 1
    }
}

// A claim was refused with `expected`.
fn refused<T>(result: T!hal.Error, expected: hal.Error) -> bool {
    match result {
        ok(_) => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

// An operation failed with `expected`.
fn failed_with(result: void!hal.Error, expected: hal.Error) -> bool {
    match result {
        ok() => {
            return false
        }
        err(error) => {
            return error == expected
        }
    }
}

// The level of GPIO `pin`, from the GPIO input register, which reads the
// pad whatever drives it.
fn pin_level(pin: u32) -> bool {
    // SAFETY: GPIO_IN is read-only.
    unsafe {
        input: hal.Reg<u32> = hal.Reg.at(0x6009_103C)
        return input.any(1u32 << pin)
    }
}

// Set the pulls of a pin owned by an analog input, from outside the chip
// package, to put a known voltage on it.
fn force_pulls(pin: u32, up: bool, down: bool) {
    // SAFETY: the test owns the pin through its analog input.
    unsafe {
        pad: hal.Reg<u32> = hal.Reg.at(0x6009_0004 + 4 * pin as usize)
        value := pad.read() & ~((1u32 << 7) | (1u32 << 8))
        if up {
            value |= 1u32 << 8
        }
        if down {
            value |= 1u32 << 7
        }
        pad.write(value)
    }
}

// Drive a pin owned by an analog input high or low with its output driver,
// or stop driving it, from outside the chip package.
fn drive(pin: u32, level: Option<bool>) {
    // SAFETY: the test owns the pin through its analog input.
    unsafe {
        set: hal.Reg<u32> = hal.Reg.at(0x6009_1008)
        clear: hal.Reg<u32> = hal.Reg.at(0x6009_100C)
        enable: hal.Reg<u32> = hal.Reg.at(0x6009_1024)
        disable: hal.Reg<u32> = hal.Reg.at(0x6009_1028)
        match level {
            some(high) => {
                if high {
                    set.write(1u32 << pin)
                } else {
                    clear.write(1u32 << pin)
                }
                enable.write(1u32 << pin)
            }
            none => {
                disable.write(1u32 << pin)
            }
        }
    }
}

// The CPU's cycle counter: the ESP32-C6 counts cycles in its own
// performance counter CSRs, not mcycle.
fn start_cycles() {
    unsafe {
        asm("csrw 0x7e0, {0}", in(reg) 1u32)
        asm("csrw 0x7e1, {0}", in(reg) 1u32)
        asm("csrw 0x7e2, {0}", in(reg) 0u32)
    }
}

fn cycles() -> u32 {
    unsafe {
        return asm("csrr {0}, 0x7e2", out(reg) u32)
    }
}

// Pins with nothing on the DevKitC-1's circuit.
const FREE_A: u32 = 10
const FREE_B: u32 = 11
const FREE_C: u32 = 18
const FREE_D: u32 = 19

fn pin_checks(b: &mut board.Board) {
    // Ownership and validation: the LED's pin, the USB pins, the flash's.
    led_taken := refused(b.pins.output(board.LED_PIN), hal.Error.Busy)
    usb := refused(b.pins.output(12), hal.Error.InvalidInput) && refused(b.pins.input(13), hal.Error.InvalidInput)
    flash := refused(b.pins.output(24), hal.Error.InvalidInput) && refused(b.pins.output(chip.PIN_COUNT), hal.Error.InvalidInput)
    pin := b.pins.output(FREE_A)!
    check(led_taken && usb && flash && refused(b.pins.input(FREE_A), hal.Error.Busy))

    // An output reads back through its own input path.
    pin.set_high()
    b.timer.delay_us(5)
    high := pin.is_high() && pin_level(FREE_A)
    pin.toggle()
    b.timer.delay_us(5)
    check(high && !pin.is_high())

    // A released input sees the pad's pulls.
    pin.set_as_input()
    pin.set_pull(true, false)
    b.timer.delay_us(50)
    up := pin.is_high()
    pin.set_pull(false, true)
    b.timer.delay_us(50)
    check(up && !pin.is_high())

    // Edges latch and clear.
    pin.set_pull(false, false)
    pin.set_low()
    pin.set_as_output()
    pin.listen(chip.RISING_EDGE)
    quiet := pin.events() == 0
    pin.set_high()
    b.timer.delay_us(5)
    raised := pin.events() == chip.RISING_EDGE
    pin.clear_events(chip.RISING_EDGE)
    cleared := pin.events() == 0
    pin.ignore(chip.RISING_EDGE)
    check(quiet && raised && cleared && pin.irq() == chip.GPIO)
    b.pins.release(pin)

    // The RGB LED, red, then off, then on in its color.
    b.led.set_color(0x20_00_00)
    red := b.led.is_high() && b.led.color() == 0x20_00_00
    b.timer.delay_ms(100)
    b.led.set_low()
    off := !b.led.is_high()
    b.led.set_color(board.LED_ON_COLOR)
    b.timer.delay_ms(100)
    b.led.toggle()
    check(red && off && !b.led.is_high() && refused(b.pins.output(board.LED_PIN), hal.Error.Busy))
}

fn bus_checks(pins: &mut chip.Pins, timer: &mut chip.Timer) {
    sda := board.I2C_SDA_PIN
    scl := board.I2C_SCL_PIN
    standard := hal.I2C_STANDARD_HZ
    check(refused(pins.i2c(sda, sda, standard), hal.Error.InvalidInput) && refused(pins.i2c(sda, 12, standard), hal.Error.InvalidInput) && refused(pins.i2c(sda, scl, 2_000_000), hal.Error.InvalidInput))
    i2c := pins.i2c(sda, scl, standard)!
    check(i2c.frequency_hz() == standard && refused(pins.i2c(FREE_A, FREE_B, standard), hal.Error.Busy) && refused(pins.output(sda), hal.Error.Busy))
    // No device answers the reserved address 0x7C: the pads' pull-ups keep
    // the idle bus high, so the controller sees a missing acknowledge.
    byte: [1]u8 = [0]
    // The first transaction brings the driver's code into the cache; the
    // second is timed.
    first_nack := failed_with(i2c.read(0x7C, &mut byte), hal.Error.NoAcknowledge)
    start := timer.now_us()
    check(first_nack && failed_with(i2c.read(0x7C, &mut byte), hal.Error.NoAcknowledge))
    elapsed := timer.now_us() - start
    // START, the address byte and its acknowledge bit at 100 kHz, STOP.
    say_number("i2c address phase us ", elapsed as u32)
    check(elapsed >= 90 && elapsed < 500)
    register: [1]u8 = [0]
    absent := !i2c.probe(0x7C)!
    write_nack := failed_with(i2c.write(0x7C, &register), hal.Error.NoAcknowledge)
    write_read_nack := failed_with(i2c.write_read(0x7C, &register, &mut byte), hal.Error.NoAcknowledge)
    ten_bit_nack := failed_with(i2c.write_ten_bit(0x2A5, &register), hal.Error.NoAcknowledge)
    say_flags("i2c absent, write, write_read, ten_bit ", absent, write_nack, write_read_nack, ten_bit_nack)
    check(absent && write_nack && write_read_nack && ten_bit_nack)

    clock := board.SPI_CLOCK_PIN
    tx := board.SPI_TX_PIN
    rx := board.SPI_RX_PIN
    check(refused(pins.spi(clock, clock, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput) && refused(pins.spi(clock, tx, some(tx), hal.SpiMode.Mode0, 1_000_000), hal.Error.InvalidInput) && refused(pins.spi(clock, tx, none, hal.SpiMode.Mode0, 10_000), hal.Error.InvalidInput))
    spi := pins.spi(clock, tx, some(rx), hal.SpiMode.Mode0, 1_000_000)!
    spi.set_loopback(true)
    data: [16]u8 = [0; 16]
    sent: [16]u8 = [0; 16]
    for index in 0..16usize {
        data[index] = (0xA5 ^ (17 * index)) as u8
        sent[index] = data[index]
    }
    warm: [16]u8 = [0; 16]
    spi.transfer(&mut warm)!
    start = timer.now_us()
    spi.transfer(&mut data)!
    elapsed = timer.now_us() - start
    same := true
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    check(same && refused(pins.spi(FREE_A, FREE_B, none, hal.SpiMode.Mode0, 1_000_000), hal.Error.Busy))
    // 128 bits at exactly 1 MHz.
    say_number("spi 128 bits us ", elapsed as u32)
    say_number("spi hz ", spi.frequency_hz())
    check(spi.frequency_hz() == 1_000_000 && elapsed >= 128 && elapsed < 220)
    spi.set_mode(hal.SpiMode.Mode3)
    spi.write(&sent)!
    spi.transfer(&mut data)!
    one: [1]u8 = [0x3C]
    spi.transfer(&mut one)!
    same = one[0] == 0x3C
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    check(same)
    // More than the controller's 64-byte buffer, at 10 MHz.
    spi.set_frequency(10_000_000)!
    long: [200]u8 = [0; 200]
    for index in 0..200usize {
        long[index] = ((index * 7 + 3) & 255) as u8
    }
    spi.transfer(&mut long)!
    same = spi.frequency_hz() == 10_000_000
    for index in 0..200usize {
        same = same && long[index] == ((index * 7 + 3) & 255) as u8
    }
    check(same)

    // Released buses give back their pins. SCL can then be clocked by hand,
    // as to free a device stuck holding SDA low, while the pads keep both
    // lines pulled up; then the buses work again.
    pins.release_i2c(i2c)
    pins.release_spi(spi)
    clock_line := pins.output(scl)!
    data_line := pins.input(sda)!
    data_line.set_pull(true, false)
    clock_line.set_pull(true, false)
    for _ in 0..9 {
        clock_line.set_low()
        timer.delay_us(5)
        clock_line.set_high()
        timer.delay_us(5)
    }
    check(clock_line.is_high() && data_line.is_high())
    pins.release(clock_line)
    pins.release(data_line)
    i2c_again := pins.i2c(sda, scl, standard)!
    first := failed_with(i2c_again.read(0x7C, &mut byte), hal.Error.NoAcknowledge)
    spi_again := pins.spi(clock, tx, some(rx), hal.SpiMode.Mode0, 1_000_000)!
    spi_again.set_loopback(true)
    one[0] = 0x5A
    spi_again.transfer(&mut one)!
    check(first && one[0] == 0x5A)
    pins.release_i2c(i2c_again)
    pins.release_spi(spi_again)
}

fn uart_checks(pins: &mut chip.Pins, timer: &mut chip.Timer) {
    tx := board.UART_TX_PIN
    rx := board.UART_RX_PIN
    check(refused(pins.uart(tx, some(tx), 115_200), hal.Error.InvalidInput) && refused(pins.uart(tx, some(rx), 10_000_000), hal.Error.InvalidInput) && refused(pins.uart(tx, some(rx), 100), hal.Error.InvalidInput))
    serial := pins.uart(tx, some(rx), 115_200)!
    second := pins.uart(FREE_A, some(FREE_B), 9600)!
    numbers := serial.number() == 0 && second.number() == 1 && serial.irq() == chip.UART0 && second.irq() == chip.UART1
    say_number("uart baud ", serial.baud())
    say_number("uart second baud ", second.baud())
    check(numbers && serial.baud() == 115_191 && second.baud() == 9600 && refused(pins.uart(FREE_C, none, 9600), hal.Error.Busy) && refused(pins.output(tx), hal.Error.Busy))
    pins.release_uart(second)

    serial.set_loopback(true)!
    sent: [16]u8 = [0; 16]
    for index in 0..16usize {
        sent[index] = (0x3C + 13 * index) as u8
    }
    data: [16]u8 = [0; 16]
    serial.write(&sent)!
    serial.flush()!
    io.read_exact(&mut serial, &mut data)!
    start := timer.now_us()
    serial.write(&sent)!
    serial.flush()!
    elapsed := timer.now_us() - start
    say_number("uart 16 bytes us ", elapsed as u32)
    io.read_exact(&mut serial, &mut data)!
    same := true
    for index in 0..16usize {
        same = same && data[index] == sent[index]
    }
    // 16 frames of 10 bits at 115191 baud: 1389 us.
    check(same && elapsed >= 1385 && elapsed < 1460)

    // "\n" goes out as "\r\n", which reads back as one "\n".
    serial.set_crlf(true)
    serial.write(b"a\nb")!
    serial.flush()!
    three: [3]u8 = [0; 3]
    io.read_exact(&mut serial, &mut three)!
    empty := serial.poll_read(&mut data)!
    check(three[0] == 97 && three[1] == 10 && three[2] == 98 && empty.transferred == 0 && empty.state == io.PollState.Pending)
    serial.set_crlf(false)

    // 140 frames of 12 bits (start, 8 data, parity, 2 stop) at 1 Mbaud take
    // 1680 us; the receive FIFO keeps the first 128, and a few more wait in
    // the receiver, and the rest overflow.
    serial.set_format(8, esp_uart.Parity.Even, 2)!
    serial.set_baud(1_000_000)!
    burst: [140]u8 = [0; 140]
    for index in 0..140usize {
        burst[index] = ((6 * index) & 255) as u8
    }
    start = timer.now_us()
    serial.write(&burst)!
    serial.flush()!
    elapsed = timer.now_us() - start
    back: [140]u8 = [0; 140]
    received := 0usize
    overruns := 0u32
    for {
        match serial.poll_read(&mut back[received..]) {
            ok(progress) => {
                received += progress.transferred
                if progress.transferred == 0 {
                    break
                }
            }
            err(error) => {
                received += error.transferred
                if error.code == esp_uart.OVERRUN {
                    overruns += 1
                } else {
                    overruns += 100
                }
            }
        }
    }
    say_number("uart burst us ", elapsed as u32)
    say_number("uart burst received ", received as u32)
    say_number("uart burst overruns ", overruns)
    same = received >= 128 && received < 140 && overruns == 1
    for index in 0..received {
        same = same && back[index] == burst[index]
    }
    check(same && serial.baud() == 1_000_000 && elapsed >= 1670 && elapsed < 1800)

    // Released, the pins stay pulled up, so the line idles high; then the
    // port is claimed again, to send only.
    serial.set_loopback(false)!
    pins.release_uart(serial)
    line := pins.input(tx)!
    line.set_pull(true, false)
    timer.delay_us(20)
    high := line.is_high()
    pins.release(line)
    again := pins.uart(tx, none, 115_200)!
    again.write(b"dodo\r\n")!
    again.flush()!
    check(high && again.baud() == 115_191)
    // Through the pad: the receiver reads the TX pin, routed back to it in
    // the GPIO matrix, so the bytes leave the chip's output driver and come
    // back through its input.
    route_rx_from(again.number(), tx)
    pad_sent: [8]u8 = [0x55, 0x00, 0xFF, 0x0F, 0xF0, 0xA5, 0x5A, 0x81]
    again.write(&pad_sent)!
    again.flush()!
    pad_back: [8]u8 = [0; 8]
    io.read_exact(&mut again, &mut pad_back)!
    same = true
    for index in 0..8usize {
        same = same && pad_back[index] == pad_sent[index]
    }
    check(same)
    pins.release_uart(again)
}

// Feed UART `number`'s receiver from GPIO `pin` in the GPIO matrix.
fn route_rx_from(number: u32, pin: u32) {
    // SAFETY: the test owns the port, and with it its receive signal.
    unsafe {
        signal := 6 + 3 * number
        input: hal.Reg<u32> = hal.Reg.at(0x6009_1154 + 4 * signal as usize)
        input.write(pin | (1u32 << 7))
    }
}

fn pwm_adc_checks(pins: &mut chip.Pins, timer: &mut chip.Timer) {
    check(refused(pins.pwm(FREE_A, 0), hal.Error.InvalidInput) && refused(pins.pwm(FREE_A, 1), hal.Error.InvalidInput) && refused(pins.pwm(12, 1000), hal.Error.InvalidInput))
    output := pins.pwm(FREE_A, 1000)!
    second := pins.pwm(FREE_B, 1000)!
    owned := refused(pins.output(FREE_A), hal.Error.Busy) && refused(pins.pwm(FREE_A, 50), hal.Error.Busy)
    // Both share a timer at 1 kHz, with 16384 steps.
    check(owned && output.max_duty() == 16384 && output.frequency_hz() == 1000 && second.channel() != output.channel() && failed_with(output.set_duty(16385), hal.Error.InvalidInput))
    hal.set_duty_percent(&mut output, 25)!
    pins.release_pwm(second)
    timer.delay_ms(2)
    steps := output.duty() == 4096
    // At 1 kHz and 25 %, the pin is high a quarter of the time: sample it.
    high := 0u32
    for _ in 0..2000 {
        if pin_level(FREE_A) {
            high += 1
        }
        timer.delay_us(5)
    }
    // Rising edges over 10 ms.
    rises := 0u32
    last := pin_level(FREE_A)
    start := timer.now_us()
    for timer.now_us() - start < 10_000 {
        level := pin_level(FREE_A)
        if level && !last {
            rises += 1
        }
        last = level
    }
    say_number("pwm duty ", output.duty() as u32)
    say_number("pwm high of 2000 ", high)
    say_number("pwm rises in 10 ms ", rises)
    check(steps && high > 400 && high < 600)
    check(rises >= 9 && rises <= 11)
    pins.release_pwm(output)

    // ADC1 channel 3 on GPIO 3, driven to 3.3 V and to ground by the pin's
    // own output driver; the pad's weak pulls move it the same way.
    check(refused(pins.analog(7), hal.Error.InvalidInput) && refused(pins.analog(12), hal.Error.InvalidInput))
    input := pins.analog(3)!
    owned = refused(pins.analog(3), hal.Error.Busy) && refused(pins.output(3), hal.Error.Busy)
    drive(3, some(true))
    timer.delay_ms(1)
    top := input.read()!
    millivolts := hal.read_millivolts(&mut input, 3300)!
    drive(3, some(false))
    timer.delay_ms(1)
    bottom := input.read()!
    drive(3, none)
    force_pulls(3, true, false)
    timer.delay_ms(2)
    pulled_up := input.read()!
    force_pulls(3, false, true)
    timer.delay_ms(2)
    pulled_down := input.read()!
    force_pulls(3, false, false)
    say_number("adc driven high ", top as u32)
    say_number("adc driven high mV ", millivolts)
    say_number("adc driven low ", bottom as u32)
    say_number("adc pulled up ", pulled_up as u32)
    say_number("adc pulled down ", pulled_down as u32)
    check(owned && input.max_value() == 4095 && top > 3800 && millivolts > 3100 && bottom < 300 && pulled_up > pulled_down + 500)
    pins.release_analog(input)

    sensor := pins.temperature()!
    raw := sensor.read()!
    celsius := chip.millicelsius(raw) / 1000
    say_number("temperature C ", celsius as u32)
    check(refused(pins.temperature(), hal.Error.Busy) && sensor.max_value() == 255 && celsius > 0 && celsius < 60)
    pins.release_analog(sensor)
}

fn say_flags(text: &str, a: bool, b: bool, c: bool, d: bool) {
    unsafe {
        match &mut SERIAL {
            some(serial) => {
                fmt.printf(serial, "{}{} {} {} {}\n", text, a, b, c, d)!
            }
            none => {}
        }
    }
}

fn say_number(text: &str, value: u32) {
    unsafe {
        match &mut SERIAL {
            some(serial) => {
                fmt.printf(serial, "{}{}\n", text, value)!
            }
            none => {}
        }
    }
}

// Interrupts: `@interrupt` handlers, the interrupt matrix, a timer alarm,
// and a function placed in SRAM.
static mut ALARM: Option<chip.Alarm> = none
static mut ALARM_HITS: u32 = 0
static PENDED_HITS: atomic.Atomic<u32> = atomic.Atomic.new(0u32)
static GPIO_HITS: atomic.Atomic<u32> = atomic.Atomic.new(0u32)
static mut EVENT_PIN: Option<chip.Pin> = none

@interrupt(SYSTIMER_TARGET0)
fn alarm_fired() {
    unsafe {
        ALARM_HITS += 1
        match &mut ALARM {
            some(alarm) => {
                alarm.clear()
            }
            none => {}
        }
    }
}

// Nothing else raises FROM_CPU_INTR0; the checks raise it from software.
@interrupt(FROM_CPU_INTR0)
fn pended() {
    chip.unpend(0)
    PENDED_HITS.fetch_add(1, atomic.Ordering.AcqRel)!
}

@interrupt(GPIO)
fn gpio_event() {
    unsafe {
        match &mut EVENT_PIN {
            some(pin) => {
                pin.clear_events(chip.RISING_EDGE)
            }
            none => {}
        }
    }
    GPIO_HITS.fetch_add(1, atomic.Ordering.AcqRel)!
}

fn alarm_hits() -> u32 {
    return unsafe {
        ALARM_HITS
    }
}

fn pended_hits() -> u32 {
    return PENDED_HITS.load(atomic.Ordering.Acquire)!
}

@section(".ramfunc")
fn from_sram(value: u32) -> u32 {
    return core.wrapping_mul(value, 3) + 1
}

// The address this code runs at.
@section(".ramfunc")
fn sram_address() -> u32 {
    unsafe {
        return asm("auipc {0}, 0", out(reg) u32)
    }
}

fn interrupt_checks(pins: &mut chip.Pins, timer: &mut chip.Timer) {
    // Alarm 0, 2 ms ahead, raises its interrupt once.
    alarm := timer.alarm(0)!
    check(refused(timer.alarm(0), hal.Error.Busy) && refused(timer.alarm(chip.ALARM_COUNT), hal.Error.InvalidInput) && alarm.number() == 0)
    irq := alarm.irq()
    alarm.listen()
    start := timer.now_us()
    alarm.schedule_in(2000)
    armed := alarm.is_armed() && alarm.is_listening()
    unsafe {
        ALARM = some(alarm)
    }
    chip.enable(irq)
    for alarm_hits() == 0 && timer.now_us() - start < 10_000 {}
    elapsed := timer.now_us() - start
    timer.delay_us(3000)
    chip.disable(irq)
    back := unsafe {
        mem.replace(&mut ALARM, none)
    }
    match back {
        some(alarm) => {
            check(armed && alarm_hits() == 1 && !alarm.fired() && irq == chip.SYSTIMER_TARGET0 && elapsed >= 1990 && elapsed < 2200)
            timer.release_alarm(alarm)
        }
        none => {
            check(false)
        }
    }

    // An alarm sleeps until its deadline; its interrupt, whose handler is
    // the runtime's endless loop, is never taken.
    sleeper := timer.alarm(1)!
    start = sleeper.now_us()
    sleeper.sleep_until(some(start + 2000))
    slept := sleeper.now_us() - start
    check(slept >= 2000 && slept < 2100 && !sleeper.fired() && !sleeper.is_armed() && !sleeper.is_listening() && !chip.is_enabled(sleeper.irq()))
    timer.release_alarm(sleeper)

    // A GPIO edge runs the GPIO handler.
    pin := pins.output(FREE_C)!
    pin.listen(chip.RISING_EDGE)
    unsafe {
        EVENT_PIN = some(pin)
    }
    chip.enable(chip.GPIO)
    unsafe {
        match &mut EVENT_PIN {
            some(pin) => {
                pin.set_high()
            }
            none => {}
        }
    }
    timer.delay_us(20)
    chip.disable(chip.GPIO)
    hits := GPIO_HITS.load(atomic.Ordering.Acquire)!
    event := unsafe {
        mem.replace(&mut EVENT_PIN, none)
    }
    match event {
        some(pin) => {
            check(hits == 1 && pin.events() == 0)
            pins.release(pin)
        }
        none => {
            check(false)
        }
    }

    // A raised software interrupt waits until it is enabled, then runs
    // once; masked, it waits for the critical section to end.
    chip.pend(0)
    timer.delay_us(5)
    waiting := chip.is_pending(chip.FROM_CPU_INTR0) && pended_hits() == 0
    chip.enable(chip.FROM_CPU_INTR0)
    timer.delay_us(5)
    check(waiting && pended_hits() == 1 && !chip.is_pending(chip.FROM_CPU_INTR0) && chip.is_enabled(chip.FROM_CPU_INTR0))
    section := hal.Critical.enter()
    chip.pend(0)
    timer.delay_us(5)
    held := pended_hits() == 1
    core.drop(section)
    timer.delay_us(5)
    check(held && pended_hits() == 2)
    chip.disable(chip.FROM_CPU_INTR0)
}

// The executor: a timer alarm as its clock, and tasks woken by time and by
// the DMA controller's interrupt.
const COPIED: executor.Signal = executor.Signal { id: 0 }

// Finishes after five 1 ms ticks.
struct Ticks {
    ticker: executor.Ticker
    count: u32

    pub fn poll(&mut self, cx: &mut executor.Context) -> executor.Poll {
        if self.ticker.ready(cx) {
            self.count += 1
            if self.count == 5 {
                return executor.Poll.Ready
            }
        }
        return executor.Poll.Pending
    }
}

// Finishes 2 ms after its first poll.
struct Waiter {
    timer: executor.Timer
    started: bool
    done_at: u64

    pub fn poll(&mut self, cx: &mut executor.Context) -> executor.Poll {
        if !self.started {
            self.started = true
            self.timer.start(cx, 2000)
        }
        if self.timer.expired(cx) {
            self.done_at = cx.now_us()
            return executor.Poll.Ready
        }
        return executor.Poll.Pending
    }
}

fn executor_checks(timer: &mut chip.Timer) {
    alarm := timer.alarm(2)!
    ticks := Ticks { ticker: executor.Ticker.every(1000), count: 0 }
    waiter := Waiter { timer: executor.Timer.new(), started: false, done_at: 0 }
    runner := executor.Executor.new()
    start := alarm.now_us()
    finished := false
    {
        tasks: [2]&mut dyn executor.Task = [&mut ticks, &mut waiter]
        finished = runner.run_until(&mut tasks, &mut alarm, start + 20_000)
    }
    elapsed := alarm.now_us() - start
    check(finished && ticks.count == 5 && elapsed >= 5000 && elapsed < 5500 && waiter.done_at - start >= 2000 && runner.sleeps() >= 5)
    timer.release_alarm(alarm)
    address := sram_address()
    check(from_sram(5) == 16 && address >= 0x4080_0000 && address < 0x4088_0000)
}

static mut DMA_SOURCE: [10000]u8 = [0u8; 10000]
static mut DMA_TARGET: [10000]u8 = [0u8; 10000]

fn dma_checks(dma: &mut chip.Dma) {
    channel := dma.channel()!
    same := true
    unsafe {
        for index in 0..10000usize {
            DMA_SOURCE[index] = ((index * 13 + 7) & 255) as u8
            DMA_TARGET[index] = 0
        }
        match channel.copy(&mut DMA_TARGET, &DMA_SOURCE) {
            ok() => {}
            err(error) => {
                say("dma copy failed: ")
                say(hal.error_name(error))
                say("\n")
                same = false
            }
        }
        for index in 0..10000usize {
            same = same && DMA_TARGET[index] == ((index * 13 + 7) & 255) as u8
        }
    }
    check(same && !channel.is_busy() && channel.remaining() == 0)
    second := dma.channel()!
    third := dma.channel()!
    busy := refused(dma.channel(), hal.Error.Busy) && refused(dma.claim(3), hal.Error.InvalidInput)
    paced := hal.DmaTransfer {
        source: 0x4080_0000,
        destination: 0x6000_0000,
        count: 4,
        width: hal.DmaWidth.Byte,
        increment_source: true,
        increment_destination: false,
        pace: hal.DmaPace.Destination,
        ring: hal.DmaRing.None,
    }
    refused_paced := unsafe {
        failed_with(second.start(paced), hal.Error.InvalidInput)
    }
    dma.release(third)
    dma.release(second)
    check(busy && refused_paced && channel.number() == 0 && dma.is_claimed(0) && !dma.is_claimed(2))
    dma.release(channel)
}

fn numeric_checks() {
    // Values the optimizer cannot fold.
    z32 := unsafe {
        DATA[1] - 7
    }
    z := z32 as u64
    check((0xFEDC_BA98_7654_3210u64 ^ z) / 0x12345 == 0xE000_4FA0_1C4D && (0xFEDC_BA98_7654_3210u64 ^ z) % 0x12345 == 0x10A4F && (-81_985_529_216_486_895 + z as i64) / 4660 == -17_593_461_205_254 && (-81_985_529_216_486_895 + z as i64) % 4660 == -3255 && core.wrapping_mul(0x1_2345_6789u64 ^ z, 0xA_BCDE_F012) == 0x379A_AAB7_F0BF_B7A2)
    e := z as f32
    check((0.1f32 + e) + 0.2f32 == 0.3f32 && (1.1754944e-38f32 + e) / 8.0f32 == 1.469368e-39f32 && (10.5f32 + e) % 3.0f32 == 1.5f32 && ((1.0f32 + e) / 3.0f32) as f64 == 0.3333333432674408)
    d := z as f64
    nan := d / d
    check((0.1 + d) + 0.2 == 0.30000000000000004 && (1.0 + d) / 3.0 * 3.0 == 1.0 && (10.5 + d) % 3.0 == 1.5 && nan != nan && (-3.75 + d) as i32 == -3 && (1e19 + d) as u64 == 10_000_000_000_000_000_000)
    counter: atomic.Atomic<u32> = atomic.Atomic.new(5u32)
    before := counter.fetch_add(3, atomic.Ordering.AcqRel)!
    swapped := counter.compare_exchange(8, 1, atomic.Ordering.AcqRel, atomic.Ordering.Acquire)!
    check(before == 5 && swapped.previous == 8 && swapped.exchanged && counter.load(atomic.Ordering.Acquire)! == 1)
}

fn main() {
    b := board.take()!
    serial := b.usb.serial()!
    // Wait for the host's first byte, so no output is lost before the
    // port is open.
    poke: [1]u8 = [0]
    serial.read(&mut poke)!
    connected := serial.is_connected()
    serial.set_crlf(true)
    unsafe {
        SERIAL = some(serial)
    }
    say("selftest ready\n")

    check(refused(board.take(), hal.Error.Busy))
    unsafe {
        check(DATA[0] == 0xDEAD_BEEF && DATA[1] == 7 && DATA[2] == 0x1234_5678)
    }
    start_cycles()
    begin := b.timer.now_us()
    b.timer.delay_ms(10)
    counted := cycles()
    elapsed := b.timer.now_us() - begin
    say_number("cycles in 10 ms ", counted)
    say_number("delay 10 ms took us ", elapsed as u32)
    check(counted > 1_580_000 && counted < 1_620_000)
    check(elapsed >= 10_000 && elapsed < 10_050)

    pin_checks(&mut b)
    bus_checks(&mut b.pins, &mut b.timer)
    uart_checks(&mut b.pins, &mut b.timer)
    pwm_adc_checks(&mut b.pins, &mut b.timer)
    interrupt_checks(&mut b.pins, &mut b.timer)
    executor_checks(&mut b.timer)
    dma_checks(&mut b.dma)
    numeric_checks()
    check(connected)

    // The board's bus pins are free and usable.
    usable := true
    pins: [8]u32 = [board.I2C_SDA_PIN, board.I2C_SCL_PIN, board.SPI_CLOCK_PIN, board.SPI_TX_PIN, board.SPI_RX_PIN, board.SPI_SELECT_PIN, board.UART_TX_PIN, board.UART_RX_PIN]
    for index in 0..8usize {
        match b.pins.output(pins[index]) {
            ok(pin) => {
                b.pins.release(pin)
            }
            err(_) => {
                usable = false
            }
        }
    }
    check(usable && board.NAME.len == 18)

    count := unsafe {
        CHECKS
    }
    say_number("selftest done ", count)
    b.led.set_color(0x00_10_00)
    for {
        b.timer.delay_ms(1000)
    }
}
