package main

import "core/ptr"
import "std/embedded/hal"
import "std/embedded/hal/fake"
import "std/fmt"
import "std/io"

// A portable driver, written once against the HAL protocols.
struct Thermometer<B> {
    bus: B
    address: u8

    fn new(bus: B, address: u8) -> Thermometer<B> {
        return Thermometer<B> { bus, address }
    }

    fn enable(&mut self) -> void!hal.Error {
        return hal.write_register(&mut self.bus, self.address, 0x01, 0x80)
    }

    // Tenths of a degree, from a big-endian 16-bit register pair.
    fn read_tenths(&mut self) -> i32!hal.Error {
        raw: [2]u8 = [0, 0]
        hal.read_registers(&mut self.bus, self.address, 0x10, &mut raw)?
        return ok(((raw[0] as i32) << 8) | raw[1] as i32)
    }

    fn release(self) -> B {
        let Thermometer { bus, address } = self
        return bus
    }
}

fn blink<P, D>(led: &mut P, delay: &mut D, times: u32) {
    for _ in 0..times {
        led.set_high()
        hal.delay_ms(delay, 500)
        led.set_low()
        hal.delay_ms(delay, 500)
    }
}

const ENABLE: u32 = 1 << 0
const MODE: u32 = 0b111 << 4
const WHOLE: u32 = 0xFFFF_FFFF
const HIGH_NIBBLE: u8 = 0xF0

fn registers() {
    storage: u32 = 0
    address := unsafe {
        ptr.from_mut(&mut storage) as usize
    }
    control: hal.Reg<u32> = unsafe {
        hal.Reg.at(address)
    }

    core.assert_eq(control.address(), address)
    control.write(ENABLE | hal.encode(MODE, 5))
    core.assert_eq(control.read(), 0x51u32)
    core.assert_eq(control.get(MODE), 5u32)
    core.assert(control.any(ENABLE))

    control.set(MODE, 2)
    core.assert_eq(control.read(), 0x21u32)
    control.clear_bits(ENABLE)
    core.assert(!control.any(ENABLE))
    control.set_bits(0x8000_0000)
    core.assert_eq(control.get(WHOLE), 0x8000_0020u32)
    control.modify(WHOLE, 0x7)
    core.assert_eq(control.read(), 7u32)
    core.assert_eq(hal.decode(MODE, 0xFFu32), 7u32)
    core.assert_eq(hal.encode(WHOLE, 9), 9u32)

    control.write(0x30)
    control.wait_set(0x30, 1)!
    control.wait_clear(ENABLE, 1)!
    match control.wait_set(0x70, 3) {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }
    match control.wait_clear(0x10, 3) {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }

    byte_storage: u8 = 0xA5
    byte_address := unsafe {
        ptr.from_mut(&mut byte_storage) as usize
    }
    status: hal.Reg<u8> = unsafe {
        hal.Reg.at(byte_address)
    }
    core.assert_eq(status.get(HIGH_NIBBLE), 0xAu8)
}

fn pins_and_delays() {
    led := fake.Pin.new()
    delay := fake.Delay.new()
    blink(&mut led, &mut delay, 3)
    core.assert_eq(led.changes(), 6u32)
    core.assert(!led.is_high())
    core.assert_eq(delay.elapsed_us(), 3_000_000u64)
    hal.write_pin(&mut led, true)
    core.assert(led.is_high())
}

fn i2c_driver() {
    bus := fake.I2c.new(0x48)
    bus.set_register(0x10, 0x01)
    bus.set_register(0x11, 0x2C)
    sensor := Thermometer.new(bus, 0x48)
    sensor.enable()!
    core.assert_eq(sensor.read_tenths()!, 300i32)

    bus = sensor.release()
    core.assert_eq(bus.register(0x01), 0x80u8)
    core.assert_eq(hal.read_register(&mut bus, 0x48, 0x11)!, 0x2Cu8)

    bus.fail_next(hal.Error.Bus)
    match hal.read_register(&mut bus, 0x48, 0x11) {
        ok(value) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Bus)
        }
    }
    match hal.write_register(&mut bus, 0x49, 0, 0) {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.NoAcknowledge)
            core.assert_eq(hal.error_name(error), "NoAcknowledge")
        }
    }
}

fn spi_devices() {
    bus := fake.Spi.new()
    flash := hal.SpiDevice.new(fake.Pin.new())
    display := hal.SpiDevice.new(fake.Pin.new())

    reply: [3]u8 = [0x00, 0xEF, 0x40]
    bus.reply_with(&reply)
    id: [2]u8 = [0, 0]
    command: [1]u8 = [0x9F]
    flash.write_read(&mut bus, &command, &mut id)!
    core.assert_eq(id[0], 0xEFu8)
    core.assert_eq(id[1], 0x40u8)
    core.assert_eq(bus.sent().len, 3usize)
    core.assert_eq(bus.sent()[0], 0x9Fu8)

    bus.clear()
    pixels: [4]u8 = [1, 2, 3, 4]
    display.write(&mut bus, &pixels)!
    core.assert_eq(bus.sent().len, 4usize)

    select := flash.release()
    core.assert(select.is_high())
    core.assert_eq(select.changes(), 3u32)
}

// A driver for a device that answers commands on a serial line, like many
// GPS and modem modules: it sends a command line and reads one reply line.
fn query<S>(serial: &mut S, command: &str, reply: &mut[u8]) -> usize!io.Error {
    fmt.printf(serial, "{}\r\n", command)?
    line := io.read_line(serial, reply)?
    return ok(line.count)
}

fn serial_ports() {
    serial := fake.Serial.new()
    serial.feed(b"OK 21.5\nREADY\n")
    reply: [16]u8 = [0; 16]
    count := query(&mut serial, "TEMP?", &mut reply)!
    core.assert_eq(count, 8usize)
    core.assert_eq(reply[3], 50u8)
    core.assert(bytes_equal(serial.sent(), b"TEMP?\r\n"))

    // Unread input stays queued in front of new input; then end of input.
    serial.feed(b"x")
    rest: [16]u8 = [0; 16]
    core.assert_eq(io.read_up_to(&mut serial, &mut rest)!, 7usize)
    core.assert_eq(rest[5], 10u8)
    core.assert_eq(rest[6], 120u8)
    core.assert_eq(serial.read(&mut rest)!, 0usize)

    serial.clear()
    fmt.printf(&mut serial, "{} {}", 42, true)!
    core.assert(bytes_equal(serial.sent(), b"42 true"))
}

fn bytes_equal(left: &[u8], right: &[u8]) -> bool {
    if left.len != right.len {
        return false
    }
    for index in 0..left.len {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

// A dimmer: an LED's brightness follows a potentiometer, written once
// against the PWM output and analog input protocols.
fn follow<A: hal.AnalogInput, P: hal.PwmOutput>(knob: &mut A, led: &mut P) -> void!hal.Error {
    value := knob.read()?
    return hal.set_duty_fraction(led, value as u32, knob.max_value() as u32)
}

fn expect_error(result: void!hal.Error, expected: hal.Error) {
    match result {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

fn expect_read_error(result: u16!hal.Error, expected: hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

fn pwm_outputs() {
    led := fake.Pwm.new(1000)
    core.assert_eq(led.duty(), 0u16)
    hal.set_duty_percent(&mut led, 25)!
    core.assert_eq(led.duty(), 250u16)
    hal.set_duty_percent(&mut led, 100)!
    core.assert_eq(led.duty(), 1000u16)
    // Fractions round to the nearest step.
    hal.set_duty_fraction(&mut led, 1, 3)!
    core.assert_eq(led.duty(), 333u16)
    hal.set_duty_fraction(&mut led, 2, 3)!
    core.assert_eq(led.duty(), 667u16)
    // A servo pulse: 1.5 ms of a 20 ms period.
    hal.set_pulse_us(&mut led, 1500, 20_000)!
    core.assert_eq(led.duty(), 75u16)
    core.assert_eq(led.changes(), 5u32)

    expect_error(hal.set_duty_percent(&mut led, 101), hal.Error.InvalidInput)
    expect_error(hal.set_duty_fraction(&mut led, 1, 0), hal.Error.InvalidInput)
    expect_error(led.set_duty(1001), hal.Error.InvalidInput)
    led.fail_next(hal.Error.NoAcknowledge)
    expect_error(hal.set_duty_percent(&mut led, 10), hal.Error.NoAcknowledge)
    core.assert(led.duty() == 75 && led.changes() == 5)

    // The full 16-bit range: max_duty 65535 still rounds exactly.
    wide := fake.Pwm.new(65535)
    hal.set_duty_percent(&mut wide, 50)!
    core.assert_eq(wide.duty(), 32768u16)
    hal.set_duty_fraction(&mut wide, 1, 1)!
    core.assert_eq(wide.duty(), 65535u16)

    // Through `dyn`, for outputs chosen at run time.
    outputs: [2] &mut dyn hal.PwmOutput = [&mut led, &mut wide]
    for index in 0..2usize {
        outputs[index].set_duty(0)!
    }
    core.assert(led.duty() == 0 && wide.duty() == 0)
}

fn analog_inputs() {
    knob := fake.Analog.new(4095)
    core.assert_eq(knob.read()!, 0u16)
    knob.set(4095)
    core.assert_eq(hal.read_millivolts(&mut knob, 3300)!, 3300u32)
    knob.set(1241)
    core.assert_eq(hal.read_millivolts(&mut knob, 3300)!, 1000u32)

    // Queued values come first, in order, then the set value again.
    values: [3]u16 = [0, 2048, 4095]
    knob.queue(&values)
    more: [1]u16 = [100]
    core.assert_eq(knob.read()!, 0u16)
    knob.queue(&more)
    core.assert_eq(knob.read()!, 2048u16)
    core.assert_eq(knob.read()!, 4095u16)
    core.assert_eq(knob.read()!, 100u16)
    core.assert_eq(knob.read()!, 1241u16)
    core.assert_eq(knob.reads(), 8u32)

    knob.fail_next(hal.Error.Timeout)
    expect_read_error(knob.read(), hal.Error.Timeout)
    core.assert_eq(knob.reads(), 8u32)

    // A driver over both protocols.
    led := fake.Pwm.new(255)
    knob.set(2048)
    follow(&mut knob, &mut led)!
    core.assert_eq(led.duty(), 128u16)
    knob.fail_next(hal.Error.Bus)
    expect_error(follow(&mut knob, &mut led), hal.Error.Bus)
    core.assert_eq(led.changes(), 1u32)

    input: &mut dyn hal.AnalogInput = &mut knob
    core.assert_eq(input.max_value(), 4095u16)
    core.assert_eq(input.read()!, 2048u16)
}

// A driver written once against the Rng protocol: shuffle `values` in place
// (Fisher-Yates), for a game or a randomized test order.
fn shuffle<R: hal.Rng>(rng: &mut R, values: &mut[u32]) -> void!hal.Error {
    count := values.len as u32
    for step in 1u32..count {
        last := count - step
        other := hal.random_below(rng, last + 1)? as usize
        held := values[last as usize]
        values[last as usize] = values[other]
        values[other] = held
    }
    return ok()
}

fn random_numbers() {
    // The fake fills a counting pattern; numbers are little-endian.
    source := fake.Rng.new()
    core.assert_eq(hal.random_u32(&mut source)!, 0x0302_0100u32)
    core.assert_eq(hal.random_u64(&mut source)!, 0x0B0A_0908_0706_0504u64)
    core.assert_eq(source.drawn(), 12u32)
    bytes := [0u8; 3]
    source.fill(&mut bytes)!
    core.assert(bytes[0] == 12 && bytes[1] == 13 && bytes[2] == 14)

    // random_below rejects the low 2^32 mod bound values: for a bound of 3
    // that is 0 (2^32 = 1 mod 3), so 0 is drawn again.
    rejected: [8]u8 = [0, 0, 0, 0, 7, 0, 0, 0]
    source.queue(&rejected)
    core.assert_eq(hal.random_below(&mut source, 3)!, 1u32)
    core.assert_eq(source.drawn(), 23u32)
    core.assert_eq(hal.random_below(&mut source, 1)!, 0u32)
    match hal.random_below(&mut source, 0) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    source.fail_next(hal.Error.Timeout)
    match hal.random_u32(&mut source) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }

    // SoftRng is xoshiro128**: from the state 1, 2, 3, 4 its first outputs
    // are those of the reference implementation.
    state: [16]u8 = [1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4, 0, 0, 0]
    source.queue(&state)
    soft := hal.SoftRng.from_rng(&mut source)!
    core.assert_eq(soft.next_u32(), 11520u32)
    core.assert_eq(soft.next_u32(), 0u32)
    core.assert_eq(soft.next_u32(), 5_927_040u32)
    core.assert_eq(soft.next_u32(), 70_819_200u32)
    // `new` expands its seed with SplitMix64.
    seeded := hal.SoftRng.new(0)
    core.assert_eq(seeded.next_u32(), 0xDEC9_045Du32)
    again := hal.SoftRng.new(0)
    core.assert_eq(again.next_u32(), 0xDEC9_045Du32)
    // An all-zero state, which xoshiro cannot leave, is replaced.
    zeros := [0u8; 16]
    source.queue(&zeros)
    stuck := hal.SoftRng.from_rng(&mut source)!
    core.assert(stuck.next_u32() != 0 || stuck.next_u32() != 0)
    source.fail_next(hal.Error.Bus)
    match hal.SoftRng.from_rng(&mut source) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Bus)
        }
    }

    // Fills of any length, and roughly uniform values.
    odd := [0u8; 7]
    seeded.fill(&mut odd)!
    counts := [0u32; 6]
    for _ in 0..6000 {
        counts[hal.random_below(&mut seeded, 6)! as usize] += 1
    }
    for face in 0usize..6 {
        core.assert(counts[face] > 850 && counts[face] < 1150)
    }

    // A driver over the protocol, statically and through `dyn`.
    values: [5]u32 = [1, 2, 3, 4, 5]
    shuffle(&mut seeded, &mut values)!
    sum := 0u32
    for index in 0usize..5 {
        sum += values[index]
    }
    core.assert_eq(sum, 15u32)
    generators: [2] &mut dyn hal.Rng = [&mut seeded, &mut source]
    for index in 0..2usize {
        generators[index].fill(&mut bytes)!
    }
}

fn critical_sections() {
    outer := hal.Critical.enter()
    inner := hal.Critical.enter()
    core.drop(inner)
    core.drop(outer)
}

fn main() {
    registers()
    pins_and_delays()
    i2c_driver()
    spi_devices()
    serial_ports()
    pwm_outputs()
    analog_inputs()
    random_numbers()
    critical_sections()
}
