package http_connection_checks
import "std/http"
import "std/http/connection"
import "std/http/client"
import "std/http/server"
import "std/io"

pub struct Fake {
    input: &[u8]
    position: usize
    written: usize
    pending: bool
    pub fn poll_read(&mut self, output: &mut[u8]) -> io.Poll!io.Error {
        if self.pending {
            self.pending = false
            return ok(io.Poll { state: io.PollState.Pending, transferred: 0 })
        }
        self.pending = true
        if self.position == self.input.len {
            return ok(io.Poll { state: io.PollState.Eof, transferred: 0 })
        }
        count := 3usize
        if count > output.len {
            count = output.len
        }
        if count > self.input.len - self.position {
            count = self.input.len - self.position
        }
        for i in 0usize..count {
            output[i] = self.input[self.position + i]
        }
        self.position += count
        return ok(io.Poll { state: io.PollState.Ready, transferred: count })
    }
    pub fn poll_write(&mut self, input: &[u8]) -> io.Poll!io.Error {
        if self.pending {
            self.pending = false
            return ok(io.Poll { state: io.PollState.Pending, transferred: 0 })
        }
        self.pending = true
        count := 2usize
        if count > input.len {
            count = input.len
        }
        self.written += count
        return ok(io.Poll { state: io.PollState.Ready, transferred: count })
    }
}
fn checks() -> i32!connection.Error {
    workspace := [0u8; 2048]
    input := [0u8; 17]
    output := [0u8; 512]
    driver := connection.Connection.new(http.Role.Response, &mut workspace, &mut input, &mut output, http.Limits.defaults())?
    fake := Fake { input: b"HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nabcHTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nxx", position: 0, written: 0, pending: true }
    headers := [http.Header { name: b"Host", value: b"localhost" }]
    request := http.Request { method: b"GET", target: b"/", headers: &headers, body: http.Body.empty() }
    trailers: [0]http.Header = []
    driver.request(&request)?
    for driver.pending_output() != 0 {
        progress := driver.poll_flush(&mut fake)?
    }
    driver.finish_body(&trailers)?
    total := 0usize
    complete := false
    for i in 0usize..1000 {
        event := driver.poll_event(&mut fake)?
        if event.kind == http.EventKind.Body {
            count := driver.body().len
            total += count
            match driver.poll_event(&mut fake) {
                ok(_) => {
                    return ok(1)
                }
                err(reason) => {
                    if reason.kind != connection.ErrorKind.Backpressure {
                        return ok(2)
                    }
                }
            }
            driver.consume_body(count)?
        }
        if event.kind == http.EventKind.Complete {
            complete = true
            break
        }
    }
    if!complete || total != 3 || !driver.reusable() {
        return ok(3)
    }
    slots := [client.Slot { state: client.SlotState.Vacant, origin: 0, trust: 0, proxy: 0, idle_since_ms: 0 }]
    pool := client.Pool.new(&mut slots)
    match pool.reserve(1, 2, 3) {
        some(index) => {
            if!pool.release(index, &driver, 100) {
                return ok(4)
            }
        }
        none => {
            return ok(5)
        }
    }
    match pool.take(1, 3, 3, 101, 1000) {
        some(_) => {
            return ok(6)
        }
        none => {}
    }
    match pool.take(1, 2, 3, 101, 1000) {
        some(_) => {}
        none => {
            return ok(7)
        }
    }
    driver.next_message()?
    failed := false
    for i in 0usize..1000 {
        match driver.poll_event(&mut fake) {
            ok(_) => {}
            err(_) => {
                failed = true
                break
            }
        }
    }
    if!failed || driver.reusable() || pool.release(0, &driver, 200) {
        return ok(8)
    }
    budget := server.Budget.new()
    budget.enter(server.Phase.Headers, 100, 10)
    match budget.check(110, false) {
        ok() => {
            return ok(9)
        }
        err(_) => {}
    }
    gate := server.Server.new(1)
    match gate.admit() {
        ok() => {}
        err(_) => {
            return ok(10)
        }
    }
    match gate.admit() {
        ok() => {
            return ok(11)
        }
        err(_) => {}
    }
    gate.begin_shutdown(200)
    if gate.accepting() || gate.must_close(199) || !gate.must_close(200) {
        return ok(12)
    }
    match gate.release() {
        ok() => {}
        err(_) => {
            return ok(13)
        }
    }
    if!gate.drained() {
        return ok(14)
    }
    return ok(0)
}
fn main() -> i32 {
    match checks() {
        ok(code) => {
            return code
        }
        err(_) => {
            return 99
        }
    }
}
