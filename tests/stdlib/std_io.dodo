package std_io_checks

import "std/io"
import "core/bytes"
import "core/num"

// Real structural implementations: no inheritance, traits, closures, or vtable.
pub struct ShortReader {
    data: &[u8]
    offset: usize
    calls: usize
    interrupt: bool
    fail_call: usize

    pub fn read(&mut self, destination: &mut[u8]) -> usize!io.Error {
        self.calls += 1
        if destination.len == 0 {
            return ok(0)
        }
        count := num.min(2, num.min(destination.len, self.data.len - self.offset))
        failed := self.calls == self.fail_call
        if self.interrupt || failed {
            count = num.min(count, 1)
        }
        for i in 0usize..count {
            destination[i] = self.data[self.offset + i]
        }
        self.offset += count
        if self.interrupt {
            self.interrupt = false
            return err(io.failure(io.ErrorKind.Interrupted, count))
        }
        if failed {
            return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: 77 })
        }
        return ok(count)
    }
}
pub struct ShortWriter {
    data: &mut[u8]
    used: usize
    calls: usize
    interrupt: bool
    fail_call: usize

    pub fn write(&mut self, source: &[u8]) -> usize!io.Error {
        self.calls += 1
        if source.len == 0 {
            return ok(0)
        }
        count := num.min(2, num.min(source.len, self.data.len - self.used))
        failed := self.calls == self.fail_call
        if self.interrupt || failed {
            count = num.min(count, 1)
        }
        for i in 0usize..count {
            self.data[self.used + i] = source[i]
        }
        self.used += count
        if self.interrupt {
            self.interrupt = false
            return err(io.failure(io.ErrorKind.Interrupted, count))
        }
        if failed {
            return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: 77 })
        }
        return ok(count)
    }
}
pub struct ZeroWriter {
    pub fn write(&mut self, source: &[u8]) -> usize!io.Error {
        return ok(0)
    }
}
pub struct BadReader {
    pub fn read(&mut self, destination: &mut[u8]) -> usize!io.Error {
        return ok(destination.len + 1)
    }
}
pub struct BadWriter {
    pub fn write(&mut self, source: &[u8]) -> usize!io.Error {
        return err(io.failure(io.ErrorKind.Other, source.len + 1))
    }
}
pub struct PollDevice {
    calls: usize
    pub fn poll_read(&mut self, destination: &mut[u8]) -> io.Poll!io.Error {
        self.calls += 1
        if destination.len == 0 {
            return ok(io.Poll { transferred: 0, state: io.PollState.Ready })
        }
        destination[0] = 99
        return ok(io.Poll { transferred: 1, state: io.PollState.Pending })
    }
    pub fn poll_write(&mut self, source: &[u8]) -> io.Poll!io.Error {
        self.calls += 1
        return ok(io.Poll { transferred: 0, state: io.PollState.Pending })
    }
}

pub struct ErrorReader {
    calls: usize
    pub fn read(&mut self, destination: &mut[u8]) -> usize!io.Error {
        if destination.len == 0 {
            return ok(0)
        }
        self.calls += 1
        count := num.min(3, destination.len)
        for i in 0usize..count {
            destination[i] = 11 + i as u8
        }
        return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: 88 })
    }
}
pub struct BrokenPoll {
    pub fn poll_read(&mut self, destination: &mut[u8]) -> io.Poll!io.Error {
        return ok(io.Poll { transferred: 0, state: io.PollState.Ready })
    }
    pub fn poll_write(&mut self, source: &[u8]) -> io.Poll!io.Error {
        return ok(io.Poll { transferred: 0, state: io.PollState.Eof })
    }
}
pub struct InterruptedPoll {
    calls: usize
    pub fn poll_read(&mut self, destination: &mut[u8]) -> io.Poll!io.Error {
        self.calls += 1
        return err(io.failure(io.ErrorKind.Interrupted, 0))
    }
}

fn memory() -> i32!io.Error {
    source := [1u8, 2, 3, 4, 5]
    reader := io.MemoryReader.new(&source)
    out := [0u8; 8]
    match io.read_exact(&mut reader, &mut out) {
        ok(_) => {
            return ok(1)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.UnexpectedEof || reason.transferred != 5 {
                return ok(2)
            }
        }
    }
    if reader.position() != 5 || !bytes.equal(&out[..5], &source) || out[5] != 0 {
        return ok(3)
    }
    if reader.read(&mut out[..0])? != 0 || reader.position() != 5 {
        return ok(4)
    }
    match reader.seek(num.MAX) {
        ok(_) => {
            return ok(5)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.OutOfBounds {
                return ok(6)
            }
        }
    }
    if reader.position() != 5 || io.seek(&mut reader, 2)? != 2 || reader.remaining()[0] != 3 {
        return ok(7)
    }
    backing := [0u8; 3]
    writer := io.MemoryWriter.new(&mut backing)
    match io.write_all(&mut writer, &source) {
        ok(_) => {
            return ok(8)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.BufferFull || reason.transferred != 3 {
                return ok(9)
            }
        }
    }
    if!bytes.equal(writer.written(), &source[..3]) || writer.remaining() != 0 {
        return ok(10)
    }
    if writer.write(&source[..0])? != 0 {
        return ok(11)
    }
    cursor_data := [10u8, 20, 30, 40]
    cursor := io.Cursor.new(&mut cursor_data)
    if io.seek(&mut cursor, 1)? != 1 || io.write_all(&mut cursor, &source[..2])? != 2 {
        return ok(12)
    }
    if cursor.bytes()[0] != 10 || cursor.bytes()[1] != 1 || cursor.bytes()[2] != 2 {
        return ok(13)
    }
    if cursor.seek(0)? != 0 || io.read_exact(&mut cursor, &mut out[..4])? != 4 || out[3] != 40 {
        return ok(14)
    }
    return ok(0)
}

fn progress() -> i32!io.Error {
    source := [1u8, 2, 3, 4, 5, 6, 7]
    output := [0u8; 7]
    reader := ShortReader { data: &source, offset: 0, calls: 0, interrupt: true, fail_call: 0 }
    if io.read_exact(&mut reader, &mut output[..0])? != 0 || reader.calls != 0 {
        return ok(20)
    }
    if io.read_exact(&mut reader, &mut output)? != 7 || reader.calls != 4 || !bytes.equal(&output, &source) {
        return ok(21)
    }
    backing := [0u8; 7]
    writer := ShortWriter { data: &mut backing, used: 0, calls: 0, interrupt: true, fail_call: 0 }
    if io.write_all(&mut writer, &source[..0])? != 0 || writer.calls != 0 {
        return ok(22)
    }
    if io.write_all(&mut writer, &source)? != 7 || writer.calls != 4 {
        return ok(23)
    }
    if!bytes.equal(&backing, &source) {
        return ok(24)
    }
    failing_read := ShortReader { data: &source, offset: 0, calls: 0, interrupt: false, fail_call: 2 }
    match io.read_exact(&mut failing_read, &mut output) {
        ok(_) => {
            return ok(25)
        }
        err(reason) => {
            if reason.transferred != 3 || reason.code != 77 {
                return ok(26)
            }
        }
    }
    if failing_read.offset != 3 {
        return ok(27)
    }
    failing_write := ShortWriter { data: &mut backing, used: 0, calls: 0, interrupt: false, fail_call: 2 }
    match io.write_all(&mut failing_write, &source) {
        ok(_) => {
            return ok(28)
        }
        err(reason) => {
            if reason.transferred != 3 || reason.code != 77 {
                return ok(29)
            }
        }
    }
    if failing_write.used != 3 {
        return ok(30)
    }
    zero := ZeroWriter {}
    match io.write_all(&mut zero, &source) {
        ok(_) => {
            return ok(31)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.WriteZero || reason.transferred != 0 {
                return ok(32)
            }
        }
    }
    bad_reader := BadReader {}
    match io.read_exact(&mut bad_reader, &mut output) {
        ok(_) => {
            return ok(33)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.InvalidProgress {
                return ok(34)
            }
        }
    }
    bad_writer := BadWriter {}
    match io.write_all(&mut bad_writer, &source) {
        ok(_) => {
            return ok(35)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.InvalidProgress {
                return ok(36)
            }
        }
    }
    return ok(0)
}

fn bounded() -> i32!io.Error {
    source := [1u8, 2, 3, 4, 5, 6, 7]
    output := [0u8; 8]
    reader := io.MemoryReader.new(&source)
    limited := io.LimitReader.new(&mut reader, 3)
    if io.read_up_to(&mut limited, &mut output)? != 3 || limited.remaining() != 0 {
        return ok(40)
    }
    core.drop(limited)
    if!bytes.equal(&output[..3], &source[..3]) {
        return ok(41)
    }
    if reader.position() != 3 {
        return ok(42)
    }
    scratch := [0u8; 2]
    if io.skip(&mut reader, 3, &mut scratch)? != 3 {
        return ok(43)
    }
    match io.skip(&mut reader, 3, &mut scratch) {
        ok(_) => {
            return ok(44)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.UnexpectedEof || reason.transferred != 1 {
                return ok(45)
            }
        }
    }
    match io.skip(&mut reader, 1, &mut scratch[..0]) {
        ok(_) => {
            return ok(46)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.InvalidInput {
                return ok(47)
            }
        }
    }
    if io.skip(&mut reader, 0, &mut scratch[..0])? != 0 {
        return ok(48)
    }
    return ok(0)
}

fn copying() -> i32 {
    source := [1u8, 2, 3, 4, 5, 6, 7]
    scratch := [0u8; 4]
    output := [0u8; 10]
    reader := io.MemoryReader.new(&source)
    writer := io.MemoryWriter.new(&mut output)
    match io.copy(&mut reader, &mut writer, &mut scratch, num.MAX) {
        ok(report) => {
            if report.read != 7 || report.written != 7 || !report.eof {
                return 50
            }
        }
        err(_) => {
            return 51
        }
    }
    if!bytes.equal(writer.written(), &source) {
        return 52
    }
    core.drop(writer)
    limited_reader := io.MemoryReader.new(&source)
    limited_writer := io.MemoryWriter.new(&mut output)
    match io.copy(&mut limited_reader, &mut limited_writer, &mut scratch, 3) {
        ok(report) => {
            if report.read != 3 || report.written != 3 || report.eof {
                return 53
            }
        }
        err(_) => {
            return 54
        }
    }
    core.drop(limited_writer)
    failed_reader := io.MemoryReader.new(&source)
    failed_writer := ShortWriter { data: &mut output, used: 0, calls: 0, interrupt: false, fail_call: 2 }
    match io.copy(&mut failed_reader, &mut failed_writer, &mut scratch, 7) {
        ok(_) => {
            return 55
        }
        err(reason) => {
            if reason.read != 4 || reason.written != 3 || reason.cause.code != 77 {
                return 56
            }
        }
    }
    core.drop(failed_writer)
    partial_reader := ShortReader { data: &source, offset: 0, calls: 0, interrupt: false, fail_call: 2 }
    partial_writer := io.MemoryWriter.new(&mut output)
    match io.copy(&mut partial_reader, &mut partial_writer, &mut scratch, 7) {
        ok(_) => {
            return 57
        }
        err(reason) => {
            if reason.read != 3 || reason.written != 3 || reason.cause.code != 77 {
                return 58
            }
        }
    }
    core.drop(partial_writer)
    retry_reader := ShortReader { data: &source, offset: 0, calls: 0, interrupt: true, fail_call: 0 }
    retry_writer := io.MemoryWriter.new(&mut output)
    match io.copy(&mut retry_reader, &mut retry_writer, &mut scratch, num.MAX) {
        ok(report) => {
            if report.read != 7 || report.written != 7 || !report.eof {
                return 59
            }
        }
        err(_) => {
            return 60
        }
    }
    return 0
}

fn buffering() -> i32!io.Error {
    source := [1u8, 2, 3, 4, 5, 6, 7]
    storage := [0u8; 3]
    output := [0u8; 7]
    reader := ShortReader { data: &source, offset: 0, calls: 0, interrupt: true, fail_call: 0 }
    buffered := io.BufferedReader.new(&mut reader, &mut storage)?
    if io.read_exact(&mut buffered, &mut output)? != 7 {
        return ok(61)
    }
    core.drop(buffered)
    if!bytes.equal(&output, &source) {
        return ok(61)
    }
    failing := ShortReader { data: &source, offset: 0, calls: 0, interrupt: false, fail_call: 2 }
    failed_buffered := io.BufferedReader.new(&mut failing, &mut storage)?
    match io.read_exact(&mut failed_buffered, &mut output) {
        ok(_) => {
            return ok(62)
        }
        err(reason) => {
            if reason.transferred != 3 || reason.code != 77 {
                return ok(63)
            }
        }
    }
    core.drop(failed_buffered)
    writer := ShortWriter { data: &mut output, used: 0, calls: 0, interrupt: true, fail_call: 0 }
    buffered_writer := io.BufferedWriter.new(&mut writer, &mut storage)?
    if io.write_all(&mut buffered_writer, &source)? != 7 || buffered_writer.pending().len != 1 {
        return ok(64)
    }
    if buffered_writer.flush()? != 1 || buffered_writer.pending().len != 0 {
        return ok(65)
    }
    core.drop(buffered_writer)
    if writer.used != 7 {
        return ok(66)
    }
    core.drop(writer)
    if!bytes.equal(&output, &source) {
        return ok(67)
    }
    failed_writer := ShortWriter { data: &mut output, used: 0, calls: 0, interrupt: false, fail_call: 1 }
    flush_buffer := io.BufferedWriter.new(&mut failed_writer, &mut storage)?
    if io.write_all(&mut flush_buffer, &source[..3])? != 3 {
        return ok(68)
    }
    match flush_buffer.flush() {
        ok(_) => {
            return ok(69)
        }
        err(reason) => {
            if reason.transferred != 1 || reason.code != 77 {
                return ok(70)
            }
        }
    }
    if!bytes.equal(flush_buffer.pending(), &source[1..3]) || flush_buffer.flush()? != 2 {
        return ok(71)
    }
    core.drop(flush_buffer)
    if failed_writer.used != 3 {
        return ok(72)
    }
    core.drop(failed_writer)
    empty_reader := io.MemoryReader.new(&source)
    match io.BufferedReader.new(&mut empty_reader, &mut storage[..0]) {
        ok(_) => {
            return ok(73)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.InvalidInput {
                return ok(74)
            }
        }
    }
    empty_writer := io.MemoryWriter.new(&mut output)
    match io.BufferedWriter.new(&mut empty_writer, &mut storage[..0]) {
        ok(_) => {
            return ok(75)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.InvalidInput {
                return ok(76)
            }
        }
    }
    core.drop(empty_writer)
    deferred_reader := ErrorReader { calls: 0 }
    deferred := io.BufferedReader.new(&mut deferred_reader, &mut storage)?
    if deferred.read(&mut output[..1])? != 1 || output[0] != 11 || deferred.buffered().len != 2 {
        return ok(84)
    }
    if deferred.read(&mut output[..1])? != 1 || output[0] != 12 {
        return ok(85)
    }
    match deferred.read(&mut output[..1]) {
        ok(_) => {
            return ok(86)
        }
        err(reason) => {
            if reason.code != 88 || reason.transferred != 1 || output[0] != 13 {
                return ok(87)
            }
        }
    }
    core.drop(deferred)
    if deferred_reader.calls != 1 {
        return ok(88)
    }
    auto_writer := ShortWriter { data: &mut output, used: 0, calls: 0, interrupt: false, fail_call: 1 }
    auto_buffer := io.BufferedWriter.new(&mut auto_writer, &mut storage)?
    match io.write_all(&mut auto_buffer, &source[..6]) {
        ok(_) => {
            return ok(89)
        }
        err(reason) => {
            if reason.transferred != 3 || reason.code != 77 {
                return ok(90)
            }
        }
    }
    if!bytes.equal(auto_buffer.pending(), &source[1..3]) || auto_buffer.flush()? != 2 {
        return ok(91)
    }
    return ok(0)
}

fn polling() -> i32!io.Error {
    device := PollDevice { calls: 0 }
    storage := [0u8; 2]
    progress := io.poll_read_once(&mut device, &mut storage)?
    if progress.state != io.PollState.Pending || progress.transferred != 1 || device.calls != 1 || storage[0] != 99 {
        return ok(80)
    }
    written := io.poll_write_once(&mut device, &storage)?
    if written.state != io.PollState.Pending || written.transferred != 0 || device.calls != 2 {
        return ok(81)
    }
    empty_read := io.poll_read_once(&mut device, &mut storage[..0])?
    empty_write := io.poll_write_once(&mut device, &storage[..0])?
    if device.calls != 2 || empty_read.state != io.PollState.Ready || empty_write.transferred != 0 {
        return ok(82)
    }
    reader := io.MemoryReader.new(&storage[..0])
    destination := [0u8; 1]
    eof := io.poll_read_once(&mut reader, &mut destination)?
    if eof.state != io.PollState.Eof || eof.transferred != 0 {
        return ok(83)
    }
    broken := BrokenPoll {}
    match io.poll_read_once(&mut broken, &mut destination) {
        ok(_) => {
            return ok(92)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.InvalidProgress {
                return ok(93)
            }
        }
    }
    match io.poll_write_once(&mut broken, &destination) {
        ok(_) => {
            return ok(94)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.InvalidProgress {
                return ok(95)
            }
        }
    }
    interrupted := InterruptedPoll { calls: 0 }
    match io.poll_read_once(&mut interrupted, &mut destination) {
        ok(_) => {
            return ok(96)
        }
        err(reason) => {
            if reason.kind != io.ErrorKind.Interrupted || interrupted.calls != 1 {
                return ok(97)
            }
        }
    }
    return ok(0)
}

fn check() -> i32!io.Error {
    code := memory()?
    if code != 0 {
        return ok(code)
    }
    code = progress()?
    if code != 0 {
        return ok(code)
    }
    code = bounded()?
    if code != 0 {
        return ok(code)
    }
    code = copying()
    if code != 0 {
        return ok(code)
    }
    code = buffering()?
    if code != 0 {
        return ok(code)
    }
    return polling()
}
fn main() -> i32 {
    match check() {
        ok(code) => {
            return code
        }
        err(_) => {
            return 99
        }
    }
}
