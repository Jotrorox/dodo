fn check_gzip() -> i32 {
    input: [98]u8 = [31u8, 139, 8, 0, 0, 0, 0, 0, 2, 255, 237, 196, 73, 17, 0, 0, 8, 4, 160, 172, 235, 209, 191, 130, 99, 15, 120, 144, 234, 217, 72, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 146, 36, 73, 250, 14, 11, 145, 165, 240, 64, 156, 0, 0]
    output := [0u8; 40000]
    match gzip.decode(&input, &mut output) {
        ok(result) => {
            if result.input_consumed != 98 || result.output_written != 40000 { return 1 }
            for i in 0usize..40000 {
                if output[i] != (97 + (i % 5)) as u8 { return 2 }
            }
        }, err(_) => { return 3 }
    }
    match gzip.decode(&input, &mut output[..39999]) {
        ok(_) => { return 4 }, err(reason) => { if reason != gzip.Error.OutputFull { return 6 } }
    }
    for split in 0usize..98 {
        match gzip.decode(&input[..split], &mut output) {
            ok(_) => { return 5 }, err(_) => {}
        }
    }
    return 0
}

fn check_errors() -> i32 {
    output := [0u8; 32]
    invalid_type := [7u8]
    invalid_stored := [1u8, 1, 0, 0, 0, 65]
    invalid_distance := [3u8, 2, 0]
    invalid_tree := [5u8,0,146,4]
    invalid_inputs := [&invalid_type[..], &invalid_stored[..], &invalid_distance[..], &invalid_tree[..]]
    for &input in invalid_inputs {
        match deflate.decode(input, &mut output) {
            ok(_) => { return 1 }, err(reason) => { if reason != deflate.Error.InvalidData { return 2 } }
        }
    }
    bad_zlib := [0u8, 0]
    match zlib.decode(&bad_zlib, &mut output) {
        ok(_) => { return 3 }, err(reason) => { if reason != zlib.Error.InvalidData { return 4 } }
    }
    dictionary := [0x78u8, 0x20]
    match zlib.decode(&dictionary, &mut output) {
        ok(_) => { return 5 }, err(reason) => { if reason != zlib.Error.UnsupportedDictionary { return 6 } }
    }
    bad_adler := [0x78u8, 0x9c, 3, 0, 0, 0, 0, 0]
    match zlib.decode(&bad_adler, &mut output) {
        ok(_) => { return 7 }, err(reason) => { if reason != zlib.Error.ChecksumMismatch { return 8 } }
    }
    bad_gzip := [31u8, 139, 8, 224, 0, 0, 0, 0, 0, 255]
    match gzip.decode(&bad_gzip, &mut output) {
        ok(_) => { return 9 }, err(reason) => { if reason != gzip.Error.InvalidData { return 10 } }
    }
    bad_crc := [31u8, 139, 8, 0, 0, 0, 0, 0, 0, 255, 3, 0, 1, 0, 0, 0, 0, 0, 0, 0]
    match gzip.decode(&bad_crc, &mut output) {
        ok(_) => { return 11 }, err(reason) => { if reason != gzip.Error.ChecksumMismatch { return 12 } }
    }
    return 0
}

fn main() -> i32 {
    if check_errors() != 0 { return 40 }
    if check_empty() != 0 { return 10 }
    if check_stored() != 0 { return 11 }
    if check_fixed() != 0 { return 12 }
    if check_dynamic() != 0 { return 13 }
    if check_zlib() != 0 { return 14 }
    if check_gzip() != 0 { return 15 }
    data := [0u8; 257]
    for i in 0usize..data.len { data[i] = (i & 255) as u8 }
    encoded := [0u8; 1024]
    stream := console.stdout()
    for kind in 0usize..3 {
        count := 0usize
        if kind == 0 {
            match deflate.encode(&data, &mut encoded) { ok(n) => { count = n }, err(_) => { return 30 } }
        } else if kind == 1 {
            match zlib.encode(&data, &mut encoded) { ok(n) => { count = n }, err(_) => { return 31 } }
        } else {
            match gzip.encode(&data, &mut encoded) { ok(n) => { count = n }, err(_) => { return 32 } }
        }
        prefix := [(count & 255) as u8, ((count >> 8) & 255) as u8, ((count >> 16) & 255) as u8, ((count >> 24) & 255) as u8]
        match io.write_all(&mut stream, &prefix) { ok(_) => {}, err(_) => { return 33 } }
        match io.write_all(&mut stream, &encoded[..count]) { ok(_) => {}, err(_) => { return 34 } }
    }
    // A stored encoder must cross the 65535-byte block boundary.
    large := [0u8; 65536]
    for i in 0usize..large.len { large[i] = (i & 255) as u8 }
    large_encoded := [0u8; 65560]
    count := match deflate.encode(&large, &mut large_encoded) {
        ok(n) => { n }, err(_) => { return 41 }
    }
    prefix := [(count & 255) as u8, ((count >> 8) & 255) as u8, ((count >> 16) & 255) as u8, ((count >> 24) & 255) as u8]
    match io.write_all(&mut stream, &prefix) { ok(_) => {}, err(_) => { return 42 } }
    match io.write_all(&mut stream, &large_encoded[..count]) { ok(_) => {}, err(_) => { return 43 } }
    return 0
}
