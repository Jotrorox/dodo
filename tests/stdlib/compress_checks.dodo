package compress_checks
import "std/compress/deflate"
import "std/compress/zlib"
import "std/compress/gzip"
import "std/console"
import "std/io"

fn check_empty() -> i32 {
    input: [2]u8 = [3u8, 0]
    output := [0u8; 1]
    match deflate.decode(&input, &mut output) {
        ok(result) => {
            if result.input_consumed != 2 || result.output_written != 0 {
                return 1
            }
            for i in 0usize..0 {
                if output[i] != (97 + (i % 5)) as u8 {
                    return 2
                }
            }
        }, err(_) => {
            return 3
        }
    }
    for split in 0usize..2 {
        match deflate.decode(&input[..split], &mut output) {
            ok(_) => {
                return 5
            }, err(_) => {}
        }
    }
    return 0
}

fn check_stored() -> i32 {
    input: [355]u8 = [1u8, 94, 1, 161, 254, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101, 97, 98, 99, 100, 101]
    output := [0u8; 350]
    match deflate.decode(&input, &mut output) {
        ok(result) => {
            if result.input_consumed != 355 || result.output_written != 350 {
                return 1
            }
            for i in 0usize..350 {
                if output[i] != (97 + (i % 5)) as u8 {
                    return 2
                }
            }
        }, err(_) => {
            return 3
        }
    }
    match deflate.decode(&input, &mut output[..349]) {
        ok(_) => {
            return 4
        }, err(reason) => {
            if reason != deflate.Error.OutputFull {
                return 6
            }
        }
    }
    for split in 0usize..355 {
        match deflate.decode(&input[..split], &mut output) {
            ok(_) => {
                return 5
            }, err(_) => {}
        }
    }
    return 0
}

