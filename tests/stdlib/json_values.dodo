fn rejects(input: &str) -> bool {
    match json.parse_str(input) {
        ok(_) => {
            return false
        },
        err(_) => {
            return true
        }
    }
}
fn text_view(input: &[u8]) -> &str!json.Error from(input) {
    value := json.parse(input)?
    return value.into_str()
}
fn string_view(input: &[u8]) -> json.String!json.Error from(input) {
    value := json.parse(input)?
    return value.into_string()
}
fn string_text_view(input: &[u8]) -> &str!json.Error from(input) {
    value := string_view(input)?
    return value.into_str()
}
fn raw_view(input: &[u8]) -> &[u8]!json.Error from(input) {
    value := json.parse(input)?
    return ok(value.into_raw())
}
