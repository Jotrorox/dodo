    weekdays := [1u32, 5u32, 5u32, 4u32, 2u32, 2u32, 2u32, 2u32, 2u32, 4u32, 7u32, 3u32, 3u32, 2u32, 5u32, 5u32, 1u32, 4u32, 5u32, 6u32, 2u32, 7u32, 6u32, 5u32, 2u32, 5u32, 2u32, 5u32, 1u32, 1u32, 4u32, 2u32, 1u32, 7u32, 5u32, 2u32, 4u32, 6u32, 1u32, 6u32, 4u32, 3u32, 3u32, 3u32, 1u32, 7u32, 6u32, 4u32, 1u32, 2u32, 3u32, 3u32, 2u32, 4u32, 1u32, 2u32, 3u32, 6u32, 7u32, 4u32, 5u32, 1u32, 2u32, 6u32, 3u32, 2u32, 5u32, 3u32, 6u32, 3u32, 6u32, 6u32, 2u32, 4u32, 4u32, 1u32, 5u32, 1u32, 7u32, 7u32, 1u32, 3u32, 3u32, 3u32, 4u32, 7u32, 7u32, 7u32, 2u32, 7u32, 2u32, 6u32, 5u32, 5u32, 3u32, 1u32, 6u32, 7u32, 4u32, 1u32, 1u32, 6u32, 4u32, 1u32, 7u32, 6u32, 1u32, 3u32, 2u32, 5u32, 1u32, 5u32, 4u32, 3u32, 2u32, 1u32, 4u32, 2u32, 5u32, 1u32, 6u32, 7u32, 4u32, 5u32, 6u32, 3u32, 6u32, 7u32, 2u32, 1u32, 2u32, 7u32, 2u32, 4u32]
    for i in 0usize..years.len {
        value := time.Date.new(years[i], months[i], days[i])?
        if value.days_since_epoch() != serial[i] || value.weekday() != weekdays[i] {
            return ok(90)
        }
        restored := time.Date.from_days_since_epoch(serial[i])?
        if restored.year() != years[i] || restored.month() != months[i] || restored.day() != days[i] {
            return ok(91)
        }
    }
    return ok(0)
}

fn main() -> i32 {
    match calendar_reference() {
        ok(code) => {
            if code != 0 {
                return code
            }
        }, err(_) => {
            return 106
        }
    }
    match durations() {
        ok(code) => {
            if code != 0 {
                return code
            }
        }, err(_) => {
            return 101
        }
    }
    match timestamps() {
        ok(code) => {
            if code != 0 {
                return code
            }
        }, err(_) => {
            return 102
        }
    }
    match calendar() {
        ok(code) => {
            if code != 0 {
                return code
            }
        }, err(_) => {
            return 103
        }
    }
    match clocks() {
        ok(code) => {
            if code != 0 {
                return code
            }
        }, err(_) => {
            return 104
        }
    }
    match text_checks() {
        ok(code) => {
            if code != 0 {
                return code
            }
        }, err(_) => {
            return 105
        }
    }
    return 0
}

@test
fn test_durations() {
    match durations() {
        ok(code) => {
            assert_eq(code, 0)
        },
        err(_) => {
            assert(false, "durations unexpectedly returned an error")
        },
    }
}

