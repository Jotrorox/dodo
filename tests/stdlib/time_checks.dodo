    days := [1u32, 31u32, 15u32, 1u32, 29u32, 19u32, 6u32, 6u32, 7u32, 1u32, 22u32, 20u32, 13u32, 5u32, 6u32, 26u32, 4u32, 18u32, 23u32, 19u32, 25u32, 26u32, 14u32, 24u32, 6u32, 7u32, 14u32, 21u32, 19u32, 12u32, 8u32, 29u32, 6u32, 2u32, 10u32, 10u32, 16u32, 24u32, 22u32, 31u32, 6u32, 5u32, 29u32, 13u32, 12u32, 4u32, 15u32, 30u32, 1u32, 18u32, 11u32, 22u32, 18u32, 18u32, 17u32, 25u32, 24u32, 15u32, 7u32, 17u32, 21u32, 4u32, 22u32, 8u32, 26u32, 22u32, 23u32, 4u32, 24u32, 5u32, 8u32, 27u32, 19u32, 27u32, 21u32, 11u32, 30u32, 10u32, 2u32, 8u32, 10u32, 2u32, 26u32, 23u32, 4u32, 13u32, 28u32, 3u32, 12u32, 14u32, 11u32, 11u32, 3u32, 23u32, 12u32, 20u32, 26u32, 12u32, 3u32, 9u32, 4u32, 3u32, 11u32, 5u32, 11u32, 5u32, 14u32, 30u32, 15u32, 9u32, 11u32, 23u32, 17u32, 9u32, 31u32, 20u32, 24u32, 29u32, 9u32, 20u32, 30u32, 27u32, 4u32, 12u32, 12u32, 13u32, 7u32, 11u32, 9u32, 13u32, 20u32, 23u32, 20u32, 10u32]
