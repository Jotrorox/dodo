fn durations() -> i32!time.TimeError {
    a := time.Duration.new(2, 1500000000)?
    if a.seconds() != 3 || a.subsec_nanos() != 500000000 {
        return ok(1)
    }
    b := time.Duration.new(1, 750000000)?
    c := a.checked_add(&b)?
    if c.seconds() != 5 || c.subsec_nanos() != 250000000 {
        return ok(2)
    }
    difference := a.checked_sub(&b)?
    if difference.seconds() != 1 || difference.subsec_nanos() != 750000000 {
        return ok(3)
    }
    divided := a.checked_div(3)?
    if divided.seconds() != 1 || divided.subsec_nanos() != 166666666 {
        return ok(4)
    }
    multiplied := a.checked_mul(2)?
    if multiplied.seconds() != 7 || multiplied.subsec_nanos() != 0 {
        return ok(5)
    }
    max := time.Duration.new(~0u64, 999999999)?
    zero := time.Duration.zero()
    same := max.checked_add(&zero)?
    if same.compare(&max) != 0 {
        return ok(6)
    }
    nothing := max.checked_mul(0)?
    if!nothing.is_zero() {
        return ok(7)
    }
    one := time.Duration.from_nanos(1)
    match max.checked_add(&one) {
        ok(_) => {
            return ok(8)
        }, err(_) => {}
    }
    match time.Duration.new(~0u64, 1000000000) {
        ok(_) => {
            return ok(9)
        }, err(_) => {}
    }
    match zero.checked_sub(&one) {
        ok(_) => {
            return ok(10)
        }, err(_) => {}
    }
    match max.checked_mul(2) {
        ok(_) => {
            return ok(11)
        }, err(_) => {}
    }
    match a.checked_div(0) {
        ok(_) => {
            return ok(12)
        }, err(_) => {}
    }
    match max.to_nanos() {
        ok(_) => {
            return ok(13)
        }, err(_) => {}
    }
    huge := time.Duration.from_nanos(~0u64)
    large := huge.to_nanos()?
    if large != ~0u64 {
        return ok(14)
    }
    milli := time.Duration.from_millis(1234)
    micro := time.Duration.from_micros(1234567)
    if milli.to_millis()? != 1234 || micro.to_micros()? != 1234567 {
        return ok(15)
    }
    seed := 12345u64
    for i in 0..10000 {
        seed = (seed * 1664525 + 1013904223) % 4294967296
        lhs := seed
        seed = (seed * 1664525 + 1013904223) % 4294967296
        rhs := seed
        left := time.Duration.from_nanos(lhs)
        right := time.Duration.from_nanos(rhs)
        sum := left.checked_add(&right)?
        if sum.to_nanos()? != lhs + rhs {
            return ok(16)
        }
        restored := sum.checked_sub(&right)?
        if restored.compare(&left) != 0 {
            return ok(17)
        }
        factor := (rhs % 100) as u32
        product := left.checked_mul(factor)?
        if product.to_nanos()? != lhs * (factor as u64) {
            return ok(18)
        }
        quotient := left.checked_div(factor + 1)?
        if quotient.to_nanos()? != lhs / ((factor + 1) as u64) {
            return ok(19)
        }
    }
    return ok(0)
}
fn timestamps() -> i32!time.TimeError {
    negative := time.Timestamp.from_unix_nanos(-1)
    if negative.seconds() != -1 || negative.subsec_nanos() != 999999999 {
        return ok(20)
    }
    if negative.to_unix_nanos()? != -1 {
        return ok(21)
    }
    one := time.Duration.from_nanos(1)
    epoch := negative.checked_add(&one)?
    if epoch.seconds() != 0 || epoch.subsec_nanos() != 0 {
        return ok(22)
    }
    back := epoch.checked_sub(&one)?
    if back.compare(&negative) != 0 {
        return ok(23)
    }
    low := time.Timestamp.from_unix_seconds(-9223372036854775807 - 1)
    high := time.Timestamp.new(9223372036854775807, 999999999)?
    whole := high.duration_since(&low)?
    if whole.seconds() != ~0u64 || whole.subsec_nanos() != 999999999 {
        return ok(24)
    }
    restored := low.checked_add(&whole)?
    if restored.compare(&high) != 0 {
        return ok(25)
    }
    restored_low := high.checked_sub(&whole)?
    if restored_low.compare(&low) != 0 {
        return ok(26)
    }
    match high.checked_add(&one) {
        ok(_) => {
            return ok(27)
        }, err(_) => {}
    }
    match low.checked_sub(&one) {
        ok(_) => {
            return ok(28)
        }, err(_) => {}
    }
    match low.duration_since(&high) {
        ok(_) => {
            return ok(29)
        }, err(_) => {}
    }
    match time.Timestamp.new(0, 1000000000) {
        ok(_) => {
            return ok(30)
        }, err(_) => {}
    }
    for value in -10000i64..10000 {
        nanos := value * 123456789
        stamp := time.Timestamp.from_unix_nanos(nanos)
        if stamp.to_unix_nanos()? != nanos {
            return ok(31)
        }
    }
    min := time.Timestamp.from_unix_nanos(-9223372036854775807 - 1)
    max := time.Timestamp.from_unix_nanos(9223372036854775807)
    if min.to_unix_nanos()? != -9223372036854775807 - 1 || max.to_unix_nanos()? != 9223372036854775807 {
        return ok(32)
    }
    lower := min.checked_sub(&one)?
    upper := max.checked_add(&one)?
    match lower.to_unix_nanos() {
        ok(_) => {
            return ok(33)
        }, err(_) => {}
    }
    match upper.to_unix_nanos() {
        ok(_) => {
            return ok(34)
        }, err(_) => {}
    }
    return ok(0)
}
fn calendar() -> i32!time.TimeError {
    if!time.is_leap_year(0) || !time.is_leap_year(2000) || time.is_leap_year(1900) || time.is_leap_year(2023) {
        return ok(40)
    }
    first := time.Date.new(0, 1, 1)?
    last := time.Date.new(9999, 12, 31)?
    epoch := time.Date.new(1970, 1, 1)?
    if first.days_since_epoch() != -719528 || last.days_since_epoch() != 2932896 || epoch.days_since_epoch() != 0 || epoch.weekday() != 4 {
        return ok(41)
    }
    match first.checked_add_days(-1) {
        ok(_) => {
            return ok(42)
        }, err(_) => {}
    }
    match last.checked_add_days(1) {
        ok(_) => {
            return ok(43)
        }, err(_) => {}
    }
    match first.checked_add_days(-9223372036854775807 - 1) {
        ok(_) => {
            return ok(44)
        }, err(_) => {}
    }
    match last.checked_add_days(9223372036854775807) {
        ok(_) => {
            return ok(45)
        }, err(_) => {}
    }
    match time.Date.new(1900, 2, 29) {
        ok(_) => {
            return ok(46)
        }, err(_) => {}
    }
    match time.Date.new(2000, 13, 1) {
        ok(_) => {
            return ok(47)
        }, err(_) => {}
    }
    match time.Date.new(2000, 1, 0) {
        ok(_) => {
            return ok(48)
        }, err(_) => {}
    }
    leap := time.Date.new(2000, 2, 29)?
    march := leap.checked_add_days(1)?
    if march.month() != 3 || march.day() != 1 {
        return ok(49)
    }
    // Every day in a complete 400-year Gregorian leap cycle, including year 0.
    for day in -719528i64..-573431 {
        date := time.Date.from_days_since_epoch(day)?
        if date.days_since_epoch() != day {
            return ok(50)
        }
        if date.weekday() < 1 || date.weekday() > 7 {
            return ok(51)
        }
        date2 := time.Date.new(date.year(), date.month(), date.day())?
        if date.compare(&date2) != 0 {
            return ok(52)
        }
    }
    for second in 0u32..86400 {
        clock := time.TimeOfDay.from_seconds_since_midnight(second, 999999999)?
        if clock.seconds_since_midnight() != second {
            return ok(53)
        }
    }
    match time.TimeOfDay.new(23, 59, 60, 0) {
        ok(_) => {
            return ok(54)
        }, err(_) => {}
    }
    match time.TimeOfDay.new(24, 0, 0, 0) {
        ok(_) => {
            return ok(55)
        }, err(_) => {}
    }
    for seconds in -86401i64..86401 {
        stamp := time.Timestamp.new(seconds, 123456789)?
        value := time.DateTime.from_timestamp(&stamp)?
        back := value.to_timestamp()
        if stamp.compare(&back) != 0 {
            return ok(56)
        }
    }
    before := time.Timestamp.from_unix_nanos(-1)
    calendar := time.DateTime.from_timestamp(&before)?
    if calendar.date().year() != 1969 || calendar.date().month() != 12 || calendar.date().day() != 31 || calendar.time_of_day().hour() != 23 || calendar.time_of_day().minute() != 59 || calendar.time_of_day().second() != 59 {
        return ok(57)
    }
    beyond := time.Timestamp.from_unix_seconds(9223372036854775807)
    match time.DateTime.from_timestamp(&beyond) {
        ok(_) => {
            return ok(58)
        }, err(_) => {}
    }
    midnight := time.TimeOfDay.midnight()
    one := time.Duration.from_nanos(1)
    previous := midnight.checked_sub(&one)?
    if previous.day_offset() != -1 || previous.time_of_day().hour() != 23 || previous.time_of_day().subsec_nanos() != 999999999 {
        return ok(92)
    }
    next := previous.time_of_day().checked_add(&one)?
    if next.day_offset() != 1 || next.time_of_day().seconds_since_midnight() != 0 || next.time_of_day().subsec_nanos() != 0 {
        return ok(93)
    }
    limit := time.Duration.new(~0u64, 999999999)?
    distant := midnight.checked_add(&limit)?
    if distant.day_offset() != ((~0u64) / 86400) as i64 {
        return ok(94)
    }
    midnight_duration := midnight.since_midnight()
    exact := time.TimeOfDay.from_duration(&midnight_duration)?
    if exact.compare(&midnight) != 0 {
        return ok(95)
    }
    full_day := time.Duration.from_seconds(86400)
    match time.TimeOfDay.from_duration(&full_day) {
        ok(_) => {
            return ok(96)
        }, err(_) => {}
    }
    old_date := time.Date.new(1999, 12, 31)?
    old_clock := time.TimeOfDay.new(23, 59, 59, 999999999)?
    old := time.DateTime.new(old_date, old_clock)
    new_year := old.checked_add(&one)?
    if new_year.date().year() != 2000 || new_year.time_of_day().seconds_since_midnight() != 0 {
        return ok(97)
    }
    back := new_year.checked_sub(&one)?
    interval := new_year.duration_since(&back)?
    if interval.compare(&one) != 0 || new_year.date().days_since(back.date()) != 1 {
        return ok(98)
    }
    return ok(0)
}
fn clocks() -> i32!time.TimeError {
    source := clock.FakeClock.new(7)
    other := clock.FakeClock.new(8)
    first := clock.now(&source)?
    independent := clock.now(&other)?
    match first.compare(&independent) {
        ok(_) => {
            return ok(60)
        }, err(reason) => {
            if reason != time.TimeError.DifferentClock {
                return ok(60)
            }
        }
    }
    match first.duration_since(&independent) {
        ok(_) => {
            return ok(61)
        }, err(_) => {}
    }
    step := time.Duration.from_millis(10)
    deadline := clock.deadline_after(&source, &step)?
    if clock.deadline_poll(&deadline, &source)? {
        return ok(62)
    }
    source.advance(&step)?
    second := source.now()?
    elapsed := second.duration_since(&first)?
    if elapsed.compare(&step) != 0 || !clock.deadline_poll(&deadline, &source)? {
        return ok(63)
    }
    fake := timer.FakeTimer.new(7)
    timer.arm(&mut fake, second.clone())?
    if!timer.poll(&mut fake, &second)? || timer.poll(&mut fake, &second)? {
        return ok(64)
    }
    timer.arm(&mut fake, second.clone())?
    if!timer.cancel(&mut fake) || timer.cancel(&mut fake) {
        return ok(65)
    }
    timer.arm(&mut fake, second.clone())?
    match timer.arm(&mut fake, independent.clone()) {
        ok() => {
            return ok(66)
        }, err(_) => {}
    }
    if!fake.is_armed() {
        return ok(67)
    }
    match timer.poll(&mut fake, &independent) {
        ok(_) => {
            return ok(68)
        }, err(_) => {}
    }
    if!timer.poll(&mut fake, &second)? {
        return ok(69)
    }
    full := time.Duration.new(~0u64, 999999999)?
    overflowing := clock.FakeClock.starting_at(9, full)
    match overflowing.advance(&step) {
        ok() => {
            return ok(70)
        }, err(_) => {}
    }
    current := overflowing.now()?
    if current.elapsed_ticks().seconds() != ~0u64 || current.elapsed_ticks().subsec_nanos() != 999999999 {
        return ok(71)
    }
    wall := clock.FakeWallClock.new(time.Timestamp.epoch())
    wall.set(time.Timestamp.from_unix_seconds(-100))
    wall_value := clock.wall_now(&wall)?
    unchanged := source.now()?
    if wall_value.seconds() != -100 || unchanged.compare(&second)? != 0 {
        return ok(72)
    }
    wall.advance(&step)?
    return ok(0)
}
fn text_checks() -> i32!iso8601.TextError {
    input := [49u8, 57, 54, 57, 45, 49, 50, 45, 51, 49, 84, 50, 51, 58, 53, 57, 58, 53, 57, 46, 57, 57, 57, 57, 57, 57, 57, 57, 57, 90]
    stamp := iso8601.parse_timestamp(&input)?
    if stamp.seconds() != -1 || stamp.subsec_nanos() != 999999999 {
        return ok(80)
    }
    output := [77u8; 35]
    if iso8601.format_timestamp(&mut output, &stamp)? != 30 || !bytes.equal(&output[..30], &input) || output[30] != 77 {
        return ok(81)
    }
    for length in 0usize..30 {
        output := [77u8; 30]
        match iso8601.format_timestamp(&mut output[..length], &stamp) {
            ok(_) => {
                return ok(82)
            }, err(_) => {}
        }
        for &byte in output {
            if byte != 77 {
                return ok(83)
            }
        }
    }
    compact := [49u8, 57, 55, 48, 45, 48, 49, 45, 48, 49, 84, 48, 48, 58, 48, 48, 58, 48, 48, 90]
    zero := iso8601.parse_timestamp(&compact)?
    if zero.seconds() != 0 || zero.subsec_nanos() != 0 {
        return ok(84)
    }
    short_fraction := [48u8, 48, 58, 48, 48, 58, 48, 48, 46, 49]
    parsed := iso8601.parse_time(&short_fraction)?
    if parsed.subsec_nanos() != 100000000 {
        return ok(85)
    }
    leap_second := [50u8, 51, 58, 53, 57, 58, 54, 48]
    match iso8601.parse_time(&leap_second) {
        ok(_) => {
            return ok(86)
        }, err(_) => {}
    }
    for length in 0usize..20 {
        match iso8601.parse_timestamp(&compact[..length]) {
            ok(_) => {
                return ok(87)
            }, err(_) => {}
        }
    }
    // Invalid separators, letters, and fractional length fail deterministically.
    for index in 0usize..compact.len {
        broken := [49u8, 57, 55, 48, 45, 48, 49, 45, 48, 49, 84, 48, 48, 58, 48, 48, 58, 48, 48, 90]
        broken[index] = 120
        match iso8601.parse_timestamp(&broken) {
            ok(_) => {
                return ok(88)
            }, err(_) => {}
        }
    }
    return ok(0)
}
