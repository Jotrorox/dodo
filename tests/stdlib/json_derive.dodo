package json_derive

import "std/encoding/json"
import "std/bytes"

@derive(Json)
struct Numbers {
    a: i8
    b: u8
    c: i16
    d: u16
    e: i32
    f: u32
    g: i64
    h: u64
    i: isize
    j: usize
    k: f32
    l: f64
    flag: bool
}

@derive(Json)
struct Inner {
    text: json.String
}

@derive(Json)
struct BorrowedArrays {
    name: &str
    inner: Inner
    texts: [2]json.String
    optional_texts: [2]Option<&str>
    matrix: [2][2]i16
    optional_array: Option<[2]u32>
    nothing: [0]u8
}

@derive(Json)
struct Pair {
    values: [2]u8
}

@derive(Json)
struct NoValues {
    values: [0]u8
}

@derive(Json)
struct NestedArrays {
    values: [2][2]Option<Inner>
}

@derive(Json)
struct PrimitiveArrays {
    flags: [2]bool
    signed: [2]i8
    unsigned: [2]u64
    floats: [2]f32
    doubles: [2]f64
}

static mut array_drops: usize = 0
struct Tracked {
    value: u64

    fn decode_json(value: json.Value) -> Self!json.Error {
        return ok(Self { value: value.as_u64()? })
    }
    fn encode_json<W>(&self, encoder: &mut json.Encoder<W>) -> void!json.Error {
        return encoder.unsigned(self.value)
    }
    fn drop(&mut self) {
        unsafe {
            array_drops += 1
        }
    }
}
@derive(Json)
struct TrackedArray {
    values: [2]Tracked
}

@derive(Json)
struct Narrow {
    signed: i8
    unsigned: u8
}

@derive(Json)
struct Float32 {
    value: f32
}

@derive(Json)
struct Empty {}

@derive(Json)
@json_deny_unknown
struct StrictEmpty {}

// A user-defined codec uses the same checked protocol as derived structs.
struct Identifier {
    value: u32

    fn encode_json<W>(&self, encoder: &mut json.Encoder<W>) -> void!json.Error {
        return encoder.unsigned(self.value as u64)
    }
    fn decode_json(value: json.Value) -> Self!json.Error {
        number := value.as_u64()?
        if number > 4294967295u64 {
            return err(json.Error { kind: json.ErrorKind.NumberRange, position: value.position() })
        }
        return ok(Self { value: number as u32 })
    }
}

@derive(Json)
struct Custom {
    @json_name("external-id")
    id: Identifier
    enabled: Option<bool>
}

fn primitive_boundaries() -> void!json.Error {
    input := b"{\"a\":-128,\"b\":255,\"c\":-32768,\"d\":65535,\"e\":-2147483648,\"f\":4294967295,\"g\":-9223372036854775808,\"h\":18446744073709551615,\"i\":-123,\"j\":456,\"k\":1.5,\"l\":-2.25,\"flag\":true}"
    record := json.decode::<Numbers>(input)?
    assert_eq(record.a, -128i8)
    assert_eq(record.b, 255u8)
    assert_eq(record.c, -32768i16)
    assert_eq(record.d, 65535u16)
    assert_eq(record.e, -2147483648i32)
    assert_eq(record.f, 4294967295u32)
    assert_eq(record.g, -9223372036854775808i64)
    assert_eq(record.h, 18446744073709551615u64)
    assert_eq(record.i, -123isize)
    assert_eq(record.j, 456usize)
    assert_eq(record.k, 1.5f32)
    assert_eq(record.l, -2.25f64)
    assert(record.flag)
    storage := [0u8; 512]
    written := json.to_slice(&record, &mut storage)?
    again := json.decode::<Numbers>(&storage[..written])?
    assert_eq(again.a, record.a)
    assert_eq(again.h, record.h)
    assert_eq(again.k, record.k)
    assert_eq(again.l, record.l)
    return ok()
}

fn borrowed_composition() -> void!json.Error {
    input := b"{\"name\":\"root\",\"inner\":{\"text\":\"n\\u0065sted\"},\"texts\":[\"A\\nB\",\"C\"],\"optional_texts\":[null,\"some\"],\"matrix\":[[-32768,32767],[0,-1]],\"optional_array\":[0,4294967295],\"nothing\":[]}"
    record := json.decode::<BorrowedArrays>(input)?
    assert_eq(record.name, "root")
    assert(record.inner.text.equals("nested"))
    assert(record.texts[0].equals("A\nB"))
    assert(record.texts[1].equals("C"))
    match &record.optional_texts[0] {
        none => {}, some(_) => {
            assert(false)
        }
    }
    match &record.optional_texts[1] {
        some(text) => {
            assert_eq(*text, "some")
        },
        none => {
            assert(false)
        },
    }
    assert_eq(record.matrix[0][0], -32768i16)
    assert_eq(record.matrix[0][1], 32767i16)
    assert_eq(record.matrix[1][1], -1i16)
    match &record.optional_array {
        some(values) => {
            assert_eq(values[1], 4294967295u32)
        },
        none => {
            assert(false)
        },
    }
    assert_eq(record.nothing.len, 0usize)
    storage := [0u8; 512]
    written := json.to_slice(&record, &mut storage)?
    again := json.decode::<BorrowedArrays>(&storage[..written])?
    assert(again.inner.text.equals("nested"))
    assert(again.texts[0].equals("A\nB"))
    assert_eq(again.name, "root")
    return ok()
}

fn validation_and_custom_codecs() -> void!json.Error {
    bad_numbers := [
        b"{\"signed\":128,\"unsigned\":0}",
        b"{\"signed\":-129,\"unsigned\":0}",
        b"{\"signed\":0,\"unsigned\":256}",
        b"{\"signed\":0,\"unsigned\":-1}",
    ]
    for input in &bad_numbers {
        match json.decode::<Narrow>(*input) {
            ok(_) => {
                assert(false)
            },
            err(reason) => {
                assert_eq(reason.kind, json.ErrorKind.NumberRange)
            },
        }
    }
    match json.decode::<Narrow>(b"{\"signed\":128,\"unsigned\":0}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.position, 10usize)
        },
    }
    match json.decode::<Float32>(b"{\"value\":1e39}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.NumberRange)
        },
    }
    match json.decode::<Empty>(b"[]") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
        },
    }
    empty := json.decode::<Empty>(b"{\"extra\":1}")?
    output := [0u8; 64]
    count := json.to_slice(&empty, &mut output)?
    assert(bytes.equal(&output[..count], b"{}"))
    match json.decode::<StrictEmpty>(b"{\"extra\":1}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.UnknownField)
        },
    }
    custom := json.decode::<Custom>(b"{\"external-id\":42}")?
    assert_eq(custom.id.value, 42u32)
    match &custom.enabled {
        none => {}, some(_) => {
            assert(false)
        }
    }
    count = json.to_slice(&custom, &mut output)?
    assert(bytes.equal(&output[..count], b"{\"external-id\":42,\"enabled\":null}"))
    custom_some := json.decode::<Custom>(b"{\"external-id\":7,\"enabled\":true}")?
    match &custom_some.enabled {
        some(flag) => {
            assert(*flag)
        }, none => {
            assert(false)
        }
    }
    return ok()
}

fn array_validation() -> void!json.Error {
    primitives := json.decode::<PrimitiveArrays>(b"{\"flags\":[true,false],\"signed\":[-128,127],\"unsigned\":[0,18446744073709551615],\"floats\":[1.5,-2.25],\"doubles\":[-3.5,4.25]}")?
    assert(primitives.flags[0] && !primitives.flags[1])
    assert_eq(primitives.signed[0], -128i8)
    assert_eq(primitives.signed[1], 127i8)
    assert_eq(primitives.unsigned[0], 0u64)
    assert_eq(primitives.unsigned[1], 18446744073709551615u64)
    assert_eq(primitives.floats[0], 1.5f32)
    assert_eq(primitives.floats[1], -2.25f32)
    assert_eq(primitives.doubles[0], -3.5f64)
    assert_eq(primitives.doubles[1], 4.25f64)
    pair := json.decode::<Pair>(b"{\"values\": [ 1 , 255 ] }")?
    assert_eq(pair.values[0], 1u8)
    assert_eq(pair.values[1], 255u8)
    invalid := [
        b"{\"values\":null}",
        b"{\"values\":{}}",
        b"{\"values\":[]}",
        b"{\"values\":[1]}",
        b"{\"values\":[1,2,3]}",
    ]
    for input in &invalid {
        match json.decode::<Pair>(*input) {
            ok(_) => {
                assert(false)
            },
            err(reason) => {
                assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
                assert_eq(reason.position, 10usize)
            },
        }
    }
    empty := json.decode::<NoValues>(b"{\"values\": [ \n\t ] }")?
    assert_eq(empty.values.len, 0usize)
    invalid_empty := [b"{\"values\":[1]}", b"{\"values\":null}"]
    for input in &invalid_empty {
        match json.decode::<NoValues>(*input) {
            ok(_) => {
                assert(false)
            },
            err(reason) => {
                assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
                assert_eq(reason.position, 10usize)
            },
        }
    }
    match json.decode::<Pair>(b"{\"values\":[1,256]}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.NumberRange)
            assert_eq(reason.position, 13usize)
        },
    }
    match json.decode::<Pair>(b"{\"values\":[1,false]}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
            assert_eq(reason.position, 13usize)
        },
    }
    nested := json.decode::<NestedArrays>(b"{\"values\":[[{\"text\":\"A],\\\"[\"},null],[null,{\"text\":\"B\\u0043\"}]]}")?
    match &nested.values[0][0] {
        some(inner) => {
            assert(inner.text.equals("A],\"["))
        },
        none => {
            assert(false)
        },
    }
    match &nested.values[1][1] {
        some(inner) => {
            assert(inner.text.equals("BC"))
        },
        none => {
            assert(false)
        },
    }
    invalid_nested := [
        b"{\"values\":[[],[null,null]]}",
        b"{\"values\":[[null],[null,null]]}",
        b"{\"values\":[[null,null,null],[null,null]]}",
        b"{\"values\":[null,[null,null]]}",
    ]
    for input in &invalid_nested {
        match json.decode::<NestedArrays>(*input) {
            ok(_) => {
                assert(false)
            },
            err(reason) => {
                assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
                assert_eq(reason.position, 11usize)
            },
        }
    }
    return ok()
}

fn array_failure_cleanup() -> void!json.Error {
    // Failure converting the second element drops the first decoded owner.
    unsafe {
        array_drops = 0
    }
    match json.decode::<TrackedArray>(b"{\"values\":[1,false]}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
        },
    }
    unsafe {
        assert_eq(array_drops, 1usize)
    }
    // Too few elements and the final check for too many also clean up owners.
    unsafe {
        array_drops = 0
    }
    match json.decode::<TrackedArray>(b"{\"values\":[1]}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
        },
    }
    unsafe {
        assert_eq(array_drops, 1usize)
    }
    unsafe {
        array_drops = 0
    }
    match json.decode::<TrackedArray>(b"{\"values\":[1,2,3]}") {
        ok(_) => {
            assert(false)
        },
        err(reason) => {
            assert_eq(reason.kind, json.ErrorKind.TypeMismatch)
        },
    }
    unsafe {
        assert_eq(array_drops, 2usize)
    }
    unsafe {
        array_drops = 0
    }
    {
        record := json.decode::<TrackedArray>(b"{\"values\":[1,2]}")?
        assert_eq(record.values[0].value, 1u64)
        assert_eq(record.values[1].value, 2u64)
        unsafe {
            assert_eq(array_drops, 0usize)
        }
    }
    unsafe {
        assert_eq(array_drops, 2usize)
    }
    return ok()
}

fn borrowed_cursor(input: &[u8]) -> [2] &str!json.Error from(input) {
    cursor := json.ArrayCursor.new(json.parse(input)?)?
    let json.ArrayElement { rest: tail, value: first } = cursor.take()?
    a := first.into_str()?
    let json.ArrayElement { rest: end, value: second } = tail.take()?
    b := second.into_str()?
    end.finish()?
    return ok([a, b])
}

fn main() {
    primitive_boundaries()!
    borrowed_composition()!
    validation_and_custom_codecs()!
    array_validation()!
    array_failure_cleanup()!
    strings := borrowed_cursor(b"[ \"first\", \"second\" ]")!
    assert_eq(strings[0], "first")
    assert_eq(strings[1], "second")
}

@test
fn derived_json_suite() {
    main()
}
