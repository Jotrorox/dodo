package main

import "core/option"
import "core/ptr"
import "std/embedded/hal"
import "std/embedded/chip/rp_adc"
import "std/embedded/chip/rp_pins"
import "std/embedded/chip/rp_pio"
import "std/embedded/chip/rp_pwm"
import "std/embedded/hal/fake"
import "std/embedded/peripheral/designware_i2c"
import "std/embedded/peripheral/pl011"
import "std/embedded/peripheral/pl022"
import "std/fmt"
import "std/io"

// Host checks for std/embedded/peripheral: the DesignWare I2C, PL022 SPI, and
// PL011 UART controller drivers against behavioural models of the
// controllers, the RP2040 and RP2350 PWM and ADC drivers against models of
// those blocks, the PIO driver against memory standing in for a PIO block,
// and the pin and controller ownership and panic reports of
// std/embedded/chip/rp_pins. The models enforce the hardware's rules
// (registers that may change only while disabled, FIFO depths, the flushed
// state after an abort) and process commands slower than the drivers poll,
// so FIFO back-pressure is exercised.

const CLOCK_HZ: u32 = 125_000_000

// --- A DW_apb_i2c controller and one device on its bus -----------------

// Bus events, logged in order: conditions, address bytes (address << 1 |
// read), and data bytes in either direction.
const START: u32 = 0x100
const RESTART: u32 = 0x200
const STOP: u32 = 0x300
const ADDRESS: u32 = 0x400

const DEVICE: u8 = 0x48
// A second device, with a 10-bit address.
const DEVICE10: u16 = 0x2A5
const I2C_FIFO: usize = 16

struct I2cModel {
    // Registers the driver configures.
    con: u32
    tar: u32
    enabled: bool
    high: u32
    low: u32
    spike: u32
    hold: u32
    interrupt_mask: u32
    // The FIFO thresholds of TX_EMPTY and RX_FULL.
    tx_threshold: u32
    rx_threshold: u32
    // COMP_PARAM_1, which encodes the receive and transmit FIFO depths.
    parameters: u32
    rx_depth: usize
    tx: [16]u32
    tx_count: usize
    rx: [16]u8
    rx_count: usize
    aborted: bool
    abort_source: u32
    stop_detected: bool
    // Bus state.
    active: bool
    reading: bool
    first_write: bool
    // This transaction addressed the device for writing.
    active_write: bool
    // The device: 256 registers behind an auto-incrementing pointer.
    registers: [256]u8
    pointer: u8
    // Process one command every `period` register reads, or with `burst`
    // every queued command at once, as if the CPU had been interrupted.
    period: u32
    burst: bool
    reads: u32
    // Failure injection: never finish a command, NACK the data byte after
    // `ack_bytes` acknowledged ones, lose arbitration at the next address.
    stuck: bool
    ack_bytes: u32
    acked: u32
    lose_arbitration: bool
    // A device holds SCL low once a transaction aborts, so the STOP never
    // comes; only disabling the controller ends it.
    hold_after_abort: bool
    // Rule violations the driver must never cause.
    tx_overflow: bool
    rx_overflow: bool
    log: [192]u32
    log_count: usize

    fn new(rx_depth: usize, period: u32) -> I2cModel {
        return I2cModel {
            con: 0,
            tar: 0x55,
            enabled: false,
            high: 0,
            low: 0,
            spike: 0,
            hold: 0x0001_0001,
            interrupt_mask: 0x8FF,
            tx_threshold: 0,
            rx_threshold: 0,
            parameters: ((I2C_FIFO as u32 - 1) << 16) | ((rx_depth as u32 - 1) << 8) | 0x6E,
            rx_depth,
            tx: [0; 16],
            tx_count: 0,
            rx: [0; 16],
            rx_count: 0,
            aborted: false,
            abort_source: 0,
            stop_detected: false,
            active: false,
            reading: false,
            first_write: false,
            active_write: false,
            registers: [0; 256],
            pointer: 0,
            period,
            burst: false,
            reads: 0,
            stuck: false,
            ack_bytes: 0xFFFF_FFFF,
            acked: 0,
            lose_arbitration: false,
            hold_after_abort: false,
            tx_overflow: false,
            rx_overflow: false,
            log: [0; 192],
            log_count: 0,
        }
    }

    fn record(&mut self, event: u32) {
        core.assert(self.log_count < 192)
        self.log[self.log_count] = event
        self.log_count += 1
    }

    fn expect(&mut self, events: &[u32]) {
        core.assert_eq(self.log_count, events.len)
        for index in 0..events.len {
            core.assert_eq(self.log[index], events[index])
        }
        self.log_count = 0
        core.assert(!self.tx_overflow && !self.rx_overflow)
    }

    // The controller gives up: it flushes both FIFOs and ends with STOP,
    // and ignores new commands until the abort is cleared.
    fn abort(&mut self, source: u32) {
        self.aborted = true
        self.abort_source = source
        self.tx_count = 0
        self.rx_count = 0
        if self.hold_after_abort {
            return
        }
        if self.active && (source & (1 << 12)) == 0 {
            self.record(STOP)
            self.stop_detected = true
        }
        self.active = false
    }

    fn step(&mut self) {
        self.reads += 1
        if self.stuck || self.reads % self.period != 0 {
            return
        }
        self.process()
        for self.burst && self.tx_count > 0 {
            self.process()
        }
    }

    fn process(&mut self) {
        if self.tx_count == 0 {
            return
        }
        command := self.tx[0]
        for index in 1..self.tx_count {
            self.tx[index - 1] = self.tx[index]
        }
        self.tx_count -= 1
        read := (command & 0x100) != 0
        if !self.active || (command & 0x400) != 0 || read != self.reading {
            if self.active {
                core.assert((self.con & (1 << 5)) != 0)
                self.record(RESTART)
            } else {
                self.record(START)
                self.active_write = false
            }
            self.active = true
            if self.lose_arbitration {
                self.lose_arbitration = false
                self.abort(1 << 12)
                return
            }
            direction := 0u32
            if read {
                direction = 1
            }
            if (self.con & (1 << 4)) != 0 {
                // 11110, the top two address bits, and the direction; a
                // write, or a read that does not continue a write, first
                // sends the low eight bits after a write header.
                target := self.tar & 0x3FF
                header := 0xF0 | ((target >> 7) & 0x6)
                continued := read && self.active_write
                if !continued {
                    self.record(ADDRESS | header)
                    self.record(ADDRESS | (target & 0xFF))
                    if target != DEVICE10 as u32 {
                        self.abort(1 << 2)
                        return
                    }
                    if read {
                        self.record(RESTART)
                    }
                }
                if read {
                    self.record(ADDRESS | header | 1)
                }
            } else {
                target := self.tar
                self.record(ADDRESS | (target << 1) | direction)
                if self.tar != DEVICE as u32 {
                    self.abort(1 << 0)
                    return
                }
            }
            self.active_write = !read
            self.reading = read
            self.first_write = true
        }
        if read {
            if self.rx_count == self.rx_depth {
                self.rx_overflow = true
            } else {
                value := self.registers[self.pointer as usize]
                self.record(value as u32)
                self.rx[self.rx_count] = value
                self.rx_count += 1
                self.pointer = core.wrapping_add(self.pointer, 1)
            }
        } else {
            value := (command & 0xFF) as u8
            self.record(value as u32)
            if self.acked == self.ack_bytes {
                self.abort(1 << 3)
                return
            }
            self.acked += 1
            if self.first_write {
                self.pointer = value
                self.first_write = false
            } else {
                self.registers[self.pointer as usize] = value
                self.pointer = core.wrapping_add(self.pointer, 1)
            }
        }
        if (command & 0x200) != 0 {
            self.record(STOP)
            self.active = false
            self.stop_detected = true
        }
    }

    // RAW_INTR_STAT: RX_FULL above the receive threshold, TX_EMPTY at or
    // below the transmit threshold once the last command is done, TX_ABRT,
    // and STOP_DET.
    fn raw(&self) -> u32 {
        raw := 0u32
        if self.rx_count > self.rx_threshold as usize {
            raw |= 1 << 2
        }
        if self.tx_count <= self.tx_threshold as usize && (self.con & (1 << 8)) != 0 && !self.stuck {
            raw |= 1 << 4
        }
        if self.aborted {
            raw |= 1 << 6
        }
        if self.stop_detected {
            raw |= 1 << 9
        }
        return raw
    }

    // The controller's interrupt line: the raw flags INTR_MASK lets through.
    fn interrupt(&self) -> u32 {
        return self.raw() & self.interrupt_mask
    }

    // The register block protocol.
    pub fn read(&mut self, offset: usize) -> u32 {
        self.step()
        if offset == 0x10 {
            core.assert(self.rx_count > 0)
            value := self.rx[0]
            for index in 1..self.rx_count {
                self.rx[index - 1] = self.rx[index]
            }
            self.rx_count -= 1
            return value as u32
        } else if offset == 0x34 {
            return self.raw()
        } else if offset == 0x40 {
            self.aborted = false
            self.abort_source = 0
            self.stop_detected = false
            return 0
        } else if offset == 0x54 {
            self.aborted = false
            self.abort_source = 0
            return 0
        } else if offset == 0x60 {
            self.stop_detected = false
            return 0
        } else if offset == 0x6C {
            if self.enabled {
                return 1
            }
            return 0
        } else if offset == 0x70 {
            status := 0u32
            if self.tx_count < I2C_FIFO {
                status |= 1 << 1
            }
            if self.rx_count > 0 {
                status |= 1 << 3
            }
            if self.active || self.tx_count > 0 {
                status |= 1 << 5
            }
            return status
        } else if offset == 0x7C {
            return self.hold
        } else if offset == 0x80 {
            return self.abort_source
        } else if offset == 0x9C {
            if self.enabled {
                return 1
            }
            return 0
        } else if offset == 0xF4 {
            return self.parameters
        }
        core.assert(false)
        return 0
    }

    pub fn write(&mut self, offset: usize, value: u32) {
        if offset == 0x6C {
            if (value & 2) != 0 {
                core.assert(self.enabled)
                self.abort(1 << 16)
            }
            self.enabled = (value & 1) != 0
            if !self.enabled {
                self.tx_count = 0
                self.rx_count = 0
                if self.active {
                    self.record(STOP)
                    self.active = false
                }
            }
            return
        }
        if offset == 0x10 {
            core.assert(self.enabled)
            if self.aborted {
                return
            }
            if self.tx_count == I2C_FIFO {
                self.tx_overflow = true
                return
            }
            self.tx[self.tx_count] = value
            self.tx_count += 1
            return
        }
        if offset == 0x30 {
            self.interrupt_mask = value
            return
        }
        // Everything else is configuration, writable only while disabled.
        core.assert(!self.enabled)
        if offset == 0x00 {
            self.con = value
        } else if offset == 0x04 {
            self.tar = value
        } else if offset == 0x1C {
            self.high = value
        } else if offset == 0x20 {
            self.low = value
        } else if offset == 0x38 {
            core.assert(value < self.rx_depth as u32)
            self.rx_threshold = value
        } else if offset == 0x3C {
            core.assert(value < I2C_FIFO as u32)
            self.tx_threshold = value
        } else if offset == 0x7C {
            self.hold = value
        } else if offset == 0xA0 {
            self.spike = value
        } else {
            core.assert(false)
        }
    }
}

fn expect_error(result: void!hal.Error, expected: hal.Error) {
    match result {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

fn i2c_timing() {
    // 313 cycles: high for 108 + 11 + 7, low for 186 + 1.
    fast := designware_i2c.timing(CLOCK_HZ, hal.I2C_FAST_HZ)!
    core.assert_eq(fast.high, 108u32)
    core.assert_eq(fast.low, 186u32)
    core.assert_eq(fast.spike, 11u32)
    core.assert_eq(fast.hold, 38u32)
    core.assert_eq(fast.frequency_hz, 399_361u32)

    standard := designware_i2c.timing(CLOCK_HZ, hal.I2C_STANDARD_HZ)!
    core.assert_eq(standard.high + standard.spike + 7 + standard.low + 1, 1250u32)
    core.assert_eq(standard.frequency_hz, 100_000u32)

    // Fast mode plus has a shorter SDA hold time.
    plus := designware_i2c.timing(150_000_000, hal.I2C_FAST_PLUS_HZ)!
    core.assert_eq(plus.high, 48u32)
    core.assert_eq(plus.low, 89u32)
    core.assert_eq(plus.hold, 19u32)

    invalid: [3]u32 = [0, 1_000_001, 1_000]
    for index in 0..3usize {
        match designware_i2c.timing(CLOCK_HZ, invalid[index]) {
            ok(_) => {
                core.assert(false)
            }
            err(error) => {
                core.assert(error == hal.Error.InvalidInput)
            }
        }
    }
    // The controller's extra cycles leave too short a high count for 1 MHz
    // below about 36 MHz.
    lowest := designware_i2c.timing(36_000_000, hal.I2C_FAST_PLUS_HZ)!
    core.assert_eq(lowest.frequency_hz, 1_000_000u32)
    match designware_i2c.timing(34_000_000, hal.I2C_FAST_PLUS_HZ) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
}

fn i2c_bus(model: I2cModel) -> designware_i2c.Controller<I2cModel> {
    return designware_i2c.Controller.new(model, designware_i2c.timing(CLOCK_HZ, hal.I2C_FAST_HZ)!)
}

fn i2c_configuration() {
    bus := i2c_bus(I2cModel.new(16, 1))
    core.assert_eq(bus.frequency_hz(), 399_361u32)
    model := bus.release()
    // Master, fast-mode timing, repeated starts, target mode off, and
    // TX_EMPTY after the last command left.
    core.assert_eq(model.con, 0x165u32)
    core.assert_eq(model.high, 108u32)
    core.assert_eq(model.low, 186u32)
    core.assert_eq(model.spike, 11u32)
    // The receive hold time in the upper half is kept.
    core.assert_eq(model.hold, 0x0001_0026u32)
    core.assert_eq(model.interrupt_mask, 0u32)
    // TX_EMPTY at half the transmit FIFO, RX_FULL at half the receive FIFO.
    core.assert_eq(model.tx_threshold, 8u32)
    core.assert_eq(model.rx_threshold, 7u32)
    core.assert(!model.enabled)
    nothing: [0]u32 = []
    model.expect(&nothing)
    bus = i2c_bus(I2cModel.new(2, 1))
    model = bus.release()
    core.assert_eq(model.rx_threshold, 0u32)
}

fn i2c_transactions() {
    bus := i2c_bus(I2cModel.new(16, 1))
    address := ADDRESS | (DEVICE as u32 << 1)

    // A register write is one transaction ending in STOP.
    hal.write_register(&mut bus, DEVICE, 0x01, 0x80)!
    // A register read writes the number, then reads after a repeated START.
    model := bus.release()
    core.assert_eq(model.registers[1], 0x80u8)
    register_write: [5]u32 = [START, address, 0x01, 0x80, STOP]
    model.expect(&register_write)
    model.registers[0x10] = 0x01
    model.registers[0x11] = 0x23
    bus = i2c_bus(model)
    raw: [2]u8 = [0, 0]
    hal.read_registers(&mut bus, DEVICE, 0x10, &mut raw)!
    core.assert_eq(raw[0], 0x01u8)
    core.assert_eq(raw[1], 0x23u8)
    core.assert_eq(hal.read_register(&mut bus, DEVICE, 0x11)!, 0x23u8)

    // A plain read continues from the register pointer.
    one: [1]u8 = [0]
    bus.read(DEVICE, &mut one)!
    model = bus.release()
    register_reads: [19]u32 = [
        START, address, 0x10, RESTART, address | 1, 0x01, 0x23, STOP,
        START, address, 0x11, RESTART, address | 1, 0x23, STOP,
        START, address | 1, 0x00, STOP
    ]
    model.expect(&register_reads)
}

fn i2c_long_transfers() {
    // Commands complete slower than the driver queues them, so the transmit
    // FIFO fills. Then the controller works off its whole queue at once, as
    // while an interrupt delays the CPU: the reads in flight must fit the
    // 2-entry receive FIFO.
    model := I2cModel.new(2, 7)
    for index in 0..40usize {
        model.registers[0x40 + index] = (3 * index) as u8
    }
    bus := i2c_bus(model)
    data: [41]u8 = [0; 41]
    data[0] = 0x80
    for index in 1..41usize {
        data[index] = (200 - index) as u8
    }
    bus.write(DEVICE, &data)!
    model = bus.release()
    model.burst = true
    bus = i2c_bus(model)
    buffer: [40]u8 = [0; 40]
    command: [1]u8 = [0x40]
    bus.write_read(DEVICE, &command, &mut buffer)!
    for index in 0..40usize {
        core.assert_eq(buffer[index], (3 * index) as u8)
    }
    model = bus.release()
    for index in 1..41usize {
        core.assert_eq(model.registers[0x80 + index - 1], (200 - index) as u8)
    }
    core.assert(!model.tx_overflow && !model.rx_overflow)
}

fn i2c_failures() {
    bus := i2c_bus(I2cModel.new(16, 3))
    one: [1]u8 = [0x07]

    // Nobody at the address: the controller aborts and sends STOP itself.
    expect_error(bus.write(0x10, &one), hal.Error.NoAcknowledge)
    expect_error(bus.read(0x10, &mut one), hal.Error.NoAcknowledge)
    probe: [1]u8 = [0]
    expect_error(bus.write_read(0x10, &one, &mut probe), hal.Error.NoAcknowledge)
    // The bus recovers for the next transaction.
    bus.write(DEVICE, &one)!
    model := bus.release()
    missing_device: [13]u32 = [
        START, ADDRESS | 0x20, STOP,
        START, ADDRESS | 0x21, STOP,
        START, ADDRESS | 0x20, STOP,
        START, ADDRESS | 0x90, 0x07, STOP
    ]
    model.expect(&missing_device)

    // The device stops acknowledging data.
    model.ack_bytes = model.acked + 2
    bus = i2c_bus(model)
    data: [4]u8 = [1, 2, 3, 4]
    expect_error(bus.write(DEVICE, &data), hal.Error.NoAcknowledge)
    model = bus.release()
    data_refused: [6]u32 = [START, ADDRESS | 0x90, 1, 2, 3, STOP]
    model.expect(&data_refused)
    model.ack_bytes = 0xFFFF_FFFF

    // Another master wins arbitration.
    model.lose_arbitration = true
    bus = i2c_bus(model)
    expect_error(bus.write(DEVICE, &one), hal.Error.Bus)
    bus.write(DEVICE, &one)!

    // Arguments the controller cannot send.
    empty: [0]u8 = []
    nothing: [0]u8 = []
    expect_error(bus.write(DEVICE, &empty), hal.Error.InvalidInput)
    expect_error(bus.read(DEVICE, &mut nothing), hal.Error.InvalidInput)
    expect_error(bus.write_read(DEVICE, &empty, &mut nothing), hal.Error.InvalidInput)
    expect_error(bus.write(0x80, &one), hal.Error.InvalidInput)
    // An empty half of write_read is a plain read or write.
    bus.write_read(DEVICE, &one, &mut nothing)!
    bus.write_read(DEVICE, &empty, &mut one)!

    // A device that holds SCL low: Timeout, then a fresh start.
    model = bus.release()
    after_arbitration: [13]u32 = [
        START,
        START, ADDRESS | 0x90, 0x07, STOP,
        START, ADDRESS | 0x90, 0x07, STOP,
        START, ADDRESS | 0x91, 0x00, STOP
    ]
    model.expect(&after_arbitration)
    model.stuck = true
    bus = i2c_bus(model)
    expect_error(bus.write(DEVICE, &one), hal.Error.Timeout)
    model = bus.release()
    core.assert(!model.enabled)
    model.stuck = false
    bus = i2c_bus(model)
    bus.write(DEVICE, &one)!
    model = bus.release()
    after_timeout: [4]u32 = [START, ADDRESS | 0x90, 0x00, STOP]
    model.expect(&after_timeout)

    // An abort whose STOP never comes leaves the bus stuck as well: Timeout,
    // not the reason for the abort.
    model.hold_after_abort = true
    bus = i2c_bus(model)
    expect_error(bus.write(0x10, &one), hal.Error.Timeout)
    model = bus.release()
    core.assert(!model.enabled)
    model.hold_after_abort = false
    bus = i2c_bus(model)
    bus.write(DEVICE, &one)!
    model = bus.release()
    held_abort: [7]u32 = [START, ADDRESS | 0x20, STOP, START, ADDRESS | 0x90, 0x00, STOP]
    model.expect(&held_abort)
}

fn expect_i2c_poll_error(result: bool!hal.Error, expected: hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

// Poll a transaction until it ends, as a task would across wakeups, through
// the polling protocol; returns the polls that found it still running.
fn finish_write(bus: &mut dyn hal.I2cPoll, address: u8, bytes: &[u8]) -> u32!hal.Error {
    polls := 0u32
    for !bus.poll_write(address, bytes)? {
        polls += 1
        core.assert(polls < 100_000)
    }
    return ok(polls)
}

fn finish_read(bus: &mut dyn hal.I2cPoll, address: u8, buffer: &mut[u8]) -> u32!hal.Error {
    polls := 0u32
    for !bus.poll_read(address, buffer)? {
        polls += 1
        core.assert(polls < 100_000)
    }
    return ok(polls)
}

fn finish_write_read(bus: &mut dyn hal.I2cPoll, address: u8, bytes: &[u8], buffer: &mut[u8]) -> u32!hal.Error {
    polls := 0u32
    for !bus.poll_write_read(address, bytes, buffer)? {
        polls += 1
        core.assert(polls < 100_000)
    }
    return ok(polls)
}

fn i2c_polled_transactions() {
    model := I2cModel.new(16, 4)
    model.registers[0x05] = 0x99
    model.registers[0x20] = 0xAB
    model.registers[0x21] = 0xCD
    bus := i2c_bus(model)
    bus.listen()
    command: [1]u8 = [0x20]
    reply: [2]u8 = [0, 0]
    core.assert(!bus.poll_write_read(DEVICE, &command, &mut reply)!)
    core.assert(bus.is_busy())
    // Nothing else gets into the FIFOs meanwhile, and calls that differ
    // from the running transaction are refused without disturbing it.
    one: [1]u8 = [0x07]
    expect_error(bus.write(DEVICE, &one), hal.Error.Busy)
    expect_error(bus.set_frequency(hal.I2C_STANDARD_HZ), hal.Error.Busy)
    expect_i2c_poll_error(bus.poll_write_read(0x49, &command, &mut reply), hal.Error.InvalidInput)
    expect_i2c_poll_error(bus.poll_write_read(0x80, &command, &mut reply), hal.Error.InvalidInput)
    expect_i2c_poll_error(bus.poll_read(DEVICE, &mut reply), hal.Error.InvalidInput)
    expect_i2c_poll_error(bus.poll_write_read(DEVICE, &command, &mut one), hal.Error.InvalidInput)
    expect_i2c_poll_error(bus.poll_write_read_ten_bit(DEVICE as u16, &command, &mut reply), hal.Error.InvalidInput)
    core.assert(bus.is_busy())
    // The controller works while the program polls.
    core.assert(finish_write_read(&mut bus, DEVICE, &command, &mut reply)! > 0)
    core.assert_eq(reply[0], 0xABu8)
    core.assert_eq(reply[1], 0xCDu8)
    core.assert(!bus.is_busy())
    data: [3]u8 = [0x30, 1, 2]
    finish_write(&mut bus, DEVICE, &data)!
    finish_read(&mut bus, DEVICE, &mut one)!
    core.assert_eq(one[0], 0x00u8)
    // A missing device ends the transaction with its reason.
    match finish_read(&mut bus, 0x10, &mut one) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.NoAcknowledge)
        }
    }
    core.assert(!bus.is_busy())
    // Arguments the controller cannot send start nothing.
    nothing: [0]u8 = []
    empty: [0]u8 = []
    expect_i2c_poll_error(bus.poll_write(DEVICE, &empty), hal.Error.InvalidInput)
    expect_i2c_poll_error(bus.poll_write_read(DEVICE, &empty, &mut nothing), hal.Error.InvalidInput)
    expect_i2c_poll_error(bus.poll_read(0x80, &mut one), hal.Error.InvalidInput)
    expect_i2c_poll_error(bus.poll_read_ten_bit(0x400, &mut one), hal.Error.InvalidInput)
    core.assert(!bus.is_busy())
    // The blocking methods work again in between, and so does a device
    // with a 10-bit address.
    bus.write(DEVICE, &one)!
    register: [1]u8 = [0x05]
    value: [1]u8 = [0]
    for !bus.poll_write_read_ten_bit(DEVICE10, &register, &mut value)! {}
    core.assert_eq(value[0], 0x99u8)
    model = bus.release()
    // Listening, an idle controller lets no interrupt through.
    core.assert_eq(model.interrupt_mask, 0u32)
    core.assert_eq(model.registers[0x30], 1u8)
    core.assert_eq(model.registers[0x31], 2u8)
    address := ADDRESS | (DEVICE as u32 << 1)
    header := ADDRESS | 0xF4
    polled: [33]u32 = [
        START, address, 0x20, RESTART, address | 1, 0xAB, 0xCD, STOP,
        START, address, 0x30, 1, 2, STOP,
        START, address | 1, 0x00, STOP,
        START, ADDRESS | 0x21, STOP,
        START, address, 0x00, STOP,
        START, header, ADDRESS | 0xA5, 0x05, RESTART, header | 1, 0x99, STOP
    ]
    model.expect(&polled)
}

// The device's registers for the long transfers: 0x40 onwards counts in
// threes, and the long write stores 199, 198, ... from 0x80.
fn long_model(burst: bool) -> I2cModel {
    model := I2cModel.new(4, 7)
    model.burst = burst
    for index in 0..40usize {
        model.registers[0x40 + index] = (3 * index) as u8
    }
    return model
}

fn long_register(index: usize) -> u8 {
    if index >= 0x80 {
        return (200 - (index - 0x7F)) as u8
    }
    if index >= 0x40 && index < 0x68 {
        return (3 * (index - 0x40)) as u8
    }
    return 0
}

const LONG_LOG: usize = 123

// The bus log of a long session: a 41-byte write, a register number and a
// 40-byte read, and a 30-byte read continuing from there, past the end of
// the counting registers into the written ones.
fn expect_long_log(model: &mut I2cModel) {
    address := ADDRESS | (DEVICE as u32 << 1)
    log: [123]u32 = [0; 123]
    log[0] = START
    log[1] = address
    log[2] = 0x80
    for index in 1..41usize {
        log[2 + index] = (200 - index) as u32
    }
    log[43] = STOP
    log[44] = START
    log[45] = address
    log[46] = 0x40
    log[47] = RESTART
    log[48] = address | 1
    for index in 0..40usize {
        log[49 + index] = long_register(0x40 + index) as u32
    }
    log[89] = STOP
    log[90] = START
    log[91] = address | 1
    for index in 0..30usize {
        log[92 + index] = long_register(0x68 + index) as u32
    }
    log[122] = STOP
    model.expect(&log)
}

fn long_data() -> [41]u8 {
    data: [41]u8 = [0; 41]
    data[0] = 0x80
    for index in 1..41usize {
        data[index] = (200 - index) as u8
    }
    return data
}

// The long session through the blocking protocol.
fn long_session<B: hal.I2c>(bus: &mut B) {
    data := long_data()
    bus.write(DEVICE, &data)!
    command: [1]u8 = [0x40]
    buffer: [40]u8 = [0; 40]
    bus.write_read(DEVICE, &command, &mut buffer)!
    more: [30]u8 = [0; 30]
    bus.read(DEVICE, &mut more)!
    for index in 0..40usize {
        core.assert_eq(buffer[index], long_register(0x40 + index))
    }
    for index in 0..30usize {
        core.assert_eq(more[index], long_register(0x68 + index))
    }
}

// The long session polled, through dyn; returns the polls it took.
fn long_polled_session(bus: &mut dyn hal.I2cPoll) -> u32 {
    data := long_data()
    polls := finish_write(bus, DEVICE, &data)!
    command: [1]u8 = [0x40]
    buffer: [40]u8 = [0; 40]
    polls += finish_write_read(bus, DEVICE, &command, &mut buffer)!
    more: [30]u8 = [0; 30]
    polls += finish_read(bus, DEVICE, &mut more)!
    for index in 0..40usize {
        core.assert_eq(buffer[index], long_register(0x40 + index))
    }
    for index in 0..30usize {
        core.assert_eq(more[index], long_register(0x68 + index))
    }
    return polls
}

fn i2c_polled_long_transfers() {
    // Commands complete slower than the driver queues them, so the
    // transmit FIFO fills and each poll moves only part of a transfer;
    // then, with `burst`, the controller works off its whole queue at
    // once, as while an interrupt delays the CPU, and the reads in flight
    // must fit the 4-entry receive FIFO. The blocking methods,
    // hal.BlockingI2c over the polling methods, and the polling methods
    // themselves put the same bytes on the bus.
    for variant in 0..2usize {
        burst := variant == 1
        bus := i2c_bus(long_model(burst))
        long_session(&mut bus)
        model := bus.release()
        expect_long_log(&mut model)

        blocking := hal.BlockingI2c.new(i2c_bus(long_model(burst)))
        long_session(&mut blocking)
        bus = blocking.release()
        model = bus.release()
        expect_long_log(&mut model)

        bus = i2c_bus(long_model(burst))
        bus.listen()
        core.assert(long_polled_session(&mut bus) > 10)
        model = bus.release()
        expect_long_log(&mut model)
        core.assert_eq(model.interrupt_mask, 0u32)
        for index in 0..40usize {
            core.assert_eq(model.registers[0x80 + index], long_register(0x80 + index))
        }
    }
}

fn expect_finish_error(result: u32!hal.Error, expected: hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

fn i2c_polled_failures() {
    address := ADDRESS | (DEVICE as u32 << 1)
    data := long_data()
    one: [1]u8 = [0x07]
    // The device stops acknowledging in the middle of a long write; the
    // controller drops the rest and ends with STOP.
    model := I2cModel.new(16, 3)
    model.ack_bytes = 20
    bus := i2c_bus(model)
    bus.listen()
    expect_finish_error(finish_write(&mut bus, DEVICE, &data), hal.Error.NoAcknowledge)
    core.assert(!bus.is_busy())
    model = bus.release()
    core.assert_eq(model.interrupt_mask, 0u32)
    core.assert_eq(model.log_count, 24usize)
    core.assert(model.log[0] == START && model.log[1] == address && model.log[2] == 0x80)
    core.assert(model.log[22] == (200 - 20) as u32 && model.log[23] == STOP)
    model.log_count = 0
    model.ack_bytes = 0xFFFF_FFFF

    // Another master wins arbitration; then the bus works again.
    model.lose_arbitration = true
    bus = i2c_bus(model)
    expect_finish_error(finish_write(&mut bus, DEVICE, &one), hal.Error.Bus)
    finish_write(&mut bus, DEVICE, &one)!
    model = bus.release()
    arbitration: [5]u32 = [START, START, address, 0x07, STOP]
    model.expect(&arbitration)

    // An abort whose STOP never comes, because a device holds SCL low:
    // the transaction stays unfinished, waiting only for a STOP, until it
    // is cancelled.
    model.hold_after_abort = true
    bus = i2c_bus(model)
    bus.listen()
    for _ in 0..100 {
        core.assert(!bus.poll_write(0x10, &one)!)
    }
    core.assert(bus.is_busy())
    model = bus.release()
    core.assert_eq(model.interrupt_mask, 1u32 << 9)
    bus = i2c_bus(model)
    bus.listen()
    for _ in 0..100 {
        core.assert(!bus.poll_write(0x10, &one)!)
    }
    bus.cancel()
    core.assert(!bus.is_busy())
    model = bus.release()
    core.assert(!model.enabled && model.interrupt_mask == 0)
    model.hold_after_abort = false
    held: [6]u32 = [START, ADDRESS | 0x20, STOP, START, ADDRESS | 0x20, STOP]
    model.expect(&held)

    // Cancelled in the middle of a long write, which then ends with STOP;
    // the next transaction, with other arguments, starts afresh.
    bus = i2c_bus(model)
    for _ in 0..3 {
        core.assert(!bus.poll_write(DEVICE, &data)!)
    }
    bus.cancel()
    core.assert(!bus.is_busy())
    finish_write(&mut bus, DEVICE, &one)!
    model = bus.release()
    count := model.log_count
    core.assert(count > 8 && count < 48)
    core.assert(model.log[0] == START && model.log[1] == address && model.log[2] == 0x80)
    core.assert(model.log[count - 5] == STOP && model.log[count - 4] == START && model.log[count - 3] == address)
    core.assert(model.log[count - 2] == 0x07 && model.log[count - 1] == STOP)
    model.log_count = 0

    // A device that holds SCL low: polls never finish, and
    // hal.BlockingI2c gives up after its poll limit, cancels, and reports
    // Timeout.
    model.stuck = true
    blocking := hal.BlockingI2c.new(i2c_bus(model))
    blocking.set_poll_limit(1000)
    expect_error(blocking.write(DEVICE, &one), hal.Error.Timeout)
    bus = blocking.release()
    core.assert(!bus.is_busy())
    model = bus.release()
    core.assert(!model.enabled)
    core.assert(!model.tx_overflow && !model.rx_overflow)
}

fn i2c_polled_interrupts() {
    // A frozen controller completes nothing, so INTR_MASK after one poll
    // shows what the transaction waits on.
    model := I2cModel.new(4, 1)
    model.stuck = true
    bus := i2c_bus(model)
    bus.listen()
    model = bus.release()
    // Idle: nothing.
    core.assert_eq(model.interrupt_mask, 0u32)
    // A long write, 16 bytes queued and 25 to go: room in the transmit
    // FIFO, the end, or an abort.
    tx_empty := 1u32 << 4
    rx_full := 1u32 << 2
    ended := (1u32 << 6) | (1u32 << 9)
    data := long_data()
    bus = i2c_bus(model)
    bus.listen()
    core.assert(!bus.poll_write(DEVICE, &data)!)
    model = bus.release()
    core.assert_eq(model.interrupt_mask, tx_empty | ended)
    // A long read: four reads queued fill the receive FIFO's worth, so the
    // next waits for received bytes, not for room in the transmit FIFO.
    buffer: [40]u8 = [0; 40]
    bus = i2c_bus(model)
    bus.listen()
    core.assert(!bus.poll_read(DEVICE, &mut buffer)!)
    model = bus.release()
    core.assert_eq(model.interrupt_mask, rx_full | ended)
    // Everything queued: only the end.
    three: [3]u8 = [1, 2, 3]
    bus = i2c_bus(model)
    bus.listen()
    core.assert(!bus.poll_write(DEVICE, &three)!)
    model = bus.release()
    core.assert_eq(model.interrupt_mask, ended)
    // Not listening, the mask stays clear.
    bus = i2c_bus(model)
    bus.listen()
    bus.ignore()
    core.assert(!bus.poll_write(DEVICE, &data)!)
    model = bus.release()
    core.assert_eq(model.interrupt_mask, 0u32)

    // Once a transaction has ended, nothing is let through, although the
    // empty transmit FIFO raises TX_EMPTY.
    model.stuck = false
    model.log_count = 0
    bus = i2c_bus(model)
    bus.listen()
    finish_write(&mut bus, DEVICE, &three)!
    model = bus.release()
    core.assert((model.raw() & tx_empty) != 0)
    core.assert_eq(model.interrupt(), 0u32)
}

fn i2c_frequency() {
    bus := i2c_bus(I2cModel.new(16, 1))
    one: [1]u8 = [0]
    bus.write(DEVICE, &one)!
    // Timing registers change only while the controller is disabled; the
    // model checks that.
    bus.set_frequency(hal.I2C_STANDARD_HZ)!
    core.assert_eq(bus.frequency_hz(), 100_000u32)
    expect_error(bus.set_frequency(2_000_000), hal.Error.InvalidInput)
    core.assert_eq(bus.frequency_hz(), 100_000u32)
    bus.write(DEVICE, &one)!
    model := bus.release()
    core.assert_eq(model.high + model.spike + 7 + model.low + 1, 1250u32)
}

fn i2c_ten_bit() {
    bus := i2c_bus(I2cModel.new(16, 1))
    data: [2]u8 = [0x05, 0x99]
    bus.write_ten_bit(DEVICE10, &data)!
    register: [1]u8 = [0x05]
    value: [1]u8 = [0]
    bus.write_read_ten_bit(DEVICE10, &register, &mut value)!
    core.assert_eq(value[0], 0x99u8)
    bus.read_ten_bit(DEVICE10, &mut value)!
    core.assert_eq(value[0], 0u8)
    // Nobody acknowledges the low address byte.
    expect_error(bus.write_ten_bit(0x155, &data), hal.Error.NoAcknowledge)
    expect_error(bus.write_ten_bit(0x400, &data), hal.Error.InvalidInput)
    expect_error(bus.read_ten_bit(0x400, &mut value), hal.Error.InvalidInput)
    // Back to a 7-bit device.
    bus.write(DEVICE, &data)!
    model := bus.release()
    core.assert_eq(model.con & (1 << 4), 0u32)
    header := ADDRESS | 0xF4
    low := ADDRESS | 0xA5
    ten_bit: [30]u32 = [
        START, header, low, 0x05, 0x99, STOP,
        START, header, low, 0x05, RESTART, header | 1, 0x99, STOP,
        START, header, low, RESTART, header | 1, 0x00, STOP,
        START, ADDRESS | 0xF2, ADDRESS | 0x55, STOP,
        START, ADDRESS | 0x90, 0x05, 0x99, STOP
    ]
    model.expect(&ten_bit)
}

fn i2c_probe() {
    bus := i2c_bus(I2cModel.new(16, 2))
    core.assert(bus.probe(DEVICE)!)
    core.assert(!bus.probe(0x10)!)
    match bus.probe(0x80) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    model := bus.release()
    probes: [7]u32 = [START, ADDRESS | 0x91, 0x00, STOP, START, ADDRESS | 0x21, STOP]
    model.expect(&probes)
}

// --- A DW_apb_i2c as a target, and the master that addresses it ---------

// What the master does, one step per register read: a byte it writes
// (FIRST_BYTE when it follows the address), a STOP, or a read of a number of
// bytes.
const FIRST_BYTE: u32 = 1 << 11
const MASTER_STOP: u32 = 0x1000
const MASTER_READ: u32 = 0x2000
const TARGET_ADDRESS: u16 = 0x3C

struct I2cTargetModel {
    con: u32
    sar: u32
    enabled: bool
    interrupt_mask: u32
    general_call: u32
    spike: u32
    hold: u32
    rx: [16]u32
    rx_count: usize
    tx: [16]u8
    tx_count: usize
    // The controller flushed stale reply bytes and drops new ones until the
    // abort is cleared.
    aborted: bool
    read_request: bool
    rx_done: bool
    stop_detected: bool
    // RX_OVER: written bytes were lost.
    lost: bool
    script: [64]u32
    script_length: usize
    position: usize
    // Bytes left in the read under way, if it started.
    reading: u32
    read_started: bool
    // What the master read.
    received: [32]u8
    received_count: usize
    // Rule violations the driver must never cause.
    tx_overflow: bool
    rx_overflow: bool

    fn new() -> I2cTargetModel {
        return I2cTargetModel {
            con: 0x7F,
            sar: 0x55,
            enabled: false,
            interrupt_mask: 0x8FF,
            general_call: 1,
            spike: 0,
            hold: 0x0001_0001,
            rx: [0; 16],
            rx_count: 0,
            tx: [0; 16],
            tx_count: 0,
            aborted: false,
            read_request: false,
            rx_done: false,
            stop_detected: false,
            lost: false,
            script: [0; 64],
            script_length: 0,
            position: 0,
            reading: 0,
            read_started: false,
            received: [0; 32],
            received_count: 0,
            tx_overflow: false,
            rx_overflow: false,
        }
    }

    fn plan(&mut self, steps: &[u32]) {
        for index in 0..steps.len {
            core.assert(self.script_length < 64)
            self.script[self.script_length] = steps[index]
            self.script_length += 1
        }
    }

    fn done(&self) -> bool {
        return self.position == self.script_length
    }

    fn step(&mut self) {
        if !self.enabled || self.done() {
            return
        }
        item := self.script[self.position]
        if (item & MASTER_READ) != 0 {
            if !self.read_started {
                self.read_started = true
                self.reading = item & 0xFF
                if self.tx_count > 0 {
                    // Left over from an earlier reply.
                    self.tx_count = 0
                    self.aborted = true
                }
            }
            if self.tx_count == 0 {
                // SCL held low until the program answers.
                self.read_request = true
                return
            }
            core.assert(self.received_count < 32)
            self.received[self.received_count] = self.tx[0]
            self.received_count += 1
            for index in 1..self.tx_count {
                self.tx[index - 1] = self.tx[index]
            }
            self.tx_count -= 1
            self.reading -= 1
            if self.reading == 0 {
                // The master does not acknowledge the last byte.
                self.rx_done = true
                self.read_started = false
                self.position += 1
            }
        } else if item == MASTER_STOP {
            self.stop_detected = true
            self.position += 1
        } else {
            if self.rx_count == 16 {
                if (self.con & (1 << 9)) == 0 {
                    self.rx_overflow = true
                    self.position += 1
                }
                return
            }
            self.rx[self.rx_count] = item
            self.rx_count += 1
            self.position += 1
        }
    }

    pub fn read(&mut self, offset: usize) -> u32 {
        self.step()
        if offset == 0x10 {
            core.assert(self.rx_count > 0)
            entry := self.rx[0]
            for index in 1..self.rx_count {
                self.rx[index - 1] = self.rx[index]
            }
            self.rx_count -= 1
            return entry
        } else if offset == 0x34 {
            raw := 0u32
            if self.lost {
                raw |= 1 << 1
            }
            if self.read_request {
                raw |= 1 << 5
            }
            if self.aborted {
                raw |= 1 << 6
            }
            if self.rx_done {
                raw |= 1 << 7
            }
            if self.stop_detected {
                raw |= 1 << 9
            }
            return raw
        } else if offset == 0x40 {
            self.read_request = false
            self.aborted = false
            self.rx_done = false
            self.stop_detected = false
            return 0
        } else if offset == 0x4C {
            self.lost = false
            return 0
        } else if offset == 0x50 {
            self.read_request = false
            return 0
        } else if offset == 0x54 {
            self.aborted = false
            return 0
        } else if offset == 0x58 {
            self.rx_done = false
            return 0
        } else if offset == 0x60 {
            self.stop_detected = false
            return 0
        } else if offset == 0x70 {
            status := 0u32
            if self.tx_count < 16 {
                status |= 1 << 1
            }
            if self.rx_count > 0 {
                status |= 1 << 3
            }
            return status
        } else if offset == 0x7C {
            return self.hold
        } else if offset == 0x00 {
            return self.con
        } else if offset == 0x9C {
            if self.enabled {
                return 1
            }
            return 0
        }
        core.assert(false)
        return 0
    }

    pub fn write(&mut self, offset: usize, value: u32) {
        if offset == 0x6C {
            core.assert_eq(value & 2, 0u32)
            self.enabled = (value & 1) != 0
            if !self.enabled {
                self.tx_count = 0
                self.rx_count = 0
            }
            return
        }
        if offset == 0x10 {
            core.assert(self.enabled)
            // Only data bytes: a target never issues read commands.
            core.assert_eq(value & 0x700, 0u32)
            if self.aborted {
                return
            }
            if self.tx_count == 16 {
                self.tx_overflow = true
                return
            }
            self.tx[self.tx_count] = value as u8
            self.tx_count += 1
            return
        }
        core.assert(!self.enabled)
        if offset == 0x00 {
            self.con = value
        } else if offset == 0x08 {
            self.sar = value
        } else if offset == 0x30 {
            self.interrupt_mask = value
        } else if offset == 0x38 || offset == 0x3C {
            core.assert_eq(value, 0u32)
        } else if offset == 0x98 {
            self.general_call = value
        } else if offset == 0x7C {
            self.hold = value
        } else if offset == 0xA0 {
            self.spike = value
        } else {
            core.assert(false)
        }
    }
}

// A register device on the target: 64 registers behind a pointer that the
// first byte of each write sets and every byte moves on. Polls until the
// master's script is done and nothing is left to report; returns the STOPs
// seen.
struct Registers {
    memory: [64]u8
    pointer: usize
    stops: u32
    writes: u32
}

fn serve(target: &mut designware_i2c.Target<I2cTargetModel>, device: &mut Registers, buffer: &mut[u8], reply_length: usize) {
    idle := 0u32
    for idle < 50 {
        match target.poll(buffer)! {
            hal.I2cTargetEvent.Idle => {
                idle += 1
            }
            hal.I2cTargetEvent.Write(count, start) => {
                idle = 0
                first := 0usize
                if start {
                    device.pointer = buffer[0] as usize
                    device.writes += 1
                    first = 1
                }
                for index in first..count {
                    device.memory[device.pointer % 64] = buffer[index]
                    device.pointer += 1
                }
            }
            hal.I2cTargetEvent.Read => {
                idle = 0
                position := device.pointer % 64
                end := position + reply_length
                if end > 64 {
                    end = 64
                }
                device.pointer += target.respond(&device.memory[position..end])!
            }
            hal.I2cTargetEvent.Stop => {
                idle = 0
                device.stops += 1
            }
        }
    }
}

fn fast_timing() -> designware_i2c.Timing {
    return designware_i2c.timing(CLOCK_HZ, hal.I2C_FAST_HZ)!
}

fn i2c_target() {
    target := designware_i2c.Target.new(I2cTargetModel.new(), fast_timing(), TARGET_ADDRESS, false)
    model := target.release()
    // A target only: master mode and the target disable off, fast-mode
    // spike filter, STOP only when addressed, SCL held while the receive
    // FIFO is full; no interrupts, no general calls.
    core.assert_eq(model.con, 0x284u32)
    core.assert_eq(model.sar, 0x3Cu32)
    core.assert(model.interrupt_mask == 0 && model.general_call == 0)
    core.assert(model.spike == 11 && model.hold == 0x0001_0026)
    core.assert(!model.enabled)

    // A register write, a register read with a repeated START, and a
    // write longer than the receive FIFO, which holds the master up
    // instead of overflowing. The buffer is smaller than the writes, and
    // they follow each other without waiting for the program.
    long: [24]u32 = [0; 24]
    long[0] = FIRST_BYTE | 0x20
    for index in 1..24usize {
        long[index] = (0x40 + index) as u32
    }
    script: [10]u32 = [
        FIRST_BYTE | 0x10, 0x22, 0x33, MASTER_STOP,
        FIRST_BYTE | 0x10, MASTER_READ | 2, MASTER_STOP,
        FIRST_BYTE | 0x08, 0x77, MASTER_STOP
    ]
    model.plan(&script)
    model.plan(&long)
    final_stop: [1]u32 = [MASTER_STOP]
    model.plan(&final_stop)
    target = designware_i2c.Target.new(model, fast_timing(), TARGET_ADDRESS, false)
    device := Registers { memory: [0; 64], pointer: 0, stops: 0, writes: 0 }
    buffer: [4]u8 = [0; 4]
    serve(&mut target, &mut device, &mut buffer, 1)
    model = target.release()
    core.assert(model.done() && !model.rx_overflow && !model.tx_overflow)
    core.assert(device.memory[0x10] == 0x22 && device.memory[0x11] == 0x33 && device.memory[0x08] == 0x77)
    for index in 1..24usize {
        core.assert_eq(device.memory[0x20 + index - 1], (0x40 + index) as u8)
    }
    core.assert_eq(device.writes, 4u32)
    core.assert(device.stops >= 1 && device.stops <= 4)
    core.assert(model.received_count == 2 && model.received[0] == 0x22 && model.received[1] == 0x33)

    // Replies queued in bulk: the master reads fewer than queued, and the
    // rest is dropped when it next reads, so the second read starts afresh.
    model.received_count = 0
    bulk: [7]u32 = [FIRST_BYTE | 0x20, MASTER_READ | 3, MASTER_STOP, FIRST_BYTE | 0x10, MASTER_READ | 2, MASTER_STOP, MASTER_READ | 1]
    model.plan(&bulk)
    target = designware_i2c.Target.new(model, fast_timing(), TARGET_ADDRESS, false)
    device.pointer = 0
    serve(&mut target, &mut device, &mut buffer, 8)
    model = target.release()
    core.assert(model.done() && !model.tx_overflow)
    core.assert_eq(model.received_count, 6usize)
    core.assert(model.received[0] == 0x41 && model.received[2] == 0x43)
    core.assert(model.received[3] == 0x22 && model.received[4] == 0x33)
    // A read without a write first continues where the pointer is, past
    // the eight bytes queued for the read before.
    core.assert_eq(model.received[5], device.memory[0x18])

    // Lost bytes, which the controller cannot lose while it holds SCL on a
    // full receive FIFO, would be reported once, and the target goes on.
    model.lost = true
    target = designware_i2c.Target.new(model, fast_timing(), TARGET_ADDRESS, false)
    dynamic: &mut dyn hal.I2cTarget = &mut target
    match dynamic.poll(&mut buffer) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Overrun)
        }
    }
    match dynamic.poll(&mut buffer)! {
        hal.I2cTargetEvent.Idle => {}
        _ => {
            core.assert(false)
        }
    }
    // An empty reply answers 0xFF and counts nothing.
    empty: [0]u8 = []
    core.assert_eq(dynamic.respond(&empty)!, 0usize)
    model = target.release()
    core.assert(!model.lost && model.tx_count == 0)

    // A 10-bit address, and a change of address between transactions.
    target = designware_i2c.Target.new(model, fast_timing(), 0x2A5, true)
    target.set_address(0x51, false)!
    match target.set_address(0x78, false) {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    model = target.release()
    core.assert(model.sar == 0x51 && (model.con & (1 << 3)) == 0)
    target = designware_i2c.Target.new(model, fast_timing(), 0x2A5, true)
    model = target.release()
    core.assert(model.sar == 0x2A5 && (model.con & (1 << 3)) != 0)

    // Reserved and out-of-range addresses.
    invalid: [5]u16 = [0x00, 0x07, 0x78, 0x7F, 0x80]
    for index in 0..5usize {
        match designware_i2c.target_address(invalid[index], false) {
            ok(_) => {
                core.assert(false)
            }
            err(error) => {
                core.assert(error == hal.Error.InvalidInput)
            }
        }
    }
    core.assert_eq(designware_i2c.target_address(0x08, false)!, 0x08u32)
    core.assert_eq(designware_i2c.target_address(0x3FF, true)!, 0x3FFu32)
    match designware_i2c.target_address(0x400, true) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
}

// --- A PL022 and the device answering on its bus -----------------------

const SPI_FIFO: usize = 8

struct SpiModel {
    cr0: u32
    cr1: u32
    prescale: u32
    interrupt_mask: u32
    tx: [8]u16
    tx_count: usize
    // The frame in the shift register, between the FIFOs.
    shifting: bool
    shift_value: u16
    rx: [8]u16
    rx_count: usize
    overrun: bool
    // The device's reply, then zeros; or the sent byte in loopback mode.
    reply: [64]u16
    reply_length: usize
    reply_position: usize
    sent: [64]u16
    sent_count: usize
    // Shift one frame every `period` status reads. With `burst`, shift every
    // queued frame at once whenever the transmit FIFO is full, as if an
    // interrupt had delayed the CPU at the worst moment.
    period: u32
    burst: bool
    reads: u32
    // Status reads a finished frame takes to reach the receive FIFO, after
    // the controller already reports idle, as the crossing between its
    // clock domains may delay it at high SPI clocks. Zero stores it at once.
    receive_delay: u32
    landing: bool
    landing_value: u16
    landing_reads: u32
    // Lose the next received byte to an overflow.
    lose_reply: bool
    tx_overflow: bool
    // As a target: the frame sent last, which the controller repeats when
    // the master clocks with the transmit FIFO empty, and how often it did.
    last_sent: u16
    underruns: u32
    // Every CR1 bit ever written.
    cr1_written: u32

    fn new(period: u32) -> SpiModel {
        return SpiModel {
            cr0: 0,
            cr1: 0,
            prescale: 0,
            interrupt_mask: 0xF,
            tx: [0; 8],
            tx_count: 0,
            shifting: false,
            shift_value: 0,
            rx: [0; 8],
            rx_count: 0,
            overrun: false,
            reply: [0; 64],
            reply_length: 0,
            reply_position: 0,
            sent: [0; 64],
            sent_count: 0,
            period,
            burst: false,
            reads: 0,
            receive_delay: 0,
            landing: false,
            landing_value: 0,
            landing_reads: 0,
            lose_reply: false,
            tx_overflow: false,
            last_sent: 0,
            underruns: 0,
            cr1_written: 0,
        }
    }

    fn reply_with(&mut self, bytes: &[u8]) {
        for index in 0..bytes.len {
            self.reply[index] = bytes[index] as u16
        }
        self.reply_length = bytes.len
        self.reply_position = 0
    }

    fn reply_with_words(&mut self, words: &[u16]) {
        for index in 0..words.len {
            self.reply[index] = words[index]
        }
        self.reply_length = words.len
        self.reply_position = 0
    }

    fn target(&self) -> bool {
        return (self.cr1 & 4) != 0
    }

    // The bits of one frame.
    fn mask(&self) -> u16 {
        return ((1u32 << ((self.cr0 & 0xF) + 1)) - 1) as u16
    }

    fn step(&mut self) {
        self.reads += 1
        if self.target() {
            // The master clocks a frame every `period` reads while it has
            // frames to send, whether or not the target is ready.
            if (self.cr1 & 2) != 0 && self.reads % self.period == 0 && self.reply_position < self.reply_length {
                value := self.last_sent
                if self.tx_count > 0 {
                    value = self.tx[0]
                    for index in 1..self.tx_count {
                        self.tx[index - 1] = self.tx[index]
                    }
                    self.tx_count -= 1
                } else {
                    self.underruns += 1
                }
                self.last_sent = value
                core.assert(self.sent_count < 64)
                self.sent[self.sent_count] = value
                self.sent_count += 1
                answer := self.reply[self.reply_position] & self.mask()
                self.reply_position += 1
                self.store(answer)
            }
            return
        }
        if self.landing {
            if self.landing_reads == 0 {
                self.land()
            } else {
                self.landing_reads -= 1
            }
        }
        if self.burst && self.tx_count == SPI_FIFO {
            for self.tx_count > 0 || self.shifting {
                self.shift()
            }
        } else if self.reads % self.period == 0 {
            self.shift()
        }
    }

    // Finish the frame in the shift register, then load the next one.
    fn shift(&mut self) {
        if self.shifting {
            value := self.shift_value
            answer := 0u16
            if (self.cr1 & 1) != 0 {
                answer = value
            } else {
                core.assert(self.sent_count < 64)
                self.sent[self.sent_count] = value
                self.sent_count += 1
                if self.reply_position < self.reply_length {
                    answer = self.reply[self.reply_position] & self.mask()
                    self.reply_position += 1
                }
            }
            if self.receive_delay == 0 {
                self.store(answer)
            } else {
                self.land()
                self.landing = true
                self.landing_value = answer
                self.landing_reads = self.receive_delay
            }
            self.shifting = false
        }
        if self.tx_count > 0 {
            self.shift_value = self.tx[0]
            for index in 1..self.tx_count {
                self.tx[index - 1] = self.tx[index]
            }
            self.tx_count -= 1
            self.shifting = true
        }
    }

    fn land(&mut self) {
        if self.landing {
            self.landing = false
            value := self.landing_value
            self.store(value)
        }
    }

    // A received frame enters the receive FIFO, or is lost.
    fn store(&mut self, answer: u16) {
        if self.rx_count == SPI_FIFO || self.lose_reply {
            self.overrun = true
            self.lose_reply = false
        } else {
            self.rx[self.rx_count] = answer
            self.rx_count += 1
        }
    }

    pub fn read(&mut self, offset: usize) -> u32 {
        if offset == 0x000 {
            return self.cr0
        } else if offset == 0x004 {
            return self.cr1
        } else if offset == 0x008 {
            core.assert(self.rx_count > 0)
            value := self.rx[0]
            for index in 1..self.rx_count {
                self.rx[index - 1] = self.rx[index]
            }
            self.rx_count -= 1
            return value as u32
        } else if offset == 0x00C {
            self.step()
            status := 0u32
            if self.tx_count == 0 {
                status |= 1 << 0
            }
            if self.tx_count < SPI_FIFO {
                status |= 1 << 1
            }
            if self.rx_count > 0 {
                status |= 1 << 2
            }
            if self.tx_count > 0 || self.shifting {
                status |= 1 << 4
            }
            return status
        } else if offset == 0x018 {
            if self.overrun {
                return 1
            }
            return 0
        }
        core.assert(false)
        return 0
    }

    pub fn write(&mut self, offset: usize, value: u32) {
        enabled := (self.cr1 & 2) != 0
        if offset == 0x004 {
            // Master or target mode changes only while disabled.
            if (self.cr1 & 2) != 0 && (value & 2) != 0 {
                core.assert_eq(value & 4, self.cr1 & 4)
            }
            self.cr1 = value
            self.cr1_written |= value
        } else if offset == 0x008 {
            core.assert(enabled)
            if self.tx_count == SPI_FIFO {
                self.tx_overflow = true
            } else {
                // Nothing above the frame size.
                core.assert_eq(value & ~(self.mask() as u32), 0u32)
                self.tx[self.tx_count] = value as u16
                self.tx_count += 1
            }
        } else if offset == 0x020 {
            if (value & 1) != 0 {
                self.overrun = false
            }
        } else if offset == 0x014 {
            self.interrupt_mask = value
        } else {
            // The format and clock change only while disabled.
            core.assert(!enabled)
            if offset == 0x000 {
                // The TI and Microwire formats have no polarity or phase.
                core.assert((value & 0x30) == 0 || (value & 0xC0) == 0)
                core.assert((value & 0x30) != 0x30)
                self.cr0 = value
            } else if offset == 0x010 {
                self.prescale = value
            } else {
                core.assert(false)
            }
        }
    }

    fn expect_sent(&mut self, bytes: &[u8]) {
        core.assert_eq(self.sent_count, bytes.len)
        for index in 0..bytes.len {
            core.assert_eq(self.sent[index], bytes[index] as u16)
        }
        self.sent_count = 0
        core.assert(!self.tx_overflow && !self.overrun)
        core.assert(self.rx_count == 0 && !self.landing)
    }
}

fn spi_divisors() {
    one := pl022.divisors(CLOCK_HZ, 1_000_000)!
    core.assert_eq(one.prescale, 2u32)
    core.assert_eq(one.rate, 63u32)
    core.assert_eq(one.frequency_hz, 992_063u32)
    // Requests above half the input clock get the fastest clock.
    fastest := pl022.divisors(CLOCK_HZ, 100_000_000)!
    core.assert_eq(fastest.prescale * fastest.rate, 2u32)
    core.assert_eq(fastest.frequency_hz, 62_500_000u32)
    // Near the bottom of the range the result still never exceeds the
    // request.
    slow := pl022.divisors(CLOCK_HZ, 2_000)!
    core.assert(slow.frequency_hz <= 2_000 && slow.frequency_hz > 1_990)
    core.assert(slow.prescale % 2 == 0 && slow.prescale <= 254 && slow.rate <= 256)
    requests: [5]u32 = [3_000, 1_000_000, 4_000_000, 10_000_000, 33_333_333]
    for index in 0..5usize {
        frequency := requests[index]
        result := pl022.divisors(150_000_000, frequency)!
        core.assert(result.frequency_hz <= frequency)
        core.assert_eq(result.frequency_hz, 150_000_000 / (result.prescale * result.rate))
    }
    // The fastest clock may need a larger prescaler than the smallest that
    // reaches the request: 125 MHz / 1030 (10 * 103), not / 1032 (6 * 172).
    close := pl022.divisors(CLOCK_HZ, 121_400)!
    core.assert_eq(close.prescale * close.rate, 1030u32)
    core.assert_eq(close.frequency_hz, 121_359u32)
    // Exhaustively, at 125 MHz: no pair of dividers gets closer.
    targets: [5]u32 = [3_000, 50_000, 121_400, 333_333, 2_000_001]
    for index in 0..5usize {
        request := targets[index]
        result := pl022.divisors(CLOCK_HZ, request)!
        for prescale in 1..128u32 {
            for rate in 1..257u32 {
                // Too fast if the exact clock, not just its whole hertz,
                // is above the request.
                total := 2 * prescale * rate
                core.assert((total as u64) * (request as u64) < CLOCK_HZ as u64 || total >= result.prescale * result.rate)
            }
        }
    }
    match pl022.divisors(CLOCK_HZ, 1_900) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
}

fn spi_bus(model: SpiModel, mode: hal.SpiMode) -> pl022.Controller<SpiModel> {
    return pl022.Controller.new(model, pl022.divisors(CLOCK_HZ, 1_000_000)!, mode)
}

fn spi_configuration() {
    // 8-bit Motorola frames, the divisor, and polarity and phase per mode.
    expected: [4]u32 = [0x3E07, 0x3E87, 0x3E47, 0x3EC7]
    for index in 0..4usize {
        mode := hal.SpiMode.Mode0
        if index == 1 {
            mode = hal.SpiMode.Mode1
        } else if index == 2 {
            mode = hal.SpiMode.Mode2
        } else if index == 3 {
            mode = hal.SpiMode.Mode3
        }
        bus := spi_bus(SpiModel.new(1), mode)
        model := bus.release()
        core.assert_eq(model.cr0, expected[index])
        core.assert_eq(model.prescale, 2u32)
        core.assert_eq(model.interrupt_mask, 0u32)
        core.assert_eq(model.cr1, 0u32)
    }
    bus := spi_bus(SpiModel.new(1), hal.SpiMode.Mode0)
    core.assert_eq(bus.frequency_hz(), 992_063u32)
    bus.set_mode(hal.SpiMode.Mode3)
    bus.set_frequency(10_000_000)!
    core.assert_eq(bus.frequency_hz(), 8_928_571u32)
    match bus.set_frequency(100) {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    model := bus.release()
    core.assert_eq(model.cr0, 0x06C7u32)
    core.assert_eq(model.prescale, 2u32)
}

fn spi_transfers() {
    // Frames shift slower than the driver queues them, so the transmit FIFO
    // fills, and now and then all at once: the bytes in flight, including
    // the one in the shift register, must fit the receive FIFO.
    model := SpiModel.new(3)
    model.burst = true
    reply: [20]u8 = [0; 20]
    for index in 0..20usize {
        reply[index] = (100 + index) as u8
    }
    model.reply_with(&reply)
    bus := spi_bus(model, hal.SpiMode.Mode0)
    bytes: [20]u8 = [0; 20]
    sent: [20]u8 = [0; 20]
    for index in 0..20usize {
        bytes[index] = index as u8
        sent[index] = index as u8
    }
    bus.transfer(&mut bytes)!
    for index in 0..20usize {
        core.assert_eq(bytes[index], (100 + index) as u8)
    }
    model = bus.release()
    model.expect_sent(&sent)

    // A write sends everything, waits for the last frame, and leaves nothing
    // behind in the receive FIFO.
    bus = spi_bus(model, hal.SpiMode.Mode0)
    long: [30]u8 = [0; 30]
    for index in 0..30usize {
        long[index] = (7 * index) as u8
    }
    bus.write(&long)!
    model = bus.release()
    model.expect_sent(&long)

    // A single byte, the usual register read: the controller is idle when
    // it is queued, which must not pass for a lost reply.
    single_reply: [1]u8 = [0x42]
    model.reply_with(&single_reply)
    bus = spi_bus(model, hal.SpiMode.Mode0)
    single: [1]u8 = [0x0F]
    bus.transfer(&mut single)!
    core.assert_eq(single[0], 0x42u8)
    model = bus.release()
    single_sent: [1]u8 = [0x0F]
    model.expect_sent(&single_sent)

    // Loopback reads back what was sent, without the device seeing it.
    bus = spi_bus(model, hal.SpiMode.Mode0)
    bus.set_loopback(true)
    echo: [3]u8 = [0xA5, 0x5A, 0xFF]
    bus.transfer(&mut echo)!
    core.assert_eq(echo[0], 0xA5u8)
    core.assert_eq(echo[2], 0xFFu8)
    bus.set_loopback(false)

    // hal.SpiDevice drives a chip select around each transaction.
    flash := hal.SpiDevice.new(fake.Pin.new())
    model = bus.release()
    flash_id: [4]u8 = [0, 0xEF, 0x40, 0x18]
    model.reply_with(&flash_id)
    bus = spi_bus(model, hal.SpiMode.Mode0)
    command: [1]u8 = [0x9F]
    id: [3]u8 = [0, 0, 0]
    flash.write_read(&mut bus, &command, &mut id)!
    core.assert_eq(id[0], 0xEFu8)
    core.assert_eq(id[2], 0x18u8)
    select := flash.release()
    // Deselected by `new`, then selected once for the whole transaction.
    core.assert(select.is_high())
    core.assert_eq(select.changes(), 3u32)
    model = bus.release()
    id_command: [4]u8 = [0x9F, 0, 0, 0]
    model.expect_sent(&id_command)

    // Reading one register reads a single byte after the command.
    sensor := hal.SpiDevice.new(fake.Pin.new())
    register_reply: [2]u8 = [0, 0x5D]
    model.reply_with(&register_reply)
    bus = spi_bus(model, hal.SpiMode.Mode0)
    register: [1]u8 = [0x8F]
    value: [1]u8 = [0]
    sensor.write_read(&mut bus, &register, &mut value)!
    core.assert_eq(value[0], 0x5Du8)
    model = bus.release()
    register_read: [2]u8 = [0x8F, 0]
    model.expect_sent(&register_read)
}

fn expect_poll_error(result: bool!hal.Error, expected: hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

// Polled transfers (hal.SpiPoll): any length across polls, with the model
// shifting slower than the driver polls, so each poll moves part of it.
fn spi_polled() {
    model := SpiModel.new(3)
    model.burst = true
    reply: [20]u8 = [0; 20]
    for index in 0..20usize {
        reply[index] = (100 + index) as u8
    }
    model.reply_with(&reply)
    bus := spi_bus(model, hal.SpiMode.Mode0)
    bytes: [20]u8 = [0; 20]
    sent: [20]u8 = [0; 20]
    for index in 0..20usize {
        bytes[index] = index as u8
        sent[index] = index as u8
    }
    polls := 0u32
    for !bus.poll_transfer(&mut bytes)! {
        polls += 1
        core.assert(bus.is_busy())
    }
    core.assert(polls > 2)
    core.assert(!bus.is_busy())
    for index in 0..20usize {
        core.assert_eq(bytes[index], (100 + index) as u8)
    }
    model = bus.release()
    model.expect_sent(&sent)

    // A write returns true only once the last frame has left; calls with
    // another length or kind are refused while it runs. Frames shift one
    // every three reads, so a poll leaves most of them for later.
    model.burst = false
    bus = spi_bus(model, hal.SpiMode.Mode0)
    long: [30]u8 = [0; 30]
    for index in 0..30usize {
        long[index] = (3 * index) as u8
    }
    core.assert(!bus.poll_write(&long)!)
    short: [3]u8 = [0; 3]
    expect_poll_error(bus.poll_write(&short), hal.Error.InvalidInput)
    expect_poll_error(bus.poll_transfer(&mut bytes), hal.Error.InvalidInput)
    for !bus.poll_write(&long)! {}
    model = bus.release()
    model.expect_sent(&long)

    // Cancelled part way, the frames already queued still go out and the
    // next transfer starts afresh.
    bus = spi_bus(model, hal.SpiMode.Mode0)
    core.assert(!bus.poll_write(&long)!)
    bus.cancel()
    core.assert(!bus.is_busy())
    model = bus.release()
    core.assert(model.sent_count > 0 && model.sent_count < 30)
    model.sent_count = 0
    bus = spi_bus(model, hal.SpiMode.Mode0)
    empty: [0]u8 = []
    core.assert(bus.poll_write(&empty)!)

    // A device selected around a polled write and read, and the blocking
    // adapter over the polling form, send what the blocking methods send.
    flash := hal.SpiDevice.new(fake.Pin.new())
    model = bus.release()
    flash_id: [4]u8 = [0, 0xEF, 0x40, 0x18]
    model.reply_with(&flash_id)
    bus = spi_bus(model, hal.SpiMode.Mode0)
    command: [1]u8 = [0x9F]
    id: [3]u8 = [0, 0, 0]
    for !flash.poll_write_read(&mut bus, &command, &mut id)! {}
    core.assert(id[0] == 0xEF && id[2] == 0x18)
    model = bus.release()
    id_command: [4]u8 = [0x9F, 0, 0, 0]
    model.expect_sent(&id_command)
    model.reply_with(&flash_id)
    blocking := hal.BlockingSpi.new(spi_bus(model, hal.SpiMode.Mode0))
    flash.write_read(&mut blocking, &command, &mut id)!
    core.assert_eq(id[1], 0x40u8)
    bus = blocking.release()
    dynamic: &mut dyn hal.SpiPoll = &mut bus
    core.assert(dynamic.poll_write(&command)! || true)
    for !bus.poll_write(&command)! {}
    model = bus.release()
    two_ids: [5]u8 = [0x9F, 0, 0, 0, 0x9F]
    model.expect_sent(&two_ids)

    // Frames above 8 bits move with the word methods only.
    bus = spi_bus(model, hal.SpiMode.Mode0)
    bus.set_frame_bits(12)!
    expect_poll_error(bus.poll_write(&command), hal.Error.Unsupported)
    model = bus.release()
}

fn spi_overrun() {
    // A receive FIFO that overflowed, for example because something else
    // used the controller, is reported once and cleared.
    bus := spi_bus(SpiModel.new(1), hal.SpiMode.Mode0)
    model := bus.release()
    model.overrun = true
    bus = spi_bus(model, hal.SpiMode.Mode0)
    bytes: [2]u8 = [1, 2]
    expect_error(bus.transfer(&mut bytes), hal.Error.Overrun)
    bus.transfer(&mut bytes)!

    // A lost reply ends the transfer instead of waiting for it forever.
    model = bus.release()
    model.lose_reply = true
    bus = spi_bus(model, hal.SpiMode.Mode0)
    expect_error(bus.transfer(&mut bytes), hal.Error.Overrun)
    bus.transfer(&mut bytes)!

    // Replies that reach the receive FIFO only after the controller looks
    // idle are late, not lost.
    model = bus.release()
    model.receive_delay = 4
    late_reply: [3]u8 = [0x11, 0x22, 0x33]
    model.reply_with(&late_reply)
    model.sent_count = 0
    bus = spi_bus(model, hal.SpiMode.Mode0)
    single: [1]u8 = [0x0F]
    bus.transfer(&mut single)!
    core.assert_eq(single[0], 0x11u8)
    bytes[0] = 0x0A
    bytes[1] = 0x0B
    bus.transfer(&mut bytes)!
    core.assert_eq(bytes[0], 0x22u8)
    core.assert_eq(bytes[1], 0x33u8)
    model = bus.release()
    late_sent: [3]u8 = [0x0F, 0x0A, 0x0B]
    model.expect_sent(&late_sent)

    // A late reply that is lost still ends the transfer.
    model.lose_reply = true
    bus = spi_bus(model, hal.SpiMode.Mode0)
    expect_error(bus.transfer(&mut bytes), hal.Error.Overrun)
    bus.transfer(&mut bytes)!
}

fn expect_words(model: &mut SpiModel, words: &[u16]) {
    core.assert_eq(model.sent_count, words.len)
    for index in 0..words.len {
        core.assert_eq(model.sent[index], words[index])
    }
    model.sent_count = 0
    core.assert(!model.tx_overflow && !model.overrun)
}

fn spi_frames() {
    // 12-bit frames: the word methods carry them, bits above the frame are
    // dropped going out, and the byte methods refuse them.
    model := SpiModel.new(2)
    model.burst = true
    replies: [12]u16 = [0; 12]
    for index in 0..12usize {
        replies[index] = (0xF000 | (0x111 * index)) as u16
    }
    model.reply_with_words(&replies)
    bus := spi_bus(model, hal.SpiMode.Mode1)
    bus.set_frame_bits(12)!
    core.assert_eq(bus.frame_bits(), 12u32)
    words: [12]u16 = [0; 12]
    for index in 0..12usize {
        words[index] = (0xA000 | (0x0AB + index)) as u16
    }
    bus.transfer_words(&mut words)!
    for index in 0..12usize {
        core.assert_eq(words[index], (0x111 * index) as u16)
    }
    bytes: [2]u8 = [1, 2]
    expect_error(bus.transfer(&mut bytes), hal.Error.Unsupported)
    expect_error(bus.write(&bytes), hal.Error.Unsupported)
    expect_error(bus.set_frame_bits(3), hal.Error.InvalidInput)
    expect_error(bus.set_frame_bits(17), hal.Error.InvalidInput)
    core.assert_eq(bus.frame_bits(), 12u32)
    model = bus.release()
    core.assert_eq(model.cr0 & 0xFF, 0x8Bu32)
    sent: [12]u16 = [0; 12]
    for index in 0..12usize {
        sent[index] = (0x0AB + index) as u16
    }
    expect_words(&mut model, &sent)

    // 16-bit writes, then 4-bit frames through the byte methods.
    bus = spi_bus(model, hal.SpiMode.Mode0)
    bus.set_frame_bits(16)!
    wide: [3]u16 = [0xFFFF, 0x1234, 0x8001]
    bus.write_words(&wide)!
    bus.set_frame_bits(4)!
    nibble_replies: [2]u8 = [0x3C, 0x05]
    model = bus.release()
    expect_words(&mut model, &wide)
    model.reply_with(&nibble_replies)
    bus = spi_bus(model, hal.SpiMode.Mode0)
    bus.set_frame_bits(4)!
    nibbles: [2]u8 = [0x09, 0x0F]
    bus.transfer(&mut nibbles)!
    core.assert(nibbles[0] == 0x0C && nibbles[1] == 0x05)
    model = bus.release()
    nibbles_out: [2]u8 = [0x09, 0x0F]
    model.expect_sent(&nibbles_out)

    // The TI and Microwire formats clear polarity and phase, and the
    // Motorola format brings the mode back.
    bus = spi_bus(model, hal.SpiMode.Mode3)
    bus.set_frame_format(pl022.FrameFormat.TexasInstruments)
    model = bus.release()
    core.assert_eq(model.cr0 & 0xF0, 0x10u32)
    bus = spi_bus(model, hal.SpiMode.Mode3)
    bus.set_frame_format(pl022.FrameFormat.Microwire)
    bus.set_frame_bits(16)!
    // A Microwire read: an 8-bit command, a 16-bit answer.
    answer: [1]u16 = [0xBEEF]
    model = bus.release()
    core.assert_eq(model.cr0 & 0xFF, 0x2Fu32)
    model.reply_with_words(&answer)
    bus = spi_bus(model, hal.SpiMode.Mode3)
    bus.set_frame_format(pl022.FrameFormat.Microwire)
    bus.set_frame_bits(16)!
    command: [1]u16 = [0x0086]
    bus.transfer_words(&mut command)!
    core.assert_eq(command[0], 0xBEEFu16)
    bus.set_frame_format(pl022.FrameFormat.Motorola)
    model = bus.release()
    core.assert_eq(model.cr0 & 0xF0, 0xC0u32)
    microwire_sent: [1]u16 = [0x0086]
    expect_words(&mut model, &microwire_sent)
}

fn spi_target_bus(model: SpiModel) -> pl022.Target<SpiModel> {
    return pl022.Target.new(model, hal.SpiMode.Mode3)
}

fn spi_target() {
    // Configured as a target: CR1 says so before the port is enabled, and
    // nothing interrupts.
    target := spi_target_bus(SpiModel.new(1))
    model := target.release()
    core.assert_eq(model.cr0, 0xC7u32)
    core.assert(model.cr1 == 0 && model.interrupt_mask == 0)

    // The master sends 20 bytes while the target exchanges them, slower
    // than the target refills, so no frame repeats.
    model.period = 4
    master: [20]u8 = [0; 20]
    for index in 0..20usize {
        master[index] = (0x80 + index) as u8
    }
    model.reply_with(&master)
    target = spi_target_bus(model)
    bytes: [20]u8 = [0; 20]
    for index in 0..20usize {
        bytes[index] = index as u8
    }
    target.transfer(&mut bytes)!
    for index in 0..20usize {
        core.assert_eq(bytes[index], (0x80 + index) as u8)
    }
    model = target.release()
    core.assert_eq(model.underruns, 0u32)
    sent: [20]u8 = [0; 20]
    for index in 0..20usize {
        sent[index] = index as u8
    }
    model.expect_sent(&sent)

    // Polled: queue replies, read what came, and an overflowed receive FIFO
    // reported once.
    command: [3]u8 = [0x9F, 0, 0]
    model.reply_with(&command)
    target = spi_target_bus(model)
    reply: [3]u8 = [0xFF, 0xEF, 0x40]
    core.assert_eq(target.queue(&reply)!, 3usize)
    received: [3]u8 = [0; 3]
    count := 0usize
    for count < 3 {
        count += target.read(&mut received[count..])!
    }
    core.assert(received[0] == 0x9F && received[2] == 0)
    model = target.release()
    model.expect_sent(&reply)
    model.overrun = true
    model.lose_reply = true
    lost: [1]u8 = [0x77]
    model.reply_with(&lost)
    target = spi_target_bus(model)
    lost_count := 0u32
    for lost_count == 0 {
        match target.read(&mut received) {
            ok(count) => {
                core.assert_eq(count, 0usize)
            }
            err(error) => {
                core.assert(error == hal.Error.Overrun)
                lost_count += 1
            }
        }
    }
    core.assert_eq(target.read(&mut received)!, 0usize)
    model = target.release()
    model.sent_count = 0
    model.cr1 = 0
    target = spi_target_bus(model)

    // 10-bit words, and the output turned off for a listening target.
    target.set_frame_bits(10)!
    target.set_output(false)
    expect_error(target.transfer(&mut received), hal.Error.Unsupported)
    model = target.release()
    core.assert(model.cr0 == 0xC9 && (model.cr1_written & 8) != 0)
    words: [2]u16 = [0x3FF, 0x155]
    model.reply_with_words(&words)
    model.cr1 = 0
    target = spi_target_bus(model)
    target.set_frame_bits(10)!
    out: [2]u16 = [0x2AA, 0x001]
    core.assert_eq(target.queue_words(&out), 2usize)
    back: [2]u16 = [0, 0]
    count = 0
    for count < 2 {
        count += target.read_words(&mut back[count..])!
    }
    core.assert(back[0] == 0x3FF && back[1] == 0x155)
    model = target.release()
    expect_words(&mut model, &out)

    // A master that clocks with nothing queued gets the last frame again.
    model.underruns = 0
    model.reply_with(&command)
    target = spi_target_bus(model)
    one: [1]u8 = [0x42]
    core.assert_eq(target.queue(&one)!, 1usize)
    count = 0
    for count < 3 {
        count += target.read(&mut received[count..])!
    }
    model = target.release()
    core.assert_eq(model.underruns, 2u32)
    repeated: [3]u8 = [0x42, 0x42, 0x42]
    model.expect_sent(&repeated)
}

// --- A PL011 and the line it drives ---------------------------------------

const UART_FIFO: usize = 32
// DR's error bits, as a received entry carries them.
const FRAMING: u32 = 1 << 8
const OVERRUN_BIT: u32 = 1 << 11
const BREAK_BITS: u32 = (1 << 10) | (1 << 8)
// While set, the line is stalled: the transmitter sends nothing.
static mut UART_STALLED: bool = false

struct UartModel {
    cr: u32
    lcr_h: u32
    // IBRD and FBRD as written, and as the last LCR_H write latched them.
    ibrd: u32
    fbrd: u32
    integer: u32
    fraction: u32
    interrupt_mask: u32
    levels: u32
    cleared: u32
    tx: [32]u8
    tx_count: usize
    // The frame in the transmit shift register.
    shifting: bool
    shift_value: u8
    // Received entries, data and error bits, as DR returns them.
    rx: [32]u32
    rx_count: usize
    // RSR's overrun flag: an arrival found the receive FIFO full.
    overrun: bool
    // Frames that went out on the line.
    sent: [160]u8
    sent_count: usize
    // Send one frame every `period` status reads.
    period: u32
    reads: u32
    tx_overflow: bool
    breaks: u32

    fn new(period: u32) -> UartModel {
        return UartModel {
            cr: 0x300,
            lcr_h: 0,
            ibrd: 0,
            fbrd: 0,
            integer: 0,
            fraction: 0,
            interrupt_mask: 0x7FF,
            levels: 0x12,
            cleared: 0,
            tx: [0; 32],
            tx_count: 0,
            shifting: false,
            shift_value: 0,
            rx: [0; 32],
            rx_count: 0,
            overrun: false,
            sent: [0; 160],
            sent_count: 0,
            period,
            reads: 0,
            tx_overflow: false,
            breaks: 0,
        }
    }

    fn enabled(&self) -> bool {
        return (self.cr & 1) != 0
    }

    // An entry arrives in the receive FIFO, or is lost if it is full.
    fn arrive(&mut self, entry: u32) {
        if self.rx_count == UART_FIFO {
            self.overrun = true
        } else {
            self.rx[self.rx_count] = entry
            self.rx_count += 1
        }
    }

    fn arrive_bytes(&mut self, bytes: &[u8]) {
        for index in 0..bytes.len {
            self.arrive(bytes[index] as u32)
        }
    }

    // Finish the frame in the shift register, then load the next one.
    fn shift(&mut self) {
        if self.shifting {
            if (self.cr & (1 << 7)) != 0 {
                entry := self.shift_value as u32
                self.arrive(entry)
            } else {
                core.assert(self.sent_count < 160)
                self.sent[self.sent_count] = self.shift_value
                self.sent_count += 1
            }
            self.shifting = false
        }
        if self.tx_count > 0 && self.enabled() {
            self.shift_value = self.tx[0]
            for index in 1..self.tx_count {
                self.tx[index - 1] = self.tx[index]
            }
            self.tx_count -= 1
            self.shifting = true
        }
    }

    pub fn read(&mut self, offset: usize) -> u32 {
        if offset == 0x000 {
            core.assert(self.rx_count > 0)
            entry := self.rx[0]
            for index in 1..self.rx_count {
                self.rx[index - 1] = self.rx[index]
            }
            self.rx_count -= 1
            return entry
        } else if offset == 0x018 {
            self.reads += 1
            stalled := unsafe {
                UART_STALLED
            }
            if !stalled && self.reads % self.period == 0 {
                self.shift()
            }
            status := 0u32
            if self.tx_count > 0 || self.shifting {
                status |= 1 << 3
            }
            if self.rx_count == 0 {
                status |= 1 << 4
            }
            if self.tx_count == UART_FIFO {
                status |= 1 << 5
            }
            if self.rx_count == UART_FIFO {
                status |= 1 << 6
            }
            if self.tx_count == 0 {
                status |= 1 << 7
            }
            return status
        } else if offset == 0x004 {
            if self.overrun {
                return 1 << 3
            }
            return 0
        } else if offset == 0x02C {
            return self.lcr_h
        } else if offset == 0x030 {
            return self.cr
        } else if offset == 0x038 {
            return self.interrupt_mask
        } else if offset == 0x040 {
            // Receive at 3/4 full, the timeout for anything waiting, and
            // transmit at half empty.
            raw := 0u32
            if self.rx_count >= 24 {
                raw |= 1 << 4
            }
            if self.tx_count <= 16 {
                raw |= 1 << 5
            }
            if self.rx_count > 0 {
                raw |= 1 << 6
            }
            if self.overrun {
                raw |= 1 << 10
            }
            return raw & self.interrupt_mask
        }
        core.assert(false)
        return 0
    }

    pub fn write(&mut self, offset: usize, value: u32) {
        if offset == 0x000 {
            core.assert(self.enabled() && (self.cr & (1 << 8)) != 0)
            if self.tx_count == UART_FIFO {
                self.tx_overflow = true
            } else {
                self.tx[self.tx_count] = value as u8
                self.tx_count += 1
            }
        } else if offset == 0x004 {
            core.assert_eq(value, 0u32)
            self.overrun = false
        } else if offset == 0x030 {
            // Disabled only between frames, with nothing left to send.
            if self.enabled() && (value & 1) == 0 {
                core.assert(self.tx_count == 0 && !self.shifting)
            }
            // No IrDA.
            core.assert_eq(value & 0x6, 0u32)
            // Flow control changes only while disabled.
            if self.enabled() && (value & 1) != 0 {
                core.assert_eq(value & 0xC000, self.cr & 0xC000)
            }
            self.cr = value
        } else if offset == 0x038 {
            self.interrupt_mask = value
        } else if offset == 0x034 {
            core.assert(!self.enabled())
            self.levels = value
        } else if offset == 0x048 {
            // No DMA requests.
            core.assert_eq(value, 0u32)
        } else if offset == 0x044 {
            self.cleared |= value
        } else if offset == 0x02C && self.enabled() {
            // Running, only a break starts or ends, between frames.
            core.assert_eq(value & ~1u32, self.lcr_h & ~1u32)
            core.assert(self.tx_count == 0 && !self.shifting)
            if (self.lcr_h & 1) != 0 && (value & 1) == 0 && (self.cr & (1 << 7)) != 0 {
                // In loopback the receiver saw the line held low.
                self.arrive(BREAK_BITS)
            }
            if (value & 1) != 0 {
                self.breaks += 1
            }
            self.lcr_h = value
        } else {
            // The divisors and format change only while disabled.
            core.assert(!self.enabled())
            if offset == 0x024 {
                self.ibrd = value
            } else if offset == 0x028 {
                self.fbrd = value
            } else if offset == 0x02C {
                self.lcr_h = value
                self.integer = self.ibrd
                self.fraction = self.fbrd
            } else {
                core.assert(false)
            }
        }
    }

    fn expect_sent(&mut self, bytes: &[u8]) {
        core.assert_eq(self.sent_count, bytes.len)
        for index in 0..bytes.len {
            core.assert_eq(self.sent[index], bytes[index])
        }
        self.sent_count = 0
        core.assert(!self.tx_overflow)
    }
}

fn expect_uart_invalid(result: pl011.Divisors!hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
}

fn uart_divisors() {
    // The Pico SDK's divisor for 115200 baud at 125 MHz: 67 + 52/64.
    usual := pl011.divisors(CLOCK_HZ, 115_200)!
    core.assert_eq(usual.integer, 67u32)
    core.assert_eq(usual.fraction, 52u32)
    core.assert_eq(usual.baud, 115_207u32)
    rp2350 := pl011.divisors(150_000_000, 115_200)!
    core.assert_eq(rp2350.integer, 81u32)
    core.assert_eq(rp2350.fraction, 24u32)
    // The fastest rate, a divisor of exactly one, and the slowest.
    fastest := pl011.divisors(CLOCK_HZ, 7_812_500)!
    core.assert(fastest.integer == 1 && fastest.fraction == 0 && fastest.baud == 7_812_500)
    slowest := pl011.divisors(CLOCK_HZ, 120)!
    core.assert(slowest.integer <= 65_535 && slowest.baud == 120)
    expect_uart_invalid(pl011.divisors(CLOCK_HZ, 7_900_000))
    expect_uart_invalid(pl011.divisors(CLOCK_HZ, 119))
    expect_uart_invalid(pl011.divisors(CLOCK_HZ, 0))
    // Rounding carries from the fraction into the integer part, the
    // arithmetic stays wide for any clock, and the divisor's range ends at
    // exactly 1 and 65535.
    carry := pl011.divisors(16_383, 512)!
    core.assert(carry.integer == 2 && carry.fraction == 0)
    widest := pl011.divisors(0xFFFF_FFFF, 115_200)!
    core.assert(widest.integer > 0 && widest.integer <= 65_535)
    top := pl011.divisors(1_048_560, 1)!
    core.assert(top.integer == 65_535 && top.fraction == 0)
    unit := pl011.divisors(16, 1)!
    core.assert(unit.integer == 1 && unit.fraction == 0)
    expect_uart_invalid(pl011.divisors(1_048_561, 1))
    expect_uart_invalid(pl011.divisors(CLOCK_HZ, 1))
    expect_uart_invalid(pl011.divisors(CLOCK_HZ, 0xFFFF_FFFF))
    expect_uart_invalid(pl011.divisors(0, 115_200))
    // The usual rates come within 0.1 %, and the rate reported is the one
    // the divisor makes.
    rates: [12]u32 = [300, 1200, 2400, 9600, 19_200, 38_400, 57_600, 115_200, 230_400, 460_800, 921_600, 1_000_000]
    clocks: [2]u32 = [CLOCK_HZ, 150_000_000]
    for clock_index in 0..2usize {
        clock := clocks[clock_index]
        for index in 0..12usize {
            rate := rates[index]
            result := pl011.divisors(clock, rate)!
            core.assert(result.fraction < 64 && result.integer >= 1)
            scaled := (64 * result.integer + result.fraction) as u64
            exact := 4 * clock as u64
            core.assert(result.baud as u64 * scaled <= exact + scaled && result.baud as u64 * scaled + scaled >= exact)
            difference := result.baud as u64 * 1000
            core.assert(difference <= rate as u64 * 1001 && difference >= rate as u64 * 999)
        }
    }
}

fn uart_port(model: UartModel) -> pl011.Controller<UartModel> {
    return pl011.Controller.new(model, pl011.divisors(CLOCK_HZ, 115_200)!)
}

// Interrupt sources: listened-to ones show as pending, receive interrupts end
// when reads drain the FIFO, and release masks everything.
fn uart_interrupts() {
    port := uart_port(UartModel.new(1))
    core.assert_eq(port.pending_interrupts(), 0u32)
    port.listen(pl011.RX_INTERRUPT | pl011.RX_TIMEOUT_INTERRUPT)
    port.listen(pl011.ERROR_INTERRUPTS)
    port.ignore(pl011.ERROR_INTERRUPTS)
    // Nothing received: the transmit source is raw but not listened to.
    core.assert_eq(port.pending_interrupts(), 0u32)
    model := port.release()
    core.assert_eq(model.interrupt_mask, 0u32)
    model.cr = 0
    port = uart_port(model)
    port.listen(pl011.RX_TIMEOUT_INTERRUPT | pl011.TX_INTERRUPT | 0xF000)
    port.write(b"hi")!
    port.flush()!
    port.clear_interrupts(pl011.TX_INTERRUPT)
    model = port.release()
    core.assert((model.cleared & pl011.TX_INTERRUPT) != 0)
    model.cr = 0
    model.arrive_bytes(b"ping")
    port = uart_port(model)
    port.listen(pl011.RX_INTERRUPT | pl011.RX_TIMEOUT_INTERRUPT)
    core.assert_eq(port.pending_interrupts(), pl011.RX_TIMEOUT_INTERRUPT)
    buffer := [0u8; 8]
    count := port.read(&mut buffer)!
    core.assert_eq(count, 4usize)
    core.assert_eq(port.pending_interrupts(), 0u32)
    port.release()
}

fn uart_configuration() {
    // 8N1 with FIFOs, the divisor latched by LCR_H, no interrupts, and the
    // transmitter and receiver on.
    port := uart_port(UartModel.new(1))
    core.assert_eq(port.baud(), 115_207u32)
    model := port.release()
    core.assert(model.integer == 67 && model.fraction == 52)
    core.assert_eq(model.lcr_h, 0x70u32)
    core.assert(model.interrupt_mask == 0 && model.cleared == 0x7FF)
    core.assert_eq(model.cr, 0u32)

    model.cr = 0
    port = uart_port(model)
    model = port.release()
    port = uart_port(model)
    port.set_format(8, pl011.Parity.Even, 1)!
    port.set_format(7, pl011.Parity.Odd, 2)!
    expect_error_io(port.set_format(9, pl011.Parity.None, 1))
    expect_error_io(port.set_format(8, pl011.Parity.None, 3))
    // Waits for queued bytes before it changes the rate.
    port.write(b"slow down")!
    port.set_baud(9600)!
    core.assert_eq(port.baud(), 9600u32)
    expect_error_io(port.set_baud(10_000_000))
    core.assert_eq(port.baud(), 9600u32)
    model = port.release()
    model.expect_sent(b"slow down")
    core.assert_eq(model.lcr_h, 0x5Au32)
    core.assert(model.integer == 813 && model.fraction == 51)
}

fn expect_error_io(result: void!hal.Error) {
    expect_error(result, hal.Error.InvalidInput)
}

fn uart_writes() {
    // Frames leave slower than the driver queues them, so the transmit FIFO
    // fills and the driver waits; nothing is ever lost.
    port := uart_port(UartModel.new(3))
    text: [100]u8 = [0; 100]
    for index in 0..100usize {
        text[index] = (32 + index) as u8
    }
    core.assert_eq(port.write(&text)!, 100usize)
    port.flush()!
    model := port.release()
    model.expect_sent(&text)

    // hal.SerialPoll: poll_flush reports output still going out, then true
    // once the last stop bit has left, as flush waits for.
    port = uart_port(model)
    core.assert(port.poll_flush()!)
    port.write(b"abc")!
    flushes := 0u32
    for !port.poll_flush()! {
        flushes += 1
    }
    core.assert(flushes > 0)
    model = port.release()
    model.expect_sent(b"abc")

    // std/fmt prints to a port, and with crlf every newline goes out as
    // CR LF while the count is still of the bytes written.
    port = uart_port(model)
    fmt.printf(&mut port, "t={} ok\n", 25)!
    port.set_crlf(true)
    written := fmt.printf(&mut port, "a\nb\n")!
    core.assert_eq(written, 4usize)
    model = port.release()
    model.expect_sent(b"t=25 ok\na\r\nb\r\n")

    // A polled write queues what fits and stops when the FIFO is full; a
    // newline whose LF no longer fits after its CR is not counted yet, and
    // the next write, once the line moves again, sends only the LF.
    model.period = 1
    port = uart_port(model)
    port.set_crlf(true)
    long: [40]u8 = [0; 40]
    for index in 0..40usize {
        long[index] = 65
    }
    long[31] = 10
    unsafe {
        UART_STALLED = true
    }
    first := port.poll_write(&long)!
    core.assert(first.transferred == 31 && first.state == io.PollState.Pending)
    unsafe {
        UART_STALLED = false
    }
    rest := port.poll_write(&long[31..])!
    core.assert(rest.transferred == 9 && rest.state == io.PollState.Ready)
    model = port.release()
    expected: [41]u8 = [65; 41]
    expected[31] = 13
    expected[32] = 10
    model.expect_sent(&expected)
}

fn uart_reads() {
    model := UartModel.new(1)
    port := uart_port(model)
    buffer: [8]u8 = [0; 8]
    // Nothing has arrived: a polled read is Pending.
    empty := port.poll_read(&mut buffer)!
    core.assert(empty.transferred == 0 && empty.state == io.PollState.Pending)
    model = port.release()

    // A read returns what has arrived, up to the buffer.
    model.arrive_bytes(b"hello, world")
    port = uart_port(model)
    core.assert_eq(port.read(&mut buffer)!, 8usize)
    core.assert_eq(buffer[7], 119u8)
    core.assert_eq(port.read(&mut buffer)!, 4usize)
    core.assert_eq(buffer[3], 100u8)
    model = port.release()

    // With crlf, Enter (CR, or CR LF) reads as one LF, so io.read_line
    // ends there; a lone LF stays.
    model.arrive_bytes(b"ab\r\ncd\re\nf")
    port = uart_port(model)
    port.set_crlf(true)
    line: [16]u8 = [0; 16]
    first := io.read_line(&mut port, &mut line)!
    core.assert(first.count == 3 && line[2] == 10)
    rest: [16]u8 = [0; 16]
    progress := port.poll_read(&mut rest)!
    core.assert_eq(progress.transferred, 6usize)
    core.assert(rest[0] == 99 && rest[2] == 10 && rest[3] == 101 && rest[4] == 10 && rest[5] == 102)
    model = port.release()

    // A byte with a framing error is dropped and reported after the good
    // bytes before it; the next read goes on after it.
    model.arrive(120)
    model.arrive(FRAMING | 121)
    model.arrive(122)
    port = uart_port(model)
    match port.read(&mut buffer) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error.kind == io.ErrorKind.Other && error.code == pl011.FRAMING_ERROR)
            core.assert(error.transferred == 1 && buffer[0] == 120)
        }
    }
    core.assert_eq(port.read(&mut buffer)!, 1usize)
    core.assert_eq(buffer[0], 122u8)
    model = port.release()

    // Bytes that arrive while the receive FIFO is full are lost; the next
    // read returns what the FIFO holds and then reports the overrun, once.
    port = uart_port(model)
    port.set_loopback(true)!
    full: [40]u8 = [0; 40]
    for index in 0..40usize {
        full[index] = index as u8
    }
    port.write(&full)!
    port.flush()!
    match port.read(&mut full) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error.code == pl011.OVERRUN && error.transferred == UART_FIFO)
            core.assert(full[0] == 0 && full[31] == 31)
        }
    }
    after := port.poll_read(&mut full)!
    core.assert(after.transferred == 0 && after.state == io.PollState.Pending)
    port.set_loopback(false)!
    model = port.release()

    // An overrun flagged on a byte keeps that byte; a break is dropped.
    model.arrive(112)
    model.arrive(OVERRUN_BIT | 113)
    model.arrive(BREAK_BITS)
    model.arrive(114)
    port = uart_port(model)
    match port.read(&mut buffer) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error.code == pl011.OVERRUN && error.transferred == 2 && buffer[1] == 113)
        }
    }
    match port.read(&mut buffer) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error.code == (pl011.BREAK | pl011.FRAMING_ERROR) && error.transferred == 0)
        }
    }
    core.assert_eq(port.read(&mut buffer)!, 1usize)
    core.assert_eq(buffer[0], 114u8)

    // Loopback reads back what was written, and nothing reaches the line.
    port.set_loopback(true)!
    port.write(b"loop")!
    port.flush()!
    core.assert_eq(io.read_exact(&mut port, &mut buffer[..4])!, 4usize)
    core.assert(buffer[0] == 108 && buffer[3] == 112)
    port.set_loopback(false)!
    model = port.release()
    model.expect_sent(b"")
    core.assert_eq(model.cr & (1 << 7), 0u32)
}

fn uart_flow_and_break() {
    // Flow control waits for what is queued, then changes while disabled.
    port := uart_port(UartModel.new(2))
    port.write(b"wait")!
    port.set_flow_control(true, true)!
    model := port.release()
    model.expect_sent(b"wait")
    core.assert_eq(model.levels, 0x1Au32)
    port = uart_port(model)
    port.set_flow_control(true, false)!
    port.set_flow_control(false, false)!
    model = port.release()

    // A break waits for what is queued, then holds the line until it is
    // ended; in loopback the receiver reports it.
    port = uart_port(model)
    port.write(b"brk")!
    port.set_break(true)!
    port.set_break(false)!
    port.set_loopback(true)!
    port.set_break(true)!
    port.set_break(false)!
    buffer: [4]u8 = [0; 4]
    match port.read(&mut buffer) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error.code == (pl011.BREAK | pl011.FRAMING_ERROR) && error.transferred == 0)
        }
    }
    port.set_loopback(false)!
    // The format survives a break.
    port.set_format(7, pl011.Parity.Even, 1)!
    port.set_break(true)!
    port.set_break(false)!
    model = port.release()
    model.expect_sent(b"brk")
    core.assert(model.breaks == 3 && model.lcr_h == 0x56)
}

fn expect_timed_out(result: usize!io.Error, transferred: usize) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error.kind == io.ErrorKind.TimedOut && error.transferred == transferred)
        }
    }
}

fn uart_poll_limits() {
    // A transmitter that never moves, as one held up by CTS: writes give up
    // after the poll limit with what was queued, flush and the settings
    // that wait for output give up too, and nothing changes.
    port := uart_port(UartModel.new(1))
    port.set_poll_limit(4)
    unsafe {
        UART_STALLED = true
    }
    long: [40]u8 = [7; 40]
    expect_timed_out(port.write(&long), UART_FIFO)
    match port.flush() {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error.kind == io.ErrorKind.TimedOut && error.transferred == 0)
        }
    }
    expect_error(port.set_baud(9600), hal.Error.Timeout)
    expect_error(port.set_format(7, pl011.Parity.Even, 1), hal.Error.Timeout)
    expect_error(port.set_break(true), hal.Error.Timeout)
    expect_error(port.set_flow_control(true, true), hal.Error.Timeout)
    core.assert_eq(port.baud(), 115_207u32)
    unsafe {
        UART_STALLED = false
    }
    port.flush()!
    model := port.release()
    model.expect_sent(&long[..UART_FIFO])
    core.assert(model.lcr_h == 0x70 && model.breaks == 0)

    // Reads wait for their first byte as long as it takes, unless bounded.
    port = uart_port(model)
    port.set_read_poll_limit(3)
    buffer: [4]u8 = [0; 4]
    expect_timed_out(port.read(&mut buffer), 0)
    model = port.release()
    model.arrive_bytes(b"hi")
    port = uart_port(model)
    port.set_read_poll_limit(3)
    core.assert_eq(port.read(&mut buffer)!, 2usize)
    port.release()
}

// The panic report as the default panic hook writes it, from the strings
// the compiler passes; a path longer than the reporter's chunks.
fn uart_panic_report() {
    port := uart_port(UartModel.new(2))
    model := port.release()
    // As its owner left it: enabled, with the transmitter on.
    model.cr = 0x301
    check: [9]u8 = [111, 118, 101, 114, 102, 108, 111, 119, 0]
    file: [48]u8 = [0; 48]
    for index in 0..47usize {
        file[index] = (97 + index % 26) as u8
    }
    unsafe {
        rp_pins.write_failure(&mut model, ptr.as_ptr(&check), ptr.as_ptr(&file), 1234, 7)
    }
    // Everything is out before it returns.
    core.assert(model.tx_count == 0 && !model.shifting)
    model.expect_sent(b"\r\ndodo: overflow check failed at abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstu:1234:7\r\n")
    // A disabled transmitter sends nothing, instead of waiting forever.
    model.cr = 0
    unsafe {
        rp_pins.write_failure(&mut model, ptr.as_ptr(&check), ptr.as_ptr(&file), 1, 1)
    }
    model.expect_sent(b"")
}

fn expect_invalid<T>(result: T!hal.Error) {
    match result {
        ok(controller) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
}

fn expect_invalid_spi(result: rp_pins.SpiPins!hal.Error) {
    match result {
        ok(pins) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
}

fn expect_invalid_uart(result: rp_pins.UartPins!hal.Error) {
    match result {
        ok(pins) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
}

// The receive pin, or PIN_COUNT for none.
fn rx_pin(pins: rp_pins.SpiPins) -> u32 {
    let rp_pins.SpiPins { controller, rx, mask } = pins
    return option.unwrap_or(rx, rp_pins.PIN_COUNT)
}

fn rp_pin_assignments() {
    // I2C pairs repeat every four pins, alternating between the controllers.
    core.assert_eq(rp_pins.i2c_controller(0, 1)!, 0u32)
    core.assert_eq(rp_pins.i2c_controller(2, 3)!, 1u32)
    core.assert_eq(rp_pins.i2c_controller(4, 5)!, 0u32)
    core.assert_eq(rp_pins.i2c_controller(26, 27)!, 1u32)
    // SDA and SCL of the same controller need not be neighbours.
    core.assert_eq(rp_pins.i2c_controller(8, 1)!, 0u32)
    expect_invalid(rp_pins.i2c_controller(5, 4))
    expect_invalid(rp_pins.i2c_controller(0, 3))
    expect_invalid(rp_pins.i2c_controller(28, 31))

    // SPI pins come in blocks of eight, SPI0 then SPI1, with SPI1 again
    // from GPIO 24.
    pins := rp_pins.spi_pins(18, 19, some(16u32))!
    core.assert_eq(pins.controller, 0u32)
    core.assert_eq(pins.mask, 0xD_0000u32)
    core.assert_eq(rx_pin(pins), 16u32)
    pins = rp_pins.spi_pins(10, 11, some(12u32))!
    core.assert_eq(pins.controller, 1u32)
    pins = rp_pins.spi_pins(26, 27, none)!
    core.assert_eq(pins.controller, 1u32)
    core.assert_eq(pins.mask, 0xC00_0000u32)
    core.assert_eq(rx_pin(pins), rp_pins.PIN_COUNT)
    pins = rp_pins.spi_pins(2, 7, some(20u32))!
    core.assert_eq(pins.controller, 0u32)
    expect_invalid_spi(rp_pins.spi_pins(19, 18, none))
    expect_invalid_spi(rp_pins.spi_pins(18, 11, none))
    expect_invalid_spi(rp_pins.spi_pins(18, 19, some(17u32)))
    expect_invalid_spi(rp_pins.spi_pins(18, 19, some(8u32)))
    expect_invalid_spi(rp_pins.spi_pins(30, 31, none))

    // UART pins come in groups of four, TX first and RX second: UART0,
    // UART1 twice, UART0 twice, UART1 twice, and UART0 on GPIO 28 and 29.
    uart := rp_pins.uart_pins(0, some(1u32))!
    core.assert(uart.controller == 0 && uart.mask == 0x3)
    uart = rp_pins.uart_pins(4, some(9u32))!
    core.assert(uart.controller == 1 && uart.mask == 0x210)
    uart = rp_pins.uart_pins(12, some(17u32))!
    core.assert(uart.controller == 0 && uart.mask == 0x2_1000)
    uart = rp_pins.uart_pins(24, none)!
    core.assert(uart.controller == 1 && uart.mask == 0x100_0000)
    uart = rp_pins.uart_pins(28, some(29u32))!
    core.assert_eq(uart.controller, 0u32)
    expect_invalid_uart(rp_pins.uart_pins(1, some(0u32)))
    expect_invalid_uart(rp_pins.uart_pins(0, some(5u32)))
    expect_invalid_uart(rp_pins.uart_pins(20, some(17u32)))
    expect_invalid_uart(rp_pins.uart_pins(0, some(2u32)))
    expect_invalid_uart(rp_pins.uart_pins(2, none))
    expect_invalid_uart(rp_pins.uart_pins(32, none))
    expect_invalid_uart(rp_pins.uart_pins(28, some(33u32)))

    // Flow control pins: CTS third and RTS fourth in the group, on the
    // same UART, which need not be the TX and RX pins' group.
    flow := rp_pins.uart_flow_pins(0, 1, 2, 3)!
    core.assert(flow.controller == 0 && flow.mask == 0xF)
    flow = rp_pins.uart_flow_pins(4, 5, 26, 27)!
    core.assert(flow.controller == 1 && flow.mask == 0xC00_0030)
    flow = rp_pins.uart_flow_pins(12, 13, 18, 19)!
    core.assert_eq(flow.controller, 0u32)
    expect_invalid_uart(rp_pins.uart_flow_pins(0, 1, 3, 2))
    expect_invalid_uart(rp_pins.uart_flow_pins(0, 1, 6, 7))
    expect_invalid_uart(rp_pins.uart_flow_pins(4, 5, 2, 7))
    expect_invalid_uart(rp_pins.uart_flow_pins(0, 2, 2, 3))

    // On the RP2350, TX and RX also on the third and fourth pins.
    aux := rp_pins.uart_aux_pins(2, some(3u32))!
    core.assert(aux.controller == 0 && aux.mask == 0xC && aux.aux == 0xC)
    aux = rp_pins.uart_aux_pins(26, some(9u32))!
    core.assert(aux.controller == 1 && aux.mask == 0x400_0200 && aux.aux == 0x400_0000)
    aux = rp_pins.uart_aux_pins(0, some(1u32))!
    core.assert_eq(aux.aux, 0u32)
    expect_invalid_uart(rp_pins.uart_aux_pins(1, none))
    expect_invalid_uart(rp_pins.uart_aux_pins(2, some(2u32)))
    expect_invalid_uart(rp_pins.uart_aux_pins(2, some(7u32)))
    expect_invalid_uart(rp_pins.uart_pins(2, some(3u32)))

    // SPI chip selects: the second pin of each group of four, in the
    // controller's blocks.
    core.assert_eq(rp_pins.spi_select_pin(0, 17)!, 1u32 << 17)
    core.assert_eq(rp_pins.spi_select_pin(1, 29)!, 1u32 << 29)
    core.assert_eq(rp_pins.spi_select_pin(0, 1)!, 2u32)
    expect_invalid(rp_pins.spi_select_pin(0, 9))
    expect_invalid(rp_pins.spi_select_pin(1, 16))
    expect_invalid(rp_pins.spi_select_pin(0, 33))
}

// --- The RP PWM block ------------------------------------------------------

// Eight slices' registers, with the block's XOR, set, and clear aliases.
// Every Channel reaches the one block through its own PwmView, as on the
// chip, where each holds a register block at the same base. Registers are
// stored by word, slice * 5 + offset / 4: CSR, DIV, CTR, CC, and TOP.
const PWM_WORDS: usize = 40
static mut PWM_REGISTERS: [40]u32 = [0u32; 40]
// Writes through the plain address of a compare register, which would
// overwrite the other output's half.
static mut PLAIN_COMPARE_WRITES: u32 = 0

struct PwmView: hal.Registers {
    pub fn read(&mut self, offset: usize) -> u32 {
        core.assert(offset < 0x1000 && offset % 4 == 0)
        word := offset / 4
        unsafe {
            value := PWM_REGISTERS[word]
            // The counter advances between reads while the slice runs.
            if word % 5 == 2 && (PWM_REGISTERS[word - 2] & 1) != 0 {
                PWM_REGISTERS[word] = (value + 1) % (PWM_REGISTERS[word + 2] + 1)
            }
            return value
        }
    }

    pub fn write(&mut self, offset: usize, value: u32) {
        alias := offset & 0x3000
        word := (offset & 0xFFF) / 4
        core.assert(word < PWM_WORDS)
        unsafe {
            current := PWM_REGISTERS[word]
            if word % 5 == 3 && alias == 0 {
                PLAIN_COMPARE_WRITES += 1
            }
            if alias == 0 {
                current = value
            } else if alias == 0x1000 {
                current ^= value
            } else if alias == 0x2000 {
                current |= value
            } else {
                current &= ~value
            }
            // CSR has 8 bits, DIV 12, the counter and TOP 16.
            register := word % 5
            if register == 0 {
                current &= 0xFF
            } else if register == 1 {
                current &= 0xFFF
            } else if register == 2 || register == 4 {
                current &= 0xFFFF
            }
            PWM_REGISTERS[word] = current
        }
    }
}

struct PwmSlice {
    csr: u32
    div: u32
    cc: u32
    top: u32
}

fn pwm_csr(slice: usize) -> u32 {
    unsafe {
        return PWM_REGISTERS[5 * slice]
    }
}

fn pwm_div(slice: usize) -> u32 {
    unsafe {
        return PWM_REGISTERS[5 * slice + 1]
    }
}

fn pwm_cc(slice: usize) -> u32 {
    unsafe {
        return PWM_REGISTERS[5 * slice + 3]
    }
}

fn pwm_top(slice: usize) -> u32 {
    unsafe {
        return PWM_REGISTERS[5 * slice + 4]
    }
}

fn pwm_slice(slice: usize) -> PwmSlice {
    unsafe {
        return PwmSlice { csr: PWM_REGISTERS[5 * slice], div: PWM_REGISTERS[5 * slice + 1], cc: PWM_REGISTERS[5 * slice + 3], top: PWM_REGISTERS[5 * slice + 4] }
    }
}

fn expect_pwm_error(result: rp_pwm.Channel<PwmView>!hal.Error, expected: hal.Error) {
    match result {
        ok(channel) => {
            channel.release()
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

fn pwm_timing() {
    // The smallest divider that fits a period in 65535 counts.
    timing := rp_pwm.timing(CLOCK_HZ, 1000)!
    core.assert(timing.divider == 31 && timing.top == 64515 && timing.frequency_hz() == 1000)
    servo := rp_pwm.timing(CLOCK_HZ, 50)!
    core.assert(servo.divider == 611 && servo.top == 65465 && servo.frequency_hz() == 50)
    // A period is at most MAX_TOP + 1 counts, so full duty still fits.
    slow := rp_pwm.timing(CLOCK_HZ, 1907)!
    core.assert(slow.divider == 17 && slow.top <= rp_pwm.MAX_TOP)
    exact := rp_pwm.timing(1_000_000, 10)!
    core.assert(exact.divider == 25 && exact.top == 63999 && exact.frequency_hz() == 10)
    // The range: clk_sys / 2 at the top, 8 Hz at the bottom.
    fastest := rp_pwm.timing(CLOCK_HZ, 62_500_000)!
    core.assert(fastest.divider == 16 && fastest.top == 1)
    slowest := rp_pwm.timing(CLOCK_HZ, 8)!
    core.assert(slowest.divider == 3815 && slowest.frequency_hz() == 8)
    expect_invalid(rp_pwm.timing(CLOCK_HZ, 100_000_000))
    expect_invalid(rp_pwm.timing(CLOCK_HZ, 7))
    expect_invalid(rp_pwm.timing(CLOCK_HZ, 0))
    // Given dividers and tops are only checked.
    given := rp_pwm.divided(CLOCK_HZ, 16 * 125, 999)!
    core.assert_eq(given.frequency_hz(), 1000u32)
    expect_invalid(rp_pwm.divided(CLOCK_HZ, 15, 999))
    expect_invalid(rp_pwm.divided(CLOCK_HZ, 4096, 999))
    expect_invalid(rp_pwm.divided(CLOCK_HZ, 16, 0xFFFF))
    // GPIO n is output n % 2 of slice (n / 2) % 8.
    core.assert(rp_pwm.slice_of(0) == 0 && rp_pwm.output_of(0) == 0)
    core.assert(rp_pwm.slice_of(15) == 7 && rp_pwm.output_of(15) == 1)
    core.assert(rp_pwm.slice_of(16) == 0 && rp_pwm.slice_of(29) == 6)
}

fn pwm_channels() {
    timing := rp_pwm.timing(CLOCK_HZ, 1000)!
    // Output A of slice 2 starts the slice: low, at the timing.
    a := unsafe {
        rp_pwm.Channel.new(PwmView {}, 4, rp_pwm.timing(CLOCK_HZ, 1000)!)!
    }
    state := pwm_slice(2)
    core.assert(state.csr == 1 && state.div == 31 && state.top == 64515 && state.cc == 0)
    core.assert(a.slice() == 2 && a.output() == 0 && a.pin() == 4)
    core.assert(a.max_duty() == 64516 && a.frequency_hz() == 1000)

    // Each output writes only its half of the compare register.
    a.set_duty(1000)!
    b := unsafe {
        rp_pwm.Channel.new(PwmView {}, 5, rp_pwm.timing(CLOCK_HZ, 1000)!)!
    }
    b.set_duty(64516)!
    core.assert_eq(pwm_cc(2), (64516u32 << 16) | 1000)
    a.set_duty(0)!
    core.assert_eq(pwm_cc(2), 64516u32 << 16)
    a.set_duty(32258)!
    core.assert(a.duty() == 32258 && b.duty() == 64516)
    core.assert_eq(pwm_cc(2), (64516u32 << 16) | 32258)
    unsafe {
        core.assert_eq(PLAIN_COMPARE_WRITES, 1u32)
    }
    expect_error(a.set_duty(64517), hal.Error.InvalidInput)
    core.assert_eq(a.duty(), 32258u16)
    hal.set_duty_percent(&mut b, 25)!
    core.assert_eq(b.duty(), 16129u16)

    // Inversion is per output.
    b.set_inverted(true)
    core.assert_eq(pwm_csr(2), 0b1001u32)
    a.set_inverted(true)
    a.set_inverted(false)
    core.assert_eq(pwm_csr(2), 0b1001u32)
    b.set_inverted(false)

    // The slice's counter runs.
    first := a.count()
    core.assert(a.count() != first)

    // The outputs share the frequency: the second output must match it, and
    // neither changes it while the other is in use.
    expect_pwm_error(unsafe {
        rp_pwm.Channel.new(PwmView {}, 5, timing)
    }, hal.Error.Busy)
    expect_error(a.set_frequency(2000), hal.Error.Busy)
    a.set_frequency(1000)!
    core.assert_eq(pwm_div(2), 31u32)
    // GPIO 20 carries the same output as GPIO 4, which is in use.
    expect_pwm_error(unsafe {
        rp_pwm.Channel.new(PwmView {}, 20, rp_pwm.timing(CLOCK_HZ, 1000)!)
    }, hal.Error.Busy)
    expect_pwm_error(unsafe {
        rp_pwm.Channel.new(PwmView {}, 30, rp_pwm.timing(CLOCK_HZ, 1000)!)
    }, hal.Error.InvalidInput)

    // Released, B holds its output low and the slice keeps running for A,
    // which may now change the frequency, keeping its duty cycle.
    b.release()
    core.assert(pwm_csr(2) == 1 && (pwm_cc(2) >> 16) == 0)
    a.set_frequency(2000)!
    core.assert(a.frequency_hz() == 2000 && a.max_duty() == 62500)
    core.assert(a.duty() == 31250 && (pwm_cc(2) & 0xFFFF) == 31250)
    a.set_timing(rp_pwm.divided(CLOCK_HZ, 16, 99)!)!
    core.assert(a.duty() == 50 && pwm_top(2) == 99 && pwm_div(2) == 16)
    // A second output may then join at that timing, and only that.
    expect_pwm_error(unsafe {
        rp_pwm.Channel.new(PwmView {}, 21, rp_pwm.timing(CLOCK_HZ, 1000)!)
    }, hal.Error.Busy)
    joined := unsafe {
        rp_pwm.Channel.new(PwmView {}, 21, rp_pwm.divided(CLOCK_HZ, 16, 99)!)!
    }
    core.assert(joined.max_duty() == 100 && joined.duty() == 0)
    core.assert_eq(pwm_cc(2), 50u32)
    joined.release()

    // The last output stops the slice.
    a.release()
    core.assert(pwm_csr(2) == 0 && pwm_cc(2) == 0)
    // Other slices were never touched.
    core.assert(pwm_csr(1) == 0 && pwm_csr(3) == 0)
    again := unsafe {
        rp_pwm.Channel.new(PwmView {}, 20, rp_pwm.timing(CLOCK_HZ, 50)!)!
    }
    core.assert(pwm_csr(2) == 1 && pwm_div(2) == 611)
    again.release()
}

// --- The RP ADC ------------------------------------------------------------

// The converter's CS and RESULT registers, with the set and clear aliases.
// A conversion takes `delay` status reads; input 4 reads the temperature
// sensor only while it is powered.
struct AdcModel: hal.Registers {
    cs: u32
    result: u32
    inputs: [5]u16
    delay: u32
    pending: u32
    conversions: u32
    // Failure injection: conversions never finish or report an error, or
    // the converter never becomes ready.
    stuck: bool
    failing: bool
    dead: bool

    fn new() -> AdcModel {
        return AdcModel { cs: 0, result: 0, inputs: [0u16; 5], delay: 3, pending: 0, conversions: 0, stuck: false, failing: false, dead: false }
    }

    pub fn read(&mut self, offset: usize) -> u32 {
        if offset == 0x04 {
            return self.result
        }
        core.assert_eq(offset, 0usize)
        if self.pending > 0 && !self.stuck {
            self.pending -= 1
            if self.pending == 0 {
                self.finish()
            }
        }
        ready := 0u32
        if (self.cs & 1) != 0 && self.pending == 0 && !self.dead {
            ready = 1 << 8
        }
        return (self.cs & ~(1u32 << 8)) | ready
    }

    pub fn write(&mut self, offset: usize, value: u32) {
        alias := offset & 0x3000
        core.assert_eq(offset & 0xFFF, 0usize)
        if alias == 0x2000 {
            self.cs |= value
        } else if alias == 0x3000 {
            self.cs &= ~value
        } else {
            core.assert_eq(alias, 0usize)
            // Selecting an input while converting corrupts the result.
            core.assert(self.pending == 0)
            // START_ONCE is a strobe; the error flag is read-only.
            self.cs = (value & ~(1u32 << 2)) | (self.cs & (1u32 << 9))
            if (value & (1u32 << 2)) != 0 {
                core.assert((self.cs & 1) != 0)
                self.pending = self.delay
                self.conversions += 1
            }
        }
    }

    fn finish(&mut self) {
        input := ((self.cs >> 12) & 0xF) as usize
        core.assert(input <= 4)
        value := self.inputs[input] as u32
        if input == 4 && (self.cs & 2) == 0 {
            value = 0
        }
        self.result = value
        if self.failing {
            self.cs |= 1 << 9
        } else {
            self.cs &= ~(1u32 << 9)
        }
    }
}

fn expect_read_error(result: u16!hal.Error, expected: hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

fn adc_inputs() {
    core.assert_eq(rp_adc.input_of(26)!, 0u32)
    core.assert_eq(rp_adc.input_of(29)!, 3u32)
    expect_invalid(rp_adc.input_of(25))
    expect_invalid(rp_adc.input_of(30))

    model := AdcModel.new()
    model.inputs = [100u16, 2048, 4095, 0, 891]
    rp_adc.start(&mut model)!
    core.assert_eq(model.cs, 1u32)
    knob := unsafe {
        rp_adc.Input.new(model, 0)
    }
    core.assert(knob.input() == 0 && knob.max_value() == 4095)
    core.assert_eq(knob.read()!, 100u16)
    core.assert_eq(hal.read_millivolts(&mut knob, 3300)!, 81u32)
    model = knob.release()
    core.assert_eq(model.conversions, 2u32)

    // Each read selects its own input first.
    full := unsafe {
        rp_adc.Input.new(model, 2)
    }
    core.assert_eq(full.read()!, 4095u16)
    model = full.release()
    core.assert_eq((model.cs >> 12) & 0xF, 2u32)

    // The temperature sensor is powered while its input is held.
    sensor := unsafe {
        rp_adc.Input.new(model, rp_adc.TEMPERATURE_INPUT)
    }
    value := sensor.read()!
    core.assert_eq(value, 891u16)
    celsius := rp_adc.millicelsius(value, 3300)
    core.assert(celsius > 19_500 && celsius < 20_500)
    model = sensor.release()
    core.assert_eq(model.cs & 2, 0u32)
    // 0.706 V is 27 C; the temperature falls as the voltage rises.
    core.assert(rp_adc.millicelsius(876, 3300) >= 27_000 && rp_adc.millicelsius(876, 3300) < 27_300)
    core.assert(rp_adc.millicelsius(1000, 3300) < rp_adc.millicelsius(900, 3300))
    core.assert(rp_adc.millicelsius(0, 3300) > 400_000)

    // A conversion that does not finish, and one that fails.
    model.stuck = true
    stuck := unsafe {
        rp_adc.Input.new(model, 1)
    }
    expect_read_error(stuck.read(), hal.Error.Timeout)
    model = stuck.release()
    model.stuck = false
    model.pending = 0
    model.failing = true
    failing := unsafe {
        rp_adc.Input.new(model, 1)
    }
    expect_read_error(failing.read(), hal.Error.Bus)
    model = failing.release()
    model.failing = false

    // A converter that never becomes ready.
    rp_adc.stop(&mut model)
    core.assert_eq(model.cs & 3, 0u32)
    model.dead = true
    match rp_adc.start(&mut model) {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }
}

// --- rp_pins.Bank over a fake chip -----------------------------------------

// What the bank asked of the chip: each pin's function and pad bits, resets
// pulsed, and controllers held in reset, one bit each.
static mut FUNCTIONS: [30]u32 = [0u32; 30]
static mut PADS: [30]u32 = [0u32; 30]
static mut RESETS: u32 = 0
static mut HELD: u32 = 0
static mut FAIL_RESET: bool = false
// The fake chip has the RP2350's UART_AUX function.
static mut UART_AUX: bool = false
// Plain memory standing in for the six controllers' register blocks: the
// drivers only configure them and disable them again, and a panic report
// leaves its last byte in a UART's data register.
static mut BLOCKS: [384]u32 = [0u32; 384]
// The PWM block and the ADC, with room for their atomic aliases, which
// plain memory does not imitate: the bank only hands out their drivers.
static mut PWM_MEMORY: [4096]u32 = [0u32; 4096]
static mut ADC_MEMORY: [4096]u32 = [0u32; 4096]
// ADC starts and stops, and whether the next start fails.
static mut ADC_STARTS: u32 = 0
static mut ADC_STOPS: u32 = 0
static mut FAIL_ADC: bool = false
// The fake chip's PIO blocks, 4096 words each, and their PIO version.
static mut PIO_MEMORY: [12288]u32 = [0u32; 12288]
static mut PIO_VERSION: u32 = 1

const SIO: u32 = 5
const UART: u32 = 2
const DISCONNECTED: u32 = 31
const PULL_DOWN: u32 = 1 << 2
const PULL_UP: u32 = 1 << 3
// The data register of each UART in BLOCKS.
const UART0_DATA: usize = 64 * 4
const UART1_DATA: usize = 64 * 5

struct FakeChip {
    pub fn route(&mut self, pin: u32, function: u32, clear: u32, set: u32) {
        unsafe {
            FUNCTIONS[pin as usize] = function
            PADS[pin as usize] = (PADS[pin as usize] & ~clear) | set
        }
    }

    pub fn reset(&mut self, controller: u32) -> void!hal.Error {
        unsafe {
            if FAIL_RESET {
                return err(hal.Error.Timeout)
            }
            RESETS += 1
            HELD &= ~(1u32 << controller)
        }
        return ok()
    }

    pub fn hold(&mut self, controller: u32) {
        unsafe {
            HELD |= 1u32 << controller
        }
    }

    pub fn base(&self, controller: u32) -> usize {
        unsafe {
            if controller >= rp_pins.PIO0 {
                return pio_base(controller - rp_pins.PIO0)
            } else if controller == rp_pins.PWM {
                return ptr.from_mut(&mut PWM_MEMORY) as usize
            } else if controller == rp_pins.ADC {
                return ptr.from_mut(&mut ADC_MEMORY) as usize
            }
            return ptr.from_mut(&mut BLOCKS) as usize + 0x100 * controller as usize
        }
    }

    pub fn start_adc(&mut self) -> void!hal.Error {
        unsafe {
            if FAIL_ADC {
                return err(hal.Error.Timeout)
            }
            ADC_STARTS += 1
        }
        return ok()
    }

    pub fn stop_adc(&mut self) {
        unsafe {
            ADC_STOPS += 1
        }
    }

    pub fn clock_hz(&self) -> u32 {
        return CLOCK_HZ
    }

    // PWM inputs are checked in pwm_capture_checks.dodo.
    pub fn pwm_slices(&self) -> u32 {
        return 8
    }

    pub fn timer_base(&self) -> usize {
        return 0
    }

    pub fn uart_aux(&self) -> bool {
        unsafe {
            return UART_AUX
        }
    }

    pub fn pio_blocks(&self) -> u32 {
        return 3
    }

    pub fn pio_version(&self) -> u32 {
        unsafe {
            return PIO_VERSION
        }
    }

    pub fn pio_irq(&self, block: u32) -> u32 {
        return 15 + 2 * block
    }
}

fn function(pin: u32) -> u32 {
    unsafe {
        return FUNCTIONS[pin as usize]
    }
}

fn expect_busy<T>(result: T!hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Busy)
        }
    }
}

fn rp_bank() {
    bank := unsafe {
        rp_pins.Bank.new(FakeChip {})
    }
    led := bank.gpio(25)!
    core.assert_eq(led, 1u32 << 25)
    core.assert_eq(function(25), SIO)
    expect_busy(bank.gpio(25))
    expect_invalid(bank.gpio(30))

    // A bus takes its controller out of reset and its pins.
    i2c := bank.i2c(4, 5, hal.I2C_FAST_HZ)!
    core.assert(function(4) == 3 && function(5) == 3)
    unsafe {
        core.assert((PADS[4] & PULL_UP) != 0 && RESETS == 1)
    }
    expect_busy(bank.i2c(8, 9, hal.I2C_FAST_HZ))
    expect_busy(bank.gpio(5))
    expect_busy(bank.spi(2, 3, some(4u32), hal.SpiMode.Mode0, 1_000_000))

    // Released, its pins are free but still pulled up, and the controller is
    // held in reset, until the bus is claimed again.
    bank.release_i2c(i2c)
    core.assert(function(4) == DISCONNECTED && function(5) == DISCONNECTED)
    unsafe {
        core.assert((PADS[4] & PULL_UP) != 0 && HELD == 1u32 << rp_pins.I2C0)
    }
    scl := bank.gpio(5)!
    expect_busy(bank.i2c(4, 5, hal.I2C_FAST_HZ))
    bank.release_gpio(scl)
    core.assert_eq(function(5), DISCONNECTED)
    again := bank.i2c(4, 5, hal.I2C_STANDARD_HZ)!
    core.assert_eq(again.frequency_hz(), hal.I2C_STANDARD_HZ)
    unsafe {
        core.assert(RESETS == 2 && HELD == 0)
    }

    // Releasing one bus leaves the others alone.
    other := bank.i2c(2, 3, hal.I2C_FAST_HZ)!
    spi := bank.spi(18, 19, some(16u32), hal.SpiMode.Mode0, 1_000_000)!
    core.assert(function(16) == 1 && function(18) == 1 && function(19) == 1)
    bank.release_spi(spi)
    core.assert(function(16) == DISCONNECTED && function(19) == DISCONNECTED && function(4) == 3 && function(2) == 3)
    unsafe {
        core.assert_eq(HELD, 1u32 << rp_pins.SPI0)
    }
    expect_busy(bank.gpio(2))
    bank.release_i2c(other)
    bank.release_i2c(again)
    unsafe {
        core.assert_eq(HELD, (1u32 << rp_pins.SPI0) | (1u32 << rp_pins.I2C0) | (1u32 << rp_pins.I2C1))
    }

    // A reset that does not finish gives the controller and pins back.
    unsafe {
        FAIL_RESET = true
    }
    match bank.spi(10, 11, none, hal.SpiMode.Mode0, 1_000_000) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }
    unsafe {
        FAIL_RESET = false
    }
    last := bank.spi(10, 11, none, hal.SpiMode.Mode3, 1_000_000)!
    core.assert(function(10) == 1 && function(11) == 1 && last.frequency_hz() == 992_063)

    // A serial port: pulled up, so its line idles high, with its controller
    // and pins owned once; the baud rate is checked before anything is
    // taken.
    serial := bank.uart(0, some(1u32), 115_200)!
    core.assert(function(0) == UART && function(1) == UART && serial.baud() == 115_207)
    unsafe {
        core.assert((PADS[1] & PULL_UP) != 0 && (PADS[1] & PULL_DOWN) == 0)
        core.assert((HELD & (1u32 << rp_pins.UART0)) == 0)
    }
    expect_busy(bank.uart(12, none, 115_200))
    expect_busy(bank.gpio(1))
    expect_busy(bank.i2c(0, 1, hal.I2C_STANDARD_HZ))
    match bank.uart(4, some(5u32), 10_000_000) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    second := bank.uart(4, some(5u32), 9600)!
    core.assert(function(4) == UART && second.baud() == 9600)

    // A panic report goes to the ports that are claimed, once: the last
    // byte of the message, LF, is in UART0's data register, and UART1 was
    // released before the panic.
    bank.release_uart(second)
    core.assert(function(4) == DISCONNECTED && function(5) == DISCONNECTED)
    unsafe {
        core.assert((PADS[5] & PULL_UP) != 0 && (HELD & (1u32 << rp_pins.UART1)) != 0)
    }
    check: [6]u8 = [98, 111, 117, 110, 100, 0]
    unsafe {
        BLOCKS[UART0_DATA] = 0
        BLOCKS[UART1_DATA] = 0
        rp_pins.report_panic(ptr.as_ptr(&check), ptr.as_ptr(&check), 3, 4)
        core.assert(BLOCKS[UART0_DATA] == 10 && BLOCKS[UART1_DATA] == 0)
        BLOCKS[UART0_DATA] = 0
        rp_pins.report_panic(ptr.as_ptr(&check), ptr.as_ptr(&check), 3, 4)
        core.assert_eq(BLOCKS[UART0_DATA], 0u32)
    }

    // Released, the port's pins and controller can be claimed again.
    bank.release_uart(serial)
    core.assert(function(0) == DISCONNECTED && function(1) == DISCONNECTED)
    unsafe {
        core.assert((PADS[0] & PULL_UP) != 0 && (HELD & (1u32 << rp_pins.UART0)) != 0)
    }
    transmit_only := bank.uart(16, none, 115_200)!
    core.assert(function(16) == UART && function(17) != UART)
    bank.release_uart(transmit_only)

    // Only a chip with UART_AUX takes TX and RX on those pins, routed to
    // that function.
    match bank.uart(14, some(15u32), 115_200) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    unsafe {
        UART_AUX = true
    }
    auxiliary := bank.uart(14, some(13u32), 115_200)!
    core.assert(function(14) == 11 && function(13) == UART)
    bank.release_uart(auxiliary)
    core.assert(function(14) == DISCONNECTED)
    unsafe {
        UART_AUX = false
    }

    // A port with flow control owns all four pins.
    flow := bank.uart_flow(0, 1, 2, 3, 115_200)!
    core.assert(function(2) == UART && function(3) == UART)
    expect_busy(bank.gpio(3))
    expect_busy(bank.uart(12, none, 9600))
    bank.release_uart(flow)
    core.assert(function(2) == DISCONNECTED && function(3) == DISCONNECTED)
    second_flow := bank.uart_flow(4, 5, 6, 7, 9600)!
    bank.release_uart(second_flow)

    // An I2C target: the address is checked before anything is taken.
    match bank.i2c_target(4, 5, 0x78, false, hal.I2C_FAST_HZ) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    target := bank.i2c_target(4, 5, 0x42, false, hal.I2C_FAST_HZ)!
    core.assert(function(4) == 3 && function(5) == 3)
    expect_busy(bank.i2c(8, 9, hal.I2C_FAST_HZ))
    bank.release_i2c_target(target)
    core.assert(function(4) == DISCONNECTED)
    wide := bank.i2c_target(8, 9, 0x2A5, true, hal.I2C_STANDARD_HZ)!
    bank.release_i2c_target(wide)

    // An SPI bus with its own chip select, and a target on the other
    // controller, whose select is pulled up so that it idles deselected.
    bank.release_spi(last)
    framed := bank.spi_with_select(18, 19, some(16u32), 17, hal.SpiMode.Mode0, 1_000_000)!
    core.assert(function(17) == 1)
    framed.set_frame_format(pl022.FrameFormat.TexasInstruments)
    match bank.spi_with_select(10, 11, none, 17, hal.SpiMode.Mode0, 1_000_000) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.InvalidInput)
        }
    }
    spi_target := bank.spi_target(10, 11, some(12u32), 13, hal.SpiMode.Mode3)!
    core.assert(function(10) == 1 && function(13) == 1)
    unsafe {
        core.assert((PADS[13] & PULL_UP) != 0 && (PADS[13] & PULL_DOWN) == 0)
    }
    expect_busy(bank.spi(26, 27, none, hal.SpiMode.Mode0, 1_000_000))
    bank.release_spi_target(spi_target)
    bank.release_spi(framed)
    core.assert(function(13) == DISCONNECTED && function(17) == DISCONNECTED)
}

const PWM_FUNCTION: u32 = 4
const INPUT_ENABLE: u32 = 1 << 6
const OUTPUT_DISABLE: u32 = 1 << 7

fn expect_pwm_busy(result: rp_pwm.Pwm!hal.Error) {
    match result {
        ok(output) => {
            output.release()
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Busy)
        }
    }
}

fn held(controller: u32) -> bool {
    unsafe {
        return (HELD & (1u32 << controller)) != 0
    }
}

// PWM outputs and ADC inputs: pins and outputs owned once, the PWM block
// out of reset while an output is in use, and the ADC running while an
// input is.
fn rp_bank_pwm_and_adc() {
    bank := unsafe {
        rp_pins.Bank.new(FakeChip {})
    }
    resets := unsafe {
        RESETS
    }
    led := bank.pwm(15, 1000)!
    core.assert(function(15) == PWM_FUNCTION && led.pin() == 15 && led.frequency_hz() == 1000)
    unsafe {
        core.assert((PADS[15] & OUTPUT_DISABLE) == 0 && RESETS == resets + 1)
    }
    core.assert(!held(rp_pins.PWM))
    hal.set_duty_percent(&mut led, 50)!
    expect_busy(bank.pwm(15, 1000))
    expect_busy(bank.gpio(15))
    expect_invalid(bank.pwm(30, 1000))
    expect_invalid(bank.pwm(14, 0))

    // The other output of the slice joins at the same frequency only; a
    // failed claim gives its pin back.
    expect_pwm_busy(bank.pwm(14, 2000))
    free := bank.gpio(14)!
    bank.release_gpio(free)
    dim := bank.pwm(14, 1000)!
    unsafe {
        core.assert_eq(RESETS, resets + 1)
    }
    // GPIO 0 and 16 carry the same output.
    first := bank.pwm_divided(0, 16, 99)!
    core.assert_eq(first.max_duty(), 100u16)
    expect_pwm_busy(bank.pwm_divided(16, 16, 99))
    taken := bank.gpio(16)!
    bank.release_gpio(taken)

    // Released, outputs disconnect their pins; the last holds the block in
    // reset.
    bank.release_pwm(led)
    core.assert(function(15) == DISCONNECTED && !held(rp_pins.PWM))
    bank.release_pwm(dim)
    bank.release_pwm(first)
    core.assert(function(14) == DISCONNECTED && function(0) == DISCONNECTED && held(rp_pins.PWM))
    unsafe {
        FAIL_RESET = true
    }
    match bank.pwm(15, 1000) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }
    unsafe {
        FAIL_RESET = false
    }
    again := bank.pwm(15, 50)!
    core.assert_eq(again.frequency_hz(), 50u32)
    bank.release_pwm(again)

    // An analog input turns off its pin's digital input and pulls; the ADC
    // starts with the first input and stops after the last.
    knob := bank.analog(26)!
    core.assert(function(26) == DISCONNECTED && knob.input() == 0 && knob.max_value() == 4095)
    unsafe {
        core.assert((PADS[26] & (INPUT_ENABLE | PULL_UP | PULL_DOWN)) == 0 && (PADS[26] & OUTPUT_DISABLE) != 0)
        core.assert(ADC_STARTS == 1 && ADC_STOPS == 0)
    }
    expect_busy(bank.analog(26))
    expect_busy(bank.gpio(26))
    expect_invalid(bank.analog(25))
    expect_invalid(bank.analog(30))
    sensor := bank.temperature()!
    core.assert_eq(sensor.input(), rp_adc.TEMPERATURE_INPUT)
    expect_busy(bank.temperature())
    supply := bank.analog(29)!
    core.assert_eq(supply.input(), 3u32)
    bank.release_analog(knob)
    bank.release_analog(supply)
    unsafe {
        core.assert(ADC_STARTS == 1 && ADC_STOPS == 0)
    }
    bank.release_analog(sensor)
    unsafe {
        core.assert(ADC_STARTS == 1 && ADC_STOPS == 1)
    }
    pin := bank.gpio(26)!
    bank.release_gpio(pin)

    // An ADC that does not start gives the pin back.
    unsafe {
        FAIL_ADC = true
    }
    match bank.analog(27) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }
    unsafe {
        FAIL_ADC = false
    }
    pin = bank.gpio(27)!
    bank.release_gpio(pin)
    sensor = bank.temperature()!
    bank.release_analog(sensor)
    unsafe {
        core.assert(ADC_STARTS == 2 && ADC_STOPS == 2)
    }
}

// The UART pin rules exhaustively, and a claim whose reset fails.
fn rp_bank_uart_rules() {
    for tx in 0u32..30 {
        for rx in 0u32..30 {
            valid := tx % 4 == 0 && rx % 4 == 1 && ((tx + 4) / 8) % 2 == ((rx + 4) / 8) % 2
            match rp_pins.uart_pins(tx, some(rx)) {
                ok(pins) => {
                    core.assert(valid)
                    core.assert_eq(pins.controller, ((tx + 4) / 8) % 2)
                    core.assert_eq(pins.mask, (1u32 << tx) | (1u32 << rx))
                }
                err(error) => {
                    core.assert(!valid && error == hal.Error.InvalidInput)
                }
            }
            aux_valid := (tx % 4 == 0 || tx % 4 == 2) && (rx % 4 == 1 || rx % 4 == 3) && ((tx + 4) / 8) % 2 == ((rx + 4) / 8) % 2
            match rp_pins.uart_aux_pins(tx, some(rx)) {
                ok(pins) => {
                    core.assert(aux_valid)
                    core.assert_eq(pins.controller, ((tx + 4) / 8) % 2)
                }
                err(error) => {
                    core.assert(!aux_valid && error == hal.Error.InvalidInput)
                }
            }
        }
    }
    bank := unsafe {
        rp_pins.Bank.new(FakeChip {})
    }
    expect_invalid(bank.uart(0, some(5u32), 115_200))
    expect_invalid(bank.uart(0, some(1u32), 0))
    // RX may come from another group of the same UART.
    uart := bank.uart(0, some(13u32), 115_200)!
    core.assert(function(0) == UART && function(13) == UART)
    expect_busy(bank.uart(16, some(17u32), 9600))
    expect_busy(bank.gpio(13))
    second := bank.uart(4, some(25u32), 9600)!
    bank.release_uart(uart)
    core.assert(function(0) == DISCONNECTED && function(13) == DISCONNECTED)
    core.assert(function(4) == UART && function(25) == UART)
    bank.release_uart(second)
    // A failed reset gives back both the controller and its pins.
    unsafe {
        FAIL_RESET = true
    }
    match bank.uart(0, some(1u32), 115_200) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }
    unsafe {
        FAIL_RESET = false
    }
    again := bank.uart(0, some(1u32), 115_200)!
    bank.release_uart(again)
    free := bank.gpio(0)!
    bank.release_gpio(free)
}

// --- The RP PIO blocks -----------------------------------------------------

// The PIO driver only writes registers and polls FIFO status, so plain
// memory stands in for a block: a write to an atomic alias lands in the
// alias's own word, where the checks read it back.
const PIO_CTRL: usize = 0x000
const PIO_FSTAT: usize = 0x004
const PIO_FDEBUG: usize = 0x008
const PIO_FLEVEL: usize = 0x00C
const PIO_IRQ: usize = 0x030
const PIO_IRQ_FORCE: usize = 0x034
const PIO_SYNC_BYPASS: usize = 0x038
const PIO_INSTR_MEM: usize = 0x048
const PIO_SM1: usize = 0x0E0
const PIO_PUTGET: usize = 0x128
const PIO_FUNCTION: u32 = 6
const SET: usize = 0x2000
const CLEAR: usize = 0x3000

fn pio_base(block: u32) -> usize {
    unsafe {
        return ptr.from_mut(&mut PIO_MEMORY) as usize + 0x4000 * block as usize
    }
}

fn pio_word(block: u32, offset: usize) -> u32 {
    unsafe {
        return PIO_MEMORY[4096 * block as usize + offset / 4]
    }
}

fn set_pio_word(block: u32, offset: usize, value: u32) {
    unsafe {
        PIO_MEMORY[4096 * block as usize + offset / 4] = value
    }
}

fn clear_pio(block: u32) {
    for index in 0..4096usize {
        set_pio_word(block, 4 * index, 0)
    }
    // Every FIFO empty.
    set_pio_word(block, PIO_FSTAT, 0x0F00_0F00)
}

fn pio_block(block: u32, version: u32) -> rp_pio.Pio {
    clear_pio(block)
    unsafe {
        return rp_pio.Pio.at(pio_base(block), block, version, CLOCK_HZ, 7 + 2 * block)
    }
}

// A program of `words` at `origin` with no settings of its own.
fn pio_program(words: &[u16], origin: u32) -> rp_pio.Program {
    instructions := [0u16; 32]
    for index in 0..words.len {
        instructions[index] = words[index]
    }
    length := words.len as u32
    return rp_pio.Program { instructions, length, origin, wrap_target: 0, wrap: length - 1, side_set_count: 0, side_set_optional: false, side_set_pindirs: false, version: 0, clock_divider: 256, fifo: rp_pio.FIFO_TXRX, status_select: 0, status_n: 0, in_count: 32, in_right: true, autopush: false, push_threshold: 32, out_count: 0, out_right: true, autopull: false, pull_threshold: 32, set_count: 0 }
}

fn expect_failure(result: void!hal.Error, expected: hal.Error) {
    match result {
        ok() => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == expected)
        }
    }
}

fn expect_unsupported<T>(result: T!hal.Error) {
    match result {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Unsupported)
        }
    }
}

// Programs land at their origin or the highest free slots, with JMP
// targets moved along; memory is owned once and freed by unload.
fn pio_loading() {
    pio := pio_block(0, 0)
    // The datasheet's square wave: set pindirs, set pins [1], set pins,
    // jmp 1.
    words1 := [0xE081u16, 0xE101, 0xE000, 0x0001]
    square := pio_program(&words1, rp_pio.ANYWHERE)
    high := pio.load(&square)!
    core.assert(high.offset() == 28 && high.length() == 4 && pio.memory() == 0xF000_0000)
    core.assert(pio_word(0, PIO_INSTR_MEM + 4 * 28) == 0xE081 && pio_word(0, PIO_INSTR_MEM + 4 * 31) == 29)
    below := pio.load(&square)!
    core.assert(below.offset() == 24 && pio_word(0, PIO_INSTR_MEM + 4 * 27) == 25)
    words2 := [0x0001u16, 0x0000]
    fixed := pio_program(&words2, 0)
    origin := pio.load(&fixed)!
    core.assert(origin.offset() == 0 && pio_word(0, PIO_INSTR_MEM + 4) == 0 && pio.memory() == 0xFF00_0003)
    expect_busy(pio.load(&fixed))
    // 22 slots are left: a program of 23 does not fit, one of 22 does.
    words3 := [0xA042u16; 23]
    long := pio_program(&words3, rp_pio.ANYWHERE)
    expect_busy(pio.load(&long))
    words4 := [0xA042u16; 22]
    fits := pio_program(&words4, rp_pio.ANYWHERE)
    rest := pio.load(&fits)!
    core.assert(rest.offset() == 2 && pio.memory() == 0xFFFF_FFFF)
    pio.unload(below)
    core.assert(pio.memory() == 0xF0FF_FFFF)
    again := pio.load(&square)!
    core.assert(again.offset() == 24)
    pio.unload(again)
    pio.unload(high)
    pio.unload(origin)
    pio.unload(rest)
    core.assert(pio.memory() == 0)
    // Malformed programs and RP2350 programs on an RP2040 are refused.
    words5 := [0xA042u16]
    empty := pio_program(&words5, rp_pio.ANYWHERE)
    empty.length = 0
    expect_invalid(pio.load(&empty))
    words6 := [0xA042u16, 0xA042]
    late := pio_program(&words6, 31)
    expect_invalid(pio.load(&late))
    words7 := [0xA042u16]
    wrapped := pio_program(&words7, rp_pio.ANYWHERE)
    wrapped.wrap = 1
    expect_invalid(pio.load(&wrapped))
    words8 := [0xA061u16]
    newer := pio_program(&words8, rp_pio.ANYWHERE)
    newer.version = 1
    expect_unsupported(pio.load(&newer))
    newer.version = 0
    newer.fifo = rp_pio.FIFO_PUTGET
    expect_unsupported(pio.load(&newer))
    core.assert(pio.memory() == 0)
}

// A program's settings become the config's, and init writes them to the
// state machine's registers.
fn pio_configs() {
    pio := pio_block(1, 1)
    words9 := [0xA042u16, 0xA042, 0xA042]
    program := pio_program(&words9, rp_pio.ANYWHERE)
    program.wrap_target = 1
    program.wrap = 2
    program.side_set_count = 3
    program.side_set_optional = true
    program.side_set_pindirs = true
    program.clock_divider = 640
    program.fifo = rp_pio.FIFO_TX
    program.status_select = rp_pio.STATUS_IRQ
    program.status_n = 19
    program.in_count = 5
    program.in_right = false
    program.autopull = true
    program.pull_threshold = 24
    program.out_count = 3
    program.set_count = 2
    loaded := pio.load(&program)!
    core.assert(loaded.offset() == 29)
    config := loaded.config()
    core.assert(config.divider() == 640)
    machine := pio.state_machine(1)!
    machine.init(&config)
    // EXECCTRL: side-set enable and pindirs, wrap 31 to 30, status IRQ 19.
    core.assert_eq(pio_word(1, PIO_SM1 + 4), (3u32 << 29) | (31u32 << 12) | (30u32 << 7) | (2u32 << 5) | 19)
    // SHIFTCTRL: TX join, pull threshold 24, push 32, right-shifting OSR,
    // autopull, five IN pins.
    core.assert_eq(pio_word(1, PIO_SM1 + 8), (1u32 << 30) | (24u32 << 25) | (1u32 << 19) | (1u32 << 17) | 5)
    // PINCTRL: three side-set bits, two SET pins, three OUT pins.
    core.assert_eq(pio_word(1, PIO_SM1 + 0x14), (3u32 << 29) | (2u32 << 26) | (3u32 << 20))
    core.assert_eq(pio_word(1, PIO_SM1), 640u32 << 8)
    // The FIFOs clear (FJOIN_RX flips there and back), errors clear, the
    // machine and its divider restart, and it jumps to its start.
    core.assert(pio_word(1, PIO_SM1 + 8 + 0x1000) == 1u32 << 31 && pio_word(1, PIO_FDEBUG) == 0x0202_0202)
    core.assert(pio_word(1, PIO_CTRL + SET) == 1u32 << 9 && pio_word(1, PIO_SM1 + 0x10) == 29)
    core.assert(pio_word(1, PIO_CTRL + CLEAR) == 1u32 << 1)
    machine.set_enabled(true)
    core.assert(pio_word(1, PIO_CTRL + SET) == 1u32 << 1)

    // Settings change one field each.
    config.set_frequency(1_000_000)!
    core.assert(config.divider() == 32_000 && config.frequency_hz() == 1_000_000)
    config.set_divider(256 * 3 + 128)!
    core.assert(config.frequency_hz() == 35_714_286)
    config.set_out_pins(5, 3)!
    config.set_set_pins(6, 2)!
    config.set_in_pins(7)!
    config.set_sideset_pins(8)!
    config.set_jmp_pin(9)!
    config.set_in_shift(true, true, 8)!
    config.set_out_shift(false, false, 32)!
    config.set_fifo_join(rp_pio.FIFO_PUTGET)!
    config.set_mov_status(rp_pio.STATUS_RX_LESS, 2)!
    config.set_out_special(true, some(4u32))!
    config.set_wrap(3, 7)!
    config.set_start(4)!
    machine.init(&config)
    core.assert_eq(pio_word(1, PIO_SM1 + 0x14), (3u32 << 29) | (2u32 << 26) | (3u32 << 20) | (7u32 << 15) | (8u32 << 10) | (6u32 << 5) | 5)
    core.assert_eq(pio_word(1, PIO_SM1 + 4), (3u32 << 29) | (9u32 << 24) | (4u32 << 19) | (3u32 << 17) | (7u32 << 12) | (3u32 << 7) | (1u32 << 5) | 2)
    core.assert_eq(pio_word(1, PIO_SM1 + 8), (3u32 << 14) | (8u32 << 20) | (1u32 << 18) | (1u32 << 16) | 5)
    core.assert(pio_word(1, PIO_SM1) == 896u32 << 8 && pio_word(1, PIO_SM1 + 0x10) == 4)
    expect_failure(config.set_out_pins(32, 1), hal.Error.InvalidInput)
    expect_failure(config.set_out_pins(0, 33), hal.Error.InvalidInput)
    expect_failure(config.set_set_pins(0, 6), hal.Error.InvalidInput)
    expect_failure(config.set_divider(255), hal.Error.InvalidInput)
    expect_failure(config.set_frequency(0), hal.Error.InvalidInput)
    expect_failure(config.set_frequency(1000), hal.Error.InvalidInput)
    expect_failure(config.set_fifo_join(6), hal.Error.InvalidInput)
    expect_failure(config.set_in_shift(true, false, 0), hal.Error.InvalidInput)
    expect_failure(config.set_mov_status(rp_pio.STATUS_IRQ, 24), hal.Error.InvalidInput)
    expect_failure(config.set_wrap(32, 0), hal.Error.InvalidInput)
    expect_failure(config.set_start(32), hal.Error.InvalidInput)
    pio.release_state_machine(machine)
    core.assert(pio_word(1, PIO_CTRL + CLEAR) == 1u32 << 1)

    // The RP2040's state machines have no IN count, RX FIFO registers,
    // or IRQ status, and four status bits.
    older := pio_block(0, 0)
    words10 := [0xA042u16]
    single := pio_program(&words10, rp_pio.ANYWHERE)
    loaded = older.load(&single)!
    config = loaded.config()
    config.set_in_count(32)!
    expect_failure(config.set_in_count(5), hal.Error.Unsupported)
    expect_failure(config.set_fifo_join(rp_pio.FIFO_TXGET), hal.Error.Unsupported)
    expect_failure(config.set_mov_status(rp_pio.STATUS_IRQ, 1), hal.Error.Unsupported)
    expect_failure(config.set_mov_status(rp_pio.STATUS_TX_LESS, 16), hal.Error.InvalidInput)
    config.set_mov_status(rp_pio.STATUS_RX_LESS, 15)!
    machine = older.state_machine(0)!
    machine.init(&config)
    core.assert_eq(pio_word(0, 0x0C8 + 4) & 0x7F, 0x1Fu32)
    expect_unsupported(machine.rx_register(0))
    older.release_state_machine(machine)
}

// FIFO words, levels, and status; executed instructions; pins set through
// the state machine; the RP2350's RX FIFO registers.
fn pio_fifos() {
    pio := pio_block(2, 1)
    first := pio.state_machine(0)!
    machine := pio.state_machine(1)!
    machine.put(0x1234)
    core.assert(pio_word(2, 0x014) == 0x1234 && pio_word(2, 0x010) == 0)
    // TX full for state machine 1 only.
    set_pio_word(2, PIO_FSTAT, 0x0F00_0F00 | (1u32 << 17))
    core.assert(machine.is_tx_full() && !first.is_tx_full() && !machine.try_put(7) && first.try_put(8))
    core.assert(pio_word(2, 0x014) == 0x1234 && pio_word(2, 0x010) == 8)
    match machine.try_get() {
        some(_) => {
            core.assert(false)
        }
        none => {}
    }
    // A word for state machine 1.
    set_pio_word(2, PIO_FSTAT, 0x0F00_0D00)
    set_pio_word(2, 0x024, 0xCAFE)
    core.assert(machine.get() == 0xCAFE && !machine.is_rx_empty() && first.is_rx_empty())
    match machine.try_get() {
        some(word) => {
            core.assert(word == 0xCAFE)
        }
        none => {
            core.assert(false)
        }
    }
    set_pio_word(2, PIO_FLEVEL, 0x0000_3521)
    core.assert(machine.tx_level() == 5 && machine.rx_level() == 3 && first.tx_level() == 1 && first.rx_level() == 2)
    set_pio_word(2, PIO_FDEBUG, 1u32 << 25)
    core.assert(machine.take_tx_stall() && pio_word(2, PIO_FDEBUG) == 1u32 << 25)
    set_pio_word(2, PIO_FDEBUG, 0)
    core.assert(!machine.take_tx_stall())
    machine.exec(0xE03F)
    core.assert(pio_word(2, PIO_SM1 + 0x10) == 0xE03F)
    machine.jump(12)
    core.assert(pio_word(2, PIO_SM1 + 0x10) == 12)
    set_pio_word(2, PIO_SM1 + 0x0C, 0x13)
    core.assert(machine.address() == 0x13 && !machine.is_exec_stalled())

    // Pins are set one at a time with SET mapped to each, then the mapping
    // and sticky output come back.
    set_pio_word(2, PIO_SM1 + 0x14, 0x1234_5678)
    set_pio_word(2, PIO_SM1 + 4, 0x0002_0000)
    machine.set_pins(30, 3, 0b011)
    core.assert(pio_word(2, PIO_SM1 + 0x10) == 0xE000 && pio_word(2, PIO_SM1 + 4 + CLEAR) == 1u32 << 17)
    core.assert(pio_word(2, PIO_SM1 + 0x14) == 0x1234_5678 && pio_word(2, PIO_SM1 + 4) == 0x0002_0000)
    machine.set_pindirs(4, 2, 0b10)
    core.assert(pio_word(2, PIO_SM1 + 0x10) == 0xE081)

    machine.set_rx_register(2, 77)!
    core.assert(pio_word(2, PIO_PUTGET + 0x10 + 8) == 77)
    set_pio_word(2, PIO_PUTGET + 0x10 + 12, 99)
    core.assert(machine.rx_register(3)! == 99)
    expect_invalid(machine.rx_register(4))
    core.assert(machine.tx_fifo_address() == pio_base(2) + 0x014 && machine.rx_fifo_address() == pio_base(2) + 0x024)
    pio.release_state_machine(first)
    pio.release_state_machine(machine)
}

// State machines are owned once; IRQ flags, interrupts, and synchronized
// starts reach only what the block's owner may touch.
fn pio_machines_and_interrupts() {
    pio := pio_block(0, 1)
    zero := pio.state_machine(0)!
    expect_busy(pio.state_machine(0))
    expect_invalid(pio.state_machine(4))
    one := pio.free_state_machine()!
    core.assert(one.index() == 1 && one.block() == 0 && pio.machines() == 0b11)
    pio.enable_in_sync(0b1111)
    core.assert(pio_word(0, PIO_CTRL + SET) == 0x303)
    // IRQ0_INTE and IRQ1_INTE of an RP2350 block, through their aliases.
    pio.listen(0, rp_pio.rx_not_empty(1) | rp_pio.flag(7))
    core.assert(pio_word(0, 0x170 + SET) == 0x8002)
    pio.ignore(1, rp_pio.tx_not_full(0))
    core.assert(pio_word(0, 0x17C + CLEAR) == 0x10)
    set_pio_word(0, 0x178, 0x8002)
    core.assert(pio.interrupts(0) == 0x8002 && pio.irq(0) == 7 && pio.irq(1) == 8)
    set_pio_word(0, PIO_IRQ, 0x1A5)
    core.assert(pio.flags() == 0xA5)
    pio.clear_flags(0x101)
    pio.force_flags(0x2)
    core.assert(pio_word(0, PIO_IRQ) == 0x1 && pio_word(0, PIO_IRQ_FORCE) == 0x2)
    pio.bypass_input_sync(5, true)
    pio.bypass_input_sync(6, false)
    core.assert(pio_word(0, PIO_SYNC_BYPASS + SET) == 1u32 << 5 && pio_word(0, PIO_SYNC_BYPASS + CLEAR) == 1u32 << 6)
    // A released machine stops and stops raising interrupts.
    pio.release_state_machine(one)
    core.assert(pio_word(0, PIO_CTRL + CLEAR) == 1u32 << 1 && pio_word(0, 0x17C + CLEAR) == 0x22 && pio.machines() == 1)
    again := pio.free_state_machine()!
    core.assert(again.index() == 1)
    pio.release_state_machine(again)
    pio.release_state_machine(zero)
    set_pio_word(0, PIO_CTRL, 0xF)
    core.assert(pio.release() == 0 && pio_word(0, PIO_CTRL) == 0)

    // The RP2040's interrupt registers sit lower, with four flags.
    older := pio_block(1, 0)
    older.listen(1, rp_pio.flag(3) | rp_pio.flag(4))
    core.assert(pio_word(1, 0x138 + SET) == 0x800 && older.irq(1) == 10)
}

// The bank hands out each block once, out of reset, with the pins given to
// it, and takes them back.
fn rp_bank_pio() {
    bank := unsafe {
        rp_pins.Bank.new(FakeChip {})
    }
    resets := unsafe {
        RESETS
    }
    expect_invalid(bank.pio(3))
    pio := bank.pio(1)!
    core.assert(pio.number() == 1 && pio.version() == 1 && pio.irq(0) == 17 && !held(rp_pins.PIO1))
    unsafe {
        core.assert_eq(RESETS, resets + 1)
    }
    expect_busy(bank.pio(1))
    led := bank.gpio(12)!
    expect_failure(bank.pio_pins(&pio, 11, 2), hal.Error.Busy)
    expect_failure(bank.pio_pins(&pio, 29, 2), hal.Error.InvalidInput)
    expect_failure(bank.pio_pins(&pio, 3, 0), hal.Error.InvalidInput)
    bank.pio_pins(&pio, 13, 3)!
    core.assert(function(13) == PIO_FUNCTION + 1 && function(15) == PIO_FUNCTION + 1 && function(12) == SIO)
    unsafe {
        core.assert((PADS[14] & OUTPUT_DISABLE) == 0 && (PADS[14] & INPUT_ENABLE) != 0)
    }
    expect_busy(bank.gpio(14))
    // Another block's pins.
    zero := bank.pio(0)!
    bank.pio_pins(&zero, 0, 1)!
    core.assert(function(0) == PIO_FUNCTION)
    machine := pio.state_machine(2)!
    pio.release_state_machine(machine)
    bank.release_pio(pio)
    core.assert(function(13) == DISCONNECTED && function(15) == DISCONNECTED && function(0) == PIO_FUNCTION && held(rp_pins.PIO1))
    free := bank.gpio(14)!
    bank.release_gpio(free)
    // A failed reset claims nothing.
    unsafe {
        FAIL_RESET = true
    }
    match bank.pio(1) {
        ok(_) => {
            core.assert(false)
        }
        err(error) => {
            core.assert(error == hal.Error.Timeout)
        }
    }
    unsafe {
        FAIL_RESET = false
    }
    again := bank.pio(1)!
    bank.release_pio(again)
    bank.release_pio(zero)
    bank.release_gpio(led)
}

