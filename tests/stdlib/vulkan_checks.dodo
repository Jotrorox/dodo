package main

import "core/mem"
import "core/ptr"
import "std/dylib"
import "std/gpu/vulkan" as vk

// std/gpu/vulkan without a GPU: layouts of the generated structs (checked
// in full against the C headers by scripts/vulkan_layout_check.py), the
// defaults, the helpers, and std/dylib, which the loader is built on.

type Strlen = extern "C" fn(*const u8) -> usize

fn layouts() {
    core.assert_eq(mem.size_of::<vk.Instance>(), 8usize)
    core.assert_eq(mem.size_of::<vk.Buffer>(), 8usize)
    core.assert_eq(mem.size_of::<vk.PfnCreateInstance>(), 8usize)
    core.assert_eq(mem.size_of::<vk.InstanceCreateInfo>(), 64usize)
    core.assert_eq(mem.offset_of::<vk.InstanceCreateInfo>("pp_enabled_extension_names"), 56usize)
    core.assert_eq(mem.size_of::<vk.PhysicalDeviceLimits>(), 504usize)
    core.assert_eq(mem.size_of::<vk.PhysicalDeviceProperties>(), 824usize)
    core.assert_eq(mem.offset_of::<vk.PhysicalDeviceProperties>("limits"), 296usize)
    core.assert_eq(mem.size_of::<vk.PhysicalDeviceMemoryProperties>(), 520usize)
    core.assert_eq(mem.size_of::<vk.ExtensionProperties>(), 260usize)
    core.assert_eq(mem.size_of::<vk.ClearColorValue>(), 16usize)
    core.assert_eq(mem.size_of::<vk.ClearValue>(), 16usize)
    core.assert_eq(mem.size_of::<vk.ImageMemoryBarrier2>(), 96usize)
    core.assert_eq(mem.size_of::<vk.RenderingInfo>(), 72usize)
    core.assert_eq(mem.size_of::<vk.DebugUtilsMessengerCreateInfoEXT>(), 48usize)
    core.assert_eq(mem.size_of::<vk.SwapchainCreateInfoKHR>(), 104usize)
    core.assert_eq(mem.size_of::<vk.XlibSurfaceCreateInfoKHR>(), 40usize)
    core.assert_eq(mem.size_of::<vk.Win32SurfaceCreateInfoKHR>(), 40usize)
    core.assert_eq(mem.size_of::<vk.MetalSurfaceCreateInfoEXT>(), 32usize)
}

fn defaults() {
    info := vk.InstanceCreateInfo.default()
    core.assert_eq(info.s_type, vk.STRUCTURE_TYPE_INSTANCE_CREATE_INFO)
    core.assert(ptr.is_null(info.p_next))
    core.assert_eq(info.enabled_extension_count, 0u32)
    barrier := vk.ImageMemoryBarrier2.default()
    core.assert_eq(barrier.s_type, vk.STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2)
    core.assert_eq(barrier.src_stage_mask, 0u64)
    extent := vk.Extent3D.default()
    core.assert_eq(extent.depth, 0u32)
    messenger := vk.DebugUtilsMessengerCreateInfoEXT.default()
    core.assert_eq(unsafe {
        messenger.pfn_user_callback as usize
    }, 0usize)
    families := unsafe {
        vk.zeroed::<[4]vk.QueueFamilyProperties>()
    }
    core.assert_eq(families[3].queue_count, 0u32)
}

fn constants() {
    core.assert_eq(vk.API_VERSION_1_0, vk.make_api_version(0, 1, 0, 0))
    core.assert_eq(vk.API_VERSION_1_4, vk.make_api_version(0, 1, 4, 0))
    version := vk.make_api_version(0, 1, 3, 290)
    core.assert_eq(vk.api_version_major(version), 1u32)
    core.assert_eq(vk.api_version_minor(version), 3u32)
    core.assert_eq(vk.api_version_patch(version), 290u32)
    core.assert_eq(vk.api_version_variant(version), 0u32)
    core.assert_eq(vk.FORMAT_R8G8B8A8_UNORM, 37i32)
    core.assert_eq(vk.ERROR_OUT_OF_DATE_KHR, -1000001004i32)
    core.assert_eq(vk.STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR, 1000001000i32)
    core.assert_eq(vk.BUFFER_USAGE_STORAGE_BUFFER_BIT, 32u32)
    core.assert_eq(vk.PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, 2048u64)
    core.assert_eq(vk.WHOLE_SIZE, 0xffffffffffffffffu64)
    core.assert_eq(vk.QUEUE_FAMILY_IGNORED, 0xffffffffu32)
    core.assert_eq(vk.KHR_SWAPCHAIN_EXTENSION_NAME.len, 17usize)
    core.assert_eq(vk.result_name(vk.ERROR_DEVICE_LOST), "ERROR_DEVICE_LOST")
    core.assert_eq(vk.result_name(vk.SUBOPTIMAL_KHR), "SUBOPTIMAL_KHR")
    core.assert_eq(vk.result_name(12345), "UNKNOWN")
}

fn helpers() {
    core.assert_eq(vk.check(vk.SUCCESS)!, vk.SUCCESS)
    core.assert_eq(vk.check(vk.INCOMPLETE)!, vk.INCOMPLETE)
    match vk.check(vk.ERROR_DEVICE_LOST) {
        ok(_) => core.assert(false),
        err(error) => {
            core.assert_eq(error.code, vk.ERROR_DEVICE_LOST)
            core.assert_eq(error.name(), "ERROR_DEVICE_LOST")
        }
    }
    field := [0u8; 32]
    name := vk.KHR_SURFACE_EXTENSION_NAME
    for i in 0usize..name.len {
        field[i] = name[i]
    }
    core.assert(vk.name_eq(&field, vk.KHR_SURFACE_EXTENSION_NAME))
    core.assert(vk.name_eq(&field, b"VK_KHR_surface"))
    core.assert(!vk.name_eq(&field, vk.KHR_SWAPCHAIN_EXTENSION_NAME))
    core.assert_eq(vk.c_name(&field).len, 14usize)
    color := vk.clear_color_float(1.0, 0.5, 0.0, 1.0)
    core.assert_eq(color.data[0], 0x3f800000u32)
    core.assert_eq(color.data[1], 0x3f000000u32)
    signed := vk.clear_color_int(-1, 0, 0, 0)
    core.assert_eq(signed.data[0], 0xffffffffu32)
    value := vk.clear_value_color(color)
    core.assert_eq(value.data[1], 0x3f000000u32)
    depth := vk.clear_value_depth_stencil(1.0, 7)
    core.assert_eq(depth.data[0], 0x3f800000u32)
    core.assert_eq(depth.data[1], 7u32)
    core.assert(ptr.is_null(vk.null_handle::<vk.DeviceT>()))
    core.assert(ptr.is_null(vk.no_allocator()))
}

fn dylib_checks() {
    match dylib.open(b"libc.so.6") {
        ok(_) => core.assert(false),
        err(error) => core.assert_eq(dylib.error_name(error), "InvalidName"),
    }
    match dylib.open(b"lib\0c\0") {
        ok(_) => core.assert(false),
        err(error) => core.assert_eq(dylib.error_name(error), "InvalidName"),
    }
    match dylib.open(b"dodo-no-such-library-4c1f.so\0") {
        ok(_) => core.assert(false),
        err(error) => core.assert_eq(dylib.error_name(error), "NotFound"),
    }
    // The C library under each operating system's name; exactly one opens.
    names := [b"libc.so.6\0", b"/usr/lib/libSystem.B.dylib\0", b"msvcrt.dll\0"]
    opened := 0
    for i in 0usize..names.len {
        match dylib.open(names[i]) {
            ok(library) => {
                opened += 1
                address := library.symbol(b"strlen\0")!
                core.assert(!ptr.is_null(address))
                strlen := unsafe {
                    address as Strlen
                }
                core.assert_eq(unsafe {
                    strlen(ptr.as_ptr(b"vulkan\0"))
                }, 6usize)
                core.assert(ptr.is_null(library.symbol(b"dodo_no_such_symbol_4c1f\0")!))
                match library.symbol(b"strlen") {
                    ok(_) => core.assert(false),
                    err(error) => core.assert_eq(dylib.error_name(error), "InvalidName"),
                }
            }
            err(_) => {}
        }
    }
    core.assert_eq(opened, 1)
}

fn loader() {
    // Either there is a Vulkan loader, whose global commands resolve, or
    // open() says there is none; it never fails to start the program.
    match vk.open() {
        ok(library) => {
            entry := library.entry()
            core.assert(unsafe {
                entry.create_instance as usize
            } != 0)
            core.assert(unsafe {
                entry.enumerate_instance_extension_properties as usize
            } != 0)
        }
        err(error) => core.assert_eq(vk.load_error_name(error), "NotFound"),
    }
    match vk.open_path(b"dodo-no-such-library-4c1f.so\0") {
        ok(_) => core.assert(false),
        err(error) => core.assert_eq(vk.load_error_name(error), "NotFound"),
    }
}

fn main() {
    layouts()
    defaults()
    constants()
    helpers()
    dylib_checks()
    loader()
}
