package std_text_unicode

import "std/text"
import "std/text_unicode"
import "core/bytes"
import "core/mem"

fn checks() -> i32!text.Error {
    expected := [9u32, 10, 11, 12, 13, 32, 133, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288]
    // Exhaustively verify the property over the Unicode code-point range.
    // In particular, U+180E and U+200B are not White_Space in Unicode 16.
    index := 0usize
    for scalar in 0u32..1114112 {
        if text_unicode.is_whitespace(scalar) {
            if index >= expected.len || scalar != expected[index] {
                return ok(1)
            }
            index += 1
        }
    }
    if index != expected.len || text_unicode.is_whitespace(~0u32) {
        return ok(2)
    }
    if!bytes.equal(mem.str_bytes(text_unicode.UNICODE_VERSION), b"16.0.0") {
        return ok(3)
    }
    storage := [0u8; 160]
    builder := text.Builder.new(&mut storage)
    for i in 0usize..expected.len {
        builder.push(expected[i])?
    }
    whitespace := builder.as_text()
    trimmed_whitespace := text_unicode.trim(&whitespace)
    if!trimmed_whitespace.is_empty() {
        return ok(4)
    }
    core.drop(trimmed_whitespace)
    core.drop(whitespace)
    middle := text.Text.from_str("x\u{2003}y\u{301}")
    builder.append(&middle)?
    for i in 0usize..expected.len {
        builder.push(expected[i])?
    }
    input := builder.as_text()
    trimmed := text_unicode.trim(&input)
    if!trimmed.equal(&middle) {
        return ok(5)
    }
    ascii_trimmed := input.trim_ascii()
    if ascii_trimmed.len_bytes() == trimmed.len_bytes() {
        return ok(6)
    }
    empty := text.Text.from_str("")
    trimmed_empty := text_unicode.trim(&empty)
    if!trimmed_empty.is_empty() {
        return ok(7)
    }
    no_whitespace := text.Text.from_str("\u{180e}\u{200b}\u{feff}")
    unchanged := text_unicode.trim(&no_whitespace)
    if!unchanged.equal(&no_whitespace) {
        return ok(8)
    }
    return ok(0)
}
fn main() -> i32 {
    match checks() {
        ok(code) => {
            return code
        }, err(_) => {
            return 90
        }
    }
}

@test
fn std_text_unicode_suite() {
    assert_eq(main(), 0, "std_text_unicode fixture returned a failure code")
}
