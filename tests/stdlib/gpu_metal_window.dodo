package main

import "std/console"
import "std/gpu/metal"
import "std/gpu/metal/objc"
import "std/window"

// Renders with Metal into a std/window window's CAMetalLayer: clears a
// drawable, draws a red triangle over its centre, copies the drawable into
// a buffer before presenting it and checks the pixels. The drawable must
// have the window's size in pixels, which std/window keeps up to date.
// Prints "unavailable REASON" when there is no window system or Metal
// device, and "passed" otherwise.

const SHADERS: &str = "#include <metal_stdlib>\nusing namespace metal;\nconstant float2 corners[3] = { float2(-0.5, -0.5), float2(0.5, -0.5), float2(0.0, 0.5) };\nvertex float4 corner_vertex(uint id [[vertex_id]]) {\n    return float4(corners[id], 0.0, 1.0);\n}\nfragment float4 red_fragment() {\n    return float4(1.0, 0.0, 0.0, 1.0);\n}\n"

// The 0xRRGGBB color at (x, y), counted from the top, of BGRA rows.
fn pixel(bytes: &[u8], row: usize, x: usize, y: usize) -> u32 {
    at := y * row + x * 4
    return (bytes[at + 2] as u32 << 16) | (bytes[at + 1] as u32 << 8) | bytes[at] as u32
}

fn run(device: &metal.Device, win: &mut window.Window) -> void!metal.Error {
    address := match win.metal_layer() {
        ok(address) => address,
        err(_) => {
            return err(metal.Error.Unsupported)
        }
    }
    object := match unsafe {
        objc.Object.retain(address as objc.Id)
    }
    {
        some(object) => object,
        none => {
            return err(metal.Error.Unsupported)
        }
    }
    layer := unsafe {
        metal.MetalLayer.from_object(object)
    }
    layer.set_device(device)
    layer.set_pixel_format(metal.PIXEL_FORMAT_BGRA8_UNORM)
    // Allow the copy below; presentation-only drawables are faster.
    layer.set_framebuffer_only(false)
    size := layer.drawable_size()
    assert_eq(size.width, win.width() as f64)
    assert_eq(size.height, win.height() as f64)

    options := metal.CompileOptions.new()?
    library := device.new_library_with_source(SHADERS, &options)?
    vertex := library.new_function("corner_vertex")?
    fragment := library.new_function("red_fragment")?
    descriptor := metal.RenderPipelineDescriptor.new()?
    descriptor.set_vertex_function(&vertex)
    descriptor.set_fragment_function(&fragment)
    target := descriptor.color_attachment(0)?
    target.set_pixel_format(metal.PIXEL_FORMAT_BGRA8_UNORM)
    state := device.new_render_pipeline_state(&descriptor)?
    queue := device.new_command_queue()?

    drawable := match layer.next_drawable() {
        some(drawable) => drawable,
        none => {
            return err(metal.Error.OutOfMemory)
        }
    }
    texture := drawable.texture()?
    width := texture.width()
    height := texture.height()
    assert_eq(width, win.width() as usize)
    assert_eq(height, win.height() as usize)
    pass := metal.RenderPassDescriptor.new()?
    attachment := pass.color_attachment(0)?
    attachment.set_texture(&texture)
    attachment.set_load_action(metal.LOAD_ACTION_CLEAR)
    attachment.set_store_action(metal.STORE_ACTION_STORE)
    attachment.set_clear_color(metal.ClearColor.new(0.2, 0.4, 0.6, 1.0))
    row := width * 4
    readback := device.new_buffer(row * height, metal.RESOURCE_STORAGE_MODE_SHARED)?
    commands := queue.command_buffer()?
    encoder := commands.render_command_encoder(&pass)?
    encoder.set_render_pipeline_state(&state)
    encoder.draw_primitives(metal.PRIMITIVE_TYPE_TRIANGLE, 0, 3)
    encoder.end_encoding()
    blit := commands.blit_command_encoder()?
    blit.copy_texture_to_buffer(&texture, 0, 0, metal.Origin.new(0, 0, 0), metal.Size.new(width, height, 1), &readback, 0, row, row * height)
    blit.end_encoding()
    commands.present_drawable(&drawable)
    commands.commit()
    commands.wait_until_completed()?
    // Only the corner and the centre row are needed.
    image := [0u8; 4 * 4096]
    readback.read(0, &mut image[..row])?
    corner := pixel(&image, row, 2, 0)
    readback.read(row * (height / 2), &mut image[..row])?
    centre := pixel(&image, row, width / 2, 0)
    console.printf("corner {} centre {}\n", corner, centre)!
    assert(corner == 0x336699 || corner == 0x336698 || corner == 0x33669a)
    assert_eq(centre, 0xff0000u32)
    return ok()
}

fn main() -> i32 {
    device := match metal.Device.system_default() {
        ok(device) => device,
        err(_) => {
            console.println("unavailable\nno Metal device")!
            return 0
        }
    }
    app := match window.App.new() {
        ok(app) => app,
        err(error) => {
            console.printf("unavailable\nwindow {}\n", window.error_name(error))!
            return 0
        }
    }
    win := match app.open(window.Options.gpu("Metal window", 160, 120)) {
        ok(win) => win,
        err(error) => {
            console.printf("unavailable\nwindow {}\n", window.error_name(error))!
            return 0
        }
    }
    match run(&device, &mut win) {
        ok() => {
            console.println("passed")!
            return 0
        }
        err(error) => {
            console.println(metal.error_name(&error))!
            return 1
        }
    }
}
