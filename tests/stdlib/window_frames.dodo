package main

import "std/console"
import "std/graphics"
import "std/time/hosted"
import "std/window"

// Draws a frame on every Frame event, asking for the next one each time, for
// two seconds, then prints how many frames and events there were and the
// frame interval. tests/window_library.rs runs it under Xvfb while moving the
// mouse, since a steady stream of events must not hold frames back.

fn run() -> void!window.Error {
    app := window.App.new()?
    win := app.open(window.Options.new("Frames", 160, 120))?
    clock := hosted.MonotonicClock.new()
    start := clock.now()!
    frames := 0u32
    events := 0u32
    console.println("open")!
    win.request_frame()?
    for {
        match app.wait_event()? {
            window.Event.Close(_) => {
                break
            }
            window.Event.Frame(_) => {
                frames += 1
                canvas := win.canvas()
                canvas.clear(graphics.hex(0x102030 + (frames & 0xff)))
                dirty := canvas.take_dirty()
                win.update(dirty)?
                now := clock.now()!
                elapsed := now.duration_since(&start)!
                if elapsed.seconds() >= 2 {
                    break
                }
                win.request_frame()?
            }
            _ => {
                events += 1
            }
        }
    }
    interval := win.frame_interval()
    console.printf("frames {} events {} interval_us {}\n", frames, events, interval.to_micros()!)!
    // A program that stops asking for frames goes back to plain event waits.
    match app.wait_event_timeout(10)? {
        some(_) => {}
        none => {}
    }
    return ok()
}

fn main() -> i32 {
    match run() {
        ok() => {
            return 0
        }
        err(error) => {
            console.printf("error {}\n", window.error_name(error))!
            return 1
        }
    }
}
