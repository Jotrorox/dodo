package main

import "std/console"
import "std/graphics"
import "std/time/hosted"
import "std/window"

// Draws a frame whenever wait_event_until_frame says one is due, for two
// seconds, then prints how many frames and events there were and the frame
// interval. tests/window_library.rs runs it under Xvfb while moving the
// mouse, since a steady stream of events must not hold frames back.

fn run() -> void!window.Error {
    win := window.open(window.Options.new("Frames", 160, 120))?
    clock := hosted.MonotonicClock.new()
    start := clock.now()!
    frames := 0u32
    events := 0u32
    console.println("open")!
    for {
        match win.wait_event_until_frame()? {
            some(window.Event.Close) => {
                break
            }
            some(_) => {
                events += 1
            }
            none => {
                frames += 1
                canvas := win.canvas()
                canvas.clear(graphics.hex(0x102030 + (frames & 0xff)))
                dirty := canvas.take_dirty()
                win.update(dirty)?
                now := clock.now()!
                elapsed := now.duration_since(&start)!
                if elapsed.seconds() >= 2 {
                    break
                }
            }
        }
    }
    interval := win.frame_interval()
    console.printf("frames {} events {} interval_us {}\n", frames, events, interval.to_micros()!)!
    // A program that stops animating goes back to plain event waits.
    match win.wait_event_timeout(10)? {
        some(_) => {}
        none => {}
    }
    return ok()
}

fn main() -> i32 {
    match run() {
        ok() => {
            return 0
        }
        err(error) => {
            console.printf("error {}\n", window.error_name(error))!
            return 1
        }
    }
}
