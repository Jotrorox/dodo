package gzip_optional_checks
import "std/compress/gzip"

fn main() -> i32 {
    input: [45]u8 = [31u8, 139, 8, 30, 0, 0, 0, 0, 0, 255, 3, 0, 1, 2, 3, 110, 97, 109, 101, 0, 99, 111, 109, 109, 101, 110, 116, 0, 53, 95, 203, 72, 205, 201, 201, 7, 0, 134, 166, 16, 54, 5, 0, 0, 0]
    output := [0u8; 5]
    match gzip.decode(&input, &mut output) {
        ok(result) => {
            if result.input_consumed != 45 || result.output_written != 5 { return 1 }
            if output[0] != 104 || output[1] != 101 || output[2] != 108 || output[3] != 108 || output[4] != 111 { return 2 }
        }, err(_) => { return 3 }
    }
    for i in 0usize..45 {
        match gzip.decode(&input[..i], &mut output) {
            ok(_) => { return 4 }, err(_) => {}
        }
    }
    input[28] = 0
    match gzip.decode(&input, &mut output) {
        err(gzip.Error.ChecksumMismatch) => {},
        err(_) => { return 5 },
        ok(_) => { return 5 },
    }
    return 0
}
