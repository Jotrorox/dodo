package compress_stream_checks
import "std/compress/io" as cio
import "std/io"
import "std/compress/deflate"
import "std/compress/zlib"
import "std/compress/gzip"

static mut BUFFER: [deflate.ENCODER_BUFFER_LEN]u8 = [0u8; deflate.ENCODER_BUFFER_LEN]

// Python-made streams split at every input boundary, with 17-byte outputs.
fn exercise<D: cio.Decoder>(decoder: &mut D, data: &[u8], end: usize, split: usize) {
    output := [0u8; 17000]
    used := 0usize
    written := 0usize
    available := split
    for true {
        count := 17usize
        if output.len - written < count {
            count = output.len - written
        }
        p := decoder.process(&data[used..available], &mut output[written..written + count])!
        used += p.input_consumed
        written += p.output_written
        if p.status == deflate.Status.Done {
            break
        }
        if p.status == deflate.Status.NeedInput {
            available = data.len
        }
    }
    assert(used == end && written == 17000)
    expected := b"hello streaming! "
    for i in 0usize..written {
        assert(output[i] == expected[i % expected.len])
    }
}
// Returns one byte per call; interrupted after byte 8, failing after byte 10.
pub struct BrokenReader {
    data: &[u8]
    position: usize
    pub fn read(&mut self, out: &mut[u8]) -> usize!io.Error {
        if self.position == self.data.len {
            return ok(0)
        }
        out[0] = self.data[self.position]
        self.position += 1
        if self.position == 8 {
            return err(io.failure(io.ErrorKind.Interrupted, 1))
        }
        if self.position == 10 {
            return err(io.Error { kind: io.ErrorKind.Other, transferred: 1, code: 77 })
        }
        return ok(1)
    }
}
// Accepts two bytes then fails, then one byte with an interruption.
pub struct BrokenWriter {
    data: &mut[u8]
    used: usize
    calls: usize
    pub fn write(&mut self, input: &[u8]) -> usize!io.Error {
        self.calls += 1
        count := input.len
        if self.calls == 1 && count > 2 {
            count = 2
        }
        if self.calls == 2 && count > 1 {
            count = 1
        }
        for i in 0usize..count {
            self.data[self.used + i] = input[i]
        }
        self.used += count
        if self.calls == 1 {
            return err(io.Error { kind: io.ErrorKind.Other, transferred: count, code: 42 })
        }
        if self.calls == 2 {
            return err(io.failure(io.ErrorKind.Interrupted, count))
        }
        return ok(count)
    }
}
fn decoded_len(kind: usize, stream: &[u8], out: &mut[u8]) -> usize {
    if kind == 0 {
        r := deflate.decode(stream, out)!;
        return r.output_written
    }
    if kind == 1 {
        r := zlib.decode(stream, out)!;
        return r.output_written
    }
    r := gzip.decode(stream, out)!;
    return r.output_written
}
// A sink failure during finish keeps the unwritten bytes for the retry.
fn writer_test<E: cio.Encoder>(encoder: &mut E, kind: usize) {
    storage := [0u8; 8000]
    sink := BrokenWriter { data: &mut storage, used: 0, calls: 0 }
    writer := cio.Writer.new(&mut sink, encoder)
    // Wrapper headers reach the sink during write; raw data waits for finish.
    failures := 0usize
    match writer.write(b"abc") {
        ok(n) => {
            assert(n == 3)
        },
        err(e) => {
            assert(e.code == 42 && e.transferred == 3);
            failures += 1
        },
    }
    for {
        match writer.finish() {
            ok(n) => {
                assert(n > 0);
                break
            },
            err(e) => {
                assert(e.kind == io.ErrorKind.Other && e.code == 42 && e.transferred == 2);
                failures += 1
            },
        }
    }
    assert(failures == 1)
    assert(writer.finish()! == 0)
    match writer.write(b"x") {
        ok(_) => {
            assert(false)
        }, err(e) => {
            assert(e.kind == io.ErrorKind.Closed && e.transferred == 0)
        }
    }
    out := [0u8; 4]
    assert(decoded_len(kind, &sink.data[..sink.used], &mut out) == 3)
    assert(out[0] == 97 && out[1] == 98 && out[2] == 99)
}
// A large write reports all accepted input even when the sink fails.
fn large_writer_test<E: cio.Encoder>(encoder: &mut E, kind: usize, fail: bool) {
    calls := 3usize
    if fail {
        calls = 0
    }
    storage := [0u8; 8000]
    sink := BrokenWriter { data: &mut storage, used: 0, calls: calls }
    writer := cio.Writer.new(&mut sink, encoder)
    input := [7u8; 100000]
    for i in 0usize..input.len {
        input[i] = ((i * 7) % 11) as u8
    }
    match writer.write(&input) {
        ok(count) => {
            assert(!fail && count == input.len)
        },
        err(e) => {
            assert(fail && e.transferred > 0 && e.transferred <= input.len)
        },
    }
    if fail {
        return
    }
    writer.finish()!
    output := [0u8; 100000]
    assert(decoded_len(kind, &sink.data[..sink.used], &mut output) == input.len)
    for i in 0usize..input.len {
        assert(output[i] == input[i])
    }
}
fn main() {
    unsafe {
        run(&mut BUFFER)
    }
}
fn run(buffer: &mut[u8]) {
    workspace := [0u32; deflate.WORKSPACE_LEN]
    for kind in 0usize..3 {
        for fail in 0usize..2 {
            if kind == 0 {
                e := deflate.Encoder.new(6, buffer, &mut workspace)!
                large_writer_test(&mut e, kind, fail == 1)
                e.reset()
                writer_test(&mut e, kind)
            } else if kind == 1 {
                e := zlib.Encoder.new(6, buffer, &mut workspace)!
                large_writer_test(&mut e, kind, fail == 1)
                e.reset()
                writer_test(&mut e, kind)
            } else {
                e := gzip.Encoder.new(6, buffer, &mut workspace)!
                large_writer_test(&mut e, kind, fail == 1)
                e.reset()
                writer_test(&mut e, kind)
            }
        }
    }
    match deflate.Encoder.new(6, &mut buffer[..1000], &mut workspace) {
        ok(_) => {
            assert(false)
        }, err(e) => {
            assert(e == deflate.Error.InvalidArgument)
        },
    }
    z := [120u8, 156u8, 237u8, 200u8, 219u8, 9u8, 0u8, 16u8, 0u8, 0u8, 192u8, 85u8, 24u8, 205u8, 135u8, 80u8, 30u8, 133u8, 253u8, 179u8, 135u8, 238u8, 62u8, 175u8, 230u8, 222u8, 87u8, 56u8, 119u8, 231u8, 52u8, 218u8, 44u8, 49u8, 84u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 241u8, 99u8, 60u8, 192u8, 125u8, 103u8, 129u8]
    g := [31u8, 139u8, 8u8, 0u8, 0u8, 0u8, 0u8, 0u8, 2u8, 255u8, 237u8, 200u8, 219u8, 9u8, 0u8, 16u8, 0u8, 0u8, 192u8, 85u8, 24u8, 205u8, 135u8, 80u8, 30u8, 133u8, 253u8, 179u8, 135u8, 238u8, 62u8, 175u8, 230u8, 222u8, 87u8, 56u8, 119u8, 231u8, 52u8, 218u8, 44u8, 49u8, 84u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 33u8, 132u8, 16u8, 66u8, 8u8, 241u8, 99u8, 60u8, 73u8, 104u8, 187u8, 150u8, 104u8, 66u8, 0u8, 0u8, 88u8]
    for split in 0usize..z.len + 1 {
        decoder := zlib.Decoder.new();
        exercise(&mut decoder, &z, z.len, split)
    }
    for split in 0usize..g.len + 1 {
        decoder := gzip.Decoder.new();
        exercise(&mut decoder, &g, g.len - 1, split)
    }
    // A source error after delivering a byte is reported once that byte is
    // decoded, with the output it produced counted.
    stored := [120u8, 1, 1, 3, 0, 252, 255, 97, 98, 99, 2, 77, 1, 39, 88]
    source := BrokenReader { data: &stored, position: 0 }
    decoder := zlib.Decoder.new()
    storage := [0u8; 1]
    reader := cio.Reader.new(&mut source, &mut decoder, &mut storage)!
    out := [0u8; 16]
    total := 0usize
    failed := false
    for !failed {
        match reader.read_checked(&mut out[total..]) {
            ok(n) => {
                assert(n > 0);
                total += n
            },
            err(error) => {
                assert(error.kind == cio.ErrorKind.Io && error.cause.code == 77)
                total += error.transferred
                failed = true
            },
        }
    }
    assert(total == 3)
    assert(out[0] == 97 && out[1] == 98 && out[2] == 99)
    assert(reader.read_checked(&mut out)! == 0)
    assert(reader.is_done())
    assert(source.position == stored.len - 1)
    bad := [120u8, 1, 1, 3, 0, 252, 255, 97, 98, 99, 2, 77, 1, 38]
    memory := io.MemoryReader.new(&bad)
    decoder.reset()
    big_storage := [0u8; 64]
    reader2 := cio.Reader.new(&mut memory, &mut decoder, &mut big_storage)!
    match reader2.read_checked(&mut out) {
        ok(_) => {
            assert(false)
        },
        err(error) => {
            assert(error.kind == cio.ErrorKind.Format && error.format == deflate.Error.ChecksumMismatch)
        },
    }
    // Two gzip members through one Reader, with trailing bytes buffered.
    joined := [0u8; 80]
    first := gzip.encode(b"ab", &mut joined, 6)!
    second := gzip.encode(b"cde", &mut joined[first..], 6)!
    memory2 := io.MemoryReader.new(&joined[..first + second])
    members := gzip.Decoder.new()
    reader3 := cio.Reader.new(&mut memory2, &mut members, &mut big_storage)!
    assert(reader3.read_checked(&mut out)! == 2)
    assert(reader3.read_checked(&mut out)! == 0)
    assert(reader3.buffered().len == second)
    assert(reader3.next_stream()!)
    assert(reader3.read_checked(&mut out)! == 3)
    assert(out[0] == 99)
    assert(reader3.read_checked(&mut out)! == 0)
    assert(!reader3.next_stream()!)
    // Truncated input.
    memory3 := io.MemoryReader.new(&joined[..first - 3])
    members.reset()
    reader4 := cio.Reader.new(&mut memory3, &mut members, &mut big_storage)!
    total = 0
    for {
        match reader4.read_checked(&mut out[total..]) {
            ok(n) => {
                assert(n > 0);
                total += n
            },
            err(error) => {
                assert(error.kind == cio.ErrorKind.Truncated);
                break
            },
        }
    }
}
