package net_checks
import "std/net"
import "std/net/dns"
import "core/bytes"

pub struct Clock {
    value: u64
    pub fn now_ms(&mut self) -> u64 {
        return self.value
    }
}
fn addresses() -> i32!net.Error {
    output := [0u8; 64]
    v4 := net.parse_ip(b"127.0.0.1")?
    if v4.family != net.Family.V4 || v4.octets[0] != 127 || v4.octets[3] != 1 {
        return ok(1)
    }
    count := net.format_ip(&v4, &mut output)?
    if!bytes.equal(&output[..count], b"127.0.0.1") {
        return ok(2)
    }
    inputs := [b"::", b"::1", b"2001:DB8:0:0:1:0:0:1", b"1:2:3:4:5:6:7:8", b"::ffff:192.0.2.1"]
    for input in inputs {
        ip := net.parse_ip(*input)?
        length := net.format_ip(&ip, &mut output)?
        again := net.parse_ip(&output[..length])?
        if!ip.equals(&again) {
            return ok(3)
        }
    }
    ip := net.parse_ip(b"2001:0db8:0:0:1:0:0:1")?
    count = net.format_ip(&ip, &mut output)?
    if!bytes.equal(&output[..count], b"2001:db8::1:0:0:1") {
        return ok(4)
    }
    invalid := [b"", b"1.2.3", b"01.2.3.4", b"256.0.0.1", b"+1.2.3.4", b"1.2.3.4.", b":::1", b"1::2::3", b"1:2:3:4:5:6:7", b"1:2:3:4:5:6:7:8::", b"1:2:3:4:5:6:7:8:9", b"::ffff:192.00.2.1", b"::1%3"]
    for input in invalid {
        match net.parse_ip(*input) {
            ok(_) => {
                return ok(5)
            }
            err(_) => {}
        }
    }
    sockets := [b"0.0.0.0:0", b"127.0.0.1:65535", b"[::1]:443", b"[fe80::1%4294967295]:80"]
    for input in sockets {
        address := net.parse_socket(*input)?
        length := net.format_socket(&address, &mut output)?
        if!bytes.equal(&output[..length], *input) {
            return ok(6)
        }
    }
    bad_sockets := [b"127.0.0.1", b"::1:80", b"[::1]", b"[::1]:", b"[::1]:65536", b"[::1%]:1", b"[::1%4294967296]:1", b"1.2.3.4:-1"]
    for input in bad_sockets {
        match net.parse_socket(*input) {
            ok(_) => {
                return ok(7)
            }
            err(_) => {}
        }
    }
    small := [99u8; 1]
    match net.format_ip(&ip, &mut small) {
        ok(_) => {
            return ok(8)
        }
        err(reason) => {
            if reason.kind != net.ErrorKind.BufferTooSmall || small[0] != 99 {
                return ok(9)
            }
        }
    }
    // Deterministic roundtrip property covering every byte value and zero runs.
    state := 12345u32
    for iteration in 0usize..2048 {
        raw := [0u8; 16]
        for i in 0usize..16 {
            state ^=(state & 524287u32) << 13
            state ^= state >> 17
            state ^=(state & 134217727u32) << 5
            raw[i] = (state >> 24) as u8
            if iteration % 3 == 0 && i > 3 && i < 12 {
                raw[i] = 0
            }
        }
        generated := net.IpAddress.v6(raw)
        length := net.format_ip(&generated, &mut output)?
        reparsed := net.parse_v6(&output[..length])?
        if!generated.equals(&reparsed) {
            return ok(10)
        }
    }
    clock := Clock { value: 100 }
    cancel := net.Cancellation.new()
    operation := net.Operation.until(101)
    operation.check(&mut clock, &cancel)?
    clock.value = 101
    match operation.check(&mut clock, &cancel) {
        ok() => {
            return ok(11)
        }
        err(reason) => {
            if reason.kind != net.ErrorKind.TimedOut {
                return ok(12)
            }
        }
    }
    cancel.cancel()
    match operation.check(&mut clock, &cancel) {
        ok() => {
            return ok(13)
        }
        err(reason) => {
            if reason.kind != net.ErrorKind.Cancelled {
                return ok(14)
            }
        }
    }
    return ok(0)
}
fn dns_checks() -> i32!dns.Error {
    packet := [0u8; 512]
    name := [0u8; 255]
    count := dns.query(b"example.test.", 0x1234, dns.TYPE_AAAA, true, &mut packet)?
    value := dns.header(&packet[..count])?
    if value.id != 0x1234 || value.questions != 1 || value.response() {
        return ok(20)
    }
    reader := dns.Reader.new(&packet[..count])?
    match reader.next_question(&mut name)? {
        some(question) => {
            if question.qtype != dns.TYPE_AAAA || !bytes.equal(question.name, b"\x07example\x04test\x00") {
                return ok(21)
            }
        }
        none => {
            return ok(22)
        }
    }
    reader.finish()?
    compressed := b"\x03www\x04test\x00\x03api\xc0\x04"
    progress := dns.expand_name(compressed, 10, &mut name)?
    if progress.consumed != 6 || !bytes.equal(&name[..progress.written], b"\x03api\x04test\x00") {
        return ok(23)
    }
    bad := [b"\xc0\x00", b"\xc0\x02\x00", b"\x40", b"\x03ab", b"\xc0"]
    for item in bad {
        match dns.expand_name(*item, 0, &mut name) {
            ok(_) => {
                return ok(24)
            }
            err(_) => {}
        }
    }
    // A compressed A response with one question and one answer.
    response := b"\x12\x34\x81\x80\x00\x01\x00\x01\x00\x00\x00\x00\x01x\x00\x00\x01\x00\x01\xc0\x0c\x00\x01\x00\x01\x00\x00\x00\x3c\x00\x04\x7f\x00\x00\x01"
    answer := dns.Reader.new(response)?
    match answer.next_question(&mut name)? {
        some(_) => {}
        none => {
            return ok(25)
        }
    }
    match answer.next_record(&mut name)? {
        some(record) => {
            if record.ttl != 60 || record.kind != dns.TYPE_A || !bytes.equal(record.data, b"\x7f\x00\x00\x01") {
                return ok(26)
            }
        }
        none => {
            return ok(27)
        }
    }
    answer.finish()?
    // Bounded malformed-message corpus, deterministic and allocator-free.
    state := 7u32
    for iteration in 0usize..1024 {
        for i in 0usize..64 {
            state ^=(state & 524287u32) << 13
            state ^= state >> 17
            state ^=(state & 134217727u32) << 5
            packet[i] = (state >> 24) as u8
        }
        match dns.expand_name(&packet[..iteration % 64], iteration % 70, &mut name) {
            ok(progress) => {
                if progress.written > 255 {
                    return ok(28)
                }
            }
            err(_) => {}
        }
        match dns.header(&packet[..iteration % 64]) {
            ok(_) => {}
            err(_) => {}
        }
    }
    return ok(0)
}
fn main() -> i32 {
    match addresses() {
        ok(code) => {
            if code != 0 {
                return code
            }
        }
        err(_) => {
            return 90
        }
    }
    match dns_checks() {
        ok(code) => {
            return code
        }
        err(_) => {
            return 91
        }
    }
}
