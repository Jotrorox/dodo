package compress_oracle

import "std/compress/deflate"
import "std/console"
import "std/io"

// "hello hello hello dodo" as a fixed-Huffman stream, decoded when stdin is
// empty so fixture runners that provide no input still exercise the decoder.
const SAMPLE: [14]u8 = [203, 72, 205, 201, 201, 87, 200, 64, 34, 83, 242, 83, 242, 1]

// Decode a single raw stream from stdin for independent differential tests.
fn main() -> i32 {
    input := [0u8; 131072]
    output := [0u8; 262144]
    source := console.stdin()
    sink := console.stdout()
    used := 0usize
    for used < input.len {
        n := match source.read(&mut input[used..]) {
            ok(n) => {
                n
            }, err(_) => {
                return 1
            }
        }
        if n == 0 {
            break
        }
        used += n
    }
    if used == 0 {
        for i in 0usize..SAMPLE.len {
            input[i] = SAMPLE[i]
        }
        used = SAMPLE.len
    }
    report := match deflate.decode(&input[..used], &mut output) {
        ok(result) => {
            result
        }, err(_) => {
            return 2
        }
    }
    if report.input_consumed != used {
        return 3
    }
    match io.write_all(&mut sink, &output[..report.output_written]) {
        ok(_) => {}, err(_) => {
            return 4
        }
    }
    return 0
}
