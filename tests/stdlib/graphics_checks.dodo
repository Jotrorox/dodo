    mutate(&fields, &mut random, 1500, false)
    // PNG with stored blocks, and two files from tests/graphics/png: Adam7
    // with a 4-bit palette, and 16-bit gray with tRNS, both using every row
    // filter. Most rounds fix the CRCs so the corruption reaches the
    // decompressor and the filters.
    png := [0u8; 558]
    image.encode_png(&canvas, &mut png)!
    mutate(&png, &mut random, 500, false)
    mutate(&png, &mut random, 1500, true)
    palette_adam7 := [
        0x89u8, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52,
        0x00, 0x00, 0x00, 0x0a, 0x00, 0x00, 0x00, 0x0a, 0x04, 0x03, 0x00, 0x00, 0x01, 0x08, 0x1b, 0xe2,
        0x18, 0x00, 0x00, 0x00, 0x30, 0x50, 0x4c, 0x54, 0x45, 0x0b, 0x03, 0xff, 0x4e, 0x9a, 0xe2, 0x91,
        0x31, 0xc5, 0xd4, 0xc8, 0xa8, 0x17, 0x5f, 0x8b, 0x5a, 0xf6, 0x6e, 0x9d, 0x8d, 0x51, 0xe0, 0x24,
        0x34, 0x23, 0xbb, 0x17, 0x66, 0x52, 0xfa, 0xa9, 0xe9, 0xdd, 0xec, 0x80, 0xc0, 0x2f, 0x17, 0xa3,
        0x72, 0xae, 0x86, 0xb5, 0x45, 0x69, 0xf8, 0xdc, 0x4c, 0x3b, 0xed, 0x51, 0x27, 0x00, 0x00, 0x00,
        0x56, 0x49, 0x44, 0x41, 0x54, 0x78, 0xda, 0x01, 0x4b, 0x00, 0xb4, 0xff, 0x02, 0x0a, 0x03, 0x01,
        0x04, 0x00, 0x00, 0x00, 0x01, 0x46, 0x8a, 0x02, 0x32, 0x03, 0x51, 0x04, 0xcb, 0x00, 0x00, 0x13,
        0x30, 0x01, 0xaa, 0xb6, 0xa0, 0x02, 0x1f, 0xfe, 0x00, 0x03, 0xec, 0x57, 0xc7, 0x04, 0x1b, 0x55,
        0x00, 0x00, 0xa5, 0x8f, 0x40, 0x01, 0x1f, 0xdf, 0xd2, 0x02, 0x01, 0x30, 0xf0, 0xce, 0x91, 0x03,
        0xf0, 0x6d, 0xc0, 0x93, 0xec, 0x04, 0x66, 0xc2, 0x70, 0x56, 0x25, 0x00, 0xbb, 0xb5, 0x68, 0xf0,
        0xfc, 0x01, 0x01, 0x2f, 0xc0, 0xe5, 0x6a, 0xe8, 0x2b, 0x19, 0xa2, 0x50, 0x67, 0xeb, 0x9b, 0x00,
        0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82
    ]
    mutate(&palette_adam7, &mut random, 3000, true)
    gray16_trns := [
        0x89u8, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52,
        0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x05, 0x10, 0x00, 0x00, 0x00, 0x00, 0xe2, 0xa8, 0x45,
        0xf4, 0x00, 0x00, 0x00, 0x02, 0x74, 0x52, 0x4e, 0x53, 0x9c, 0x40, 0xdd, 0xbb, 0x49, 0xbe, 0x00,
        0x00, 0x00, 0x6a, 0x49, 0x44, 0x41, 0x54, 0x78, 0xda, 0x01, 0x5f, 0x00, 0xa0, 0xff, 0x00, 0x9c,
        0x40, 0x1f, 0xff, 0x3f, 0xff, 0xff, 0xff, 0x00, 0x00, 0x9c, 0x40, 0x13, 0x53, 0x41, 0x8a, 0xfa,
        0xfe, 0x01, 0x00, 0x00, 0x1f, 0xff, 0x20, 0x00, 0x5d, 0x41, 0x63, 0xbf, 0x01, 0x01, 0xb1, 0x70,
        0x98, 0x4c, 0x53, 0x84, 0x02, 0x00, 0x00, 0x7d, 0x41, 0xc1, 0x01, 0x2c, 0x8c, 0x36, 0x52, 0x21,
        0x9c, 0xeb, 0xd0, 0x36, 0x43, 0xe3, 0xbf, 0x03, 0xff, 0xff, 0x33, 0x61, 0xff, 0xff, 0x7f, 0xd9,
        0x51, 0xb9, 0x3f, 0xb5, 0x23, 0xce, 0x20, 0x00, 0x20, 0x00, 0x04, 0xaf, 0xbb, 0xf5, 0x91, 0x9d,
        0x41, 0x9d, 0xbf, 0x00, 0x41, 0x00, 0x00, 0xc0, 0x00, 0xdd, 0x41, 0x63, 0xbf, 0x50, 0x8e, 0x27,
        0xf7, 0x8c, 0xa7, 0x2b, 0x81, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60,
        0x82
    ]
    mutate(&gray16_trns, &mut random, 3000, true)
    // The unmutated RGB565 bit-field file decodes to its four colors.
    field_pixels := [0u8; 2 * 2 * 4]
    decoded := image.decode(&fields, &mut field_pixels, graphics.PixelFormat.Rgba8888)!
    assert_eq(at(&decoded, 0, 1), graphics.RED)
    assert_eq(at(&decoded, 1, 1), graphics.BLUE)
    assert_eq(at(&decoded, 0, 0), graphics.GREEN)
    assert_eq(at(&decoded, 1, 0), graphics.WHITE)
}

// A coordinate that is usually near the canvas and sometimes extreme.
fn wild(random: &mut Random) -> i32 {
    choice := random.next() % 8
    if choice == 0 {
        return -2147483648
    }
    if choice == 1 {
        return 2147483647
    }
    if choice == 2 {
        return (random.next() as i64 - 2147483648) as i32
    }
    return (random.next() % 64) as i32 - 24
}

fn extent(random: &mut Random) -> u32 {
    choice := random.next() % 8
    if choice == 0 {
        return 4294967295
    }
    if choice == 1 {
        return random.next()
    }
    return random.next() % 40
}

// Random primitives with extreme arguments in every format: drawing must
// never trap, and work must stay bounded by the visible area.
fn random_drawing() {
    random := Random { state: 0x9e3779b9 }
    rgba := [0u8; 16 * 12 * 4]
    rgb565 := [0u8; 16 * 12 * 2]
    gray := [0u8; 16 * 12]
    mono := [0u8; 2 * 12]
    canvases := [graphics.canvas(&mut rgba, 16, 12, graphics.PixelFormat.Rgba8888)!, graphics.canvas(&mut rgb565, 16, 12, graphics.PixelFormat.Rgb565)!, graphics.canvas(&mut gray, 16, 12, graphics.PixelFormat.Gray8)!, graphics.canvas(&mut mono, 13, 12, graphics.PixelFormat.Mono1)!]
    small := font.small()
    big := font.medium().scaled(3)
    sprite_pixels := [0u8; 5 * 5 * 4]
    sprite := graphics.canvas(&mut sprite_pixels, 5, 5, graphics.PixelFormat.Rgba8888)!
    sprite.clear(graphics.rgba(10, 200, 30, 128))
    coordinates := [0i32; 12]
    path_storage := [0i32; 64]
    path := graphics.Path.new(&mut path_storage)
    for _ in 0u32..4000 {
        canvas := &mut canvases[(random.next() % 4) as usize]
        color := random.next()
        if random.next() % 16 == 0 {
            canvas.set_clip(graphics.Rect.new(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random)))
        }
        operation := random.next() % 22
        if operation == 0 {
            canvas.line(wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random), color)
        } else if operation == 1 {
            canvas.rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), color)
        } else if operation == 2 {
            canvas.fill_rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), color)
        } else if operation == 3 {
            canvas.round_rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), extent(&mut random), color)
        } else if operation == 4 {
            canvas.fill_round_rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), extent(&mut random), color)
        } else if operation == 5 {
            canvas.circle(wild(&mut random), wild(&mut random), extent(&mut random), color)
        } else if operation == 6 {
            canvas.fill_circle(wild(&mut random), wild(&mut random), extent(&mut random), color)
        } else if operation == 7 {
            canvas.ellipse(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), color)
        } else if operation == 8 {
            canvas.fill_ellipse(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), color)
        } else if operation == 9 || operation == 10 {
            count := (random.next() % 7) as usize
            for i in 0usize..2 * count {
                coordinates[i] = wild(&mut random)
            }
            if operation == 9 {
                canvas.polygon(&coordinates[..2 * count], color)
            } else {
                canvas.fill_polygon(&coordinates[..2 * count], color)
            }
        } else if operation == 11 {
            if random.next() % 2 == 0 {
                canvas.text(&small, wild(&mut random), wild(&mut random), "Wild € text\nÿ", color)
            } else {
                canvas.text(&big, wild(&mut random), wild(&mut random), "Ab", color)
            }
        } else if operation == 12 {
            canvas.blend_rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), color)
        } else if operation == 14 {
            canvas.aa_line(wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random), color)
        } else if operation == 15 {
            canvas.aa_thick_line(wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random), extent(&mut random), color)
        } else if operation == 16 {
            if random.next() % 2 == 0 {
                canvas.aa_fill_circle(wild(&mut random), wild(&mut random), extent(&mut random), color)
            } else {
                canvas.aa_circle(wild(&mut random), wild(&mut random), extent(&mut random), color)
            }
        } else if operation == 17 {
            if random.next() % 2 == 0 {
                canvas.aa_fill_ellipse(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), color)
            } else {
                canvas.aa_ellipse(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), color)
            }
        } else if operation == 18 {
            if random.next() % 2 == 0 {
                canvas.aa_fill_round_rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), extent(&mut random), color)
            } else {
                canvas.aa_round_rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), extent(&mut random), color)
            }
        } else if operation == 19 {
            count := (random.next() % 7) as usize
            for i in 0usize..2 * count {
                coordinates[i] = wild(&mut random)
            }
            canvas.aa_fill_polygon(&coordinates[..2 * count], color)
        } else if operation == 20 {
            path.clear()
            commands := random.next() % 6
            for _ in 0u32..commands {
                kind := random.next() % 5
                if kind == 0 {
                    path.move_to(wild(&mut random), wild(&mut random))
                } else if kind == 1 {
                    path.line_to(wild(&mut random), wild(&mut random))
                } else if kind == 2 {
                    path.quad_to(wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random))
                } else if kind == 3 {
                    path.cubic_to(wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random))
                } else {
                    path.circle(wild(&mut random), wild(&mut random), wild(&mut random))
                }
            }
            if random.next() % 2 == 0 {
                canvas.fill_path(&path, graphics.FillRule.NonZero, color)
            } else {
                canvas.fill_path(&path, graphics.FillRule.EvenOdd, color)
            }
        } else if operation == 21 {
            shade := graphics.Gradient.linear(wild(&mut random), wild(&mut random), wild(&mut random), wild(&mut random), color, random.next())
            if random.next() % 2 == 0 {
                shade = graphics.Gradient.radial(wild(&mut random), wild(&mut random), extent(&mut random), color, random.next())
            }
            shade.add_stop((random.next() & 255) as u8, random.next())
            shade.set_dither(random.next() % 2 == 0)
            if random.next() % 2 == 0 {
                shade.set_spread(graphics.Spread.Reflect)
            }
            canvas.gradient_rect(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random), &shade)
        } else {
            region := graphics.Rect.new(wild(&mut random), wild(&mut random), extent(&mut random), extent(&mut random))
            if random.next() % 2 == 0 {
                canvas.blit_region(&sprite, region, wild(&mut random), wild(&mut random))
            } else {
                canvas.blend_region(&sprite, region, wild(&mut random), wild(&mut random))
            }
        }
        // The dirty rectangle never leaves the canvas.
        dirty := canvas.dirty()
        bounds := canvas.bounds()
        inside := dirty.intersect(&bounds)
        assert(dirty.is_empty() || inside.equals(&dirty))
        if random.next() % 8 == 0 {
            canvas.take_dirty()
            canvas.reset_clip()
        }
    }
}

fn main() {
    construction()
    colors()
    formats()
    clipping_and_dirty()
    rectangles()
    lines()
    circles()
    polygons()
    comb_polygon()
    text()
    blitting()
    displays()
    origins()
    codecs()
    corrupted_files()
    random_drawing()
    antialiasing()
    gradients()
    truetype_checks()
    corrupted_fonts()
}

@test
fn graphics_checks_suite() {
    main()
}
